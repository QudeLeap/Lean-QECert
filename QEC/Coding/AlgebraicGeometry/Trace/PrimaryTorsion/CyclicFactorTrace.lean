/-!
# Primary trace on a cyclic quotient with a prime-power factor

For nonzero `q` and `b`, this module computes the first `e` primary-torsion
grades of `R ⧸ (q ^ e * b)`.  Each grade is the residue quotient by `(q)`,
with distinguished representative `q ^ (e - i - 1) * b`.  Multiplication by
`r` therefore has depth-`e` primary trace `e * (r mod q)`.

The proof is symbolic and does not enumerate a quotient.  It does not extract
the multiplicity of `q` in an arbitrary element, combine Smith summands, or
prove a residue, duality, genus, or Riemann--Roch theorem.
-/

namespace QEC.Coding.AlgebraicGeometry

variable {R : Type*} [CommRing R] [IsDomain R]

/-- Multiplication by `r` on `R ⧸ (q ^ e * b)`. -/
noncomputable def cyclicPowerFactorQuotientMul
    (q : R) (e : ℕ) (b r : R) :
    (R ⧸ Ideal.span {q ^ e * b}) →ₗ[R]
      (R ⧸ Ideal.span {q ^ e * b}) :=
  Algebra.lmul R (R ⧸ Ideal.span {q ^ e * b})
    (Ideal.Quotient.mk (Ideal.span {q ^ e * b}) r)

/-- Up to depth `e`, the `i`-th `(q)`-primary torsion layer of
`R ⧸ (q ^ e * b)` is generated by `q ^ (e - i) * b`. -/
theorem primaryTorsionLayer_cyclicPowerFactorQuotient
    (q : R) (hq : q ≠ 0) (e : ℕ) (b : R) (i : ℕ) (hi : i ≤ e) :
    primaryTorsionLayer (Ideal.span {q})
        (R ⧸ Ideal.span {q ^ e * b}) i =
      R ∙ Ideal.Quotient.mk (Ideal.span {q ^ e * b})
        (q ^ (e - i) * b) := by
  have hfactor : q ^ i * (q ^ (e - i) * b) = q ^ e * b := by
    rw [← mul_assoc, ← pow_add, Nat.add_sub_of_le hi]
  rw [← hfactor, primaryTorsionLayer, Ideal.span_singleton_pow,
    Submodule.torsionBySet_ideal_span_singleton_eq]
  exact Ideal.Quotient.torsionBy_eq_span_singleton
    (q ^ i) (q ^ (e - i) * b)
      (mem_nonZeroDivisors_of_ne_zero (pow_ne_zero i hq))

private def cyclicPowerFactorGradeGenerator
    (q : R) (hq : q ≠ 0) (e : ℕ) (b : R)
    (i : ℕ) (hi : i < e) :
    primaryTorsionLayer (Ideal.span {q})
      (R ⧸ Ideal.span {q ^ e * b}) (i + 1) :=
  ⟨Ideal.Quotient.mk (Ideal.span {q ^ e * b})
      (q ^ (e - (i + 1)) * b), by
    rw [primaryTorsionLayer_cyclicPowerFactorQuotient
      q hq e b (i + 1) hi]
    exact Submodule.mem_span_singleton_self _⟩

private def cyclicPowerFactorGradeMap
    (q : R) (hq : q ≠ 0) (e : ℕ) (b : R)
    (i : ℕ) (hi : i < e) :
    R →ₗ[R] primaryTorsionGrade (Ideal.span {q})
      (R ⧸ Ideal.span {q ^ e * b}) i :=
  LinearMap.toSpanSingleton R _
    (Submodule.Quotient.mk
      (cyclicPowerFactorGradeGenerator q hq e b i hi))

private theorem cyclicPowerFactorGradeMap_surjective
    (q : R) (hq : q ≠ 0) (e : ℕ) (b : R)
    (i : ℕ) (hi : i < e) :
    Function.Surjective (cyclicPowerFactorGradeMap q hq e b i hi) := by
  intro z
  induction z using Submodule.Quotient.induction_on with
  | _ x =>
      have hx : (x : R ⧸ Ideal.span {q ^ e * b}) ∈
          R ∙ Ideal.Quotient.mk (Ideal.span {q ^ e * b})
            (q ^ (e - (i + 1)) * b) := by
        rw [← primaryTorsionLayer_cyclicPowerFactorQuotient
          q hq e b (i + 1) hi]
        exact x.property
      obtain ⟨r, hr⟩ := Submodule.mem_span_singleton.mp hx
      refine ⟨r, ?_⟩
      change r • (Submodule.Quotient.mk
          (cyclicPowerFactorGradeGenerator q hq e b i hi) :
            primaryTorsionGrade (Ideal.span {q})
              (R ⧸ Ideal.span {q ^ e * b}) i) =
        (Submodule.Quotient.mk x :
          primaryTorsionGrade (Ideal.span {q})
            (R ⧸ Ideal.span {q ^ e * b}) i)
      rw [← Submodule.Quotient.mk_smul]
      congr 2
      apply Subtype.ext
      exact hr

private theorem cyclicPowerFactorGradeMap_ker
    (q : R) (hq : q ≠ 0) (e : ℕ) (b : R) (hb : b ≠ 0)
    (i : ℕ) (hi : i < e) :
    LinearMap.ker (cyclicPowerFactorGradeMap q hq e b i hi) =
      Ideal.span {q} := by
  ext r
  constructor
  · intro hr
    rw [LinearMap.mem_ker] at hr
    change r • (Submodule.Quotient.mk
        (cyclicPowerFactorGradeGenerator q hq e b i hi) :
          primaryTorsionGrade (Ideal.span {q})
            (R ⧸ Ideal.span {q ^ e * b}) i) = 0 at hr
    rw [← Submodule.Quotient.mk_smul,
      Submodule.Quotient.mk_eq_zero] at hr
    change r • (cyclicPowerFactorGradeGenerator q hq e b i hi :
      R ⧸ Ideal.span {q ^ e * b}) ∈
        primaryTorsionLayer (Ideal.span {q})
          (R ⧸ Ideal.span {q ^ e * b}) i at hr
    rw [primaryTorsionLayer_cyclicPowerFactorQuotient
      q hq e b i hi.le, Submodule.mem_span_singleton] at hr
    obtain ⟨c, hc⟩ := hr
    change Ideal.Quotient.mk (Ideal.span {q ^ e * b})
        (c * (q ^ (e - i) * b)) =
      Ideal.Quotient.mk (Ideal.span {q ^ e * b})
        (r * (q ^ (e - (i + 1)) * b)) at hc
    rw [Ideal.Quotient.eq] at hc
    have hfactor : q ^ i * (q ^ (e - i) * b) = q ^ e * b := by
      rw [← mul_assoc, ← pow_add, Nat.add_sub_of_le hi.le]
    have hpow_le : Ideal.span {q ^ e * b} ≤
        Ideal.span {q ^ (e - i) * b} := by
      rw [Ideal.span_le, Set.singleton_subset_iff, ← hfactor]
      exact Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _)
    have hcq : c * (q ^ (e - i) * b) ∈
        Ideal.span {q ^ (e - i) * b} :=
      Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _)
    have hrq : r * (q ^ (e - (i + 1)) * b) ∈
        Ideal.span {q ^ (e - i) * b} := by
      have := (Ideal.span {q ^ (e - i) * b}).sub_mem hcq (hpow_le hc)
      simpa only [sub_sub_cancel] using this
    have hsub : e - i = (e - (i + 1)) + 1 := by omega
    rw [Ideal.mem_span_singleton] at hrq
    obtain ⟨d, hd⟩ := hrq
    have hgenerator : q ^ (e - i) * b =
        (q ^ (e - (i + 1)) * b) * q := by
      rw [hsub, pow_succ]
      ring
    rw [hgenerator, mul_comm r (q ^ (e - (i + 1)) * b),
      mul_assoc] at hd
    have hnonzero : q ^ (e - (i + 1)) * b ≠ 0 :=
      mul_ne_zero (pow_ne_zero _ hq) hb
    have hd_cancel : (q ^ (e - (i + 1)) * b) * r =
        (q ^ (e - (i + 1)) * b) * (q * d) := by
      simpa only [mul_assoc] using hd
    have hd' : r = q * d := mul_left_cancel₀ hnonzero hd_cancel
    rw [Ideal.mem_span_singleton]
    exact ⟨d, hd'⟩
  · intro hr
    rw [LinearMap.mem_ker]
    change r • (Submodule.Quotient.mk
        (cyclicPowerFactorGradeGenerator q hq e b i hi) :
          primaryTorsionGrade (Ideal.span {q})
            (R ⧸ Ideal.span {q ^ e * b}) i) = 0
    have hann := primaryTorsionGrade_annihilated
      (R := R) (M := R ⧸ Ideal.span {q ^ e * b})
        (Ideal.span {q}) i
    exact @hann
      (Submodule.Quotient.mk
        (cyclicPowerFactorGradeGenerator q hq e b i hi)) ⟨r, hr⟩

private noncomputable def primaryTorsionGradeEquivCyclicPowerFactorQuotientR
    (q : R) (hq : q ≠ 0) (e : ℕ) (b : R) (hb : b ≠ 0)
    (i : ℕ) (hi : i < e) :
    (R ⧸ Ideal.span {q}) ≃ₗ[R]
      primaryTorsionGrade (Ideal.span {q})
        (R ⧸ Ideal.span {q ^ e * b}) i :=
  (Submodule.quotEquivOfEq (Ideal.span {q})
      (LinearMap.ker (cyclicPowerFactorGradeMap q hq e b i hi))
      (cyclicPowerFactorGradeMap_ker q hq e b hb i hi).symm).trans
    ((cyclicPowerFactorGradeMap q hq e b i hi).quotKerEquivOfSurjective
      (cyclicPowerFactorGradeMap_surjective q hq e b i hi))

/-- Every one of the first `e` primary grades of `R ⧸ (q ^ e * b)` is
one-dimensional over `R ⧸ (q)`. -/
noncomputable def primaryTorsionGradeEquivCyclicPowerFactorQuotient
    (q : R) (hq : q ≠ 0) (e : ℕ) (b : R) (hb : b ≠ 0)
    (i : ℕ) (hi : i < e) :
    letI := primaryTorsionGradeModule
      (M := R ⧸ Ideal.span {q ^ e * b}) (Ideal.span {q}) i
    (R ⧸ Ideal.span {q}) ≃ₗ[R ⧸ Ideal.span {q}]
      primaryTorsionGrade (Ideal.span {q})
        (R ⧸ Ideal.span {q ^ e * b}) i := by
  let h := primaryTorsionGrade_annihilated
    (R := R) (M := R ⧸ Ideal.span {q ^ e * b})
      (Ideal.span {q}) i
  letI : Module (R ⧸ Ideal.span {q})
      (primaryTorsionGrade (Ideal.span {q})
        (R ⧸ Ideal.span {q ^ e * b}) i) := h.module
  let E := primaryTorsionGradeEquivCyclicPowerFactorQuotientR
    q hq e b hb i hi
  exact
    { toEquiv := E.toEquiv
      map_add' := E.map_add
      map_smul' := by
        intro c x
        induction c using Quotient.inductionOn' with
        | _ r =>
            change E (Ideal.Quotient.mk (Ideal.span {q}) r • x) =
              Ideal.Quotient.mk (Ideal.span {q}) r • E x
            rw [Module.IsTorsionBySet.mk_smul h]
            exact E.map_smul r x }

/-- On representatives, the cyclic-factor grade equivalence is scalar
multiplication of its distinguished grade generator. -/
theorem primaryTorsionGradeEquivCyclicPowerFactorQuotient_mk
    (q : R) (hq : q ≠ 0) (e : ℕ) (b : R) (hb : b ≠ 0)
    (i : ℕ) (hi : i < e) (r : R) :
    letI := primaryTorsionGradeModule
      (M := R ⧸ Ideal.span {q ^ e * b}) (Ideal.span {q}) i
    primaryTorsionGradeEquivCyclicPowerFactorQuotient
        q hq e b hb i hi (Ideal.Quotient.mk (Ideal.span {q}) r) =
      Ideal.Quotient.mk (Ideal.span {q}) r •
        primaryTorsionGradeEquivCyclicPowerFactorQuotient
          q hq e b hb i hi 1 := by
  letI := primaryTorsionGradeModule
    (M := R ⧸ Ideal.span {q ^ e * b}) (Ideal.span {q}) i
  rw [← map_smul]
  change primaryTorsionGradeEquivCyclicPowerFactorQuotient
      q hq e b hb i hi (Ideal.Quotient.mk (Ideal.span {q}) r) =
    primaryTorsionGradeEquivCyclicPowerFactorQuotient
      q hq e b hb i hi (Ideal.Quotient.mk (Ideal.span {q}) r • 1)
  rw [smul_eq_mul, mul_one]

private theorem primaryTorsionGradeEndomorphism_cyclicPowerFactorQuotientMul
    (q : R) (e : ℕ) (b : R) (i : ℕ) (r : R)
    (z : primaryTorsionGrade (Ideal.span {q})
      (R ⧸ Ideal.span {q ^ e * b}) i) :
    letI := primaryTorsionGradeModule
      (M := R ⧸ Ideal.span {q ^ e * b}) (Ideal.span {q}) i
    primaryTorsionGradeEndomorphism (Ideal.span {q})
        (cyclicPowerFactorQuotientMul q e b r) i z =
      Ideal.Quotient.mk (Ideal.span {q}) r • z := by
  let h := primaryTorsionGrade_annihilated
    (R := R) (M := R ⧸ Ideal.span {q ^ e * b})
      (Ideal.span {q}) i
  letI : Module (R ⧸ Ideal.span {q})
      (primaryTorsionGrade (Ideal.span {q})
        (R ⧸ Ideal.span {q ^ e * b}) i) := h.module
  induction z using Submodule.Quotient.induction_on with
  | _ x =>
      rw [primaryTorsionGradeEndomorphism_mk,
        Module.IsTorsionBySet.mk_smul h]
      rfl

/-- Multiplication by `r` has trace `r mod q` on every one of the first `e`
primary grades of `R ⧸ (q ^ e * b)`. -/
theorem primaryTorsionGradeTrace_cyclicPowerFactorQuotient
    [IsNoetherianRing R] (q : R) (hq : q ≠ 0)
    [hmax : (Ideal.span {q}).IsMaximal]
    (e : ℕ) (b : R) (hb : b ≠ 0) (i : ℕ) (hi : i < e) (r : R) :
    primaryTorsionGradeTrace (Ideal.span {q})
        (cyclicPowerFactorQuotientMul q e b r) i =
      Ideal.Quotient.mk (Ideal.span {q}) r := by
  let p := Ideal.span {q}
  let M := R ⧸ Ideal.span {q ^ e * b}
  letI : Field (R ⧸ p) := Ideal.Quotient.field p
  letI := primaryTorsionGradeModule (M := M) p i
  letI : Module.Finite (R ⧸ p) (primaryTorsionGrade p M i) :=
    primaryTorsionGradeFinite (M := M) p i
  let E := primaryTorsionGradeEquivCyclicPowerFactorQuotient
    q hq e b hb i hi
  let source : (R ⧸ p) →ₗ[R ⧸ p] (R ⧸ p) :=
    Algebra.lmul (R ⧸ p) (R ⧸ p) (Ideal.Quotient.mk p r)
  let target : primaryTorsionGrade p M i →ₗ[R ⧸ p]
      primaryTorsionGrade p M i :=
    primaryTorsionGradeEndomorphism p
      (cyclicPowerFactorQuotientMul q e b r) i
  have hconj : E.conj source = target := by
    apply LinearMap.ext
    intro z
    obtain ⟨x, rfl⟩ := E.surjective z
    simp only [LinearEquiv.conj_apply, LinearMap.comp_apply,
      LinearEquiv.coe_coe, LinearEquiv.symm_apply_apply]
    rw [primaryTorsionGradeEndomorphism_cyclicPowerFactorQuotientMul]
    exact E.map_smul (Ideal.Quotient.mk p r) x
  change LinearMap.trace (R ⧸ p) (primaryTorsionGrade p M i) target =
    Ideal.Quotient.mk p r
  calc
    _ = LinearMap.trace (R ⧸ p) (primaryTorsionGrade p M i)
        (E.conj source) := congrArg (LinearMap.trace (R ⧸ p) _) hconj.symm
    _ = LinearMap.trace (R ⧸ p) (R ⧸ p) source :=
      LinearMap.trace_conj' source E
    _ = Algebra.trace (R ⧸ p) (R ⧸ p) (Ideal.Quotient.mk p r) :=
      (Algebra.trace_apply (R ⧸ p) (Ideal.Quotient.mk p r)).symm
    _ = Ideal.Quotient.mk p r := Algebra.trace_self_apply _

/-- The first `e` primary grades of multiplication by `r` on
`R ⧸ (q ^ e * b)` have total trace `e * (r mod q)`. -/
theorem primaryTorsionTrace_cyclicPowerFactorQuotient
    [IsNoetherianRing R] (q : R) (hq : q ≠ 0)
    [hmax : (Ideal.span {q}).IsMaximal]
    (e : ℕ) (b : R) (hb : b ≠ 0) (r : R) :
    primaryTorsionTrace (Ideal.span {q})
        (cyclicPowerFactorQuotientMul q e b r) e =
      (e : R ⧸ Ideal.span {q}) *
        Ideal.Quotient.mk (Ideal.span {q}) r := by
  rw [primaryTorsionTrace]
  calc
    (∑ i ∈ Finset.range e,
        primaryTorsionGradeTrace (Ideal.span {q})
          (cyclicPowerFactorQuotientMul q e b r) i) =
        ∑ _i ∈ Finset.range e,
          Ideal.Quotient.mk (Ideal.span {q}) r := by
      apply Finset.sum_congr rfl
      intro i hi
      exact primaryTorsionGradeTrace_cyclicPowerFactorQuotient
        q hq e b hb i (Finset.mem_range.mp hi) r
    _ = _ := by
      simp only [Finset.sum_const, Finset.card_range, nsmul_eq_mul]

end QEC.Coding.AlgebraicGeometry
