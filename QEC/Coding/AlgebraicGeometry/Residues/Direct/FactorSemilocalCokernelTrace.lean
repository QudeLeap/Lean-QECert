/-!
# A principal cokernel isolated at one direct factor

Suppose the principal ideal generated by an integral multiplier `t` factors
as `P * J`, where `P` is one actual upper factor of a direct polynomial
prime and `J` is coprime to the extended base prime.  The principal-cokernel
trace comparison identifies the Smith-style cokernel with the semilocal
quotient, and Chinese remaindering then isolates exactly the ordinary trace
on `B / P`.  Canonical base-residue transport turns this into the established
factor residue trace.

This module assumes the displayed principal factorization.  It does not
construct a semilocal multiplier, sum over upper factors, or assert a global
residue, duality, genus, or Riemann--Roch theorem.
-/

namespace QEC.Coding.AlgebraicGeometry.DirectFactorSemilocalCokernelTrace

open scoped Polynomial RatFunc nonZeroDivisors
open UniqueFactorizationMonoid

attribute [-instance] Ideal.Quotient.commSemiring
attribute [local instance]
  Ideal.Quotient.algebraQuotientOfRamificationIdxNeZero

variable (k F : Type*)
variable [Field k] [Finite k] [Field F]
variable [Algebra k[X] F] [Algebra k⟮X⟯ F]
variable [IsScalarTower k[X] k⟮X⟯ F]
variable [_root_.FunctionField k F]
variable [Algebra.IsSeparable k⟮X⟯ F]

abbrev R : Type _ := k[X]
abbrev B : Type _ := _root_.FunctionField.ringOfIntegers k F

local instance : Module.IsTorsionFree (R k) (B k F) :=
  Module.isTorsionFree_iff_algebraMap_injective.mpr
    (_root_.FunctionField.ringOfIntegers.algebraMap_injective k F)

/-- If the principal multiplier ideal is one chosen upper factor times a
base-primary-coprime complement, its induced cokernel multiplication has
primary trace equal to the ordinary quotient trace on that factor. -/
theorem primaryTorsionTrace_principalCokernel_eq_quotientTrace
    (p : IsDedekindDomain.HeightOneSpectrum (R k))
    (P : (factors
      (Ideal.map (algebraMap (R k) (B k F)) p.asIdeal)).toFinset)
    (J : Ideal (B k F))
    (hcop : IsCoprime
      (Ideal.map (algebraMap (R k) (B k F)) p.asIdeal) J)
    (t b : B k F)
    (hspan : Ideal.span ({t} : Set (B k F)) =
      (P : Ideal (B k F)) * J)
    (depth : ℕ) (hdepth : 0 < depth) :
    primaryTorsionTrace p.asIdeal
        (principalCokernelMul (R := R k) t b) depth =
      Algebra.trace (R k ⧸ p.asIdeal)
        (B k F ⧸ (P : Ideal (B k F)))
        (Ideal.Quotient.mk (P : Ideal (B k F)) b) := by
  calc
    primaryTorsionTrace p.asIdeal
        (principalCokernelMul (R := R k) t b) depth =
      primaryTorsionTrace p.asIdeal
        (Algebra.lmul (R k) (B k F ⧸ ((P : Ideal (B k F)) * J))
          (Ideal.Quotient.mk ((P : Ideal (B k F)) * J) b)) depth :=
      primaryTorsionTrace_cokernel_lmul_eq_idealQuotientMul_of_eq
        p.asIdeal t b ((P : Ideal (B k F)) * J) hspan depth
    _ = _ :=
      DirectFactorSemilocalPrimaryTrace.primaryTorsionTrace_directFactorMulCoprime_eq_quotientTrace
        k F p P J hcop b depth hdepth

/-- Canonical base-residue transport sends the same principal-cokernel trace
to the residue trace on the chosen upper factor. -/
theorem
    quotientResidueEquiv_primaryTorsionTrace_principalCokernel_eq_factorResidueTrace
    (p : IsDedekindDomain.HeightOneSpectrum (R k))
    (P : (factors
      (Ideal.map (algebraMap (R k) (B k F)) p.asIdeal)).toFinset)
    (J : Ideal (B k F))
    (hcop : IsCoprime
      (Ideal.map (algebraMap (R k) (B k F)) p.asIdeal) J)
    (t b : B k F)
    (hspan : Ideal.span ({t} : Set (B k F)) =
      (P : Ideal (B k F)) * J)
    (depth : ℕ) (hdepth : 0 < depth) :
    Ideal.Factors.quotientResidueEquiv p.asIdeal
        (primaryTorsionTrace p.asIdeal
          (principalCokernelMul (R := R k) t b) depth) =
      Ideal.Factors.factorResidueTrace p.asIdeal P b := by
  rw [primaryTorsionTrace_principalCokernel_eq_quotientTrace
    k F p P J hcop t b hspan depth hdepth]
  exact Ideal.Factors.quotientTrace_to_factorResidueTrace p.asIdeal P b

/-- A semilocal multiplier exists for which the principal-cokernel primary
trace is exactly the ordinary multiplication trace on the chosen factor. -/
theorem exists_primaryTorsionTrace_principalCokernel_eq_quotientTrace
    (p : IsDedekindDomain.HeightOneSpectrum (R k))
    (P : (factors
      (Ideal.map (algebraMap (R k) (B k F)) p.asIdeal)).toFinset)
    (b : B k F) (depth : ℕ) (hdepth : 0 < depth) :
    ∃ t : B k F, t ≠ 0 ∧
      primaryTorsionTrace p.asIdeal
          (principalCokernelMul (R := R k) t b) depth =
        Algebra.trace (R k ⧸ p.asIdeal)
          (B k F ⧸ (P : Ideal (B k F)))
          (Ideal.Quotient.mk (P : Ideal (B k F)) b) := by
  obtain ⟨t, ht, J, hspan, hcop⟩ :=
    DirectFactorSemilocalMultiplier.exists_directFactorSemilocalMultiplier
      k F p P
  exact ⟨t, ht,
    primaryTorsionTrace_principalCokernel_eq_quotientTrace
      k F p P J hcop t b hspan depth hdepth⟩

/-- A semilocal multiplier exists for which canonical base-residue transport
turns the principal-cokernel primary trace into the chosen factor residue
trace. -/
theorem
    exists_quotientResidueEquiv_primaryTorsionTrace_principalCokernel_eq_factorResidueTrace
    (p : IsDedekindDomain.HeightOneSpectrum (R k))
    (P : (factors
      (Ideal.map (algebraMap (R k) (B k F)) p.asIdeal)).toFinset)
    (b : B k F) (depth : ℕ) (hdepth : 0 < depth) :
    ∃ t : B k F, t ≠ 0 ∧
      Ideal.Factors.quotientResidueEquiv p.asIdeal
          (primaryTorsionTrace p.asIdeal
            (principalCokernelMul (R := R k) t b) depth) =
        Ideal.Factors.factorResidueTrace p.asIdeal P b := by
  obtain ⟨t, ht, J, hspan, hcop⟩ :=
    DirectFactorSemilocalMultiplier.exists_directFactorSemilocalMultiplier
      k F p P
  exact ⟨t, ht,
    quotientResidueEquiv_primaryTorsionTrace_principalCokernel_eq_factorResidueTrace
      k F p P J hcop t b hspan depth hdepth⟩

end QEC.Coding.AlgebraicGeometry.DirectFactorSemilocalCokernelTrace
