import QEC.Coding.Stabilizer.PauliSemantics

/-!
# QEC.QLDPC

Quantum LDPC incidence APIs and per-code locality bridges.
-/

namespace QEC

universe u v w x

open scoped Classical

namespace Coding.ChainComplexData

/-- Package the binary CSS code induced by finite chain-complex data as a chain-complex code. -/
noncomputable def binaryChainComplexCode
    {ι κ lambda : Type u} [Fintype ι] [DecidableEq ι] [Fintype κ] [Fintype lambda]
    (K : ChainComplexData
      (ZMod 2) (Word (ZMod 2) κ) (Word (ZMod 2) ι)
      (Word (ZMod 2) lambda)) :
    ChainComplexCode (ZMod 2) ι (Semantics.Qubit.QubitRegister ι)
      (Word (ZMod 2) κ) (Word (ZMod 2) ι)
      (Word (ZMod 2) lambda) where
  complex := K
  css := K.binaryCSSCode
  cycles := K.middleCycleCode
  boundaries := K.middleBoundaryCode
  boundary_subset_cycles := K.middleBoundaryCode_le_middleCycleCode

end Coding.ChainComplexData

namespace Coding.StabilizerCode

open PauliSymplectic

/--
The binary Pauli group generated by a stabilizer code's declared checks.

This target is fixed by the code before any alternative finite generating set
is chosen.
-/
noncomputable def generatedGroup
    {ι : Type u} [Fintype ι] [DecidableEq ι]
    (Q : StabilizerCode (ZMod 2) ι (Semantics.Qubit.QubitRegister ι)) :
    Set (Binary ι) := by
  classical
  letI : Fintype {P : Binary ι // P ∈ Q.stabilizers} := Fintype.ofFinite _
  exact {P |
    GeneratedStabilizer
      (fun check : {P : Binary ι // P ∈ Q.stabilizers} => check.1) P}

/--
The source-level validity conditions not enforced by the current
`StabilizerCode` structure: the generated group excludes `-I`, and the declared
code is exactly its common fixed space.
-/
def IsSourceValidBinary
    {ι : Type u} [Fintype ι] [DecidableEq ι]
    (Q : StabilizerCode (ZMod 2) ι (Semantics.Qubit.QubitRegister ι)) : Prop :=
  binarySign (ι := ι) 1 ∉ Q.generatedGroup ∧
    ∀ ψ, ψ ∈ Q.code.carrier ↔
      ∀ P, P ∈ Q.generatedGroup → toQubitOperator P ψ = ψ

/-- A binary stabilizer code satisfying the source's group/code-space convention. -/
abbrev SourceValidBinary
    (ι : Type u) [Fintype ι] [DecidableEq ι] :=
  {Q : StabilizerCode (ZMod 2) ι (Semantics.Qubit.QubitRegister ι) //
    Q.IsSourceValidBinary}

end Coding.StabilizerCode

namespace QLDPC

/-- A finite Pauli set generates an independently specified binary Pauli group. -/
def FinsetGenerates
    {ι : Type u} [Fintype ι] [DecidableEq ι]
    (G : Finset (Coding.PauliSymplectic.Binary ι))
    (S : Set (Coding.PauliSymplectic.Binary ι)) : Prop :=
  Coding.PauliSymplectic.generatedStabilizerSet (fun g : {P // P ∈ G} => g.1) = S

/-- A generated closure is monotone when every source generator lies in the target closure. -/
theorem generatedStabilizer_of_generators_generated
    {ι : Type u} [Fintype ι] [DecidableEq ι]
    {κ : Type v} {mu : Type w} [Fintype κ] [Fintype mu]
    {source : κ → Coding.PauliSymplectic.Binary ι}
    {target : mu → Coding.PauliSymplectic.Binary ι}
    (hgenerator : ∀ j, Coding.PauliSymplectic.GeneratedStabilizer target (source j))
    {P : Coding.PauliSymplectic.Binary ι}
    (hP : Coding.PauliSymplectic.GeneratedStabilizer source P) :
    Coding.PauliSymplectic.GeneratedStabilizer target P := by
  induction hP with
  | one => exact Coding.PauliSymplectic.GeneratedStabilizer.one
  | generator j => exact hgenerator j
  | mul _ _ ihP ihQ => exact Coding.PauliSymplectic.GeneratedStabilizer.mul ihP ihQ
  | dagger _ ihP => exact Coding.PauliSymplectic.GeneratedStabilizer.dagger ihP

/-- Pure X checks generated termwise also generate the check for their finite binary sum. -/
theorem generatedStabilizer_cssXCheck_sum
    {ι : Type u} [Fintype ι] [DecidableEq ι]
    {κ : Type v} [Fintype κ] {alpha : Type w}
    (generators : κ → Coding.PauliSymplectic.Binary ι)
    (s : Finset alpha) (f : alpha → Coding.Word (ZMod 2) ι)
    (h : ∀ a ∈ s, Coding.PauliSymplectic.GeneratedStabilizer generators
      (Coding.PauliSymplectic.cssXCheck (f a))) :
    Coding.PauliSymplectic.GeneratedStabilizer generators
      (Coding.PauliSymplectic.cssXCheck (∑ a ∈ s, f a)) := by
  classical
  induction s using Finset.induction_on with
  | empty =>
      simpa [Coding.PauliSymplectic.binaryOne] using
        (Coding.PauliSymplectic.GeneratedStabilizer.one (generators := generators))
  | @insert a s ha ih =>
      rw [Finset.sum_insert ha]
      rw [← Coding.PauliSymplectic.binaryMul_cssXCheck]
      exact Coding.PauliSymplectic.GeneratedStabilizer.mul
        (h a (Finset.mem_insert_self a s))
        (ih (fun b hb => h b (Finset.mem_insert_of_mem hb)))

/-- Pure Z checks generated termwise also generate the check for their finite binary sum. -/
theorem generatedStabilizer_cssZCheck_sum
    {ι : Type u} [Fintype ι] [DecidableEq ι]
    {κ : Type v} [Fintype κ] {alpha : Type w}
    (generators : κ → Coding.PauliSymplectic.Binary ι)
    (s : Finset alpha) (f : alpha → Coding.Word (ZMod 2) ι)
    (h : ∀ a ∈ s, Coding.PauliSymplectic.GeneratedStabilizer generators
      (Coding.PauliSymplectic.cssZCheck (f a))) :
    Coding.PauliSymplectic.GeneratedStabilizer generators
      (Coding.PauliSymplectic.cssZCheck (∑ a ∈ s, f a)) := by
  classical
  induction s using Finset.induction_on with
  | empty =>
      simpa [Coding.PauliSymplectic.binaryOne] using
        (Coding.PauliSymplectic.GeneratedStabilizer.one (generators := generators))
  | @insert a s ha ih =>
      rw [Finset.sum_insert ha]
      rw [← Coding.PauliSymplectic.binaryMul_cssZCheck]
      exact Coding.PauliSymplectic.GeneratedStabilizer.mul
        (h a (Finset.mem_insert_self a s))
        (ih (fun b hb => h b (Finset.mem_insert_of_mem hb)))

/-- The number of distinct checks in `G` whose Pauli support contains `q`. -/
def qubitCheckDegree
    {ι : Type u} [Fintype ι] [DecidableEq ι]
    (G : Finset (Coding.PauliSymplectic.Binary ι)) (q : ι) : Nat :=
  (G.filter fun g => q ∈ Coding.PauliSymplectic.support g).card

/--
A source-valid binary stabilizer-code family is LDPC when one family-independent
bound controls both generator weight and distinct-generator qubit degree.
-/
def IsLDPCStabilizerFamily
    {A : Type u} {ι : A → Type v}
    [∀ a, Fintype (ι a)] [∀ a, DecidableEq (ι a)]
    (Q : ∀ a, Coding.StabilizerCode.SourceValidBinary (ι a)) : Prop :=
  ∃ w : Nat, ∀ a, ∃ G : Finset (Coding.PauliSymplectic.Binary (ι a)),
    FinsetGenerates G (Q a).1.generatedGroup ∧
      (∀ g ∈ G, Coding.PauliSymplectic.weight g ≤ w) ∧
      ∀ q, qubitCheckDegree G q ≤ w

/-- A finite bipartite incidence relation between checks `χ` and variables `ι`. -/
structure CheckIncidence (χ ι : Type*) [Fintype χ] [Fintype ι] where
  incident : χ → ι → Prop

namespace CheckIncidence

variable {χ ι : Type*} [Fintype χ] [Fintype ι]

/-- Variables incident to a check. -/
noncomputable def checkSupport (I : CheckIncidence χ ι) (c : χ) : Finset ι := by
  classical
  exact Finset.univ.filter fun q => I.incident c q

/-- Checks incident to a variable. -/
noncomputable def variableSupport (I : CheckIncidence χ ι) (q : ι) : Finset χ := by
  classical
  exact Finset.univ.filter fun c => I.incident c q

@[simp]
theorem mem_checkSupport (I : CheckIncidence χ ι) (c : χ) (q : ι) :
    q ∈ I.checkSupport c ↔ I.incident c q := by
  classical
  simp [checkSupport]

@[simp]
theorem mem_variableSupport (I : CheckIncidence χ ι) (c : χ) (q : ι) :
    c ∈ I.variableSupport q ↔ I.incident c q := by
  classical
  simp [variableSupport]

/-- The per-code locality profile induced by finite check-variable incidence. -/
noncomputable def localityProfile (I : CheckIncidence χ ι) : Coding.LocalityProfile :=
  { maxCheckWeight := Finset.univ.sup fun c => (I.checkSupport c).card
    maxVariableDegree := Finset.univ.sup fun q => (I.variableSupport q).card }

/-- Explicit row/check and column/variable bounds give bounded per-code qLDPC locality. -/
theorem boundedLocality_of_row_col_bounds
    (I : CheckIncidence χ ι) {B : Nat}
    (hrow : ∀ c, (I.checkSupport c).card ≤ B)
    (hcol : ∀ q, (I.variableSupport q).card ≤ B) :
    Coding.BoundedLocality I.localityProfile B := by
  constructor
  · change (Finset.univ.sup fun c => (I.checkSupport c).card) ≤ B
    exact Finset.sup_le fun c _hc => hrow c
  · change (Finset.univ.sup fun q => (I.variableSupport q).card) ≤ B
    exact Finset.sup_le fun q _hq => hcol q

end CheckIncidence

/-- Build the per-code qLDPC property from concrete finite incidence row/column bounds. -/
noncomputable def QLDPCProperty.ofCheckIncidenceBounds
    {F : Type u} {ι : Type v} {H : Type w} {C0 C1 C2 : Type x}
    [Field F] [Fintype F] [DecidableEq F] [Fintype ι]
    [NormedAddCommGroup H] [InnerProductSpace Complex H] [Semantics.FiniteQuantumSystem H]
    [AddCommGroup C0] [Module F C0] [AddCommGroup C1] [Module F C1]
    [AddCommGroup C2] [Module F C2]
    {χ : Type*} [Fintype χ]
    (chainCode : Coding.ChainComplexCode F ι H C0 C1 C2)
    (parameters : Coding.CodeParameters F ι)
    (I : CheckIncidence χ ι) {B : Nat}
    (hrow : ∀ c, (I.checkSupport c).card ≤ B)
    (hcol : ∀ q, (I.variableSupport q).card ≤ B) :
    Coding.QLDPCProperty F ι H C0 C1 C2 :=
  { chainCode := chainCode
    parameters := parameters
    locality := I.localityProfile
    localityBound := B
    bounded_locality := I.boundedLocality_of_row_col_bounds hrow hcol }

/--
The explicit check-variable incidence induced by finite-coordinate chain-complex
boundary maps. Left checks are rows of the transpose of `boundary1`; right checks
are rows of `boundary2`.
-/
noncomputable def chainComplexBoundaryIncidence
    {F : Type u} {ι κ lambda : Type v} [Field F] [Fintype F] [DecidableEq F]
    [Fintype ι] [Fintype κ] [Fintype lambda]
    (K : Coding.ChainComplexData F (Coding.Word F κ) (Coding.Word F ι)
      (Coding.Word F lambda)) :
    CheckIncidence (Sum κ lambda) ι where
  incident c q :=
    match c with
    | Sum.inl k => (Coding.wordLinearMapTranspose K.boundary1
        (Coding.canonicalBasisWord (F := F) k)) q ≠ 0
    | Sum.inr l => (K.boundary2
        (Coding.canonicalBasisWord (F := F) l)) q ≠ 0

/-- The pure CSS Pauli check indexed by one basis row of a binary chain complex. -/
noncomputable def chainComplexCSSRowCheck
    {ι κ lambda : Type v} [Fintype ι] [Fintype κ] [Fintype lambda]
    (K : Coding.ChainComplexData
      (ZMod 2) (Coding.Word (ZMod 2) κ) (Coding.Word (ZMod 2) ι)
      (Coding.Word (ZMod 2) lambda)) :
    Sum κ lambda → Coding.PauliSymplectic.Binary ι
  | Sum.inl k => Coding.PauliSymplectic.cssXCheck
      (Coding.wordLinearMapTranspose K.boundary1
        (Coding.canonicalBasisWord (F := ZMod 2) k))
  | Sum.inr l => Coding.PauliSymplectic.cssZCheck
      (K.boundary2 (Coding.canonicalBasisWord (F := ZMod 2) l))

/-- The finite set of distinct basis-row CSS checks of a binary chain complex. -/
noncomputable def chainComplexCSSRowChecks
    {ι κ lambda : Type v} [Fintype ι] [Fintype κ] [Fintype lambda]
    (K : Coding.ChainComplexData
      (ZMod 2) (Coding.Word (ZMod 2) κ) (Coding.Word (ZMod 2) ι)
      (Coding.Word (ZMod 2) lambda)) :
    Finset (Coding.PauliSymplectic.Binary ι) := by
  classical
  exact Finset.univ.image (chainComplexCSSRowCheck K)

@[simp]
theorem mem_chainComplexCSSRowChecks
    {ι κ lambda : Type v} [Fintype ι] [Fintype κ] [Fintype lambda]
    (K : Coding.ChainComplexData
      (ZMod 2) (Coding.Word (ZMod 2) κ) (Coding.Word (ZMod 2) ι)
      (Coding.Word (ZMod 2) lambda)) (P : Coding.PauliSymplectic.Binary ι) :
    P ∈ chainComplexCSSRowChecks K ↔
      ∃ c : Sum κ lambda, chainComplexCSSRowCheck K c = P := by
  classical
  simp [chainComplexCSSRowChecks]

theorem chainComplexCSSRowCheck_mem_binaryCSSCheckSet
    {ι κ lambda : Type v} [Fintype ι] [Fintype κ] [Fintype lambda]
    (K : Coding.ChainComplexData
      (ZMod 2) (Coding.Word (ZMod 2) κ) (Coding.Word (ZMod 2) ι)
      (Coding.Word (ZMod 2) lambda)) (c : Sum κ lambda) :
    chainComplexCSSRowCheck K c ∈
      Coding.PauliSymplectic.binaryCSSCheckSet
        K.firstCoboundaryCheckCode K.middleBoundaryCode := by
  cases c with
  | inl k =>
      left
      refine ⟨_, ?_, rfl⟩
      exact (K.mem_firstCoboundaryCheckCode_iff _).2
        ⟨Coding.canonicalBasisWord (F := ZMod 2) k, rfl⟩
  | inr l =>
      right
      refine ⟨_, ?_, rfl⟩
      exact (K.mem_middleBoundaryCode_iff _).2
        ⟨Coding.canonicalBasisWord (F := ZMod 2) l, rfl⟩

/-- Every X check in the first-coboundary range is generated by the X basis rows. -/
theorem chainComplexCSSRowChecks_generate_cssXCheck_of_mem_firstCoboundaryCheckCode
    {ι κ lambda : Type v} [Fintype ι] [DecidableEq ι] [Fintype κ] [Fintype lambda]
    (K : Coding.ChainComplexData
      (ZMod 2) (Coding.Word (ZMod 2) κ) (Coding.Word (ZMod 2) ι)
      (Coding.Word (ZMod 2) lambda))
    {x : Coding.Word (ZMod 2) ι} (hx : x ∈ K.firstCoboundaryCheckCode.carrier) :
    Coding.PauliSymplectic.GeneratedStabilizer
      (fun g : {P : Coding.PauliSymplectic.Binary ι // P ∈ chainComplexCSSRowChecks K} => g.1)
      (Coding.PauliSymplectic.cssXCheck x) := by
  classical
  rcases (K.mem_firstCoboundaryCheckCode_iff x).1 hx with ⟨y, rfl⟩
  let generators :=
    fun g : {P : Coding.PauliSymplectic.Binary ι // P ∈ chainComplexCSSRowChecks K} => g.1
  change Coding.PauliSymplectic.GeneratedStabilizer generators
    (Coding.PauliSymplectic.cssXCheck (Coding.wordLinearMapTranspose K.boundary1 y))
  have hterm : ∀ k ∈ (Finset.univ : Finset κ),
      Coding.PauliSymplectic.GeneratedStabilizer generators
        (Coding.PauliSymplectic.cssXCheck
          (Coding.wordLinearMapTranspose K.boundary1 (Pi.single k (y k)))) := by
    intro k _hk
    by_cases hk0 : y k = 0
    · have hzero : Coding.wordLinearMapTranspose K.boundary1 (Pi.single k (y k)) = 0 := by
        simp [hk0]
      rw [hzero]
      simpa [Coding.PauliSymplectic.binaryOne] using
        (Coding.PauliSymplectic.GeneratedStabilizer.one (generators := generators))
    · have hk1 : y k = 1 := Coding.PauliSymplectic.zmod_two_eq_one_of_ne_zero hk0
      have hrow : chainComplexCSSRowCheck K (Sum.inl k) ∈ chainComplexCSSRowChecks K :=
        (mem_chainComplexCSSRowChecks K _).2 ⟨Sum.inl k, rfl⟩
      have hgenerator : Coding.PauliSymplectic.GeneratedStabilizer generators
          (chainComplexCSSRowCheck K (Sum.inl k)) :=
        Coding.PauliSymplectic.GeneratedStabilizer.generator
          (⟨chainComplexCSSRowCheck K (Sum.inl k), hrow⟩ :
            {P : Coding.PauliSymplectic.Binary ι // P ∈ chainComplexCSSRowChecks K})
      simpa [chainComplexCSSRowCheck, Coding.canonicalBasisWord, hk1] using hgenerator
  have hsum := generatedStabilizer_cssXCheck_sum generators Finset.univ
    (fun k : κ => Coding.wordLinearMapTranspose K.boundary1 (Pi.single k (y k))) hterm
  have hsum_eq :
      (∑ k ∈ (Finset.univ : Finset κ),
        Coding.wordLinearMapTranspose K.boundary1 (Pi.single k (y k))) =
      Coding.wordLinearMapTranspose K.boundary1 y := by
    rw [← map_sum, Coding.word_eq_sum_single]
  rw [hsum_eq] at hsum
  exact hsum

/-- Every Z check in the middle-boundary range is generated by the Z basis rows. -/
theorem chainComplexCSSRowChecks_generate_cssZCheck_of_mem_middleBoundaryCode
    {ι κ lambda : Type v} [Fintype ι] [DecidableEq ι] [Fintype κ] [Fintype lambda]
    (K : Coding.ChainComplexData
      (ZMod 2) (Coding.Word (ZMod 2) κ) (Coding.Word (ZMod 2) ι)
      (Coding.Word (ZMod 2) lambda))
    {z : Coding.Word (ZMod 2) ι} (hz : z ∈ K.middleBoundaryCode.carrier) :
    Coding.PauliSymplectic.GeneratedStabilizer
      (fun g : {P : Coding.PauliSymplectic.Binary ι // P ∈ chainComplexCSSRowChecks K} => g.1)
      (Coding.PauliSymplectic.cssZCheck z) := by
  classical
  rcases (K.mem_middleBoundaryCode_iff z).1 hz with ⟨y, rfl⟩
  let generators :=
    fun g : {P : Coding.PauliSymplectic.Binary ι // P ∈ chainComplexCSSRowChecks K} => g.1
  change Coding.PauliSymplectic.GeneratedStabilizer generators
    (Coding.PauliSymplectic.cssZCheck (K.boundary2 y))
  have hterm : ∀ l ∈ (Finset.univ : Finset lambda),
      Coding.PauliSymplectic.GeneratedStabilizer generators
        (Coding.PauliSymplectic.cssZCheck (K.boundary2 (Pi.single l (y l)))) := by
    intro l _hl
    by_cases hl0 : y l = 0
    · have hzero : K.boundary2 (Pi.single l (y l)) = 0 := by
        simp [hl0]
      rw [hzero]
      simpa [Coding.PauliSymplectic.binaryOne] using
        (Coding.PauliSymplectic.GeneratedStabilizer.one (generators := generators))
    · have hl1 : y l = 1 := Coding.PauliSymplectic.zmod_two_eq_one_of_ne_zero hl0
      have hrow : chainComplexCSSRowCheck K (Sum.inr l) ∈ chainComplexCSSRowChecks K :=
        (mem_chainComplexCSSRowChecks K _).2 ⟨Sum.inr l, rfl⟩
      have hgenerator : Coding.PauliSymplectic.GeneratedStabilizer generators
          (chainComplexCSSRowCheck K (Sum.inr l)) :=
        Coding.PauliSymplectic.GeneratedStabilizer.generator
          (⟨chainComplexCSSRowCheck K (Sum.inr l), hrow⟩ :
            {P : Coding.PauliSymplectic.Binary ι // P ∈ chainComplexCSSRowChecks K})
      simpa [chainComplexCSSRowCheck, Coding.canonicalBasisWord, hl1] using hgenerator
  have hsum := generatedStabilizer_cssZCheck_sum generators Finset.univ
    (fun l : lambda => K.boundary2 (Pi.single l (y l))) hterm
  have hsum_eq :
      (∑ l ∈ (Finset.univ : Finset lambda), K.boundary2 (Pi.single l (y l))) =
      K.boundary2 y := by
    rw [← map_sum, Coding.word_eq_sum_single]
  rw [hsum_eq] at hsum
  exact hsum

/-- Every declared chain-complex CSS check lies in the closure of the basis-row checks. -/
theorem chainComplexCSSRowChecks_generate_of_mem_binaryCSSCheckSet
    {ι κ lambda : Type v} [Fintype ι] [DecidableEq ι] [Fintype κ] [Fintype lambda]
    (K : Coding.ChainComplexData
      (ZMod 2) (Coding.Word (ZMod 2) κ) (Coding.Word (ZMod 2) ι)
      (Coding.Word (ZMod 2) lambda))
    {P : Coding.PauliSymplectic.Binary ι}
    (hP : P ∈ Coding.PauliSymplectic.binaryCSSCheckSet
      K.firstCoboundaryCheckCode K.middleBoundaryCode) :
    Coding.PauliSymplectic.GeneratedStabilizer
      (fun g : {Q : Coding.PauliSymplectic.Binary ι // Q ∈ chainComplexCSSRowChecks K} => g.1)
      P := by
  rcases hP with ⟨x, hx, rfl⟩ | ⟨z, hz, rfl⟩
  · exact chainComplexCSSRowChecks_generate_cssXCheck_of_mem_firstCoboundaryCheckCode K hx
  · exact chainComplexCSSRowChecks_generate_cssZCheck_of_mem_middleBoundaryCode K hz

/-- The distinct basis-row checks generate the independently defined induced CSS stabilizer group. -/
theorem chainComplexCSSRowChecks_generate_stabilizerGroup
    {ι κ lambda : Type v} [Fintype ι] [DecidableEq ι] [Fintype κ] [Fintype lambda]
    (K : Coding.ChainComplexData
      (ZMod 2) (Coding.Word (ZMod 2) κ) (Coding.Word (ZMod 2) ι)
      (Coding.Word (ZMod 2) lambda)) :
    FinsetGenerates (chainComplexCSSRowChecks K)
      (K.binaryCSSCode).stabilizer.generatedGroup := by
  classical
  letI : Fintype
      {Q : Coding.PauliSymplectic.Binary ι // Q ∈ (K.binaryCSSCode).stabilizer.stabilizers} :=
    Fintype.ofFinite _
  rw [FinsetGenerates]
  ext P
  constructor
  · intro hP
    change Coding.PauliSymplectic.GeneratedStabilizer
      (fun g : {Q : Coding.PauliSymplectic.Binary ι // Q ∈ chainComplexCSSRowChecks K} => g.1)
      P at hP
    unfold Coding.StabilizerCode.generatedGroup
    apply generatedStabilizer_of_generators_generated ?_ hP
    intro g
    have hg : g.1 ∈ (K.binaryCSSCode).stabilizer.stabilizers := by
      rcases (mem_chainComplexCSSRowChecks K g.1).1 g.2 with ⟨c, hc⟩
      rw [← hc]
      change chainComplexCSSRowCheck K c ∈
        Coding.PauliSymplectic.binaryCSSCheckSet
          K.firstCoboundaryCheckCode K.middleBoundaryCode
      exact chainComplexCSSRowCheck_mem_binaryCSSCheckSet K c
    exact Coding.PauliSymplectic.GeneratedStabilizer.generator
      (generators := fun check :
        {Q : Coding.PauliSymplectic.Binary ι // Q ∈ (K.binaryCSSCode).stabilizer.stabilizers} =>
          check.1)
      ⟨g.1, hg⟩
  · intro hP
    unfold Coding.StabilizerCode.generatedGroup at hP
    change Coding.PauliSymplectic.GeneratedStabilizer
      (fun g : {Q : Coding.PauliSymplectic.Binary ι // Q ∈ chainComplexCSSRowChecks K} => g.1)
      P
    apply generatedStabilizer_of_generators_generated ?_ hP
    intro check
    apply chainComplexCSSRowChecks_generate_of_mem_binaryCSSCheckSet K
    change check.1 ∈ Coding.PauliSymplectic.binaryCSSCheckSet
      K.firstCoboundaryCheckCode K.middleBoundaryCode
    exact check.2

@[simp]
theorem chainComplexCSSRowCheck_support_inl
    {ι κ lambda : Type v} [Fintype ι] [Fintype κ] [Fintype lambda]
    (K : Coding.ChainComplexData
      (ZMod 2) (Coding.Word (ZMod 2) κ) (Coding.Word (ZMod 2) ι)
      (Coding.Word (ZMod 2) lambda)) (k : κ) :
    Coding.PauliSymplectic.support (chainComplexCSSRowCheck K (Sum.inl k)) =
      Coding.hammingSupport
        (Coding.wordLinearMapTranspose K.boundary1
          (Coding.canonicalBasisWord (F := ZMod 2) k)) := by
  simp [chainComplexCSSRowCheck]

@[simp]
theorem chainComplexCSSRowCheck_support_inr
    {ι κ lambda : Type v} [Fintype ι] [Fintype κ] [Fintype lambda]
    (K : Coding.ChainComplexData
      (ZMod 2) (Coding.Word (ZMod 2) κ) (Coding.Word (ZMod 2) ι)
      (Coding.Word (ZMod 2) lambda)) (l : lambda) :
    Coding.PauliSymplectic.support (chainComplexCSSRowCheck K (Sum.inr l)) =
      Coding.hammingSupport
        (K.boundary2 (Coding.canonicalBasisWord (F := ZMod 2) l)) := by
  simp [chainComplexCSSRowCheck]

@[simp]
theorem chainComplexCSSRowCheck_weight_inl
    {ι κ lambda : Type v} [Fintype ι] [Fintype κ] [Fintype lambda]
    (K : Coding.ChainComplexData
      (ZMod 2) (Coding.Word (ZMod 2) κ) (Coding.Word (ZMod 2) ι)
      (Coding.Word (ZMod 2) lambda)) (k : κ) :
    Coding.PauliSymplectic.weight (chainComplexCSSRowCheck K (Sum.inl k)) =
      Coding.HammingWeight
        (Coding.wordLinearMapTranspose K.boundary1
          (Coding.canonicalBasisWord (F := ZMod 2) k)) := by
  simp [chainComplexCSSRowCheck]

@[simp]
theorem chainComplexCSSRowCheck_weight_inr
    {ι κ lambda : Type v} [Fintype ι] [Fintype κ] [Fintype lambda]
    (K : Coding.ChainComplexData
      (ZMod 2) (Coding.Word (ZMod 2) κ) (Coding.Word (ZMod 2) ι)
      (Coding.Word (ZMod 2) lambda)) (l : lambda) :
    Coding.PauliSymplectic.weight (chainComplexCSSRowCheck K (Sum.inr l)) =
      Coding.HammingWeight
        (K.boundary2 (Coding.canonicalBasisWord (F := ZMod 2) l)) := by
  simp [chainComplexCSSRowCheck]

@[simp]
theorem chainComplexBoundaryIncidence_incident_inl
    {F : Type u} {ι κ lambda : Type v} [Field F] [Fintype F] [DecidableEq F]
    [Fintype ι] [Fintype κ] [Fintype lambda]
    (K : Coding.ChainComplexData F (Coding.Word F κ) (Coding.Word F ι)
      (Coding.Word F lambda)) (k : κ) (q : ι) :
    (chainComplexBoundaryIncidence K).incident (Sum.inl k) q ↔
      (Coding.wordLinearMapTranspose K.boundary1
        (Coding.canonicalBasisWord (F := F) k)) q ≠ 0 :=
  Iff.rfl

@[simp]
theorem chainComplexBoundaryIncidence_incident_inr
    {F : Type u} {ι κ lambda : Type v} [Field F] [Fintype F] [DecidableEq F]
    [Fintype ι] [Fintype κ] [Fintype lambda]
    (K : Coding.ChainComplexData F (Coding.Word F κ) (Coding.Word F ι)
      (Coding.Word F lambda)) (l : lambda) (q : ι) :
    (chainComplexBoundaryIncidence K).incident (Sum.inr l) q ↔
      (K.boundary2 (Coding.canonicalBasisWord (F := F) l)) q ≠ 0 :=
  Iff.rfl

@[simp]
theorem chainComplexBoundaryIncidence_checkSupport_inl
    {F : Type u} {ι κ lambda : Type v} [Field F] [Fintype F] [DecidableEq F]
    [Fintype ι] [Fintype κ] [Fintype lambda]
    (K : Coding.ChainComplexData F (Coding.Word F κ) (Coding.Word F ι)
      (Coding.Word F lambda)) (k : κ) :
    (chainComplexBoundaryIncidence K).checkSupport (Sum.inl k) =
      Coding.hammingSupport
        (Coding.wordLinearMapTranspose K.boundary1
          (Coding.canonicalBasisWord (F := F) k)) := by
  ext q
  rw [CheckIncidence.mem_checkSupport]
  simp [Coding.hammingSupport, chainComplexBoundaryIncidence]

@[simp]
theorem chainComplexBoundaryIncidence_checkSupport_inr
    {F : Type u} {ι κ lambda : Type v} [Field F] [Fintype F] [DecidableEq F]
    [Fintype ι] [Fintype κ] [Fintype lambda]
    (K : Coding.ChainComplexData F (Coding.Word F κ) (Coding.Word F ι)
      (Coding.Word F lambda)) (l : lambda) :
    (chainComplexBoundaryIncidence K).checkSupport (Sum.inr l) =
      Coding.hammingSupport
        (K.boundary2 (Coding.canonicalBasisWord (F := F) l)) := by
  ext q
  rw [CheckIncidence.mem_checkSupport]
  simp [Coding.hammingSupport, chainComplexBoundaryIncidence]

private theorem wordLinearMapTranspose_single_apply
    {F : Type u} {I K : Type v} [Field F] [Fintype F]
    [Fintype I] [Fintype K]
    (A : Coding.Word F I →ₗ[F] Coding.Word F K) (k : K) (q : I) :
    Coding.wordLinearMapTranspose A
        (Coding.canonicalBasisWord (F := F) k) q =
      A (Coding.canonicalBasisWord (F := F) q) k := by
  classical
  unfold Coding.wordLinearMapTranspose Coding.canonicalBasisWord
  simp only [LinearMap.coe_mk, AddHom.coe_mk]
  rw [Fintype.sum_eq_single k]
  · simp
  · intro k' hne
    simp [hne]

/-- A qubit's incidence degree is exactly the sum of the two boundary-column
weights.  The two summands are disjoint because the check index is a sum. -/
theorem chainComplexBoundaryIncidence_variableSupport_card_eq_boundary_columns
    {F : Type u} {I K L : Type v} [Field F] [Fintype F] [DecidableEq F]
    [Fintype I] [Fintype K] [Fintype L]
    (C : Coding.ChainComplexData F (Coding.Word F K) (Coding.Word F I)
      (Coding.Word F L)) (q : I) :
    ((chainComplexBoundaryIncidence C).variableSupport q).card =
      Coding.HammingWeight
        (C.boundary1 (Coding.canonicalBasisWord (F := F) q)) +
      Coding.HammingWeight
        (Coding.wordLinearMapTranspose C.boundary2
          (Coding.canonicalBasisWord (F := F) q)) := by
  classical
  let x := C.boundary1 (Coding.canonicalBasisWord (F := F) q)
  let z := Coding.wordLinearMapTranspose C.boundary2
    (Coding.canonicalBasisWord (F := F) q)
  have hSupport :
      (chainComplexBoundaryIncidence C).variableSupport q =
        Coding.hammingSupport (Sum.elim x z) := by
    ext c
    rw [CheckIncidence.mem_variableSupport]
    simp only [Coding.hammingSupport, Finset.mem_filter, Finset.mem_univ,
      true_and]
    cases c with
    | inl k =>
        dsimp [chainComplexBoundaryIncidence, x]
        rw [wordLinearMapTranspose_single_apply]
    | inr l =>
        dsimp [chainComplexBoundaryIncidence, z]
        rw [wordLinearMapTranspose_single_apply]
  rw [hSupport]
  change Coding.HammingWeight (Sum.elim x z) =
    Coding.HammingWeight x + Coding.HammingWeight z
  classical
  let e :
      {s : Sum K L // Sum.elim x z s ≠ 0} ≃
        Sum {k : K // x k ≠ 0} {l : L // z l ≠ 0} :=
    { toFun := fun s =>
        match s with
        | ⟨Sum.inl k, hk⟩ => Sum.inl ⟨k, hk⟩
        | ⟨Sum.inr l, hl⟩ => Sum.inr ⟨l, hl⟩
      invFun := fun s =>
        match s with
        | Sum.inl k => ⟨Sum.inl k.1, k.2⟩
        | Sum.inr l => ⟨Sum.inr l.1, l.2⟩
      left_inv := by rintro ⟨k | l, h⟩ <;> rfl
      right_inv := by rintro (k | l) <;> rfl }
  calc
    Coding.HammingWeight (Sum.elim x z) =
        Fintype.card {s : Sum K L // Sum.elim x z s ≠ 0} := by
      simp [Coding.HammingWeight, Coding.hammingSupport,
        Fintype.card_subtype]
    _ = Fintype.card (Sum {k : K // x k ≠ 0} {l : L // z l ≠ 0}) :=
      Fintype.card_congr e
    _ = Coding.HammingWeight x + Coding.HammingWeight z := by
      simp [Coding.HammingWeight, Coding.hammingSupport,
        Fintype.card_subtype]

@[simp]
theorem chainComplexCSSRowCheck_support_eq_checkSupport
    {ι κ lambda : Type v} [Fintype ι] [Fintype κ] [Fintype lambda]
    (K : Coding.ChainComplexData
      (ZMod 2) (Coding.Word (ZMod 2) κ) (Coding.Word (ZMod 2) ι)
      (Coding.Word (ZMod 2) lambda)) (c : Sum κ lambda) :
    Coding.PauliSymplectic.support (chainComplexCSSRowCheck K c) =
      (chainComplexBoundaryIncidence K).checkSupport c := by
  cases c with
  | inl k => simp
  | inr l => simp

/-- Deduplicating equal basis-row checks cannot increase any qubit's check degree. -/
theorem chainComplexCSSRowChecks_qubitCheckDegree_le_incidence
    {ι κ lambda : Type v} [Fintype ι] [Fintype κ] [Fintype lambda]
    (K : Coding.ChainComplexData
      (ZMod 2) (Coding.Word (ZMod 2) κ) (Coding.Word (ZMod 2) ι)
      (Coding.Word (ZMod 2) lambda)) (q : ι) :
    qubitCheckDegree (chainComplexCSSRowChecks K) q ≤
      ((chainComplexBoundaryIncidence K).variableSupport q).card := by
  classical
  calc
    qubitCheckDegree (chainComplexCSSRowChecks K) q ≤
        (((chainComplexBoundaryIncidence K).variableSupport q).image
          (chainComplexCSSRowCheck K)).card := by
      apply Finset.card_le_card
      intro P hP
      rw [Finset.mem_filter] at hP
      rcases (mem_chainComplexCSSRowChecks K P).1 hP.1 with ⟨c, rfl⟩
      rw [Finset.mem_image]
      refine ⟨c, ?_, rfl⟩
      rw [CheckIncidence.mem_variableSupport]
      rw [← CheckIncidence.mem_checkSupport]
      simpa using hP.2
    _ ≤ ((chainComplexBoundaryIncidence K).variableSupport q).card :=
      Finset.card_image_le

/--
Boundary row-weight assumptions and a concrete variable-degree bound imply the
per-code locality profile bound for the induced chain-complex incidence.
-/
theorem chainComplexBoundaryIncidence_boundedLocality_of_boundary_bounds
    {F : Type u} {ι κ lambda : Type v} [Field F] [Fintype F] [DecidableEq F]
    [Fintype ι] [Fintype κ] [Fintype lambda]
    (K : Coding.ChainComplexData F (Coding.Word F κ) (Coding.Word F ι)
      (Coding.Word F lambda))
    {w variableDegree : Nat}
    (hrow1 : ∀ k, Coding.HammingWeight
      (Coding.wordLinearMapTranspose K.boundary1
        (Coding.canonicalBasisWord (F := F) k)) ≤ w)
    (hrow2 : ∀ l, Coding.HammingWeight
      (K.boundary2 (Coding.canonicalBasisWord (F := F) l)) ≤ w)
    (hcol : ∀ q, ((chainComplexBoundaryIncidence K).variableSupport q).card ≤
      variableDegree) :
    Coding.BoundedLocality (chainComplexBoundaryIncidence K).localityProfile
      (max w variableDegree) := by
  refine (chainComplexBoundaryIncidence K).boundedLocality_of_row_col_bounds ?_ ?_
  · intro c
    cases c with
    | inl k =>
        rw [chainComplexBoundaryIncidence_checkSupport_inl]
        exact (hrow1 k).trans (Nat.le_max_left w variableDegree)
    | inr l =>
        rw [chainComplexBoundaryIncidence_checkSupport_inr]
        exact (hrow2 l).trans (Nat.le_max_left w variableDegree)
  · intro q
    exact (hcol q).trans (Nat.le_max_right w variableDegree)

/--
Explicit finite-coordinate chain-complex boundary row/column bounds give an
honest per-code binary qLDPC property for the associated chain-complex CSS code.
-/
theorem exists_binaryChainComplexQLDPCProperty_of_boundary_bounds
    {ι κ lambda : Type u} [Fintype ι] [DecidableEq ι] [Fintype κ] [Fintype lambda]
    (K : Coding.ChainComplexData
      (ZMod 2) (Coding.Word (ZMod 2) κ) (Coding.Word (ZMod 2) ι)
      (Coding.Word (ZMod 2) lambda))
    (parameters : Coding.CodeParameters (ZMod 2) ι)
    {w variableDegree : Nat}
    (hrow1 : ∀ k, Coding.HammingWeight
      (Coding.wordLinearMapTranspose K.boundary1
        (Coding.canonicalBasisWord (F := ZMod 2) k)) ≤ w)
    (hrow2 : ∀ l, Coding.HammingWeight
      (K.boundary2 (Coding.canonicalBasisWord (F := ZMod 2) l)) ≤ w)
    (hcol : ∀ q, ((chainComplexBoundaryIncidence K).variableSupport q).card ≤
      variableDegree) :
    ∃ P : Coding.QLDPCProperty (ZMod 2) ι (Semantics.Qubit.QubitRegister ι)
      (Coding.Word (ZMod 2) κ) (Coding.Word (ZMod 2) ι)
      (Coding.Word (ZMod 2) lambda),
      P.chainCode = K.binaryChainComplexCode ∧
      P.parameters = parameters ∧
      P.locality = (chainComplexBoundaryIncidence K).localityProfile ∧
      P.localityBound = max w variableDegree := by
  refine ⟨QLDPCProperty.ofCheckIncidenceBounds
    K.binaryChainComplexCode parameters (chainComplexBoundaryIncidence K)
    (B := max w variableDegree) ?_ ?_, ?_, ?_, ?_, ?_⟩
  · intro c
    cases c with
    | inl k =>
        rw [chainComplexBoundaryIncidence_checkSupport_inl]
        exact (hrow1 k).trans (Nat.le_max_left w variableDegree)
    | inr l =>
        rw [chainComplexBoundaryIncidence_checkSupport_inr]
        exact (hrow2 l).trans (Nat.le_max_left w variableDegree)
  · intro q
    exact (hcol q).trans (Nat.le_max_right w variableDegree)
  · rfl
  · rfl
  · rfl
  · rfl

/--
Uniform boundary row/check and column/variable bounds for a Nat-indexed binary
chain-complex family give the same bounded-locality witness for every valid
family member after `start`.
-/
theorem eventually_chainComplexBoundaryIncidence_boundedLocality_of_uniform_boundary_bounds
    {ι κ lambda : Nat → Type u}
    [∀ n, Fintype (ι n)] [∀ n, DecidableEq (ι n)]
    [∀ n, Fintype (κ n)] [∀ n, Fintype (lambda n)]
    (validIndex : Nat → Prop) (start : Nat)
    (K : ∀ n, Coding.ChainComplexData
      (ZMod 2) (Coding.Word (ZMod 2) (κ n))
      (Coding.Word (ZMod 2) (ι n))
      (Coding.Word (ZMod 2) (lambda n)))
    {w variableDegree : Nat}
    (hrow1 : ∀ n, start ≤ n → validIndex n → ∀ k,
      Coding.HammingWeight
        (Coding.wordLinearMapTranspose (K n).boundary1
          (Coding.canonicalBasisWord (F := ZMod 2) k)) ≤ w)
    (hrow2 : ∀ n, start ≤ n → validIndex n → ∀ l,
      Coding.HammingWeight ((K n).boundary2
        (Coding.canonicalBasisWord (F := ZMod 2) l)) ≤ w)
    (hcol : ∀ n, start ≤ n → validIndex n → ∀ q,
      ((chainComplexBoundaryIncidence (K n)).variableSupport q).card ≤ variableDegree) :
    ∀ n, start ≤ n → validIndex n →
      Coding.BoundedLocality
        (chainComplexBoundaryIncidence (K n)).localityProfile
        (max w variableDegree) := by
  intro n hn hvalid
  exact chainComplexBoundaryIncidence_boundedLocality_of_boundary_bounds
    (K n)
    (hrow1 n hn hvalid)
    (hrow2 n hn hvalid)
    (hcol n hn hvalid)

/--
Uniform boundary row/check and column/variable bounds for a Nat-indexed binary
chain-complex family give a pointwise qLDPC property with the same locality
bound for every valid family member after `start`.
-/
theorem eventually_exists_binaryChainComplexQLDPCProperty_of_uniform_boundary_bounds
    {ι κ lambda : Nat → Type u}
    [∀ n, Fintype (ι n)] [∀ n, DecidableEq (ι n)]
    [∀ n, Fintype (κ n)] [∀ n, Fintype (lambda n)]
    (validIndex : Nat → Prop) (start : Nat)
    (K : ∀ n, Coding.ChainComplexData
      (ZMod 2) (Coding.Word (ZMod 2) (κ n))
      (Coding.Word (ZMod 2) (ι n))
      (Coding.Word (ZMod 2) (lambda n)))
    (parameters : ∀ n, Coding.CodeParameters (ZMod 2) (ι n))
    {w variableDegree : Nat}
    (hrow1 : ∀ n, start ≤ n → validIndex n → ∀ k,
      Coding.HammingWeight
        (Coding.wordLinearMapTranspose (K n).boundary1
          (Coding.canonicalBasisWord (F := ZMod 2) k)) ≤ w)
    (hrow2 : ∀ n, start ≤ n → validIndex n → ∀ l,
      Coding.HammingWeight ((K n).boundary2
        (Coding.canonicalBasisWord (F := ZMod 2) l)) ≤ w)
    (hcol : ∀ n, start ≤ n → validIndex n → ∀ q,
      ((chainComplexBoundaryIncidence (K n)).variableSupport q).card ≤ variableDegree) :
    ∀ n, start ≤ n → validIndex n →
      ∃ P : Coding.QLDPCProperty (ZMod 2) (ι n)
        (Semantics.Qubit.QubitRegister (ι n))
        (Coding.Word (ZMod 2) (κ n))
        (Coding.Word (ZMod 2) (ι n))
        (Coding.Word (ZMod 2) (lambda n)),
        P.chainCode = (K n).binaryChainComplexCode ∧
        P.parameters = parameters n ∧
        P.locality = (chainComplexBoundaryIncidence (K n)).localityProfile ∧
        P.localityBound = max w variableDegree := by
  intro n hn hvalid
  exact exists_binaryChainComplexQLDPCProperty_of_boundary_bounds
    (K n)
    (parameters n)
    (hrow1 n hn hvalid)
    (hrow2 n hn hvalid)
    (hcol n hn hvalid)

