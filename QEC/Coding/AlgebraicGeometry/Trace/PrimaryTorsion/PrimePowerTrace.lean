/-!
# Primary trace on a cyclic prime-power quotient

This module computes the successive primary-torsion grades of the actual
cyclic quotient `R ⧸ (q ^ e)`.  The construction is symbolic: it uses the
principal-ideal filtration and never enumerates the quotient.

It does not yet treat an arbitrary cyclic quotient, a Smith cokernel, a local
residue, duality, genus, or Riemann--Roch.
-/

namespace QEC.Coding.AlgebraicGeometry

variable {R : Type*} [CommRing R] [IsDomain R]

/-- Multiplication by `r` on the cyclic prime-power quotient. -/
noncomputable def primePowerQuotientMul (q : R) (e : ℕ) (r : R) :
    (R ⧸ Ideal.span {q ^ e}) →ₗ[R] (R ⧸ Ideal.span {q ^ e}) :=
  Algebra.lmul R (R ⧸ Ideal.span {q ^ e})
    (Ideal.Quotient.mk (Ideal.span {q ^ e}) r)

/-- Up to the exponent `e`, the `i`-th primary-torsion layer of
`R ⧸ (q ^ e)` is generated by the class of `q ^ (e - i)`. -/
theorem primaryTorsionLayer_primePowerQuotient (q : R) (hq : q ≠ 0)
    (e i : ℕ) (hi : i ≤ e) :
    primaryTorsionLayer (Ideal.span {q})
        (R ⧸ Ideal.span {q ^ e}) i =
      R ∙ Ideal.Quotient.mk (Ideal.span {q ^ e}) (q ^ (e - i)) := by
  have hpow : q ^ i * q ^ (e - i) = q ^ e := by
    rw [← pow_add, Nat.add_sub_of_le hi]
  rw [← hpow, primaryTorsionLayer, Ideal.span_singleton_pow,
    Submodule.torsionBySet_ideal_span_singleton_eq]
  exact Ideal.Quotient.torsionBy_eq_span_singleton
    (q ^ i) (q ^ (e - i))
      (mem_nonZeroDivisors_of_ne_zero (pow_ne_zero i hq))

private theorem primaryTorsionLayer_primePowerQuotient_eq_map (q : R)
    (hq : q ≠ 0) (e i : ℕ) (hi : i ≤ e) :
    primaryTorsionLayer (Ideal.span {q})
        (R ⧸ Ideal.span {q ^ e}) i =
      Submodule.map (Submodule.mkQ (Ideal.span {q ^ e}))
        ((Ideal.span {q} ^ (e - i) : Ideal R) : Submodule R R) := by
  rw [primaryTorsionLayer_primePowerQuotient q hq e i hi,
    Ideal.span_singleton_pow, ← Ideal.submodule_span_eq,
    Submodule.map_span]
  rw [Set.image_singleton]
  rfl

private def primePowerGradeGenerator (q : R) (hq : q ≠ 0)
    (e i : ℕ) (hi : i < e) :
    primaryTorsionLayer (Ideal.span {q})
      (R ⧸ Ideal.span {q ^ e}) (i + 1) :=
  ⟨Ideal.Quotient.mk (Ideal.span {q ^ e}) (q ^ (e - (i + 1))), by
    rw [primaryTorsionLayer_primePowerQuotient q hq e (i + 1) hi]
    exact Submodule.mem_span_singleton_self _⟩

private def primePowerGradeMap (q : R) (hq : q ≠ 0)
    (e i : ℕ) (hi : i < e) :
    R →ₗ[R] primaryTorsionGrade (Ideal.span {q})
      (R ⧸ Ideal.span {q ^ e}) i :=
  LinearMap.toSpanSingleton R _
    (Submodule.Quotient.mk (primePowerGradeGenerator q hq e i hi))

private theorem primePowerGradeMap_surjective (q : R) (hq : q ≠ 0)
    (e i : ℕ) (hi : i < e) :
    Function.Surjective (primePowerGradeMap q hq e i hi) := by
  intro z
  induction z using Submodule.Quotient.induction_on with
  | _ x =>
      have hx : (x : R ⧸ Ideal.span {q ^ e}) ∈
          R ∙ Ideal.Quotient.mk (Ideal.span {q ^ e})
            (q ^ (e - (i + 1))) := by
        rw [← primaryTorsionLayer_primePowerQuotient q hq e (i + 1) hi]
        exact x.property
      obtain ⟨r, hr⟩ := Submodule.mem_span_singleton.mp hx
      refine ⟨r, ?_⟩
      change r • (Submodule.Quotient.mk
          (primePowerGradeGenerator q hq e i hi) :
            primaryTorsionGrade (Ideal.span {q})
              (R ⧸ Ideal.span {q ^ e}) i) =
        (Submodule.Quotient.mk x :
          primaryTorsionGrade (Ideal.span {q})
            (R ⧸ Ideal.span {q ^ e}) i)
      rw [← Submodule.Quotient.mk_smul]
      congr 2
      apply Subtype.ext
      exact hr

private theorem primePowerGradeMap_ker (q : R) (hq : q ≠ 0)
    (e i : ℕ) (hi : i < e) :
    LinearMap.ker (primePowerGradeMap q hq e i hi) = Ideal.span {q} := by
  ext r
  constructor
  · intro hr
    rw [LinearMap.mem_ker] at hr
    change r • (Submodule.Quotient.mk
        (primePowerGradeGenerator q hq e i hi) :
          primaryTorsionGrade (Ideal.span {q})
            (R ⧸ Ideal.span {q ^ e}) i) = 0 at hr
    rw [← Submodule.Quotient.mk_smul,
      Submodule.Quotient.mk_eq_zero] at hr
    change r • (primePowerGradeGenerator q hq e i hi :
      R ⧸ Ideal.span {q ^ e}) ∈
        primaryTorsionLayer (Ideal.span {q})
          (R ⧸ Ideal.span {q ^ e}) i at hr
    rw [primaryTorsionLayer_primePowerQuotient q hq e i hi.le,
      Submodule.mem_span_singleton] at hr
    obtain ⟨c, hc⟩ := hr
    change Ideal.Quotient.mk (Ideal.span {q ^ e})
        (c * q ^ (e - i)) =
      Ideal.Quotient.mk (Ideal.span {q ^ e})
        (r * q ^ (e - (i + 1))) at hc
    rw [Ideal.Quotient.eq] at hc
    have hpow_le : Ideal.span {q ^ e} ≤ Ideal.span {q ^ (e - i)} := by
      rw [← Ideal.span_singleton_pow, ← Ideal.span_singleton_pow]
      exact Ideal.pow_le_pow_right (Nat.sub_le e i)
    have hcq : c * q ^ (e - i) ∈ Ideal.span {q ^ (e - i)} :=
      Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _)
    have hrq : r * q ^ (e - (i + 1)) ∈ Ideal.span {q ^ (e - i)} := by
      have := (Ideal.span {q ^ (e - i)}).sub_mem hcq (hpow_le hc)
      simpa only [sub_sub_cancel] using this
    have hsub : e - i = (e - (i + 1)) + 1 := by omega
    rw [hsub, pow_succ, Ideal.mem_span_singleton] at hrq
    obtain ⟨d, hd⟩ := hrq
    rw [mul_comm r (q ^ (e - (i + 1))), mul_assoc] at hd
    have hd' : r = q * d :=
      mul_left_cancel₀ (pow_ne_zero (e - (i + 1)) hq) hd
    rw [Ideal.mem_span_singleton]
    exact ⟨d, hd'⟩
  · intro hr
    rw [LinearMap.mem_ker]
    change r • (Submodule.Quotient.mk
        (primePowerGradeGenerator q hq e i hi) :
          primaryTorsionGrade (Ideal.span {q})
            (R ⧸ Ideal.span {q ^ e}) i) = 0
    have hann := primaryTorsionGrade_annihilated
      (R := R) (M := R ⧸ Ideal.span {q ^ e}) (Ideal.span {q}) i
    exact @hann
      (Submodule.Quotient.mk (primePowerGradeGenerator q hq e i hi)) ⟨r, hr⟩

private noncomputable def primaryTorsionGradeEquivPrimePowerQuotientR
    (q : R) (hq : q ≠ 0) (e i : ℕ) (hi : i < e) :
    (R ⧸ Ideal.span {q}) ≃ₗ[R]
      primaryTorsionGrade (Ideal.span {q})
        (R ⧸ Ideal.span {q ^ e}) i :=
  (Submodule.quotEquivOfEq (Ideal.span {q})
      (LinearMap.ker (primePowerGradeMap q hq e i hi))
      (primePowerGradeMap_ker q hq e i hi).symm).trans
    ((primePowerGradeMap q hq e i hi).quotKerEquivOfSurjective
      (primePowerGradeMap_surjective q hq e i hi))

/-- Every nonzero primary grade of `R ⧸ (q ^ e)` is one-dimensional over
`R ⧸ (q)`.  The equivalence is induced by the literal class of
`q ^ (e - i - 1)`. -/
noncomputable def primaryTorsionGradeEquivPrimePowerQuotient
    (q : R) (hq : q ≠ 0) (e i : ℕ) (hi : i < e) :
    letI := primaryTorsionGradeModule
      (M := R ⧸ Ideal.span {q ^ e}) (Ideal.span {q}) i
    (R ⧸ Ideal.span {q}) ≃ₗ[R ⧸ Ideal.span {q}]
      primaryTorsionGrade (Ideal.span {q})
        (R ⧸ Ideal.span {q ^ e}) i := by
  let h := primaryTorsionGrade_annihilated
    (R := R) (M := R ⧸ Ideal.span {q ^ e}) (Ideal.span {q}) i
  letI : Module (R ⧸ Ideal.span {q})
      (primaryTorsionGrade (Ideal.span {q})
        (R ⧸ Ideal.span {q ^ e}) i) := h.module
  let E := primaryTorsionGradeEquivPrimePowerQuotientR q hq e i hi
  exact
    { toEquiv := E.toEquiv
      map_add' := E.map_add
      map_smul' := by
        intro c x
        induction c using Quotient.inductionOn' with
        | _ r =>
            change E (Ideal.Quotient.mk (Ideal.span {q}) r • x) =
              Ideal.Quotient.mk (Ideal.span {q}) r • E x
            rw [Module.IsTorsionBySet.mk_smul h]
            exact E.map_smul r x }

/-- On a quotient representative, the prime-power grade equivalence is
scalar multiplication of the distinguished grade generator. -/
theorem primaryTorsionGradeEquivPrimePowerQuotient_mk
    (q : R) (hq : q ≠ 0) (e i : ℕ) (hi : i < e) (r : R) :
    letI := primaryTorsionGradeModule
      (M := R ⧸ Ideal.span {q ^ e}) (Ideal.span {q}) i
    primaryTorsionGradeEquivPrimePowerQuotient q hq e i hi
        (Ideal.Quotient.mk (Ideal.span {q}) r) =
      Ideal.Quotient.mk (Ideal.span {q}) r •
        primaryTorsionGradeEquivPrimePowerQuotient q hq e i hi 1 := by
  letI := primaryTorsionGradeModule
    (M := R ⧸ Ideal.span {q ^ e}) (Ideal.span {q}) i
  rw [← map_smul]
  change primaryTorsionGradeEquivPrimePowerQuotient q hq e i hi
      (Ideal.Quotient.mk (Ideal.span {q}) r) =
    primaryTorsionGradeEquivPrimePowerQuotient q hq e i hi
      (Ideal.Quotient.mk (Ideal.span {q}) r • 1)
  rw [smul_eq_mul, mul_one]

private theorem primaryTorsionGradeEndomorphism_primePowerQuotientMul
    (q : R) (e i : ℕ) (r : R)
    (z : primaryTorsionGrade (Ideal.span {q})
      (R ⧸ Ideal.span {q ^ e}) i) :
    letI := primaryTorsionGradeModule
      (M := R ⧸ Ideal.span {q ^ e}) (Ideal.span {q}) i
    primaryTorsionGradeEndomorphism (Ideal.span {q})
        (primePowerQuotientMul q e r) i z =
      Ideal.Quotient.mk (Ideal.span {q}) r • z := by
  let h := primaryTorsionGrade_annihilated
    (R := R) (M := R ⧸ Ideal.span {q ^ e}) (Ideal.span {q}) i
  letI : Module (R ⧸ Ideal.span {q})
      (primaryTorsionGrade (Ideal.span {q})
        (R ⧸ Ideal.span {q ^ e}) i) := h.module
  induction z using Submodule.Quotient.induction_on with
  | _ x =>
      rw [primaryTorsionGradeEndomorphism_mk,
        Module.IsTorsionBySet.mk_smul h]
      rfl

/-- Multiplication by `r` has residue `r mod q` as its trace on every
nonzero primary grade of `R ⧸ (q ^ e)`. -/
theorem primaryTorsionGradeTrace_primePowerQuotient
    [IsNoetherianRing R] (q : R) (hq : q ≠ 0)
    [hmax : (Ideal.span {q}).IsMaximal]
    (e i : ℕ) (hi : i < e) (r : R) :
    primaryTorsionGradeTrace (Ideal.span {q})
        (primePowerQuotientMul q e r) i =
      Ideal.Quotient.mk (Ideal.span {q}) r := by
  let p := Ideal.span {q}
  let M := R ⧸ Ideal.span {q ^ e}
  letI : Field (R ⧸ p) := Ideal.Quotient.field p
  letI := primaryTorsionGradeModule (M := M) p i
  letI : Module.Finite (R ⧸ p) (primaryTorsionGrade p M i) :=
    primaryTorsionGradeFinite (M := M) p i
  let E := primaryTorsionGradeEquivPrimePowerQuotient q hq e i hi
  let source : (R ⧸ p) →ₗ[R ⧸ p] (R ⧸ p) :=
    Algebra.lmul (R ⧸ p) (R ⧸ p) (Ideal.Quotient.mk p r)
  let target : primaryTorsionGrade p M i →ₗ[R ⧸ p]
      primaryTorsionGrade p M i :=
    primaryTorsionGradeEndomorphism p (primePowerQuotientMul q e r) i
  have hconj : E.conj source = target := by
    apply LinearMap.ext
    intro z
    obtain ⟨x, rfl⟩ := E.surjective z
    simp only [LinearEquiv.conj_apply, LinearMap.comp_apply,
      LinearEquiv.coe_coe, LinearEquiv.symm_apply_apply]
    rw [primaryTorsionGradeEndomorphism_primePowerQuotientMul]
    exact E.map_smul (Ideal.Quotient.mk p r) x
  change LinearMap.trace (R ⧸ p) (primaryTorsionGrade p M i) target =
    Ideal.Quotient.mk p r
  calc
    _ = LinearMap.trace (R ⧸ p) (primaryTorsionGrade p M i)
        (E.conj source) := congrArg (LinearMap.trace (R ⧸ p) _) hconj.symm
    _ = LinearMap.trace (R ⧸ p) (R ⧸ p) source :=
      LinearMap.trace_conj' source E
    _ = Algebra.trace (R ⧸ p) (R ⧸ p) (Ideal.Quotient.mk p r) :=
      (Algebra.trace_apply (R ⧸ p) (Ideal.Quotient.mk p r)).symm
    _ = Ideal.Quotient.mk p r := Algebra.trace_self_apply _

/-- The depth-`e` primary trace on `R ⧸ (q ^ e)` is `e` times reduction
modulo `q`. -/
theorem primaryTorsionTrace_primePowerQuotient
    [IsNoetherianRing R] (q : R) (hq : q ≠ 0)
    [hmax : (Ideal.span {q}).IsMaximal]
    (e : ℕ) (r : R) :
    primaryTorsionTrace (Ideal.span {q})
        (primePowerQuotientMul q e r) e =
      (e : R ⧸ Ideal.span {q}) *
        Ideal.Quotient.mk (Ideal.span {q}) r := by
  rw [primaryTorsionTrace]
  calc
    (∑ i ∈ Finset.range e,
        primaryTorsionGradeTrace (Ideal.span {q})
          (primePowerQuotientMul q e r) i) =
        ∑ _i ∈ Finset.range e,
          Ideal.Quotient.mk (Ideal.span {q}) r := by
      apply Finset.sum_congr rfl
      intro i hi
      exact primaryTorsionGradeTrace_primePowerQuotient q hq e i
        (Finset.mem_range.mp hi) r
    _ = _ := by
      simp only [Finset.sum_const, Finset.card_range, nsmul_eq_mul]

