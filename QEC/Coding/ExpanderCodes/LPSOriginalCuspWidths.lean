import QEC.Coding.ExpanderCodes.LPSCongruenceSturm
import Mathlib.NumberTheory.ModularForms.Cusps

/-!
# LPSOriginalCuspWidths

Actual minimal widths and original cusp-neighborhood geometry for the same Gamma0 group.
No width, stabilizer, descent, analytic coefficient or quotient topology law is assumed.
These are punctured neighborhoods; cusp filling, analytic gluing, compactness, algebraic
modular curves, arithmetic Hecke/Frobenius correspondence and the PK22 magnitude bound
remain unproved.
-/

namespace QEC.Coding.TannerLiftedProduct
open Complex Filter Topology
open scoped MatrixGroups UpperHalfPlane ModularForm Manifold ContDiff Pointwise
noncomputable section

/-- The actual integral conjugate of the original real Gamma0 subgroup. -/
def lpsOriginalCuspGroup (N : ℕ) (ρ : SL(2,ℤ)) : Subgroup (GL (Fin 2) ℝ) :=
  ConjAct.toConjAct (Matrix.SpecialLinearGroup.mapGL ℝ ρ)⁻¹ •
    (CongruenceSubgroup.Gamma0 N : Subgroup (GL (Fin 2) ℝ))

/-- Minus identity belongs to the actual original Gamma0 group at every level. -/
lemma lpsGamma0_neg_one_mem (N : ℕ) : (-1 : GL (Fin 2) ℝ)∈
    (CongruenceSubgroup.Gamma0 N : Subgroup (GL (Fin 2) ℝ)) := by
  refine ⟨-1,?_,?_⟩
  · apply CongruenceSubgroup.Gamma0_mem.mpr
    simp
  · apply Units.ext
    ext i j
    simp [Matrix.SpecialLinearGroup.mapGL_coe_matrix]

/-- The actual integral cusp conjugate retains minus identity. -/
lemma lpsOriginalCuspGroup_neg_one_mem (N : ℕ) (ρ : SL(2,ℤ)) :
    (-1 : GL (Fin 2) ℝ)∈lpsOriginalCuspGroup N ρ := by
  rw [lpsOriginalCuspGroup,ConjAct.toConjAct_inv,
    Subgroup.mem_inv_pointwise_smul_iff,ConjAct.toConjAct_smul]
  simpa using lpsGamma0_neg_one_mem N

/-- The genuine strict periods and periods agree for the original cusp group. -/
lemma lpsOriginalCuspGroup_regular (N : ℕ) (ρ : SL(2,ℤ)) :
    (lpsOriginalCuspGroup N ρ).IsRegularAtInfty :=
  Subgroup.isRegularAtInfty_of_neg_one_mem (lpsOriginalCuspGroup_neg_one_mem N ρ)

/-- An integral conjugate remains in the actual integral special-linear real range. -/
lemma lpsOriginalCuspGroup_le_SLRange (N : ℕ) (ρ : SL(2,ℤ)) :
    lpsOriginalCuspGroup N ρ ≤ (Matrix.SpecialLinearGroup.mapGL (n:=Fin 2) (R:=ℤ) ℝ).range := by
  intro g hg
  rw [lpsOriginalCuspGroup,ConjAct.toConjAct_inv,
    Subgroup.mem_inv_pointwise_smul_iff,ConjAct.toConjAct_smul] at hg
  rcases hg with ⟨γ,hγ,hγg⟩
  refine ⟨ρ⁻¹*γ*ρ,?_⟩
  simp only [map_mul,map_inv]
  rw [hγg]
  group

/-- The actual cusp subgroup inherits discreteness from the genuine integral range. -/
instance lpsOriginalCuspGroup_discrete (N : ℕ) (ρ : SL(2,ℤ)) :
    DiscreteTopology (lpsOriginalCuspGroup N ρ) :=
  (Matrix.SpecialLinearGroup.discreteSpecialLinearGroupIntRange (n:=Fin 2)).of_subset
    (lpsOriginalCuspGroup_le_SLRange N ρ)

/-- The actual cusp conjugate has determinant one, derived from the original group. -/
instance lpsOriginalCuspGroup_detOne (N : ℕ) (ρ : SL(2,ℤ)) :
    (lpsOriginalCuspGroup N ρ).HasDetOne := by
  unfold lpsOriginalCuspGroup
  infer_instance

/-- The existing genuine common period is retained, without calling it minimal. -/
lemma lpsOriginalCuspGroup_integerPeriod (N : ℕ) (ρ : SL(2,ℤ)) :
    (N:ℝ) ∈ (lpsOriginalCuspGroup N ρ).strictPeriods :=
  lpsGamma0Translate_integerPeriod N ρ

/-- The true minimal strict width is positive, derived from the genuine nonzero period. -/
lemma lpsOriginalCuspGroup_width_positive (N : ℕ) [NeZero N] (ρ : SL(2,ℤ)) :
    0 < (lpsOriginalCuspGroup N ρ).strictWidthInfty := by
  apply Subgroup.strictWidthInfty_pos_iff.mpr
  exact Subgroup.isCusp_of_mem_strictPeriods
    (by exact_mod_cast Nat.pos_of_ne_zero (NeZero.ne N))
    (lpsOriginalCuspGroup_integerPeriod N ρ)

/-- The actual discrete period group is generated by its true minimal strict width. -/
lemma lpsOriginalCuspGroup_periods_generated (N : ℕ) (ρ : SL(2,ℤ)) :
    (lpsOriginalCuspGroup N ρ).strictPeriods =
      AddSubgroup.zmultiples (lpsOriginalCuspGroup N ρ).strictWidthInfty :=
  Subgroup.strictPeriods_eq_zmultiples_strictWidthInfty

/-- Adjoining minus identity does not change the actual minimal cusp width. -/
lemma lpsOriginalCuspGroup_width_eq (N : ℕ) (ρ : SL(2,ℤ)) :
    (lpsOriginalCuspGroup N ρ).widthInfty =
      (lpsOriginalCuspGroup N ρ).strictWidthInfty := by
  rw [Subgroup.widthInfty,
    Subgroup.adjoinNegOne_eq_self_iff.mpr (lpsOriginalCuspGroup_neg_one_mem N ρ)]

/-- An actual integral determinant-one matrix fixing infinity is a signed translation. -/
lemma lpsIntegralFixInfinity_translation (g : GL (Fin 2) ℝ)
    (hg : g ∈ (Matrix.SpecialLinearGroup.mapGL (n:=Fin 2) (R:=ℤ) ℝ).range)
    (hc : g 1 0=0) :
    ∃ x : ℝ, g=Matrix.GeneralLinearGroup.upperRightHom x ∨
      g= -Matrix.GeneralLinearGroup.upperRightHom x := by
  rcases hg with ⟨γ,rfl⟩
  have hcZ : γ 1 0=0 := by
    have he : (Matrix.SpecialLinearGroup.mapGL ℝ γ) 1 0=(γ 1 0:ℝ) := by
      simp [Matrix.SpecialLinearGroup.mapGL_coe_matrix]
    rw [he] at hc
    exact_mod_cast hc
  have hd := γ.det_coe
  rw [Matrix.det_fin_two,hcZ,mul_zero,sub_zero] at hd
  rcases Int.eq_one_or_neg_one_of_mul_eq_one' hd with ⟨ha,hd⟩|⟨ha,hd⟩
  · refine ⟨(γ 0 1:ℝ),Or.inl ?_⟩
    apply Units.ext
    ext i j
    fin_cases i <;> fin_cases j <;>
      simp [Matrix.SpecialLinearGroup.mapGL_coe_matrix,Matrix.GeneralLinearGroup.upperRightHom,
        ha,hd,hcZ]
  · refine ⟨-(γ 0 1:ℝ),Or.inr ?_⟩
    apply Units.ext
    ext i j
    fin_cases i <;> fin_cases j <;>
      simp [Matrix.SpecialLinearGroup.mapGL_coe_matrix,Matrix.GeneralLinearGroup.upperRightHom,
        ha,hd,hcZ]

/-- The true cusp stabilizer consists of integer minimal-width translations up to center. -/
lemma lpsOriginalCuspGroup_stabilizer_generated (N : ℕ) (ρ : SL(2,ℤ))
    (g : GL (Fin 2) ℝ) (hg : g∈lpsOriginalCuspGroup N ρ)
    (hfix : g • (OnePoint.infty : OnePoint ℝ)=OnePoint.infty) :
    ∃ m : ℤ, g=Matrix.GeneralLinearGroup.upperRightHom
        (m • (lpsOriginalCuspGroup N ρ).strictWidthInfty) ∨
      g= -Matrix.GeneralLinearGroup.upperRightHom
        (m • (lpsOriginalCuspGroup N ρ).strictWidthInfty) := by
  obtain ⟨x,hx⟩ := lpsIntegralFixInfinity_translation g
    (lpsOriginalCuspGroup_le_SLRange N ρ hg) (OnePoint.smul_infty_eq_self_iff.mp hfix)
  have hp : x∈(lpsOriginalCuspGroup N ρ).strictPeriods := by
    apply Subgroup.mem_strictPeriods_iff.mpr
    rcases hx with he|he
    · rwa [←he]
    · have hneg := Subgroup.mul_mem (lpsOriginalCuspGroup N ρ)
        (lpsOriginalCuspGroup_neg_one_mem N ρ) hg
      simpa [he] using hneg
  rw [lpsOriginalCuspGroup_periods_generated] at hp
  obtain ⟨m,hm⟩ := AddSubgroup.mem_zmultiples_iff.mp hp
  exact ⟨m,hm.symm ▸ hx⟩

end
end QEC.Coding.TannerLiftedProduct
