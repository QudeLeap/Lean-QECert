import QEC.Coding.ExpanderCodes.FiniteFieldQuadraticSplitting
import Mathlib.LinearAlgebra.Matrix.GeneralLinearGroup.Projective

/-!
# Unbounded projective special linear groups

Upper unipotent matrices give an explicit injection of the coefficient field
into PSL₂, and hence into PGL₂. Even-degree finite extensions therefore give
actual finite PSL₂ groups of unbounded order, together with the irreducible
specialization and quadratic splitting parameters used in [DEL21, Section 6.2].
This does not identify the subgroup generated by the arithmetic generators
with PSL₂ and does not assert a spectral bound.
-/

namespace QEC.Coding.ExpanderCodes.ProjectiveLinearSize

open Matrix

variable {K : Type*} [Field K]

/-- An actual determinant-one upper unipotent matrix. -/
def upperUnipotent (t : K) : Matrix.SpecialLinearGroup (Fin 2) K :=
  ⟨!![1, t; 0, 1], by simp [Matrix.det_fin_two]⟩

/-- Its class modulo the center of SL₂. -/
def projectiveUpper (t : K) : Matrix.ProjectiveSpecialLinearGroup (Fin 2) K :=
  QuotientGroup.mk (upperUnipotent t)

/-- Passing to the projective quotient does not identify distinct unipotents. -/
theorem projectiveUpper_injective : Function.Injective (projectiveUpper (K := K)) := by
  intro t u h
  have hPGL :
      Matrix.ProjGenLinGroup.mk (Matrix.SpecialLinearGroup.toGL (upperUnipotent t)) =
        Matrix.ProjGenLinGroup.mk (Matrix.SpecialLinearGroup.toGL (upperUnipotent u)) :=
    congrArg Matrix.ProjectiveSpecialLinearGroup.toPGL h
  obtain ⟨c, hc⟩ := Matrix.ProjGenLinGroup.mk_eq_mk_iff.mp hPGL
  have h00 := congrArg
    (fun g : Matrix.GeneralLinearGroup (Fin 2) K => (g : Matrix (Fin 2) (Fin 2) K) 0 0) hc
  change (!![1, t; 0, 1] * Matrix.scalar (Fin 2) (c : K)) 0 0 =
    (!![1, u; 0, 1] : Matrix (Fin 2) (Fin 2) K) 0 0 at h00
  have hcOne : (c : K) = 1 := by
    simpa [Matrix.mul_apply, Fin.sum_univ_two,
      Matrix.scalar, Matrix.diagonal] using h00
  have h01 := congrArg
    (fun g : Matrix.GeneralLinearGroup (Fin 2) K => (g : Matrix (Fin 2) (Fin 2) K) 0 1) hc
  change (!![1, t; 0, 1] * Matrix.scalar (Fin 2) (c : K)) 0 1 =
    (!![1, u; 0, 1] : Matrix (Fin 2) (Fin 2) K) 0 1 at h01
  simpa [Matrix.mul_apply, Fin.sum_univ_two,
    Matrix.scalar, Matrix.diagonal, hcOne] using h01

theorem field_card_le_psl_card [Finite K] :
    Nat.card K ≤ Nat.card (Matrix.ProjectiveSpecialLinearGroup (Fin 2) K) :=
  Nat.card_le_card_of_injective projectiveUpper projectiveUpper_injective

theorem field_card_le_pgl_card [Finite K] :
    Nat.card K ≤ Nat.card (Matrix.ProjGenLinGroup (Fin 2) K) := by
  let : Finite (Matrix.ProjGenLinGroup (Fin 2) K) :=
    Quotient.finite _
  exact Nat.card_le_card_of_injective
    (Matrix.ProjectiveSpecialLinearGroup.toPGL ∘ projectiveUpper)
    (Matrix.ProjectiveSpecialLinearGroup.toPGL_injective.comp projectiveUpper_injective)

/-- The finite PSL₂ groups in even-degree extensions are cofinal in size;
the specialization and square root are actual elements, not certificate inputs. -/
theorem exists_large_even_psl (p N : ℕ) [hPrime : Fact p.Prime]
    (epsilon : ZMod p) (hEpsilon : epsilon ≠ 0)
    (hNonSquare : ∀ r : ZMod p, r ^ 2 ≠ epsilon) :
    ∃ n : ℕ, 1 < n ∧
      N ≤ Nat.card (Matrix.ProjectiveSpecialLinearGroup (Fin 2) (GaloisField p (2 * n))) ∧
      ∃ y r : GaloisField p (2 * n), y ≠ 0 ∧ 1 + y ≠ 0 ∧ r ≠ 0 ∧
        r ^ 2 = algebraMap (ZMod p) (GaloisField p (2 * n)) epsilon ∧
        Irreducible (minpoly (ZMod p) y) ∧
        (minpoly (ZMod p) y).natDegree = 2 * n := by
  refine ⟨N + 2, by omega, ?_,
    exists_split_full_degree_parameter p (N + 2) (by omega)
      epsilon hEpsilon hNonSquare⟩
  apply le_trans _ (field_card_le_psl_card (K := GaloisField p (2 * (N + 2))))
  rw [GaloisField.card p (2 * (N + 2)) (by omega)]
  have hPow := Nat.lt_pow_self hPrime.out.one_lt (n := 2 * (N + 2))
  omega

end QEC.Coding.ExpanderCodes.ProjectiveLinearSize
