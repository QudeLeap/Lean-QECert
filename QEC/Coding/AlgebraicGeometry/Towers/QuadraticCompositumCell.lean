import QEC.Coding.AlgebraicGeometry.Towers.QuadraticGlobalNormalization
import QEC.Coding.AlgebraicGeometry.Towers.QuadraticGlobalDifferent
import QEC.Coding.AlgebraicGeometry.Differents.TrivialFieldExtension
import Mathlib.Algebra.Polynomial.Degree.IsMonicOfDegree

/-!
# A normalized quadratic compositum cell at a fixed prime

This is the oriented characteristic-two step in Garcia--Stichtenoth (2005),
Lemma 1. The lower extension is given by its actual equation and generator.
The other generator is corrected inside the actual first upper field. Its
equation and generated field are preserved, and the different of the new
upper edge is computed at the specified prime, not at a selected extension.

Applying the same statement with the lower edges exchanged gives the other
orientation of the compositum square. No cumulative different is an input.
-/

open IntermediateField

namespace QEC.Coding.AlgebraicGeometry.F256GarciaStichtenoth

noncomputable section

/-- An actual field generated by a root of a quadratic equation has degree
one or two. The redundant compositum case is not discarded. -/
theorem literalQuadratic_finrank_eq_one_or_two
    {K E : Type*} [_root_.Field K] [_root_.Field E] [Algebra K E]
    [FiniteDimensional K E] (a : K) (z : E)
    (hz : z ^ 2 + z = algebraMap K E a) (hgen : K⟮z⟯ = ⊤) :
    Module.finrank K E = 1 ∨ Module.finrank K E = 2 := by
  let p : Polynomial K := Polynomial.X ^ 2 + Polynomial.X - Polynomial.C a
  have hp : p.Monic := by
    simpa only [p, sub_eq_add_neg, ← Polynomial.C_neg,
      Polynomial.C_1, one_mul] using
      (Polynomial.isMonicOfDegree_add_add_two (1 : K) (-a)).monic
  have hpdegree : p.natDegree = 2 := by
    simpa only [p, sub_eq_add_neg, ← Polynomial.C_neg,
      Polynomial.C_1, one_mul] using
      (Polynomial.isMonicOfDegree_add_add_two (1 : K) (-a)).natDegree_eq
  have hroot : Polynomial.aeval z p = 0 := by
    simpa only [p, map_sub, map_add, map_pow, Polynomial.aeval_X,
      Polynomial.aeval_C, sub_eq_zero] using hz
  have hi : IsIntegral K z := ⟨p, hp, hroot⟩
  have hbound : Module.finrank K E ≤ 2 := by
    have hm := Polynomial.natDegree_le_of_dvd (minpoly.dvd K z hroot) hp.ne_zero
    rw [← IntermediateField.adjoin.finrank hi, hgen,
      IntermediateField.finrank_top', hpdegree] at hm
    exact hm
  have hpos := Module.finrank_pos (R := K) (M := E)
  omega

/-- Translation by a base-field element does not change a simple extension. -/
theorem adjoin_add_algebraMap_eq {K L : Type*} [_root_.Field K] [_root_.Field L]
    [Algebra K L] (y : L) (c : K) :
    K⟮y + algebraMap K L c⟯ = K⟮y⟯ := by
  apply le_antisymm
  · rw [IntermediateField.adjoin_simple_le_iff]
    exact (K⟮y⟯).add_mem (IntermediateField.mem_adjoin_simple_self K y)
      ((K⟮y⟯).algebraMap_mem c)
  · rw [IntermediateField.adjoin_simple_le_iff]
    have h := (K⟮y + algebraMap K L c⟯).sub_mem
      (IntermediateField.mem_adjoin_simple_self K (y + algebraMap K L c))
      ((K⟮y + algebraMap K L c⟯).algebraMap_mem c)
    simpa only [add_sub_cancel_right] using h

/-- The corrected generator satisfies the corrected Artin--Schreier equation
in the unchanged upper field. -/
theorem artinSchreier_baseChange_translate_equation
    {K L E : Type*} [_root_.Field K] [_root_.Field L] [_root_.Field E]
    [Algebra F256 E] [Algebra K L] [Algebra K E] [Algebra L E]
    [IsScalarTower K L E] (b : K) (z : E)
    (hz : z ^ 2 + z = algebraMap K E b) (c : L) :
    (z + algebraMap L E c) ^ 2 + (z + algebraMap L E c) =
      algebraMap L E (algebraMap K L b + c ^ 2 + c) := by
  letI : CharP F256 2 :=
    charP_of_injective_algebraMap (algebraMap (ZMod 2) F256).injective 2
  letI : CharP E 2 :=
    charP_of_injective_algebraMap (algebraMap F256 E).injective 2
  have htwo : (2 : E) = 0 := CharP.cast_eq_zero E 2
  rw [add_sq, htwo]
  simp only [zero_mul, add_zero, map_add, map_pow,
    ← IsScalarTower.algebraMap_apply K L E]
  linear_combination hz

section IntegralModels

variable (A B C D K L E : Type*)
    [CommRing A] [CommRing B] [CommRing C] [CommRing D]
    [_root_.Field K] [_root_.Field L] [_root_.Field E]
    [IsDomain A] [IsLocalRing A]
    [IsDedekindDomain B] [IsDedekindDomain C] [IsDedekindDomain D]
    [Algebra F256 K] [Algebra F256 L] [Algebra F256 E]
    [Algebra A B] [Algebra.IsIntegral A B] [Module.IsTorsionFree A B]
    [Algebra A C] [Algebra.IsIntegral A C] [Module.IsTorsionFree A C]
    [Algebra B K] [IsFractionRing B K]
    [Algebra K L] [Algebra B L] [IsScalarTower B K L]
    [Algebra B C] [Algebra C L] [IsFractionRing C L] [IsScalarTower B C L]
    [IsIntegralClosure C B L] [Module.IsTorsionFree B C]
    [FiniteDimensional K L] [Algebra.IsSeparable K L]
    [Module.IsTorsionFree B L]
    [Algebra K E] [Algebra L E] [IsScalarTower K L E]
    [Algebra C E] [IsScalarTower C L E]
    [Algebra C D] [Algebra D E] [IsScalarTower C D E]
    [IsIntegralClosure D C E] [Module.IsTorsionFree C D]
    [FiniteDimensional L E] [Algebra.IsSeparable L E]
    [Module.IsTorsionFree C E]

include A in
/-- One genuine quadratic upper edge of the compositum square. The returned
parameter and generator can be used in the next square: their normalization,
literal equation, full generation, and actual different are all proved. -/
theorem quadraticCompositumCell_normalized_weakDifferent
    (H : IsDedekindDomain.HeightOneSpectrum B)
    [Finite (heightOnePlace (k := F256) (K := K) H).residueField]
    (P : IsDedekindDomain.HeightOneSpectrum C) [P.asIdeal.LiesOver H.asIdeal]
    (Q : IsDedekindDomain.HeightOneSpectrum D) [Q.asIdeal.LiesOver P.asIdeal]
    (a b : K) (y : L) (z : E)
    (hy : y ^ 2 + y = algebraMap K L a)
    (hz : z ^ 2 + z = algebraMap K E b)
    (hdegree : Module.finrank K L = 2) (hgen : K⟮y⟯ = ⊤)
    (hdegreeUpper : Module.finrank L E = 2) (hgenUpper : L⟮z⟯ = ⊤)
    (ha : (heightOnePlace (k := F256) (K := K) H).order a = -1 ∨
      0 ≤ (heightOnePlace (k := F256) (K := K) H).order a)
    (hb : (heightOnePlace (k := F256) (K := K) H).order b = -1 ∨
      0 ≤ (heightOnePlace (k := F256) (K := K) H).order b) :
    ∃ c : L,
      ((heightOnePlace (k := F256) (K := L) P).order
          (algebraMap K L b + c ^ 2 + c) = -1 ∨
        0 ≤ (heightOnePlace (k := F256) (K := L) P).order
          (algebraMap K L b + c ^ 2 + c)) ∧
      (z + algebraMap L E c) ^ 2 + (z + algebraMap L E c) =
        algebraMap L E (algebraMap K L b + c ^ 2 + c) ∧
      L⟮z + algebraMap L E c⟯ = ⊤ ∧
      multiplicity Q.asIdeal (differentIdeal C D) =
        2 * (P.asIdeal.ramificationIdx' Q.asIdeal - 1) := by
  obtain ⟨c, _, hc⟩ := quadraticLiteral_integralModel_normalizing_correction
    A B C K L H P a y hy hdegree hgen ha b hb
  have heq := artinSchreier_baseChange_translate_equation b z hz c
  have hgenerates : L⟮z + algebraMap L E c⟯ = ⊤ := by
    rw [adjoin_add_algebraMap_eq, hgenUpper]
  refine ⟨c, hc, heq, hgenerates, ?_⟩
  exact quadraticLiteral_integralModel_weakDifferent A C D L E P Q
    (algebraMap K L b + c ^ 2 + c) (z + algebraMap L E c)
    heq hdegreeUpper hgenerates hc

include A in
/-- The same cell without degree or linear-disjointness assumptions. Both
degrees are derived from the literal equations and generation. Degree-one
steps preserve orders and contribute unit different; genuine quadratic
steps use the residue-square correction. -/
theorem quadraticCompositumCell_normalized_weakDifferent_or_redundant
    [IsFractionRing D E]
    (H : IsDedekindDomain.HeightOneSpectrum B)
    [Finite (heightOnePlace (k := F256) (K := K) H).residueField]
    (P : IsDedekindDomain.HeightOneSpectrum C) [P.asIdeal.LiesOver H.asIdeal]
    (Q : IsDedekindDomain.HeightOneSpectrum D) [Q.asIdeal.LiesOver P.asIdeal]
    (a b : K) (y : L) (z : E)
    (hy : y ^ 2 + y = algebraMap K L a)
    (hz : z ^ 2 + z = algebraMap K E b)
    (hgen : K⟮y⟯ = ⊤) (hgenUpper : L⟮z⟯ = ⊤)
    (ha : (heightOnePlace (k := F256) (K := K) H).order a = -1 ∨
      0 ≤ (heightOnePlace (k := F256) (K := K) H).order a)
    (hb : (heightOnePlace (k := F256) (K := K) H).order b = -1 ∨
      0 ≤ (heightOnePlace (k := F256) (K := K) H).order b) :
    ∃ c : L,
      ((heightOnePlace (k := F256) (K := L) P).order
          (algebraMap K L b + c ^ 2 + c) = -1 ∨
        0 ≤ (heightOnePlace (k := F256) (K := L) P).order
          (algebraMap K L b + c ^ 2 + c)) ∧
      (z + algebraMap L E c) ^ 2 + (z + algebraMap L E c) =
        algebraMap L E (algebraMap K L b + c ^ 2 + c) ∧
      L⟮z + algebraMap L E c⟯ = ⊤ ∧
      multiplicity Q.asIdeal (differentIdeal C D) =
        2 * (P.asIdeal.ramificationIdx' Q.asIdeal - 1) := by
  letI : Module.Finite B C := IsIntegralClosure.finite B K L C
  letI : Module.Finite C D := IsIntegralClosure.finite C L E D
  obtain ⟨c, hc⟩ : ∃ c : L,
      (heightOnePlace (k := F256) (K := L) P).order
          (algebraMap K L b + c ^ 2 + c) = -1 ∨
        0 ≤ (heightOnePlace (k := F256) (K := L) P).order
          (algebraMap K L b + c ^ 2 + c) := by
    rcases literalQuadratic_finrank_eq_one_or_two a y hy hgen with hdeg | hdeg
    · refine ⟨0, ?_⟩
      simpa only [zero_pow (by decide : 2 ≠ 0), add_zero,
        heightOnePlace_order_algebraMap_of_finrank_eq_one B C K L H P hdeg b] using hb
    · obtain ⟨c, _, hc⟩ := quadraticLiteral_integralModel_normalizing_correction
        A B C K L H P a y hy hdeg hgen ha b hb
      exact ⟨c, hc⟩
  have heq := artinSchreier_baseChange_translate_equation b z hz c
  have hgenerates : L⟮z + algebraMap L E c⟯ = ⊤ := by
    rw [adjoin_add_algebraMap_eq, hgenUpper]
  refine ⟨c, hc, heq, hgenerates, ?_⟩
  rcases literalQuadratic_finrank_eq_one_or_two
    (algebraMap K L b + c ^ 2 + c) (z + algebraMap L E c)
    heq hgenerates with hdeg | hdeg
  · exact (ramificationIdx_and_weakDifferent_of_finrank_eq_one
      C D L E P Q hdeg).2
  · exact quadraticLiteral_integralModel_weakDifferent A C D L E P Q
      (algebraMap K L b + c ^ 2 + c) (z + algebraMap L E c)
      heq hdeg hgenerates hc

end IntegralModels

end

end QEC.Coding.AlgebraicGeometry.F256GarciaStichtenoth
