import QEC.Coding.HighDimensionalExpander.CartwrightSteger.Projective.Index

/-!
# The finite-image consequence of the Cartwright--Steger norm class

This file isolates the group-theoretic content of LSV Proposition `whatisr`.
Once a projective element has determinant class of full order, adjoining it
to `PSL_d(K)` generates all of `PGL_d(K)`.  The later arithmetic reduction
therefore only has to identify the reduced norm of the actual
Cartwright--Steger element `b` with the selected class `y / (1 + y)`.
-/

namespace QEC.Coding.HighDimensionalExpander.CartwrightSteger

open scoped MatrixGroups

namespace ProjectiveIndex

variable {G Q : Type*} [Group G] [Group Q]

/-- If one element generates the target of a surjective group homomorphism,
then that element together with the kernel generates the source. -/
theorem ker_sup_zpowers_eq_top_of_image_zpowers_eq_top
    (f : G →* Q) (b : G)
    (hb : Subgroup.zpowers (f b) = ⊤) :
    f.ker ⊔ Subgroup.zpowers b = ⊤ := by
  apply top_unique
  intro g _
  have hfg : f g ∈ Subgroup.zpowers (f b) := by
    rw [hb]
    exact Subgroup.mem_top _
  obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.mp hfg
  have hker : g * b ^ (-k) ∈ f.ker := by
    rw [MonoidHom.mem_ker, map_mul, map_zpow, ← hk]
    simp
  have hzpow : b ^ k ∈ Subgroup.zpowers b :=
    Subgroup.zpow_mem_zpowers b k
  have hproduct : (g * b ^ (-k)) * b ^ k ∈
      f.ker ⊔ Subgroup.zpowers b :=
    Subgroup.mul_mem_sup hker hzpow
  simpa [← mul_assoc] using hproduct

variable (n K : Type*) [Fintype n] [DecidableEq n]
  [Nonempty n] [Field K] [Fintype K]

/-- The subgroup generated by projective special-linear matrices and one
projective element. -/
noncomputable def generatedProjectiveImage (b : PGL(n, K)) :
    Subgroup PGL(n, K) :=
  projectiveSpecialLinear n K ⊔ Subgroup.zpowers b

/-- A full-order determinant class supplies the whole projective group. -/
theorem generatedProjectiveImage_eq_top
    (b : PGL(n, K))
    (horder : orderOf (projectiveDetClass n K b) =
      Nat.card (DetPowerClass n K)) :
    generatedProjectiveImage n K b = ⊤ := by
  have hz : Subgroup.zpowers (projectiveDetClass n K b) = ⊤ := by
    apply (Subgroup.card_eq_iff_eq_top
      (Subgroup.zpowers (projectiveDetClass n K b))).mp
    rw [Nat.card_zpowers, horder]
  rw [generatedProjectiveImage,
    ← ker_projectiveDetClass_eq_projectiveSpecialLinear n K]
  exact ker_sup_zpowers_eq_top_of_image_zpowers_eq_top
    (projectiveDetClass n K) b
    hz

end ProjectiveIndex

/-- A construction-owned `GL` representative whose determinant is exactly
the class selected by `Chooseorder`.  This is the target determinant class
for the later reduction of the genuine Cartwright--Steger element `b`. -/
noncomputable def indexWitnessGL
    (P : BasePrime) (r : Rank) (level : Nat) :
    Matrix.GeneralLinearGroup (Fin r.matrixRank)
      (ResidueField P r level) :=
  Classical.choose
    (ProjectiveIndex.generalLinear_det_surjective
      (Fin r.matrixRank) (ResidueField P r level)
      (indexRatioUnit P r level))

theorem indexWitnessGL_det
    (P : BasePrime) (r : Rank) (level : Nat) :
    Matrix.GeneralLinearGroup.det (indexWitnessGL P r level) =
      indexRatioUnit P r level :=
  Classical.choose_spec
    (ProjectiveIndex.generalLinear_det_surjective
      (Fin r.matrixRank) (ResidueField P r level)
      (indexRatioUnit P r level))

/-- Projective representative of the selected determinant class. -/
noncomputable def indexWitness
    (P : BasePrime) (r : Rank) (level : Nat) : PGL P r level :=
  Matrix.ProjGenLinGroup.mk (indexWitnessGL P r level)

theorem residueProjectiveDetClass_indexWitness
    (P : BasePrime) (r : Rank) (level : Nat) :
    residueProjectiveDetClass P r level (indexWitness P r level) =
      (QuotientGroup.mk (indexRatioUnit P r level) :
        ResiduePowerClass P r level) := by
  rw [indexWitness, residueProjectiveDetClass]
  change QuotientGroup.mk' _
      (Matrix.GeneralLinearGroup.det (indexWitnessGL P r level)) = _
  rw [indexWitnessGL_det]
  rfl

theorem residueProjectiveDetClass_indexWitness_orderOf
    (P : BasePrime) (r : Rank) (level : Nat) :
    orderOf
        (residueProjectiveDetClass P r level (indexWitness P r level)) =
      Nat.card (ResiduePowerClass P r level) := by
  rw [residueProjectiveDetClass_indexWitness,
    indexRatioUnit_orderOf, IndexSelection.natCard_powerClass]
  simp only [Fintype.card_fin]

/-- The selected determinant class is large enough to generate all of the
finite projective group once `PSL` is present. -/
theorem PSL_sup_indexWitness_eq_PGL
    (P : BasePrime) (r : Rank) (level : Nat) :
    PSL P r level ⊔ Subgroup.zpowers (indexWitness P r level) = ⊤ := by
  exact ProjectiveIndex.generatedProjectiveImage_eq_top
      (Fin r.matrixRank) (ResidueField P r level)
      (indexWitness P r level)
      (residueProjectiveDetClass_indexWitness_orderOf P r level)

end QEC.Coding.HighDimensionalExpander.CartwrightSteger
