    rw [htag] at hbase
    simp [rxOriginalCentralBoundaryVertexMap, rxOriginalCentralZTag,
      rxOriginalCentralZCoordinate, rxOriginalCentralCell] at hbase
    have holdZ : oldZ = z :=
      (rxOriginalCentralZFaceOwner P A4 x oldZ oldMember).2.symm.trans hbase
    subst oldZ
