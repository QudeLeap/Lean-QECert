import QEC.Coding.AlgebraicGeometry.Towers.SourceGaloisWIntermediate
import QEC.Coding.AlgebraicGeometry.Towers.StepPlaceTransport
import QEC.Coding.AlgebraicGeometry.Towers.ZeroPlace
import QEC.Coding.AlgebraicGeometry.Divisors.RationalBaseInfinityCancellation

/-!
# The zero and infinity places of the source F256(w) intermediate field

The Stichtenoth ramification calculation is made over the rational function
field generated by the literal element `w = x₀^16 + x₀`.  This file
identifies that intermediate field with a rational function field and
transports the genuine zero and infinity valuations to it.  The resulting
places are distinguished by the actual orders `1` and `-1` of `w`.

No upper fibre, ramification index, different, divisor, genus, or canonical
differential is asserted here.
-/

namespace QEC.Coding.AlgebraicGeometry.F256GarciaStichtenoth

noncomputable section

open IntermediateField Polynomial

/-- The literal intermediate coordinate `w = x₀^16 + x₀` is
transcendental over `F256`. -/
theorem sourceGaloisBaseW_transcendental : Transcendental F256 galoisBaseW := by
  have hdegree :
      (Polynomial.X ^ 16 + Polynomial.X : Polynomial F256).natDegree = 16 := by
    calc
      (Polynomial.X ^ 16 + Polynomial.X : Polynomial F256).natDegree =
          (Polynomial.X ^ 16 : Polynomial F256).natDegree :=
        Polynomial.natDegree_add_eq_left_of_natDegree_lt (by norm_num)
      _ = 16 := by norm_num
  have hmonic :
      (Polynomial.X ^ 16 + Polynomial.X : Polynomial F256).Monic :=
    Polynomial.monic_X_pow_add (by norm_num)
  have hw :
      galoisBaseW = algebraMap (Polynomial F256) (RatFunc F256)
        (Polynomial.X ^ 16 + Polynomial.X) := by
    simp [galoisBaseW, RatFunc.algebraMap_X]
  rw [hw]
  simpa only [RatFunc.aeval_X_left_eq_algebraMap] using
    RatFunc.transcendental_X.aeval
      (Polynomial.X ^ 16 + Polynomial.X : Polynomial F256)
      (by simp [hdegree])
      (by simp [hmonic.leadingCoeff])

/-- The actual generator `w` in the intermediate field `F256(w)`. -/
noncomputable def sourceGaloisWFieldGenerator : SourceGaloisWField :=
  ⟨galoisBaseW, by
    change galoisBaseW ∈ IntermediateField.adjoin F256 {galoisBaseW}
    exact IntermediateField.subset_adjoin F256 {galoisBaseW}
      (Set.mem_singleton galoisBaseW)⟩

@[simp]
theorem coe_sourceGaloisWFieldGenerator :
    (sourceGaloisWFieldGenerator : RatFunc F256) = galoisBaseW :=
  rfl

/-- Sending the rational variable to the literal `w` identifies the
intermediate field with a rational function field over `F256`. -/
noncomputable def sourceGaloisWFieldEquivRatFunc :
    RatFunc F256 ≃ₐ[F256] SourceGaloisWField :=
  RatFunc.algEquivOfTranscendental galoisBaseW
    sourceGaloisBaseW_transcendental

@[simp]
theorem sourceGaloisWFieldEquivRatFunc_X :
    sourceGaloisWFieldEquivRatFunc RatFunc.X = sourceGaloisWFieldGenerator := by
  apply Subtype.ext
  exact RatFunc.algEquivOfTranscendental_X
    galoisBaseW sourceGaloisBaseW_transcendental

/-- The genuine zero place of the rational intermediate field `F256(w)`. -/
noncomputable def sourceGaloisWZeroPlace : GlobalPlace F256 SourceGaloisWField :=
  GlobalPlace.comapAlgEquiv sourceGaloisWFieldEquivRatFunc.symm
    zeroBaseRationalPlace.place

/-- The genuine infinity place of the rational intermediate field
`F256(w)`. -/
noncomputable def sourceGaloisWInfinityPlace : GlobalPlace F256 SourceGaloisWField :=
  GlobalPlace.comapAlgEquiv sourceGaloisWFieldEquivRatFunc.symm
    (GlobalPlace.rationalInfinity F256)

/-- The generator `w` has a normalized simple zero at the transported zero
place. -/
theorem sourceGaloisWZeroPlace_order_generator :
    sourceGaloisWZeroPlace.order sourceGaloisWFieldGenerator = 1 := by
  rw [sourceGaloisWZeroPlace, GlobalPlace.comapAlgEquiv_order,
    ← sourceGaloisWFieldEquivRatFunc_X,
    sourceGaloisWFieldEquivRatFunc.symm_apply_apply]
  exact zeroBaseRationalPlace_order_X

/-- The generator `w` has a normalized simple pole at the transported
infinity place. -/
theorem sourceGaloisWInfinityPlace_order_generator :
    sourceGaloisWInfinityPlace.order sourceGaloisWFieldGenerator = -1 := by
  rw [sourceGaloisWInfinityPlace, GlobalPlace.comapAlgEquiv_order,
    ← sourceGaloisWFieldEquivRatFunc_X,
    sourceGaloisWFieldEquivRatFunc.symm_apply_apply,
    RationalBaseInfinityCancellation.rationalInfinity_order_eq_neg_intDegree
      F256 RatFunc.X RatFunc.X_ne_zero,
    RatFunc.intDegree_X]

/-- The zero and infinity places of `F256(w)` are genuinely distinct. -/
theorem sourceGaloisWZeroPlace_ne_infinity :
    sourceGaloisWZeroPlace ≠ sourceGaloisWInfinityPlace := by
  intro hplaces
  have horder := congrArg
    (fun P : GlobalPlace F256 SourceGaloisWField =>
      P.order sourceGaloisWFieldGenerator) hplaces
  change sourceGaloisWZeroPlace.order sourceGaloisWFieldGenerator =
    sourceGaloisWInfinityPlace.order sourceGaloisWFieldGenerator at horder
  rw [sourceGaloisWZeroPlace_order_generator,
    sourceGaloisWInfinityPlace_order_generator] at horder
  norm_num at horder

end

end QEC.Coding.AlgebraicGeometry.F256GarciaStichtenoth
