import QEC.Coding.FourDimensionalToricCode.Hamiltonian

/-!
# Logical membrane sectors of the periodic four-dimensional toric code

Following DKLP02's four-dimensional toric-code model, this module constructs
one paired set of homologically nontrivial membrane representatives.  The
primal membrane is the periodic `xy` surface at fixed `z,w`.  Its paired dual
surface is geometrically a `zw` membrane; on primal plaquette qubits it is
represented by `xy` plaquettes at fixed `x,y`.

The construction reuses the M3 chain-complex, homology/cohomology, and pure
CSS logical quotient APIs.  Nontriviality is not assumed: the two membranes
have pairing one, which proves that neither is a boundary/coboundary.  The
corresponding pure Pauli representatives normalize, but are not generated by,
the selected link-X and cube-Z toric stabilizers.

This module does not define partial membranes, syndrome loops, sweeps, energy
barriers, or lifetime statements.

[DKLP02, Section "Toric code in four dimensions", `sec:four_dim`]
-/

noncomputable section

namespace QEC.Coding.PeriodicCubical4

open scoped Classical BigOperators

private theorem sum_add_one {L : Nat} [NeZero L] {M : Type*} [AddCommMonoid M]
    (f : ZMod L → M) :
    (∑ a : ZMod L, f (a + 1)) = ∑ a : ZMod L, f a :=
  Equiv.sum_comp (Equiv.addRight 1) f

/-- A four-coordinate constructor for the explicit periodic cell representatives. -/
def coord4 {L : Nat} (x y z w : ZMod L) : Coord L
  | .x => x
  | .y => y
  | .z => z
  | .w => w

@[simp] theorem coord4_x {L : Nat} (x y z w : ZMod L) :
    coord4 x y z w .x = x := rfl
@[simp] theorem coord4_y {L : Nat} (x y z w : ZMod L) :
    coord4 x y z w .y = y := rfl
@[simp] theorem coord4_z {L : Nat} (x y z w : ZMod L) :
    coord4 x y z w .z = z := rfl
@[simp] theorem coord4_w {L : Nat} (x y z w : ZMod L) :
    coord4 x y z w .w = w := rfl

@[simp] theorem coord4_eq_coord4_iff {L : Nat}
    (x y z w x' y' z' w' : ZMod L) :
    coord4 x y z w = coord4 x' y' z' w' ↔
      x = x' ∧ y = y' ∧ z = z' ∧ w = w' := by
  constructor
  · intro h
    exact ⟨congrFun h .x, congrFun h .y, congrFun h .z, congrFun h .w⟩
  · rintro ⟨rfl, rfl, rfl, rfl⟩
    rfl

/-- The primal periodic `xy` membrane at fixed complementary coordinates `z,w`. -/
def primalXYMembrane {L : Nat} [NeZero L] (z w : ZMod L) :
    Word (ZMod 2) (Plaquette L) :=
  ∑ x : ZMod L, ∑ y : ZMod L, cellWord (coord4 x y z w, .xy)

/-- The dual `zw` membrane, represented on primal `xy` plaquette qubits at fixed `x,y`. -/
def dualXYMembrane {L : Nat} [NeZero L] (x y : ZMod L) :
    Word (ZMod 2) (Plaquette L) :=
  ∑ z : ZMod L, ∑ w : ZMod L, cellWord (coord4 x y z w, .xy)

@[simp] theorem primalXYMembrane_apply_coord4 {L : Nat} [NeZero L]
    (z₀ w₀ x y z w : ZMod L) (q : Plane) :
    primalXYMembrane z₀ w₀ (coord4 x y z w, q) =
      if q = .xy ∧ z = z₀ ∧ w = w₀ then 1 else 0 := by
  classical
  by_cases hq : q = .xy
  · subst q
    by_cases hz : z = z₀
    · subst z
      by_cases hw : w = w₀
      · subst w
        simp only [primalXYMembrane, Finset.sum_apply]
        rw [Fintype.sum_eq_single x]
        · rw [Fintype.sum_eq_single y]
          · simp [cellWord]
          · intro b hby
            simp [cellWord, Prod.ext_iff, hby]
        · intro a hax
          apply Fintype.sum_eq_zero
          intro b
          simp [cellWord, Prod.ext_iff, hax]
      · simp [primalXYMembrane, cellWord, Prod.ext_iff, hw]
    · simp [primalXYMembrane, cellWord, Prod.ext_iff, hz]
  · simp [primalXYMembrane, cellWord, Prod.ext_iff, hq]

@[simp] theorem dualXYMembrane_apply_coord4 {L : Nat} [NeZero L]
    (x₀ y₀ x y z w : ZMod L) (q : Plane) :
    dualXYMembrane x₀ y₀ (coord4 x y z w, q) =
      if q = .xy ∧ x = x₀ ∧ y = y₀ then 1 else 0 := by
  classical
  by_cases hq : q = .xy
  · subst q
    by_cases hx : x = x₀
    · subst x
      by_cases hy : y = y₀
      · subst y
        simp only [dualXYMembrane, Finset.sum_apply]
        rw [Fintype.sum_eq_single z]
        · rw [Fintype.sum_eq_single w]
          · simp [cellWord]
          · intro b hbw
            simp [cellWord, Prod.ext_iff, hbw]
        · intro a haz
          apply Fintype.sum_eq_zero
          intro b
          simp [cellWord, Prod.ext_iff, haz]
      · simp [dualXYMembrane, cellWord, Prod.ext_iff, hy]
    · simp [dualXYMembrane, cellWord, Prod.ext_iff, hx]
  · simp [dualXYMembrane, cellWord, Prod.ext_iff, hq]

private theorem shift_coord4_x {L : Nat} (x y z w : ZMod L) :
    shift (coord4 x y z w) .x = coord4 (x + 1) y z w := by
  ext a
  cases a <;> simp [shift, coord4]

private theorem shift_coord4_y {L : Nat} (x y z w : ZMod L) :
    shift (coord4 x y z w) .y = coord4 x (y + 1) z w := by
  ext a
  cases a <;> simp [shift, coord4]

private theorem shift_coord4_z {L : Nat} (x y z w : ZMod L) :
    shift (coord4 x y z w) .z = coord4 x y (z + 1) w := by
  ext a
  cases a <;> simp [shift, coord4]

private theorem shift_coord4_w {L : Nat} (x y z w : ZMod L) :
    shift (coord4 x y z w) .w = coord4 x y z (w + 1) := by
  ext a
  cases a <;> simp [shift, coord4]

private theorem coord4_eta {L : Nat} (c : Coord L) :
    coord4 (c .x) (c .y) (c .z) (c .w) = c := by
  ext a
  cases a <;> rfl

@[simp] private theorem wordPairing_cellWord_right {L : Nat} [NeZero L]
    (m : Word (ZMod 2) (Plaquette L)) (p : Plaquette L) :
    wordPairing m (cellWord p) = m p := by
  classical
  simp only [wordPairing_apply, dotProduct, cellWord]
  rw [Fintype.sum_eq_single p]
  · simp
  · intro q hqp
    simp [hqp]

/-- Periodicity cancels the two boundary links in each in-plane direction. -/
theorem boundary2_primalXYMembrane {L : Nat} [NeZero L] (z w : ZMod L) :
    boundary2 (primalXYMembrane z w) = 0 := by
  simp only [primalXYMembrane, map_sum, boundary2, linearize_cellWord,
    plaquetteBoundary, shift_coord4_x, shift_coord4_y,
    Finset.sum_add_distrib]
  rw [show (∑ x : ZMod L, ∑ y : ZMod L,
      cellWord (coord4 x (y + 1) z w, Axis.x)) =
      ∑ x : ZMod L, ∑ y : ZMod L,
        cellWord (coord4 x y z w, Axis.x) by
      apply Fintype.sum_congr
      intro x
      exact sum_add_one (M := Word (ZMod 2) (Link L))
        (fun y : ZMod L => cellWord (coord4 x y z w, Axis.x))]
  rw [show (∑ x : ZMod L, ∑ y : ZMod L,
      cellWord (coord4 (x + 1) y z w, Axis.y)) =
      ∑ x : ZMod L, ∑ y : ZMod L,
        cellWord (coord4 x y z w, Axis.y) by
      exact sum_add_one (M := Word (ZMod 2) (Link L))
        (fun x : ZMod L => ∑ y : ZMod L,
          cellWord (coord4 x y z w, Axis.y))]
  simp

private theorem wordPairing_dualXYMembrane_cubeBoundary {L : Nat} [NeZero L]
    (x y : ZMod L) (c : Cube L) :
    wordPairing (dualXYMembrane x y) (cubeBoundary c) = 0 := by
  rcases c with ⟨c, v⟩
  rw [← coord4_eta c]
  cases v <;>
    simp only [cubeBoundary, map_add, wordPairing_cellWord_right,
      shift_coord4_x, shift_coord4_y, shift_coord4_z, shift_coord4_w,
      dualXYMembrane_apply_coord4] <;>
    split_ifs <;> simp_all <;> exact ZModModule.add_self 1

/-- The dual membrane is a cocycle: it pairs trivially with every cube boundary. -/
theorem transpose_boundary3_dualXYMembrane {L : Nat} [NeZero L]
    (x y : ZMod L) :
    wordLinearMapTranspose boundary3 (dualXYMembrane x y) = 0 := by
  apply (wordPairing_nondegenerate (F := ZMod 2)).left
  intro c
  rw [wordPairing_wordLinearMapTranspose]
  rw [← word_eq_sum_single (F := ZMod 2) c]
  simp only [map_sum, boundary3, linearize_single, map_smul]
  change (∑ a : Cube L, c a *
    wordPairing (dualXYMembrane x y) (cubeBoundary a)) = 0
  simp only [wordPairing_dualXYMembrane_cubeBoundary, mul_zero,
    Finset.sum_const_zero]

/-- Paired primal and dual membranes meet in exactly one plaquette modulo two. -/
theorem wordPairing_dual_primal {L : Nat} [NeZero L]
    (x₀ y₀ z₀ w₀ : ZMod L) :
    wordPairing (dualXYMembrane x₀ y₀) (primalXYMembrane z₀ w₀) = 1 := by
  simp only [primalXYMembrane, map_sum, wordPairing_cellWord_right,
    dualXYMembrane_apply_coord4]
  rw [Fintype.sum_eq_single x₀]
  · rw [Fintype.sum_eq_single y₀]
    · simp
    · intro b hby
      simp [hby]
  · intro a hax
    apply Fintype.sum_eq_zero
    intro b
    simp [hax]

theorem primalXYMembrane_mem_middleCycleCode {L : Nat} [NeZero L]
    (z w : ZMod L) :
    primalXYMembrane z w ∈
      (plaquetteChainComplex (L := L)).middleCycleCode.carrier := by
  rw [ChainComplexData.mem_middleCycleCode_iff]
  exact boundary2_primalXYMembrane z w

theorem dualXYMembrane_mem_middleCocycleCode {L : Nat} [NeZero L]
    (x y : ZMod L) :
    dualXYMembrane x y ∈
      (plaquetteChainComplex (L := L)).middleCocycleCode.carrier := by
  rw [ChainComplexData.mem_middleCocycleCode_iff]
  exact transpose_boundary3_dualXYMembrane x y

/-- Pairing with the dual cocycle proves the primal membrane is not a boundary. -/
theorem primalXYMembrane_not_mem_middleBoundaryCode {L : Nat} [NeZero L]
    (x₀ y₀ z₀ w₀ : ZMod L) :
    primalXYMembrane z₀ w₀ ∉
      (plaquetteChainComplex (L := L)).middleBoundaryCode.carrier := by
  intro h
  rcases ((plaquetteChainComplex (L := L)).mem_middleBoundaryCode_iff
    (primalXYMembrane z₀ w₀)).1 h with ⟨c, hc⟩
  have hzero : wordPairing (dualXYMembrane x₀ y₀) (boundary3 c) = 0 := by
    rw [← wordPairing_wordLinearMapTranspose]
    rw [transpose_boundary3_dualXYMembrane]
    simp
  change boundary3 c = primalXYMembrane z₀ w₀ at hc
  rw [hc, wordPairing_dual_primal] at hzero
  exact one_ne_zero hzero

/-- Pairing with the primal cycle proves the dual membrane is not a coboundary. -/
theorem dualXYMembrane_not_mem_firstCoboundaryCheckCode {L : Nat} [NeZero L]
    (x₀ y₀ z₀ w₀ : ZMod L) :
    dualXYMembrane x₀ y₀ ∉
      (plaquetteChainComplex (L := L)).firstCoboundaryCheckCode.carrier := by
  intro h
  rcases ((plaquetteChainComplex (L := L)).mem_firstCoboundaryCheckCode_iff
    (dualXYMembrane x₀ y₀)).1 h with ⟨e, he⟩
  have hzero : wordPairing (dualXYMembrane x₀ y₀)
      (primalXYMembrane z₀ w₀) = 0 := by
    rw [← he, wordPairing_wordLinearMapTranspose]
    change wordPairing e (boundary2 (primalXYMembrane z₀ w₀)) = 0
    rw [boundary2_primalXYMembrane]
    simp
  rw [wordPairing_dual_primal] at hzero
  exact one_ne_zero hzero

def primalXYCycle {L : Nat} [NeZero L] (z w : ZMod L) :
    (plaquetteChainComplex (L := L)).middleCycleCode.carrier :=
  ⟨primalXYMembrane z w, primalXYMembrane_mem_middleCycleCode z w⟩

/-- The primal membrane's class in the existing M3 middle-homology quotient. -/
noncomputable def primalXYHomologyClass {L : Nat} [NeZero L] (z w : ZMod L) :
    (plaquetteChainComplex (L := L)).middleHomology :=
  Submodule.Quotient.mk (primalXYCycle z w)

theorem primalXYHomologyClass_ne_zero {L : Nat} [NeZero L]
    (x₀ y₀ z₀ w₀ : ZMod L) :
    primalXYHomologyClass z₀ w₀ ≠ 0 := by
  intro hzero
  have hmem := (Submodule.Quotient.mk_eq_zero _).1 hzero
  exact primalXYMembrane_not_mem_middleBoundaryCode x₀ y₀ z₀ w₀ (by
    simpa [primalXYHomologyClass, primalXYCycle,
      ChainComplexData.middleBoundaryInCycles] using hmem)

def dualXYCocycle {L : Nat} [NeZero L] (x y : ZMod L) :
    (plaquetteChainComplex (L := L)).middleCocycleCode.carrier :=
  ⟨dualXYMembrane x y, dualXYMembrane_mem_middleCocycleCode x y⟩

/-- The dual membrane's class in the existing M3 middle-cohomology quotient. -/
noncomputable def dualXYCohomologyClass {L : Nat} [NeZero L] (x y : ZMod L) :
    (plaquetteChainComplex (L := L)).middleCohomology :=
  Submodule.Quotient.mk (dualXYCocycle x y)

theorem dualXYCohomologyClass_ne_zero {L : Nat} [NeZero L]
    (x₀ y₀ z₀ w₀ : ZMod L) :
    dualXYCohomologyClass x₀ y₀ ≠ 0 := by
  intro hzero
  have hmem := (Submodule.Quotient.mk_eq_zero _).1 hzero
  exact dualXYMembrane_not_mem_firstCoboundaryCheckCode x₀ y₀ z₀ w₀ (by
    simpa [dualXYCohomologyClass, dualXYCocycle,
      ChainComplexData.middleCoboundaryInCocycles] using hmem)

def primalXYPureZRepresentative {L : Nat} [NeZero L] (z w : ZMod L) :
    (plaquetteChainComplex (L := L)).firstCoboundaryCheckCode.dual.carrier :=
  ⟨primalXYMembrane z w, by
    rw [(plaquetteChainComplex (L := L)).firstCoboundaryCheckCode_dual_carrier_eq_middleCycleCode]
    exact primalXYMembrane_mem_middleCycleCode z w⟩

/-- The primal membrane in the existing pure-Z CSS logical quotient. -/
noncomputable def primalXYPureZLogicalClass {L : Nat} [NeZero L] (z w : ZMod L) :
    (plaquetteChainComplex (L := L)).pureZLogicalQuotient :=
  Submodule.Quotient.mk (primalXYPureZRepresentative z w)

theorem primalXYPureZLogicalClass_ne_zero {L : Nat} [NeZero L]
    (x₀ y₀ z₀ w₀ : ZMod L) :
    primalXYPureZLogicalClass z₀ w₀ ≠ 0 := by
  intro hzero
  have hmem := (Submodule.Quotient.mk_eq_zero _).1 hzero
  exact primalXYMembrane_not_mem_middleBoundaryCode x₀ y₀ z₀ w₀ hmem

theorem primalXYPureZLogicalClass_maps_to_homology {L : Nat} [NeZero L]
    (z w : ZMod L) :
    (plaquetteChainComplex (L := L)).pureZLogicalQuotientEquivMiddleHomology
        (primalXYPureZLogicalClass z w) =
      primalXYHomologyClass z w := by
  rfl

def dualXYPureXRepresentative {L : Nat} [NeZero L] (x y : ZMod L) :
    (plaquetteChainComplex (L := L)).middleBoundaryCode.dual.carrier :=
  ⟨dualXYMembrane x y, by
    rw [(plaquetteChainComplex (L := L)).middleBoundaryCode_dual_carrier_eq_middleCocycleCode]
    exact dualXYMembrane_mem_middleCocycleCode x y⟩

/-- The dual membrane in the existing pure-X CSS logical quotient. -/
noncomputable def dualXYPureXLogicalClass {L : Nat} [NeZero L] (x y : ZMod L) :
    (plaquetteChainComplex (L := L)).pureXLogicalQuotient :=
  Submodule.Quotient.mk (dualXYPureXRepresentative x y)

theorem dualXYPureXLogicalClass_ne_zero {L : Nat} [NeZero L]
    (x₀ y₀ z₀ w₀ : ZMod L) :
    dualXYPureXLogicalClass x₀ y₀ ≠ 0 := by
  intro hzero
  have hmem := (Submodule.Quotient.mk_eq_zero _).1 hzero
  exact dualXYMembrane_not_mem_firstCoboundaryCheckCode x₀ y₀ z₀ w₀ hmem

theorem dualXYPureXLogicalClass_maps_to_cohomology {L : Nat} [NeZero L]
    (x y : ZMod L) :
    (plaquetteChainComplex (L := L)).pureXLogicalQuotientEquivMiddleCohomology
        (dualXYPureXLogicalClass x y) =
      dualXYCohomologyClass x y := by
  rfl

open PauliSymplectic

/-- The pure-Z Pauli carried by the primal membrane. -/
noncomputable def primalZLogical {L : Nat} [NeZero L] (z w : ZMod L) :
    Binary (Plaquette L) :=
  cssZCheck (primalXYMembrane z w)

/-- The pure-X Pauli carried by the dual membrane. -/
noncomputable def dualXLogical {L : Nat} [NeZero L] (x y : ZMod L) :
    Binary (Plaquette L) :=
  cssXCheck (dualXYMembrane x y)

/-- The primal membrane Pauli commutes with every selected toric generator. -/
theorem primalZLogical_in_normalizer {L : Nat} [NeZero L] [Fact (1 < L)]
    (z w : ZMod L) :
    InStabilizerNormalizer (toricGenerator (L := L)) (primalZLogical z w) := by
  rw [inStabilizerNormalizer_iff_commutes_generators]
  intro j
  cases j with
  | inl e =>
      rw [toricGenerator_inl]
      apply cssZCheck_commutes_cssXCheck_of_mem_dual
        (plaquetteChainComplex (L := L)).firstCoboundaryCheckCode
      · exact ((plaquetteChainComplex (L := L)).mem_firstCoboundaryCheckCode_iff _).2
          ⟨Pi.single e 1, rfl⟩
      · rw [(plaquetteChainComplex (L := L)).firstCoboundaryCheckCode_dual_carrier_eq_middleCycleCode]
        exact primalXYMembrane_mem_middleCycleCode z w
  | inr c =>
      rw [toricGenerator_inr]
      exact cssZCheck_commutes_cssZCheck _ _

/-- The dual membrane Pauli commutes with every selected toric generator. -/
theorem dualXLogical_in_normalizer {L : Nat} [NeZero L] [Fact (1 < L)]
    (x y : ZMod L) :
    InStabilizerNormalizer (toricGenerator (L := L)) (dualXLogical x y) := by
  rw [inStabilizerNormalizer_iff_commutes_generators]
  intro j
  cases j with
  | inl e =>
      rw [toricGenerator_inl]
      exact cssXCheck_commutes_cssXCheck _ _
  | inr c =>
      rw [toricGenerator_inr]
      change symplecticForm
        ({ xPart := dualXYMembrane x y, zPart := 0 } :
          SymplecticVector (ZMod 2) (Plaquette L))
        ({ xPart := 0, zPart := boundary3 (Pi.single c (1 : ZMod 2)) } :
          SymplecticVector (ZMod 2) (Plaquette L)) = 0
      rw [symplecticForm_x_zero_zero_z_eq_wordPairing]
      rw [← wordPairing_wordLinearMapTranspose]
      rw [transpose_boundary3_dualXYMembrane]
      simp

theorem toricGenerator_mem_binaryCSSCheckSet {L : Nat} [NeZero L] [Fact (1 < L)]
    (j : Sum (Link L) (Cube L)) :
    toricGenerator (L := L) j ∈ binaryCSSCheckSet
      (plaquetteChainComplex (L := L)).firstCoboundaryCheckCode
      (plaquetteChainComplex (L := L)).middleBoundaryCode := by
  cases j with
  | inl e =>
      rw [toricGenerator_inl]
      exact Or.inl ⟨wordLinearMapTranspose boundary2 (Pi.single e 1),
        ((plaquetteChainComplex (L := L)).mem_firstCoboundaryCheckCode_iff _).2
          ⟨Pi.single e 1, rfl⟩, rfl⟩
  | inr c =>
      rw [toricGenerator_inr]
      exact Or.inr ⟨boundary3 (Pi.single c 1),
        ((plaquetteChainComplex (L := L)).mem_middleBoundaryCode_iff _).2
          ⟨Pi.single c 1, rfl⟩, rfl⟩

/-- The primal membrane is non-stabilizer even modulo the binary global-sign convention. -/
theorem primalZLogical_not_generatedUpToSign
    {L : Nat} [NeZero L] [Fact (1 < L)]
    (x₀ y₀ z₀ w₀ : ZMod L) :
    ¬ InGeneratedStabilizerUpToSign
      (toricGenerator (L := L)) (primalZLogical z₀ w₀) := by
  rintro ⟨S, hgenerated, hvector⟩
  have hcomponents := generatedStabilizer_css_components
    (plaquetteChainComplex (L := L)).firstCoboundaryCheckCode
    (plaquetteChainComplex (L := L)).middleBoundaryCode
    (plaquetteChainComplex (L := L)).middleBoundaryCode_le_firstCoboundaryCheckCode_dual
    (toricGenerator (L := L)) toricGenerator_mem_binaryCSSCheckSet hgenerated
  have hz : primalXYMembrane z₀ w₀ = S.vector.zPart :=
    congrArg (fun v => v.zPart) hvector
  exact primalXYMembrane_not_mem_middleBoundaryCode x₀ y₀ z₀ w₀ (by
    rw [hz]
    exact hcomponents.2.2)

/-- The primal membrane normalizer element is not in the selected stabilizer closure. -/
theorem primalZLogical_not_generated {L : Nat} [NeZero L] [Fact (1 < L)]
    (x₀ y₀ z₀ w₀ : ZMod L) :
    ¬ GeneratedStabilizer (toricGenerator (L := L)) (primalZLogical z₀ w₀) := by
  intro hgenerated
  exact primalZLogical_not_generatedUpToSign x₀ y₀ z₀ w₀
    ⟨primalZLogical z₀ w₀, hgenerated, rfl⟩

/-- The dual membrane is non-stabilizer even modulo the binary global-sign convention. -/
theorem dualXLogical_not_generatedUpToSign
    {L : Nat} [NeZero L] [Fact (1 < L)]
    (x₀ y₀ z₀ w₀ : ZMod L) :
    ¬ InGeneratedStabilizerUpToSign
      (toricGenerator (L := L)) (dualXLogical x₀ y₀) := by
  rintro ⟨S, hgenerated, hvector⟩
  have hcomponents := generatedStabilizer_css_components
    (plaquetteChainComplex (L := L)).firstCoboundaryCheckCode
    (plaquetteChainComplex (L := L)).middleBoundaryCode
    (plaquetteChainComplex (L := L)).middleBoundaryCode_le_firstCoboundaryCheckCode_dual
    (toricGenerator (L := L)) toricGenerator_mem_binaryCSSCheckSet hgenerated
  have hx : dualXYMembrane x₀ y₀ = S.vector.xPart :=
    congrArg (fun v => v.xPart) hvector
  exact dualXYMembrane_not_mem_firstCoboundaryCheckCode x₀ y₀ z₀ w₀ (by
    rw [hx]
    exact hcomponents.2.1)

/-- The dual membrane normalizer element is not in the selected stabilizer closure. -/
theorem dualXLogical_not_generated {L : Nat} [NeZero L] [Fact (1 < L)]
    (x₀ y₀ z₀ w₀ : ZMod L) :
    ¬ GeneratedStabilizer (toricGenerator (L := L)) (dualXLogical x₀ y₀) := by
  intro hgenerated
  exact dualXLogical_not_generatedUpToSign x₀ y₀ z₀ w₀
    ⟨dualXLogical x₀ y₀, hgenerated, rfl⟩

/-- The paired primal-Z and dual-X logical Paulis anticommute. -/
theorem primalZLogical_not_commutes_dualXLogical {L : Nat} [NeZero L]
    (x₀ y₀ z₀ w₀ : ZMod L) :
    ¬ Commutes (primalZLogical z₀ w₀) (dualXLogical x₀ y₀) := by
  intro hcommutes
  have hpair' : wordPairing (primalXYMembrane z₀ w₀)
      (dualXYMembrane x₀ y₀) = 0 := by
    simpa [primalZLogical, dualXLogical, cssZCheck, cssXCheck, Commutes,
      symplecticForm, wordPairing_apply, dotProduct] using hcommutes
  have hpair : wordPairing (dualXYMembrane x₀ y₀)
      (primalXYMembrane z₀ w₀) = 0 := by
    rw [wordPairing_apply, dotProduct_comm, ← wordPairing_apply]
    exact hpair'
  rw [wordPairing_dual_primal] at hpair
  exact one_ne_zero hpair

end QEC.Coding.PeriodicCubical4
