import QEC.Coding.ExpanderCodes.LPSHeckeCorrespondence
import QEC.Coding.ExpanderCodes.LPSTraceQuadraticForm

/-!
# Quaternion words in the LPS generators

Every normalized LPS generator has odd real coordinate and even imaginary
coordinates.  This parity condition is multiplicative.  Consequently, on
products of genuine LPS generators, projective reduction to the identity
modulo the odd residue prime `q` is equivalent to divisibility of all three
imaginary coordinates by `2q`, exactly the congruence appearing in the LPS
trace quadratic form.
-/

open scoped MatrixGroups

namespace QEC.Coding.TannerLiftedProduct

variable {p : ℕ}

/-- The parity class of the Lipschitz quaternions generated by the normalized
LPS norm-`p` shell. -/
def LPSQuaternion.HasLPSParity (t : LPSQuaternion) : Prop :=
  Odd t.a ∧ Even t.b ∧ Even t.c ∧ Even t.d

theorem LPSQuaternion.hasLPSParity_one :
    (1 : LPSQuaternion).HasLPSParity := by
  simp [LPSQuaternion.HasLPSParity]

/-- The LPS parity class is closed under quaternion multiplication. -/
theorem LPSQuaternion.HasLPSParity.mul
    {t u : LPSQuaternion} (ht : t.HasLPSParity)
    (hu : u.HasLPSParity) : (t * u).HasLPSParity := by
  rcases ht with ⟨hta, htb, htc, htd⟩
  rcases hu with ⟨hua, hub, huc, hud⟩
  constructor
  · simp only [LPSQuaternion.mul_a]
    exact (((hta.mul hua).sub_even (htb.mul_right u.b)).sub_even
      (htc.mul_right u.c)).sub_even (htd.mul_right u.d)
  constructor
  · simp only [LPSQuaternion.mul_b]
    exact (((hub.mul_left t.a).add (htb.mul_right u.a)).add
      (htc.mul_right u.d)).sub (htd.mul_right u.c)
  constructor
  · simp only [LPSQuaternion.mul_c]
    exact (((huc.mul_left t.a).sub (htb.mul_right u.d)).add
      (htc.mul_right u.a)).add (htd.mul_right u.b)
  · simp only [LPSQuaternion.mul_d]
    exact (((hud.mul_left t.a).add (htb.mul_right u.c)).sub
      (htc.mul_right u.b)).add (htd.mul_right u.a)

/-- A normalized norm-`p` LPS generator has the multiplicative parity class. -/
theorem hasLPSParity_of_mem_lpsQuaternionShell
    (a : LPSResiduePrime p) {t : LPSQuaternion}
    (ht : t ∈ lpsQuaternionShell p) : t.HasLPSParity := by
  have hnorm := norm_eq_of_mem_lpsQuaternionShell a.degreePrime.pos ht
  have hnormalized :=
    (mem_lpsQuaternionShell_iff a.degreePrime.pos t).mp ht
  have hodd := exactly_one_odd_coordinate a.degreeModFour t hnorm
  rcases hodd with hfirst | hsecond | hthird | hfourth
  · exact ⟨hnormalized.2.2,
      Int.not_odd_iff_even.mp hfirst.2.1,
      Int.not_odd_iff_even.mp hfirst.2.2.1,
      Int.not_odd_iff_even.mp hfirst.2.2.2⟩
  · exact (hsecond.1 hnormalized.2.2).elim
  · exact (hthird.1 hnormalized.2.2).elim
  · exact (hfourth.1 hnormalized.2.2).elim

/-- Product of a word in the actual normalized LPS shell, before projective
reduction. -/
noncomputable def lpsQuaternionWordProduct
    (word : List (LPSGeneratorIndex p)) : LPSQuaternion :=
  (word.map fun t => t.1).prod

@[simp] theorem lpsQuaternionWordProduct_nil :
    lpsQuaternionWordProduct ([] : List (LPSGeneratorIndex p)) = 1 := rfl

@[simp] theorem lpsQuaternionWordProduct_cons
    (t : LPSGeneratorIndex p) (word : List (LPSGeneratorIndex p)) :
    lpsQuaternionWordProduct (t :: word) =
      t.1 * lpsQuaternionWordProduct word := by
  simp [lpsQuaternionWordProduct]

/-- Every word in normalized LPS generators stays in the LPS parity class. -/
theorem hasLPSParity_lpsQuaternionWordProduct
    (a : LPSResiduePrime p) (word : List (LPSGeneratorIndex p)) :
    (lpsQuaternionWordProduct word).HasLPSParity := by
  induction word with
  | nil => exact LPSQuaternion.hasLPSParity_one
  | cons t word ih =>
      rw [lpsQuaternionWordProduct_cons]
      exact (hasLPSParity_of_mem_lpsQuaternionShell a t.2).mul ih

/-- The norm of a length-`n` LPS generator word is `p^n`. -/
@[simp] theorem norm_lpsQuaternionWordProduct
    (a : LPSResiduePrime p) (word : List (LPSGeneratorIndex p)) :
    (lpsQuaternionWordProduct word).norm = (p : ℤ) ^ word.length := by
  induction word with
  | nil => simp
  | cons t word ih =>
      rw [lpsQuaternionWordProduct_cons, LPSQuaternion.norm_mul,
        norm_eq_of_mem_lpsQuaternionShell a.degreePrime.pos t.2, ih]
      simp [pow_succ, mul_comm]

/-- The same word, multiplied inside the norm-away submonoid used by the
projective quaternion reduction. -/
noncomputable def lpsQuaternionAwayWordProduct
    (a : LPSResiduePrime p) (word : List (LPSGeneratorIndex p)) :
    lpsQuaternionAwaySubmonoid a.q :=
  (word.map (lpsQuaternionShellAwayLabel a)).prod

@[simp] theorem coe_lpsQuaternionAwayWordProduct
    (a : LPSResiduePrime p) (word : List (LPSGeneratorIndex p)) :
    (lpsQuaternionAwayWordProduct a word : LPSQuaternion) =
      lpsQuaternionWordProduct word := by
  change (Submonoid.subtype (lpsQuaternionAwaySubmonoid a.q))
      ((word.map (lpsQuaternionShellAwayLabel a)).prod) = _
  rw [map_list_prod]
  simp [lpsQuaternionWordProduct, lpsQuaternionShellAwayLabel,
    lpsQuaternionAwayElement]

/-- Projective reduction of a quaternion word is the product of the finite
LPS Hecke labels. -/
theorem lpsQuaternionAwayPGL_wordProduct
    (a : LPSResiduePrime p) (word : List (LPSGeneratorIndex p)) :
    lpsQuaternionAwayPGL a.q (lpsQuaternionAwayWordProduct a word) =
      (word.map (lpsPGLHeckeLabel a)).prod := by
  change lpsQuaternionAwayPGL a.q
      ((word.map (lpsQuaternionShellAwayLabel a)).prod) = _
  rw [map_list_prod]
  rw [List.map_map]
  change (word.map (lpsPGLHeckeLabel a)).prod = _
  rfl

/-- Product of the same word in the concrete finite LPS vertex group. -/
noncomputable def lpsPSLWordProduct
    (a : LPSResiduePrime p) (word : List (LPSGeneratorIndex p)) :
    PSL(2, ZMod a.q) :=
  (word.map (lpsQuaternionLabel a)).prod

/-- The concrete `PSL` word maps to its multiplicative quaternion reduction
in `PGL`. -/
theorem toPGL_lpsPSLWordProduct
    (a : LPSResiduePrime p) (word : List (LPSGeneratorIndex p)) :
    Matrix.ProjectiveSpecialLinearGroup.toPGL
        (lpsPSLWordProduct a word) =
      lpsQuaternionAwayPGL a.q (lpsQuaternionAwayWordProduct a word) := by
  rw [lpsPSLWordProduct, map_list_prod,
    lpsQuaternionAwayPGL_wordProduct]
  rw [List.map_map]
  congr 1
  apply List.map_congr_left
  intro t _ht
  exact lpsPGLHeckeLabel_eq_toPGL a t |>.symm

private theorem two_mul_q_dvd_of_even_of_q_dvd
    (a : LPSResiduePrime p) {x : ℤ} (heven : Even x)
    (hq : (a.q : ℤ) ∣ x) : ((2 * a.q : ℕ) : ℤ) ∣ x := by
  have hqNeTwo : a.q ≠ 2 := by
    have hmod := a.modFour
    omega
  have hqOdd : Odd a.q := a.prime.odd_of_ne_two hqNeTwo
  have hcoprimeNat : Nat.Coprime 2 a.q :=
    Nat.coprime_two_left.mpr hqOdd
  have hcoprime : IsCoprime (2 : ℤ) (a.q : ℤ) :=
    hcoprimeNat.isCoprime
  simpa only [Nat.cast_mul, Nat.cast_ofNat] using
    hcoprime.mul_dvd heven.two_dvd hq

/-- On genuine LPS generator words, reduction to the projective identity is
equivalent to the `2q` divisibility condition of the trace theta series. -/
theorem lpsQuaternionAwayPGL_wordProduct_eq_one_iff
    (a : LPSResiduePrime p) (word : List (LPSGeneratorIndex p)) :
    lpsQuaternionAwayPGL a.q (lpsQuaternionAwayWordProduct a word) = 1 ↔
      ((2 * a.q : ℕ) : ℤ) ∣ (lpsQuaternionWordProduct word).b ∧
        ((2 * a.q : ℕ) : ℤ) ∣ (lpsQuaternionWordProduct word).c ∧
          ((2 * a.q : ℕ) : ℤ) ∣ (lpsQuaternionWordProduct word).d := by
  rw [lpsQuaternionAwayPGL_eq_one_iff]
  simp only [coe_lpsQuaternionAwayWordProduct]
  have hparity := hasLPSParity_lpsQuaternionWordProduct a word
  constructor
  · rintro ⟨hb, hc, hd⟩
    exact ⟨two_mul_q_dvd_of_even_of_q_dvd a hparity.2.1 hb,
      two_mul_q_dvd_of_even_of_q_dvd a hparity.2.2.1 hc,
      two_mul_q_dvd_of_even_of_q_dvd a hparity.2.2.2 hd⟩
  · rintro ⟨hb, hc, hd⟩
    exact ⟨dvd_trans (by simp) hb,
      dvd_trans (by simp) hc,
      dvd_trans (by simp) hd⟩

/-- A finite LPS word closes at the identity exactly when its integral
quaternion product belongs to the trace congruence shell at norm `p^n`. -/
theorem lpsPSLWordProduct_eq_one_iff_mem_traceCongruenceShell
    (a : LPSResiduePrime p) (word : List (LPSGeneratorIndex p)) :
    lpsPSLWordProduct a word = 1 ↔
      lpsQuaternionWordProduct word ∈
        lpsTraceCongruenceShell a.q (p ^ word.length) := by
  have hpPow : 0 < p ^ word.length :=
    pow_pos a.degreePrime.pos word.length
  rw [mem_lpsTraceCongruenceShell_iff hpPow,
    norm_lpsQuaternionWordProduct a]
  simp only [Int.natCast_pow]
  rw [true_and]
  rw [← lpsQuaternionAwayPGL_wordProduct_eq_one_iff a word]
  constructor
  · intro h
    have hmap := congrArg
      (Matrix.ProjectiveSpecialLinearGroup.toPGL
        (n := Fin 2) (R := ZMod a.q)) h
    simpa [toPGL_lpsPSLWordProduct] using hmap
  · intro h
    apply Matrix.ProjectiveSpecialLinearGroup.toPGL_injective
    simpa [toPGL_lpsPSLWordProduct] using h

end QEC.Coding.TannerLiftedProduct
