import QEC.Coding.AlgebraicGeometry.Towers.RationalCoordinateCells

/-!
# The literal coordinate windows in each constructed source level

Earlier coordinates are carried by the existing source-recursion embeddings.
Past the final index the sequence repeats its last coordinate, solely to
provide a total indexing function; recursion is asserted only below the level.
-/

open IntermediateField

namespace QEC.Coding.AlgebraicGeometry.F256GarciaStichtenoth

noncomputable section

/-- Actual source coordinates in one constructed finite source level. -/
def sourceCoordinates : (m : ℕ) → ℕ → SourceField m
  | 0, _ => sourceDistinguishedCoordinate 0
  | m + 1, i => if i ≤ m then sourceRecursionEmbedding m (sourceCoordinates m i)
      else sourceDistinguishedCoordinate (m + 1)

theorem sourceCoordinates_succ_of_le (m i : ℕ) (hi : i ≤ m) :
    sourceCoordinates (m + 1) i = sourceRecursionEmbedding m (sourceCoordinates m i) := by
  simp only [sourceCoordinates, if_pos hi]

theorem sourceCoordinates_of_le (m i : ℕ) (hi : m ≤ i) :
    sourceCoordinates m i = sourceDistinguishedCoordinate m := by
  cases m with
  | zero => rfl
  | succ m => simp only [sourceCoordinates, if_neg (by omega : ¬i ≤ m)]

theorem sourceCoordinates_last (m : ℕ) :
    sourceCoordinates m m = sourceDistinguishedCoordinate m := sourceCoordinates_of_le m m le_rfl

theorem sourceCoordinates_transcendental (m i : ℕ) :
    Transcendental F256 (sourceCoordinates m i) := by
  induction m with
  | zero => exact sourceBasicSourceCoordinate_transcendental 0
  | succ m ih =>
      by_cases hi : i ≤ m
      · rw [sourceCoordinates_succ_of_le m i hi]
        intro ha
        exact ih ((isAlgebraic_algHom_iff (sourceRecursionEmbedding m)
          (sourceRecursionEmbedding m).injective).mp ha)
      · rw [sourceCoordinates_of_le (m + 1) i (by omega)]
        exact sourceBasicSourceCoordinate_transcendental (m + 1)

/-- The displayed source equation holds on every adjacent pair in the
actual finite coordinate sequence. -/
theorem sourceCoordinates_recursion (m i : ℕ) (hi : i < m) :
    sourceCoordinates m (i + 1) ^ 16 + sourceCoordinates m (i + 1) =
      sourceStepRhs (sourceCoordinates m i) := by
  induction m with
  | zero => omega
  | succ m ih =>
      by_cases him : i < m
      · rw [sourceCoordinates_succ_of_le m (i + 1) (by omega),
          sourceCoordinates_succ_of_le m i (by omega)]
        simpa only [map_add, map_pow, sourceStepRhs, map_div₀, map_one] using
          congrArg (sourceRecursionEmbedding m) (ih him)
      · have hieq : i = m := by omega
        subst i
        rw [sourceCoordinates_last, sourceCoordinates_succ_of_le m m le_rfl,
          sourceCoordinates_last]
        simpa only [sourceStepRhs, map_div₀, map_pow, map_add, map_one] using
          sourceRecursion_equation m

theorem sourceCoordinates_zero (m : ℕ) :
    sourceCoordinates m 0 = algebraMap (RatFunc F256) (SourceField m) RatFunc.X := by
  induction m with
  | zero => rfl
  | succ m ih =>
      rw [sourceCoordinates_succ_of_le m 0 (Nat.zero_le m), ih]
      rfl

/-- A source successor is generated by its displayed recursion coordinate,
not merely by the reciprocal polynomial's presentation generator. -/
theorem sourceRecursion_adjoin_coordinate_eq_top (m : ℕ) :
    (SourceField m)⟮sourceDistinguishedCoordinate (m + 1)⟯ =
      (⊤ : IntermediateField (SourceField m) (SourceField (m + 1))) := by
  let P := sourceDistinguishedPlace m
  let x := sourceDistinguishedCoordinate m
  let hx := sourceDistinguishedCoordinate_order m
  apply top_unique
  have hroot : (SourceField m)⟮(AdjoinRoot.root (sourceStepPolynomial P x hx) :
      SourceField (m + 1))⟯ = ⊤ :=
    IntermediateField.adjoin_root_eq_top (sourceStepPolynomial P x hx)
  refine hroot.symm.le.trans ?_
  erw [IntermediateField.adjoin_le_iff]
  intro z hz
  have hz' : z = AdjoinRoot.root (sourceStepPolynomial P x hx) := Set.mem_singleton_iff.mp hz
  subst z
  have hmem := ((SourceField m)⟮sourceDistinguishedCoordinate (m + 1)⟯).inv_mem
    (mem_adjoin_simple_self (SourceField m) (sourceDistinguishedCoordinate (m + 1)))
  have hcoord : (sourceDistinguishedCoordinate (m + 1))⁻¹ =
      (AdjoinRoot.root (sourceStepPolynomial P x hx) : SourceField (m + 1)) :=
    inv_inv _
  rw [hcoord] at hmem
  exact hmem

theorem sourceRecursion_fieldRange_sup_coordinate (m : ℕ) :
    (sourceRecursionEmbedding m).fieldRange ⊔ F256⟮sourceDistinguishedCoordinate (m + 1)⟯ =
      (⊤ : IntermediateField F256 (SourceField (m + 1))) := by
  let T := (sourceRecursionEmbedding m).fieldRange ⊔ F256⟮sourceDistinguishedCoordinate (m + 1)⟯
  apply top_unique
  intro z hzTop
  clear hzTop
  change z ∈ T
  have hz : z ∈ (SourceField m)⟮sourceDistinguishedCoordinate (m + 1)⟯ := by
    rw [sourceRecursion_adjoin_coordinate_eq_top]
    trivial
  induction hz using IntermediateField.adjoin_induction with
  | mem v hv =>
      exact (show F256⟮sourceDistinguishedCoordinate (m + 1)⟯ ≤ T from le_sup_right)
        (IntermediateField.subset_adjoin F256 _ hv)
  | algebraMap v =>
      exact (show (sourceRecursionEmbedding m).fieldRange ≤ T from le_sup_left) ⟨v, rfl⟩
  | add v w _ _ hv hw => exact T.add_mem hv hw
  | mul v w _ _ hv hw => exact T.mul_mem hv hw
  | inv v _ hv => exact T.inv_mem hv

/-- The last literal window is the existing `SourceField m`, not a newly
postulated carrier or an unnamed function field. -/
theorem sourceCoordinates_window_eq_top (m : ℕ) :
    coordinateWindow (sourceCoordinates m) 0 m = ⊤ := by
  induction m with
  | zero => exact RatFunc.adjoin_X
  | succ m ih =>
      have hp : coordinateWindow (sourceCoordinates (m + 1)) 0 m =
          (coordinateWindow (sourceCoordinates m) 0 m).map (sourceRecursionEmbedding m) := by
        rw [coordinateWindow_map]
        apply coordinateWindow_congr
        intro i hi
        exact sourceCoordinates_succ_of_le m (0 + i) (by omega)
      rw [coordinateWindow, Nat.zero_add, sourceCoordinates_last, hp, ih,
        ← AlgHom.fieldRange_eq_map]
      exact sourceRecursion_fieldRange_sup_coordinate m

private theorem sourceCoordinates_seed_finite_separable (m : ℕ) :
    FiniteDimensional F256⟮sourceCoordinates m 0⟯ (SourceField m) ∧
      Algebra.IsSeparable F256⟮sourceCoordinates m 0⟯ (SourceField m) := by
  let j := IsScalarTower.toAlgHom F256 (RatFunc F256) (SourceField m)
  let K := j.fieldRange
  let jK : RatFunc F256 →ₐ[F256] K := j.codRestrict K.toSubalgebra (fun r => ⟨r, rfl⟩)
  letI : Algebra (RatFunc F256) K := jK.toRingHom.toAlgebra
  letI : IsScalarTower (RatFunc F256) K (SourceField m) := IsScalarTower.of_algebraMap_eq' rfl
  have hresult : FiniteDimensional K (SourceField m) ∧ Algebra.IsSeparable K (SourceField m) :=
    ⟨Module.Finite.of_restrictScalars_finite (RatFunc F256) K (SourceField m),
      Algebra.isSeparable_tower_top_of_isSeparable (RatFunc F256) K (SourceField m)⟩
  have hK : K = F256⟮sourceCoordinates m 0⟯ := by
    rw [sourceCoordinates_zero]
    change j.fieldRange = F256⟮j RatFunc.X⟯
    rw [AlgHom.fieldRange_eq_map, ← RatFunc.adjoin_X,
      IntermediateField.adjoin_map, Set.image_singleton]
  rw [hK] at hresult
  exact hresult

/-- Finiteness and separability over every actual coordinate are derived
from the rational seed and the two orientations of the basic source cells. -/
theorem sourceCoordinates_finite_separable (m i : ℕ) :
    FiniteDimensional F256⟮sourceCoordinates m i⟯ (SourceField m) ∧
      Algebra.IsSeparable F256⟮sourceCoordinates m i⟯ (SourceField m) := by
  induction i with
  | zero => exact sourceCoordinates_seed_finite_separable m
  | succ i ih =>
      by_cases hi : i < m
      · letI := ih.1
        letI := ih.2
        exact rationalRecursion_next_finite_separable (sourceCoordinates m i)
          (sourceCoordinates m (i + 1)) (sourceCoordinates_transcendental m i)
          (sourceCoordinates_transcendental m (i + 1)) (sourceCoordinates_recursion m i hi)
      · have heq : sourceCoordinates m (i + 1) = sourceCoordinates m i :=
          (sourceCoordinates_of_le m (i + 1) (by omega)).trans
            (sourceCoordinates_of_le m i (by omega)).symm
        rw [heq]
        exact ih

scoped instance sourceCoordinates_finite (m i : ℕ) :
    FiniteDimensional F256⟮sourceCoordinates m i⟯ (SourceField m) :=
  (sourceCoordinates_finite_separable m i).1

scoped instance sourceCoordinates_separable (m i : ℕ) :
    Algebra.IsSeparable F256⟮sourceCoordinates m i⟯ (SourceField m) :=
  (sourceCoordinates_finite_separable m i).2

/-- The original source tower, inside its constructed terminal field,
admits the normalized quadratic refinement derived from the paper's
coordinate pyramid. Residue finiteness is derived from this function field. -/
theorem sourceCoordinates_normalized (m : ℕ) (Q : GlobalPlace F256 (SourceField m)) :
    PlaceNormalizedExtension Q F256⟮sourceCoordinates m 0⟯ ⊤ := by
  letI : Algebra (Polynomial F256) (SourceField m) :=
    ((algebraMap (RatFunc F256) (SourceField m)).comp
      (algebraMap (Polynomial F256) (RatFunc F256))).toAlgebra
  letI : IsScalarTower (Polynomial F256) (RatFunc F256) (SourceField m) :=
    IsScalarTower.of_algebraMap_eq' rfl
  letI : Finite Q.residueField := GlobalPlace.finite_residueField Q
  have h := rationalCoordinateWindow_normalized Q (sourceCoordinates m)
    (sourceCoordinates_transcendental m) m (sourceCoordinates_recursion m)
  rwa [sourceCoordinates_window_eq_top] at h

end

end QEC.Coding.AlgebraicGeometry.F256GarciaStichtenoth
