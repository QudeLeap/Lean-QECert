import QEC.Semantics.Instruments.Sequential.Composition
/-!
# The finite KT19 prime-qudit protocol

This module builds the physical register operations, syndrome instrument,
decoder, and one-level stochastic protocol for KT19 prime-qudit distillation.
The first layer supplies the arbitrary-word generalized-`X` transport and the
inverse-transversal resource identity needed by the syndrome correction.
-/

noncomputable section

namespace QEC.Distillation.KT19Protocol

open Semantics
open QEC.Coding
open QEC.Coding.KT19ReedSolomon
open QEC.Distillation.KT19PrimeQuditCSS
open QEC.Distillation.KT19MagicResource.KT19PrimeQuditCSS
open QEC.Distillation.KT19P11ReedSolomonCubicBridge

attribute [local instance]
  QEC.Distillation.KT19PrimeQuditCSS.primeQuditRegisterLabelFintype

/-- The finite protocol's proposition-indexed outcome formulas use classical
decidability locally; this keeps their statements available without adding
computable equality assumptions on arbitrary finite index types. -/
local instance instKT19ProtocolClassicalDecidable (p : Prop) : Decidable p :=
  Classical.propDecidable p

universe u

variable (p : Nat) [NeZero p]
variable {Site : Type u} [Fintype Site] [DecidableEq Site]

/-! ## Register translations -/

/-- Addition by an arbitrary generalized-`X` word on computational labels. -/
def xWordLabelEquiv (word : PrimeQuditRegisterLabel p Site) :
    PrimeQuditRegisterLabel p Site ≃ PrimeQuditRegisterLabel p Site where
  toFun label := label + word
  invFun label := label - word
  left_inv label := by
    funext site
    simp
  right_inv label := by
    funext site
    simp

/-- The register linear isometry induced by addition of a generalized-`X` word. -/
noncomputable def xWordLinearIsometry (word : PrimeQuditRegisterLabel p Site) :
    PrimeQuditRegister p Site ≃ₗᵢ[Complex] PrimeQuditRegister p Site :=
  LinearIsometryEquiv.piLpCongrLeft 2 Complex Complex (xWordLabelEquiv p word)

/-- The sitewise generalized-`X` transport for an arbitrary register word. -/
noncomputable def xWordTransport (word : PrimeQuditRegisterLabel p Site) :
    UnitaryTransport (PrimeQuditRegister p Site) (PrimeQuditRegister p Site) where
  toLinearEquiv := (xWordLinearIsometry p word).toLinearEquiv
  map_inner := fun psi chi => (xWordLinearIsometry p word).inner_map_map psi chi

@[simp]
theorem xWordTransport_apply (word : PrimeQuditRegisterLabel p Site)
    (psi : PrimeQuditRegister p Site) (label : PrimeQuditRegisterLabel p Site) :
    xWordTransport p word psi label = psi (label - word) :=
  rfl

/-- A register word transport shifts every computational-basis label by that word. -/
theorem xWordTransport_apply_basis (word label : PrimeQuditRegisterLabel p Site) :
    xWordTransport p word (registerBasisKet p label) =
      registerBasisKet p (label + word) := by
  classical
  ext target
  by_cases htarget : target = label + word
  · subst target
    simp [xWordTransport_apply, registerBasisKet, EuclideanSpace.basisFun_apply]
  · have htarget' : target - word ≠ label := by
      intro h
      apply htarget
      calc
        target = (target - word) + word := by
          funext site
          simp
        _ = label + word := by rw [h]
    simp [xWordTransport_apply, registerBasisKet, EuclideanSpace.basisFun_apply,
      htarget, htarget']

/-- Removing the physical cubic layer from a magic register word leaves its
Fourier character ket. -/
theorem inverseTransversal_magicRegisterKet
    (error : PrimeQuditRegisterLabel p Site) :
    (physicalU13 p).symm (magicRegisterKet p error) = characterKet p error :=
  physicalU13_symm_magicRegisterKet p error

/-! ## Classical syndrome sectors -/

section Syndromes

variable {q : Nat} [NeZero q] [Fact q.Prime]
variable {Logical Stabilizer : Type u} [Fintype Logical] [Fintype Stabilizer]

/-- The span of all displayed logical and stabilizer rows. -/
def rowCarrier (R : CubicRowFamily q Logical Stabilizer Site) :
    Submodule (ZMod q) (PrimeQuditRegisterLabel q Site) :=
  Submodule.span (ZMod q) (Set.range R.row)

/-- The span of the displayed stabilizer rows. -/
def stabilizerCarrier (R : CubicRowFamily q Logical Stabilizer Site) :
    Submodule (ZMod q) (PrimeQuditRegisterLabel q Site) :=
  Submodule.span (ZMod q) (Set.range R.stabilizerRow)

/-- The finite linear code generated by the actual stabilizer rows.  This
packages no acceptance conclusion; it only exposes the row span to the
project's existing finite-code duality API. -/
def kt19StabilizerCode (R : CubicRowFamily q Logical Stabilizer Site) :
    LinearCode (ZMod q) Site where
  carrier := stabilizerCarrier R

/-- Every stabilizer word is a word in the full displayed row span. -/
theorem stabilizerCarrier_le_rowCarrier
    (R : CubicRowFamily q Logical Stabilizer Site) :
    stabilizerCarrier R ≤ rowCarrier R := by
  apply Submodule.span_mono
  rintro word ⟨index, rfl⟩
  exact ⟨Sum.inr index, rfl⟩

/-- Every finite stabilizer-word translation is a word in the actual measured
row carrier. -/
theorem stabilizerWord_mem_rowCarrier
    (R : CubicRowFamily q Logical Stabilizer Site)
    (coefficient : Stabilizer → ZMod q) :
    R.stabilizerWord coefficient ∈ rowCarrier R := by
  unfold CubicRowFamily.stabilizerWord rowCarrier
  apply Submodule.sum_mem
  intro index _
  apply Submodule.smul_mem
  exact Submodule.subset_span ⟨Sum.inr index, rfl⟩

/-- The finite Z-syndrome sector: computational words modulo the full row span.

This quotient is the intrinsic coset form of the simultaneous syndrome for
all words in the dual of the displayed row span.
-/
abbrev ZSyndrome (R : CubicRowFamily q Logical Stabilizer Site) :=
  PrimeQuditRegisterLabel q Site ⧸ rowCarrier R

/-- Classical equality on finite Z-syndrome sectors.  The sector is a genuine
quotient of the finite register-label space, so this only supplies the
decidable comparison needed to enumerate physical measurement outcomes. -/
noncomputable instance zSyndromeDecidableEq
    (R : CubicRowFamily q Logical Stabilizer Site) : DecidableEq (ZSyndrome R) :=
  Classical.decEq _

/-- The Z-syndrome sector occupied by a computational-basis word. -/
def zSyndrome (R : CubicRowFamily q Logical Stabilizer Site)
    (word : PrimeQuditRegisterLabel q Site) : ZSyndrome R :=
  Submodule.Quotient.mk word

/-- Adding a word from the measured row carrier does not change its physical
Z-syndrome quotient. -/
theorem zSyndrome_add_mem_rowCarrier
    (R : CubicRowFamily q Logical Stabilizer Site)
    (word carrier : PrimeQuditRegisterLabel q Site)
    (hcarrier : carrier ∈ rowCarrier R) :
    zSyndrome R (word + carrier) = zSyndrome R word := by
  change Submodule.Quotient.mk (word + carrier) = Submodule.Quotient.mk word
  rw [Submodule.Quotient.eq]
  simpa using hcarrier

/-- The trivial Z-syndrome sector is exactly the displayed full row carrier. -/
theorem zSyndrome_eq_zero_iff_mem_rowCarrier
    (R : CubicRowFamily q Logical Stabilizer Site)
    (word : PrimeQuditRegisterLabel q Site) :
    zSyndrome R word = 0 ↔ word ∈ rowCarrier R := by
  change Submodule.Quotient.mk word = Submodule.Quotient.mk 0 ↔ _
  rw [Submodule.Quotient.eq]
  simp

/-- A stabilizer-row shift preserves the cubic phase on every word in the
measured row carrier.  The conclusion is derived from the cubic-row normal
form, whose diagonal term depends only on logical coefficients. -/
theorem cubicExponent_sub_stabilizerRow_of_mem_rowCarrier
    (R : CubicRowFamily q Logical Stabilizer Site)
    (word : PrimeQuditRegisterLabel q Site) (hword : word ∈ rowCarrier R)
    (index : Stabilizer) :
    cubicExponent q (word - R.stabilizerRow index) = cubicExponent q word := by
  classical
  obtain ⟨coefficient, hcoefficient⟩ :=
    (Submodule.mem_span_range_iff_exists_fun (ZMod q)).mp hword
  change R.combinedWord coefficient = word at hcoefficient
  let logicalCoefficient : Logical → ZMod q :=
    fun logical => -coefficient (Sum.inl logical)
  let stabilizerCoefficient : Stabilizer → ZMod q :=
    fun stabilizer => coefficient (Sum.inr stabilizer)
  have hcoefficient_eq :
      CubicRowFamily.combinedCoefficient logicalCoefficient stabilizerCoefficient =
        coefficient := by
    funext row
    rcases row with logical | stabilizer
    · simp [logicalCoefficient, CubicRowFamily.combinedCoefficient]
    · simp [stabilizerCoefficient, CubicRowFamily.combinedCoefficient]
  have hcoset :
      R.cosetLabel logicalCoefficient stabilizerCoefficient = word := by
    rw [R.cosetLabel_eq_combinedWord, hcoefficient_eq, hcoefficient]
  let delta : Stabilizer → ZMod q :=
    fun stabilizer => if stabilizer = index then 1 else 0
  have hdelta : R.stabilizerWord delta = R.stabilizerRow index := by
    unfold CubicRowFamily.stabilizerWord
    rw [Finset.sum_eq_single index]
    · simp [delta]
    · intro other _ hother
      simp [delta, hother]
    · simp
  have hcoset_sub :
      R.cosetLabel logicalCoefficient (stabilizerCoefficient - delta) =
        R.cosetLabel logicalCoefficient stabilizerCoefficient - R.stabilizerRow index := by
    unfold CubicRowFamily.cosetLabel
    rw [R.stabilizerWord_sub, hdelta]
    abel
  calc
    cubicExponent q (word - R.stabilizerRow index) =
        cubicExponent q
          (R.cosetLabel logicalCoefficient (stabilizerCoefficient - delta)) := by
      rw [hcoset_sub, hcoset]
    _ = -(∑ logical : Logical, logicalCoefficient logical ^ 3 * R.epsilon logical) :=
      R.cubicExponent_cosetLabel logicalCoefficient (stabilizerCoefficient - delta)
    _ = cubicExponent q (R.cosetLabel logicalCoefficient stabilizerCoefficient) :=
      (R.cubicExponent_cosetLabel logicalCoefficient stabilizerCoefficient).symm
    _ = cubicExponent q word := by rw [hcoset]

/-- A concrete word representing a Z-syndrome sector. -/
noncomputable def zSyndromeRepresentative
    (R : CubicRowFamily q Logical Stabilizer Site) (syndrome : ZSyndrome R) :
    PrimeQuditRegisterLabel q Site :=
  Classical.choose (Submodule.Quotient.mk_surjective (rowCarrier R) syndrome)

/-- The selected representative occupies the syndrome sector it represents. -/
theorem zSyndrome_representative
    (R : CubicRowFamily q Logical Stabilizer Site) (syndrome : ZSyndrome R) :
    zSyndrome R (zSyndromeRepresentative R syndrome) = syndrome :=
  Classical.choose_spec (Submodule.Quotient.mk_surjective (rowCarrier R) syndrome)

/-- Adding the selected representative translates precisely from its measured
Z-syndrome sector to the trivial sector. -/
theorem zSyndrome_add_representative_eq_iff
    (R : CubicRowFamily q Logical Stabilizer Site)
    (word : PrimeQuditRegisterLabel q Site) (syndrome : ZSyndrome R) :
    zSyndrome R (word + zSyndromeRepresentative R syndrome) = syndrome ↔
      zSyndrome R word = 0 := by
  have hrepresentative :
      Submodule.Quotient.mk (zSyndromeRepresentative R syndrome) = syndrome :=
    zSyndrome_representative R syndrome
  change Submodule.Quotient.mk
      (word + zSyndromeRepresentative R syndrome) = syndrome ↔
    Submodule.Quotient.mk word = 0
  rw [Submodule.Quotient.mk_add, hrepresentative]
  constructor
  · intro h
    have h' : Submodule.Quotient.mk word + syndrome = 0 + syndrome := by
      simpa using h
    exact add_right_cancel h'
  · intro h
    simpa [h]

/-- The literal X syndrome obtained by pairing with every stabilizer row. -/
def xSyndrome (R : CubicRowFamily q Logical Stabilizer Site)
    (word : PrimeQuditRegisterLabel q Site) : Stabilizer → ZMod q :=
  fun index => wordPairing word (R.stabilizerRow index)

/-- The classical error-word condition selected by the trivial physical
X-syndrome outcome. -/
def kt19AcceptedWord (R : CubicRowFamily q Logical Stabilizer Site)
    (word : PrimeQuditRegisterLabel q Site) : Prop :=
  xSyndrome R word = 0

/-- The logical magic-register label induced by a physical error word.  Its
negative sign is forced by the encoder convention
`cosetLabel = -logicalWord + stabilizerWord`. -/
private def kt19LogicalRouting (R : CubicRowFamily q Logical Stabilizer Site)
    (error : PrimeQuditRegisterLabel q Site) :
    PrimeQuditRegisterLabel q Logical :=
  fun port => -wordPairing error (R.logicalRow port)

/-- On a physically accepted word, the character phase of every encoded CSS
coset label is exactly the character phase of its routed logical label. -/
private theorem kt19AcceptedWord_registerPairing_cosetLabel
    (R : CubicRowFamily q Logical Stabilizer Site)
    (error : PrimeQuditRegisterLabel q Site)
    (logical : PrimeQuditRegisterLabel q Logical)
    (stabilizer : PrimeQuditRegisterLabel q Stabilizer)
    (haccepted : kt19AcceptedWord R error) :
    registerPairing q error (R.cosetLabel logical stabilizer) =
      registerPairing q (kt19LogicalRouting R error) logical := by
  have hstabilizer :
      wordPairing error (R.stabilizerWord stabilizer) = 0 := by
    unfold CubicRowFamily.stabilizerWord
    rw [map_sum]
    apply Finset.sum_eq_zero
    intro index _
    rw [map_smul]
    have hrow := congrFun haccepted index
    change wordPairing error (R.stabilizerRow index) = 0 at hrow
    rw [hrow, smul_zero]
  change wordPairing error (R.cosetLabel logical stabilizer) =
    wordPairing (kt19LogicalRouting R error) logical
  unfold CubicRowFamily.cosetLabel
  rw [(wordPairing error).map_add, (wordPairing error).map_neg,
    hstabilizer, add_zero]
  unfold CubicRowFamily.logicalWord kt19LogicalRouting
  rw [map_sum]
  simp only [map_smul, wordPairing_apply, dotProduct, smul_eq_mul]
  rw [← Finset.sum_neg_distrib]
  apply Finset.sum_congr rfl
  intro port _
  ring

/-- Trivial stabilizer syndrome is exactly membership in the dual of the
actual stabilizer-row code.  The result is derived by span induction, so no
accepted-word support is supplied as protocol data. -/
theorem kt19AcceptedWord_iff_mem_stabilizerCode_dual
    (R : CubicRowFamily q Logical Stabilizer Site)
    (word : PrimeQuditRegisterLabel q Site) :
    kt19AcceptedWord R word ↔ word ∈ (kt19StabilizerCode R).dual.carrier := by
  unfold kt19AcceptedWord
  rw [LinearCode.mem_dual]
  change xSyndrome R word = 0 ↔
    ∀ carrier : PrimeQuditRegisterLabel q Site,
      carrier ∈ stabilizerCarrier R → wordPairing word carrier = 0
  constructor
  · intro h carrier hcarrier
    change carrier ∈ Submodule.span (ZMod q) (Set.range R.stabilizerRow) at hcarrier
    induction hcarrier using Submodule.span_induction with
    | mem carrier hcarrier =>
        rcases hcarrier with ⟨index, rfl⟩
        simpa [xSyndrome] using congrFun h index
    | zero => simp
    | add left right _ _ hleft hright =>
        rw [(wordPairing word).map_add, hleft, hright, add_zero]
    | smul scalar carrier _ hcarrier =>
        rw [(wordPairing word).map_smul, hcarrier, smul_zero]
  · intro h
    funext index
    have hrow : R.stabilizerRow index ∈ stabilizerCarrier R := by
      unfold stabilizerCarrier
      exact Submodule.subset_span ⟨index, rfl⟩
    simpa [xSyndrome] using h (R.stabilizerRow index) hrow

/-! ## Physical syndrome projectors and instruments -/

omit [Fact q.Prime] in
private theorem registerBasisKet_inner_self
    (word : PrimeQuditRegisterLabel q Site) :
    inner ℂ (registerBasisKet q word) (registerBasisKet q word) = 1 := by
  simp [registerBasisKet, EuclideanSpace.basisFun_apply]

omit [Fact q.Prime] in
private theorem registerBasisKet_inner_zero
    (left right : PrimeQuditRegisterLabel q Site) (hne : left ≠ right) :
    inner ℂ (registerBasisKet q left) (registerBasisKet q right) = 0 := by
  rw [registerBasisKet, registerBasisKet]
  simp only [EuclideanSpace.basisFun_apply, EuclideanSpace.inner_single_left]
  simp [hne]

omit [Fact q.Prime] in
private theorem computationalRankOne_mul
    (left right : PrimeQuditRegisterLabel q Site) :
    (InnerProductSpace.rankOne ℂ (registerBasisKet q left)
      (registerBasisKet q left)).toLinearMap *
        (InnerProductSpace.rankOne ℂ (registerBasisKet q right)
          (registerBasisKet q right)).toLinearMap =
      if left = right then
        (InnerProductSpace.rankOne ℂ (registerBasisKet q right)
          (registerBasisKet q right)).toLinearMap
      else 0 := by
  classical
  ext psi
  simp only [Module.End.mul_apply, InnerProductSpace.toLinearMap_rankOne,
    LinearMap.smulRight_apply, innerₛₗ_apply_apply]
  rw [inner_smul_right]
  by_cases hsame : left = right
  · subst left
    rw [registerBasisKet_inner_self]
    simp
  · rw [registerBasisKet_inner_zero left right hsame]
    simp [hsame]

private theorem characterRankOne_mul
    (left right : PrimeQuditRegisterLabel q Site) :
    (InnerProductSpace.rankOne ℂ (characterKet q left)
      (characterKet q left)).toLinearMap *
        (InnerProductSpace.rankOne ℂ (characterKet q right)
          (characterKet q right)).toLinearMap =
      if left = right then
        (InnerProductSpace.rankOne ℂ (characterKet q right)
          (characterKet q right)).toLinearMap
      else 0 := by
  classical
  ext psi
  simp only [Module.End.mul_apply, InnerProductSpace.toLinearMap_rankOne,
    LinearMap.smulRight_apply, innerₛₗ_apply_apply]
  rw [inner_smul_right]
  by_cases hsame : left = right
  · subst left
    rw [characterKet_inner]
    simp
  · rw [characterKet_inner]
    simp [hsame]

/-- The literal computational-basis projector onto a finite Z-syndrome
sector.  Its summands are the physical rank-one basis projectors, not an
assumed sector predicate. -/
noncomputable def zSyndromeProjector
    (R : CubicRowFamily q Logical Stabilizer Site) (syndrome : ZSyndrome R) :
    Operator (PrimeQuditRegister q Site) :=
  ∑ word : PrimeQuditRegisterLabel q Site,
    if zSyndrome R word = syndrome then
      (InnerProductSpace.rankOne ℂ (registerBasisKet q word)
        (registerBasisKet q word)).toLinearMap
    else 0

/-- A Z-syndrome sector keeps exactly its computational basis labels. -/
theorem zSyndromeProjector_apply_basis
    (R : CubicRowFamily q Logical Stabilizer Site) (syndrome : ZSyndrome R)
    (word : PrimeQuditRegisterLabel q Site) :
    zSyndromeProjector R syndrome (registerBasisKet q word) =
      if zSyndrome R word = syndrome then registerBasisKet q word else 0 := by
  classical
  unfold zSyndromeProjector
  simp only [LinearMap.sum_apply]
  by_cases hsector : zSyndrome R word = syndrome
  · rw [if_pos hsector, Finset.sum_eq_single word]
    · rw [if_pos hsector]
      simp only [InnerProductSpace.toLinearMap_rankOne, LinearMap.smulRight_apply,
        innerₛₗ_apply_apply]
      rw [registerBasisKet_inner_self]
      simp
    · intro other _ hne
      by_cases hother : zSyndrome R other = syndrome
      · rw [if_pos hother]
        simp only [InnerProductSpace.toLinearMap_rankOne, LinearMap.smulRight_apply,
          innerₛₗ_apply_apply]
        rw [registerBasisKet_inner_zero other word hne]
        simp
      · simp [hother]
    · simp
  · rw [if_neg hsector]
    apply Finset.sum_eq_zero
    intro other _
    by_cases hother : zSyndrome R other = syndrome
    · rw [if_pos hother]
      simp only [InnerProductSpace.toLinearMap_rankOne, LinearMap.smulRight_apply,
        innerₛₗ_apply_apply]
      have hne : other ≠ word := by
        intro heq
        subst other
        exact hsector hother
      rw [registerBasisKet_inner_zero other word hne]
      simp
    · simp [hother]

/-- The Z-syndrome projectors form a complete computational measurement. -/
theorem sum_zSyndromeProjector_eq_one
    (R : CubicRowFamily q Logical Stabilizer Site) :
    ∑ syndrome : ZSyndrome R, zSyndromeProjector R syndrome = 1 := by
  classical
  unfold zSyndromeProjector
  rw [Finset.sum_comm]
  simp_rw [Fintype.sum_ite_eq]
  simpa [registerBasisKet, Module.End.one_eq_id] using congrArg ContinuousLinearMap.toLinearMap
    (OrthonormalBasis.sum_rankOne_eq_id
      (EuclideanSpace.basisFun (PrimeQuditRegisterLabel q Site) ℂ))

/-- Each Z-syndrome sector projector is self-adjoint. -/
theorem zSyndromeProjector_adjoint
    (R : CubicRowFamily q Logical Stabilizer Site) (syndrome : ZSyndrome R) :
    LinearMap.adjoint (zSyndromeProjector R syndrome) = zSyndromeProjector R syndrome := by
  classical
  unfold zSyndromeProjector
  rw [map_sum]
  apply Finset.sum_congr rfl
  intro word _
  by_cases hsector : zSyndrome R word = syndrome
  · rw [if_pos hsector]
    rw [LinearMap.adjoint_eq_toCLM_adjoint]
    change ((InnerProductSpace.rankOne ℂ (registerBasisKet q word)
      (registerBasisKet q word)).adjoint).toLinearMap = _
    rw [InnerProductSpace.adjoint_rankOne]
  · simp [hsector]

/-- A Z-syndrome sector projector acts coordinatewise: it retains exactly the
computational amplitudes in its quotient sector. -/
theorem zSyndromeProjector_apply
    (R : CubicRowFamily q Logical Stabilizer Site) (syndrome : ZSyndrome R)
    (psi : PrimeQuditRegister q Site) (word : PrimeQuditRegisterLabel q Site) :
    zSyndromeProjector R syndrome psi word =
      if zSyndrome R word = syndrome then psi word else 0 := by
  have hinner := LinearMap.adjoint_inner_right
    (zSyndromeProjector R syndrome) (registerBasisKet q word) psi
  rw [zSyndromeProjector_adjoint] at hinner
  rw [zSyndromeProjector_apply_basis] at hinner
  by_cases hsector : zSyndrome R word = syndrome
  · rw [if_pos hsector]
    rw [if_pos hsector] at hinner
    rw [registerBasisKet, EuclideanSpace.basisFun_inner,
      EuclideanSpace.basisFun_inner] at hinner
    exact hinner
  · rw [if_neg hsector]
    rw [if_neg hsector] at hinner
    rw [registerBasisKet, EuclideanSpace.basisFun_inner] at hinner
    simpa using hinner

/-- The inverse transversal cubic is diagonal in the computational basis and
therefore commutes pointwise with every actual Z-syndrome sector projector. -/
theorem physicalU13_symm_zSyndromeProjector_apply
    (R : CubicRowFamily q Logical Stabilizer Site) (syndrome : ZSyndrome R)
    (psi : PrimeQuditRegister q Site) (word : PrimeQuditRegisterLabel q Site) :
    (physicalU13 q).symm (zSyndromeProjector R syndrome psi) word =
      zSyndromeProjector R syndrome ((physicalU13 q).symm psi) word := by
  have inversePhase (chi : PrimeQuditRegister q Site) :
      (physicalU13 q).symm chi word =
        phase q (-cubicExponent q word) * chi word := by
    exact physicalU13_symm_apply_phase q chi word
  by_cases hsector : zSyndrome R word = syndrome
  · calc
      (physicalU13 q).symm (zSyndromeProjector R syndrome psi) word =
          phase q (-cubicExponent q word) *
            zSyndromeProjector R syndrome psi word :=
        inversePhase (zSyndromeProjector R syndrome psi)
      _ = phase q (-cubicExponent q word) * psi word := by
            rw [zSyndromeProjector_apply, if_pos hsector]
      _ = zSyndromeProjector R syndrome ((physicalU13 q).symm psi) word := by
            rw [zSyndromeProjector_apply, if_pos hsector]
            exact (inversePhase psi).symm
  · calc
      (physicalU13 q).symm (zSyndromeProjector R syndrome psi) word =
          phase q (-cubicExponent q word) *
            zSyndromeProjector R syndrome psi word :=
        inversePhase (zSyndromeProjector R syndrome psi)
      _ = 0 := by
            rw [zSyndromeProjector_apply, if_neg hsector, mul_zero]
      _ = zSyndromeProjector R syndrome ((physicalU13 q).symm psi) word := by
            rw [zSyndromeProjector_apply, if_neg hsector]

/-- Vector form of the diagonal inverse-transversal commutation with a
physical Z-syndrome sector. -/
theorem physicalU13_symm_zSyndromeProjector
    (R : CubicRowFamily q Logical Stabilizer Site) (syndrome : ZSyndrome R)
    (psi : PrimeQuditRegister q Site) :
    (physicalU13 q).symm (zSyndromeProjector R syndrome psi) =
      zSyndromeProjector R syndrome ((physicalU13 q).symm psi) := by
  ext word
  exact physicalU13_symm_zSyndromeProjector_apply R syndrome psi word

/-- The prescribed physical X correction moves a measured Z-syndrome sector
to the trivial sector, with the representative equation proved in the finite
quotient rather than assumed as correction data. -/
theorem xWordTransport_neg_zSyndromeProjector_apply
    (R : CubicRowFamily q Logical Stabilizer Site) (syndrome : ZSyndrome R)
    (psi : PrimeQuditRegister q Site) (word : PrimeQuditRegisterLabel q Site) :
    xWordTransport q (-zSyndromeRepresentative R syndrome)
        (zSyndromeProjector R syndrome psi) word =
      zSyndromeProjector R 0
        (xWordTransport q (-zSyndromeRepresentative R syndrome) psi) word := by
  by_cases hzero : zSyndrome R word = 0
  · have hsector :
        zSyndrome R (word + zSyndromeRepresentative R syndrome) = syndrome :=
      (zSyndrome_add_representative_eq_iff R word syndrome).2 hzero
    simp [xWordTransport_apply, zSyndromeProjector_apply, sub_neg_eq_add,
      hzero, hsector]
  · have hsector :
        zSyndrome R (word + zSyndromeRepresentative R syndrome) ≠ syndrome := by
      intro h
      exact hzero ((zSyndrome_add_representative_eq_iff R word syndrome).1 h)
    simp [xWordTransport_apply, zSyndromeProjector_apply, sub_neg_eq_add,
      hzero, hsector]

/-- Vector form of the sector translation selected by the concrete quotient
representative. -/
theorem xWordTransport_neg_zSyndromeProjector
    (R : CubicRowFamily q Logical Stabilizer Site) (syndrome : ZSyndrome R)
    (psi : PrimeQuditRegister q Site) :
    xWordTransport q (-zSyndromeRepresentative R syndrome)
        (zSyndromeProjector R syndrome psi) =
      zSyndromeProjector R 0
        (xWordTransport q (-zSyndromeRepresentative R syndrome) psi) := by
  ext word
  exact xWordTransport_neg_zSyndromeProjector_apply R syndrome psi word

/-- Translating a character ket by a negative word preserves its character
label and contributes exactly the corresponding finite-field phase. -/
theorem xWordTransport_neg_characterKet
    (error shift : PrimeQuditRegisterLabel q Site) :
    xWordTransport q (-shift) (characterKet q error) =
      phase q (registerPairing q error shift) • characterKet q error := by
  ext label
  simp only [xWordTransport_apply, WithLp.ofLp_smul, Pi.smul_apply, smul_eq_mul,
    characterKet_apply, sub_neg_eq_add]
  have hpairing : registerPairing q error (label + shift) =
      registerPairing q error label + registerPairing q error shift := by
    simp [registerPairing, mul_add, Finset.sum_add_distrib]
  rw [hpairing, phase_add]
  ring

/-- A stabilizer-row translation acts on a character ket by the negative
stabilizer-syndrome phase of its literal error word. -/
theorem xWordTransport_stabilizerRow_characterKet
    (R : CubicRowFamily q Logical Stabilizer Site)
    (error : PrimeQuditRegisterLabel q Site) (index : Stabilizer) :
    xWordTransport q (R.stabilizerRow index) (characterKet q error) =
      phase q (-xSyndrome R error index) • characterKet q error := by
  simpa [xSyndrome, registerPairing, wordPairing_apply, dotProduct,
    Finset.sum_neg_distrib] using
    (xWordTransport_neg_characterKet (q := q) error (-R.stabilizerRow index))

/-- After the concrete Z-sector projection and restored physical cubic layer,
each actual stabilizer translation still has the syndrome phase of the input
error word.  The only phase preservation used here is the proved cubic-row
normal form on the measured row carrier. -/
theorem xWordTransport_stabilizerRow_physicalU13_zSyndromeProjector
    (R : CubicRowFamily q Logical Stabilizer Site)
    (error : PrimeQuditRegisterLabel q Site) (index : Stabilizer) :
    xWordTransport q (R.stabilizerRow index)
        (physicalU13 q (zSyndromeProjector R 0 (characterKet q error))) =
      phase q (-xSyndrome R error index) •
        physicalU13 q (zSyndromeProjector R 0 (characterKet q error)) := by
  ext word
  have hrow : R.stabilizerRow index ∈ rowCarrier R := by
    unfold rowCarrier
    exact Submodule.subset_span ⟨Sum.inr index, rfl⟩
  have hshift :
      zSyndrome R (word - R.stabilizerRow index) = zSyndrome R word := by
    have htranslate := zSyndrome_add_mem_rowCarrier R
      (word - R.stabilizerRow index) (R.stabilizerRow index) hrow
    simpa using htranslate.symm
  by_cases hsector : zSyndrome R word = 0
  · have hshiftSector : zSyndrome R (word - R.stabilizerRow index) = 0 := by
      rw [hshift]
      exact hsector
    have hcarrier : word ∈ rowCarrier R :=
      (zSyndrome_eq_zero_iff_mem_rowCarrier R word).1 hsector
    have hcubic := cubicExponent_sub_stabilizerRow_of_mem_rowCarrier
      R word hcarrier index
    have hpairing :
        registerPairing q error (word - R.stabilizerRow index) =
          registerPairing q error word - xSyndrome R error index := by
      simp only [registerPairing, xSyndrome, wordPairing_apply, dotProduct,
        Pi.sub_apply, mul_sub, Finset.sum_sub_distrib]
    simp only [xWordTransport_apply, WithLp.ofLp_smul, Pi.smul_apply,
      smul_eq_mul]
    rw [physicalU13_apply_phase, physicalU13_apply_phase,
      zSyndromeProjector_apply, zSyndromeProjector_apply,
      if_pos hshiftSector, if_pos hsector, characterKet_apply, hcubic, hpairing]
    rw [show registerPairing q error word - xSyndrome R error index =
        registerPairing q error word + -xSyndrome R error index by abel,
      phase_add]
    rw [characterKet_apply]
    ring
  · have hshiftSector : zSyndrome R (word - R.stabilizerRow index) ≠ 0 := by
      intro hzero
      apply hsector
      rw [← hshift]
      exact hzero
    simp only [xWordTransport_apply, WithLp.ofLp_smul, Pi.smul_apply,
      smul_eq_mul]
    rw [physicalU13_apply_phase, physicalU13_apply_phase,
      zSyndromeProjector_apply, zSyndromeProjector_apply,
      if_neg hshiftSector, if_neg hsector]
    simp

/-- Different literal stabilizer syndromes give orthogonal character-ket
components after the actual trivial-sector projection and restored physical
cubic layer.  This is derived from the concrete stabilizer-row eigenphases,
rather than by assuming that the Z and X projectors commute. -/
theorem characterKet_inner_physicalU13_zSyndromeProjector_eq_zero_of_xSyndrome_ne
    (R : CubicRowFamily q Logical Stabilizer Site)
    (label error : PrimeQuditRegisterLabel q Site)
    (hsyndrome : xSyndrome R label ≠ xSyndrome R error) :
    inner ℂ (characterKet q label)
      (physicalU13 q (zSyndromeProjector R 0 (characterKet q error))) = 0 := by
  classical
  obtain ⟨index, hindex⟩ :
      ∃ index, xSyndrome R label index ≠ xSyndrome R error index := by
    by_contra h
    push_neg at h
    exact hsyndrome (funext h)
  have hunit := (xWordTransport q (R.stabilizerRow index)).map_inner
    (characterKet q label)
    (physicalU13 q (zSyndromeProjector R 0 (characterKet q error)))
  have heigen :
      (phase q (-xSyndrome R error index) *
          starRingEnd ℂ (phase q (-xSyndrome R label index))) *
        inner ℂ (characterKet q label)
          (physicalU13 q (zSyndromeProjector R 0 (characterKet q error))) =
      inner ℂ (characterKet q label)
        (physicalU13 q (zSyndromeProjector R 0 (characterKet q error))) := by
    rw [xWordTransport_stabilizerRow_characterKet,
      xWordTransport_stabilizerRow_physicalU13_zSyndromeProjector] at hunit
    simpa only [inner_smul_left, inner_smul_right, ← mul_assoc] using hunit
  have hphase :
      phase q (-xSyndrome R error index) *
          starRingEnd ℂ (phase q (-xSyndrome R label index)) =
        phase q (xSyndrome R label index - xSyndrome R error index) := by
    rw [phase_conj, ← phase_add]
    congr 1
    abel
  rw [hphase] at heigen
  have hphase_ne_one :
      phase q (xSyndrome R label index - xSyndrome R error index) ≠ 1 := by
    intro hphase
    apply hindex
    exact sub_eq_zero.mp ((phase_eq_one_iff q _).1 hphase)
  have hfactor_ne_zero :
      phase q (xSyndrome R label index - xSyndrome R error index) - 1 ≠ 0 :=
    sub_ne_zero.mpr hphase_ne_one
  have hmul_zero :
      (phase q (xSyndrome R label index - xSyndrome R error index) - 1) *
        inner ℂ (characterKet q label)
          (physicalU13 q (zSyndromeProjector R 0 (characterKet q error))) = 0 := by
    rw [sub_mul, one_mul, heigen, sub_self]
  exact (mul_eq_zero.mp hmul_zero).resolve_left hfactor_ne_zero

/-- Applying a Z-syndrome sector projector twice changes no physical state. -/
theorem zSyndromeProjector_idempotent
    (R : CubicRowFamily q Logical Stabilizer Site) (syndrome : ZSyndrome R) :
    (zSyndromeProjector R syndrome).comp (zSyndromeProjector R syndrome) =
      zSyndromeProjector R syndrome := by
  classical
  rw [← Module.End.mul_eq_comp]
  unfold zSyndromeProjector
  rw [Fintype.sum_mul_sum]
  simp_rw [ite_mul, mul_ite, zero_mul, mul_zero, computationalRankOne_mul]
  apply Finset.sum_congr rfl
  intro left _
  by_cases hsector : zSyndrome R left = syndrome
  · rw [if_pos hsector]
    rw [Finset.sum_eq_single left]
    · simp [hsector]
    · intro right _ hne
      have hleftRight : left ≠ right := Ne.symm hne
      simp [hsector, hleftRight]
    · simp
  · simp [hsector]

/-- The actual sector projector has the Kraus adjoint-square required for a
physical projective measurement. -/
theorem zSyndromeProjector_adjoint_comp
    (R : CubicRowFamily q Logical Stabilizer Site) (syndrome : ZSyndrome R) :
    (LinearMap.adjoint (zSyndromeProjector R syndrome)).comp
        (zSyndromeProjector R syndrome) = zSyndromeProjector R syndrome := by
  rw [zSyndromeProjector_adjoint]
  exact zSyndromeProjector_idempotent R syndrome

/-- The literal Fourier-basis projector onto one stabilizer X-syndrome. -/
noncomputable def xSyndromeProjector
    (R : CubicRowFamily q Logical Stabilizer Site) (syndrome : Stabilizer → ZMod q) :
    Operator (PrimeQuditRegister q Site) :=
  ∑ word : PrimeQuditRegisterLabel q Site,
    if xSyndrome R word = syndrome then
      (InnerProductSpace.rankOne ℂ (characterKet q word)
        (characterKet q word)).toLinearMap
    else 0

/-- An X-syndrome sector keeps exactly its character-basis labels. -/
theorem xSyndromeProjector_apply_characterKet
    (R : CubicRowFamily q Logical Stabilizer Site) (syndrome : Stabilizer → ZMod q)
    (word : PrimeQuditRegisterLabel q Site) :
    xSyndromeProjector R syndrome (characterKet q word) =
      if xSyndrome R word = syndrome then characterKet q word else 0 := by
  classical
  unfold xSyndromeProjector
  simp only [LinearMap.sum_apply]
  by_cases hsector : xSyndrome R word = syndrome
  · rw [if_pos hsector, Finset.sum_eq_single word]
    · rw [if_pos hsector]
      simp only [InnerProductSpace.toLinearMap_rankOne, LinearMap.smulRight_apply,
        innerₛₗ_apply_apply]
      rw [characterKet_inner]
      simp
    · intro other _ hne
      by_cases hother : xSyndrome R other = syndrome
      · rw [if_pos hother]
        simp only [InnerProductSpace.toLinearMap_rankOne, LinearMap.smulRight_apply,
          innerₛₗ_apply_apply]
        rw [characterKet_inner]
        simp [hne]
      · simp [hother]
    · simp
  · rw [if_neg hsector]
    apply Finset.sum_eq_zero
    intro other _
    by_cases hother : xSyndrome R other = syndrome
    · rw [if_pos hother]
      simp only [InnerProductSpace.toLinearMap_rankOne, LinearMap.smulRight_apply,
        innerₛₗ_apply_apply]
      rw [characterKet_inner]
      have hne : other ≠ word := by
        intro heq
        subst other
        exact hsector hother
      simp [hne]
    · simp [hother]

/-- The literal X-sector measurement of the corrected physical state keeps
exactly its derived stabilizer syndrome.  This uses the proved eigenphase
orthogonality of the actual corrected sector state, rather than a blanket
commutation assertion for the two measurements. -/
theorem xSyndromeProjector_apply_physicalU13_zSyndromeProjector_characterKet
    (R : CubicRowFamily q Logical Stabilizer Site)
    (syndrome : Stabilizer → ZMod q)
    (error : PrimeQuditRegisterLabel q Site) :
    xSyndromeProjector R syndrome
        (physicalU13 q (zSyndromeProjector R 0 (characterKet q error))) =
      if xSyndrome R error = syndrome then
        physicalU13 q (zSyndromeProjector R 0 (characterKet q error))
      else 0 := by
  classical
  by_cases hsector : xSyndrome R error = syndrome
  · rw [if_pos hsector]
    unfold xSyndromeProjector
    simp only [LinearMap.sum_apply]
    have hcomplete :
        (∑ label : PrimeQuditRegisterLabel q Site,
          (InnerProductSpace.rankOne ℂ (characterKet q label)
            (characterKet q label)).toLinearMap)
          (physicalU13 q (zSyndromeProjector R 0 (characterKet q error))) =
        physicalU13 q (zSyndromeProjector R 0 (characterKet q error)) := by
      rw [sum_characterKet_rankOne_eq_one q]
      rfl
    calc
      (∑ label : PrimeQuditRegisterLabel q Site,
          (if xSyndrome R label = syndrome then
            (InnerProductSpace.rankOne ℂ (characterKet q label)
              (characterKet q label)).toLinearMap
          else 0)
            (physicalU13 q (zSyndromeProjector R 0 (characterKet q error)))) =
          ∑ label : PrimeQuditRegisterLabel q Site,
            (InnerProductSpace.rankOne ℂ (characterKet q label)
              (characterKet q label)).toLinearMap
                (physicalU13 q (zSyndromeProjector R 0 (characterKet q error))) := by
        apply Finset.sum_congr rfl
        intro label _
        by_cases hlabel : xSyndrome R label = syndrome
        · rw [if_pos hlabel]
        · rw [if_neg hlabel]
          simp only [LinearMap.zero_apply, InnerProductSpace.toLinearMap_rankOne,
            LinearMap.smulRight_apply, innerₛₗ_apply_apply]
          have hlabelError : xSyndrome R label ≠ xSyndrome R error := by
            intro heq
            exact hlabel (heq.trans hsector)
          rw [characterKet_inner_physicalU13_zSyndromeProjector_eq_zero_of_xSyndrome_ne
            R label error hlabelError]
          simp
      _ = physicalU13 q (zSyndromeProjector R 0 (characterKet q error)) := by
        simpa only [LinearMap.sum_apply] using hcomplete
  · rw [if_neg hsector]
    unfold xSyndromeProjector
    simp only [LinearMap.sum_apply]
    apply Finset.sum_eq_zero
    intro label _
    by_cases hlabel : xSyndrome R label = syndrome
    · rw [if_pos hlabel]
      simp only [InnerProductSpace.toLinearMap_rankOne, LinearMap.smulRight_apply,
        innerₛₗ_apply_apply]
      have hlabelError : xSyndrome R label ≠ xSyndrome R error := by
        intro heq
        exact hsector (heq.symm.trans hlabel)
      rw [characterKet_inner_physicalU13_zSyndromeProjector_eq_zero_of_xSyndrome_ne
        R label error hlabelError]
      simp
    · simp [hlabel]

/-- The X-syndrome projectors form the complete character-basis measurement. -/
theorem sum_xSyndromeProjector_eq_one
    (R : CubicRowFamily q Logical Stabilizer Site) :
    ∑ syndrome : Stabilizer → ZMod q, xSyndromeProjector R syndrome = 1 := by
  classical
  unfold xSyndromeProjector
  rw [Finset.sum_comm]
  simp_rw [Fintype.sum_ite_eq]
  exact sum_characterKet_rankOne_eq_one q

/-- Each X-syndrome sector projector is self-adjoint. -/
theorem xSyndromeProjector_adjoint
    (R : CubicRowFamily q Logical Stabilizer Site) (syndrome : Stabilizer → ZMod q) :
    LinearMap.adjoint (xSyndromeProjector R syndrome) = xSyndromeProjector R syndrome := by
  classical
  unfold xSyndromeProjector
  rw [map_sum]
  apply Finset.sum_congr rfl
  intro word _
  by_cases hsector : xSyndrome R word = syndrome
  · rw [if_pos hsector]
    rw [LinearMap.adjoint_eq_toCLM_adjoint]
    change ((InnerProductSpace.rankOne ℂ (characterKet q word)
      (characterKet q word)).adjoint).toLinearMap = _
    rw [InnerProductSpace.adjoint_rankOne]
  · simp [hsector]

/-- Applying an X-syndrome sector projector twice changes no physical state. -/
theorem xSyndromeProjector_idempotent
    (R : CubicRowFamily q Logical Stabilizer Site) (syndrome : Stabilizer → ZMod q) :
    (xSyndromeProjector R syndrome).comp (xSyndromeProjector R syndrome) =
      xSyndromeProjector R syndrome := by
  classical
  rw [← Module.End.mul_eq_comp]
  unfold xSyndromeProjector
  rw [Fintype.sum_mul_sum]
  simp_rw [ite_mul, mul_ite, zero_mul, mul_zero, characterRankOne_mul]
  apply Finset.sum_congr rfl
  intro left _
  by_cases hsector : xSyndrome R left = syndrome
  · rw [if_pos hsector]
    rw [Finset.sum_eq_single left]
    · simp [hsector]
    · intro right _ hne
      have hleftRight : left ≠ right := Ne.symm hne
      simp [hsector, hleftRight]
    · simp
  · simp [hsector]

/-- The actual X-sector projector has the Kraus adjoint-square required for a
physical projective measurement. -/
theorem xSyndromeProjector_adjoint_comp
    (R : CubicRowFamily q Logical Stabilizer Site) (syndrome : Stabilizer → ZMod q) :
    (LinearMap.adjoint (xSyndromeProjector R syndrome)).comp
        (xSyndromeProjector R syndrome) = xSyndromeProjector R syndrome := by
  rw [xSyndromeProjector_adjoint]
  exact xSyndromeProjector_idempotent R syndrome

/-- The physical Z-syndrome measurement has one coherent Kraus branch per
sector.  It therefore does not reveal a full computational word. -/
noncomputable def zSyndromeKrausFamily
    (R : CubicRowFamily q Logical Stabilizer Site) :
    FiniteKrausFamily (ZSyndrome R)
      (PrimeQuditRegister q Site) (PrimeQuditRegister q Site) where
  operator syndrome := zSyndromeProjector R syndrome

/-- Completeness follows from the partition of the actual computational basis
into quotient sectors. -/
theorem zSyndromeKrausFamily_complete
    (R : CubicRowFamily q Logical Stabilizer Site) :
    (zSyndromeKrausFamily R).Complete := by
  rw [FiniteKrausFamily.Complete]
  simp only [zSyndromeKrausFamily]
  rw [Finset.sum_congr rfl (fun syndrome _ =>
    zSyndromeProjector_adjoint_comp R syndrome)]
  exact sum_zSyndromeProjector_eq_one R

/-- The finite physical Z-syndrome instrument, whose branch label is exactly
the quotient syndrome it reports. -/
noncomputable def zSyndromeInstrument
    (R : CubicRowFamily q Logical Stabilizer Site) :
    FiniteInstrument (ZSyndrome R) (ZSyndrome R)
      (PrimeQuditRegister q Site) (PrimeQuditRegister q Site) where
  kraus := zSyndromeKrausFamily R
  observe := id

theorem zSyndromeInstrument_complete
    (R : CubicRowFamily q Logical Stabilizer Site) :
    (zSyndromeInstrument R).kraus.Complete :=
  zSyndromeKrausFamily_complete R

/-- The physical X-syndrome measurement has one coherent Kraus branch per
Fourier-sector.  It therefore does not reveal a full character word. -/
noncomputable def xSyndromeKrausFamily
    (R : CubicRowFamily q Logical Stabilizer Site) :
    FiniteKrausFamily (Stabilizer → ZMod q)
      (PrimeQuditRegister q Site) (PrimeQuditRegister q Site) where
  operator syndrome := xSyndromeProjector R syndrome

/-- Completeness follows from the partition of the actual register Fourier
basis into stabilizer syndrome sectors. -/
theorem xSyndromeKrausFamily_complete
    (R : CubicRowFamily q Logical Stabilizer Site) :
    (xSyndromeKrausFamily R).Complete := by
  rw [FiniteKrausFamily.Complete]
  simp only [xSyndromeKrausFamily]
  rw [Finset.sum_congr rfl (fun syndrome _ =>
    xSyndromeProjector_adjoint_comp R syndrome)]
  exact sum_xSyndromeProjector_eq_one R

/-- The finite physical X-syndrome instrument, whose branch label is exactly
the stabilizer syndrome it reports. -/
noncomputable def xSyndromeInstrument
    (R : CubicRowFamily q Logical Stabilizer Site) :
    FiniteInstrument (Stabilizer → ZMod q) (Stabilizer → ZMod q)
      (PrimeQuditRegister q Site) (PrimeQuditRegister q Site) where
  kraus := xSyndromeKrausFamily R
  observe := id

theorem xSyndromeInstrument_complete
    (R : CubicRowFamily q Logical Stabilizer Site) :
    (xSyndromeInstrument R).kraus.Complete :=
  xSyndromeKrausFamily_complete R

/-! ## The complete corrected KT19 syndrome instrument -/

/-- The appendix correction selected by a measured Z syndrome.  This is
literally `U13 · X(-w_mu) · U13†`, with `w_mu` the chosen representative of
the measured quotient sector. -/
noncomputable def zSyndromeCorrection
    (R : CubicRowFamily q Logical Stabilizer Site) (mu : ZSyndrome R) :
    UnitaryTransport (PrimeQuditRegister q Site) (PrimeQuditRegister q Site) :=
  ((physicalU13 q).symm.trans
    (xWordTransport q (-zSyndromeRepresentative R mu))).trans (physicalU13 q)

/-- On a literal magic-register error word, the prescribed correction moves
the observed Z sector to the trivial sector and leaves only its derived
character phase. -/
theorem zSyndromeCorrection_apply_zSyndromeProjector_magicRegisterKet
    (R : CubicRowFamily q Logical Stabilizer Site) (mu : ZSyndrome R)
    (error : PrimeQuditRegisterLabel q Site) :
    zSyndromeCorrection R mu
        (zSyndromeProjector R mu (magicRegisterKet q error)) =
      phase q (registerPairing q error (zSyndromeRepresentative R mu)) •
        physicalU13 q (zSyndromeProjector R 0 (characterKet q error)) := by
  change physicalU13 q
      (xWordTransport q (-zSyndromeRepresentative R mu)
        ((physicalU13 q).symm
          (zSyndromeProjector R mu (magicRegisterKet q error)))) = _
  rw [physicalU13_symm_zSyndromeProjector,
    inverseTransversal_magicRegisterKet,
    xWordTransport_neg_zSyndromeProjector,
    xWordTransport_neg_characterKet]
  simp only [map_smul]

/-- The actual X-syndrome instrument after the correction selected by one
Z-syndrome outcome.  It is obtained by unitary transport of the physical
X-sector instrument, so its completeness is inherited from actual operators. -/
noncomputable def correctionThenXKrausFamily
    (R : CubicRowFamily q Logical Stabilizer Site) (mu : ZSyndrome R) :
    FiniteKrausFamily (Stabilizer → ZMod q)
      (PrimeQuditRegister q Site) (PrimeQuditRegister q Site) :=
  (xSyndromeKrausFamily R).unitaryTransport (zSyndromeCorrection R mu).symm
    (UnitaryTransport.identity (PrimeQuditRegister q Site))

theorem correctionThenXKrausFamily_complete
    (R : CubicRowFamily q Logical Stabilizer Site) (mu : ZSyndrome R) :
    (correctionThenXKrausFamily R mu).Complete := by
  exact (xSyndromeKrausFamily R).unitaryTransport_complete
    (zSyndromeCorrection R mu).symm
    (UnitaryTransport.identity (PrimeQuditRegister q Site))
    (xSyndromeKrausFamily_complete R)

/-- The physical KT19 Kraus branch `K_(mu,sigma)`: first project to the
measured Z sector, apply the syndrome-dependent appendix correction, then
project to the measured X sector. -/
noncomputable def kt19ProtocolKrausFamily
    (R : CubicRowFamily q Logical Stabilizer Site) :
    FiniteKrausFamily (ZSyndrome R × (Stabilizer → ZMod q))
      (PrimeQuditRegister q Site) (PrimeQuditRegister q Site) where
  operator branch :=
    (xSyndromeProjector R branch.2).comp
      ((zSyndromeCorrection R branch.1).toLinearEquiv.toLinearMap.comp
        (zSyndromeProjector R branch.1))

/-- Each fine physical KT19 branch acts on a literal magic-register error
word by the derived corrected X-sector action.  This is stated before binary
coarsening, so acceptance remains a consequence of the actual measured
syndrome rather than a supplied word predicate. -/
theorem kt19ProtocolKrausFamily_apply_magicRegisterKet
    (R : CubicRowFamily q Logical Stabilizer Site)
    (mu : ZSyndrome R) (sigma : Stabilizer → ZMod q)
    (error : PrimeQuditRegisterLabel q Site) :
    (kt19ProtocolKrausFamily R).operator (mu, sigma) (magicRegisterKet q error) =
      if xSyndrome R error = sigma then
        phase q (registerPairing q error (zSyndromeRepresentative R mu)) •
          physicalU13 q (zSyndromeProjector R 0 (characterKet q error))
      else 0 := by
  change xSyndromeProjector R sigma
      (zSyndromeCorrection R mu
        (zSyndromeProjector R mu (magicRegisterKet q error))) = _
  rw [zSyndromeCorrection_apply_zSyndromeProjector_magicRegisterKet]
  rw [map_smul,
    xSyndromeProjector_apply_physicalU13_zSyndromeProjector_characterKet]
  by_cases hsyndrome : xSyndrome R error = sigma <;> simp [hsyndrome]

/-- The fine physical instrument retains every Z/X syndrome pair. -/
noncomputable def kt19ProtocolInstrument
    (R : CubicRowFamily q Logical Stabilizer Site) :
    FiniteInstrument (ZSyndrome R × (Stabilizer → ZMod q))
      (ZSyndrome R × (Stabilizer → ZMod q))
      (PrimeQuditRegister q Site) (PrimeQuditRegister q Site) where
  kraus := kt19ProtocolKrausFamily R
  observe := id

/-- Completeness of the full physical KT19 instrument is derived by binding
the complete Z measurement to the correction-transported complete X
measurement; it does not assume a channel or outcome law. -/
theorem kt19ProtocolInstrument_complete
    (R : CubicRowFamily q Logical Stabilizer Site) :
    (kt19ProtocolInstrument R).kraus.Complete := by
  let afterZ : (mu : ZSyndrome R) →
      FiniteInstrument (Stabilizer → ZMod q) (Stabilizer → ZMod q)
        (PrimeQuditRegister q Site) (PrimeQuditRegister q Site) :=
    fun mu =>
      { kraus := correctionThenXKrausFamily R mu
        observe := id }
  have hbound := (zSyndromeInstrument R).bind_complete afterZ
    (zSyndromeInstrument_complete R) (fun mu => correctionThenXKrausFamily_complete R mu)
  simpa [kt19ProtocolInstrument, kt19ProtocolKrausFamily, afterZ,
    correctionThenXKrausFamily, FiniteInstrument.bind, UnitaryTransport.symm,
    UnitaryTransport.identity, xSyndromeKrausFamily, zSyndromeInstrument,
    zSyndromeKrausFamily, LinearMap.comp_assoc] using hbound

/-- The physical channel obtained by forgetting the detailed syndrome record.
It is CPTP only after the preceding Kraus-completeness proof. -/
noncomputable def kt19ProtocolChannel
    (R : CubicRowFamily q Logical Stabilizer Site) :
    QuantumChannel (PrimeQuditRegister q Site) (PrimeQuditRegister q Site) :=
  (kt19ProtocolInstrument R).kraus.toQuantumChannel
    (kt19ProtocolInstrument_complete R)

/-- Whether a measured X syndrome is the accepted trivial syndrome. -/
def kt19SyndromeOutcome (sigma : Stabilizer → ZMod q) : DistillationOutcome :=
  if sigma = 0 then .accepted else .rejected

/-- The computable accept test for a retained Z/X-syndrome pair.  The only
accepted physical outcomes are those with trivial X syndrome. -/
def kt19Accepts (R : CubicRowFamily q Logical Stabilizer Site)
    (branch : ZSyndrome R × (Stabilizer → ZMod q)) : Bool :=
  decide (branch.2 = 0)

theorem kt19Accepts_iff
    (R : CubicRowFamily q Logical Stabilizer Site)
    (branch : ZSyndrome R × (Stabilizer → ZMod q)) :
    kt19Accepts R branch = true ↔ branch.2 = 0 := by
  simp [kt19Accepts]

/-- The same physical Kraus family, now observed through the required binary
distillation outcome.  Both accepted and rejected branches remain derived
from the complete instrument. -/
noncomputable def kt19DistillationInstrument
    (R : CubicRowFamily q Logical Stabilizer Site) :
    FiniteInstrument (ZSyndrome R × (Stabilizer → ZMod q)) DistillationOutcome
      (PrimeQuditRegister q Site) (PrimeQuditRegister q Site) :=
  (kt19ProtocolInstrument R).binaryCoarsen (kt19Accepts R)

theorem kt19DistillationInstrument_complete
    (R : CubicRowFamily q Logical Stabilizer Site) :
    (kt19DistillationInstrument R).kraus.Complete :=
  (kt19ProtocolInstrument R).binaryCoarsen_complete (kt19Accepts R)
    (kt19ProtocolInstrument_complete R)

/-! ## The actual trace-preserving KT19 decoder -/

/-- The isometric carrier decoded coherently by the KT19 decoder.  It is the
physical cubic layer after the concrete CSS encoder after the inverse logical
cubic layer.  Taking its adjoint is therefore exactly
`U13_logical · V† · U13_physical†`. -/
noncomputable def kt19DecoderEncodingIsometry
    (R : CubicRowFamily q Logical Stabilizer Site) :
    PrimeQuditRegister q Logical →ₗᵢ[Complex] PrimeQuditRegister q Site := by
  letI : DecidableEq Logical := Classical.decEq _
  let physical : UnitaryTransport (PrimeQuditRegister q Site)
      (PrimeQuditRegister q Site) := physicalU13 q
  let logical : UnitaryTransport (PrimeQuditRegister q Logical)
      (PrimeQuditRegister q Logical) := physicalU13 q
  exact physical.toLinearIsometryEquiv.toLinearIsometry.comp
    (R.encodingIsometry.comp logical.symm.toLinearIsometryEquiv.toLinearIsometry)

/-- The coherent KT19 decoder branch on the actual encoded carrier. -/
def kt19DecoderCodeBranch
    (R : CubicRowFamily q Logical Stabilizer Site) :
    PrimeQuditRegister q Site →ₗ[Complex] PrimeQuditRegister q Logical :=
  LinearMap.adjoint (kt19DecoderEncodingIsometry R).toLinearMap

@[simp]
theorem kt19DecoderCodeBranch_encoded
    (R : CubicRowFamily q Logical Stabilizer Site)
    (psi : PrimeQuditRegister q Logical) :
    kt19DecoderCodeBranch R (kt19DecoderEncodingIsometry R psi) = psi := by
  change LinearMap.adjoint (kt19DecoderEncodingIsometry R).toLinearMap
    ((kt19DecoderEncodingIsometry R).toLinearMap psi) = psi
  exact LinearMap.congr_fun (kt19DecoderEncodingIsometry R).adjoint_comp_self' psi

theorem adjoint_kt19DecoderCodeBranch
    (R : CubicRowFamily q Logical Stabilizer Site) :
    LinearMap.adjoint (kt19DecoderCodeBranch R) =
      (kt19DecoderEncodingIsometry R).toLinearMap := by
  rw [kt19DecoderCodeBranch, LinearMap.adjoint_adjoint]

/-- The carrier projector induced by the coherent inverse decoder. -/
def kt19DecoderCodeProjector
    (R : CubicRowFamily q Logical Stabilizer Site) :
    Operator (PrimeQuditRegister q Site) :=
  (LinearMap.adjoint (kt19DecoderCodeBranch R)).comp (kt19DecoderCodeBranch R)

@[simp]
theorem kt19DecoderCodeProjector_encoded
    (R : CubicRowFamily q Logical Stabilizer Site)
    (psi : PrimeQuditRegister q Logical) :
    kt19DecoderCodeProjector R (kt19DecoderEncodingIsometry R psi) =
      kt19DecoderEncodingIsometry R psi := by
  change LinearMap.adjoint (kt19DecoderCodeBranch R)
    (kt19DecoderCodeBranch R (kt19DecoderEncodingIsometry R psi)) =
      kt19DecoderEncodingIsometry R psi
  rw [kt19DecoderCodeBranch_encoded, adjoint_kt19DecoderCodeBranch]
  rfl

theorem kt19DecoderCodeBranch_comp_adjoint
    (R : CubicRowFamily q Logical Stabilizer Site) :
    (kt19DecoderCodeBranch R).comp
        (LinearMap.adjoint (kt19DecoderCodeBranch R)) = 1 := by
  rw [adjoint_kt19DecoderCodeBranch, kt19DecoderCodeBranch]
  exact (kt19DecoderEncodingIsometry R).adjoint_comp_self'

theorem kt19DecoderCodeProjector_idempotent
    (R : CubicRowFamily q Logical Stabilizer Site) :
    (kt19DecoderCodeProjector R).comp (kt19DecoderCodeProjector R) =
      kt19DecoderCodeProjector R := by
  rw [kt19DecoderCodeProjector]
  calc
    ((LinearMap.adjoint (kt19DecoderCodeBranch R)).comp (kt19DecoderCodeBranch R)).comp
        ((LinearMap.adjoint (kt19DecoderCodeBranch R)).comp
          (kt19DecoderCodeBranch R)) =
        (LinearMap.adjoint (kt19DecoderCodeBranch R)).comp
          (((kt19DecoderCodeBranch R).comp
            (LinearMap.adjoint (kt19DecoderCodeBranch R))).comp
              (kt19DecoderCodeBranch R)) := by
            ext psi
            rfl
    _ = (LinearMap.adjoint (kt19DecoderCodeBranch R)).comp
          ((1 : Operator (PrimeQuditRegister q Logical)).comp
            (kt19DecoderCodeBranch R)) := by
            rw [kt19DecoderCodeBranch_comp_adjoint]
    _ = (LinearMap.adjoint (kt19DecoderCodeBranch R)).comp
          (kt19DecoderCodeBranch R) := by
            ext psi
            rfl

theorem kt19DecoderCodeProjector_adjoint
    (R : CubicRowFamily q Logical Stabilizer Site) :
    LinearMap.adjoint (kt19DecoderCodeProjector R) = kt19DecoderCodeProjector R := by
  simp [kt19DecoderCodeProjector, LinearMap.adjoint_comp]

/-- The orthogonal complement required to make the KT19 decoder trace
preserving on the entire physical Hilbert space. -/
def kt19DecoderComplementProjector
    (R : CubicRowFamily q Logical Stabilizer Site) :
    Operator (PrimeQuditRegister q Site) :=
  1 - kt19DecoderCodeProjector R

theorem kt19DecoderComplementProjector_adjoint
    (R : CubicRowFamily q Logical Stabilizer Site) :
    LinearMap.adjoint (kt19DecoderComplementProjector R) =
      kt19DecoderComplementProjector R := by
  simp [kt19DecoderComplementProjector, kt19DecoderCodeProjector_adjoint]

theorem kt19DecoderComplementProjector_idempotent
    (R : CubicRowFamily q Logical Stabilizer Site) :
    (kt19DecoderComplementProjector R).comp
        (kt19DecoderComplementProjector R) =
      kt19DecoderComplementProjector R := by
  ext psi
  have hprojector := LinearMap.congr_fun
    (kt19DecoderCodeProjector_idempotent R) psi
  simp only [kt19DecoderComplementProjector, LinearMap.comp_apply,
    LinearMap.sub_apply, Module.End.one_apply, map_sub] at hprojector ⊢
  rw [hprojector]
  abel_nf

@[simp]
theorem kt19DecoderComplementProjector_encoded
    (R : CubicRowFamily q Logical Stabilizer Site)
    (psi : PrimeQuditRegister q Logical) :
    kt19DecoderComplementProjector R (kt19DecoderEncodingIsometry R psi) = 0 := by
  simp only [kt19DecoderComplementProjector, LinearMap.sub_apply, Module.End.one_apply]
  rw [kt19DecoderCodeProjector_encoded]
  abel_nf

/-- A fixed normalized logical basis ket used only on the decoder complement. -/
noncomputable def kt19DecoderFallbackState
    (R : CubicRowFamily q Logical Stabilizer Site) : PrimeQuditRegister q Logical := by
  classical
  exact registerBasisKet q (fun _ => 0)

theorem kt19DecoderFallbackState_inner_self
    (R : CubicRowFamily q Logical Stabilizer Site) :
    inner Complex (kt19DecoderFallbackState R) (kt19DecoderFallbackState R) = 1 := by
  classical
  simp [kt19DecoderFallbackState, registerBasisKet, EuclideanSpace.basisFun_apply]

private theorem kt19DecoderFallbackState_normSq
    (R : CubicRowFamily q Logical Stabilizer Site) :
    ‖kt19DecoderFallbackState R‖ ^ 2 = 1 := by
  rw [InnerProductSpace.norm_sq_eq_re_inner (𝕜 := Complex),
    kt19DecoderFallbackState_inner_self]
  norm_num

private noncomputable def kt19DecoderPhysicalBasis
    (R : CubicRowFamily q Logical Stabilizer Site) :=
  stdOrthonormalBasis Complex (PrimeQuditRegister q Site)

/-- One finite complement branch erases a projected physical basis direction
to the fixed logical fallback. -/
def kt19ComplementDecoderBranch
    (R : CubicRowFamily q Logical Stabilizer Site)
    (i : Fin (Module.finrank Complex (PrimeQuditRegister q Site))) :
    PrimeQuditRegister q Site →ₗ[Complex] PrimeQuditRegister q Logical :=
  (InnerProductSpace.rankOne Complex (kt19DecoderFallbackState R)
    (kt19DecoderComplementProjector R (kt19DecoderPhysicalBasis R i))).toLinearMap

theorem kt19ComplementDecoderBranch_adjoint_comp
    (R : CubicRowFamily q Logical Stabilizer Site)
    (i : Fin (Module.finrank Complex (PrimeQuditRegister q Site))) :
    (LinearMap.adjoint (kt19ComplementDecoderBranch R i)).comp
        (kt19ComplementDecoderBranch R i) =
      (InnerProductSpace.rankOne Complex
        (kt19DecoderComplementProjector R (kt19DecoderPhysicalBasis R i))
        (kt19DecoderComplementProjector R (kt19DecoderPhysicalBasis R i))).toLinearMap := by
  have hadjoint : LinearMap.adjoint
      ((InnerProductSpace.rankOne Complex (kt19DecoderFallbackState R)
        (kt19DecoderComplementProjector R (kt19DecoderPhysicalBasis R i))).toLinearMap) =
      (InnerProductSpace.rankOne Complex
        (kt19DecoderComplementProjector R (kt19DecoderPhysicalBasis R i))
        (kt19DecoderFallbackState R)).toLinearMap := by
    rw [LinearMap.adjoint_eq_toCLM_adjoint]
    change ((InnerProductSpace.rankOne Complex (kt19DecoderFallbackState R)
      (kt19DecoderComplementProjector R (kt19DecoderPhysicalBasis R i))).adjoint).toLinearMap = _
    rw [InnerProductSpace.adjoint_rankOne]
  apply LinearMap.ext
  intro psi
  simp only [kt19ComplementDecoderBranch]
  rw [hadjoint]
  have hnormSq : (↑‖kt19DecoderFallbackState R‖ : Complex) ^ 2 = 1 := by
    norm_cast
    exact kt19DecoderFallbackState_normSq R
  simp [LinearMap.comp_apply, hnormSq]

theorem sum_kt19ComplementDecoderBranch_adjoint_comp
    (R : CubicRowFamily q Logical Stabilizer Site) :
    ∑ i : Fin (Module.finrank Complex (PrimeQuditRegister q Site)),
        (LinearMap.adjoint (kt19ComplementDecoderBranch R i)).comp
          (kt19ComplementDecoderBranch R i) =
      kt19DecoderComplementProjector R := by
  simp_rw [kt19ComplementDecoderBranch_adjoint_comp]
  calc
    (∑ i, (InnerProductSpace.rankOne Complex
      (kt19DecoderComplementProjector R (kt19DecoderPhysicalBasis R i))
      (kt19DecoderComplementProjector R (kt19DecoderPhysicalBasis R i))).toLinearMap) =
      (kt19DecoderComplementProjector R).comp
        (LinearMap.adjoint (kt19DecoderComplementProjector R)) := by
        apply LinearMap.ext
        intro psi
        simp only [LinearMap.sum_apply, LinearMap.comp_apply]
        rw [← (kt19DecoderPhysicalBasis R).sum_repr'
          (LinearMap.adjoint (kt19DecoderComplementProjector R) psi)]
        simp only [map_sum, map_smul]
        apply Finset.sum_congr rfl
        intro i _hi
        rw [LinearMap.adjoint_inner_right]
        rfl
    _ = (kt19DecoderComplementProjector R).comp
        (kt19DecoderComplementProjector R) := by
      rw [kt19DecoderComplementProjector_adjoint]
    _ = kt19DecoderComplementProjector R :=
      kt19DecoderComplementProjector_idempotent R

/-- The finite Kraus completion of the actual KT19 coherent decoder. -/
def kt19DecoderKrausFamily
    (R : CubicRowFamily q Logical Stabilizer Site) :
    FiniteKrausFamily
      (Sum Unit (Fin (Module.finrank Complex (PrimeQuditRegister q Site))))
      (PrimeQuditRegister q Site) (PrimeQuditRegister q Logical) where
  operator
    | .inl _ => kt19DecoderCodeBranch R
    | .inr i => kt19ComplementDecoderBranch R i

theorem kt19DecoderKrausFamily_complete
    (R : CubicRowFamily q Logical Stabilizer Site) :
    (kt19DecoderKrausFamily R).Complete := by
  rw [FiniteKrausFamily.Complete, Fintype.sum_sum_type]
  change (∑ _ : Unit, kt19DecoderCodeProjector R) +
      (∑ i : Fin (Module.finrank Complex (PrimeQuditRegister q Site)),
        (LinearMap.adjoint (kt19ComplementDecoderBranch R i)).comp
          (kt19ComplementDecoderBranch R i)) = 1
  rw [Fintype.sum_unique, sum_kt19ComplementDecoderBranch_adjoint_comp]
  simp [kt19DecoderComplementProjector]

/-- The actual CPTP KT19 decoder: coherent inverse decoding on its concrete
carrier, with a finite physical complement completion. -/
noncomputable def kt19DecoderChannel
    (R : CubicRowFamily q Logical Stabilizer Site) :
    QuantumChannel (PrimeQuditRegister q Site) (PrimeQuditRegister q Logical) :=
  (kt19DecoderKrausFamily R).toQuantumChannel (kt19DecoderKrausFamily_complete R)

private theorem kt19SandwichRankOne {H K : Type u}
    [NormedAddCommGroup H] [InnerProductSpace Complex H] [FiniteQuantumSystem H]
    [NormedAddCommGroup K] [InnerProductSpace Complex K] [FiniteQuantumSystem K]
    (L : H →ₗ[Complex] K) (psi : H) :
    L.comp ((InnerProductSpace.rankOne Complex psi psi).toLinearMap.comp
      (LinearMap.adjoint L)) =
      (InnerProductSpace.rankOne Complex (L psi) (L psi)).toLinearMap := by
  ext x
  simp [LinearMap.comp_apply, InnerProductSpace.rankOne_apply,
    LinearMap.adjoint_inner_right]

/-- On the coherent encoded carrier, the total decoder agrees with the actual
inverse-decoding branch; all complement Kraus terms vanish. -/
theorem kt19DecoderChannel_rankOne_encoded
    (R : CubicRowFamily q Logical Stabilizer Site)
    (psi : PrimeQuditRegister q Logical) :
    kt19DecoderChannel R (InnerProductSpace.rankOne Complex
      (kt19DecoderEncodingIsometry R psi)
      (kt19DecoderEncodingIsometry R psi)).toLinearMap =
      (InnerProductSpace.rankOne Complex psi psi).toLinearMap := by
  rw [kt19DecoderChannel, FiniteKrausFamily.toQuantumChannel_apply_sum,
    Fintype.sum_sum_type]
  simp only [kt19DecoderKrausFamily]
  simp_rw [kt19SandwichRankOne]
  rw [Fintype.sum_unique]
  simp only [kt19DecoderCodeBranch_encoded]
  have hcomplement : ∀ i, kt19ComplementDecoderBranch R i
      (kt19DecoderEncodingIsometry R psi) = 0 := by
    intro i
    have hinner : inner Complex
        (kt19DecoderComplementProjector R (kt19DecoderPhysicalBasis R i))
        (kt19DecoderEncodingIsometry R psi) = 0 := by
      rw [← LinearMap.adjoint_inner_right, kt19DecoderComplementProjector_adjoint,
        kt19DecoderComplementProjector_encoded]
      simp
    change inner Complex
      (kt19DecoderComplementProjector R (kt19DecoderPhysicalBasis R i))
      (kt19DecoderEncodingIsometry R psi) • kt19DecoderFallbackState R = 0
    rw [hinner]
    simp
  simp_rw [hcomplement]
  simp

/-! ## The decoded zero-word reference -/

/-- The measured zero Z-sector is exactly the finite union of the concrete
logical/stabilizer coset labels.  This is kept local because it serves only
the zero-word reference calculation for the physical #883 endpoint. -/
private theorem kt19RowCarrier_mem_iff_exists_cosetLabel
    (R : CubicRowFamily q Logical Stabilizer Site)
    (word : PrimeQuditRegisterLabel q Site) :
    word ∈ rowCarrier R ↔
      ∃ logical : Logical → ZMod q, ∃ stabilizer : Stabilizer → ZMod q,
        R.cosetLabel logical stabilizer = word := by
  classical
  constructor
  · intro hword
    obtain ⟨coefficient, hcoefficient⟩ :=
      (Submodule.mem_span_range_iff_exists_fun (ZMod q)).mp hword
    change R.combinedWord coefficient = word at hcoefficient
    let logical : Logical → ZMod q := fun index => -coefficient (Sum.inl index)
    let stabilizer : Stabilizer → ZMod q := fun index => coefficient (Sum.inr index)
    refine ⟨logical, stabilizer, ?_⟩
    have hcoefficient_eq :
        CubicRowFamily.combinedCoefficient logical stabilizer = coefficient := by
      funext row
      rcases row with index | index
      · simp [logical, CubicRowFamily.combinedCoefficient]
      · simp [stabilizer, CubicRowFamily.combinedCoefficient]
    rw [R.cosetLabel_eq_combinedWord, hcoefficient_eq, hcoefficient]
  · rintro ⟨logical, stabilizer, hlabel⟩
    apply (Submodule.mem_span_range_iff_exists_fun (ZMod q)).mpr
    refine ⟨CubicRowFamily.combinedCoefficient logical stabilizer, ?_⟩
    change R.combinedWord (CubicRowFamily.combinedCoefficient logical stabilizer) = word
    rw [← R.cosetLabel_eq_combinedWord]
    exact hlabel

/-- The literal zero character has the same finite Fourier amplitude on every
computational label. -/
private theorem kt19CharacterKet_zero_apply
    (word : PrimeQuditRegisterLabel q Site) :
    characterKet q 0 word =
      (Real.sqrt (q : Real) : Complex)⁻¹ ^ Fintype.card Site := by
  rw [characterKet_apply]
  simp [registerPairing]

/-- The concrete finite coset normalization never vanishes. -/
private theorem kt19CosetNormalization_ne_zero
    (R : CubicRowFamily q Logical Stabilizer Site) :
    CubicRowFamily.cosetNormalization q Stabilizer ≠ 0 := by
  intro hzero
  have hunit := R.cosetNormalization_conj_mul_card
  rw [hzero] at hunit
  norm_num at hunit

/-- The existing normalized-coset inner-product formula, written as the
computational coordinate needed by the local zero-word calculation. -/
private theorem kt19CosetKet_apply_of_cosetLabel
    (R : CubicRowFamily q Logical Stabilizer Site)
    (logical : Logical → ZMod q) (stabilizer : Stabilizer → ZMod q) :
    (R.cosetKet logical).ofLp (R.cosetLabel logical stabilizer) =
      CubicRowFamily.cosetNormalization q Stabilizer := by
  simpa [registerBasisKet, EuclideanSpace.basisFun_apply,
    EuclideanSpace.inner_single_left] using
    R.cosetKet_apply logical stabilizer

/-- A normalized logical coset has zero computational amplitude away from
its finite stabilizer-label support.  Keeping this inner finite sum separate
prevents the encoder calculation from silently treating a nested sum as zero. -/
private theorem kt19CosetKet_apply_eq_zero_of_not_mem
    (R : CubicRowFamily q Logical Stabilizer Site)
    (logical : Logical → ZMod q) (word : PrimeQuditRegisterLabel q Site)
    (hword : ∀ stabilizer : Stabilizer → ZMod q,
      R.cosetLabel logical stabilizer ≠ word) :
    (R.cosetKet logical).ofLp word = 0 := by
  classical
  unfold CubicRowFamily.cosetKet
  simp only [WithLp.ofLp_smul, Pi.smul_apply, smul_eq_mul,
    WithLp.ofLp_sum, Finset.sum_apply]
  rw [Finset.mul_sum]
  apply Finset.sum_eq_zero
  intro stabilizer _
  have hne := hword stabilizer
  have hne' : word ≠ R.cosetLabel logical stabilizer := Ne.symm hne
  simp [registerBasisKet, EuclideanSpace.basisFun_apply, hne, hne']

/-- The explicit CSS encoder has exactly one zero-character contribution on
each word of the measured row carrier and no contribution off that carrier. -/
private theorem kt19Encoding_characterKet_zero_apply
    (R : CubicRowFamily q Logical Stabilizer Site)
    (word : PrimeQuditRegisterLabel q Site) :
    R.encodingLinearMap (characterKet q 0) word =
      if word ∈ rowCarrier R then
        CubicRowFamily.cosetNormalization q Stabilizer *
          ((Real.sqrt (q : Real) : Complex)⁻¹ ^ Fintype.card Logical)
      else 0 := by
  classical
  by_cases hword : word ∈ rowCarrier R
  · obtain ⟨logical, stabilizer, hlabel⟩ :=
      (kt19RowCarrier_mem_iff_exists_cosetLabel R word).mp hword
    rw [if_pos hword]
    change (∑ logical : Logical → ZMod q,
      characterKet q 0 logical • R.cosetKet logical).ofLp word = _
    simp only [WithLp.ofLp_sum, WithLp.ofLp_smul, Pi.smul_apply, smul_eq_mul,
      Finset.sum_apply]
    rw [Finset.sum_eq_single logical]
    · rw [← hlabel, kt19CosetKet_apply_of_cosetLabel R logical stabilizer,
        kt19CharacterKet_zero_apply (q := q) (Site := Logical) logical]
      ring
    · intro other _ hother
      have hnot : ∀ stabilizer' : Stabilizer → ZMod q,
          R.cosetLabel other stabilizer' ≠ word := by
        intro stabilizer' heq
        apply hother
        exact R.cosetLabel_eq_implies_logical_eq other logical stabilizer'
          stabilizer (heq.trans hlabel.symm)
      rw [kt19CosetKet_apply_eq_zero_of_not_mem R other word hnot]
      simp
    · simp
  · rw [if_neg hword]
    change (∑ logical : Logical → ZMod q,
      characterKet q 0 logical • R.cosetKet logical).ofLp word = 0
    simp only [WithLp.ofLp_sum, WithLp.ofLp_smul, Pi.smul_apply, smul_eq_mul,
      Finset.sum_apply]
    apply Finset.sum_eq_zero
    intro logical _
    have hnot : ∀ stabilizer : Stabilizer → ZMod q,
        R.cosetLabel logical stabilizer ≠ word := by
      intro stabilizer heq
      apply hword
      exact (kt19RowCarrier_mem_iff_exists_cosetLabel R word).mpr
        ⟨logical, stabilizer, heq⟩
    rw [kt19CosetKet_apply_eq_zero_of_not_mem R logical word hnot]
    simp

/-- The decoder carrier sends the literal zero magic register through the
physical cubic layer after the concrete CSS encoding of the zero character. -/
private theorem kt19DecoderEncodingIsometry_magicRegisterKet_zero
    (R : CubicRowFamily q Logical Stabilizer Site) :
    kt19DecoderEncodingIsometry R (magicRegisterKet q 0) =
      physicalU13 q (R.encodingLinearMap (characterKet q 0)) := by
  change physicalU13 q
      (R.encodingLinearMap ((physicalU13 q).symm (magicRegisterKet q 0))) = _
  rw [inverseTransversal_magicRegisterKet]

/-- The physical zero-syndrome component of the zero error word lies on the
actual decoder's encoded ideal ray.  Its normalization is retained explicitly
so the later raw-branch calculation can recover it from the measured Born
weight instead of assuming a success scalar. -/
private theorem kt19ZeroWord_sector_is_encoded
    (R : CubicRowFamily q Logical Stabilizer Site) :
    ∃ scale : Complex,
      physicalU13 q (zSyndromeProjector R 0 (characterKet q 0)) =
        scale • kt19DecoderEncodingIsometry R (magicRegisterKet q 0) := by
  let physicalAmplitude : Complex :=
    (Real.sqrt (q : Real) : Complex)⁻¹ ^ Fintype.card Site
  let encodedAmplitude : Complex :=
    CubicRowFamily.cosetNormalization q Stabilizer *
      ((Real.sqrt (q : Real) : Complex)⁻¹ ^ Fintype.card Logical)
  have hqpos : (0 : Real) < (q : Real) := by
    exact_mod_cast Nat.pos_of_ne_zero (NeZero.ne q)
  have hsqrt : (Real.sqrt (q : Real) : Complex) ≠ 0 := by
    exact_mod_cast Real.sqrt_ne_zero'.mpr hqpos
  have hlogicalAmplitude :
      ((Real.sqrt (q : Real) : Complex)⁻¹ ^ Fintype.card Logical) ≠ 0 := by
    exact pow_ne_zero _ (inv_ne_zero hsqrt)
  have hencodedAmplitude : encodedAmplitude ≠ 0 := by
    dsimp [encodedAmplitude]
    exact mul_ne_zero (kt19CosetNormalization_ne_zero R) hlogicalAmplitude
  let scale : Complex := physicalAmplitude * encodedAmplitude⁻¹
  have hscale_encoded : scale * encodedAmplitude = physicalAmplitude := by
    calc
      scale * encodedAmplitude =
          (physicalAmplitude * encodedAmplitude⁻¹) * encodedAmplitude := by rfl
      _ = physicalAmplitude * (encodedAmplitude⁻¹ * encodedAmplitude) := by
        rw [mul_assoc]
      _ = physicalAmplitude := by
        rw [inv_mul_cancel₀ hencodedAmplitude, mul_one]
  have hprojector :
      zSyndromeProjector R 0 (characterKet q 0) =
        scale • R.encodingLinearMap (characterKet q 0) := by
    ext word
    change (zSyndromeProjector R 0 (characterKet q 0)).ofLp word =
      (scale • R.encodingLinearMap (characterKet q 0)).ofLp word
    simp only [WithLp.ofLp_smul, Pi.smul_apply, smul_eq_mul]
    by_cases hword : word ∈ rowCarrier R
    · have hsector : zSyndrome R word = 0 :=
        (zSyndrome_eq_zero_iff_mem_rowCarrier R word).mpr hword
      rw [zSyndromeProjector_apply, if_pos hsector,
        kt19Encoding_characterKet_zero_apply R word, if_pos hword,
        kt19CharacterKet_zero_apply]
      simpa [physicalAmplitude, encodedAmplitude] using hscale_encoded.symm
    · have hsector : zSyndrome R word ≠ 0 := by
        intro hzero
        exact hword ((zSyndrome_eq_zero_iff_mem_rowCarrier R word).mp hzero)
      rw [zSyndromeProjector_apply, if_neg hsector,
        kt19Encoding_characterKet_zero_apply R word, if_neg hword]
      simp
  refine ⟨scale, ?_⟩
  rw [hprojector, map_smul,
    ← kt19DecoderEncodingIsometry_magicRegisterKet_zero]

/-- For an accepted physical word, encoding its routed logical character has
the same character phase on every supported CSS coset label, and vanishes off
the measured row carrier. -/
private theorem kt19Encoding_characterKet_routed_apply
    (R : CubicRowFamily q Logical Stabilizer Site)
    (error : PrimeQuditRegisterLabel q Site)
    (haccepted : kt19AcceptedWord R error)
    (word : PrimeQuditRegisterLabel q Site) :
    R.encodingLinearMap (characterKet q (kt19LogicalRouting R error)) word =
      if word ∈ rowCarrier R then
        CubicRowFamily.cosetNormalization q Stabilizer *
          ((Real.sqrt (q : Real) : Complex)⁻¹ ^ Fintype.card Logical) *
            phase q (registerPairing q error word)
      else 0 := by
  classical
  by_cases hword : word ∈ rowCarrier R
  · obtain ⟨logical, stabilizer, hlabel⟩ :=
      (kt19RowCarrier_mem_iff_exists_cosetLabel R word).mp hword
    rw [if_pos hword]
    change (∑ logical : Logical → ZMod q,
      characterKet q (kt19LogicalRouting R error) logical •
        R.cosetKet logical).ofLp word = _
    simp only [WithLp.ofLp_sum, WithLp.ofLp_smul, Pi.smul_apply, smul_eq_mul,
      Finset.sum_apply]
    rw [Finset.sum_eq_single logical]
    · have hpairing := kt19AcceptedWord_registerPairing_cosetLabel
        R error logical stabilizer haccepted
      rw [← hlabel, kt19CosetKet_apply_of_cosetLabel R logical stabilizer,
        characterKet_apply, ← hpairing]
      ring
    · intro other _ hother
      have hnot : ∀ stabilizer' : Stabilizer → ZMod q,
          R.cosetLabel other stabilizer' ≠ word := by
        intro stabilizer' heq
        apply hother
        exact R.cosetLabel_eq_implies_logical_eq other logical stabilizer'
          stabilizer (heq.trans hlabel.symm)
      rw [kt19CosetKet_apply_eq_zero_of_not_mem R other word hnot]
      simp
    · simp
  · rw [if_neg hword]
    change (∑ logical : Logical → ZMod q,
      characterKet q (kt19LogicalRouting R error) logical •
        R.cosetKet logical).ofLp word = 0
    simp only [WithLp.ofLp_sum, WithLp.ofLp_smul, Pi.smul_apply, smul_eq_mul,
      Finset.sum_apply]
    apply Finset.sum_eq_zero
    intro logical _
    have hnot : ∀ stabilizer : Stabilizer → ZMod q,
        R.cosetLabel logical stabilizer ≠ word := by
      intro stabilizer heq
      apply hword
      exact (kt19RowCarrier_mem_iff_exists_cosetLabel R word).mpr
        ⟨logical, stabilizer, heq⟩
    rw [kt19CosetKet_apply_eq_zero_of_not_mem R logical word hnot]
    simp

/-- The decoder carrier maps every logical magic-register basis word through
the physical cubic layer after encoding its corresponding character ket. -/
private theorem kt19DecoderEncodingIsometry_magicRegisterKet
    (R : CubicRowFamily q Logical Stabilizer Site)
    (label : PrimeQuditRegisterLabel q Logical) :
    kt19DecoderEncodingIsometry R (magicRegisterKet q label) =
      physicalU13 q (R.encodingLinearMap (characterKet q label)) := by
  change physicalU13 q
      (R.encodingLinearMap ((physicalU13 q).symm (magicRegisterKet q label))) = _
  rw [inverseTransversal_magicRegisterKet]

/-- The accepted zero-Z-syndrome component of every accepted error word lies
on the actual decoder ray indexed by the derived logical routing label. -/
private theorem kt19AcceptedWord_sector_is_routed_encoded
    (R : CubicRowFamily q Logical Stabilizer Site)
    (error : PrimeQuditRegisterLabel q Site)
    (haccepted : kt19AcceptedWord R error) :
    ∃ scale : Complex,
      physicalU13 q (zSyndromeProjector R 0 (characterKet q error)) =
        scale • kt19DecoderEncodingIsometry R
          (magicRegisterKet q (kt19LogicalRouting R error)) := by
  let physicalAmplitude : Complex :=
    (Real.sqrt (q : Real) : Complex)⁻¹ ^ Fintype.card Site
  let encodedAmplitude : Complex :=
    CubicRowFamily.cosetNormalization q Stabilizer *
      ((Real.sqrt (q : Real) : Complex)⁻¹ ^ Fintype.card Logical)
  have hqpos : (0 : Real) < (q : Real) := by
    exact_mod_cast Nat.pos_of_ne_zero (NeZero.ne q)
  have hsqrt : (Real.sqrt (q : Real) : Complex) ≠ 0 := by
    exact_mod_cast Real.sqrt_ne_zero'.mpr hqpos
  have hlogicalAmplitude :
      ((Real.sqrt (q : Real) : Complex)⁻¹ ^ Fintype.card Logical) ≠ 0 := by
    exact pow_ne_zero _ (inv_ne_zero hsqrt)
  have hencodedAmplitude : encodedAmplitude ≠ 0 := by
    dsimp [encodedAmplitude]
    exact mul_ne_zero (kt19CosetNormalization_ne_zero R) hlogicalAmplitude
  let scale : Complex := physicalAmplitude * encodedAmplitude⁻¹
  have hscale_encoded : scale * encodedAmplitude = physicalAmplitude := by
    calc
      scale * encodedAmplitude =
          (physicalAmplitude * encodedAmplitude⁻¹) * encodedAmplitude := by rfl
      _ = physicalAmplitude * (encodedAmplitude⁻¹ * encodedAmplitude) := by
        rw [mul_assoc]
      _ = physicalAmplitude := by
        rw [inv_mul_cancel₀ hencodedAmplitude, mul_one]
  have hprojector :
      zSyndromeProjector R 0 (characterKet q error) =
        scale • R.encodingLinearMap
          (characterKet q (kt19LogicalRouting R error)) := by
    ext word
    change (zSyndromeProjector R 0 (characterKet q error)).ofLp word =
      (scale • R.encodingLinearMap
        (characterKet q (kt19LogicalRouting R error))).ofLp word
    simp only [WithLp.ofLp_smul, Pi.smul_apply, smul_eq_mul]
    by_cases hword : word ∈ rowCarrier R
    · have hsector : zSyndrome R word = 0 :=
        (zSyndrome_eq_zero_iff_mem_rowCarrier R word).mpr hword
      rw [zSyndromeProjector_apply, if_pos hsector,
        kt19Encoding_characterKet_routed_apply R error haccepted word,
        if_pos hword, characterKet_apply]
      change physicalAmplitude * phase q (registerPairing q error word) =
        scale * (encodedAmplitude * phase q (registerPairing q error word))
      rw [← mul_assoc, hscale_encoded]
    · have hsector : zSyndrome R word ≠ 0 := by
        intro hzero
        exact hword ((zSyndrome_eq_zero_iff_mem_rowCarrier R word).mp hzero)
      rw [zSyndromeProjector_apply, if_neg hsector,
        kt19Encoding_characterKet_routed_apply R error haccepted word,
        if_neg hword]
      simp
  refine ⟨scale, ?_⟩
  rw [hprojector, map_smul,
    ← kt19DecoderEncodingIsometry_magicRegisterKet]

/-! ## IID run and guarded physical endpoints -/

/-- The approved input is one actual finite register resource.  Its defining
convex decomposition is the IID product distribution over sitewise
magic-basis error labels from `magicRegisterResource`; this wrapper does not
replace it with a uniform or correlated noise model. -/
noncomputable def kt19IIDResource
    (mu : ZMod q → ℝ) (hmu_nonneg : ∀ a : ZMod q, 0 ≤ mu a)
    (hmu_sum : ∑ a : ZMod q, mu a = 1) :
    DensityOperator (PrimeQuditRegister q Site) :=
  magicRegisterResource q mu hmu_nonneg hmu_sum

/-- One normalized diagonal IID component, retained explicitly so that every
later success identity is a finite sum over actual magic-register words. -/
noncomputable def kt19WordInputDensity
    (error : PrimeQuditRegisterLabel q Site) :
    DensityOperator (PrimeQuditRegister q Site) :=
  DensityOperator.pureDensity (magicRegisterKet q error) (by
    rw [InnerProductSpace.norm_sq_eq_re_inner (𝕜 := Complex),
      magicRegisterKet_inner_self]
    norm_num)

/-! ## Independent single-site preparation -/

/-- A universe-polymorphic singleton physical site.  Using a one-site
register rather than the universe-zero abbreviation `PrimeQudit` keeps the
resource, input, and output carriers in the common universe required by
`DistillationRun`, without changing the one-qudit Hilbert dimension. -/
abbrev KT19SingleResourceSite : Type u := ULift.{u} PUnit

/-- The actual one-qudit resource carrier used by a generic KT19 run. -/
abbrev KT19SingleQudit (q : Nat) [NeZero q] : Type u :=
  PrimeQuditRegister q KT19SingleResourceSite.{u}

/-- Identify a prime-field label with the unique word on the singleton
resource site. -/
private def kt19SingleSiteLabelEquiv :
    ZMod q ≃ PrimeQuditRegisterLabel q KT19SingleResourceSite.{u} where
  toFun label := fun _ => label
  invFun word := word default
  left_inv _ := rfl
  right_inv word := by
    funext site
    rw [Subsingleton.elim site default]

/-- The singleton word selected by one prime-field magic label. -/
def kt19SingleSiteLabel (label : ZMod q) :
    PrimeQuditRegisterLabel q KT19SingleResourceSite.{u} :=
  kt19SingleSiteLabelEquiv label

/-- One normalized singleton-register magic-basis component. -/
private noncomputable def kt19SingleSiteWordDensity
    (word : PrimeQuditRegisterLabel q KT19SingleResourceSite.{u}) :
    DensityOperator (KT19SingleQudit.{u} q) :=
  DensityOperator.pureDensity (magicRegisterKet q word) (by
    rw [InnerProductSpace.norm_sq_eq_re_inner (𝕜 := Complex),
      magicRegisterKet_inner_self]
    norm_num)

/-- A one-site resource retains the owner's arbitrary prime-field weight
vector while living in the generic run's universe. -/
noncomputable def kt19SingleSiteResource
    (mu : ZMod q → ℝ) (hmu_nonneg : ∀ a : ZMod q, 0 ≤ mu a)
    (hmu_sum : ∑ a : ZMod q, mu a = 1) :
    DensityOperator (KT19SingleQudit.{u} q) :=
  magicRegisterResource q mu hmu_nonneg hmu_sum

/-- The singleton resource expands over the actual one-site magic-register
word densities. -/
private theorem kt19SingleSiteResource_toOperator
    (mu : ZMod q → ℝ) (hmu_nonneg : ∀ a : ZMod q, 0 ≤ mu a)
    (hmu_sum : ∑ a : ZMod q, mu a = 1) :
    (kt19SingleSiteResource mu hmu_nonneg hmu_sum).toOperator =
      ∑ word : PrimeQuditRegisterLabel q KT19SingleResourceSite.{u},
        (wordProbability q mu word : Complex) •
          (kt19SingleSiteWordDensity word).toOperator := by
  unfold kt19SingleSiteResource magicRegisterResource
  rw [DensityOperator.convexCombination_toOperator]
  rfl

/-- A one-site magic-register projector sandwiches a pure density into the
rank-one density of the projected ket. -/
private theorem kt19SingleSite_sandwich_rankOne
    (observed : PrimeQuditRegisterLabel q KT19SingleResourceSite.{u})
    (psi : KT19SingleQudit.{u} q) :
    ((magicRegisterKrausFamily q).operator observed).comp
        ((InnerProductSpace.rankOne Complex psi psi).toLinearMap.comp
          (LinearMap.adjoint ((magicRegisterKrausFamily q).operator observed))) =
      (InnerProductSpace.rankOne Complex
        ((magicRegisterKrausFamily q).operator observed psi)
        ((magicRegisterKrausFamily q).operator observed psi)).toLinearMap := by
  ext x
  simp [LinearMap.comp_apply, InnerProductSpace.rankOne_apply,
    LinearMap.adjoint_inner_right]

/-- The singleton-register projective Kraus operator retains exactly its
matching magic-basis word. -/
private theorem kt19SingleSiteKraus_apply_magicRegisterKet
    (observed actual : PrimeQuditRegisterLabel q KT19SingleResourceSite.{u}) :
    (magicRegisterKrausFamily q).operator observed (magicRegisterKet q actual) =
      if observed = actual then magicRegisterKet q actual else 0 := by
  simp only [magicRegisterKrausFamily, InnerProductSpace.toLinearMap_rankOne,
    LinearMap.smulRight_apply, innerₛₗ_apply_apply]
  by_cases hlabel : observed = actual
  · subst actual
    rw [magicRegisterKet_inner_self]
    simp only [one_smul, if_pos]
  · rw [magicRegisterKet_inner]
    simp only [if_neg hlabel, zero_smul]

/-- One observed singleton-register branch is its projector sandwich. -/
private theorem kt19SingleSiteInstrument_branchOperator_eq_sandwich
    (observed : PrimeQuditRegisterLabel q KT19SingleResourceSite.{u})
    (A : Operator (KT19SingleQudit.{u} q)) :
    (magicRegisterInstrument q).branchOperator observed A =
      ((magicRegisterKrausFamily q).operator observed).comp
        (A.comp (LinearMap.adjoint ((magicRegisterKrausFamily q).operator observed))) := by
  classical
  rw [FiniteInstrument.branchOperator_apply]
  rw [Fintype.sum_eq_single observed]
  · simp [magicRegisterInstrument]
  · intro other hother
    simp [magicRegisterInstrument, hother]

/-- Measuring a singleton-register magic density returns exactly its word. -/
private theorem kt19SingleSiteInstrument_branch_wordDensity
    (observed actual : PrimeQuditRegisterLabel q KT19SingleResourceSite.{u}) :
    (magicRegisterInstrument q).branchOperator observed
        (kt19SingleSiteWordDensity actual).toOperator =
      if observed = actual then (kt19SingleSiteWordDensity actual).toOperator else 0 := by
  rw [kt19SingleSiteInstrument_branchOperator_eq_sandwich]
  unfold kt19SingleSiteWordDensity
  rw [DensityOperator.pureDensity_toOperator, kt19SingleSite_sandwich_rankOne,
    kt19SingleSiteKraus_apply_magicRegisterKet]
  by_cases hlabel : observed = actual
  · rw [if_pos hlabel]
    simp only [if_pos hlabel]
  · rw [if_neg hlabel]
    apply LinearMap.ext
    intro psi
    simp only [InnerProductSpace.toLinearMap_rankOne,
      LinearMap.smulRight_apply, innerₛₗ_apply_apply, inner_zero_left,
      zero_smul, if_neg hlabel]
    simp only [LinearMap.zero_apply]

/-- The complete singleton-register measurement recovers every literal word
weight of the supplied one-site resource. -/
private theorem kt19SingleSiteInstrument_bornWeight_resource
    (mu : ZMod q → ℝ) (hmu_nonneg : ∀ a : ZMod q, 0 ≤ mu a)
    (hmu_sum : ∑ a : ZMod q, mu a = 1)
    (observed : PrimeQuditRegisterLabel q KT19SingleResourceSite.{u}) :
    (magicRegisterInstrument q).bornWeight observed
        (kt19SingleSiteResource mu hmu_nonneg hmu_sum) =
      wordProbability q mu observed := by
  classical
  unfold FiniteInstrument.bornWeight
  rw [kt19SingleSiteResource_toOperator,
    FiniteInstrument.branchOperator_sum, map_sum, Complex.re_sum]
  simp_rw [FiniteInstrument.branchOperator_smul, map_smul,
    kt19SingleSiteInstrument_branch_wordDensity]
  rw [Finset.sum_eq_single observed]
  · simp [DensityOperator.trace_toOperator]
  · intro other _ hother
    simp [hother.symm]
  · simp

/-- A singleton word carries exactly its one prime-field label weight. -/
private theorem kt19SingleSite_wordProbability
    (mu : ZMod q → ℝ) (label : ZMod q) :
    wordProbability q mu (kt19SingleSiteLabel label) = mu label := by
  unfold wordProbability kt19SingleSiteLabel kt19SingleSiteLabelEquiv
  rw [Fintype.prod_unique]
  rfl

/-- The actual noisy input slots are individual prime-qudit resources, one
for every physical site.  Their common density has the arbitrary
owner-selected magic-label distribution `mu`; independence is realized by
the finite product preparation below rather than by packaging a whole noisy
register into one resource slot. -/
noncomputable def kt19NoisySingleSiteResources
    (mu : ZMod q → ℝ) (hmu_nonneg : ∀ a : ZMod q, 0 ≤ mu a)
    (hmu_sum : ∑ a : ZMod q, mu a = 1) :
    ResourceInput (Fintype.card Site) (KT19SingleQudit.{u} q) :=
  fun _ => kt19SingleSiteResource mu hmu_nonneg hmu_sum

/-- Match the abstract physical-site type with the finite input slots exposed
by `DistillationRun.resourceCount`. -/
private noncomputable def kt19ResourceSiteEquiv :
    Site ≃ Fin (Fintype.card Site) :=
  Fintype.equivFin Site

/-- Product probability of observing one complete magic-label word when the
complete one-site magic-basis instrument is applied independently to all
supplied physical resources. -/
private noncomputable def kt19MeasuredWordProbability
    (inputs : ResourceInput (Fintype.card Site) (KT19SingleQudit.{u} q))
    (error : PrimeQuditRegisterLabel q Site) : ℝ :=
  ∏ site : Site,
    (magicRegisterInstrument q).bornWeight (kt19SingleSiteLabel (error site))
      (inputs (kt19ResourceSiteEquiv (Site := Site) site))

private theorem kt19MeasuredWordProbability_nonneg
    (inputs : ResourceInput (Fintype.card Site) (KT19SingleQudit.{u} q))
    (error : PrimeQuditRegisterLabel q Site) :
    0 ≤ kt19MeasuredWordProbability (q := q) inputs error := by
  unfold kt19MeasuredWordProbability
  exact Finset.prod_nonneg (fun site _ =>
    (magicRegisterInstrument q).bornWeight_nonneg (kt19SingleSiteLabel (error site))
      (inputs (kt19ResourceSiteEquiv (Site := Site) site)))

private theorem kt19MeasuredWordProbability_sum_eq_one
    (inputs : ResourceInput (Fintype.card Site) (KT19SingleQudit.{u} q)) :
    ∑ error : PrimeQuditRegisterLabel q Site,
      kt19MeasuredWordProbability (q := q) inputs error = 1 := by
  classical
  have hsite (site : Site) :
      ∑ label : ZMod q,
        (magicRegisterInstrument q).bornWeight (kt19SingleSiteLabel label)
          (inputs (kt19ResourceSiteEquiv (Site := Site) site)) = 1 := by
    calc
      _ = ∑ word : PrimeQuditRegisterLabel q KT19SingleResourceSite.{u},
          (magicRegisterInstrument q).bornWeight word
            (inputs (kt19ResourceSiteEquiv (Site := Site) site)) := by
        exact Fintype.sum_equiv kt19SingleSiteLabelEquiv _ _ (fun _ => rfl)
      _ = 1 := (magicRegisterInstrument q).sum_bornWeight_eq_one
        (magicRegisterKrausFamily_complete q)
        (inputs (kt19ResourceSiteEquiv (Site := Site) site))
  change (∑ error : Site → ZMod q, ∏ site : Site,
      (magicRegisterInstrument q).bornWeight (kt19SingleSiteLabel (error site))
        (inputs (kt19ResourceSiteEquiv (Site := Site) site))) = 1
  rw [labelUniv_eq_piUniv]
  rw [Fintype_sum_fn_prod (R := ℝ) (ι := Site) (α := ZMod q)
    (fun site label =>
      (magicRegisterInstrument q).bornWeight (kt19SingleSiteLabel label)
        (inputs (kt19ResourceSiteEquiv (Site := Site) site)))]
  simp_rw [hsite]
  simp

/-- A genuine finite preparation/injection operation: measure every supplied
single-site resource in the complete magic basis and prepare the corresponding
sitewise magic-register word.  Its word law is the product of the actually
observed one-site Born weights. -/
noncomputable def kt19PrepareInput
    (inputs : ResourceInput (Fintype.card Site) (KT19SingleQudit.{u} q)) :
    DensityOperator (PrimeQuditRegister q Site) :=
  DensityOperator.convexCombination Finset.univ
    (kt19MeasuredWordProbability (q := q) inputs)
    (kt19WordInputDensity (q := q) (Site := Site))
    (fun error _ => kt19MeasuredWordProbability_nonneg inputs error)
    (kt19MeasuredWordProbability_sum_eq_one inputs)

private theorem kt19MeasuredWordProbability_noisySingleSiteResources
    (mu : ZMod q → ℝ) (hmu_nonneg : ∀ a : ZMod q, 0 ≤ mu a)
    (hmu_sum : ∑ a : ZMod q, mu a = 1)
    (error : PrimeQuditRegisterLabel q Site) :
    kt19MeasuredWordProbability (q := q)
        (kt19NoisySingleSiteResources (Site := Site) mu hmu_nonneg hmu_sum) error =
      wordProbability q mu error := by
  unfold kt19MeasuredWordProbability kt19NoisySingleSiteResources wordProbability
  apply Finset.prod_congr rfl
  intro site _
  rw [kt19SingleSiteInstrument_bornWeight_resource,
    kt19SingleSite_wordProbability]

/-- Preparing the actual independent noisy one-site resources reconstructs
exactly the IID magic-register density used by the syndrome analysis. -/
theorem kt19PrepareInput_noisySingleSiteResources
    (mu : ZMod q → ℝ) (hmu_nonneg : ∀ a : ZMod q, 0 ≤ mu a)
    (hmu_sum : ∑ a : ZMod q, mu a = 1) :
    kt19PrepareInput (Site := Site)
        (kt19NoisySingleSiteResources (Site := Site) mu hmu_nonneg hmu_sum) =
      kt19IIDResource (Site := Site) mu hmu_nonneg hmu_sum := by
  apply DensityOperator.ext_toOperator
  unfold kt19PrepareInput kt19IIDResource magicRegisterResource
  rw [DensityOperator.convexCombination_toOperator,
    DensityOperator.convexCombination_toOperator]
  unfold DensityOperator.convexCombinationOperator
  apply Finset.sum_congr rfl
  intro error _
  rw [kt19MeasuredWordProbability_noisySingleSiteResources]
  rfl

/-- The raw branch operator of the fine physical instrument on one normalized
IID word component is the rank-one operator of its derived Kraus vector.
The branch is zero precisely in the X-syndrome sectors ruled out by the
actual corrected-state calculation. -/
theorem kt19ProtocolInstrument_branchOperator_wordInputDensity
    (R : CubicRowFamily q Logical Stabilizer Site)
    (mu : ZSyndrome R) (sigma : Stabilizer → ZMod q)
    (error : PrimeQuditRegisterLabel q Site) :
    (kt19ProtocolInstrument R).branchOperator (mu, sigma)
        (kt19WordInputDensity (Site := Site) error).toOperator =
      if xSyndrome R error = sigma then
        (InnerProductSpace.rankOne Complex
          (phase q (registerPairing q error (zSyndromeRepresentative R mu)) •
            physicalU13 q (zSyndromeProjector R 0 (characterKet q error)))
          (phase q (registerPairing q error (zSyndromeRepresentative R mu)) •
            physicalU13 q (zSyndromeProjector R 0 (characterKet q error)))).toLinearMap
      else 0 := by
  classical
  rw [FiniteInstrument.branchOperator_apply]
  simp only [kt19ProtocolInstrument, id_eq]
  rw [Finset.sum_eq_single (mu, sigma)]
  · simp only [if_pos, kt19WordInputDensity, DensityOperator.pureDensity_toOperator]
    rw [kt19SandwichRankOne,
      kt19ProtocolKrausFamily_apply_magicRegisterKet]
    by_cases hsyndrome : xSyndrome R error = sigma <;> simp [hsyndrome]
  · intro branch _ hbranch
    simp [hbranch]
  · simp

/-- A fine physical branch has zero raw operator on a literal IID word when
its measured X sector differs from that word's derived stabilizer syndrome. -/
theorem kt19ProtocolInstrument_branchOperator_wordInputDensity_eq_zero_of_xSyndrome_ne
    (R : CubicRowFamily q Logical Stabilizer Site)
    (mu : ZSyndrome R) (sigma : Stabilizer → ZMod q)
    (error : PrimeQuditRegisterLabel q Site)
    (hsyndrome : xSyndrome R error ≠ sigma) :
    (kt19ProtocolInstrument R).branchOperator (mu, sigma)
    (kt19WordInputDensity (Site := Site) error).toOperator = 0 := by
  rw [kt19ProtocolInstrument_branchOperator_wordInputDensity, if_neg hsyndrome]

/-- A word with nontrivial derived X syndrome contributes no raw accepted
operator after the concrete binary coarsening: every accepted fine branch has
the measured trivial syndrome and is therefore a mismatch branch. -/
theorem kt19DistillationInstrument_accepted_branchOperator_wordInputDensity_eq_zero_of_xSyndrome_ne_zero
    (R : CubicRowFamily q Logical Stabilizer Site)
    (error : PrimeQuditRegisterLabel q Site)
    (hsyndrome : xSyndrome R error ≠ 0) :
    (kt19DistillationInstrument R).branchOperator .accepted
        (kt19WordInputDensity (Site := Site) error).toOperator = 0 := by
  classical
  rw [kt19DistillationInstrument,
    FiniteInstrument.binaryCoarsen_branchOperator_accepted]
  apply Finset.sum_eq_zero
  rintro ⟨mu, sigma⟩ hmember
  have hsigma : sigma = 0 := by
    simpa [kt19Accepts] using (Finset.mem_filter.mp hmember).2
  apply kt19ProtocolInstrument_branchOperator_wordInputDensity_eq_zero_of_xSyndrome_ne
  intro hmatch
  exact hsyndrome (hmatch.trans hsigma)

/-- A word with trivial derived X syndrome contributes no raw rejected
operator after binary coarsening: every rejected fine branch has a nontrivial
measured syndrome and is therefore a mismatch branch. -/
theorem kt19DistillationInstrument_rejected_branchOperator_wordInputDensity_eq_zero_of_xSyndrome_eq_zero
    (R : CubicRowFamily q Logical Stabilizer Site)
    (error : PrimeQuditRegisterLabel q Site)
    (hsyndrome : xSyndrome R error = 0) :
    (kt19DistillationInstrument R).branchOperator .rejected
        (kt19WordInputDensity (Site := Site) error).toOperator = 0 := by
  classical
  rw [kt19DistillationInstrument,
    FiniteInstrument.binaryCoarsen_branchOperator_rejected]
  apply Finset.sum_eq_zero
  rintro ⟨mu, sigma⟩ hmember
  have hsigma : sigma ≠ 0 := by
    simpa [kt19Accepts, Bool.not_eq_true] using (Finset.mem_filter.mp hmember).2
  apply kt19ProtocolInstrument_branchOperator_wordInputDensity_eq_zero_of_xSyndrome_ne
  intro hmatch
  apply hsigma
  exact hmatch.symm.trans hsyndrome

/-- The accepted Born mass of the actual instrument on one literal IID-word
component.  This is derived from the physical Kraus family, not supplied as
an acceptance predicate. -/
noncomputable def kt19WordSuccessMass
    (R : CubicRowFamily q Logical Stabilizer Site)
    (error : PrimeQuditRegisterLabel q Site) : ℝ :=
  (kt19DistillationInstrument R).bornWeight .accepted
    (kt19WordInputDensity (Site := Site) error)

/-- On each literal IID word, the actual accepted Born mass is exactly the
indicator of the derived trivial X-syndrome condition.  This is obtained from
the two physical binary-support calculations and completeness, rather than
from a separately supplied acceptance predicate. -/
theorem kt19WordSuccessMass_eq_ite_acceptedWord
    (R : CubicRowFamily q Logical Stabilizer Site)
    (error : PrimeQuditRegisterLabel q Site) :
    kt19WordSuccessMass R error =
      if kt19AcceptedWord R error then 1 else 0 := by
  classical
  unfold kt19AcceptedWord
  by_cases hsyndrome : xSyndrome R error = 0
  · rw [if_pos hsyndrome]
    have hrejectOperator :=
      kt19DistillationInstrument_rejected_branchOperator_wordInputDensity_eq_zero_of_xSyndrome_eq_zero
        R error hsyndrome
    have hreject :
        (kt19DistillationInstrument R).bornWeight .rejected
          (kt19WordInputDensity (Site := Site) error) = 0 := by
      unfold FiniteInstrument.bornWeight
      rw [hrejectOperator]
      simp
    have hsum := (kt19DistillationInstrument R).sum_bornWeight_eq_one
      (kt19DistillationInstrument_complete R)
      (kt19WordInputDensity (Site := Site) error)
    rw [show (Finset.univ : Finset DistillationOutcome) =
        {.accepted, .rejected} by decide] at hsum
    simpa [kt19WordSuccessMass, hreject] using hsum
  · rw [if_neg hsyndrome]
    unfold kt19WordSuccessMass FiniteInstrument.bornWeight
    rw [kt19DistillationInstrument_accepted_branchOperator_wordInputDensity_eq_zero_of_xSyndrome_ne_zero
      R error hsyndrome]
    simp

/-- The literal zero error word has the trivial derived X syndrome. -/
private theorem kt19ZeroWord_xSyndrome
    (R : CubicRowFamily q Logical Stabilizer Site) :
    xSyndrome R (0 : PrimeQuditRegisterLabel q Site) = 0 := by
  funext index
  simp [xSyndrome, wordPairing_apply, dotProduct]

/-- The accepted Born mass of the zero word is one, as derived from the
physical complete binary instrument. -/
private theorem kt19ZeroWord_success_mass
    (R : CubicRowFamily q Logical Stabilizer Site) :
    kt19WordSuccessMass R 0 = 1 := by
  rw [kt19WordSuccessMass_eq_ite_acceptedWord]
  simp [kt19AcceptedWord, kt19ZeroWord_xSyndrome]

/-- The actual binary accepted branch on the literal zero word is the finite
sum of its physical zero-syndrome fine branches.  No abstract acceptance
predicate or stored output state occurs in this calculation. -/
private theorem kt19ZeroWord_accepted_branchOperator_eq_sum
    (R : CubicRowFamily q Logical Stabilizer Site) :
    (kt19DistillationInstrument R).branchOperator .accepted
        (kt19WordInputDensity (Site := Site) 0).toOperator =
      ∑ syndrome : ZSyndrome R,
        (InnerProductSpace.rankOne Complex
          (physicalU13 q (zSyndromeProjector R 0 (characterKet q 0)))
          (physicalU13 q (zSyndromeProjector R 0 (characterKet q 0)))).toLinearMap := by
  classical
  rw [kt19DistillationInstrument,
    FiniteInstrument.binaryCoarsen_branchOperator_accepted,
    Finset.sum_filter, Fintype.sum_prod_type]
  apply Finset.sum_congr rfl
  intro syndrome _
  rw [Finset.sum_eq_single (0 : Stabilizer → ZMod q)]
  · rw [kt19ProtocolInstrument_branchOperator_wordInputDensity R syndrome 0 0]
    simp [kt19Accepts, kt19ZeroWord_xSyndrome, registerPairing]
  · intro other _ hother
    simp [kt19Accepts, hother]
  · simp

/-- A rank-one operator scales by the squared complex scalar on a common ray. -/
private theorem kt19RankOne_smul_self
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace Complex H]
    (scalar : Complex) (psi : H) :
    (InnerProductSpace.rankOne Complex (scalar • psi) (scalar • psi)).toLinearMap =
      (star scalar * scalar) •
        (InnerProductSpace.rankOne Complex psi psi).toLinearMap := by
  ext x
  simp [InnerProductSpace.rankOne_apply]
  rw [smul_smul, mul_comm scalar]

/-- On every physically accepted word, the binary accepted branch is the
finite sum of rank-one operators on its common corrected zero-Z-syndrome
ray.  The syndrome-dependent global phases cancel inside each rank-one
operator. -/
private theorem kt19AcceptedWord_accepted_branchOperator_eq_sum
    (R : CubicRowFamily q Logical Stabilizer Site)
    (error : PrimeQuditRegisterLabel q Site)
    (haccepted : kt19AcceptedWord R error) :
    (kt19DistillationInstrument R).branchOperator .accepted
        (kt19WordInputDensity (Site := Site) error).toOperator =
      ∑ _syndrome : ZSyndrome R,
        (InnerProductSpace.rankOne Complex
          (physicalU13 q (zSyndromeProjector R 0 (characterKet q error)))
          (physicalU13 q (zSyndromeProjector R 0 (characterKet q error)))).toLinearMap := by
  classical
  rw [kt19DistillationInstrument,
    FiniteInstrument.binaryCoarsen_branchOperator_accepted,
    Finset.sum_filter, Fintype.sum_prod_type]
  apply Finset.sum_congr rfl
  intro syndrome _
  rw [Finset.sum_eq_single (0 : Stabilizer → ZMod q)]
  · rw [kt19ProtocolInstrument_branchOperator_wordInputDensity R syndrome 0 error]
    have hsyndrome : xSyndrome R error = 0 := haccepted
    rw [if_pos hsyndrome]
    simp only [kt19Accepts, decide_true, if_true]
    rw [kt19RankOne_smul_self]
    have hphase :
        star (phase q (registerPairing q error
          (zSyndromeRepresentative R syndrome))) *
            phase q (registerPairing q error
              (zSyndromeRepresentative R syndrome)) = 1 := by
      rw [mul_comm]
      exact phase_mul_conj q _
    rw [hphase, one_smul]
  · intro other _ hother
    simp [kt19Accepts, hother]
  · simp

/-- The fixed normalized physical state used solely to totalize a
zero-probability interface branch.  It is never used as a claimed physical
conditional output. -/
noncomputable def kt19EndpointFallback :
    DensityOperator (PrimeQuditRegister q Site) :=
  DensityOperator.pureDensity (magicRegisterKet q 0) (by
    rw [InnerProductSpace.norm_sq_eq_re_inner (𝕜 := Complex),
      magicRegisterKet_inner_self]
    norm_num)

/-- The raw unnormalized accepted or rejected branch of the actual finite
distillation instrument on the direct IID register resource. -/
noncomputable def kt19RawEndpoint
    (R : CubicRowFamily q Logical Stabilizer Site)
    (mu : ZMod q → ℝ) (hmu_nonneg : ∀ a : ZMod q, 0 ≤ mu a)
    (hmu_sum : ∑ a : ZMod q, mu a = 1)
    (outcome : DistillationOutcome) : Operator (PrimeQuditRegister q Site) :=
  (kt19DistillationInstrument R).branchOperator outcome
    (kt19IIDResource (Site := Site) mu hmu_nonneg hmu_sum).toOperator

/-- The exact Born mass of one raw KT19 endpoint. -/
noncomputable def kt19EndpointWeight
    (R : CubicRowFamily q Logical Stabilizer Site)
    (mu : ZMod q → ℝ) (hmu_nonneg : ∀ a : ZMod q, 0 ≤ mu a)
    (hmu_sum : ∑ a : ZMod q, mu a = 1)
    (outcome : DistillationOutcome) : ℝ :=
  (kt19DistillationInstrument R).bornWeight outcome
    (kt19IIDResource (Site := Site) mu hmu_nonneg hmu_sum)

theorem kt19EndpointWeight_nonneg
    (R : CubicRowFamily q Logical Stabilizer Site)
    (mu : ZMod q → ℝ) (hmu_nonneg : ∀ a : ZMod q, 0 ≤ mu a)
    (hmu_sum : ∑ a : ZMod q, mu a = 1)
    (outcome : DistillationOutcome) :
    0 ≤ kt19EndpointWeight R mu hmu_nonneg hmu_sum outcome :=
  (kt19DistillationInstrument R).bornWeight_nonneg outcome
    (kt19IIDResource (Site := Site) mu hmu_nonneg hmu_sum)

/-- Normalize a KT19 endpoint only after its actual Born mass is positive. -/
noncomputable def kt19EndpointConditional
    (R : CubicRowFamily q Logical Stabilizer Site)
    (mu : ZMod q → ℝ) (hmu_nonneg : ∀ a : ZMod q, 0 ≤ mu a)
    (hmu_sum : ∑ a : ZMod q, mu a = 1)
    (outcome : DistillationOutcome)
    (hpos : 0 < kt19EndpointWeight R mu hmu_nonneg hmu_sum outcome) :
    DensityOperator (PrimeQuditRegister q Site) :=
  (kt19DistillationInstrument R).conditionalDensity outcome
    (kt19IIDResource (Site := Site) mu hmu_nonneg hmu_sum) hpos

/-- A total endpoint interface: the actual conditional at positive mass and
the explicit fallback only at a proved zero-mass endpoint. -/
noncomputable def kt19EndpointCompletion
    (R : CubicRowFamily q Logical Stabilizer Site)
    (mu : ZMod q → ℝ) (hmu_nonneg : ∀ a : ZMod q, 0 ≤ mu a)
    (hmu_sum : ∑ a : ZMod q, mu a = 1)
    (outcome : DistillationOutcome) : DensityOperator (PrimeQuditRegister q Site) :=
  FiniteInstrument.binaryCoarsenCompletion (kt19ProtocolInstrument R) (kt19Accepts R)
    (kt19IIDResource (Site := Site) mu hmu_nonneg hmu_sum)
    (kt19EndpointFallback (Site := Site)) outcome

/-- At a positive observed endpoint mass, the totalized endpoint interface is
definitionally the actual conditional branch rather than its zero-mass
fallback. -/
theorem kt19EndpointCompletion_eq_conditional_of_pos
    (R : CubicRowFamily q Logical Stabilizer Site)
    (mu : ZMod q → ℝ) (hmu_nonneg : ∀ a : ZMod q, 0 ≤ mu a)
    (hmu_sum : ∑ a : ZMod q, mu a = 1)
    (outcome : DistillationOutcome)
    (hpos : 0 < kt19EndpointWeight R mu hmu_nonneg hmu_sum outcome) :
    kt19EndpointCompletion R mu hmu_nonneg hmu_sum outcome =
      kt19EndpointConditional R mu hmu_nonneg hmu_sum outcome hpos := by
  have hpos' :
      0 < ((kt19ProtocolInstrument R).binaryCoarsen (kt19Accepts R)).bornWeight outcome
        (kt19IIDResource (Site := Site) mu hmu_nonneg hmu_sum) := by
    simpa [kt19EndpointWeight, kt19DistillationInstrument] using hpos
  rw [kt19EndpointCompletion, FiniteInstrument.binaryCoarsenCompletion, dif_pos hpos']
  rfl

/-- A zero observed endpoint mass leaves no hidden physical branch. -/
theorem kt19RawEndpoint_eq_zero_of_weight_eq_zero
    (R : CubicRowFamily q Logical Stabilizer Site)
    (mu : ZMod q → ℝ) (hmu_nonneg : ∀ a : ZMod q, 0 ≤ mu a)
    (hmu_sum : ∑ a : ZMod q, mu a = 1)
    (outcome : DistillationOutcome)
    (hzero : kt19EndpointWeight R mu hmu_nonneg hmu_sum outcome = 0) :
    kt19RawEndpoint R mu hmu_nonneg hmu_sum outcome = 0 := by
  simpa [kt19RawEndpoint, kt19EndpointWeight] using
    (kt19DistillationInstrument R).branchOperator_eq_zero_of_bornWeight_eq_zero
      outcome (kt19IIDResource (Site := Site) mu hmu_nonneg hmu_sum) hzero

/-- The totalized endpoint remains tied to the actual raw branch by its
observed Born mass, including at a zero-mass outcome. -/
theorem kt19EndpointWeight_smul_completion_toOperator
    (R : CubicRowFamily q Logical Stabilizer Site)
    (mu : ZMod q → ℝ) (hmu_nonneg : ∀ a : ZMod q, 0 ≤ mu a)
    (hmu_sum : ∑ a : ZMod q, mu a = 1)
    (outcome : DistillationOutcome) :
    (kt19EndpointWeight R mu hmu_nonneg hmu_sum outcome : Complex) •
        (kt19EndpointCompletion R mu hmu_nonneg hmu_sum outcome).toOperator =
      kt19RawEndpoint R mu hmu_nonneg hmu_sum outcome := by
  simpa [kt19EndpointWeight, kt19EndpointCompletion, kt19RawEndpoint,
    kt19DistillationInstrument] using
    (FiniteInstrument.binaryCoarsen_bornWeight_smul_completion_toOperator
      (kt19ProtocolInstrument R) (kt19Accepts R)
      (kt19IIDResource (Site := Site) mu hmu_nonneg hmu_sum)
      (kt19EndpointFallback (Site := Site)) outcome)

/-- Accepted and rejected endpoint weights partition the actual input mass. -/
theorem kt19EndpointWeight_sum
    (R : CubicRowFamily q Logical Stabilizer Site)
    (mu : ZMod q → ℝ) (hmu_nonneg : ∀ a : ZMod q, 0 ≤ mu a)
    (hmu_sum : ∑ a : ZMod q, mu a = 1) :
    kt19EndpointWeight R mu hmu_nonneg hmu_sum .accepted +
      kt19EndpointWeight R mu hmu_nonneg hmu_sum .rejected = 1 := by
  have hsum := (kt19DistillationInstrument R).sum_bornWeight_eq_one
    (kt19DistillationInstrument_complete R)
    (kt19IIDResource (Site := Site) mu hmu_nonneg hmu_sum)
  rw [show (Finset.univ : Finset DistillationOutcome) =
      {.accepted, .rejected} by decide] at hsum
  simpa [kt19EndpointWeight] using hsum

/-- The physical one-level run before decoding.  It consumes one independent
single-qudit resource per physical site, prepares their measured product
register by `kt19PrepareInput`, and then applies the actual binary coarsening
of the complete Z/correction/X instrument. -/
noncomputable def kt19SyndromeRun
    (R : CubicRowFamily q Logical Stabilizer Site)
    (mu : ZMod q → ℝ) (hmu_nonneg : ∀ a : ZMod q, 0 ≤ mu a)
    (hmu_sum : ∑ a : ZMod q, mu a = 1) :
    DistillationRun (KT19SingleQudit.{u} q)
      (PrimeQuditRegister q Site) (PrimeQuditRegister q Site) :=
  FiniteInstrument.binaryDistillationRun (kt19ProtocolInstrument R) (kt19Accepts R)
    (kt19ProtocolInstrument_complete R) (Fintype.card Site)
    (kt19NoisySingleSiteResources (Site := Site) mu hmu_nonneg hmu_sum)
    (kt19PrepareInput (q := q) (Site := Site))
    (kt19EndpointFallback (Site := Site))

/-- The actual one-level KT19 run after the complete trace-preserving decoder. -/
noncomputable def kt19Run
    (R : CubicRowFamily q Logical Stabilizer Site)
    (mu : ZMod q → ℝ) (hmu_nonneg : ∀ a : ZMod q, 0 ≤ mu a)
    (hmu_sum : ∑ a : ZMod q, mu a = 1) :
    DistillationRun (KT19SingleQudit.{u} q)
      (PrimeQuditRegister q Site) (PrimeQuditRegister q Logical) :=
  (kt19SyndromeRun R mu hmu_nonneg hmu_sum).postprocess (kt19DecoderChannel R)

/-- The physical run consumes exactly one single-qudit input resource per
physical site. -/
@[simp] theorem kt19Run_resourceCount
    (R : CubicRowFamily q Logical Stabilizer Site)
    (mu : ZMod q → ℝ) (hmu_nonneg : ∀ a : ZMod q, 0 ≤ mu a)
    (hmu_sum : ∑ a : ZMod q, mu a = 1) :
    (kt19Run R mu hmu_nonneg hmu_sum).resourceCount = Fintype.card Site :=
  rfl

/-- The corrected run exposes exactly the accepted Born mass computed from
the prepared IID register. -/
@[simp] theorem kt19Run_successProbability
    (R : CubicRowFamily q Logical Stabilizer Site)
    (mu : ZMod q → ℝ) (hmu_nonneg : ∀ a : ZMod q, 0 ≤ mu a)
    (hmu_sum : ∑ a : ZMod q, mu a = 1) :
    (kt19Run R mu hmu_nonneg hmu_sum).successProbability =
      kt19EndpointWeight R mu hmu_nonneg hmu_sum .accepted := by
  change (kt19DistillationInstrument R).bornWeight .accepted
      (kt19PrepareInput (Site := Site)
        (kt19NoisySingleSiteResources (Site := Site) mu hmu_nonneg hmu_sum)) = _
  rw [kt19PrepareInput_noisySingleSiteResources]
  rfl

/-- The physical run's accepted output is precisely the guarded actual
accepted endpoint, rather than a caller-provided conditional state. -/
@[simp] theorem kt19SyndromeRun_acceptedOutput
    (R : CubicRowFamily q Logical Stabilizer Site)
    (mu : ZMod q → ℝ) (hmu_nonneg : ∀ a : ZMod q, 0 ≤ mu a)
    (hmu_sum : ∑ a : ZMod q, mu a = 1) :
    (kt19SyndromeRun R mu hmu_nonneg hmu_sum).acceptedOutput =
      kt19EndpointCompletion R mu hmu_nonneg hmu_sum .accepted :=
  by
    unfold kt19SyndromeRun
    change FiniteInstrument.binaryCoarsenCompletion
      (kt19ProtocolInstrument R) (kt19Accepts R)
      (kt19PrepareInput (Site := Site)
        (kt19NoisySingleSiteResources (Site := Site) mu hmu_nonneg hmu_sum))
      (kt19EndpointFallback (Site := Site)) .accepted = _
    rw [kt19PrepareInput_noisySingleSiteResources]
    rfl

/-- The physical run's rejected output is precisely the guarded actual
rejected endpoint, rather than a caller-provided conditional state. -/
@[simp] theorem kt19SyndromeRun_rejectedOutput
    (R : CubicRowFamily q Logical Stabilizer Site)
    (mu : ZMod q → ℝ) (hmu_nonneg : ∀ a : ZMod q, 0 ≤ mu a)
    (hmu_sum : ∑ a : ZMod q, mu a = 1) :
    (kt19SyndromeRun R mu hmu_nonneg hmu_sum).rejectedOutput =
      kt19EndpointCompletion R mu hmu_nonneg hmu_sum .rejected :=
  by
    unfold kt19SyndromeRun
    change FiniteInstrument.binaryCoarsenCompletion
      (kt19ProtocolInstrument R) (kt19Accepts R)
      (kt19PrepareInput (Site := Site)
        (kt19NoisySingleSiteResources (Site := Site) mu hmu_nonneg hmu_sum))
      (kt19EndpointFallback (Site := Site)) .rejected = _
    rw [kt19PrepareInput_noisySingleSiteResources]
    rfl

/-- The decoded accepted endpoint is the decoder channel applied to the
physical accepted completion. -/
@[simp] theorem kt19Run_acceptedOutput
    (R : CubicRowFamily q Logical Stabilizer Site)
    (mu : ZMod q → ℝ) (hmu_nonneg : ∀ a : ZMod q, 0 ≤ mu a)
    (hmu_sum : ∑ a : ZMod q, mu a = 1) :
    (kt19Run R mu hmu_nonneg hmu_sum).acceptedOutput =
      (kt19DecoderChannel R).mapDensity
        (kt19EndpointCompletion R mu hmu_nonneg hmu_sum .accepted) :=
  by
    change (kt19DecoderChannel R).mapDensity
      (kt19SyndromeRun R mu hmu_nonneg hmu_sum).acceptedOutput = _
    rw [kt19SyndromeRun_acceptedOutput]

/-- The decoded rejected endpoint is the decoder channel applied to the
physical rejected completion. -/
@[simp] theorem kt19Run_rejectedOutput
    (R : CubicRowFamily q Logical Stabilizer Site)
    (mu : ZMod q → ℝ) (hmu_nonneg : ∀ a : ZMod q, 0 ≤ mu a)
    (hmu_sum : ∑ a : ZMod q, mu a = 1) :
    (kt19Run R mu hmu_nonneg hmu_sum).rejectedOutput =
      (kt19DecoderChannel R).mapDensity
        (kt19EndpointCompletion R mu hmu_nonneg hmu_sum .rejected) :=
  by
    change (kt19DecoderChannel R).mapDensity
      (kt19SyndromeRun R mu hmu_nonneg hmu_sum).rejectedOutput = _
    rw [kt19SyndromeRun_rejectedOutput]

/-- The finite magic-register label distribution of an arbitrary decoded
density, defined only through the complete physical magic-basis readout. -/
noncomputable def kt19OutputLabelDistribution
    (rho : DensityOperator (PrimeQuditRegister q Logical))
    (label : PrimeQuditRegisterLabel q Logical) : ℝ :=
  (magicRegisterInstrument q (Site := Logical)).bornWeight label rho

theorem kt19OutputLabelDistribution_nonneg
    (rho : DensityOperator (PrimeQuditRegister q Logical))
    (label : PrimeQuditRegisterLabel q Logical) :
    0 ≤ kt19OutputLabelDistribution rho label :=
  (magicRegisterInstrument q (Site := Logical)).bornWeight_nonneg label rho

theorem kt19OutputLabelDistribution_sum
    (rho : DensityOperator (PrimeQuditRegister q Logical)) :
    ∑ label : PrimeQuditRegisterLabel q Logical,
      kt19OutputLabelDistribution rho label = 1 :=
  (magicRegisterInstrument q (Site := Logical)).sum_bornWeight_eq_one
    (magicRegisterInstrument_complete q (Site := Logical)) rho

/-- The nonideal magic-label mass at one logical port of an arbitrary decoded
density. -/
noncomputable def kt19OutputPortError
    (rho : DensityOperator (PrimeQuditRegister q Logical))
    (port : Logical) : ℝ :=
  ∑ label : PrimeQuditRegisterLabel q Logical,
    if label port = 0 then 0 else kt19OutputLabelDistribution rho label

theorem kt19OutputPortError_nonneg
    (rho : DensityOperator (PrimeQuditRegister q Logical))
    (port : Logical) :
    0 ≤ kt19OutputPortError rho port := by
  unfold kt19OutputPortError
  apply Finset.sum_nonneg
  intro label _
  by_cases hlabel : label port = 0
  · simp [hlabel]
  · simpa [hlabel] using kt19OutputLabelDistribution_nonneg rho label

/-- Worst-port nonideal magic-label mass for a decoded density. -/
noncomputable def kt19OutputWorstPortError [Nonempty Logical]
    (rho : DensityOperator (PrimeQuditRegister q Logical)) : ℝ :=
  (Finset.univ : Finset Logical).sup' Finset.univ_nonempty
    (fun port => kt19OutputPortError rho port)

theorem kt19OutputPortError_le_worst [Nonempty Logical]
    (rho : DensityOperator (PrimeQuditRegister q Logical))
    (port : Logical) :
    kt19OutputPortError rho port ≤ kt19OutputWorstPortError rho := by
  unfold kt19OutputWorstPortError
  exact Finset.le_sup' _ (Finset.mem_univ port)

theorem kt19OutputWorstPortError_nonneg [Nonempty Logical]
    (rho : DensityOperator (PrimeQuditRegister q Logical)) :
    0 ≤ kt19OutputWorstPortError rho := by
  let port : Logical := Classical.choice (inferInstance : Nonempty Logical)
  exact (kt19OutputPortError_nonneg rho port).trans
    (kt19OutputPortError_le_worst rho port)

/-- The exact accepted-output label law is obtained by measuring the actual
decoded positive-mass accepted branch in the complete magic-register basis. -/
noncomputable def kt19AcceptedOutputDistribution
    (R : CubicRowFamily q Logical Stabilizer Site)
    (mu : ZMod q → ℝ) (hmu_nonneg : ∀ a : ZMod q, 0 ≤ mu a)
    (hmu_sum : ∑ a : ZMod q, mu a = 1)
    (hpos : 0 < kt19EndpointWeight R mu hmu_nonneg hmu_sum .accepted)
    (label : PrimeQuditRegisterLabel q Logical) : ℝ :=
  kt19OutputLabelDistribution
    ((kt19DecoderChannel R).mapDensity
      (kt19EndpointConditional R mu hmu_nonneg hmu_sum .accepted hpos)) label

/-- Every observed accepted-output label mass is nonnegative because it is a
Born weight of the actual finite magic-basis instrument. -/
theorem kt19AcceptedOutputDistribution_nonneg
    (R : CubicRowFamily q Logical Stabilizer Site)
    (mu : ZMod q → ℝ) (hmu_nonneg : ∀ a : ZMod q, 0 ≤ mu a)
    (hmu_sum : ∑ a : ZMod q, mu a = 1)
    (hpos : 0 < kt19EndpointWeight R mu hmu_nonneg hmu_sum .accepted)
    (label : PrimeQuditRegisterLabel q Logical) :
    0 ≤ kt19AcceptedOutputDistribution R mu hmu_nonneg hmu_sum hpos label :=
  (magicRegisterInstrument q (Site := Logical)).bornWeight_nonneg label
    ((kt19DecoderChannel R).mapDensity
      (kt19EndpointConditional R mu hmu_nonneg hmu_sum .accepted hpos))

/-- The accepted-output label law has total mass one. -/
theorem kt19AcceptedOutputDistribution_sum
    (R : CubicRowFamily q Logical Stabilizer Site)
    (mu : ZMod q → ℝ) (hmu_nonneg : ∀ a : ZMod q, 0 ≤ mu a)
    (hmu_sum : ∑ a : ZMod q, mu a = 1)
    (hpos : 0 < kt19EndpointWeight R mu hmu_nonneg hmu_sum .accepted) :
    ∑ label : PrimeQuditRegisterLabel q Logical,
      kt19AcceptedOutputDistribution R mu hmu_nonneg hmu_sum hpos label = 1 :=
  (magicRegisterInstrument q (Site := Logical)).sum_bornWeight_eq_one
    (magicRegisterInstrument_complete q (Site := Logical))
    ((kt19DecoderChannel R).mapDensity
      (kt19EndpointConditional R mu hmu_nonneg hmu_sum .accepted hpos))

/-- The actual decoded run has exactly the positive accepted-branch label law
when its accepted mass is positive. -/
theorem kt19Run_acceptedOutputLabelDistribution_eq
    (R : CubicRowFamily q Logical Stabilizer Site)
    (mu : ZMod q → ℝ) (hmu_nonneg : ∀ a : ZMod q, 0 ≤ mu a)
    (hmu_sum : ∑ a : ZMod q, mu a = 1)
    (hpos : 0 < kt19EndpointWeight R mu hmu_nonneg hmu_sum .accepted)
    (label : PrimeQuditRegisterLabel q Logical) :
    kt19OutputLabelDistribution
      ((kt19Run R mu hmu_nonneg hmu_sum).acceptedOutput) label =
      kt19AcceptedOutputDistribution R mu hmu_nonneg hmu_sum hpos label := by
  rw [kt19Run_acceptedOutput,
    kt19EndpointCompletion_eq_conditional_of_pos R mu hmu_nonneg hmu_sum .accepted hpos]
  rfl

/-- The exact accepted conditional error probability at a decoded output
port: total magic-basis mass on its nonideal, nonzero labels. -/
noncomputable def kt19PortError
    (R : CubicRowFamily q Logical Stabilizer Site)
    (mu : ZMod q → ℝ) (hmu_nonneg : ∀ a : ZMod q, 0 ≤ mu a)
    (hmu_sum : ∑ a : ZMod q, mu a = 1)
    (hpos : 0 < kt19EndpointWeight R mu hmu_nonneg hmu_sum .accepted)
    (port : Logical) : ℝ :=
  ∑ label : PrimeQuditRegisterLabel q Logical,
    if label port = 0 then 0 else
      kt19AcceptedOutputDistribution R mu hmu_nonneg hmu_sum hpos label

/-- The accepted conditional port error is the generic operational port
error evaluated at the actual decoded positive-mass accepted density. -/
theorem kt19PortError_eq_outputPortError
    (R : CubicRowFamily q Logical Stabilizer Site)
    (mu : ZMod q → ℝ) (hmu_nonneg : ∀ a : ZMod q, 0 ≤ mu a)
    (hmu_sum : ∑ a : ZMod q, mu a = 1)
    (hpos : 0 < kt19EndpointWeight R mu hmu_nonneg hmu_sum .accepted)
    (port : Logical) :
    kt19PortError R mu hmu_nonneg hmu_sum hpos port =
      kt19OutputPortError
        ((kt19DecoderChannel R).mapDensity
          (kt19EndpointConditional R mu hmu_nonneg hmu_sum .accepted hpos)) port :=
  rfl

theorem kt19PortError_nonneg
    (R : CubicRowFamily q Logical Stabilizer Site)
    (mu : ZMod q → ℝ) (hmu_nonneg : ∀ a : ZMod q, 0 ≤ mu a)
    (hmu_sum : ∑ a : ZMod q, mu a = 1)
    (hpos : 0 < kt19EndpointWeight R mu hmu_nonneg hmu_sum .accepted)
    (port : Logical) :
    0 ≤ kt19PortError R mu hmu_nonneg hmu_sum hpos port := by
  unfold kt19PortError
  apply Finset.sum_nonneg
  intro label _
  by_cases hlabel : label port = 0
  · simp [hlabel]
  · simpa [hlabel] using
      kt19AcceptedOutputDistribution_nonneg R mu hmu_nonneg hmu_sum hpos label

/-- The protocol error is the worst actual conditional nonzero-label mass
over decoded output ports.  A nonempty logical-output type is explicit. -/
noncomputable def kt19WorstPortError [Nonempty Logical]
    (R : CubicRowFamily q Logical Stabilizer Site)
    (mu : ZMod q → ℝ) (hmu_nonneg : ∀ a : ZMod q, 0 ≤ mu a)
    (hmu_sum : ∑ a : ZMod q, mu a = 1)
    (hpos : 0 < kt19EndpointWeight R mu hmu_nonneg hmu_sum .accepted) : ℝ :=
  (Finset.univ : Finset Logical).sup' Finset.univ_nonempty
    (fun port => kt19PortError R mu hmu_nonneg hmu_sum hpos port)

theorem kt19WorstPortError_eq_outputWorstPortError [Nonempty Logical]
    (R : CubicRowFamily q Logical Stabilizer Site)
    (mu : ZMod q → ℝ) (hmu_nonneg : ∀ a : ZMod q, 0 ≤ mu a)
    (hmu_sum : ∑ a : ZMod q, mu a = 1)
    (hpos : 0 < kt19EndpointWeight R mu hmu_nonneg hmu_sum .accepted) :
    kt19WorstPortError R mu hmu_nonneg hmu_sum hpos =
      kt19OutputWorstPortError
        ((kt19DecoderChannel R).mapDensity
          (kt19EndpointConditional R mu hmu_nonneg hmu_sum .accepted hpos)) :=
  rfl

/-- The actual decoded run's accepted output has the declared KT19 worst-port
error whenever the observed accepted mass is positive. -/
theorem kt19Run_acceptedOutputWorstPortError_eq [Nonempty Logical]
    (R : CubicRowFamily q Logical Stabilizer Site)
    (mu : ZMod q → ℝ) (hmu_nonneg : ∀ a : ZMod q, 0 ≤ mu a)
    (hmu_sum : ∑ a : ZMod q, mu a = 1)
    (hpos : 0 < kt19EndpointWeight R mu hmu_nonneg hmu_sum .accepted) :
    kt19OutputWorstPortError
      ((kt19Run R mu hmu_nonneg hmu_sum).acceptedOutput) =
      kt19WorstPortError R mu hmu_nonneg hmu_sum hpos := by
  rw [kt19Run_acceptedOutput,
    kt19EndpointCompletion_eq_conditional_of_pos R mu hmu_nonneg hmu_sum .accepted hpos]
  exact (kt19WorstPortError_eq_outputWorstPortError R mu hmu_nonneg hmu_sum hpos).symm

theorem kt19PortError_le_worst [Nonempty Logical]
    (R : CubicRowFamily q Logical Stabilizer Site)
    (mu : ZMod q → ℝ) (hmu_nonneg : ∀ a : ZMod q, 0 ≤ mu a)
    (hmu_sum : ∑ a : ZMod q, mu a = 1)
    (hpos : 0 < kt19EndpointWeight R mu hmu_nonneg hmu_sum .accepted)
    (port : Logical) :
    kt19PortError R mu hmu_nonneg hmu_sum hpos port ≤
      kt19WorstPortError R mu hmu_nonneg hmu_sum hpos := by
  unfold kt19WorstPortError
  exact Finset.le_sup' _ (Finset.mem_univ port)

theorem kt19WorstPortError_nonneg [Nonempty Logical]
    (R : CubicRowFamily q Logical Stabilizer Site)
    (mu : ZMod q → ℝ) (hmu_nonneg : ∀ a : ZMod q, 0 ≤ mu a)
    (hmu_sum : ∑ a : ZMod q, mu a = 1)
    (hpos : 0 < kt19EndpointWeight R mu hmu_nonneg hmu_sum .accepted) :
    0 ≤ kt19WorstPortError R mu hmu_nonneg hmu_sum hpos := by
  let port : Logical := Classical.choice (inferInstance : Nonempty Logical)
  exact (kt19PortError_nonneg R mu hmu_nonneg hmu_sum hpos port).trans
    (kt19PortError_le_worst R mu hmu_nonneg hmu_sum hpos port)

/-- The literal nonzero-label error rate of an arbitrary approved per-site
distribution. -/
def kt19ErrorRate (mu : ZMod q → ℝ) : ℝ :=
  1 - mu 0

/-- The protocol error rate is exactly the resource's total nonzero-label
mass, so recurrence statements retain the owner-specified IID meaning of
`epsilon`. -/
theorem kt19ErrorRate_eq_nonzeroMass
    (mu : ZMod q → ℝ) (hmu_sum : ∑ a : ZMod q, mu a = 1) :
    kt19ErrorRate mu = nonzeroMass q mu := by
  simpa [kt19ErrorRate] using (nonzeroMass_eq_one_sub_mu_zero q mu hmu_sum).symm

theorem kt19Mu_zero_le_one
    (mu : ZMod q → ℝ) (hmu_nonneg : ∀ a : ZMod q, 0 ≤ mu a)
    (hmu_sum : ∑ a : ZMod q, mu a = 1) :
    mu 0 ≤ 1 := by
  have hle : mu 0 ≤ ∑ a : ZMod q, mu a :=
    Finset.single_le_sum (s := Finset.univ) (f := mu)
      (fun a _ => hmu_nonneg a) (Finset.mem_univ 0)
  simpa [hmu_sum] using hle

theorem kt19ErrorRate_nonneg
    (mu : ZMod q → ℝ) (hmu_nonneg : ∀ a : ZMod q, 0 ≤ mu a)
    (hmu_sum : ∑ a : ZMod q, mu a = 1) :
    0 ≤ kt19ErrorRate mu :=
  sub_nonneg.mpr (kt19Mu_zero_le_one mu hmu_nonneg hmu_sum)

theorem kt19ErrorRate_le_one
    (mu : ZMod q → ℝ) (hmu_nonneg : ∀ a : ZMod q, 0 ≤ mu a) :
    kt19ErrorRate mu ≤ 1 := by
  unfold kt19ErrorRate
  linarith [hmu_nonneg 0]

/-- The only permitted input family consists of one literal single-site
magic resource at every physical slot, all with the same nonzero-label rate.
The independent constructor and site-count index make the IID law explicit;
correlated or arbitrary CPTP inputs are outside this model. -/
def kt19IIDInputErrorModel
    (mu : ZMod q → ℝ) (hmu_nonneg : ∀ a : ZMod q, 0 ≤ mu a)
    (hmu_sum : ∑ a : ZMod q, mu a = 1) :
    InputErrorModel (Fintype.card Site) (KT19SingleQudit.{u} q) :=
  .independent
    { rate := fun _ => kt19ErrorRate mu
      rate_nonneg := fun _ => kt19ErrorRate_nonneg mu hmu_nonneg hmu_sum
      rate_le_one := fun _ => kt19ErrorRate_le_one mu hmu_nonneg
      admissible := fun rates inputs =>
        (∀ index, rates index = kt19ErrorRate mu) ∧
          ∀ index, inputs index = kt19SingleSiteResource mu hmu_nonneg hmu_sum }

theorem kt19IIDInputErrorModel_permits
    (mu : ZMod q → ℝ) (hmu_nonneg : ∀ a : ZMod q, 0 ≤ mu a)
    (hmu_sum : ∑ a : ZMod q, mu a = 1) :
    (kt19IIDInputErrorModel (Site := Site) mu hmu_nonneg hmu_sum).Permits
      (kt19NoisySingleSiteResources (Site := Site) mu hmu_nonneg hmu_sum) := by
  change (∀ index, kt19ErrorRate mu = kt19ErrorRate mu) ∧
    ∀ index, kt19SingleSiteResource mu hmu_nonneg hmu_sum =
      kt19SingleSiteResource mu hmu_nonneg hmu_sum
  exact ⟨fun _ => rfl, fun _ => rfl⟩

/-- The ideal decoded output is the all-zero-label magic-register state on
the actual logical output register. -/
noncomputable def kt19IdealOutput :
    DensityOperator (PrimeQuditRegister q Logical) :=
  DensityOperator.pureDensity (magicRegisterKet q 0) (by
    rw [InnerProductSpace.norm_sq_eq_re_inner (𝕜 := Complex),
      magicRegisterKet_inner_self]
    norm_num)

/-- Decoding the actual accepted branch of the literal zero error word gives
the ideal logical magic-register density.  The ray calculation is supplied by
the concrete zero-sector/encoder bridge above; its coefficient is fixed to
one here by the actual accepted Born mass and trace preservation of the
finite decoder channel. -/
private theorem kt19ZeroWord_decodedAccepted_eq_ideal
    (R : CubicRowFamily q Logical Stabilizer Site) :
    kt19DecoderChannel R
      ((kt19DistillationInstrument R).branchOperator .accepted
        (kt19WordInputDensity (Site := Site) 0).toOperator) =
      (kt19IdealOutput (q := q) (Logical := Logical)).toOperator := by
  classical
  let raw : Operator (PrimeQuditRegister q Site) :=
    (kt19DistillationInstrument R).branchOperator .accepted
      (kt19WordInputDensity (Site := Site) 0).toOperator
  obtain ⟨scale, hsector⟩ := kt19ZeroWord_sector_is_encoded R
  let coefficient : Complex := ∑ _syndrome : ZSyndrome R, star scale * scale
  have hraw : raw =
      ∑ syndrome : ZSyndrome R,
        (InnerProductSpace.rankOne Complex
          (physicalU13 q (zSyndromeProjector R 0 (characterKet q 0)))
          (physicalU13 q (zSyndromeProjector R 0 (characterKet q 0)))).toLinearMap := by
    simpa [raw] using kt19ZeroWord_accepted_branchOperator_eq_sum R
  have hdecoded : kt19DecoderChannel R raw =
      coefficient • (kt19IdealOutput (q := q) (Logical := Logical)).toOperator := by
    rw [hraw, map_sum]
    simp_rw [hsector, kt19RankOne_smul_self, map_smul,
      kt19DecoderChannel_rankOne_encoded]
    simp only [kt19IdealOutput, DensityOperator.pureDensity_toOperator]
    dsimp [coefficient]
    rw [Finset.sum_smul]
  have hraw_trace :
      LinearMap.trace Complex (PrimeQuditRegister q Site) raw = 1 := by
    change LinearMap.trace Complex (PrimeQuditRegister q Site)
      ((kt19DistillationInstrument R).branchOperator .accepted
        (kt19WordInputDensity (Site := Site) 0).toOperator) = 1
    rw [(kt19DistillationInstrument R).trace_branchOperator_eq_bornWeight
      .accepted (kt19WordInputDensity (Site := Site) 0)]
    simpa [kt19WordSuccessMass] using
      congrArg (fun value : ℝ => (value : Complex)) (kt19ZeroWord_success_mass R)
  have hdecoded_trace :
      LinearMap.trace Complex (PrimeQuditRegister q Logical)
        (kt19DecoderChannel R raw) = 1 := by
    rw [(kt19DecoderChannel R).trace_map]
    exact hraw_trace
  have hcoefficient : coefficient = 1 := by
    rw [hdecoded, map_smul, kt19IdealOutput,
      DensityOperator.pureDensity_toOperator, InnerProductSpace.trace_rankOne,
      magicRegisterKet_inner_self] at hdecoded_trace
    simpa using hdecoded_trace
  change kt19DecoderChannel R raw =
    (kt19IdealOutput (q := q) (Logical := Logical)).toOperator
  rw [hdecoded, hcoefficient, one_smul]

/-- Decoding the actual accepted branch of any accepted IID word gives the
pure logical magic-register word selected by the derived routing label.  The
ray coefficient is fixed to one by the physical word-success mass and trace
preservation, not by an assumed decoder output. -/
private theorem kt19AcceptedWord_decodedAccepted_eq_routedMagic
    (R : CubicRowFamily q Logical Stabilizer Site)
    (error : PrimeQuditRegisterLabel q Site)
    (haccepted : kt19AcceptedWord R error) :
    kt19DecoderChannel R
      ((kt19DistillationInstrument R).branchOperator .accepted
        (kt19WordInputDensity (Site := Site) error).toOperator) =
      (DensityOperator.pureDensity
        (magicRegisterKet q (kt19LogicalRouting R error)) (by
          rw [InnerProductSpace.norm_sq_eq_re_inner (𝕜 := Complex),
            magicRegisterKet_inner_self]
          norm_num)).toOperator := by
  classical
  let raw : Operator (PrimeQuditRegister q Site) :=
    (kt19DistillationInstrument R).branchOperator .accepted
      (kt19WordInputDensity (Site := Site) error).toOperator
  obtain ⟨scale, hsector⟩ :=
    kt19AcceptedWord_sector_is_routed_encoded R error haccepted
  let coefficient : Complex := ∑ _syndrome : ZSyndrome R, star scale * scale
  have hraw : raw =
      ∑ _syndrome : ZSyndrome R,
        (InnerProductSpace.rankOne Complex
          (physicalU13 q (zSyndromeProjector R 0 (characterKet q error)))
          (physicalU13 q (zSyndromeProjector R 0 (characterKet q error)))).toLinearMap := by
    simpa [raw] using
      kt19AcceptedWord_accepted_branchOperator_eq_sum R error haccepted
  have hdecoded : kt19DecoderChannel R raw =
      coefficient •
        (DensityOperator.pureDensity
          (magicRegisterKet q (kt19LogicalRouting R error)) (by
            rw [InnerProductSpace.norm_sq_eq_re_inner (𝕜 := Complex),
              magicRegisterKet_inner_self]
            norm_num)).toOperator := by
    rw [hraw, map_sum]
    simp_rw [hsector, kt19RankOne_smul_self, map_smul,
      kt19DecoderChannel_rankOne_encoded]
    simp only [DensityOperator.pureDensity_toOperator]
    dsimp [coefficient]
    rw [Finset.sum_smul]
  have hraw_trace :
      LinearMap.trace Complex (PrimeQuditRegister q Site) raw = 1 := by
    change LinearMap.trace Complex (PrimeQuditRegister q Site)
      ((kt19DistillationInstrument R).branchOperator .accepted
        (kt19WordInputDensity (Site := Site) error).toOperator) = 1
    rw [(kt19DistillationInstrument R).trace_branchOperator_eq_bornWeight
      .accepted (kt19WordInputDensity (Site := Site) error)]
    have hmass : kt19WordSuccessMass R error = 1 := by
      rw [kt19WordSuccessMass_eq_ite_acceptedWord, if_pos haccepted]
    simpa [kt19WordSuccessMass] using
      congrArg (fun value : Real => (value : Complex)) hmass
  have hdecoded_trace :
      LinearMap.trace Complex (PrimeQuditRegister q Logical)
        (kt19DecoderChannel R raw) = 1 := by
    rw [(kt19DecoderChannel R).trace_map]
    exact hraw_trace
  have hcoefficient : coefficient = 1 := by
    rw [hdecoded, map_smul, DensityOperator.pureDensity_toOperator,
      InnerProductSpace.trace_rankOne, magicRegisterKet_inner_self] at hdecoded_trace
    simpa using hdecoded_trace
  change kt19DecoderChannel R raw = _
  rw [hdecoded, hcoefficient, one_smul]

/-- The source-approved KT19 package: an actual one-level run, exactly the
IID diagonal input model it consumes, postselected behavior, ideal output,
and worst-port magic-label error functional. -/
noncomputable def kt19MagicStateDistillationProtocol [Nonempty Logical]
    (R : CubicRowFamily q Logical Stabilizer Site)
    (mu : ZMod q → ℝ) (hmu_nonneg : ∀ a : ZMod q, 0 ≤ mu a)
    (hmu_sum : ∑ a : ZMod q, mu a = 1) :
    MagicStateDistillationProtocol
      (KT19SingleQudit.{u} q)
      (PrimeQuditRegister q Site)
      (PrimeQuditRegister q Logical) where
  run := kt19Run R mu hmu_nonneg hmu_sum
  inputErrorModel := kt19IIDInputErrorModel (Site := Site) mu hmu_nonneg hmu_sum
  inputPermitted := by
    change (kt19IIDInputErrorModel (Site := Site) mu hmu_nonneg hmu_sum).Permits
      (kt19NoisySingleSiteResources (Site := Site) mu hmu_nonneg hmu_sum)
    exact kt19IIDInputErrorModel_permits (Site := Site) mu hmu_nonneg hmu_sum
  behavior := .postselected
  idealOutput := kt19IdealOutput (q := q) (Logical := Logical)
  outputError := fun rho _ => kt19OutputWorstPortError rho
  outputError_nonneg := fun rho _ => kt19OutputWorstPortError_nonneg rho

/-- The shared #458 accounting family for one concrete KT19 block.  Its
singleton index does not hide the changing-prime construction: the resource,
input, and output Hilbert spaces are those of this actual member, while the
run itself now records every single-site input slot. -/
noncomputable def kt19OverheadFamily [Nonempty Logical]
    (R : CubicRowFamily q Logical Stabilizer Site)
    (mu : ZMod q → ℝ) (hmu_nonneg : ∀ a : ZMod q, 0 ≤ mu a)
    (hmu_sum : ∑ a : ZMod q, mu a = 1) :
    DistillationProtocolFamily (KT19SingleQudit.{u} q)
      (PrimeQuditRegister q Site) (PrimeQuditRegister q Logical) PUnit where
  targetError := fun _ =>
    kt19OutputWorstPortError
      (kt19Run R mu hmu_nonneg hmu_sum).acceptedOutput
  protocol := fun _ =>
    kt19MagicStateDistillationProtocol R mu hmu_nonneg hmu_sum
  outputResourceCount := fun _ => Fintype.card Logical
  outputResourceCount_pos := fun _ => Fintype.card_pos
  successfulOutputError_le_targetError := fun _ => le_rfl

/-- The success probability is the actual accepted Born mass, never an
input field or assumed scalar. -/
noncomputable def kt19Success
    (R : CubicRowFamily q Logical Stabilizer Site)
    (mu : ZMod q → ℝ) (hmu_nonneg : ∀ a : ZMod q, 0 ≤ mu a)
    (hmu_sum : ∑ a : ZMod q, mu a = 1) : ℝ :=
  kt19EndpointWeight R mu hmu_nonneg hmu_sum .accepted

theorem kt19Success_nonneg
    (R : CubicRowFamily q Logical Stabilizer Site)
    (mu : ZMod q → ℝ) (hmu_nonneg : ∀ a : ZMod q, 0 ≤ mu a)
    (hmu_sum : ∑ a : ZMod q, mu a = 1) :
    0 ≤ kt19Success R mu hmu_nonneg hmu_sum :=
  kt19EndpointWeight_nonneg R mu hmu_nonneg hmu_sum .accepted

/-- The one-block input cost per accepted logical output is the shared #458
successful-output cost of the actual single-site-resource run. -/
noncomputable def kt19SuccessfulOutputCost [Nonempty Logical]
    (R : CubicRowFamily q Logical Stabilizer Site)
    (mu : ZMod q → ℝ) (hmu_nonneg : ∀ a : ZMod q, 0 ≤ mu a)
    (hmu_sum : ∑ a : ZMod q, mu a = 1) : ℝ :=
  (kt19OverheadFamily R mu hmu_nonneg hmu_sum).successfulOutputCost PUnit.unit

/-- Expanding the shared accounting definition exposes the physical site
count, logical port count, and actual accepted Born mass. -/
theorem kt19SuccessfulOutputCost_eq_shared_formula [Nonempty Logical]
    (R : CubicRowFamily q Logical Stabilizer Site)
    (mu : ZMod q → ℝ) (hmu_nonneg : ∀ a : ZMod q, 0 ≤ mu a)
    (hmu_sum : ∑ a : ZMod q, mu a = 1) :
    kt19SuccessfulOutputCost R mu hmu_nonneg hmu_sum =
      (Fintype.card Site : ℝ) /
        ((Fintype.card Logical : ℝ) *
          kt19Success R mu hmu_nonneg hmu_sum) := by
  unfold kt19SuccessfulOutputCost DistillationProtocolFamily.successfulOutputCost
  unfold DistillationProtocolFamily.inputResourceCount kt19OverheadFamily
  change (Fintype.card Site : ℝ) /
      ((Fintype.card Logical : ℝ) *
        (kt19Run R mu hmu_nonneg hmu_sum).successProbability) = _
  rw [kt19Run_successProbability]
  rfl

/-- The finite-site successful-output accounting expression is nonnegative,
including the degenerate zero-success case under Lean's field convention. -/
theorem kt19SuccessfulOutputCost_nonneg [Nonempty Logical]
    (R : CubicRowFamily q Logical Stabilizer Site)
    (mu : ZMod q → ℝ) (hmu_nonneg : ∀ a : ZMod q, 0 ≤ mu a)
    (hmu_sum : ∑ a : ZMod q, mu a = 1) :
    0 ≤ kt19SuccessfulOutputCost R mu hmu_nonneg hmu_sum := by
  exact DistillationProtocolFamily.successfulOutputCost_nonneg
    (kt19OverheadFamily R mu hmu_nonneg hmu_sum) PUnit.unit

/-- The exact success mass expands linearly over the constructed IID
magic-register mixture.  Each summand is the actual accepted Born mass of a
physical word component, weighted by its product probability. -/
theorem kt19Success_eq_word_sum
    (R : CubicRowFamily q Logical Stabilizer Site)
    (mu : ZMod q → ℝ) (hmu_nonneg : ∀ a : ZMod q, 0 ≤ mu a)
    (hmu_sum : ∑ a : ZMod q, mu a = 1) :
    kt19Success R mu hmu_nonneg hmu_sum =
      ∑ error : PrimeQuditRegisterLabel q Site,
        wordProbability q mu error * kt19WordSuccessMass R error := by
  unfold kt19Success kt19EndpointWeight kt19IIDResource FiniteInstrument.bornWeight
  rw [magicRegisterResource, DensityOperator.convexCombination_toOperator]
  unfold DensityOperator.convexCombinationOperator
  rw [FiniteInstrument.branchOperator_sum]
  simp_rw [FiniteInstrument.branchOperator_smul]
  rw [map_sum, Complex.re_sum]
  apply Finset.sum_congr rfl
  intro error _
  rw [map_smul]
  change ((wordProbability q mu error : Complex) •
      LinearMap.trace Complex (PrimeQuditRegister q Site)
        ((kt19DistillationInstrument R).branchOperator .accepted
          (kt19WordInputDensity (Site := Site) error).toOperator)).re =
    wordProbability q mu error * kt19WordSuccessMass R error
  rw [(kt19DistillationInstrument R).trace_branchOperator_eq_bornWeight
    .accepted (kt19WordInputDensity (Site := Site) error)]
  simp only [smul_eq_mul, Complex.mul_re, Complex.ofReal_re,
    Complex.ofReal_im, zero_mul, sub_zero]
  rfl

/-- The actual success probability is exactly the IID probability mass of
the words accepted by the derived physical X-syndrome condition. -/
theorem kt19Success_eq_acceptedWord_sum
    (R : CubicRowFamily q Logical Stabilizer Site)
    (mu : ZMod q → ℝ) (hmu_nonneg : ∀ a : ZMod q, 0 ≤ mu a)
    (hmu_sum : ∑ a : ZMod q, mu a = 1) :
    kt19Success R mu hmu_nonneg hmu_sum =
      ∑ error ∈ Finset.univ.filter (kt19AcceptedWord R),
        wordProbability q mu error := by
  rw [kt19Success_eq_word_sum]
  simp_rw [kt19WordSuccessMass_eq_ite_acceptedWord]
  rw [Finset.sum_filter]
  apply Finset.sum_congr rfl
  intro error _
  by_cases haccept : kt19AcceptedWord R error <;> simp [haccept]

/-- The all-zero IID error word is physically accepted, so its literal
product weight lower-bounds the actual success probability. -/
theorem kt19Success_ge_mu_zero_pow
    (R : CubicRowFamily q Logical Stabilizer Site)
    (mu : ZMod q → ℝ) (hmu_nonneg : ∀ a : ZMod q, 0 ≤ mu a)
    (hmu_sum : ∑ a : ZMod q, mu a = 1) :
    (mu 0) ^ Fintype.card Site ≤ kt19Success R mu hmu_nonneg hmu_sum := by
  have hzeroAccepted :
      kt19AcceptedWord R (0 : PrimeQuditRegisterLabel q Site) := by
    unfold kt19AcceptedWord xSyndrome
    funext index
    simp
  have hzeroMembership :
      (0 : PrimeQuditRegisterLabel q Site) ∈
        Finset.univ.filter (kt19AcceptedWord R) :=
    Finset.mem_filter.mpr ⟨Finset.mem_univ _, hzeroAccepted⟩
  have hzeroProbability :
      wordProbability q mu (0 : PrimeQuditRegisterLabel q Site) =
        (mu 0) ^ Fintype.card Site := by
    simp [wordProbability]
  calc
    (mu 0) ^ Fintype.card Site =
        wordProbability q mu (0 : PrimeQuditRegisterLabel q Site) :=
      hzeroProbability.symm
    _ ≤ ∑ error ∈ Finset.univ.filter (kt19AcceptedWord R),
        wordProbability q mu error :=
      Finset.single_le_sum (s := Finset.univ.filter (kt19AcceptedWord R))
        (f := wordProbability q mu)
        (fun error _ => wordProbability_nonneg q mu hmu_nonneg error)
        hzeroMembership
    _ = kt19Success R mu hmu_nonneg hmu_sum :=
      (kt19Success_eq_acceptedWord_sum R mu hmu_nonneg hmu_sum).symm

/-- Strict positive zero-label mass makes the actual KT19 postselection
success strictly positive, rather than merely nonnegative. -/
theorem kt19Success_pos_of_mu_zero_pos
    (R : CubicRowFamily q Logical Stabilizer Site)
    (mu : ZMod q → ℝ) (hmu_nonneg : ∀ a : ZMod q, 0 ≤ mu a)
    (hmu_sum : ∑ a : ZMod q, mu a = 1)
    (hmu_zero : 0 < mu 0) :
    0 < kt19Success R mu hmu_nonneg hmu_sum :=
  lt_of_lt_of_le (pow_pos hmu_zero _) (kt19Success_ge_mu_zero_pow R mu hmu_nonneg hmu_sum)

/-- Rewriting the literal zero-label mass as `1 - ε` gives the stated KT19
IID lower bound for the actual accepted Born mass. -/
theorem kt19Success_ge_one_sub_errorRate_pow
    (R : CubicRowFamily q Logical Stabilizer Site)
    (mu : ZMod q → ℝ) (hmu_nonneg : ∀ a : ZMod q, 0 ≤ mu a)
    (hmu_sum : ∑ a : ZMod q, mu a = 1) :
    (1 - kt19ErrorRate mu) ^ Fintype.card Site ≤
      kt19Success R mu hmu_nonneg hmu_sum := by
  have hzero : 1 - kt19ErrorRate mu = mu 0 := by
    unfold kt19ErrorRate
    ring
  rw [hzero]
  exact kt19Success_ge_mu_zero_pow R mu hmu_nonneg hmu_sum

/-- An IID error rate strictly below one gives positive mass to the all-zero
word, hence makes the actual postselected KT19 success probability positive. -/
theorem kt19Success_pos_of_errorRate_lt_one
    (R : CubicRowFamily q Logical Stabilizer Site)
    (mu : ZMod q → ℝ) (hmu_nonneg : ∀ a : ZMod q, 0 ≤ mu a)
    (hmu_sum : ∑ a : ZMod q, mu a = 1)
    (heps : kt19ErrorRate mu < 1) :
    0 < kt19Success R mu hmu_nonneg hmu_sum := by
  apply kt19Success_pos_of_mu_zero_pos R mu hmu_nonneg hmu_sum
  unfold kt19ErrorRate at heps
  linarith

/-- The strict IID error-rate hypothesis supplies the positive accepted
endpoint witness required by the physical conditional-output interface. -/
theorem kt19AcceptedEndpointWeight_pos_of_errorRate_lt_one
    (R : CubicRowFamily q Logical Stabilizer Site)
    (mu : ZMod q → ℝ) (hmu_nonneg : ∀ a : ZMod q, 0 ≤ mu a)
    (hmu_sum : ∑ a : ZMod q, mu a = 1)
    (heps : kt19ErrorRate mu < 1) :
    0 < kt19EndpointWeight R mu hmu_nonneg hmu_sum .accepted := by
  simpa [kt19Success] using
    (kt19Success_pos_of_errorRate_lt_one R mu hmu_nonneg hmu_sum heps)

/-- The literal finite input-per-output accounting is bounded by the IID
zero-word success lower bound whenever the input error rate is below one. -/
theorem kt19SuccessfulOutputCost_le_one_sub_errorRate_pow [Nonempty Logical]
    (R : CubicRowFamily q Logical Stabilizer Site)
    (mu : ZMod q → ℝ) (hmu_nonneg : ∀ a : ZMod q, 0 ≤ mu a)
    (hmu_sum : ∑ a : ZMod q, mu a = 1)
    (heps : kt19ErrorRate mu < 1) :
    kt19SuccessfulOutputCost R mu hmu_nonneg hmu_sum ≤
      (Fintype.card Site : ℝ) /
        ((Fintype.card Logical : ℝ) *
          (1 - kt19ErrorRate mu) ^ Fintype.card Site) := by
  have hlogical : 0 < (Fintype.card Logical : ℝ) :=
    Nat.cast_pos.mpr Fintype.card_pos
  have hpower : 0 < (1 - kt19ErrorRate mu) ^ Fintype.card Site :=
    pow_pos (sub_pos.mpr heps) _
  have hdenominator :
      (Fintype.card Logical : ℝ) *
          (1 - kt19ErrorRate mu) ^ Fintype.card Site ≤
        (Fintype.card Logical : ℝ) * kt19Success R mu hmu_nonneg hmu_sum :=
    mul_le_mul_of_nonneg_left
      (kt19Success_ge_one_sub_errorRate_pow R mu hmu_nonneg hmu_sum) hlogical.le
  rw [kt19SuccessfulOutputCost_eq_shared_formula]
  exact div_le_div_of_nonneg_left (Nat.cast_nonneg _)
    (mul_pos hlogical hpower) hdenominator

/-! ## The source-indexed changing-prime KT19 family -/

/--
The concrete data that may vary with the KT19 prime/code parameters.  This
stores only the source-side prime/admissibility witness, the displayed cubic
rows, and their proved identification with the shortened Reed--Solomon code.
All Hilbert spaces, magic resources, gates, instruments, decoder, run,
success, output error, routing, and cost below are constructed from those
data; no protocol conclusion is a field of this structure.
-/
structure KT19DistillationFamily (p l k : Nat) [NeZero p] [Fact p.Prime] where
  primeAtLeastFive : PrimeAtLeastFive p
  admissible : Admissible p l k
  rowFamily : CubicRowFamily p (Fin k) (Fin (l - k))
    (KeptPunctureLocation p k)
  stabilizerCarrier_eq_shortened :
    stabilizerCarrier rowFamily = (shortenedReedSolomonCode p l k).carrier

namespace KT19DistillationFamily

variable {p l k : Nat} [NeZero p] [Fact p.Prime]

/-- The actual p-dependent input resource of one family member. -/
noncomputable def inputResource (family : KT19DistillationFamily p l k)
    (mu : ZMod p → ℝ) (hmu_nonneg : ∀ a : ZMod p, 0 ≤ mu a)
    (hmu_sum : ∑ a : ZMod p, mu a = 1) :
    DensityOperator (KT19SingleQudit.{0} p) :=
  kt19SingleSiteResource mu hmu_nonneg hmu_sum

/-- Applying the member's finite preparation operation to all of its actual
single-site inputs gives the IID physical register entering syndrome
extraction. -/
noncomputable def preparedInput (family : KT19DistillationFamily p l k)
    (mu : ZMod p → ℝ) (hmu_nonneg : ∀ a : ZMod p, 0 ≤ mu a)
    (hmu_sum : ∑ a : ZMod p, mu a = 1) :
    DensityOperator (PrimeQuditRegister p (KeptPunctureLocation p k)) :=
  kt19PrepareInput (Site := KeptPunctureLocation p k)
    (kt19NoisySingleSiteResources (Site := KeptPunctureLocation p k)
      mu hmu_nonneg hmu_sum :
        ResourceInput (Fintype.card (KeptPunctureLocation p k))
          (KT19SingleQudit.{0} p))

theorem preparedInput_eq_iidResource (family : KT19DistillationFamily p l k)
    (mu : ZMod p → ℝ) (hmu_nonneg : ∀ a : ZMod p, 0 ≤ mu a)
    (hmu_sum : ∑ a : ZMod p, mu a = 1) :
    preparedInput family mu hmu_nonneg hmu_sum =
      kt19IIDResource (Site := KeptPunctureLocation p k)
        mu hmu_nonneg hmu_sum :=
  kt19PrepareInput_noisySingleSiteResources mu hmu_nonneg hmu_sum

/-- The literal transversal physical cubic gate of one family member. -/
noncomputable def physicalGate (family : KT19DistillationFamily p l k) :
    UnitaryTransport (PrimeQuditRegister p (KeptPunctureLocation p k))
      (PrimeQuditRegister p (KeptPunctureLocation p k)) :=
  family.rowFamily.physicalU13

/-- The actual encoded code, with its p-dependent physical and logical
Hilbert spaces, is derived from the displayed cubic rows. -/
noncomputable def encodedCode (family : KT19DistillationFamily p l k) :=
  family.rowFamily.encodedCode

/-- The complete fine physical syndrome instrument of one family member. -/
noncomputable def protocolInstrument (family : KT19DistillationFamily p l k) :=
  kt19ProtocolInstrument family.rowFamily

/-- The complete binary accepted/rejected instrument of one family member. -/
noncomputable def distillationInstrument
    (family : KT19DistillationFamily p l k) :=
  kt19DistillationInstrument family.rowFamily

/-- The trace-preserving decoder constructed from the member's actual
encoding isometry and complement branch. -/
noncomputable def decoder (family : KT19DistillationFamily p l k) :=
  kt19DecoderChannel family.rowFamily

/-- The actual decoded finite run of one family member. -/
noncomputable def run (family : KT19DistillationFamily p l k)
    (mu : ZMod p → ℝ) (hmu_nonneg : ∀ a : ZMod p, 0 ≤ mu a)
    (hmu_sum : ∑ a : ZMod p, mu a = 1) :=
  kt19Run family.rowFamily mu hmu_nonneg hmu_sum

/-- Admissibility supplies an actual logical output port, so the family
protocol's postselected output interface never relies on a supplied
nonemptiness assumption. -/
theorem outputPort_nonempty (family : KT19DistillationFamily p l k) :
    Nonempty (Fin k) := by
  rcases family.admissible with ⟨_, hk, _, _, _⟩
  exact ⟨⟨0, by omega⟩⟩

/-- The source-selected #457 protocol package for one family member.  The
nonempty output-port instance is derived from KT19 admissibility (`1 ≤ k`). -/
noncomputable def protocol (family : KT19DistillationFamily p l k)
    (mu : ZMod p → ℝ) (hmu_nonneg : ∀ a : ZMod p, 0 ≤ mu a)
    (hmu_sum : ∑ a : ZMod p, mu a = 1) :
    MagicStateDistillationProtocol
      (KT19SingleQudit.{0} p)
      (PrimeQuditRegister p (KeptPunctureLocation p k))
      (PrimeQuditRegister p (Fin k)) := by
  letI : Nonempty (Fin k) := outputPort_nonempty family
  exact kt19MagicStateDistillationProtocol family.rowFamily mu hmu_nonneg hmu_sum

/-- The member-specific shared #458 accounting family.  This is constructed
from the same actual run and does not carry a separate resource-count or cost
witness. -/
noncomputable def overheadFamily (family : KT19DistillationFamily p l k)
    (mu : ZMod p → ℝ) (hmu_nonneg : ∀ a : ZMod p, 0 ≤ mu a)
    (hmu_sum : ∑ a : ZMod p, mu a = 1) :
    DistillationProtocolFamily (KT19SingleQudit.{0} p)
      (PrimeQuditRegister p (KeptPunctureLocation p k))
      (PrimeQuditRegister p (Fin k)) PUnit := by
  letI : Nonempty (Fin k) := outputPort_nonempty family
  exact kt19OverheadFamily family.rowFamily mu hmu_nonneg hmu_sum

/-- The p-dependent output label routed from an accepted error word to each
logical port.  This is the literal negative pairing with the displayed
logical row, not a supplied routing hypothesis. -/
def kt19Routing (family : KT19DistillationFamily p l k)
    (error : Word (ZMod p) (KeptPunctureLocation p k)) :
    PrimeQuditRegisterLabel p (Fin k) :=
  kt19LogicalRouting family.rowFamily error

/-- The family routing value is the literal negative pairing with the
corresponding displayed logical row at each actual output port. -/
@[simp] theorem kt19Routing_apply (family : KT19DistillationFamily p l k)
    (error : Word (ZMod p) (KeptPunctureLocation p k)) (port : Fin k) :
    kt19Routing family error port =
      -wordPairing error (family.rowFamily.logicalRow port) :=
  rfl

/-- Every physically accepted family word is decoded to the pure logical
magic-register word selected by the literal KT19 routing function. -/
theorem acceptedDecodedWord_eq_routedMagic
    (family : KT19DistillationFamily p l k)
    (error : Word (ZMod p) (KeptPunctureLocation p k))
    (haccepted : kt19AcceptedWord family.rowFamily error) :
    family.decoder
      (family.distillationInstrument.branchOperator .accepted
        (kt19WordInputDensity error).toOperator) =
      (DensityOperator.pureDensity
        (magicRegisterKet p (kt19Routing family error)) (by
          rw [InnerProductSpace.norm_sq_eq_re_inner (𝕜 := Complex),
            magicRegisterKet_inner_self]
          norm_num)).toOperator := by
  simpa [decoder, distillationInstrument, kt19Routing] using
    kt19AcceptedWord_decodedAccepted_eq_routedMagic
      family.rowFamily error haccepted

/-- The actual retained input-slot count is `p - k`. -/
theorem inputResourceCount_eq (family : KT19DistillationFamily p l k) :
    Fintype.card (KeptPunctureLocation p k) = p - k := by
  rcases family.admissible with ⟨_, _, hkl, hlp, _⟩
  have hkp : k ≤ p := hkl.trans hlp
  simpa using keptPunctureLocations_card p k hkp

/-- The resource count stored by the actual physical run agrees with the
retained-site cardinality and hence is exactly `p-k`. -/
theorem run_resourceCount_eq (family : KT19DistillationFamily p l k)
    (mu : ZMod p → ℝ) (hmu_nonneg : ∀ a : ZMod p, 0 ≤ mu a)
    (hmu_sum : ∑ a : ZMod p, mu a = 1) :
    (run family mu hmu_nonneg hmu_sum).resourceCount = p - k := by
  rw [run, kt19Run_resourceCount, inputResourceCount_eq family]

/-- Shared #458 accounting reads the actual run resource count, hence exactly
`p-k`, rather than a separately advertised cardinality. -/
theorem overheadFamily_inputResourceCount_eq
    (family : KT19DistillationFamily p l k)
    (mu : ZMod p → ℝ) (hmu_nonneg : ∀ a : ZMod p, 0 ≤ mu a)
    (hmu_sum : ∑ a : ZMod p, mu a = 1) :
    (overheadFamily family mu hmu_nonneg hmu_sum).inputResourceCount PUnit.unit =
      p - k := by
  unfold DistillationProtocolFamily.inputResourceCount overheadFamily
  exact run_resourceCount_eq family mu hmu_nonneg hmu_sum

/-- The actual decoded output-port count is the literal logical dimension
`k`, not a metadata field. -/
theorem outputPortCount_eq (_family : KT19DistillationFamily p l k) :
    Fintype.card (Fin k) = k := by
  simp

/-- The actual accepted Born mass of a family member is bounded below by the
IID zero-word contribution with the derived retained-slot count. -/
theorem success_ge_one_sub_errorRate_pow
    (family : KT19DistillationFamily p l k)
    (mu : ZMod p → ℝ) (hmu_nonneg : ∀ a : ZMod p, 0 ≤ mu a)
    (hmu_sum : ∑ a : ZMod p, mu a = 1) :
    (1 - kt19ErrorRate mu) ^ (p - k) ≤
      kt19Success family.rowFamily mu hmu_nonneg hmu_sum := by
  simpa only [inputResourceCount_eq family] using
    (kt19Success_ge_one_sub_errorRate_pow family.rowFamily mu hmu_nonneg hmu_sum)

/-- Strict IID error rate below one makes the actual family member's accepted
Born mass positive. -/
theorem success_pos_of_errorRate_lt_one
    (family : KT19DistillationFamily p l k)
    (mu : ZMod p → ℝ) (hmu_nonneg : ∀ a : ZMod p, 0 ≤ mu a)
    (hmu_sum : ∑ a : ZMod p, mu a = 1) (heps : kt19ErrorRate mu < 1) :
    0 < kt19Success family.rowFamily mu hmu_nonneg hmu_sum :=
  kt19Success_pos_of_errorRate_lt_one family.rowFamily mu hmu_nonneg hmu_sum heps

/-- The literal successful-output input cost of a family member is bounded
using its derived input and output cardinalities and actual accepted Born
mass. -/
noncomputable def successfulOutputCost
    (family : KT19DistillationFamily p l k)
    (mu : ZMod p → ℝ) (hmu_nonneg : ∀ a : ZMod p, 0 ≤ mu a)
    (hmu_sum : ∑ a : ZMod p, mu a = 1) : ℝ := by
  exact (overheadFamily family mu hmu_nonneg hmu_sum).successfulOutputCost PUnit.unit

/-- The family-facing cost is definitionally the shared #458
`DistillationProtocolFamily.successfulOutputCost` of its actual run. -/
theorem successfulOutputCost_eq_shared
    (family : KT19DistillationFamily p l k)
    (mu : ZMod p → ℝ) (hmu_nonneg : ∀ a : ZMod p, 0 ≤ mu a)
    (hmu_sum : ∑ a : ZMod p, mu a = 1) :
    successfulOutputCost family mu hmu_nonneg hmu_sum =
      (overheadFamily family mu hmu_nonneg hmu_sum).successfulOutputCost PUnit.unit :=
  rfl

/-- The literal successful-output input cost of a family member is bounded
using its derived input and output cardinalities and actual accepted Born
mass. -/
theorem successfulOutputCost_le_one_sub_errorRate_pow
    (family : KT19DistillationFamily p l k)
    (mu : ZMod p → ℝ) (hmu_nonneg : ∀ a : ZMod p, 0 ≤ mu a)
    (hmu_sum : ∑ a : ZMod p, mu a = 1) (heps : kt19ErrorRate mu < 1) :
    successfulOutputCost family mu hmu_nonneg hmu_sum ≤
      ((p - k : Nat) : ℝ) /
        ((k : ℝ) * (1 - kt19ErrorRate mu) ^ (p - k)) := by
  letI : Nonempty (Fin k) := outputPort_nonempty family
  change kt19SuccessfulOutputCost family.rowFamily mu hmu_nonneg hmu_sum ≤ _
  simpa only [inputResourceCount_eq family, outputPortCount_eq family] using
    (kt19SuccessfulOutputCost_le_one_sub_errorRate_pow
      family.rowFamily mu hmu_nonneg hmu_sum heps)

/-- The family member's actual worst decoded-output magic-label error.  The
required output-port witness is derived from admissibility, rather than being
an additional protocol field or caller-supplied assumption. -/
noncomputable def outputWorstPortError
    (family : KT19DistillationFamily p l k)
    (mu : ZMod p → ℝ) (hmu_nonneg : ∀ a : ZMod p, 0 ≤ mu a)
    (hmu_sum : ∑ a : ZMod p, mu a = 1) : ℝ := by
  letI : Nonempty (Fin k) := outputPort_nonempty family
  exact kt19OutputWorstPortError
    ((kt19Run family.rowFamily mu hmu_nonneg hmu_sum).acceptedOutput)

/-- The family gate realizes the concrete inverse logical cubic action. -/
theorem physicalGate_implements_inverseLogicalU13
    (family : KT19DistillationFamily p l k) :
    family.encodedCode.ImplementsLogicalGate family.physicalGate
      family.rowFamily.logicalInverseU13 := by
  simpa [encodedCode, physicalGate] using
    (CubicRowFamily.physicalU13_implements_inverseLogicalU13
      family.rowFamily family.primeAtLeastFive)

/-- Restriction to retained coordinates preserves the pairing against a word
that vanishes on every selected coordinate.  This is private to the #883
family adapter: it is the coordinate calculation required to connect the
displayed shortened stabilizer code to its complementary punctured dual. -/
private theorem wordPairing_restrictKept_eq_of_restrictSelected_eq_zero
    (left right : Word (ZMod p) (ZMod p))
    (hselected : restrictSelected p k left = 0) :
    wordPairing (restrictKept p k left) (restrictKept p k right) =
      wordPairing left right := by
  classical
  letI selectedPunctureSubtypeFintype :
      Fintype {point : ZMod p // point ∈ selectedPunctureLocations p k} :=
    Subtype.fintype _
  have hsplit :=
    Fintype.sum_subtype_add_sum_subtype
      (fun point : ZMod p => point ∈ selectedPunctureLocations p k)
      (fun point => left point * right point)
  let complementKept :
      {point : ZMod p // ¬ point ∈ selectedPunctureLocations p k} ≃
        KeptPunctureLocation p k :=
    { toFun := fun point => ⟨point.1,
        Finset.mem_sdiff.mpr ⟨Finset.mem_univ _, point.2⟩⟩
      invFun := fun point => ⟨point.1, (Finset.mem_sdiff.mp point.2).2⟩
      left_inv := fun point => Subtype.ext rfl
      right_inv := fun point => Subtype.ext rfl }
  change (∑ point : KeptPunctureLocation p k, left point.1 * right point.1) =
    ∑ point : ZMod p, left point * right point
  have hselectedSum :
      (∑ point : {point : ZMod p // point ∈ selectedPunctureLocations p k},
        left point.1 * right point.1) = 0 := by
    apply Finset.sum_eq_zero
    intro point _
    have hpoint : left point.1 = 0 := by
      simpa using congrFun hselected
        (⟨point.1, point.2⟩ : SelectedPunctureLocation p k)
    rw [hpoint]
    simp
  have hcomplement :
      (∑ point : {point : ZMod p // ¬ point ∈ selectedPunctureLocations p k},
        left point.1 * right point.1) =
        ∑ point : ZMod p, left point * right point := by
    rw [hselectedSum, zero_add] at hsplit
    exact hsplit
  have hequiv :
      (∑ point : {point : ZMod p // ¬ point ∈ selectedPunctureLocations p k},
        left point.1 * right point.1) =
        ∑ point : KeptPunctureLocation p k, left point.1 * right point.1 := by
    exact Fintype.sum_equiv complementKept _ _ (fun _ => rfl)
  exact hequiv.symm.trans hcomplement

/-- Complementary punctured words are orthogonal to the actual shortened
stabilizer carrier.  The fact is derived from the full Reed--Solomon duality
and the literal selected/retained coordinate split, not recorded as family
data. -/
private theorem puncturedComplementary_le_shortenedDual
    (family : KT19DistillationFamily p l k) :
    (puncturedReedSolomonCode p (p - l) k).carrier ≤
      (shortenedReedSolomonCode p l k).dual.carrier := by
  rcases family.admissible with ⟨_, _, _, hlp, _⟩
  intro word hword
  refine ((shortenedReedSolomonCode p l k).mem_dual word).2 ?_
  intro shortened hshortened
  rcases (mem_puncturedReedSolomonCode word).1 hword with
    ⟨fullWord, hfullWord, hrestrictWord⟩
  rcases (mem_shortenedReedSolomonCode shortened).1 hshortened with
    ⟨fullShortened, hfullShortened, hselected, hrestrictShortened⟩
  have hfullWordDual : fullWord ∈ (reedSolomonCode p l).dual.carrier := by
    rw [reedSolomonCode_dual p l hlp]
    simpa using hfullWord
  have horthogonal := (reedSolomonCode p l).orthogonal_of_mem_dual
    hfullWordDual hfullShortened
  rw [← hrestrictWord, ← hrestrictShortened]
  calc
    wordPairing (restrictKept p k fullWord)
        (restrictKept p k fullShortened) =
        wordPairing (restrictKept p k fullShortened)
          (restrictKept p k fullWord) := by
      simp only [wordPairing_apply, dotProduct_comm]
    _ = wordPairing fullShortened fullWord :=
      wordPairing_restrictKept_eq_of_restrictSelected_eq_zero
        fullShortened fullWord hselected
    _ = 0 := by
      simpa [wordPairing_apply, dotProduct_comm] using horthogonal

/-- The actual shortened carrier of a family member has complementary
punctured dual.  The dimension comparison is kept private because this is
only the source-required bridge for the #883 family interface. -/
private theorem shortenedDual_eq_complementaryPunctured
    (family : KT19DistillationFamily p l k) :
    (shortenedReedSolomonCode p l k).dual.carrier =
      (puncturedReedSolomonCode p (p - l) k).carrier := by
  rcases family.admissible with ⟨_, _, hkl, hlp, _⟩
  have hkp : k ≤ p := hkl.trans hlp
  have hcomplementLength : p - l ≤ p - k := by omega
  symm
  apply Submodule.eq_of_le_of_finrank_eq
  · exact puncturedComplementary_le_shortenedDual family
  · change Dimension (puncturedReedSolomonCode p (p - l) k) =
      Dimension (shortenedReedSolomonCode p l k).dual
    rw [LinearCode.dual_dimension_eq_length_sub_dimension,
      puncturedReedSolomonCode_dimension p (p - l) k hkp hcomplementLength,
      shortenedReedSolomonCode_dimension p l k hkp hkl hlp]
    have hcard : Fintype.card (KeptPunctureLocation p k) = p - k := by
      simpa using keptPunctureLocations_card p k hkp
    simp only [Length, hcard]
    omega

/-- The accepted-word carrier derived from the physical KT19 stabilizer rows
is exactly the complementary punctured Reed--Solomon code. -/
theorem dualWordCarrier_eq_punctured
    (family : KT19DistillationFamily p l k) :
    (kt19StabilizerCode family.rowFamily).dual.carrier =
      (puncturedReedSolomonCode p (p - l) k).carrier := by
  have hcarrier :
      (kt19StabilizerCode family.rowFamily).carrier =
        (shortenedReedSolomonCode p l k).carrier := by
    simpa [kt19StabilizerCode] using family.stabilizerCarrier_eq_shortened
  rw [LinearCode.dual_carrier, hcarrier]
  simpa only [LinearCode.dual_carrier] using
    shortenedDual_eq_complementaryPunctured family

/-- The accepted-word code of a family member has the exact complementary
Reed--Solomon minimum distance. -/
theorem dualWord_minimumDistance
    (family : KT19DistillationFamily p l k) :
    MinimumDistance (kt19StabilizerCode family.rowFamily).dual (l + 1 - k) := by
  rcases puncturedComplementaryReedSolomon_minimumDistance p l k
    family.admissible with ⟨word, hword, hwordNe, hwordWeight, hleast⟩
  refine ⟨word, ?_, hwordNe, hwordWeight, ?_⟩
  · rw [dualWordCarrier_eq_punctured family]
    exact hword
  · intro candidate hcandidate hcandidateNe
    apply hleast candidate
    · rw [← dualWordCarrier_eq_punctured family]
      exact hcandidate
    · exact hcandidateNe

/-- A nonzero physically accepted word has the exact family distance lower
bound, obtained from the constructed stabilizer code rather than a stored
error-tail conclusion. -/
theorem acceptedWord_hammingWeight_ge_exactDistance
    (family : KT19DistillationFamily p l k)
    (error : Word (ZMod p) (KeptPunctureLocation p k))
    (haccepted : kt19AcceptedWord family.rowFamily error) (herror : error ≠ 0) :
    l + 1 - k ≤ HammingWeight error := by
  have hacceptedDual :
      error ∈ (kt19StabilizerCode family.rowFamily).dual.carrier :=
    (kt19AcceptedWord_iff_mem_stabilizerCode_dual family.rowFamily error).mp haccepted
  rcases dualWord_minimumDistance family with
    ⟨word, hword, hwordNe, hwordWeight, hleast⟩
  exact hleast error hacceptedDual herror

/-- Every IID error word has mass at most the corresponding power of the
actual single-site nonzero-label mass.  This is the finite product estimate
used by the family recurrence: zero coordinates cost at most one and every
nonzero coordinate costs at most `kt19ErrorRate mu`. -/
private theorem wordProbability_le_errorRate_pow_hammingWeight
    (mu : ZMod p → ℝ) (hmu_nonneg : ∀ a : ZMod p, 0 ≤ mu a)
    (hmu_sum : ∑ a : ZMod p, mu a = 1)
    (error : Word (ZMod p) (KeptPunctureLocation p k)) :
    wordProbability p mu error ≤ kt19ErrorRate mu ^ HammingWeight error := by
  classical
  have hmu_zero : mu 0 = 1 - kt19ErrorRate mu := by
    unfold kt19ErrorRate
    ring
  unfold wordProbability
  calc
    (∏ site : KeptPunctureLocation p k, mu (error site)) ≤
        ∏ site : KeptPunctureLocation p k,
          if error site = 0 then 1 else kt19ErrorRate mu := by
      refine Finset.prod_le_prod ?_ ?_
      · intro site _
        exact hmu_nonneg (error site)
      · intro site _
        by_cases hzero : error site = 0
        · simpa [hzero] using kt19Mu_zero_le_one mu hmu_nonneg hmu_sum
        · simpa [hzero] using
            (mu_nonzero_le (p := p) mu (kt19ErrorRate mu) hmu_zero
              hmu_nonneg hmu_sum (error site) hzero)
    _ = kt19ErrorRate mu ^ HammingWeight error := by
      rw [Finset.prod_ite]
      have hnonzero :
          (Finset.univ.filter fun site : KeptPunctureLocation p k =>
            ¬ error site = 0) = hammingSupport error := by
        ext site
        simp [hammingSupport]
      have hzero_card :
          (Finset.univ.filter fun site : KeptPunctureLocation p k =>
            error site = 0).card =
              Fintype.card (KeptPunctureLocation p k) - HammingWeight error := by
        have hpartition := Finset.card_filter_add_card_filter_not
          (s := Finset.univ)
          (fun site : KeptPunctureLocation p k => error site = 0)
        rw [hnonzero, ← HammingWeight_eq_card_hammingSupport] at hpartition
        have huniv_card :
            (Finset.univ : Finset (KeptPunctureLocation p k)).card =
              Fintype.card (KeptPunctureLocation p k) := by
          simp
        rw [huniv_card] at hpartition
        exact Nat.eq_sub_of_add_eq hpartition
      have hnonzero_card :
          (Finset.univ.filter fun site : KeptPunctureLocation p k =>
            ¬ error site = 0).card = HammingWeight error := by
        rw [hnonzero, HammingWeight_eq_card_hammingSupport]
      rw [Finset.prod_const, Finset.prod_const, hzero_card, hnonzero_card]
      ring

/-- Every accepted nonzero family word has literal IID mass at most the
exact complementary-code distance power of the single-site error rate. -/
theorem acceptedWordProbability_le_errorRate_pow_exactDistance
    (family : KT19DistillationFamily p l k)
    (mu : ZMod p → ℝ) (hmu_nonneg : ∀ a : ZMod p, 0 ≤ mu a)
    (hmu_sum : ∑ a : ZMod p, mu a = 1)
    (error : Word (ZMod p) (KeptPunctureLocation p k))
    (haccepted : kt19AcceptedWord family.rowFamily error) (herror : error ≠ 0) :
    wordProbability p mu error ≤ kt19ErrorRate mu ^ (l + 1 - k) := by
  calc
    wordProbability p mu error ≤ kt19ErrorRate mu ^ HammingWeight error :=
      wordProbability_le_errorRate_pow_hammingWeight mu hmu_nonneg hmu_sum error
    _ ≤ kt19ErrorRate mu ^ (l + 1 - k) :=
      pow_le_pow_of_le_one
        (kt19ErrorRate_nonneg mu hmu_nonneg hmu_sum)
        (kt19ErrorRate_le_one mu hmu_nonneg)
        (acceptedWord_hammingWeight_ge_exactDistance family error haccepted herror)

/-- The literal accepted nonzero-word mass of a family member before
normalization by its physical accepted Born weight. -/
noncomputable def acceptedResidualMass
    (family : KT19DistillationFamily p l k)
    (mu : ZMod p → ℝ) : ℝ :=
  ∑ error : Word (ZMod p) (KeptPunctureLocation p k),
    if kt19AcceptedWord family.rowFamily error ∧ error ≠ 0 then
      wordProbability p mu error
    else 0

/-- The accepted nonzero-word mass is nonnegative because it is a finite sum
of the exact IID product probabilities. -/
theorem acceptedResidualMass_nonneg
    (family : KT19DistillationFamily p l k)
    (mu : ZMod p → ℝ) (hmu_nonneg : ∀ a : ZMod p, 0 ≤ mu a) :
    0 ≤ acceptedResidualMass family mu := by
  unfold acceptedResidualMass
  apply Finset.sum_nonneg
  intro error _
  by_cases hresidual : kt19AcceptedWord family.rowFamily error ∧ error ≠ 0
  · simp [hresidual, wordProbability_nonneg p mu hmu_nonneg error]
  · simp [hresidual]

/-- The literal accepted-error tail is bounded by the finite physical word
count times the exact family-distance IID monomial. -/
theorem acceptedResidualMass_le_card_errorRate_pow_exactDistance
    (family : KT19DistillationFamily p l k)
    (mu : ZMod p → ℝ) (hmu_nonneg : ∀ a : ZMod p, 0 ≤ mu a)
    (hmu_sum : ∑ a : ZMod p, mu a = 1) :
    acceptedResidualMass family mu ≤
      (Fintype.card (Word (ZMod p) (KeptPunctureLocation p k)) : ℝ) *
        kt19ErrorRate mu ^ (l + 1 - k) := by
  unfold acceptedResidualMass
  calc
    (∑ error : Word (ZMod p) (KeptPunctureLocation p k),
      if kt19AcceptedWord family.rowFamily error ∧ error ≠ 0 then
        wordProbability p mu error
      else 0) ≤
        ∑ _error : Word (ZMod p) (KeptPunctureLocation p k),
          kt19ErrorRate mu ^ (l + 1 - k) := by
      apply Finset.sum_le_sum
      intro error _
      by_cases hresidual : kt19AcceptedWord family.rowFamily error ∧ error ≠ 0
      · rw [if_pos hresidual]
        exact acceptedWordProbability_le_errorRate_pow_exactDistance
          family mu hmu_nonneg hmu_sum error hresidual.1 hresidual.2
      · simp [hresidual, pow_nonneg (kt19ErrorRate_nonneg mu hmu_nonneg hmu_sum)]
    _ = (Fintype.card (Word (ZMod p) (KeptPunctureLocation p k)) : ℝ) *
        kt19ErrorRate mu ^ (l + 1 - k) := by
      simp

/-- The family accepted-error tail normalized by the actual physical success
mass; this remains a finite tail, not a stored output-error conclusion. -/
noncomputable def acceptedResidualError
    (family : KT19DistillationFamily p l k)
    (mu : ZMod p → ℝ) (hmu_nonneg : ∀ a : ZMod p, 0 ≤ mu a)
    (hmu_sum : ∑ a : ZMod p, mu a = 1) : ℝ :=
  acceptedResidualMass family mu /
    kt19Success family.rowFamily mu hmu_nonneg hmu_sum

/-- The family distance bounds its normalized accepted-error tail by the
actual measured success mass, with strict positivity derived from the IID
input model. -/
theorem acceptedResidualError_le_card_errorRate_pow_exactDistance_div_success
    (family : KT19DistillationFamily p l k)
    (mu : ZMod p → ℝ) (hmu_nonneg : ∀ a : ZMod p, 0 ≤ mu a)
    (hmu_sum : ∑ a : ZMod p, mu a = 1) (heps : kt19ErrorRate mu < 1) :
    acceptedResidualError family mu hmu_nonneg hmu_sum ≤
      ((Fintype.card (Word (ZMod p) (KeptPunctureLocation p k)) : ℝ) *
        kt19ErrorRate mu ^ (l + 1 - k)) /
        kt19Success family.rowFamily mu hmu_nonneg hmu_sum := by
  unfold acceptedResidualError
  exact div_le_div_of_nonneg_right
    (acceptedResidualMass_le_card_errorRate_pow_exactDistance
      family mu hmu_nonneg hmu_sum)
    (le_of_lt (success_pos_of_errorRate_lt_one
      family mu hmu_nonneg hmu_sum heps))

end KT19DistillationFamily

/-! ## The concrete p=11 accepted-word distance -/

local instance p11Prime : Fact (Nat.Prime 11) := ⟨by norm_num⟩
local instance p11NeZero : NeZero 11 := ⟨by norm_num⟩

/-- The first concrete member of the changing-prime family is derived from
the displayed `p = 11`, `l = 4`, `k = 2` cubic rows.  Its code identity is
the bridge theorem proved from those rows, rather than an asserted protocol
or performance conclusion. -/
noncomputable def p11DistillationFamily : KT19DistillationFamily 11 4 2 where
  primeAtLeastFive := by
    constructor <;> norm_num
  admissible := by
    norm_num [Admissible]
  rowFamily := p11CubicRowFamily
  stabilizerCarrier_eq_shortened := by
    change p11StabilizerCarrier = (shortenedReedSolomonCode 11 4 2).carrier
    exact p11_stabilizerCarrier_eq_shortenedReedSolomon

/-- The retained-coordinate pairing agrees with the full pairing when the
left word vanishes on the two selected p=11 coordinates.  This is a local
derivation from the literal restriction maps, kept private because it only
serves the concrete #883 distance bridge. -/
private theorem p11_wordPairing_restrictKept_eq_of_restrictSelected_eq_zero
    (left right : Word (ZMod 11) (ZMod 11))
    (hselected : restrictSelected 11 2 left = 0) :
    wordPairing (restrictKept 11 2 left) (restrictKept 11 2 right) =
      wordPairing left right := by
  classical
  letI selectedPunctureSubtypeFintype :
      Fintype {point : ZMod 11 // point ∈ selectedPunctureLocations 11 2} :=
    Subtype.fintype _
  have hsplit :=
    Fintype.sum_subtype_add_sum_subtype
      (fun point : ZMod 11 => point ∈ selectedPunctureLocations 11 2)
      (fun point => left point * right point)
  let complementKept :
      {point : ZMod 11 // ¬ point ∈ selectedPunctureLocations 11 2} ≃
        KeptPunctureLocation 11 2 :=
    { toFun := fun point => ⟨point.1,
        Finset.mem_sdiff.mpr ⟨Finset.mem_univ _, point.2⟩⟩
      invFun := fun point => ⟨point.1, (Finset.mem_sdiff.mp point.2).2⟩
      left_inv := fun point => Subtype.ext rfl
      right_inv := fun point => Subtype.ext rfl }
  change (∑ point : KeptPunctureLocation 11 2, left point.1 * right point.1) =
    ∑ point : ZMod 11, left point * right point
  have hselectedSum :
      (∑ point : {point : ZMod 11 // point ∈ selectedPunctureLocations 11 2},
        left point.1 * right point.1) = 0 := by
    apply Finset.sum_eq_zero
    intro point _
    have hpoint : left point.1 = 0 := by
      simpa using congrFun hselected
        (⟨point.1, point.2⟩ : SelectedPunctureLocation 11 2)
    rw [hpoint]
    simp
  have hcomplement :
      (∑ point : {point : ZMod 11 // ¬ point ∈ selectedPunctureLocations 11 2},
        left point.1 * right point.1) =
        ∑ point : ZMod 11, left point * right point := by
    rw [hselectedSum, zero_add] at hsplit
    exact hsplit
  have hequiv :
      (∑ point : {point : ZMod 11 // ¬ point ∈ selectedPunctureLocations 11 2},
        left point.1 * right point.1) =
        ∑ point : KeptPunctureLocation 11 2, left point.1 * right point.1 := by
    exact Fintype.sum_equiv complementKept _ _ (fun _ => rfl)
  exact hequiv.symm.trans hcomplement

/-- The concrete degree-<7 punctured p=11 code is orthogonal to every
shortened degree-<4 word. -/
private theorem p11_puncturedSeven_le_shortenedFour_dual :
    (puncturedReedSolomonCode 11 7 2).carrier ≤
      (shortenedReedSolomonCode 11 4 2).dual.carrier := by
  intro word hword
  refine ((shortenedReedSolomonCode 11 4 2).mem_dual word).2 ?_
  intro shortened hshortened
  rcases (mem_puncturedReedSolomonCode word).1 hword with
    ⟨fullWord, hfullWord, hrestrictWord⟩
  rcases (mem_shortenedReedSolomonCode shortened).1 hshortened with
    ⟨fullShortened, hfullShortened, hselected, hrestrictShortened⟩
  have hfullWordDual : fullWord ∈ (reedSolomonCode 11 4).dual.carrier := by
    rw [reedSolomonCode_dual 11 4 (by norm_num)]
    simpa using hfullWord
  have horthogonal := (reedSolomonCode 11 4).orthogonal_of_mem_dual
    hfullWordDual hfullShortened
  rw [← hrestrictWord, ← hrestrictShortened]
  calc
    wordPairing (restrictKept 11 2 fullWord)
        (restrictKept 11 2 fullShortened) =
        wordPairing (restrictKept 11 2 fullShortened)
          (restrictKept 11 2 fullWord) := by
      simp only [wordPairing_apply, dotProduct_comm]
    _ = wordPairing fullShortened fullWord :=
      p11_wordPairing_restrictKept_eq_of_restrictSelected_eq_zero
        fullShortened fullWord hselected
    _ = 0 := by
      simpa [wordPairing_apply, dotProduct_comm] using horthogonal

/-- Complementary p=11 shortening/puncturing duality needed only for the
accepted-word distance.  The proof uses the preceding public orthogonality
route and the public finite-code dimension formulas, without broadening the
#882 source API. -/
private theorem p11_shortenedFour_dual_eq_puncturedSeven :
    (shortenedReedSolomonCode 11 4 2).dual.carrier =
      (puncturedReedSolomonCode 11 7 2).carrier := by
  symm
  apply Submodule.eq_of_le_of_finrank_eq
  · exact p11_puncturedSeven_le_shortenedFour_dual
  · change Dimension (puncturedReedSolomonCode 11 7 2) =
      Dimension (shortenedReedSolomonCode 11 4 2).dual
    rw [LinearCode.dual_dimension_eq_length_sub_dimension,
      puncturedReedSolomonCode_dimension 11 7 2 (by norm_num) (by norm_num),
      shortenedReedSolomonCode_dimension 11 4 2 (by norm_num) (by norm_num) (by norm_num)]
    have hcard : Fintype.card (KeptPunctureLocation 11 2) = 9 := by
      simpa using keptPunctureLocations_card 11 2 (by norm_num : 2 ≤ 11)
    simp [Length, hcard]

/-- Every nonzero p=11 word accepted by the physical KT19 syndrome
instrument has Hamming weight at least three. -/
theorem p11AcceptedWord_hammingWeight_ge_three
    (error : Word (ZMod 11) (KeptPunctureLocation 11 2))
    (haccepted : kt19AcceptedWord p11CubicRowFamily error) (herror : error ≠ 0) :
    3 ≤ HammingWeight error := by
  have hacceptedDual :
      error ∈ (kt19StabilizerCode p11CubicRowFamily).dual.carrier :=
    (kt19AcceptedWord_iff_mem_stabilizerCode_dual p11CubicRowFamily error).mp haccepted
  rw [LinearCode.mem_dual] at hacceptedDual
  have hshortenedDual :
      error ∈ (shortenedReedSolomonCode 11 4 2).dual.carrier := by
    rw [LinearCode.mem_dual]
    intro carrier hcarrier
    apply hacceptedDual carrier
    change carrier ∈ p11StabilizerCarrier
    rw [p11_stabilizerCarrier_eq_shortenedReedSolomon]
    exact hcarrier
  have hpunctured : error ∈ (puncturedReedSolomonCode 11 7 2).carrier := by
    rw [← p11_shortenedFour_dual_eq_puncturedSeven]
    exact hshortenedDual
  have hminimum : MinimumDistance (puncturedReedSolomonCode 11 7 2) 3 := by
    exact puncturedComplementaryReedSolomon_minimumDistance
      (p := 11) (l := 4) (k := 2) (by norm_num [Admissible])
  rcases hminimum with ⟨_, _, _, _, hleast⟩
  exact hleast error hpunctured herror

/-- The literal p=11 IID word mass is at most the corresponding power of the
actual total nonzero-label mass.  This is a local product estimate: nonzero
coordinates cost at most `kt19ErrorRate mu`, while zero coordinates cost at
most one. -/
private theorem p11_wordProbability_le_errorRate_pow_hammingWeight
    (mu : ZMod 11 → ℝ) (hmu_nonneg : ∀ a : ZMod 11, 0 ≤ mu a)
    (hmu_sum : ∑ a : ZMod 11, mu a = 1)
    (error : Word (ZMod 11) (KeptPunctureLocation 11 2)) :
    wordProbability 11 mu error ≤ kt19ErrorRate mu ^ HammingWeight error := by
  classical
  have hmu_zero : mu 0 = 1 - kt19ErrorRate mu := by
    unfold kt19ErrorRate
    ring
  unfold wordProbability
  calc
    (∏ site : KeptPunctureLocation 11 2, mu (error site)) ≤
        ∏ site : KeptPunctureLocation 11 2,
          if error site = 0 then 1 else kt19ErrorRate mu := by
      refine Finset.prod_le_prod ?_ ?_
      · intro site _
        exact hmu_nonneg (error site)
      · intro site _
        by_cases hzero : error site = 0
        · simpa [hzero] using kt19Mu_zero_le_one mu hmu_nonneg hmu_sum
        · simpa [hzero] using
            (mu_nonzero_le (p := 11) mu (kt19ErrorRate mu) hmu_zero
              hmu_nonneg hmu_sum (error site) hzero)
    _ = kt19ErrorRate mu ^ HammingWeight error := by
      rw [Finset.prod_ite]
      have hnonzero :
          (Finset.univ.filter fun site : KeptPunctureLocation 11 2 =>
            ¬ error site = 0) = hammingSupport error := by
        ext site
        simp [hammingSupport]
      have hzero_card :
          (Finset.univ.filter fun site : KeptPunctureLocation 11 2 =>
            error site = 0).card =
              Fintype.card (KeptPunctureLocation 11 2) - HammingWeight error := by
        have hpartition := Finset.card_filter_add_card_filter_not
          (s := Finset.univ)
          (fun site : KeptPunctureLocation 11 2 => error site = 0)
        rw [hnonzero, ← HammingWeight_eq_card_hammingSupport] at hpartition
        have huniv_card :
            (Finset.univ : Finset (KeptPunctureLocation 11 2)).card =
              Fintype.card (KeptPunctureLocation 11 2) := by
          simp
        rw [huniv_card] at hpartition
        exact Nat.eq_sub_of_add_eq hpartition
      have hnonzero_card :
          (Finset.univ.filter fun site : KeptPunctureLocation 11 2 =>
            ¬ error site = 0).card = HammingWeight error := by
        rw [hnonzero, HammingWeight_eq_card_hammingSupport]
      rw [Finset.prod_const, Finset.prod_const, hzero_card, hnonzero_card]
      ring

/-- Every accepted nonzero p=11 error word has literal IID mass at most the
third power of the actual single-site nonzero-label error rate. -/
theorem p11AcceptedWordProbability_le_errorRate_pow_three
    (mu : ZMod 11 → ℝ) (hmu_nonneg : ∀ a : ZMod 11, 0 ≤ mu a)
    (hmu_sum : ∑ a : ZMod 11, mu a = 1)
    (error : Word (ZMod 11) (KeptPunctureLocation 11 2))
    (haccepted : kt19AcceptedWord p11CubicRowFamily error) (herror : error ≠ 0) :
    wordProbability 11 mu error ≤ kt19ErrorRate mu ^ 3 := by
  calc
    wordProbability 11 mu error ≤ kt19ErrorRate mu ^ HammingWeight error :=
      p11_wordProbability_le_errorRate_pow_hammingWeight mu hmu_nonneg hmu_sum error
    _ ≤ kt19ErrorRate mu ^ 3 :=
      pow_le_pow_of_le_one
        (kt19ErrorRate_nonneg mu hmu_nonneg hmu_sum)
        (kt19ErrorRate_le_one mu hmu_nonneg)
        (p11AcceptedWord_hammingWeight_ge_three error haccepted herror)

/-- The literal accepted nonzero p=11 word mass before normalization by the
actual accepted Born weight.  Its support is derived from the physical KT19
syndrome acceptance predicate, not supplied as a separate enumerator. -/
noncomputable def p11AcceptedResidualMass
    (mu : ZMod 11 → ℝ) : ℝ :=
  ∑ error : Word (ZMod 11) (KeptPunctureLocation 11 2),
    if kt19AcceptedWord p11CubicRowFamily error ∧ error ≠ 0 then
      wordProbability 11 mu error
    else 0

/-- The accepted nonzero p=11 word mass is nonnegative because it is a finite
sum of literal IID product probabilities. -/
theorem p11AcceptedResidualMass_nonneg
    (mu : ZMod 11 → ℝ) (hmu_nonneg : ∀ a : ZMod 11, 0 ≤ mu a) :
    0 ≤ p11AcceptedResidualMass mu := by
  unfold p11AcceptedResidualMass
  apply Finset.sum_nonneg
  intro error _
  by_cases hresidual : kt19AcceptedWord p11CubicRowFamily error ∧ error ≠ 0
  · simp [hresidual, wordProbability_nonneg 11 mu hmu_nonneg error]
  · simp [hresidual]

/-- The concrete p=11 accepted-error tail is bounded by the finite physical
word count times the exact distance-three IID monomial. -/
theorem p11AcceptedResidualMass_le_card_errorRate_pow_three
    (mu : ZMod 11 → ℝ) (hmu_nonneg : ∀ a : ZMod 11, 0 ≤ mu a)
    (hmu_sum : ∑ a : ZMod 11, mu a = 1) :
    p11AcceptedResidualMass mu ≤
      (Fintype.card (Word (ZMod 11) (KeptPunctureLocation 11 2)) : ℝ) *
        kt19ErrorRate mu ^ 3 := by
  unfold p11AcceptedResidualMass
  calc
    (∑ error : Word (ZMod 11) (KeptPunctureLocation 11 2),
      if kt19AcceptedWord p11CubicRowFamily error ∧ error ≠ 0 then
        wordProbability 11 mu error
      else 0) ≤
        ∑ _error : Word (ZMod 11) (KeptPunctureLocation 11 2),
          kt19ErrorRate mu ^ 3 := by
      apply Finset.sum_le_sum
      intro error _
      by_cases hresidual : kt19AcceptedWord p11CubicRowFamily error ∧ error ≠ 0
      · rw [if_pos hresidual]
        exact p11AcceptedWordProbability_le_errorRate_pow_three
          mu hmu_nonneg hmu_sum error hresidual.1 hresidual.2
      · simp [hresidual, pow_nonneg (kt19ErrorRate_nonneg mu hmu_nonneg hmu_sum)]
    _ = (Fintype.card (Word (ZMod 11) (KeptPunctureLocation 11 2)) : ℝ) *
        kt19ErrorRate mu ^ 3 := by
      simp

/-- The literal p=11 accepted-error tail normalized by the actual accepted
Born weight.  This remains a residual mass, not a replacement output-error
observable: the later decoded-output bridge must prove that connection from
the physical decoder and readout. -/
noncomputable def p11AcceptedResidualError
    (mu : ZMod 11 → ℝ) (hmu_nonneg : ∀ a : ZMod 11, 0 ≤ mu a)
    (hmu_sum : ∑ a : ZMod 11, mu a = 1) : ℝ :=
  p11AcceptedResidualMass mu /
    kt19Success p11CubicRowFamily mu hmu_nonneg hmu_sum

/-- Distance three bounds the normalized p=11 accepted-error tail by the
actual physical success mass.  No success-free recurrence is inferred here. -/
theorem p11AcceptedResidualError_le_card_errorRate_pow_three_div_success
    (mu : ZMod 11 → ℝ) (hmu_nonneg : ∀ a : ZMod 11, 0 ≤ mu a)
    (hmu_sum : ∑ a : ZMod 11, mu a = 1)
    (heps : kt19ErrorRate mu < 1) :
    p11AcceptedResidualError mu hmu_nonneg hmu_sum ≤
      ((Fintype.card (Word (ZMod 11) (KeptPunctureLocation 11 2)) : ℝ) *
        kt19ErrorRate mu ^ 3) /
        kt19Success p11CubicRowFamily mu hmu_nonneg hmu_sum := by
  unfold p11AcceptedResidualError
  exact div_le_div_of_nonneg_right
    (p11AcceptedResidualMass_le_card_errorRate_pow_three mu hmu_nonneg hmu_sum)
    (le_of_lt (kt19Success_pos_of_errorRate_lt_one
      p11CubicRowFamily mu hmu_nonneg hmu_sum heps))

/-- The p=11 successful-output cost retains the actual retained-site and
logical-port counts and the actual accepted Born mass in its denominator. -/
theorem p11SuccessfulOutputCost_le_one_sub_errorRate_pow
    (mu : ZMod 11 → ℝ) (hmu_nonneg : ∀ a : ZMod 11, 0 ≤ mu a)
    (hmu_sum : ∑ a : ZMod 11, mu a = 1)
    (heps : kt19ErrorRate mu < 1) :
    kt19SuccessfulOutputCost p11CubicRowFamily mu hmu_nonneg hmu_sum ≤
      (Fintype.card (KeptPunctureLocation 11 2) : ℝ) /
        ((Fintype.card (Fin 2) : ℝ) *
          (1 - kt19ErrorRate mu) ^ Fintype.card (KeptPunctureLocation 11 2)) :=
  kt19SuccessfulOutputCost_le_one_sub_errorRate_pow
    p11CubicRowFamily mu hmu_nonneg hmu_sum heps

/-! ## The decoded p=11 accepted residual -/

/-- The raw accepted endpoint is the literal IID mixture of its accepted
word branches.  Words outside the physical trivial-X-syndrome support are
removed only after their actual binary branch has been shown to vanish. -/
private theorem kt19RawAcceptedEndpoint_eq_acceptedWord_sum
    (R : CubicRowFamily q Logical Stabilizer Site)
    (mu : ZMod q → ℝ) (hmu_nonneg : ∀ a : ZMod q, 0 ≤ mu a)
    (hmu_sum : ∑ a : ZMod q, mu a = 1) :
    kt19RawEndpoint R mu hmu_nonneg hmu_sum .accepted =
      ∑ error : PrimeQuditRegisterLabel q Site,
        if kt19AcceptedWord R error then
          (wordProbability q mu error : Complex) •
            (kt19DistillationInstrument R).branchOperator .accepted
              (kt19WordInputDensity (Site := Site) error).toOperator
        else 0 := by
  classical
  unfold kt19RawEndpoint kt19IIDResource
  rw [magicRegisterResource, DensityOperator.convexCombination_toOperator]
  unfold DensityOperator.convexCombinationOperator
  rw [FiniteInstrument.branchOperator_sum]
  simp_rw [FiniteInstrument.branchOperator_smul]
  apply Finset.sum_congr rfl
  intro error _
  change (wordProbability q mu error : Complex) •
      (kt19DistillationInstrument R).branchOperator .accepted
        (kt19WordInputDensity (Site := Site) error).toOperator = _
  by_cases haccepted : kt19AcceptedWord R error
  · simp [haccepted]
  · have hsyndrome : xSyndrome R error ≠ 0 := by
      simpa [kt19AcceptedWord] using haccepted
    rw [kt19DistillationInstrument_accepted_branchOperator_wordInputDensity_eq_zero_of_xSyndrome_ne_zero
      R error hsyndrome]
    simp [haccepted]

/-- For later centering, rejected word indices are represented by the ideal
operator itself.  On accepted indices this is exactly the actual decoded raw
branch, so no conditional density is fabricated for a zero-weight word. -/
private noncomputable def kt19AcceptedDecodedBranch
    (R : CubicRowFamily q Logical Stabilizer Site)
    (error : PrimeQuditRegisterLabel q Site) :
    Operator (PrimeQuditRegister q Logical) :=
  if kt19AcceptedWord R error then
    kt19DecoderChannel R
      ((kt19DistillationInstrument R).branchOperator .accepted
        (kt19WordInputDensity (Site := Site) error).toOperator)
  else (kt19IdealOutput (q := q) (Logical := Logical)).toOperator

private theorem kt19AcceptedDecodedBranch_of_accepted
    (R : CubicRowFamily q Logical Stabilizer Site)
    (error : PrimeQuditRegisterLabel q Site)
    (haccepted : kt19AcceptedWord R error) :
    kt19AcceptedDecodedBranch R error =
      kt19DecoderChannel R
        ((kt19DistillationInstrument R).branchOperator .accepted
          (kt19WordInputDensity (Site := Site) error).toOperator) := by
  simp [kt19AcceptedDecodedBranch, haccepted]

private theorem kt19AcceptedDecodedBranch_zero_eq_ideal
    (R : CubicRowFamily q Logical Stabilizer Site) :
    kt19AcceptedDecodedBranch R (0 : PrimeQuditRegisterLabel q Site) =
      (kt19IdealOutput (q := q) (Logical := Logical)).toOperator := by
  have haccepted : kt19AcceptedWord R (0 : PrimeQuditRegisterLabel q Site) := by
    simp [kt19AcceptedWord, kt19ZeroWord_xSyndrome]
  rw [kt19AcceptedDecodedBranch, if_pos haccepted]
  exact kt19ZeroWord_decodedAccepted_eq_ideal R

/-- Applying the trace-preserving decoder to the physical raw accepted
endpoint commutes with the literal finite IID accepted-word decomposition. -/
private theorem kt19DecodedRawAcceptedEndpoint_eq_acceptedWord_sum
    (R : CubicRowFamily q Logical Stabilizer Site)
    (mu : ZMod q → ℝ) (hmu_nonneg : ∀ a : ZMod q, 0 ≤ mu a)
    (hmu_sum : ∑ a : ZMod q, mu a = 1) :
    kt19DecoderChannel R (kt19RawEndpoint R mu hmu_nonneg hmu_sum .accepted) =
      ∑ error : PrimeQuditRegisterLabel q Site,
        if kt19AcceptedWord R error then
          (wordProbability q mu error : Complex) • kt19AcceptedDecodedBranch R error
        else 0 := by
  rw [kt19RawAcceptedEndpoint_eq_acceptedWord_sum R mu hmu_nonneg hmu_sum, map_sum]
  apply Finset.sum_congr rfl
  intro error _
  by_cases haccepted : kt19AcceptedWord R error
  · rw [if_pos haccepted, map_smul,
      kt19AcceptedDecodedBranch_of_accepted R error haccepted]
    simp [haccepted]
  · simp [haccepted]

/-- The decoded raw accepted endpoint is exactly the finite IID mixture of
the routed logical magic-register words.  This is the unnormalized form of
the routed output law. -/
private theorem kt19DecodedRawAcceptedEndpoint_eq_routedMagic_sum
    (R : CubicRowFamily q Logical Stabilizer Site)
    (mu : ZMod q → ℝ) (hmu_nonneg : ∀ a : ZMod q, 0 ≤ mu a)
    (hmu_sum : ∑ a : ZMod q, mu a = 1) :
    kt19DecoderChannel R (kt19RawEndpoint R mu hmu_nonneg hmu_sum .accepted) =
      ∑ error : PrimeQuditRegisterLabel q Site,
        if kt19AcceptedWord R error then
          (wordProbability q mu error : Complex) •
            (DensityOperator.pureDensity
              (magicRegisterKet q (kt19LogicalRouting R error)) (by
                rw [InnerProductSpace.norm_sq_eq_re_inner (𝕜 := Complex),
                  magicRegisterKet_inner_self]
                norm_num)).toOperator
        else 0 := by
  rw [kt19DecodedRawAcceptedEndpoint_eq_acceptedWord_sum
    R mu hmu_nonneg hmu_sum]
  apply Finset.sum_congr rfl
  intro error _
  by_cases haccepted : kt19AcceptedWord R error
  · rw [if_pos haccepted, kt19AcceptedDecodedBranch_of_accepted R error haccepted,
      kt19AcceptedWord_decodedAccepted_eq_routedMagic R error haccepted]
    simp [haccepted]
  · simp [haccepted]

/-- The actual accepted Born mass, cast to the operator scalar field, has the
same finite accepted-word support as the decoded raw endpoint. -/
private theorem kt19Success_cast_eq_acceptedWord_sum
    (R : CubicRowFamily q Logical Stabilizer Site)
    (mu : ZMod q → ℝ) (hmu_nonneg : ∀ a : ZMod q, 0 ≤ mu a)
    (hmu_sum : ∑ a : ZMod q, mu a = 1) :
    (kt19Success R mu hmu_nonneg hmu_sum : Complex) =
      ∑ error : PrimeQuditRegisterLabel q Site,
        if kt19AcceptedWord R error then (wordProbability q mu error : Complex) else 0 := by
  rw [kt19Success_eq_acceptedWord_sum R mu hmu_nonneg hmu_sum,
    Finset.sum_filter, Complex.ofReal_sum]
  apply Finset.sum_congr rfl
  intro error _
  by_cases haccepted : kt19AcceptedWord R error <;> simp [haccepted]

/-- The normalized decoded density for a word whose actual accepted mass is
one.  The positivity witness is derived from the physical word-success law. -/
private noncomputable def kt19AcceptedDecodedDensity
    (R : CubicRowFamily q Logical Stabilizer Site)
    (error : PrimeQuditRegisterLabel q Site)
    (haccepted : kt19AcceptedWord R error) :
    DensityOperator (PrimeQuditRegister q Logical) :=
  (kt19DecoderChannel R).mapDensity
    ((kt19DistillationInstrument R).conditionalDensity .accepted
      (kt19WordInputDensity (Site := Site) error) (by
        change 0 < kt19WordSuccessMass R error
        rw [kt19WordSuccessMass_eq_ite_acceptedWord, if_pos haccepted]
        norm_num))

private theorem kt19AcceptedDecodedDensity_toOperator
    (R : CubicRowFamily q Logical Stabilizer Site)
    (error : PrimeQuditRegisterLabel q Site)
    (haccepted : kt19AcceptedWord R error) :
    (kt19AcceptedDecodedDensity R error haccepted).toOperator =
      kt19AcceptedDecodedBranch R error := by
  rw [kt19AcceptedDecodedBranch_of_accepted R error haccepted]
  unfold kt19AcceptedDecodedDensity
  rw [QuantumChannel.mapDensity_toOperator,
    FiniteInstrument.conditionalDensity_toOperator]
  change kt19DecoderChannel R
      ((kt19WordSuccessMass R error : Complex)⁻¹ •
        (kt19DistillationInstrument R).branchOperator .accepted
          (kt19WordInputDensity (Site := Site) error).toOperator) = _
  rw [map_smul, kt19WordSuccessMass_eq_ite_acceptedWord, if_pos haccepted]
  simp

/-- Every represented decoded branch lies within trace norm two of the
zero-word ideal density: on accepted words it is an actual normalized
conditional density, and elsewhere it is the ideal reference itself. -/
private theorem kt19AcceptedDecodedBranch_traceNorm_sub_ideal_le_two
    (R : CubicRowFamily q Logical Stabilizer Site)
    (error : PrimeQuditRegisterLabel q Site) :
    traceNorm (kt19AcceptedDecodedBranch R error -
      (kt19IdealOutput (q := q) (Logical := Logical)).toOperator) ≤ 2 := by
  classical
  by_cases haccepted : kt19AcceptedWord R error
  · rw [← kt19AcceptedDecodedDensity_toOperator R error haccepted]
    calc
      traceNorm ((kt19AcceptedDecodedDensity R error haccepted).toOperator -
          (kt19IdealOutput (q := q) (Logical := Logical)).toOperator) ≤
          traceNorm (kt19AcceptedDecodedDensity R error haccepted).toOperator +
            traceNorm (-(kt19IdealOutput (q := q) (Logical := Logical)).toOperator) := by
        simpa [sub_eq_add_neg] using
          traceNorm_add_le (kt19AcceptedDecodedDensity R error haccepted).toOperator
            (-(kt19IdealOutput (q := q) (Logical := Logical)).toOperator)
      _ = 2 := by
        rw [DensityOperator.traceNorm_eq_one, traceNorm_neg,
          DensityOperator.traceNorm_eq_one]
        norm_num
  · rw [kt19AcceptedDecodedBranch, if_neg haccepted]
    rw [sub_self, (traceNorm_eq_zero_iff
      (0 : Operator (PrimeQuditRegister q Logical))).mpr rfl]
    norm_num

/-- The decoded contribution of accepted nonzero p=11 words, centered at the
actual zero-word decoded ideal. -/
private noncomputable def p11AcceptedResidualDecodedDifference
    (mu : ZMod 11 → ℝ) : Operator (PrimeQuditRegister 11 (Fin 2)) :=
  ∑ error : Word (ZMod 11) (KeptPunctureLocation 11 2),
    if kt19AcceptedWord p11CubicRowFamily error ∧ error ≠ 0 then
      (wordProbability 11 mu error : Complex) •
        (kt19AcceptedDecodedBranch p11CubicRowFamily error -
          (kt19IdealOutput (q := 11) (Logical := Fin 2)).toOperator)
    else 0

/-- The raw decoded p=11 accepted endpoint differs from its actual success
multiple of the ideal output by exactly the accepted nonzero-word residual. -/
private theorem p11DecodedRawAcceptedEndpoint_sub_success_ideal_eq_residual
    (mu : ZMod 11 → ℝ) (hmu_nonneg : ∀ a : ZMod 11, 0 ≤ mu a)
    (hmu_sum : ∑ a : ZMod 11, mu a = 1) :
    kt19DecoderChannel p11CubicRowFamily
        (kt19RawEndpoint p11CubicRowFamily mu hmu_nonneg hmu_sum .accepted) -
      (kt19Success p11CubicRowFamily mu hmu_nonneg hmu_sum : Complex) •
        (kt19IdealOutput (q := 11) (Logical := Fin 2)).toOperator =
      p11AcceptedResidualDecodedDifference mu := by
  rw [kt19DecodedRawAcceptedEndpoint_eq_acceptedWord_sum p11CubicRowFamily
      mu hmu_nonneg hmu_sum,
    kt19Success_cast_eq_acceptedWord_sum p11CubicRowFamily mu hmu_nonneg hmu_sum]
  unfold p11AcceptedResidualDecodedDifference
  exact FiniteCentering.finset_centered_sum_eq_nonzero_residual
    (Finset.univ : Finset (Word (ZMod 11) (KeptPunctureLocation 11 2)))
    (fun error => (wordProbability 11 mu error : Complex))
    (kt19AcceptedWord p11CubicRowFamily)
    (kt19AcceptedDecodedBranch p11CubicRowFamily)
    0
    (kt19IdealOutput (q := 11) (Logical := Fin 2)).toOperator
    (kt19AcceptedDecodedBranch_zero_eq_ideal p11CubicRowFamily)

/-- Before normalization, the trace norm of the decoded p=11 residual is at
most twice its literal accepted nonzero-word probability mass. -/
private theorem p11AcceptedResidualDecodedDifference_traceNorm_le_two_mul_mass
    (mu : ZMod 11 → ℝ) (hmu_nonneg : ∀ a : ZMod 11, 0 ≤ mu a) :
    traceNorm (p11AcceptedResidualDecodedDifference mu) ≤
      2 * p11AcceptedResidualMass mu := by
  unfold p11AcceptedResidualDecodedDifference
  calc
    traceNorm (∑ error : Word (ZMod 11) (KeptPunctureLocation 11 2),
        if kt19AcceptedWord p11CubicRowFamily error ∧ error ≠ 0 then
          (wordProbability 11 mu error : Complex) •
            (kt19AcceptedDecodedBranch p11CubicRowFamily error -
              (kt19IdealOutput (q := 11) (Logical := Fin 2)).toOperator)
        else 0) ≤
        ∑ error : Word (ZMod 11) (KeptPunctureLocation 11 2),
          if kt19AcceptedWord p11CubicRowFamily error ∧ error ≠ 0 then
            2 * wordProbability 11 mu error
          else 0 := by
      simpa using
        (FiniteDecodedTrace.finset_weighted_residual_traceNorm_le_two_mul_mass
          (Finset.univ : Finset (Word (ZMod 11) (KeptPunctureLocation 11 2)))
          (wordProbability 11 mu)
          (fun error => kt19AcceptedWord p11CubicRowFamily error ∧ error ≠ 0)
          (kt19AcceptedDecodedBranch p11CubicRowFamily)
          (kt19IdealOutput (q := 11) (Logical := Fin 2)).toOperator
          (fun error => wordProbability_nonneg 11 mu hmu_nonneg error)
          (fun error =>
            kt19AcceptedDecodedBranch_traceNorm_sub_ideal_le_two
              p11CubicRowFamily error))
    _ = 2 * p11AcceptedResidualMass mu := by
      unfold p11AcceptedResidualMass
      calc
        (∑ error : Word (ZMod 11) (KeptPunctureLocation 11 2),
            if kt19AcceptedWord p11CubicRowFamily error ∧ error ≠ 0 then
              2 * wordProbability 11 mu error
            else 0) =
            ∑ error : Word (ZMod 11) (KeptPunctureLocation 11 2),
              2 * (if kt19AcceptedWord p11CubicRowFamily error ∧ error ≠ 0 then
                wordProbability 11 mu error
              else 0) := by
          apply Finset.sum_congr rfl
          intro error _
          by_cases hresidual : kt19AcceptedWord p11CubicRowFamily error ∧ error ≠ 0 <;>
            simp [hresidual]
        _ = 2 * ∑ error : Word (ZMod 11) (KeptPunctureLocation 11 2),
            if kt19AcceptedWord p11CubicRowFamily error ∧ error ≠ 0 then
              wordProbability 11 mu error
            else 0 := by
          rw [← Finset.mul_sum]

/-! ## The normalized p=11 output readout -/

/-- One complete magic-register readout weight is the rank-one projector
probability of its actual label ket. -/
private theorem p11OutputLabelDistribution_eq_rankOneTrace
    (rho : DensityOperator (PrimeQuditRegister 11 (Fin 2)))
    (label : PrimeQuditRegisterLabel 11 (Fin 2)) :
    kt19OutputLabelDistribution rho label =
      (LinearMap.trace Complex (PrimeQuditRegister 11 (Fin 2))
        ((InnerProductSpace.rankOne Complex (magicRegisterKet 11 label)
          (magicRegisterKet 11 label)).toLinearMap * rho.toOperator)).re := by
  classical
  let P : Operator (PrimeQuditRegister 11 (Fin 2)) :=
    (InnerProductSpace.rankOne Complex (magicRegisterKet 11 label)
      (magicRegisterKet 11 label)).toLinearMap
  have hnorm : ‖magicRegisterKet 11 label‖ = 1 := by
    have hnormSq : ‖magicRegisterKet 11 label‖ ^ 2 = 1 := by
      rw [InnerProductSpace.norm_sq_eq_re_inner (𝕜 := Complex),
        magicRegisterKet_inner_self]
      norm_num
    nlinarith [norm_nonneg (magicRegisterKet 11 label)]
  have hP : P.IsSymmetricProjection := by
    simpa [P] using
      (InnerProductSpace.isSymmetricProjection_rankOne_self
        (𝕜 := Complex) hnorm)
  have hPself : LinearMap.adjoint P = P :=
    (LinearMap.isSymmetric_iff_isSelfAdjoint P).mp hP.isSymmetric
  have hPidemp : P * P = P := hP.isIdempotentElem.eq
  unfold kt19OutputLabelDistribution FiniteInstrument.bornWeight
  rw [FiniteInstrument.branchOperator_apply]
  rw [Fintype.sum_eq_single label]
  · simp only [magicRegisterInstrument, magicRegisterKrausFamily, id_eq, ↓reduceIte]
    change Complex.re (LinearMap.trace Complex (PrimeQuditRegister 11 (Fin 2))
      (P * (rho.toOperator * LinearMap.adjoint P))) =
        Complex.re (LinearMap.trace Complex (PrimeQuditRegister 11 (Fin 2))
          (P * rho.toOperator))
    rw [hPself]
    calc
      Complex.re (LinearMap.trace Complex (PrimeQuditRegister 11 (Fin 2))
          (P * (rho.toOperator * P))) =
          Complex.re (LinearMap.trace Complex (PrimeQuditRegister 11 (Fin 2))
            ((P * rho.toOperator) * P)) := by
              congr 2
      _ = Complex.re (LinearMap.trace Complex (PrimeQuditRegister 11 (Fin 2))
          (P * (P * rho.toOperator))) := by
            rw [LinearMap.trace_mul_comm]
      _ = Complex.re (LinearMap.trace Complex (PrimeQuditRegister 11 (Fin 2))
          (P * rho.toOperator)) := by
            rw [← mul_assoc, hPidemp]
  · intro other hother
    simp [magicRegisterInstrument, magicRegisterKrausFamily, hother]

/-- The trace of a rank-one left projector against an operator is its
corresponding quadratic form. -/
private theorem p11Trace_rankOne_mul
    (u : PrimeQuditRegister 11 (Fin 2))
    (A : Operator (PrimeQuditRegister 11 (Fin 2))) :
    LinearMap.trace Complex (PrimeQuditRegister 11 (Fin 2))
      ((InnerProductSpace.rankOne Complex u u).toLinearMap * A) =
        inner Complex u (A u) := by
  rw [LinearMap.trace_mul_comm]
  have hcomp : A * (InnerProductSpace.rankOne Complex u u).toLinearMap =
      (InnerProductSpace.rankOne Complex (A u) u).toLinearMap := by
    ext vector
    simp [Module.End.mul_eq_comp, LinearMap.comp_apply,
      InnerProductSpace.rankOne_apply]
  rw [hcomp]
  exact InnerProductSpace.trace_rankOne (A u) u

/-- Any nonzero magic-register label is operationally bounded by the trace
distance to the zero-label ideal output. -/
private theorem kt19OutputLabelDistribution_le_traceNorm_sub_ideal_of_ne
    (rho : DensityOperator (PrimeQuditRegister 11 (Fin 2)))
    (label : PrimeQuditRegisterLabel 11 (Fin 2)) (hlabel : label ≠ 0) :
    kt19OutputLabelDistribution rho label ≤
      traceNorm (rho.toOperator -
        (kt19IdealOutput (q := 11) (Logical := Fin 2)).toOperator) := by
  classical
  let P : Operator (PrimeQuditRegister 11 (Fin 2)) :=
    (InnerProductSpace.rankOne Complex (magicRegisterKet 11 label)
      (magicRegisterKet 11 label)).toLinearMap
  have hnorm : ‖magicRegisterKet 11 label‖ = 1 := by
    have hnormSq : ‖magicRegisterKet 11 label‖ ^ 2 = 1 := by
      rw [InnerProductSpace.norm_sq_eq_re_inner (𝕜 := Complex),
        magicRegisterKet_inner_self]
      norm_num
    nlinarith [norm_nonneg (magicRegisterKet 11 label)]
  have hP : P.IsSymmetricProjection := by
    simpa [P] using
      (InnerProductSpace.isSymmetricProjection_rankOne_self
        (𝕜 := Complex) hnorm)
  have hprojector : IsStarProjection P := by
    rw [LinearMap.isStarProjection_iff_isSymmetricProjection]
    exact hP
  have hideal :
      (LinearMap.trace Complex (PrimeQuditRegister 11 (Fin 2))
        (P * (kt19IdealOutput (q := 11) (Logical := Fin 2)).toOperator)).re = 0 := by
    dsimp [P]
    rw [kt19IdealOutput, DensityOperator.pureDensity_toOperator,
      p11Trace_rankOne_mul]
    simp [InnerProductSpace.rankOne_apply, magicRegisterKet_inner,
      hlabel, Ne.symm hlabel]
  have hraw :
      kt19OutputLabelDistribution rho label =
        (LinearMap.trace Complex (PrimeQuditRegister 11 (Fin 2))
          (P * rho.toOperator)).re := by
    simpa [P] using p11OutputLabelDistribution_eq_rankOneTrace rho label
  have hcenter :
      (LinearMap.trace Complex (PrimeQuditRegister 11 (Fin 2))
        (P * rho.toOperator)).re =
        (LinearMap.trace Complex (PrimeQuditRegister 11 (Fin 2))
          (P * (rho.toOperator -
            (kt19IdealOutput (q := 11) (Logical := Fin 2)).toOperator))).re := by
    rw [mul_sub, map_sub, Complex.sub_re, hideal, sub_zero]
  calc
    kt19OutputLabelDistribution rho label =
        (LinearMap.trace Complex (PrimeQuditRegister 11 (Fin 2))
          (P * (rho.toOperator -
            (kt19IdealOutput (q := 11) (Logical := Fin 2)).toOperator))).re := hraw.trans hcenter
    _ ≤ |(LinearMap.trace Complex (PrimeQuditRegister 11 (Fin 2))
          (P * (rho.toOperator -
            (kt19IdealOutput (q := 11) (Logical := Fin 2)).toOperator))).re| := le_abs_self _
    _ ≤ ‖LinearMap.trace Complex (PrimeQuditRegister 11 (Fin 2))
          (P * (rho.toOperator -
            (kt19IdealOutput (q := 11) (Logical := Fin 2)).toOperator))‖ :=
      Complex.abs_re_le_norm _
    _ ≤ traceNorm (P * (rho.toOperator -
          (kt19IdealOutput (q := 11) (Logical := Fin 2)).toOperator)) :=
      norm_trace_le_traceNorm _
    _ ≤ operatorNorm P * traceNorm (rho.toOperator -
          (kt19IdealOutput (q := 11) (Logical := Fin 2)).toOperator) :=
      traceNorm_mul_left_le _ _
    _ ≤ 1 * traceNorm (rho.toOperator -
          (kt19IdealOutput (q := 11) (Logical := Fin 2)).toOperator) := by
      exact mul_le_mul_of_nonneg_right
        (operatorNorm_projection_le P hprojector) (traceNorm_nonneg _)
    _ = traceNorm (rho.toOperator -
          (kt19IdealOutput (q := 11) (Logical := Fin 2)).toOperator) := by ring

/-- A port's nonzero output-label mass is at most the number of complete
magic-register labels times the trace distance to the ideal output. -/
private theorem kt19OutputPortError_le_card_mul_traceNorm_sub_ideal
    (rho : DensityOperator (PrimeQuditRegister 11 (Fin 2))) (port : Fin 2) :
    kt19OutputPortError rho port ≤
      (Fintype.card (PrimeQuditRegisterLabel 11 (Fin 2)) : ℝ) *
        traceNorm (rho.toOperator -
          (kt19IdealOutput (q := 11) (Logical := Fin 2)).toOperator) := by
  classical
  unfold kt19OutputPortError
  calc
    (∑ label : PrimeQuditRegisterLabel 11 (Fin 2),
      if label port = 0 then 0 else kt19OutputLabelDistribution rho label) ≤
        ∑ _label : PrimeQuditRegisterLabel 11 (Fin 2),
          traceNorm (rho.toOperator -
            (kt19IdealOutput (q := 11) (Logical := Fin 2)).toOperator) := by
      apply Finset.sum_le_sum
      intro label _
      by_cases hport : label port = 0
      · simp [hport, traceNorm_nonneg]
      · rw [if_neg hport]
        apply kt19OutputLabelDistribution_le_traceNorm_sub_ideal_of_ne rho label
        intro hzero
        apply hport
        simpa [hzero]
    _ = (Fintype.card (PrimeQuditRegisterLabel 11 (Fin 2)) : ℝ) *
        traceNorm (rho.toOperator -
          (kt19IdealOutput (q := 11) (Logical := Fin 2)).toOperator) := by
      simp

/-- The actual normalized p=11 accepted output differs from the ideal output
by exactly the physically centered residual divided by its measured success
mass. -/
private theorem p11AcceptedOutput_sub_ideal_eq_normalizedResidual
    (mu : ZMod 11 → ℝ) (hmu_nonneg : ∀ a : ZMod 11, 0 ≤ mu a)
    (hmu_sum : ∑ a : ZMod 11, mu a = 1)
    (heps : kt19ErrorRate mu < 1) :
    (kt19Run p11CubicRowFamily mu hmu_nonneg hmu_sum).acceptedOutput.toOperator -
        (kt19IdealOutput (q := 11) (Logical := Fin 2)).toOperator =
      (kt19Success p11CubicRowFamily mu hmu_nonneg hmu_sum : Complex)⁻¹ •
        p11AcceptedResidualDecodedDifference mu := by
  have hsuccess :
      0 < kt19EndpointWeight p11CubicRowFamily mu hmu_nonneg hmu_sum .accepted :=
    kt19AcceptedEndpointWeight_pos_of_errorRate_lt_one
      p11CubicRowFamily mu hmu_nonneg hmu_sum heps
  rw [kt19Run_acceptedOutput,
    kt19EndpointCompletion_eq_conditional_of_pos
      p11CubicRowFamily mu hmu_nonneg hmu_sum .accepted hsuccess]
  dsimp only [kt19EndpointWeight] at hsuccess
  unfold kt19EndpointConditional
  rw [QuantumChannel.mapDensity_toOperator,
    FiniteInstrument.conditionalDensity_toOperator]
  rw [map_smul]
  change
    (kt19Success p11CubicRowFamily mu hmu_nonneg hmu_sum : Complex)⁻¹ •
        kt19DecoderChannel p11CubicRowFamily
          (kt19RawEndpoint p11CubicRowFamily mu hmu_nonneg hmu_sum .accepted) -
      (kt19IdealOutput (q := 11) (Logical := Fin 2)).toOperator = _
  have hrewrite :
      (kt19Success p11CubicRowFamily mu hmu_nonneg hmu_sum : Complex)⁻¹ •
          kt19DecoderChannel p11CubicRowFamily
            (kt19RawEndpoint p11CubicRowFamily mu hmu_nonneg hmu_sum .accepted) -
        (kt19IdealOutput (q := 11) (Logical := Fin 2)).toOperator =
      (kt19Success p11CubicRowFamily mu hmu_nonneg hmu_sum : Complex)⁻¹ •
        p11AcceptedResidualDecodedDifference mu := by
    rw [← p11DecodedRawAcceptedEndpoint_sub_success_ideal_eq_residual
      mu hmu_nonneg hmu_sum]
    have hne : (kt19Success p11CubicRowFamily mu hmu_nonneg hmu_sum : Complex) ≠ 0 := by
      exact_mod_cast (ne_of_gt (kt19Success_pos_of_errorRate_lt_one
        p11CubicRowFamily mu hmu_nonneg hmu_sum heps))
    rw [smul_sub, smul_smul, inv_mul_cancel₀ hne, one_smul]
  exact hrewrite

/-- The actual p=11 accepted output's trace error is controlled by its
normalized finite accepted-error tail. -/
theorem p11AcceptedOutputTraceNorm_sub_ideal_le_two_mul_residualError
    (mu : ZMod 11 → ℝ) (hmu_nonneg : ∀ a : ZMod 11, 0 ≤ mu a)
    (hmu_sum : ∑ a : ZMod 11, mu a = 1)
    (heps : kt19ErrorRate mu < 1) :
    traceNorm ((kt19Run p11CubicRowFamily mu hmu_nonneg hmu_sum).acceptedOutput.toOperator -
      (kt19IdealOutput (q := 11) (Logical := Fin 2)).toOperator) ≤
      2 * p11AcceptedResidualError mu hmu_nonneg hmu_sum := by
  rw [p11AcceptedOutput_sub_ideal_eq_normalizedResidual mu hmu_nonneg hmu_sum heps]
  have hmass := p11AcceptedResidualDecodedDifference_traceNorm_le_two_mul_mass
    mu hmu_nonneg
  have hsuccess : 0 < kt19Success p11CubicRowFamily mu hmu_nonneg hmu_sum :=
    kt19Success_pos_of_errorRate_lt_one p11CubicRowFamily mu hmu_nonneg hmu_sum heps
  simpa [p11AcceptedResidualError] using
    (FiniteDecodedTrace.normalized_residual_traceNorm_le
      (kt19Success p11CubicRowFamily mu hmu_nonneg hmu_sum)
      (p11AcceptedResidualMass mu)
      (p11AcceptedResidualDecodedDifference mu) hsuccess hmass)

/-- The worst p=11 physical magic-register readout error is bounded by the
actual normalized accepted residual. -/
theorem p11OutputWorstPortError_le_two_mul_card_mul_residualError
    (mu : ZMod 11 → ℝ) (hmu_nonneg : ∀ a : ZMod 11, 0 ≤ mu a)
    (hmu_sum : ∑ a : ZMod 11, mu a = 1)
    (heps : kt19ErrorRate mu < 1) :
    kt19OutputWorstPortError
      ((kt19Run p11CubicRowFamily mu hmu_nonneg hmu_sum).acceptedOutput) ≤
      2 * (Fintype.card (PrimeQuditRegisterLabel 11 (Fin 2)) : ℝ) *
        p11AcceptedResidualError mu hmu_nonneg hmu_sum := by
  classical
  unfold kt19OutputWorstPortError
  apply Finset.sup'_le
  intro port _
  calc
    kt19OutputPortError
        ((kt19Run p11CubicRowFamily mu hmu_nonneg hmu_sum).acceptedOutput) port ≤
        (Fintype.card (PrimeQuditRegisterLabel 11 (Fin 2)) : ℝ) *
          traceNorm
            ((kt19Run p11CubicRowFamily mu hmu_nonneg hmu_sum).acceptedOutput.toOperator -
              (kt19IdealOutput (q := 11) (Logical := Fin 2)).toOperator) :=
      kt19OutputPortError_le_card_mul_traceNorm_sub_ideal _ port
    _ ≤ (Fintype.card (PrimeQuditRegisterLabel 11 (Fin 2)) : ℝ) *
          (2 * p11AcceptedResidualError mu hmu_nonneg hmu_sum) :=
      mul_le_mul_of_nonneg_left
        (p11AcceptedOutputTraceNorm_sub_ideal_le_two_mul_residualError
          mu hmu_nonneg hmu_sum heps) (Nat.cast_nonneg _)
    _ = 2 * (Fintype.card (PrimeQuditRegisterLabel 11 (Fin 2)) : ℝ) *
          p11AcceptedResidualError mu hmu_nonneg hmu_sum := by ring

/-- Distance three therefore gives a success-adjusted cubic bound for the
actual p=11 worst-port magic-register readout error. -/
theorem p11OutputWorstPortError_le_two_mul_card_mul_card_errorRate_pow_three_div_success
    (mu : ZMod 11 → ℝ) (hmu_nonneg : ∀ a : ZMod 11, 0 ≤ mu a)
    (hmu_sum : ∑ a : ZMod 11, mu a = 1)
    (heps : kt19ErrorRate mu < 1) :
    kt19OutputWorstPortError
      ((kt19Run p11CubicRowFamily mu hmu_nonneg hmu_sum).acceptedOutput) ≤
      2 * (Fintype.card (PrimeQuditRegisterLabel 11 (Fin 2)) : ℝ) *
        (((Fintype.card (Word (ZMod 11) (KeptPunctureLocation 11 2)) : ℝ) *
          kt19ErrorRate mu ^ 3) /
          kt19Success p11CubicRowFamily mu hmu_nonneg hmu_sum) := by
  calc
    kt19OutputWorstPortError
        ((kt19Run p11CubicRowFamily mu hmu_nonneg hmu_sum).acceptedOutput) ≤
        2 * (Fintype.card (PrimeQuditRegisterLabel 11 (Fin 2)) : ℝ) *
          p11AcceptedResidualError mu hmu_nonneg hmu_sum :=
      p11OutputWorstPortError_le_two_mul_card_mul_residualError
        mu hmu_nonneg hmu_sum heps
    _ ≤ 2 * (Fintype.card (PrimeQuditRegisterLabel 11 (Fin 2)) : ℝ) *
          (((Fintype.card (Word (ZMod 11) (KeptPunctureLocation 11 2)) : ℝ) *
            kt19ErrorRate mu ^ 3) /
            kt19Success p11CubicRowFamily mu hmu_nonneg hmu_sum) := by
      exact mul_le_mul_of_nonneg_left
        (p11AcceptedResidualError_le_card_errorRate_pow_three_div_success
          mu hmu_nonneg hmu_sum heps)
        (mul_nonneg (by norm_num) (Nat.cast_nonneg _))

/-! ## The generic family decoded-output bridge -/

namespace KT19DistillationFamily

variable {p l k : Nat} [NeZero p] [Fact p.Prime]

/-- The normalized accepted output of the actual family run is exactly the
success-normalized finite IID mixture of the magic-register words selected by
`kt19Routing`. -/
theorem acceptedOutput_toOperator_eq_routed_sum
    (family : KT19DistillationFamily p l k)
    (mu : ZMod p → ℝ) (hmu_nonneg : ∀ a : ZMod p, 0 ≤ mu a)
    (hmu_sum : ∑ a : ZMod p, mu a = 1)
    (heps : kt19ErrorRate mu < 1) :
    (run family mu hmu_nonneg hmu_sum).acceptedOutput.toOperator =
      (kt19Success family.rowFamily mu hmu_nonneg hmu_sum : Complex)⁻¹ •
        ∑ error : Word (ZMod p) (KeptPunctureLocation p k),
          if kt19AcceptedWord family.rowFamily error then
            (wordProbability p mu error : Complex) •
              (DensityOperator.pureDensity
                (magicRegisterKet p (kt19Routing family error)) (by
                  rw [InnerProductSpace.norm_sq_eq_re_inner (𝕜 := Complex),
                    magicRegisterKet_inner_self]
                  norm_num)).toOperator
          else 0 := by
  have hsuccess :
      0 < kt19EndpointWeight family.rowFamily mu hmu_nonneg hmu_sum .accepted :=
    kt19AcceptedEndpointWeight_pos_of_errorRate_lt_one
      family.rowFamily mu hmu_nonneg hmu_sum heps
  change (kt19Run family.rowFamily mu hmu_nonneg hmu_sum).acceptedOutput.toOperator = _
  rw [kt19Run_acceptedOutput,
    kt19EndpointCompletion_eq_conditional_of_pos
      family.rowFamily mu hmu_nonneg hmu_sum .accepted hsuccess]
  dsimp only [kt19EndpointWeight] at hsuccess
  unfold kt19EndpointConditional
  rw [QuantumChannel.mapDensity_toOperator,
    FiniteInstrument.conditionalDensity_toOperator, map_smul]
  change (kt19Success family.rowFamily mu hmu_nonneg hmu_sum : Complex)⁻¹ •
      kt19DecoderChannel family.rowFamily
        (kt19RawEndpoint family.rowFamily mu hmu_nonneg hmu_sum .accepted) = _
  rw [kt19DecodedRawAcceptedEndpoint_eq_routedMagic_sum
    family.rowFamily mu hmu_nonneg hmu_sum]
  rfl

/-- The decoded contribution of accepted nonzero family words, centered at
the actual decoded zero-word ideal. -/
private noncomputable def acceptedResidualDecodedDifference
    (family : KT19DistillationFamily p l k)
    (mu : ZMod p → ℝ) : Operator (PrimeQuditRegister p (Fin k)) :=
  ∑ error : Word (ZMod p) (KeptPunctureLocation p k),
    if kt19AcceptedWord family.rowFamily error ∧ error ≠ 0 then
      (wordProbability p mu error : Complex) •
        (kt19AcceptedDecodedBranch family.rowFamily error -
          (kt19IdealOutput (q := p) (Logical := Fin k)).toOperator)
    else 0

/-- The physical decoded accepted endpoint differs from its actual success
multiple of the ideal output by exactly the family nonzero-word residual. -/
private theorem decodedRawAcceptedEndpoint_sub_success_ideal_eq_residual
    (family : KT19DistillationFamily p l k)
    (mu : ZMod p → ℝ) (hmu_nonneg : ∀ a : ZMod p, 0 ≤ mu a)
    (hmu_sum : ∑ a : ZMod p, mu a = 1) :
    kt19DecoderChannel family.rowFamily
        (kt19RawEndpoint family.rowFamily mu hmu_nonneg hmu_sum .accepted) -
      (kt19Success family.rowFamily mu hmu_nonneg hmu_sum : Complex) •
        (kt19IdealOutput (q := p) (Logical := Fin k)).toOperator =
      acceptedResidualDecodedDifference family mu := by
  rw [kt19DecodedRawAcceptedEndpoint_eq_acceptedWord_sum family.rowFamily
      mu hmu_nonneg hmu_sum,
    kt19Success_cast_eq_acceptedWord_sum family.rowFamily mu hmu_nonneg hmu_sum]
  unfold acceptedResidualDecodedDifference
  exact FiniteCentering.finset_centered_sum_eq_nonzero_residual
    (Finset.univ : Finset (Word (ZMod p) (KeptPunctureLocation p k)))
    (fun error => (wordProbability p mu error : Complex))
    (kt19AcceptedWord family.rowFamily)
    (kt19AcceptedDecodedBranch family.rowFamily)
    0
    (kt19IdealOutput (q := p) (Logical := Fin k)).toOperator
    (kt19AcceptedDecodedBranch_zero_eq_ideal family.rowFamily)

/-- Before normalization, the trace norm of the decoded family residual is at
most twice its literal accepted nonzero-word mass. -/
private theorem acceptedResidualDecodedDifference_traceNorm_le_two_mul_mass
    (family : KT19DistillationFamily p l k)
    (mu : ZMod p → ℝ) (hmu_nonneg : ∀ a : ZMod p, 0 ≤ mu a) :
    traceNorm (acceptedResidualDecodedDifference family mu) ≤
      2 * acceptedResidualMass family mu := by
  unfold acceptedResidualDecodedDifference
  calc
    traceNorm (∑ error : Word (ZMod p) (KeptPunctureLocation p k),
        if kt19AcceptedWord family.rowFamily error ∧ error ≠ 0 then
          (wordProbability p mu error : Complex) •
            (kt19AcceptedDecodedBranch family.rowFamily error -
              (kt19IdealOutput (q := p) (Logical := Fin k)).toOperator)
        else 0) ≤
        ∑ error : Word (ZMod p) (KeptPunctureLocation p k),
          if kt19AcceptedWord family.rowFamily error ∧ error ≠ 0 then
            2 * wordProbability p mu error
          else 0 := by
      simpa using
        (FiniteDecodedTrace.finset_weighted_residual_traceNorm_le_two_mul_mass
          (Finset.univ : Finset (Word (ZMod p) (KeptPunctureLocation p k)))
          (wordProbability p mu)
          (fun error => kt19AcceptedWord family.rowFamily error ∧ error ≠ 0)
          (kt19AcceptedDecodedBranch family.rowFamily)
          (kt19IdealOutput (q := p) (Logical := Fin k)).toOperator
          (fun error => wordProbability_nonneg p mu hmu_nonneg error)
          (fun error =>
            kt19AcceptedDecodedBranch_traceNorm_sub_ideal_le_two
              family.rowFamily error))
    _ = 2 * acceptedResidualMass family mu := by
      unfold acceptedResidualMass
      calc
        (∑ error : Word (ZMod p) (KeptPunctureLocation p k),
            if kt19AcceptedWord family.rowFamily error ∧ error ≠ 0 then
              2 * wordProbability p mu error
            else 0) =
            ∑ error : Word (ZMod p) (KeptPunctureLocation p k),
              2 * (if kt19AcceptedWord family.rowFamily error ∧ error ≠ 0 then
                wordProbability p mu error
              else 0) := by
          apply Finset.sum_congr rfl
          intro error _
          by_cases hresidual : kt19AcceptedWord family.rowFamily error ∧ error ≠ 0 <;>
            simp [hresidual]
        _ = 2 * ∑ error : Word (ZMod p) (KeptPunctureLocation p k),
            if kt19AcceptedWord family.rowFamily error ∧ error ≠ 0 then
              wordProbability p mu error
            else 0 := by
          rw [← Finset.mul_sum]

omit [Fact p.Prime] in
/-- One complete generic-family magic-register readout weight is the trace
of its actual rank-one label projector. -/
private theorem outputLabelDistribution_eq_rankOneTrace
    (rho : DensityOperator (PrimeQuditRegister p (Fin k)))
    (label : PrimeQuditRegisterLabel p (Fin k)) :
    kt19OutputLabelDistribution rho label =
      (LinearMap.trace Complex (PrimeQuditRegister p (Fin k))
        ((InnerProductSpace.rankOne Complex (magicRegisterKet p label)
          (magicRegisterKet p label)).toLinearMap * rho.toOperator)).re := by
  classical
  let P : Operator (PrimeQuditRegister p (Fin k)) :=
    (InnerProductSpace.rankOne Complex (magicRegisterKet p label)
      (magicRegisterKet p label)).toLinearMap
  have hnorm : ‖magicRegisterKet p label‖ = 1 := by
    have hnormSq : ‖magicRegisterKet p label‖ ^ 2 = 1 := by
      rw [InnerProductSpace.norm_sq_eq_re_inner (𝕜 := Complex),
        magicRegisterKet_inner_self]
      norm_num
    nlinarith [norm_nonneg (magicRegisterKet p label)]
  have hP : P.IsSymmetricProjection := by
    simpa [P] using
      (InnerProductSpace.isSymmetricProjection_rankOne_self
        (𝕜 := Complex) hnorm)
  have hPself : LinearMap.adjoint P = P :=
    (LinearMap.isSymmetric_iff_isSelfAdjoint P).mp hP.isSymmetric
  have hPidemp : P * P = P := hP.isIdempotentElem.eq
  unfold kt19OutputLabelDistribution FiniteInstrument.bornWeight
  rw [FiniteInstrument.branchOperator_apply]
  rw [Fintype.sum_eq_single label]
  · simp only [magicRegisterInstrument, magicRegisterKrausFamily, id_eq, ↓reduceIte]
    change Complex.re (LinearMap.trace Complex (PrimeQuditRegister p (Fin k))
      (P * (rho.toOperator * LinearMap.adjoint P))) =
        Complex.re (LinearMap.trace Complex (PrimeQuditRegister p (Fin k))
          (P * rho.toOperator))
    rw [hPself]
    calc
      Complex.re (LinearMap.trace Complex (PrimeQuditRegister p (Fin k))
          (P * (rho.toOperator * P))) =
          Complex.re (LinearMap.trace Complex (PrimeQuditRegister p (Fin k))
            ((P * rho.toOperator) * P)) := by
              congr 2
      _ = Complex.re (LinearMap.trace Complex (PrimeQuditRegister p (Fin k))
          (P * (P * rho.toOperator))) := by
            rw [LinearMap.trace_mul_comm]
      _ = Complex.re (LinearMap.trace Complex (PrimeQuditRegister p (Fin k))
          (P * rho.toOperator)) := by
            rw [← mul_assoc, hPidemp]
  · intro other hother
    simp [magicRegisterInstrument, magicRegisterKrausFamily, hother]

omit [Fact p.Prime] in
/-- The trace of a rank-one left projector against an operator is its
corresponding quadratic form. -/
private theorem trace_rankOne_mul
    (u : PrimeQuditRegister p (Fin k))
    (A : Operator (PrimeQuditRegister p (Fin k))) :
    LinearMap.trace Complex (PrimeQuditRegister p (Fin k))
      ((InnerProductSpace.rankOne Complex u u).toLinearMap * A) =
        inner Complex u (A u) := by
  rw [LinearMap.trace_mul_comm]
  have hcomp : A * (InnerProductSpace.rankOne Complex u u).toLinearMap =
      (InnerProductSpace.rankOne Complex (A u) u).toLinearMap := by
    ext vector
    simp [Module.End.mul_eq_comp, LinearMap.comp_apply,
      InnerProductSpace.rankOne_apply]
  rw [hcomp]
  exact InnerProductSpace.trace_rankOne (A u) u

/-- A magic-register basis projector reads one pure routed magic word with
Kronecker-delta weight. -/
private theorem trace_magicProjector_mul_pureMagic
    (observed routed : PrimeQuditRegisterLabel p (Fin k)) :
    LinearMap.trace Complex (PrimeQuditRegister p (Fin k))
      ((InnerProductSpace.rankOne Complex (magicRegisterKet p observed)
          (magicRegisterKet p observed)).toLinearMap *
        (DensityOperator.pureDensity (magicRegisterKet p routed) (by
          rw [InnerProductSpace.norm_sq_eq_re_inner (𝕜 := Complex),
            magicRegisterKet_inner_self]
          norm_num)).toOperator) =
      if observed = routed then 1 else 0 := by
  rw [DensityOperator.pureDensity_toOperator, trace_rankOne_mul]
  by_cases hroute : observed = routed
  · subst routed
    have hnorm : ‖magicRegisterKet p observed‖ = 1 := by
      have hnormSq : ‖magicRegisterKet p observed‖ ^ 2 = 1 := by
        rw [InnerProductSpace.norm_sq_eq_re_inner (𝕜 := Complex),
          magicRegisterKet_inner_self]
        norm_num
      nlinarith [norm_nonneg (magicRegisterKet p observed)]
    simp [InnerProductSpace.rankOne_apply, hnorm]
  · have hroute' : routed ≠ observed := Ne.symm hroute
    simp [hroute, hroute', InnerProductSpace.rankOne_apply,
      magicRegisterKet_inner]

/-- The unnormalized IID mass of accepted physical words routed to one exact
logical magic-register label. -/
noncomputable def routedAcceptedMass
    (family : KT19DistillationFamily p l k)
    (mu : ZMod p → ℝ) (label : PrimeQuditRegisterLabel p (Fin k)) : ℝ :=
  ∑ error : Word (ZMod p) (KeptPunctureLocation p k),
    if kt19AcceptedWord family.rowFamily error ∧
        label = kt19Routing family error then
      wordProbability p mu error
    else 0

/-- Projecting the unnormalized routed output sum onto one magic label gives
exactly its routed accepted IID mass. -/
private theorem trace_magicProjector_mul_routed_sum
    (family : KT19DistillationFamily p l k)
    (mu : ZMod p → ℝ) (label : PrimeQuditRegisterLabel p (Fin k)) :
    LinearMap.trace Complex (PrimeQuditRegister p (Fin k))
      ((InnerProductSpace.rankOne Complex (magicRegisterKet p label)
          (magicRegisterKet p label)).toLinearMap *
        (∑ error : Word (ZMod p) (KeptPunctureLocation p k),
          if kt19AcceptedWord family.rowFamily error then
            (wordProbability p mu error : Complex) •
              (DensityOperator.pureDensity
                (magicRegisterKet p (kt19Routing family error)) (by
                  rw [InnerProductSpace.norm_sq_eq_re_inner (𝕜 := Complex),
                    magicRegisterKet_inner_self]
                  norm_num)).toOperator
          else 0)) =
      (routedAcceptedMass family mu label : Complex) := by
  classical
  rw [Finset.mul_sum, map_sum, routedAcceptedMass, Complex.ofReal_sum]
  apply Finset.sum_congr rfl
  intro error _
  by_cases haccepted : kt19AcceptedWord family.rowFamily error
  · by_cases hrouted : label = kt19Routing family error
    · simp only [haccepted, hrouted, and_self, if_true]
      rw [Algebra.mul_smul_comm, map_smul,
        trace_magicProjector_mul_pureMagic]
      simp
    · simp only [haccepted, true_and, if_true, hrouted, if_false]
      rw [Algebra.mul_smul_comm, map_smul,
        trace_magicProjector_mul_pureMagic]
      simp [hrouted]
  · simp [haccepted]

/-- Measuring the actual normalized accepted output in the complete logical
magic basis gives precisely the accepted IID mass routed to that label,
divided by the physical success probability. -/
theorem outputLabelDistribution_eq_routedMass_div_success
    (family : KT19DistillationFamily p l k)
    (mu : ZMod p → ℝ) (hmu_nonneg : ∀ a : ZMod p, 0 ≤ mu a)
    (hmu_sum : ∑ a : ZMod p, mu a = 1)
    (heps : kt19ErrorRate mu < 1)
    (label : PrimeQuditRegisterLabel p (Fin k)) :
    kt19OutputLabelDistribution
        (run family mu hmu_nonneg hmu_sum).acceptedOutput label =
      routedAcceptedMass family mu label /
        kt19Success family.rowFamily mu hmu_nonneg hmu_sum := by
  classical
  let P : Operator (PrimeQuditRegister p (Fin k)) :=
    (InnerProductSpace.rankOne Complex (magicRegisterKet p label)
      (magicRegisterKet p label)).toLinearMap
  have htrace :
      LinearMap.trace Complex (PrimeQuditRegister p (Fin k))
        (P * (run family mu hmu_nonneg hmu_sum).acceptedOutput.toOperator) =
          ((routedAcceptedMass family mu label /
            kt19Success family.rowFamily mu hmu_nonneg hmu_sum : Real) : Complex) := by
    rw [acceptedOutput_toOperator_eq_routed_sum
      family mu hmu_nonneg hmu_sum heps]
    rw [Algebra.mul_smul_comm, map_smul]
    change (kt19Success family.rowFamily mu hmu_nonneg hmu_sum : Complex)⁻¹ *
        LinearMap.trace Complex (PrimeQuditRegister p (Fin k))
          ((InnerProductSpace.rankOne Complex (magicRegisterKet p label)
              (magicRegisterKet p label)).toLinearMap *
            (∑ error : Word (ZMod p) (KeptPunctureLocation p k),
              if kt19AcceptedWord family.rowFamily error then
                (wordProbability p mu error : Complex) •
                  (DensityOperator.pureDensity
                    (magicRegisterKet p (kt19Routing family error)) (by
                      rw [InnerProductSpace.norm_sq_eq_re_inner (𝕜 := Complex),
                        magicRegisterKet_inner_self]
                      norm_num)).toOperator
              else 0)) = _
    rw [trace_magicProjector_mul_routed_sum]
    rw [Complex.ofReal_div, div_eq_mul_inv]
    ring
  rw [outputLabelDistribution_eq_rankOneTrace]
  change (LinearMap.trace Complex (PrimeQuditRegister p (Fin k))
    (P * (run family mu hmu_nonneg hmu_sum).acceptedOutput.toOperator)).re = _
  rw [htrace]
  simp

/-- Any nonzero generic-family magic-register label is operationally bounded
by the trace distance to the actual zero-label ideal output. -/
private theorem outputLabelDistribution_le_traceNorm_sub_ideal_of_ne
    (rho : DensityOperator (PrimeQuditRegister p (Fin k)))
    (label : PrimeQuditRegisterLabel p (Fin k)) (hlabel : label ≠ 0) :
    kt19OutputLabelDistribution rho label ≤
      traceNorm (rho.toOperator -
        (kt19IdealOutput (q := p) (Logical := Fin k)).toOperator) := by
  classical
  let P : Operator (PrimeQuditRegister p (Fin k)) :=
    (InnerProductSpace.rankOne Complex (magicRegisterKet p label)
      (magicRegisterKet p label)).toLinearMap
  have hnorm : ‖magicRegisterKet p label‖ = 1 := by
    have hnormSq : ‖magicRegisterKet p label‖ ^ 2 = 1 := by
      rw [InnerProductSpace.norm_sq_eq_re_inner (𝕜 := Complex),
        magicRegisterKet_inner_self]
      norm_num
    nlinarith [norm_nonneg (magicRegisterKet p label)]
  have hP : P.IsSymmetricProjection := by
    simpa [P] using
      (InnerProductSpace.isSymmetricProjection_rankOne_self
        (𝕜 := Complex) hnorm)
  have hprojector : IsStarProjection P := by
    rw [LinearMap.isStarProjection_iff_isSymmetricProjection]
    exact hP
  have hideal :
      (LinearMap.trace Complex (PrimeQuditRegister p (Fin k))
        (P * (kt19IdealOutput (q := p) (Logical := Fin k)).toOperator)).re = 0 := by
    dsimp [P]
    rw [kt19IdealOutput, DensityOperator.pureDensity_toOperator,
      trace_rankOne_mul]
    simp [InnerProductSpace.rankOne_apply, magicRegisterKet_inner,
      Ne.symm hlabel]
  have hraw :
      kt19OutputLabelDistribution rho label =
        (LinearMap.trace Complex (PrimeQuditRegister p (Fin k))
          (P * rho.toOperator)).re := by
    simpa [P] using outputLabelDistribution_eq_rankOneTrace rho label
  have hcenter :
      (LinearMap.trace Complex (PrimeQuditRegister p (Fin k))
        (P * rho.toOperator)).re =
        (LinearMap.trace Complex (PrimeQuditRegister p (Fin k))
          (P * (rho.toOperator -
            (kt19IdealOutput (q := p) (Logical := Fin k)).toOperator))).re := by
    rw [mul_sub, map_sub, Complex.sub_re, hideal, sub_zero]
  calc
    kt19OutputLabelDistribution rho label =
        (LinearMap.trace Complex (PrimeQuditRegister p (Fin k))
          (P * (rho.toOperator -
            (kt19IdealOutput (q := p) (Logical := Fin k)).toOperator))).re := hraw.trans hcenter
    _ ≤ |(LinearMap.trace Complex (PrimeQuditRegister p (Fin k))
          (P * (rho.toOperator -
            (kt19IdealOutput (q := p) (Logical := Fin k)).toOperator))).re| := le_abs_self _
    _ ≤ ‖LinearMap.trace Complex (PrimeQuditRegister p (Fin k))
          (P * (rho.toOperator -
            (kt19IdealOutput (q := p) (Logical := Fin k)).toOperator))‖ :=
      Complex.abs_re_le_norm _
    _ ≤ traceNorm (P * (rho.toOperator -
          (kt19IdealOutput (q := p) (Logical := Fin k)).toOperator)) :=
      norm_trace_le_traceNorm _
    _ ≤ operatorNorm P * traceNorm (rho.toOperator -
          (kt19IdealOutput (q := p) (Logical := Fin k)).toOperator) :=
      traceNorm_mul_left_le _ _
    _ ≤ 1 * traceNorm (rho.toOperator -
          (kt19IdealOutput (q := p) (Logical := Fin k)).toOperator) := by
      exact mul_le_mul_of_nonneg_right
        (operatorNorm_projection_le P hprojector) (traceNorm_nonneg _)
    _ = traceNorm (rho.toOperator -
          (kt19IdealOutput (q := p) (Logical := Fin k)).toOperator) := by ring

/-- A family output port's nonzero magic-label mass is at most the complete
readout-label count times the trace distance to the physical ideal output. -/
private theorem outputPortError_le_card_mul_traceNorm_sub_ideal
    (rho : DensityOperator (PrimeQuditRegister p (Fin k))) (port : Fin k) :
    kt19OutputPortError rho port ≤
      (Fintype.card (PrimeQuditRegisterLabel p (Fin k)) : ℝ) *
        traceNorm (rho.toOperator -
          (kt19IdealOutput (q := p) (Logical := Fin k)).toOperator) := by
  classical
  unfold kt19OutputPortError
  calc
    (∑ label : PrimeQuditRegisterLabel p (Fin k),
      if label port = 0 then 0 else kt19OutputLabelDistribution rho label) ≤
        ∑ _label : PrimeQuditRegisterLabel p (Fin k),
          traceNorm (rho.toOperator -
            (kt19IdealOutput (q := p) (Logical := Fin k)).toOperator) := by
      apply Finset.sum_le_sum
      intro label _
      by_cases hport : label port = 0
      · simp [hport, traceNorm_nonneg]
      · rw [if_neg hport]
        apply outputLabelDistribution_le_traceNorm_sub_ideal_of_ne rho label
        intro hzero
        apply hport
        simp [hzero]
    _ = (Fintype.card (PrimeQuditRegisterLabel p (Fin k)) : ℝ) *
        traceNorm (rho.toOperator -
          (kt19IdealOutput (q := p) (Logical := Fin k)).toOperator) := by
      simp

/-- The normalized family accepted output differs from the ideal output by
exactly the physically centered residual divided by its measured success
mass. -/
private theorem acceptedOutput_sub_ideal_eq_normalizedResidual
    (family : KT19DistillationFamily p l k)
    (mu : ZMod p → ℝ) (hmu_nonneg : ∀ a : ZMod p, 0 ≤ mu a)
    (hmu_sum : ∑ a : ZMod p, mu a = 1)
    (heps : kt19ErrorRate mu < 1) :
    (kt19Run family.rowFamily mu hmu_nonneg hmu_sum).acceptedOutput.toOperator -
        (kt19IdealOutput (q := p) (Logical := Fin k)).toOperator =
      (kt19Success family.rowFamily mu hmu_nonneg hmu_sum : Complex)⁻¹ •
        acceptedResidualDecodedDifference family mu := by
  have hsuccess :
      0 < kt19EndpointWeight family.rowFamily mu hmu_nonneg hmu_sum .accepted :=
    kt19AcceptedEndpointWeight_pos_of_errorRate_lt_one
      family.rowFamily mu hmu_nonneg hmu_sum heps
  rw [kt19Run_acceptedOutput,
    kt19EndpointCompletion_eq_conditional_of_pos
      family.rowFamily mu hmu_nonneg hmu_sum .accepted hsuccess]
  dsimp only [kt19EndpointWeight] at hsuccess
  unfold kt19EndpointConditional
  rw [QuantumChannel.mapDensity_toOperator,
    FiniteInstrument.conditionalDensity_toOperator]
  rw [map_smul]
  change
    (kt19Success family.rowFamily mu hmu_nonneg hmu_sum : Complex)⁻¹ •
        kt19DecoderChannel family.rowFamily
          (kt19RawEndpoint family.rowFamily mu hmu_nonneg hmu_sum .accepted) -
      (kt19IdealOutput (q := p) (Logical := Fin k)).toOperator = _
  rw [← decodedRawAcceptedEndpoint_sub_success_ideal_eq_residual
    family mu hmu_nonneg hmu_sum]
  have hne : (kt19Success family.rowFamily mu hmu_nonneg hmu_sum : Complex) ≠ 0 := by
    exact_mod_cast (ne_of_gt (success_pos_of_errorRate_lt_one
      family mu hmu_nonneg hmu_sum heps))
  rw [smul_sub, smul_smul, inv_mul_cancel₀ hne, one_smul]

/-- The actual family accepted output's trace error is controlled by its
normalized finite accepted-error tail. -/
private theorem acceptedOutputTraceNorm_sub_ideal_le_two_mul_residualError
    (family : KT19DistillationFamily p l k)
    (mu : ZMod p → ℝ) (hmu_nonneg : ∀ a : ZMod p, 0 ≤ mu a)
    (hmu_sum : ∑ a : ZMod p, mu a = 1)
    (heps : kt19ErrorRate mu < 1) :
    traceNorm ((kt19Run family.rowFamily mu hmu_nonneg hmu_sum).acceptedOutput.toOperator -
      (kt19IdealOutput (q := p) (Logical := Fin k)).toOperator) ≤
      2 * acceptedResidualError family mu hmu_nonneg hmu_sum := by
  rw [acceptedOutput_sub_ideal_eq_normalizedResidual family mu hmu_nonneg hmu_sum heps]
  have hmass := acceptedResidualDecodedDifference_traceNorm_le_two_mul_mass
    family mu hmu_nonneg
  have hsuccess : 0 < kt19Success family.rowFamily mu hmu_nonneg hmu_sum :=
    success_pos_of_errorRate_lt_one family mu hmu_nonneg hmu_sum heps
  simpa [acceptedResidualError] using
    (FiniteDecodedTrace.normalized_residual_traceNorm_le
      (kt19Success family.rowFamily mu hmu_nonneg hmu_sum)
      (acceptedResidualMass family mu)
      (acceptedResidualDecodedDifference family mu) hsuccess hmass)

/-- The family member's actual worst-port physical magic-register readout
error is bounded by its normalized finite accepted residual. -/
private theorem outputWorstPortError_le_two_mul_card_mul_residualError
    (family : KT19DistillationFamily p l k)
    (mu : ZMod p → ℝ) (hmu_nonneg : ∀ a : ZMod p, 0 ≤ mu a)
    (hmu_sum : ∑ a : ZMod p, mu a = 1)
    (heps : kt19ErrorRate mu < 1) :
    outputWorstPortError family mu hmu_nonneg hmu_sum ≤
      2 * (Fintype.card (PrimeQuditRegisterLabel p (Fin k)) : ℝ) *
        acceptedResidualError family mu hmu_nonneg hmu_sum := by
  classical
  letI : Nonempty (Fin k) := outputPort_nonempty family
  change kt19OutputWorstPortError
      ((kt19Run family.rowFamily mu hmu_nonneg hmu_sum).acceptedOutput) ≤ _
  unfold kt19OutputWorstPortError
  apply Finset.sup'_le
  intro port _
  calc
    kt19OutputPortError
        ((kt19Run family.rowFamily mu hmu_nonneg hmu_sum).acceptedOutput) port ≤
        (Fintype.card (PrimeQuditRegisterLabel p (Fin k)) : ℝ) *
          traceNorm
            ((kt19Run family.rowFamily mu hmu_nonneg hmu_sum).acceptedOutput.toOperator -
              (kt19IdealOutput (q := p) (Logical := Fin k)).toOperator) :=
      outputPortError_le_card_mul_traceNorm_sub_ideal _ port
    _ ≤ (Fintype.card (PrimeQuditRegisterLabel p (Fin k)) : ℝ) *
          (2 * acceptedResidualError family mu hmu_nonneg hmu_sum) :=
      mul_le_mul_of_nonneg_left
        (acceptedOutputTraceNorm_sub_ideal_le_two_mul_residualError
          family mu hmu_nonneg hmu_sum heps) (Nat.cast_nonneg _)
    _ = 2 * (Fintype.card (PrimeQuditRegisterLabel p (Fin k)) : ℝ) *
          acceptedResidualError family mu hmu_nonneg hmu_sum := by ring

/-- The actual family output error obeys a success-adjusted exact-distance
IID recurrence, derived from its physical measurement, decoder, readout, and
finite accepted-word support. -/
theorem outputWorstPortError_le_two_mul_card_mul_card_errorRate_pow_exactDistance_div_success
    (family : KT19DistillationFamily p l k)
    (mu : ZMod p → ℝ) (hmu_nonneg : ∀ a : ZMod p, 0 ≤ mu a)
    (hmu_sum : ∑ a : ZMod p, mu a = 1)
    (heps : kt19ErrorRate mu < 1) :
    outputWorstPortError family mu hmu_nonneg hmu_sum ≤
      2 * (Fintype.card (PrimeQuditRegisterLabel p (Fin k)) : ℝ) *
        (((Fintype.card (Word (ZMod p) (KeptPunctureLocation p k)) : ℝ) *
          kt19ErrorRate mu ^ (l + 1 - k)) /
          kt19Success family.rowFamily mu hmu_nonneg hmu_sum) := by
  calc
    outputWorstPortError family mu hmu_nonneg hmu_sum ≤
        2 * (Fintype.card (PrimeQuditRegisterLabel p (Fin k)) : ℝ) *
          acceptedResidualError family mu hmu_nonneg hmu_sum :=
      outputWorstPortError_le_two_mul_card_mul_residualError
        family mu hmu_nonneg hmu_sum heps
    _ ≤ 2 * (Fintype.card (PrimeQuditRegisterLabel p (Fin k)) : ℝ) *
          (((Fintype.card (Word (ZMod p) (KeptPunctureLocation p k)) : ℝ) *
            kt19ErrorRate mu ^ (l + 1 - k)) /
            kt19Success family.rowFamily mu hmu_nonneg hmu_sum) := by
      exact mul_le_mul_of_nonneg_left
        (acceptedResidualError_le_card_errorRate_pow_exactDistance_div_success
          family mu hmu_nonneg hmu_sum heps)
        (mul_nonneg (by norm_num) (Nat.cast_nonneg _))

/-- The explicit one-block constant in the small-error KT19 recurrence.  Its
two factors of two come respectively from physical magic-basis readout and
from the lower bound `Pₛ ≥ 1/2` on the stated small-noise domain. -/
noncomputable def smallErrorRecurrenceConstant
    (_family : KT19DistillationFamily p l k) : ℝ :=
  4 * (Fintype.card (PrimeQuditRegisterLabel p (Fin k)) : ℝ) *
    (Fintype.card (Word (ZMod p) (KeptPunctureLocation p k)) : ℝ)

/-- On the explicit domain `(p-k) ε ≤ 1/2`, the actual physical output error
obeys the denominator-free recurrence required for iteration:
`ε_out ≤ C(p,l,k) ε^(l+1-k)`.  The success lower bound is derived from the
literal all-zero IID word and Bernoulli's inequality. -/
theorem outputWorstPortError_le_smallErrorRecurrence
    (family : KT19DistillationFamily p l k)
    (mu : ZMod p → ℝ) (hmu_nonneg : ∀ a : ZMod p, 0 ≤ mu a)
    (hmu_sum : ∑ a : ZMod p, mu a = 1)
    (hsmall : ((p - k : Nat) : ℝ) * kt19ErrorRate mu ≤ 1 / 2) :
    outputWorstPortError family mu hmu_nonneg hmu_sum ≤
      smallErrorRecurrenceConstant family *
        kt19ErrorRate mu ^ (l + 1 - k) := by
  have heps_nonneg : 0 ≤ kt19ErrorRate mu :=
    kt19ErrorRate_nonneg mu hmu_nonneg hmu_sum
  have heps_le_one : kt19ErrorRate mu ≤ 1 :=
    kt19ErrorRate_le_one mu hmu_nonneg
  rcases family.admissible with ⟨_, _, hkl, _, hthree⟩
  have hkp : k < p := by
    have hp5 : 5 ≤ p := family.primeAtLeastFive.five_le
    omega
  have hcount_pos : 0 < p - k := Nat.sub_pos_of_lt hkp
  have hcount_one : (1 : ℝ) ≤ ((p - k : Nat) : ℝ) := by
    exact_mod_cast hcount_pos
  have heps : kt19ErrorRate mu < 1 := by
    by_contra hnot
    have heps_one : 1 ≤ kt19ErrorRate mu := le_of_not_gt hnot
    have hone_le_product :
        (1 : ℝ) ≤ ((p - k : Nat) : ℝ) * kt19ErrorRate mu := by
      nlinarith [mul_nonneg (sub_nonneg.mpr hcount_one)
        (sub_nonneg.mpr heps_one)]
    linarith
  have hbernoulli :
      1 - ((p - k : Nat) : ℝ) * kt19ErrorRate mu ≤
        (1 - kt19ErrorRate mu) ^ (p - k) := by
    calc
      1 - ((p - k : Nat) : ℝ) * kt19ErrorRate mu =
          1 + ((p - k : Nat) : ℝ) *
            ((1 - kt19ErrorRate mu) - 1) := by ring
      _ ≤ (1 - kt19ErrorRate mu) ^ (p - k) :=
        one_add_mul_sub_le_pow (a := 1 - kt19ErrorRate mu) (by linarith) (p - k)
  have hsuccess_half :
      (1 / 2 : ℝ) ≤ kt19Success family.rowFamily mu hmu_nonneg hmu_sum :=
    calc
      (1 / 2 : ℝ) ≤ 1 - ((p - k : Nat) : ℝ) * kt19ErrorRate mu := by
        linarith
      _ ≤ (1 - kt19ErrorRate mu) ^ (p - k) := hbernoulli
      _ ≤ kt19Success family.rowFamily mu hmu_nonneg hmu_sum :=
        success_ge_one_sub_errorRate_pow family mu hmu_nonneg hmu_sum
  have hsuccess_pos :
      0 < kt19Success family.rowFamily mu hmu_nonneg hmu_sum := by
    linarith
  let tail : ℝ :=
    (Fintype.card (Word (ZMod p) (KeptPunctureLocation p k)) : ℝ) *
      kt19ErrorRate mu ^ (l + 1 - k)
  have htail_nonneg : 0 ≤ tail := by
    dsimp only [tail]
    exact mul_nonneg (Nat.cast_nonneg _) (pow_nonneg heps_nonneg _)
  have htail_div :
      tail / kt19Success family.rowFamily mu hmu_nonneg hmu_sum ≤ 2 * tail := by
    rw [div_le_iff₀ hsuccess_pos]
    have hmul := mul_le_mul_of_nonneg_left hsuccess_half htail_nonneg
    nlinarith
  calc
    outputWorstPortError family mu hmu_nonneg hmu_sum ≤
        2 * (Fintype.card (PrimeQuditRegisterLabel p (Fin k)) : ℝ) *
          (tail / kt19Success family.rowFamily mu hmu_nonneg hmu_sum) := by
      simpa only [tail] using
        (outputWorstPortError_le_two_mul_card_mul_card_errorRate_pow_exactDistance_div_success
          family mu hmu_nonneg hmu_sum heps)
    _ ≤ 2 * (Fintype.card (PrimeQuditRegisterLabel p (Fin k)) : ℝ) *
          (2 * tail) :=
      mul_le_mul_of_nonneg_left htail_div
        (mul_nonneg (by norm_num) (Nat.cast_nonneg _))
    _ = smallErrorRecurrenceConstant family *
          kt19ErrorRate mu ^ (l + 1 - k) := by
      simp only [smallErrorRecurrenceConstant, tail]
      ring

end KT19DistillationFamily

/-- The accepted observed mass of the complete physical instrument cannot
exceed one. -/
theorem kt19Success_le_one
    (R : CubicRowFamily q Logical Stabilizer Site)
    (mu : ZMod q → ℝ) (hmu_nonneg : ∀ a : ZMod q, 0 ≤ mu a)
    (hmu_sum : ∑ a : ZMod q, mu a = 1) :
    kt19Success R mu hmu_nonneg hmu_sum ≤ 1 := by
  simpa [kt19Success, kt19EndpointWeight, kt19DistillationInstrument] using
    (FiniteInstrument.binaryCoarsen_accepted_le_one
      (kt19ProtocolInstrument R) (kt19Accepts R)
      (kt19ProtocolInstrument_complete R)
      (kt19IIDResource (Site := Site) mu hmu_nonneg hmu_sum))

/-- The decoded run's two guarded conditional outputs reconstruct the raw
complete channel output with their actual accepted and rejected Born masses. -/
theorem kt19Run_raw_convex_reconstruction
    (R : CubicRowFamily q Logical Stabilizer Site)
    (mu : ZMod q → ℝ) (hmu_nonneg : ∀ a : ZMod q, 0 ≤ mu a)
    (hmu_sum : ∑ a : ZMod q, mu a = 1) :
    (kt19Run R mu hmu_nonneg hmu_sum).rawOutput =
      outcomeMixture (kt19Run R mu hmu_nonneg hmu_sum).successProbability
        (kt19Run R mu hmu_nonneg hmu_sum).success_nonneg
        (kt19Run R mu hmu_nonneg hmu_sum).success_le_one
        (kt19Run R mu hmu_nonneg hmu_sum).acceptedOutput
        (kt19Run R mu hmu_nonneg hmu_sum).rejectedOutput :=
  (kt19Run R mu hmu_nonneg hmu_sum).rawOutput_eq_outcomeMixture

