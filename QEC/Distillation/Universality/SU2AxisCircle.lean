import QEC.Distillation.Universality.OneQubitGeneratedUniversality
import Mathlib.Analysis.SpecialFunctions.Complex.Circle
import Mathlib.Analysis.Complex.Polynomial.Basic

/-!
# One-qubit special-unitary axis circles

This module gives a concrete, matrix-level realization of the one-parameter
special-unitary circle about a unit Bloch axis.  Its special-unitary
representatives are intended for statements after quotienting by global phase
(that is, projective `PU(2)` statements).  In particular, this module makes no
claim that a finite determinant-one generating set is dense in raw `U(2)`.

It is deliberately limited to that local API: it does not contain an Euler
decomposition, a density claim, or a generated-gate-set closure argument.
-/

noncomputable section

namespace QEC
namespace Distillation

open GeneratedUniversality

/-- A transparent real unit vector used as a Bloch/Pauli rotation axis. -/
structure UnitBlochAxis where
  x : Real
  y : Real
  z : Real
  norm_sq : x ^ 2 + y ^ 2 + z ^ 2 = 1

/-- The concrete two-by-two matrix type used by the axis-circle API. -/
abbrev SingleQubitMatrix := Matrix (Fin 2) (Fin 2) Complex

/-- The concrete one-qubit unitary group used by the axis-circle API. -/
abbrev SingleQubitGate := UnitaryGate (Fin 2)

/-- The Pauli matrix associated to a real Bloch axis. -/
def axisPauliMatrix (axis : UnitBlochAxis) : SingleQubitMatrix :=
  !![(axis.z : Complex), (axis.x : Complex) - Complex.I * (axis.y : Complex);
     (axis.x : Complex) + Complex.I * (axis.y : Complex), -(axis.z : Complex)]

@[simp] theorem axisPauliMatrix_zero_zero (axis : UnitBlochAxis) :
    axisPauliMatrix axis 0 0 = axis.z := by
  simp [axisPauliMatrix]

@[simp] theorem axisPauliMatrix_zero_one (axis : UnitBlochAxis) :
    axisPauliMatrix axis 0 1 =
      (axis.x : Complex) - Complex.I * (axis.y : Complex) := by
  simp [axisPauliMatrix]

@[simp] theorem axisPauliMatrix_one_zero (axis : UnitBlochAxis) :
    axisPauliMatrix axis 1 0 =
      (axis.x : Complex) + Complex.I * (axis.y : Complex) := by
  simp [axisPauliMatrix]

@[simp] theorem axisPauliMatrix_one_one (axis : UnitBlochAxis) :
    axisPauliMatrix axis 1 1 = -axis.z := by
  simp [axisPauliMatrix]

/-- Extensionality for transparent unit Bloch axes. -/
theorem unitBlochAxis_ext {axis axis' : UnitBlochAxis}
    (hx : axis.x = axis'.x) (hy : axis.y = axis'.y) (hz : axis.z = axis'.z) :
    axis = axis' := by
  cases axis
  cases axis'
  simp_all

/-- The concrete Pauli-axis matrix determines its transparent Bloch axis. -/
theorem axisPauliMatrix_injective : Function.Injective axisPauliMatrix := by
  intro axis axis' hmatrix
  apply unitBlochAxis_ext
  · have hentry := congrArg Complex.re (congrFun (congrFun hmatrix 0) 1)
    simpa [axisPauliMatrix, Complex.mul_re] using hentry
  · have hentry := congrArg Complex.im (congrFun (congrFun hmatrix 0) 1)
    have hneg : -axis.y = -axis'.y := by
      simpa [axisPauliMatrix, Complex.mul_im] using hentry
    exact neg_injective hneg
  · apply Complex.ofReal_injective
    simpa [axisPauliMatrix] using congrFun (congrFun hmatrix 0) 0

/-- The Pauli-axis matrix is self-adjoint. -/
theorem axisPauliMatrix_conjTranspose (axis : UnitBlochAxis) :
    (axisPauliMatrix axis).conjTranspose = axisPauliMatrix axis := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [axisPauliMatrix, Complex.conj_ofReal] <;> ring

/-- A unit Bloch axis squares to the identity Pauli matrix. -/
theorem axisPauliMatrix_sq (axis : UnitBlochAxis) :
    axisPauliMatrix axis * axisPauliMatrix axis = 1 := by
  have hnorm : (axis.x : Complex) ^ 2 + (axis.y : Complex) ^ 2 +
      (axis.z : Complex) ^ 2 = 1 := by
    exact_mod_cast axis.norm_sq
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [axisPauliMatrix, Matrix.mul_apply, Fin.sum_univ_two]
  all_goals
    ring_nf
    try rw [Complex.I_sq]
    try { convert hnorm using 1 <;> ring }

/-- The two-dimensional algebra generated by a Pauli-axis matrix. -/
def axisLinearMatrix (axis : UnitBlochAxis) (r s : Complex) : SingleQubitMatrix :=
  r • 1 - (Complex.I * s) • axisPauliMatrix axis

/-- Multiplication in the Pauli-axis algebra is the complex multiplication law. -/
theorem axisLinearMatrix_mul (axis : UnitBlochAxis) (r s u v : Complex) :
    axisLinearMatrix axis r s * axisLinearMatrix axis u v =
      axisLinearMatrix axis (r * u - s * v) (r * v + s * u) := by
  have hI : (Complex.I * v) * (Complex.I * s) = -(v * s) := by
    calc
      (Complex.I * v) * (Complex.I * s) = (Complex.I * Complex.I) * (v * s) := by ring
      _ = -(v * s) := by rw [Complex.I_mul_I]; ring
  simp only [axisLinearMatrix, sub_mul, mul_sub, smul_mul_assoc, mul_smul_comm,
    one_mul, mul_one, axisPauliMatrix_sq]
  rw [smul_sub, smul_sub]
  simp only [smul_smul]
  rw [hI]
  module

/-- The special-unitary rotation matrix associated to a complex circle point. -/
def axisCircleMatrix (axis : UnitBlochAxis) (z : Complex) : SingleQubitMatrix :=
  axisLinearMatrix axis z.re z.im

@[simp] theorem axisCircleMatrix_one (axis : UnitBlochAxis) :
    axisCircleMatrix axis 1 = 1 := by
  simp [axisCircleMatrix, axisLinearMatrix]

/-- The axis-circle matrices respect complex multiplication. -/
theorem axisCircleMatrix_mul (axis : UnitBlochAxis) (z w : Complex) :
    axisCircleMatrix axis z * axisCircleMatrix axis w = axisCircleMatrix axis (z * w) := by
  rw [axisCircleMatrix, axisCircleMatrix, axisCircleMatrix, axisLinearMatrix_mul]
  simp only [Complex.mul_re, Complex.mul_im]
  norm_cast

/-- Conjugate transpose corresponds to complex conjugation on the circle parameter. -/
theorem axisCircleMatrix_conjTranspose (axis : UnitBlochAxis) (z : Complex) :
    (axisCircleMatrix axis z).conjTranspose = axisCircleMatrix axis (star z) := by
  simp [axisCircleMatrix, axisLinearMatrix, axisPauliMatrix_conjTranspose,
    Complex.conj_re, Complex.conj_im]

/-- A unit-modulus parameter gives a unitary axis-circle matrix. -/
theorem axisCircleMatrix_unitary (axis : UnitBlochAxis) (z : Circle) :
    axisCircleMatrix axis z ∈ Matrix.unitaryGroup (Fin 2) Complex := by
  rw [Matrix.mem_unitaryGroup_iff]
  rw [Matrix.star_eq_conjTranspose, axisCircleMatrix_conjTranspose, axisCircleMatrix_mul]
  have hunit : (z : Complex) * star (z : Complex) = 1 := by
    apply Complex.ext
    · simpa [Complex.normSq_apply, pow_two] using z.normSq_coe
    · simp [Complex.mul_re, Complex.mul_im] <;> ring
  rw [hunit, axisCircleMatrix_one]

/-- The axis circle, parameterized by an additive circle of period `2π`. -/
def axisCircle (axis : UnitBlochAxis) (t : AddCircle (2 * Real.pi)) : SingleQubitGate :=
  ⟨axisCircleMatrix axis (AddCircle.toCircle t), axisCircleMatrix_unitary axis _⟩

@[simp] theorem axisCircle_matrix (axis : UnitBlochAxis) (t : AddCircle (2 * Real.pi)) :
    (axisCircle axis t : SingleQubitMatrix) = axisCircleMatrix axis (AddCircle.toCircle t) :=
  rfl

/-- Exact matrix entries for the axis circle. -/
theorem axisCircle_matrix_entries (axis : UnitBlochAxis) (t : AddCircle (2 * Real.pi)) :
    (axisCircle axis t : SingleQubitMatrix) =
      !![((AddCircle.toCircle t : Complex).re : Complex) -
          Complex.I * ((AddCircle.toCircle t : Complex).im : Complex) * (axis.z : Complex),
         -Complex.I * ((AddCircle.toCircle t : Complex).im : Complex) * (axis.x : Complex) -
          ((AddCircle.toCircle t : Complex).im : Complex) * (axis.y : Complex);
         -Complex.I * ((AddCircle.toCircle t : Complex).im : Complex) * (axis.x : Complex) +
          ((AddCircle.toCircle t : Complex).im : Complex) * (axis.y : Complex),
         ((AddCircle.toCircle t : Complex).re : Complex) +
          Complex.I * ((AddCircle.toCircle t : Complex).im : Complex) * (axis.z : Complex)] := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [axisCircle, axisCircleMatrix, axisLinearMatrix, axisPauliMatrix]
  all_goals
    ring_nf
    try rw [Complex.I_sq]
    ring

/-- Every axis-circle matrix has determinant one. -/
theorem axisCircle_det (axis : UnitBlochAxis) (t : AddCircle (2 * Real.pi)) :
    (axisCircle axis t : SingleQubitMatrix).det = 1 := by
  let z : Complex := AddCircle.toCircle t
  have haxis : (axis.x : Complex) ^ 2 + (axis.y : Complex) ^ 2 +
      (axis.z : Complex) ^ 2 = 1 := by
    exact_mod_cast axis.norm_sq
  have hcircle_real : z.re ^ 2 + z.im ^ 2 = 1 := by
    dsimp [z]
    simpa [Complex.normSq_apply, pow_two] using (AddCircle.toCircle t).normSq_coe
  have hcircle : (z.re : Complex) ^ 2 + (z.im : Complex) ^ 2 = 1 := by
    exact_mod_cast hcircle_real
  change (axisCircleMatrix axis z).det = 1
  rw [Matrix.det_fin_two]
  simp [axisCircleMatrix, axisLinearMatrix, axisPauliMatrix]
  calc
    _ = (z.re : Complex) ^ 2 + (z.im : Complex) ^ 2 *
        ((axis.x : Complex) ^ 2 + (axis.y : Complex) ^ 2 + (axis.z : Complex) ^ 2) := by
      ring_nf
      rw [Complex.I_sq, Complex.I_pow_four]
      ring
    _ = (z.re : Complex) ^ 2 + (z.im : Complex) ^ 2 := by rw [haxis, mul_one]
    _ = 1 := hcircle

/-- The trace recovers twice the real circle coordinate. -/
theorem axisCircle_trace (axis : UnitBlochAxis) (t : AddCircle (2 * Real.pi)) :
    Matrix.trace (axisCircle axis t : SingleQubitMatrix) =
      2 * ((AddCircle.toCircle t : Complex).re : Complex) := by
  rw [Matrix.trace_fin_two]
  simp [axisCircle, axisCircleMatrix, axisLinearMatrix, axisPauliMatrix]
  ring

/-- A nonzero imaginary circle coordinate recovers the Pauli axis from its rotation matrix. -/
theorem axisCircleMatrix_axis_recovery {axis axis' : UnitBlochAxis} {z : Complex}
    (h_im : z.im ≠ 0)
    (hmatrix : axisCircleMatrix axis z = axisCircleMatrix axis' z) :
    axis = axis' := by
  apply axisPauliMatrix_injective
  have hscaled : (Complex.I * (z.im : Complex)) • axisPauliMatrix axis =
      (Complex.I * (z.im : Complex)) • axisPauliMatrix axis' := by
    have hmatrix' : (z.re : Complex) • 1 - (Complex.I * (z.im : Complex)) • axisPauliMatrix axis =
        (z.re : Complex) • 1 - (Complex.I * (z.im : Complex)) • axisPauliMatrix axis' := by
      simpa [axisCircleMatrix, axisLinearMatrix] using hmatrix
    exact sub_right_inj.mp hmatrix'
  have him_ne : (z.im : Complex) ≠ 0 := by
    exact_mod_cast h_im
  exact smul_right_injective SingleQubitMatrix (mul_ne_zero Complex.I_ne_zero him_ne) hscaled

/-- A nontrivial axis-circle point determines its transparent unit Bloch axis. -/
theorem axisCircle_axis_recovery {axis axis' : UnitBlochAxis}
    (t : AddCircle (2 * Real.pi))
    (h_im : (AddCircle.toCircle t : Complex).im ≠ 0)
    (hgate : axisCircle axis t = axisCircle axis' t) : axis = axis' := by
  apply axisCircleMatrix_axis_recovery h_im
  exact congrArg (fun U : SingleQubitGate => (U : SingleQubitMatrix)) hgate

@[simp] theorem axisCircle_zero (axis : UnitBlochAxis) : axisCircle axis 0 = 1 := by
  apply Subtype.ext
  change axisCircleMatrix axis (AddCircle.toCircle (0 : AddCircle (2 * Real.pi))) = 1
  simp [axisCircleMatrix_one]

/-- Addition of circle parameters is multiplication of the corresponding unitary gates. -/
theorem axisCircle_add (axis : UnitBlochAxis) (t u : AddCircle (2 * Real.pi)) :
    axisCircle axis (t + u) = axisCircle axis t * axisCircle axis u := by
  apply Subtype.ext
  change axisCircleMatrix axis (AddCircle.toCircle (t + u)) =
    axisCircleMatrix axis (AddCircle.toCircle t) * axisCircleMatrix axis (AddCircle.toCircle u)
  rw [AddCircle.toCircle_add]
  exact (axisCircleMatrix_mul axis _ _).symm

/-- Negating a circle parameter gives the inverse unitary gate. -/
theorem axisCircle_neg (axis : UnitBlochAxis) (t : AddCircle (2 * Real.pi)) :
    axisCircle axis (-t) = (axisCircle axis t)⁻¹ := by
  apply (eq_inv_iff_mul_eq_one).2
  rw [← axisCircle_add]
  simp

/-- Natural circle multiples give natural powers of the corresponding gate. -/
theorem axisCircle_nsmul (axis : UnitBlochAxis) (t : AddCircle (2 * Real.pi)) (n : Nat) :
    axisCircle axis (n • t) = (axisCircle axis t) ^ n := by
  induction n with
  | zero => simp
  | succ n ih =>
      rw [succ_nsmul, axisCircle_add, ih, pow_succ]

/-- The axis circle is continuous as a map into the concrete unitary group. -/
theorem axisCircle_continuous (axis : UnitBlochAxis) :
    Continuous (axisCircle axis : AddCircle (2 * Real.pi) → SingleQubitGate) := by
  apply continuous_induced_rng.mpr
  change Continuous fun t : AddCircle (2 * Real.pi) =>
    axisCircleMatrix axis (AddCircle.toCircle t)
  apply continuous_matrix
  intro i j
  fin_cases i <;> fin_cases j <;>
    simp [axisCircleMatrix, axisLinearMatrix, axisPauliMatrix] <;> fun_prop

/-- Conjugating a Pauli-axis circle transports it along a supplied Pauli transport equality. -/
theorem axisCircle_conjugate
    (V : SingleQubitGate) (axis axis' : UnitBlochAxis)
    (haxis : (V : SingleQubitMatrix) * axisPauliMatrix axis *
        ((V⁻¹ : SingleQubitGate) : SingleQubitMatrix) = axisPauliMatrix axis')
    (t : AddCircle (2 * Real.pi)) :
    V * axisCircle axis t * V⁻¹ = axisCircle axis' t := by
  apply Subtype.ext
  rw [Matrix.UnitaryGroup.mul_val, Matrix.UnitaryGroup.mul_val, Matrix.UnitaryGroup.inv_val]
  change (V : SingleQubitMatrix) * axisCircleMatrix axis (AddCircle.toCircle t) *
      star (V : SingleQubitMatrix) = axisCircleMatrix axis' (AddCircle.toCircle t)
  have hinv : (V : SingleQubitMatrix) * star (V : SingleQubitMatrix) = 1 := by
    simpa only [Matrix.UnitaryGroup.mul_val, Matrix.UnitaryGroup.inv_val,
      Matrix.UnitaryGroup.one_val] using
      congrArg (fun W : SingleQubitGate => (W : SingleQubitMatrix)) (mul_inv_cancel V)
  have haxis' : (V : SingleQubitMatrix) * axisPauliMatrix axis * star (V : SingleQubitMatrix) =
      axisPauliMatrix axis' := by
    simpa only [Matrix.UnitaryGroup.inv_val] using haxis

  simp only [axisCircleMatrix, axisLinearMatrix, mul_sub, sub_mul, mul_smul_comm,
    smul_mul_assoc, ← mul_assoc, hinv, mul_one, one_mul, haxis']

/-- A square-root representative of the determinant of a one-qubit unitary. -/
noncomputable def determinantRoot (U : SingleQubitGate) : Complex :=
  Classical.choose <| IsAlgClosed.exists_pow_nat_eq
    (U : SingleQubitMatrix).det (show 0 < 2 by norm_num)

theorem determinantRoot_sq (U : SingleQubitGate) :
    determinantRoot U ^ 2 = (U : SingleQubitMatrix).det := by
  exact Classical.choose_spec <| IsAlgClosed.exists_pow_nat_eq
    (U : SingleQubitMatrix).det (show 0 < 2 by norm_num)

/-- The determinant root of a unitary is itself unit modulus. -/
theorem determinantRoot_norm (U : SingleQubitGate) : ‖determinantRoot U‖ = 1 := by
  have hdet_unitary : (U : SingleQubitMatrix).det ∈ unitary Complex :=
    Matrix.det_of_mem_unitary U.property
  have hdet_norm : ‖(U : SingleQubitMatrix).det‖ = 1 := by
    have hsq : ‖(U : SingleQubitMatrix).det‖ ^ 2 = 1 := by
      apply Complex.ofReal_injective
      calc
        (↑(‖(U : SingleQubitMatrix).det‖ ^ 2) : Complex) =
            (↑(Complex.normSq (U : SingleQubitMatrix).det) : Complex) := by
          rw [Complex.normSq_eq_norm_sq]
        _ = star (U : SingleQubitMatrix).det * (U : SingleQubitMatrix).det :=
          Complex.normSq_eq_conj_mul_self
        _ = 1 := hdet_unitary.1
    nlinarith [norm_nonneg ((U : SingleQubitMatrix).det)]
  have hroot_sq : ‖determinantRoot U‖ ^ 2 = 1 := by
    calc
      ‖determinantRoot U‖ ^ 2 = ‖determinantRoot U ^ 2‖ := (norm_pow _ 2).symm
      _ = ‖(U : SingleQubitMatrix).det‖ := by rw [determinantRoot_sq]
      _ = 1 := hdet_norm
  nlinarith [norm_nonneg (determinantRoot U)]

private theorem determinantRoot_inv_unitary (U : SingleQubitGate) :
    (determinantRoot U)⁻¹ ∈ unitary Complex := by
  have hnormSq : Complex.normSq (determinantRoot U) = 1 := by
    rw [Complex.normSq_eq_norm_sq, determinantRoot_norm]
    norm_num
  have hstarInv : star ((determinantRoot U)⁻¹) = determinantRoot U := by
    rw [Complex.inv_def]
    simp [hnormSq]
  have hroot_ne : determinantRoot U ≠ 0 := by
    intro hzero
    simpa [hzero] using determinantRoot_norm U
  rw [Unitary.mem_iff, hstarInv]
  exact ⟨mul_inv_cancel₀ hroot_ne, inv_mul_cancel₀ hroot_ne⟩

/--
Divide a unitary by a chosen square root of its determinant.

The result is a determinant-one representative of the same global-phase
class.  This is a projective normalization interface; it does not assert any
raw-`U(2)` density property for a finite collection of such representatives.
-/
noncomputable def phaseNormalize (U : SingleQubitGate) : SingleQubitGate :=
  ⟨(determinantRoot U)⁻¹ • (U : SingleQubitMatrix),
    Unitary.smul_mem_of_mem (determinantRoot_inv_unitary U) U.property⟩

@[simp] theorem phaseNormalize_matrix (U : SingleQubitGate) :
    (phaseNormalize U : SingleQubitMatrix) = (determinantRoot U)⁻¹ • (U : SingleQubitMatrix) :=
  rfl

/-- Phase normalization has determinant one. -/
theorem phaseNormalize_det (U : SingleQubitGate) :
    (phaseNormalize U : SingleQubitMatrix).det = 1 := by
  have hroot_ne : determinantRoot U ≠ 0 := by
    intro hzero
    have hnorm := determinantRoot_norm U
    simp [hzero] at hnorm
  rw [phaseNormalize_matrix, Matrix.det_smul]
  norm_num
  rw [determinantRoot_sq]
  have hdet_ne : (U : SingleQubitMatrix).det ≠ 0 := by
    rw [← determinantRoot_sq]
    exact pow_ne_zero 2 hroot_ne
  exact inv_mul_cancel₀ hdet_ne

/-- Every one-qubit unitary is phase-equivalent to a determinant-one representative. -/
theorem phaseNormalize_globalPhaseEquivalent (U : SingleQubitGate) :
    GlobalPhaseEquivalent (phaseNormalize U) U := by
  refine ⟨determinantRoot U, determinantRoot_norm U, ?_⟩
  rw [phaseNormalize_matrix, smul_smul]
  have hroot_ne : determinantRoot U ≠ 0 := by
    intro hzero
    have hnorm := determinantRoot_norm U
    simp [hzero] at hnorm
  rw [mul_inv_cancel₀ hroot_ne, one_smul]

end Distillation
end QEC
