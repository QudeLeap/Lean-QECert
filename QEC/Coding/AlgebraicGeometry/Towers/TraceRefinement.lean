import QEC.Coding.AlgebraicGeometry.Towers.NormalizedCompositumEdges

/-!
# Literal trace-coordinate refinements in the ambient field

Successive coordinates satisfy `t_(j+1)² + t_(j+1) = t_j`. The fields here
adjoin those actual coordinates, rather than identify an unrelated abstract
degree-sixteen field. Normalization propagates from the initial parameter.
-/

open IntermediateField
open scoped QEC.Coding.AlgebraicGeometry.IntermediateIntegralModels

namespace QEC.Coding.AlgebraicGeometry.F256GarciaStichtenoth

noncomputable section

attribute [local instance 2500] Algebra.toSMul Algebra.toModule

variable {F E : Type*} [_root_.Field F] [_root_.Field E] [Algebra F E]

/-- The literal field obtained by adjoining the first `j` trace coordinates. -/
def tracePrefixField (K : IntermediateField F E) (t : ℕ → E) : ℕ → IntermediateField F E
  | 0 => K
  | j + 1 => ((tracePrefixField K t j)⟮t (j + 1)⟯).restrictScalars F

theorem tracePrefixField_le_succ (K : IntermediateField F E) (t : ℕ → E) (j : ℕ) :
    tracePrefixField K t j ≤ tracePrefixField K t (j + 1) := by
  rw [tracePrefixField, IntermediateField.restrictScalars_adjoin_eq_sup]
  exact le_sup_left

theorem tracePrefixField_coordinate_mem
    (K : IntermediateField F E) (t : ℕ → E) (ht : t 0 ∈ K) (j : ℕ) :
    t j ∈ tracePrefixField K t j := by
  cases j with
  | zero => exact ht
  | succ j => exact IntermediateField.mem_adjoin_simple_self (tracePrefixField K t j) (t (j + 1))

/-- The full literal prefix is generated by its last coordinate: every
earlier coordinate is a polynomial in the next one. -/
theorem tracePrefixField_eq_adjoin_terminal
    (K : IntermediateField F E) (t : ℕ → E) (ht : t 0 ∈ K) (n : ℕ)
    (heq : ∀ j < n, t (j + 1) ^ 2 + t (j + 1) = t j) :
    tracePrefixField K t n = (K⟮t n⟯).restrictScalars F := by
  induction n with
  | zero =>
      rw [tracePrefixField, IntermediateField.restrictScalars_adjoin_eq_sup]
      exact (sup_eq_left.mpr (IntermediateField.adjoin_simple_le_iff.mpr ht)).symm
  | succ n ih =>
      rw [tracePrefixField, IntermediateField.restrictScalars_adjoin_eq_sup,
        ih (fun j hj => heq j (by omega)),
        IntermediateField.restrictScalars_adjoin_eq_sup,
        IntermediateField.restrictScalars_adjoin_eq_sup, sup_assoc]
      have hle : F⟮t n⟯ ≤ F⟮t (n + 1)⟯ := by
        rw [IntermediateField.adjoin_simple_le_iff, ← heq n (by omega)]
        have ht' := IntermediateField.mem_adjoin_simple_self F (t (n + 1))
        exact (F⟮t (n + 1)⟯).add_mem
          ((F⟮t (n + 1)⟯).toSubalgebra.pow_mem ht' 2) ht'
      rw [sup_eq_right.mpr hle]

/-- The four trace coordinates in characteristic two, ordered from the
additive parameter to the original root. -/
def traceCoordinates16 (y : E) : ℕ → E
  | 0 => y ^ 16 + y
  | 1 => y ^ 8 + y ^ 4 + y ^ 2 + y
  | 2 => y ^ 4 + y
  | 3 => y ^ 2 + y
  | _ => y

theorem traceCoordinates16_equation [CharP E 2] (y : E) (j : ℕ) (hj : j < 4) :
    traceCoordinates16 y (j + 1) ^ 2 + traceCoordinates16 y (j + 1) =
      traceCoordinates16 y j := by
  interval_cases j <;> simp only [traceCoordinates16, CharTwo.add_sq] <;>
    ring_nf <;> simp [CharTwo.two_eq_zero]

variable (A : Type*) [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
    [Algebra A F] [IsFractionRing A F] [Algebra A E] [IsScalarTower A F E]
    [FiniteDimensional F E] [Algebra.IsSeparable F E]
    [Algebra F256 F] [Algebra F256 E] [IsScalarTower F256 F E]
    [Module.Finite A (integralClosure A E)]
    (Q : IsDedekindDomain.HeightOneSpectrum (integralClosure A E))

local notation "P" => IntermediateIntegralModels.prime A F E Q

/-- Every prefix of the actual trace-coordinate chain is a normalized
refinement, and its terminal coordinate is normalized at the fixed prime.
Only the starting parameter carries an order hypothesis. -/
theorem tracePrefixField_normalized
    (K : IntermediateField F E) (t : ℕ → E) (ht : t 0 ∈ K) (n : ℕ)
    (heq : ∀ j < n, t (j + 1) ^ 2 + t (j + 1) = t j)
    (hzero : (heightOnePlace (k := F256) (K := K) (P K)).order ⟨t 0, ht⟩ = -1 ∨
      0 ≤ (heightOnePlace (k := F256) (K := K) (P K)).order ⟨t 0, ht⟩) :
    NormalizedRefinement A F E Q K (tracePrefixField K t n) ∧
      ((heightOnePlace (k := F256) (K := tracePrefixField K t n)
        (P (tracePrefixField K t n))).order
          ⟨t n, tracePrefixField_coordinate_mem K t ht n⟩ = -1 ∨
        0 ≤ (heightOnePlace (k := F256) (K := tracePrefixField K t n)
          (P (tracePrefixField K t n))).order
            ⟨t n, tracePrefixField_coordinate_mem K t ht n⟩) := by
  induction n with
  | zero => exact ⟨.refl, hzero⟩
  | succ n ih =>
      obtain ⟨hchain, horder⟩ := ih (fun j hj => heq j (by omega))
      let L := tracePrefixField K t n
      let M := tracePrefixField K t (n + 1)
      letI : Fact (L ≤ M) := ⟨tracePrefixField_le_succ K t n⟩
      let a : L := ⟨t n, tracePrefixField_coordinate_mem K t ht n⟩
      let y : M := ⟨t (n + 1), tracePrefixField_coordinate_mem K t ht (n + 1)⟩
      have hy : y ^ 2 + y = algebraMap L M a := by
        apply Subtype.ext
        exact heq n (by omega)
      have hgen : L⟮y⟯ = ⊤ :=
        adjoin_in_subfield_eq_top L M (t (n + 1)) y.property rfl
      have hedge : NormalizedEdge A F E Q L M :=
        ⟨a, t (n + 1), heq n (by omega), horder, rfl⟩
      exact ⟨hchain.tail hedge, normalizedLiteralRoot_order A F E Q a y hy hgen horder⟩

/-- The source's degree-sixteen additive equation has a normalized
four-stage refinement in its literal generated subfield. Neither degree
sixteen nor a ramification conclusion is an input. -/
theorem artinSchreier16_normalizedRefinement
    (K : IntermediateField F E) (a : K) (y : E)
    (hy : y ^ 16 + y = (a : E))
    (ha : (heightOnePlace (k := F256) (K := K) (P K)).order a = -1 ∨
      0 ≤ (heightOnePlace (k := F256) (K := K) (P K)).order a) :
    NormalizedRefinement A F E Q K ((K⟮y⟯).restrictScalars F) := by
  letI : CharP F256 2 :=
    charP_of_injective_algebraMap (algebraMap (ZMod 2) F256).injective 2
  letI : CharP E 2 :=
    charP_of_injective_algebraMap (algebraMap F256 E).injective 2
  have ht : traceCoordinates16 y 0 ∈ K := by
    change y ^ 16 + y ∈ K
    rw [hy]
    exact a.property
  have ht0 : (⟨traceCoordinates16 y 0, ht⟩ : K) = a := Subtype.ext hy
  have h := (tracePrefixField_normalized A Q K (traceCoordinates16 y) ht 4
    (traceCoordinates16_equation y) (by rwa [ht0])).1
  rw [tracePrefixField_eq_adjoin_terminal K (traceCoordinates16 y) ht 4
    (traceCoordinates16_equation y)] at h
  exact h

end

end QEC.Coding.AlgebraicGeometry.F256GarciaStichtenoth
