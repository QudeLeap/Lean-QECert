import Mathlib.FieldTheory.RatFunc.AsPolynomial
import Mathlib.NumberTheory.FunctionField

/-!
# The inverse rational-function chart

This file records the concrete coordinate change used for the second affine
chart of a one-variable function field.  If `t` is the supplied rational
coordinate, then `y = t⁻¹` is again transcendental.  Mathlib's
`RatFunc.algEquivOfTranscendental` therefore gives the actual coefficient map
from a fresh copy of `k⟮X⟯` into `F`, sending its `X` to `y`.

The finite-dimensional and separability transports needed to instantiate the
existing `AffinePlace` construction are deliberately kept separate: they must
be proved from this map, rather than postulated as an infinity-place package.
In particular, this file does not classify global places or assert a
Riemann--Roch dimension formula.
-/

namespace QEC.Coding.AlgebraicGeometry

namespace InverseChart

open scoped IntermediateField Polynomial RatFunc

variable (k F : Type*)
variable [Field k] [Finite k] [Field F]
variable [Algebra k F] [Algebra k⟮X⟯ F]
variable [IsScalarTower k k⟮X⟯ F]
variable [_root_.FunctionField k F]

/-- The original affine coordinate in the supplied function field. -/
noncomputable def coordinate : F := algebraMap k⟮X⟯ F RatFunc.X

/-- The coordinate on the complementary affine chart. -/
noncomputable def inverseCoordinate : F := (coordinate k F)⁻¹

/-- The supplied rational coordinate remains transcendental after embedding
the rational-function field in `F`. -/
theorem coordinate_transcendental : Transcendental k (coordinate k F) := by
  apply (transcendental_algebraMap_iff (algebraMap k⟮X⟯ F).injective).mpr
  exact RatFunc.transcendental_X

/-- Inverting a transcendental coordinate does not make it algebraic. -/
theorem inverseCoordinate_transcendental :
    Transcendental k (inverseCoordinate k F) := by
  intro h
  apply coordinate_transcendental k F
  apply IsAlgebraic.inv_iff.mp
  simpa only [inverseCoordinate] using h

/-- The exact rational-function equivalence for the inverse coordinate. -/
noncomputable def rationalEquiv :
    RatFunc k ≃ₐ[k] k⟮(inverseCoordinate k F)⟯ :=
  RatFunc.algEquivOfTranscendental (inverseCoordinate k F)
    (inverseCoordinate_transcendental k F)

/-- The actual coefficient map for the inverse chart, obtained by composing
the inverse-coordinate rational-function equivalence with the subfield
inclusion into `F`. -/
noncomputable def rationalMap : RatFunc k →ₐ[k] F :=
  (k⟮(inverseCoordinate k F)⟯).val.comp
    (rationalEquiv k F).toAlgHom

/-- The new rational-function variable is sent to the reciprocal of the
original coordinate. -/
theorem rationalMap_X :
    rationalMap k F RatFunc.X = inverseCoordinate k F := by
  simp [rationalMap, rationalEquiv]

/-- The finite-dimensionality already provided by the function-field API,
viewed over the subfield generated by the inverse coordinate. -/
theorem finiteDimensional_adjoin_inverseCoordinate :
    FiniteDimensional k⟮(inverseCoordinate k F)⟯ F :=
  _root_.FunctionField.finiteDimensional_of_adjoin_transcendental
    (inverseCoordinate_transcendental k F)

/-- The ring homomorphism from the polynomial ring of the inverse chart to
`F`.  This is the map to use when transporting the affine-place construction
to the complementary chart. -/
noncomputable def polynomialMap : k[X] →+* F :=
  (rationalMap k F).toRingHom.comp (algebraMap k[X] (RatFunc k))

/-- The polynomial-algebra structure induced by the inverse coordinate.
Together with `rationalMap`, this is the concrete input for the future
finite-dimensional/separability transport into `AffinePlace`. -/
@[reducible] noncomputable def polynomialAlgebra : Algebra k[X] F :=
  (polynomialMap k F).toAlgebra

/-- The inverse-chart polynomial variable evaluates to the reciprocal of the
original rational coordinate. -/
theorem polynomialMap_X :
    polynomialMap k F Polynomial.X = inverseCoordinate k F := by
  simpa [polynomialMap] using rationalMap_X k F

end InverseChart

end QEC.Coding.AlgebraicGeometry
