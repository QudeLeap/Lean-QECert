import QEC.Semantics.Core.Definitions
import Mathlib.Analysis.Matrix.Normed
import Mathlib.LinearAlgebra.UnitaryGroup

/-!
# Generated-unitary universality interfaces

This module provides transparent finite-dimensional interfaces for generated
unitary subgroups, their topological closures, global phase, and finite
precision approximation. It deliberately contains no concrete gate-set
density theorem.
-/

noncomputable section

universe u

namespace QEC
namespace Distillation
namespace GeneratedUniversality

open Semantics
open scoped Matrix.Norms.Elementwise

/-- The Mathlib unitary group on a finite complex coordinate space. -/
abbrev UnitaryGate (n : Type u) [Fintype n] [DecidableEq n] :=
  Matrix.unitaryGroup n Complex

/-- Equality of finite-dimensional unitary matrices up to a unit-modulus scalar. -/
def GlobalPhaseEquivalent {n : Type u} [Fintype n] [DecidableEq n]
    (U V : UnitaryGate n) : Prop :=
  ∃ scalar : Complex, ‖scalar‖ = 1 ∧
    (V : Matrix n n Complex) = scalar • (U : Matrix n n Complex)

/-- Every unitary is globally phase-equivalent to itself. -/
theorem globalPhaseEquivalent_refl {n : Type u} [Fintype n] [DecidableEq n]
    (U : UnitaryGate n) : GlobalPhaseEquivalent U U :=
  ⟨1, norm_one, by simp⟩

/-- Matrix equality implies equality modulo global phase. -/
theorem globalPhaseEquivalent_of_matrix_eq {n : Type u} [Fintype n] [DecidableEq n]
    {U V : UnitaryGate n}
    (hmatrix : (V : Matrix n n Complex) = (U : Matrix n n Complex)) :
    GlobalPhaseEquivalent U V :=
  ⟨1, norm_one, by simpa using hmatrix⟩

/-- Global-phase equivalence is symmetric. -/
theorem globalPhaseEquivalent_symm {n : Type u} [Fintype n] [DecidableEq n]
    {U V : UnitaryGate n} (h : GlobalPhaseEquivalent U V) :
    GlobalPhaseEquivalent V U := by
  rcases h with ⟨scalar, hnorm, hmatrix⟩
  have hnonzero : scalar ≠ 0 := by
    intro hzero
    simp [hzero] at hnorm
  refine ⟨scalar⁻¹, ?_, ?_⟩
  · rw [norm_inv, hnorm]
    norm_num
  · rw [hmatrix, smul_smul, inv_mul_cancel₀ hnonzero, one_smul]

/-- Global-phase equivalence is transitive. -/
theorem globalPhaseEquivalent_trans {n : Type u} [Fintype n] [DecidableEq n]
    {U V W : UnitaryGate n}
    (hUV : GlobalPhaseEquivalent U V)
    (hVW : GlobalPhaseEquivalent V W) :
    GlobalPhaseEquivalent U W := by
  rcases hUV with ⟨scalarUV, hnormUV, hmatrixUV⟩
  rcases hVW with ⟨scalarVW, hnormVW, hmatrixVW⟩
  refine ⟨scalarVW * scalarUV, ?_, ?_⟩
  · rw [norm_mul, hnormVW, hnormUV]
    norm_num
  · rw [hmatrixVW, hmatrixUV, smul_smul]

/-- Global-phase equivalence is compatible with multiplication. -/
theorem globalPhaseEquivalent_mul {n : Type u} [Fintype n] [DecidableEq n]
    {U V U' V' : UnitaryGate n}
    (hleft : GlobalPhaseEquivalent U V)
    (hright : GlobalPhaseEquivalent U' V') :
    GlobalPhaseEquivalent (U * U') (V * V') := by
  rcases hleft with ⟨leftScalar, hleftNorm, hleftMatrix⟩
  rcases hright with ⟨rightScalar, hrightNorm, hrightMatrix⟩
  refine ⟨leftScalar * rightScalar, ?_, ?_⟩
  · rw [norm_mul, hleftNorm, hrightNorm]
    norm_num
  · change (V : Matrix n n Complex) * (V' : Matrix n n Complex) =
      (leftScalar * rightScalar) • ((U : Matrix n n Complex) * (U' : Matrix n n Complex))
    rw [hleftMatrix, hrightMatrix, smul_mul_smul]

/-- Global-phase equivalence is compatible with inversion. -/
theorem globalPhaseEquivalent_inv {n : Type u} [Fintype n] [DecidableEq n]
    {U V : UnitaryGate n} (h : GlobalPhaseEquivalent U V) :
    GlobalPhaseEquivalent U⁻¹ V⁻¹ := by
  rcases h with ⟨scalar, hnorm, hmatrix⟩
  refine ⟨star scalar, ?_, ?_⟩
  · simpa using hnorm
  · change (↑(V⁻¹) : Matrix n n Complex) = star scalar • (↑(U⁻¹) : Matrix n n Complex)
    simp only [Matrix.UnitaryGroup.inv_val]
    rw [hmatrix, star_smul]

/-- Global-phase equivalence is compatible with conjugation. -/
theorem globalPhaseEquivalent_conjugate {n : Type u} [Fintype n] [DecidableEq n]
    {U V U' V' : UnitaryGate n}
    (hconjugator : GlobalPhaseEquivalent U V)
    (hconjugated : GlobalPhaseEquivalent U' V') :
    GlobalPhaseEquivalent (U * U' * U⁻¹) (V * V' * V⁻¹) :=
  globalPhaseEquivalent_mul
    (globalPhaseEquivalent_mul hconjugator hconjugated)
    (globalPhaseEquivalent_inv hconjugator)
/-- The subgroup generated by a transparent set of unitary gates. -/
def generatedUnitarySubgroup {n : Type u} [Fintype n] [DecidableEq n]
    (generators : Set (UnitaryGate n)) : Subgroup (UnitaryGate n) :=
  Subgroup.closure generators

/-- The topological closure of a generated unitary subgroup. -/
def generatedUnitaryTopologicalClosure {n : Type u} [Fintype n] [DecidableEq n]
    (generators : Set (UnitaryGate n)) : Set (UnitaryGate n) :=
  closure (generatedUnitarySubgroup generators : Set (UnitaryGate n))

/-- A generator set is dense when its generated subgroup has full topological closure. -/
def GeneratedUnitaryDense {n : Type u} [Fintype n] [DecidableEq n]
    (generators : Set (UnitaryGate n)) : Prop :=
  generatedUnitaryTopologicalClosure generators = Set.univ
/-- Every unitary has a representative in the generated closure, up to global phase. -/
def ProjectivelyGeneratedDense {n : Type u} [Fintype n] [DecidableEq n]
    (generators : Set (UnitaryGate n)) : Prop :=
  ∀ target : UnitaryGate n, ∃ representative : UnitaryGate n,
    representative ∈ generatedUnitaryTopologicalClosure generators ∧
      GlobalPhaseEquivalent target representative

/-- Enlarging generators enlarges their generated subgroups. -/
theorem generatedUnitarySubgroup_mono {n : Type u} [Fintype n] [DecidableEq n]
    {generators generators' : Set (UnitaryGate n)}
    (h : generators ⊆ generators') :
    generatedUnitarySubgroup generators ≤ generatedUnitarySubgroup generators' :=
  Subgroup.closure_mono h

/-- Enlarging generators enlarges their generated topological closures. -/
theorem generatedUnitaryTopologicalClosure_mono {n : Type u} [Fintype n] [DecidableEq n]
    {generators generators' : Set (UnitaryGate n)}
    (h : generators ⊆ generators') :
    generatedUnitaryTopologicalClosure generators ⊆
      generatedUnitaryTopologicalClosure generators' := by
  apply closure_mono
  exact generatedUnitarySubgroup_mono h

/-- Generated density is monotone under enlarging the generating set. -/
theorem generatedUnitaryDense_mono {n : Type u} [Fintype n] [DecidableEq n]
    {generators generators' : Set (UnitaryGate n)}
    (h : generators ⊆ generators')
    (hdense : GeneratedUnitaryDense generators) :
    GeneratedUnitaryDense generators' := by
  apply Set.eq_univ_of_forall
  intro U
  apply generatedUnitaryTopologicalClosure_mono h
  rw [hdense]
  exact Set.mem_univ U

/-- A generated subgroup is closed under composition of generated unitaries. -/
theorem generatedUnitarySubgroup_compose_mem {n : Type u} [Fintype n] [DecidableEq n]
    (generators : Set (UnitaryGate n)) {U V : UnitaryGate n}
    (hU : U ∈ generatedUnitarySubgroup generators)
    (hV : V ∈ generatedUnitarySubgroup generators) :
    U * V ∈ generatedUnitarySubgroup generators :=
  (generatedUnitarySubgroup generators).mul_mem hU hV

/-- A generated subgroup is closed under conjugation by its generated unitaries. -/
theorem generatedUnitarySubgroup_conjugate_mem {n : Type u} [Fintype n] [DecidableEq n]
    (generators : Set (UnitaryGate n)) {U V : UnitaryGate n}
    (hU : U ∈ generatedUnitarySubgroup generators)
    (hV : V ∈ generatedUnitarySubgroup generators) :
    U * V * U⁻¹ ∈ generatedUnitarySubgroup generators :=
  (generatedUnitarySubgroup generators).mul_mem
    ((generatedUnitarySubgroup generators).mul_mem hU hV)
    ((generatedUnitarySubgroup generators).inv_mem hU)

/-- Every generated unitary lies in the topological closure of its generated subgroup. -/
theorem generatedUnitarySubgroup_subset_topologicalClosure {n : Type u}
    [Fintype n] [DecidableEq n] (generators : Set (UnitaryGate n)) :
    (generatedUnitarySubgroup generators : Set (UnitaryGate n)) ⊆
      generatedUnitaryTopologicalClosure generators :=
  subset_closure

/-- Approximation by a generated unitary, modulo a unit-modulus global phase. -/
def ApproximatesModuloPhase {n : Type u} [Fintype n] [DecidableEq n]
    (generators : Set (UnitaryGate n)) (target : UnitaryGate n) (precision : Real) : Prop :=
  ∃ candidate : UnitaryGate n,
    candidate ∈ generatedUnitaryTopologicalClosure generators ∧
      ∃ scalar : Complex, ‖scalar‖ = 1 ∧
        ‖(candidate : Matrix n n Complex) - scalar • (target : Matrix n n Complex)‖ < precision

/-- Changing the target by a unit global phase preserves an approximation. -/
theorem approximatesModuloPhase_congr_target {n : Type u} [Fintype n] [DecidableEq n]
    {generators : Set (UnitaryGate n)} {target target' : UnitaryGate n} {precision : Real}
    (htarget : GlobalPhaseEquivalent target target')
    (happrox : ApproximatesModuloPhase generators target precision) :
    ApproximatesModuloPhase generators target' precision := by
  rcases htarget with ⟨phase, hnorm, hmatrix⟩
  rcases happrox with ⟨candidate, hcandidate, scalar, hscalar, hbound⟩
  have hnonzero : phase ≠ 0 := by
    intro hzero
    simp [hzero] at hnorm
  refine ⟨candidate, hcandidate, scalar * phase⁻¹, ?_, ?_⟩
  · rw [norm_mul, hscalar, norm_inv, hnorm]
    norm_num
  · rw [hmatrix, smul_smul]
    have hphase_cancel : scalar * phase⁻¹ * phase = scalar := by
      calc
        scalar * phase⁻¹ * phase = scalar * (phase⁻¹ * phase) := by ring
        _ = scalar := by rw [inv_mul_cancel₀ hnonzero, mul_one]
    rw [hphase_cancel]
    exact hbound

/-- Approximation modulo phase is monotone under enlarging the generating set. -/
theorem approximatesModuloPhase_mono {n : Type u} [Fintype n] [DecidableEq n]
    {generators generators' : Set (UnitaryGate n)} {target : UnitaryGate n} {precision : Real}
    (h : generators ⊆ generators')
    (happrox : ApproximatesModuloPhase generators target precision) :
    ApproximatesModuloPhase generators' target precision := by
  rcases happrox with ⟨candidate, hcandidate, scalar, hscalar, hbound⟩
  exact ⟨candidate, generatedUnitaryTopologicalClosure_mono h hcandidate,
    scalar, hscalar, hbound⟩

/-- An approximation remains valid at every weaker positive precision. -/
theorem approximatesModuloPhase_of_le {n : Type u} [Fintype n] [DecidableEq n]
    {generators : Set (UnitaryGate n)} {target : UnitaryGate n}
    {precision precision' : Real}
    (happrox : ApproximatesModuloPhase generators target precision)
    (h : precision ≤ precision') :
    ApproximatesModuloPhase generators target precision' := by
  rcases happrox with ⟨candidate, hcandidate, scalar, hscalar, hbound⟩
  exact ⟨candidate, hcandidate, scalar, hscalar, lt_of_lt_of_le hbound h⟩

/-- Topological-closure membership gives an approximation at every positive precision. -/
theorem approximatesModuloPhase_of_mem_generatedUnitaryTopologicalClosure
    {n : Type u} [Fintype n] [DecidableEq n]
    {generators : Set (UnitaryGate n)} {target : UnitaryGate n} {precision : Real}
    (htarget : target ∈ generatedUnitaryTopologicalClosure generators)
    (hprecision : 0 < precision) :
    ApproximatesModuloPhase generators target precision :=
  ⟨target, htarget, 1, norm_one, by simpa using hprecision⟩

/-- A closure representative equal to the target modulo phase approximates the target. -/
theorem approximatesModuloPhase_of_globalPhaseEquivalent_mem_generatedUnitaryTopologicalClosure
    {n : Type u} [Fintype n] [DecidableEq n]
    {generators : Set (UnitaryGate n)} {target representative : UnitaryGate n} {precision : Real}
    (hphase : GlobalPhaseEquivalent target representative)
    (hrepresentative : representative ∈ generatedUnitaryTopologicalClosure generators)
    (hprecision : 0 < precision) :
    ApproximatesModuloPhase generators target precision :=
  approximatesModuloPhase_congr_target (globalPhaseEquivalent_symm hphase)
    (approximatesModuloPhase_of_mem_generatedUnitaryTopologicalClosure hrepresentative hprecision)

/-- Finite-precision universality for a finite-dimensional unitary group. -/
def FinitePrecisionUniversal {n : Type u} [Fintype n] [DecidableEq n]
    (generators : Set (UnitaryGate n)) : Prop :=
  ∀ target : UnitaryGate n, ∀ precision : Real, 0 < precision →
    ApproximatesModuloPhase generators target precision

/-- Dense generation entails finite-precision universality. -/
theorem finitePrecisionUniversal_of_dense {n : Type u} [Fintype n] [DecidableEq n]
    {generators : Set (UnitaryGate n)}
    (hdense : GeneratedUnitaryDense generators) :
    FinitePrecisionUniversal generators := by
  intro target precision hprecision
  apply approximatesModuloPhase_of_mem_generatedUnitaryTopologicalClosure _ hprecision
  rw [hdense]
  simp

/-- Projective generated density entails finite-precision universality. -/
theorem finitePrecisionUniversal_of_projectivelyGeneratedDense
    {n : Type u} [Fintype n] [DecidableEq n]
    {generators : Set (UnitaryGate n)}
    (hdense : ProjectivelyGeneratedDense generators) :
    FinitePrecisionUniversal generators := by
  intro target precision hprecision
  rcases hdense target with ⟨representative, hrepresentative, hphase⟩
  exact approximatesModuloPhase_of_globalPhaseEquivalent_mem_generatedUnitaryTopologicalClosure
    hphase hrepresentative hprecision

/-- Finite-precision universality is monotone under enlarging the generating set. -/
theorem finitePrecisionUniversal_mono {n : Type u} [Fintype n] [DecidableEq n]
    {generators generators' : Set (UnitaryGate n)}
    (h : generators ⊆ generators')
    (huniversal : FinitePrecisionUniversal generators) :
    FinitePrecisionUniversal generators' := by
  intro target precision hprecision
  exact approximatesModuloPhase_mono h (huniversal target precision hprecision)

/-- Finite-precision one-qubit universality. -/
def FinitePrecisionOneQubitUniversal
    (generators : Set (UnitaryGate (Fin 2))) : Prop :=
  FinitePrecisionUniversal generators

/-- Finite-precision universality on an `r`-qubit register of dimension `2^r`. -/
def FinitePrecisionRegisterUniversal (r : Nat)
    (generators : Set (UnitaryGate (Fin (2 ^ r)))) : Prop :=
  FinitePrecisionUniversal generators

/-- Density entails the one-qubit finite-precision interface. -/
theorem finitePrecisionOneQubitUniversal_of_dense
    {generators : Set (UnitaryGate (Fin 2))}
    (hdense : GeneratedUnitaryDense generators) :
    FinitePrecisionOneQubitUniversal generators :=
  finitePrecisionUniversal_of_dense hdense

/-- Projective generated density entails the one-qubit finite-precision interface. -/
theorem finitePrecisionOneQubitUniversal_of_projectivelyGeneratedDense
    {generators : Set (UnitaryGate (Fin 2))}
    (hdense : ProjectivelyGeneratedDense generators) :
    FinitePrecisionOneQubitUniversal generators :=
  finitePrecisionUniversal_of_projectivelyGeneratedDense hdense

/-- Density entails the finite-register finite-precision interface. -/
theorem finitePrecisionRegisterUniversal_of_dense (r : Nat)
    {generators : Set (UnitaryGate (Fin (2 ^ r)))}
    (hdense : GeneratedUnitaryDense generators) :
    FinitePrecisionRegisterUniversal r generators :=
  finitePrecisionUniversal_of_dense hdense

/-- The density action supplied by an existing semantic unitary transport. -/
noncomputable def transportDensity {H : Type u}
    [NormedAddCommGroup H] [InnerProductSpace Complex H] [FiniteQuantumSystem H]
    (U : UnitaryTransport H H) (rho : DensityOperator H) : DensityOperator H :=
  U.conjDensity rho

/-- The generated-universality density action is the semantic unitary conjugation action. -/
theorem transportDensity_toOperator {H : Type u}
    [NormedAddCommGroup H] [InnerProductSpace Complex H] [FiniteQuantumSystem H]
    (U : UnitaryTransport H H) (rho : DensityOperator H) :
    (transportDensity U rho).toOperator = U.conjOperator rho.toOperator :=
  rfl

end GeneratedUniversality
end Distillation
end QEC
