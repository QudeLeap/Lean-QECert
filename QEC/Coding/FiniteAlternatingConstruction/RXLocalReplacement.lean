      have hraw := congrArg Subtype.val (Sum.inl.inj hinl)
      change Vertex.x edge.1.1 = Vertex.z z at hraw
      cases hraw
    · have himpossible :
          (Sum.inr (Sum.inl
            (⟨Sum.inl edge, edgeMember⟩,
              ⟨segment.1 - 1, by have := segment.2; omega⟩)) :
              SubdivisionVertex P x S) =
