import QEC.Distillation.Triorthogonal.NoisyInjection
import QEC.Coding.Stabilizer.JointMeasurement
import QEC.Semantics.Core.Subsystem
import QEC.Semantics.Entropy.Purification
/-!
# The finite BH12 distillation subroutine

This module assembles the explicit even-family encoding, independent noisy
`T` layer, diagonal Clifford correction, full `G₀` syndrome instrument, raw
accept/reject endpoints, and accepted decoding.  The probability laws are
defined from the physical error words; normalized accepted quantities are
introduced only after a positive success proof.
-/

noncomputable section

namespace QEC
namespace Distillation
namespace Triorthogonal
namespace BH12Protocol

open Semantics
open Coding
open Coding.PauliSymplectic
open BH12EvenFamily
open BH12NoisyInjection
open scoped BigOperators

attribute [local instance 100] Fintype.ofFinite

universe u

/-- The `k = 2q` logical output register. -/
abbrev LogicalRegister (q : Nat) := Qubit.QubitRegister (OddRow q)

/-- The `n = 3k+8` physical register of the literal BH12 family. -/
abbrev PhysicalRegister (q : Nat) := Qubit.QubitRegister (Column q)

/-- A physical stochastic `Z`-error word. -/
abbrev PhysicalError (q : Nat) := Word (ZMod 2) (Column q)

/-- The visible three-bit `G₀` syndrome. -/
abbrev Syndrome := JointSyndrome EvenRow

/-- The three literal `X` checks generated by the even rows of `G(q)`. -/
def xChecks (q : Nat) (check : EvenRow) : Binary (Column q) :=
  cssXCheck (evenWord check)

theorem xChecks_commute (q : Nat) (left right : EvenRow) :
    Commutes (xChecks q left) (xChecks q right) :=
  cssXCheck_commutes_cssXCheck _ _

/-- The all-positive syndrome accepted by BH12. -/
def trivialSyndrome : Syndrome := fun _ => .positive

/-- The deterministic `G₀` syndrome carried by one physical `Z` error. -/
def syndromeOfError {q : Nat} (error : PhysicalError q) : Syndrome :=
  fun check =>
    if wordPairing (evenWord check) error = 0 then .positive else .negative

/-- Acceptance is literal orthogonality to every even row. -/
def Accepts {q : Nat} (error : PhysicalError q) : Prop :=
  syndromeOfError error = trivialSyndrome

instance {q : Nat} (error : PhysicalError q) : Decidable (Accepts error) :=
  inferInstanceAs (Decidable (syndromeOfError error = trivialSyndrome))

theorem accepts_iff_pairing_even_rows {q : Nat} (error : PhysicalError q) :
    Accepts error ↔ ∀ check, wordPairing (evenWord check) error = 0 := by
  constructor
  · intro h check
    have hs := congrFun h check
    simp only [syndromeOfError, trivialSyndrome] at hs
    split at hs
    · assumption
    · contradiction
  · intro h
    funext check
    simp [syndromeOfError, trivialSyndrome, h check]

/-- The operational acceptance test is exactly membership in `G₀⊥`. -/
theorem accepts_iff_mem_evenCode_dual {q : Nat} (error : PhysicalError q) :
    Accepts error ↔ error ∈ (family q).evenCode.dual.carrier := by
  rw [accepts_iff_pairing_even_rows, LinearCode.mem_dual]
  constructor
  · intro h word hword
    change word ∈ Submodule.span (ZMod 2) (Set.range (@evenWord q)) at hword
    induction hword using Submodule.span_induction with
    | mem word hword =>
        rcases hword with ⟨check, rfl⟩
        simpa [wordPairing_apply, dotProduct_comm] using h check
    | zero => simp
    | add left right _ _ hleft hright =>
        rw [(wordPairing error).map_add, hleft, hright, add_zero]
    | smul scalar word _ hword =>
        rw [(wordPairing error).map_smul, hword, smul_zero]
  · intro h check
    have := h (evenWord check) ((family q).evenRow_mem_evenCode check)
    simpa [wordPairing_apply, dotProduct_comm] using this

/-- Coarse-grain a full syndrome into the source accept/reject endpoint. -/
def syndromeOutcome (syndrome : Syndrome) : DistillationOutcome :=
  if syndrome = trivialSyndrome then .accepted else .rejected

@[simp] theorem syndromeOutcome_trivial :
    syndromeOutcome trivialSyndrome = .accepted := by
  simp [syndromeOutcome]

theorem syndromeOutcome_eq_accepted_iff (syndrome : Syndrome) :
    syndromeOutcome syndrome = .accepted ↔ syndrome = trivialSyndrome := by
  simp [syndromeOutcome]

theorem syndromeOutcome_eq_rejected_iff (syndrome : Syndrome) :
    syndromeOutcome syndrome = .rejected ↔ syndrome ≠ trivialSyndrome := by
  simp [syndromeOutcome]

/-- The actual full `G₀` projective syndrome instrument. -/
def fullSyndromeInstrument (q : Nat) :
    FiniteInstrument Syndrome Syndrome (PhysicalRegister q) (PhysicalRegister q) :=
  jointStabilizerInstrument (xChecks q) (xChecks_commute q)

/-- The same full syndrome measurement, observed only as accept/reject. -/
def protocolSyndromeInstrument (q : Nat) :
    FiniteInstrument Syndrome DistillationOutcome
      (PhysicalRegister q) (PhysicalRegister q) where
  kraus := jointStabilizerKrausFamily (xChecks q) (xChecks_commute q)
  observe := syndromeOutcome

@[simp] theorem protocolSyndromeInstrument_kraus (q : Nat) :
    (protocolSyndromeInstrument q).kraus =
      jointStabilizerKrausFamily (xChecks q) (xChecks_commute q) :=
  rfl

theorem protocolSyndromeInstrument_complete (q : Nat) :
    (protocolSyndromeInstrument q).kraus.Complete :=
  jointStabilizerKrausFamily_complete (xChecks q) (xChecks_commute q)

/-- Forgetting the syndrome gives the complete `G₀` measurement channel. -/
def syndromeMeasurementChannel (q : Nat) :
    QuantumChannel (PhysicalRegister q) (PhysicalRegister q) :=
  (protocolSyndromeInstrument q).kraus.toQuantumChannel
    (protocolSyndromeInstrument_complete q)

/-- The explicit physical inverse-`S`/controlled-`Z` correction channel. -/
def correctionChannel (q : Nat) :
    QuantumChannel (PhysicalRegister q) (PhysicalRegister q) :=
  QuantumChannel.unitaryConj (family q).physicalCliffordCorrection

/-- Independent noisy `T` injection followed by the BH12 correction. -/
def correctedNoisyTChannel (q : Nat) (p : ErrorParameter) :
    QuantumChannel (PhysicalRegister q) (PhysicalRegister q) :=
  QuantumChannel.comp (correctionChannel q)
    (independentNoisyTChannel (Index := Column q) p)

/-- The complete unconditioned operation through the full syndrome measurement. -/
def physicalOperation (q : Nat) (p : ErrorParameter) :
    QuantumChannel (PhysicalRegister q) (PhysicalRegister q) :=
  QuantumChannel.comp (syndromeMeasurementChannel q)
    (correctedNoisyTChannel q p)

private theorem encodedPlusAmbient_normSq (q : Nat) :
    ‖((family q).encodedPlusState (isTriorthogonal q) : PhysicalRegister q)‖ ^ 2 = 1 := by
  have hinner := (family q).encodedPlusState_inner_self (isTriorthogonal q)
  have hambient :
      inner Complex
          (((family q).encodedPlusState (isTriorthogonal q) :
            (family q).cssQuantumCode.carrier) : PhysicalRegister q)
          (((family q).encodedPlusState (isTriorthogonal q) :
            (family q).cssQuantumCode.carrier) : PhysicalRegister q) = 1 := by
    simpa using hinner
  rw [InnerProductSpace.norm_sq_eq_re_inner (𝕜 := Complex), hambient]
  norm_num

/-- The actual encoded logical `|+⟩^⊗k` preparation. -/
def encodedPlusInput (q : Nat) : DensityOperator (PhysicalRegister q) :=
  DensityOperator.pureDensity
    ((family q).encodedPlusState (isTriorthogonal q) : PhysicalRegister q)
    (encodedPlusAmbient_normSq q)

/-- State immediately before measuring the full `G₀` syndrome. -/
def preSyndromeState (q : Nat) (p : ErrorParameter) :
    DensityOperator (PhysicalRegister q) :=
  (correctedNoisyTChannel q p).mapDensity (encodedPlusInput q)

/-- Unnormalized raw endpoint retained even when its Born weight is zero. -/
def rawEndpoint (q : Nat) (p : ErrorParameter)
    (outcome : DistillationOutcome) : Operator (PhysicalRegister q) :=
  (protocolSyndromeInstrument q).branchOperator outcome (preSyndromeState q p).toOperator

/-- Born mass of a raw accept/reject endpoint. -/
def endpointWeight (q : Nat) (p : ErrorParameter)
    (outcome : DistillationOutcome) : ℝ :=
  (protocolSyndromeInstrument q).bornWeight outcome (preSyndromeState q p)

theorem endpointWeight_nonneg (q : Nat) (p : ErrorParameter)
    (outcome : DistillationOutcome) : 0 ≤ endpointWeight q p outcome :=
  (protocolSyndromeInstrument q).bornWeight_nonneg outcome (preSyndromeState q p)

theorem endpointWeight_sum (q : Nat) (p : ErrorParameter) :
    endpointWeight q p .accepted + endpointWeight q p .rejected = 1 := by
  have h := (protocolSyndromeInstrument q).sum_bornWeight_eq_one
    (protocolSyndromeInstrument_complete q) (preSyndromeState q p)
  rw [show (Finset.univ : Finset DistillationOutcome) =
      {.accepted, .rejected} by decide] at h
  simpa [endpointWeight] using h

/-- A zero-weight endpoint is the literal zero raw operator. -/
theorem rawEndpoint_eq_zero_of_weight_eq_zero (q : Nat) (p : ErrorParameter)
    (outcome : DistillationOutcome) (hzero : endpointWeight q p outcome = 0) :
    rawEndpoint q p outcome = 0 :=
  (protocolSyndromeInstrument q).branchOperator_eq_zero_of_bornWeight_eq_zero
    outcome (preSyndromeState q p) hzero

/-- Normalize only a genuinely positive endpoint. -/
def endpointConditional (q : Nat) (p : ErrorParameter)
    (outcome : DistillationOutcome) (hpos : 0 < endpointWeight q p outcome) :
    DensityOperator (PhysicalRegister q) :=
  (protocolSyndromeInstrument q).conditionalDensity outcome
    (preSyndromeState q p) hpos

@[simp] theorem endpointConditional_toOperator (q : Nat) (p : ErrorParameter)
    (outcome : DistillationOutcome) (hpos : 0 < endpointWeight q p outcome) :
    (endpointConditional q p outcome hpos).toOperator =
      ((endpointWeight q p outcome : Complex)⁻¹) • rawEndpoint q p outcome :=
  rfl

private theorem phaseAmplitude_nat_mul (theta : ℝ) (n : Nat) :
    OneQubitMagic.phaseAmplitude (n * theta) =
      OneQubitMagic.phaseAmplitude theta ^ n := by
  induction n with
  | zero => simp
  | succ n ih =>
      rw [Nat.cast_succ, add_mul, OneQubitMagic.phaseAmplitude_add,
        ih, one_mul, pow_succ]

/-- Raw logical `T` maps the equal superposition to the product magic state. -/
theorem allSiteT_logicalPlusState (q : Nat) :
    (allSiteT (Index := OddRow q))
        (BinaryRowFamily.logicalPlusState (OddRow q)) =
      BinaryRowFamily.logicalMagicState (OddRow q) := by
  ext bits
  rw [allSiteT_apply]
  simp only [BinaryRowFamily.logicalPlusState_apply,
    BinaryRowFamily.logicalMagicState_apply, BinaryRowFamily.piDivFourPhase]
  rw [show Real.pi / 4 *
      (HammingWeight (bitstringWordEquiv (OddRow q) bits) : Real) =
      (HammingWeight (bitstringWordEquiv (OddRow q) bits) : Nat) *
        (Real.pi / 4) by ring]
  rw [phaseAmplitude_nat_mul]
  ring

/-- Corrected transversal `T` maps the encoded plus preparation to encoded magic. -/
theorem correctedAllSiteT_encodedPlusState (q : Nat) :
    (family q).correctedAllSiteT
        ((family q).encodedPlusState (isTriorthogonal q) : PhysicalRegister q) =
      ((family q).encodedMagicState (isTriorthogonal q) : PhysicalRegister q) := by
  change (family q).correctedAllSiteT
      ((family q).encoding (isTriorthogonal q)
        (BinaryRowFamily.logicalPlusState (OddRow q)) : PhysicalRegister q) =
    ((family q).encoding (isTriorthogonal q)
      (BinaryRowFamily.logicalMagicState (OddRow q)) : PhysicalRegister q)
  rw [(family q).correctedAllSiteT_intertwines_encoding
    (isTriorthogonal q) (BinaryRowFamily.logicalPlusState (OddRow q))]
  rw [allSiteT_logicalPlusState]

/-- The normalized physical pure state in one independent error-word branch. -/
def errorBranchState {q : Nat} (error : PhysicalError q) : PhysicalRegister q :=
  toQubitOperator (cssZCheck error)
    ((family q).encodedMagicState (isTriorthogonal q) : PhysicalRegister q)

private theorem encodedMagicAmbient_normSq (q : Nat) :
    ‖((family q).encodedMagicState (isTriorthogonal q) : PhysicalRegister q)‖ ^ 2 = 1 := by
  have hinner := (family q).encodedMagicState_inner_self (isTriorthogonal q)
  have hambient :
      inner Complex
          (((family q).encodedMagicState (isTriorthogonal q) :
            (family q).cssQuantumCode.carrier) : PhysicalRegister q)
          (((family q).encodedMagicState (isTriorthogonal q) :
            (family q).cssQuantumCode.carrier) : PhysicalRegister q) = 1 := by
    simpa using hinner
  rw [InnerProductSpace.norm_sq_eq_re_inner (𝕜 := Complex), hambient]
  norm_num

theorem errorBranchState_normSq {q : Nat} (error : PhysicalError q) :
    ‖errorBranchState error‖ ^ 2 = 1 := by
  have hinner : inner Complex (errorBranchState error) (errorBranchState error) = 1 := by
    simp only [errorBranchState]
    rw [← LinearMap.adjoint_inner_left]
    have hunit := toQubitOperator_adjoint_comp_self (cssZCheck error)
    have happ :
        LinearMap.adjoint (toQubitOperator (cssZCheck error))
            (toQubitOperator (cssZCheck error)
              ((family q).encodedMagicState (isTriorthogonal q) : PhysicalRegister q)) =
          ((family q).encodedMagicState (isTriorthogonal q) : PhysicalRegister q) := by
      have := LinearMap.congr_fun hunit
        ((family q).encodedMagicState (isTriorthogonal q) : PhysicalRegister q)
      simpa [LinearMap.comp_apply] using this
    rw [happ]
    have hmagic := (family q).encodedMagicState_inner_self (isTriorthogonal q)
    simpa using hmagic
  rw [InnerProductSpace.norm_sq_eq_re_inner (𝕜 := Complex), hinner]
  norm_num

/-- Pure density in one physical independent-error branch. -/
def errorBranchDensity {q : Nat} (error : PhysicalError q) :
    DensityOperator (PhysicalRegister q) :=
  DensityOperator.pureDensity (errorBranchState error)
    (errorBranchState_normSq error)

private theorem sandwich_rankOne {H K : Type u}
    [NormedAddCommGroup H] [InnerProductSpace Complex H] [FiniteQuantumSystem H]
    [NormedAddCommGroup K] [InnerProductSpace Complex K] [FiniteQuantumSystem K]
    (L : H →ₗ[Complex] K) (psi : H) :
    L.comp ((InnerProductSpace.rankOne Complex psi psi).toLinearMap.comp
      (LinearMap.adjoint L)) =
      (InnerProductSpace.rankOne Complex (L psi) (L psi)).toLinearMap := by
  ext x
  simp [LinearMap.comp_apply, InnerProductSpace.rankOne_apply,
    LinearMap.adjoint_inner_right]

private theorem unitary_conj_rankOne {H K : Type u}
    [NormedAddCommGroup H] [InnerProductSpace Complex H] [FiniteQuantumSystem H]
    [NormedAddCommGroup K] [InnerProductSpace Complex K] [FiniteQuantumSystem K]
    (U : UnitaryTransport H K) (psi : H) :
    U.conjOperator
        (InnerProductSpace.rankOne Complex psi psi).toLinearMap =
      (InnerProductSpace.rankOne Complex (U psi) (U psi)).toLinearMap := by
  change U.toLinearEquiv.toLinearMap.comp
      ((InnerProductSpace.rankOne Complex psi psi).toLinearMap.comp
        U.toLinearEquiv.symm.toLinearMap) = _
  rw [← U.adjoint_toLinearMap]
  exact sandwich_rankOne U.toLinearEquiv.toLinearMap psi

private theorem selfAdjoint_sandwich_rankOne {H : Type u}
    [NormedAddCommGroup H] [InnerProductSpace Complex H] [FiniteQuantumSystem H]
    (L : Operator H) (hL : LinearMap.adjoint L = L) (psi : H) :
    L.comp ((InnerProductSpace.rankOne Complex psi psi).toLinearMap.comp L) =
      (InnerProductSpace.rankOne Complex (L psi) (L psi)).toLinearMap := by
  have h := sandwich_rankOne L psi
  rw [hL] at h
  exact h

private theorem correction_commutes_errorZ (q : Nat) (error : PhysicalError q)
    (psi : PhysicalRegister q) :
    (family q).physicalCliffordCorrection
        (toQubitOperator (cssZCheck error) psi) =
      toQubitOperator (cssZCheck error)
        ((family q).physicalCliffordCorrection psi) := by
  ext bits
  simp [BinaryRowFamily.physicalCliffordCorrection_apply,
    toQubitOperator_apply, cssZCheck, xSupport, zSupport]
  ring

/-- One physical Kraus branch really is corrected `T`, followed by its `Z` word. -/
theorem corrected_errorBranch_on_encodedPlus (q : Nat)
    (error : PhysicalError q) :
    (family q).physicalCliffordCorrection
        (registerBranchOperator error
          ((family q).encodedPlusState (isTriorthogonal q) : PhysicalRegister q)) =
      errorBranchState error := by
  rw [registerBranchOperator]
  change (family q).physicalCliffordCorrection
      (toQubitOperator (cssZCheck error)
        ((allSiteT (Index := Column q))
          ((family q).encodedPlusState (isTriorthogonal q) : PhysicalRegister q))) = _
  rw [correction_commutes_errorZ]
  change toQubitOperator (cssZCheck error)
      ((family q).correctedAllSiteT
        ((family q).encodedPlusState (isTriorthogonal q) : PhysicalRegister q)) = _
  rw [correctedAllSiteT_encodedPlusState]
  rfl

set_option maxHeartbeats 800000 in
/-- The pre-syndrome density is the actual independent mixture of physical branches. -/
theorem preSyndromeState_toOperator (q : Nat) (p : ErrorParameter) :
    (preSyndromeState q p).toOperator =
      ∑ error : PhysicalError q,
        (errorWordProbability p error : Complex) •
          (errorBranchDensity error).toOperator := by
  change (correctionChannel q)
      ((independentNoisyTChannel (Index := Column q) p)
        (encodedPlusInput q).toOperator) = _
  rw [independentNoisyTChannel_apply]
  rw [map_sum]
  apply Finset.sum_congr rfl
  intro error _
  rw [map_smul]
  congr 1
  rw [correctionChannel, QuantumChannel.unitaryConj_apply]
  rw [encodedPlusInput, DensityOperator.pureDensity_toOperator]
  rw [unitary_conj_rankOne]
  rw [show (toQubitOperator (cssZCheck error)).comp
      ((InnerProductSpace.rankOne Complex
        ((allSiteT (Index := Column q))
          ((family q).encodedPlusState (isTriorthogonal q) : PhysicalRegister q))
        ((allSiteT (Index := Column q))
          ((family q).encodedPlusState (isTriorthogonal q) : PhysicalRegister q))).toLinearMap.comp
        (toQubitOperator (cssZCheck error))) =
      (InnerProductSpace.rankOne Complex
        (registerBranchOperator error
          ((family q).encodedPlusState (isTriorthogonal q) : PhysicalRegister q))
        (registerBranchOperator error
          ((family q).encodedPlusState (isTriorthogonal q) : PhysicalRegister q))).toLinearMap by
    apply selfAdjoint_sandwich_rankOne
    rw [adjoint_toQubitOperator_eq_binaryDagger]
    simp]
  rw [show (family q).physicalCliffordCorrection.conjOperator
      (InnerProductSpace.rankOne Complex
        (registerBranchOperator error
          ((family q).encodedPlusState (isTriorthogonal q) : PhysicalRegister q))
        (registerBranchOperator error
          ((family q).encodedPlusState (isTriorthogonal q) : PhysicalRegister q))).toLinearMap =
      (InnerProductSpace.rankOne Complex
        ((family q).physicalCliffordCorrection
          (registerBranchOperator error
            ((family q).encodedPlusState (isTriorthogonal q) : PhysicalRegister q)))
        ((family q).physicalCliffordCorrection
          (registerBranchOperator error
            ((family q).encodedPlusState (isTriorthogonal q) : PhysicalRegister q)))).toLinearMap by
    exact unitary_conj_rankOne (family q).physicalCliffordCorrection _]
  rw [corrected_errorBranch_on_encodedPlus]
  rfl

private theorem encodedMagic_xCheck_fixed (q : Nat) (check : EvenRow) :
    toQubitOperator (xChecks q check)
        ((family q).encodedMagicState (isTriorthogonal q) : PhysicalRegister q) =
      ((family q).encodedMagicState (isTriorthogonal q) : PhysicalRegister q) := by
  apply (mem_binaryCSSQuantumCodeOfDualLe_carrier
    (family q).evenCode (family q).rowCode.dual
    (family q).cssDualContainment _).1
      ((family q).encodedMagicState (isTriorthogonal q)).property
  exact Or.inl ⟨evenWord check, (family q).evenRow_mem_evenCode check, rfl⟩

/-- Every error branch lies in the simultaneous eigenspace of its literal syndrome. -/
theorem errorBranchState_xCheck_eigen {q : Nat} (error : PhysicalError q)
    (check : EvenRow) :
    toHermitianQubitOperator (xChecks q check) (errorBranchState error) =
      (syndromeOfError error check).sign • errorBranchState error := by
  have hfixed := encodedMagic_xCheck_fixed q check
  have hHermitian :
      toHermitianQubitOperator (xChecks q check) =
        toQubitOperator (xChecks q check) := by
    simp [xChecks, toHermitianQubitOperator, hermitianPhaseScalar,
      binaryOverlapCount, binaryOverlapSupport, xSupport, zSupport]
  rw [hHermitian]
  have hfixed' :
      toQubitOperator (cssXCheck (evenWord check))
          ((family q).encodedMagicState (isTriorthogonal q) : PhysicalRegister q) =
        ((family q).encodedMagicState (isTriorthogonal q) : PhysicalRegister q) := by
    simpa [xChecks] using hfixed
  by_cases hpair : wordPairing (evenWord check) error = 0
  · have hcomm :=
      cssXCheck_toQubitOperator_commute_cssZCheck_of_wordPairing_eq_zero hpair
    have happ := LinearMap.congr_fun hcomm
      ((family q).encodedMagicState (isTriorthogonal q) : PhysicalRegister q)
    rw [Module.End.mul_apply, Module.End.mul_apply, hfixed'] at happ
    rw [syndromeOfError, if_pos hpair]
    simp only [StabilizerOutcome.sign, one_smul]
    change toQubitOperator (xChecks q check)
        (toQubitOperator (cssZCheck error)
          ((family q).encodedMagicState (isTriorthogonal q) : PhysicalRegister q)) = _
    simpa [xChecks, errorBranchState] using happ
  · have hnotcomm :
        ¬ Commutes (cssXCheck (evenWord check)) (cssZCheck error) := by
      simpa [cssXCheck, cssZCheck, Commutes,
        symplecticForm_x_zero_zero_z_eq_wordPairing] using hpair
    have hanti := toQubitOperator_anticommute_of_not_commutes
      (cssXCheck (evenWord check)) (cssZCheck error) hnotcomm
    have happ := LinearMap.congr_fun hanti
      ((family q).encodedMagicState (isTriorthogonal q) : PhysicalRegister q)
    simp only [LinearMap.neg_apply, Module.End.mul_apply] at happ
    rw [hfixed'] at happ
    rw [syndromeOfError, if_neg hpair]
    simp only [StabilizerOutcome.sign, neg_one_smul]
    change toQubitOperator (xChecks q check)
        (toQubitOperator (cssZCheck error)
          ((family q).encodedMagicState (isTriorthogonal q) : PhysicalRegister q)) = _
    simpa [xChecks, errorBranchState] using happ

/-- The matching full joint-syndrome projector fixes its physical branch. -/
theorem matchingSyndromeProjector_errorBranchState {q : Nat}
    (error : PhysicalError q) :
    jointStabilizerProjector (xChecks q) (xChecks_commute q)
        (syndromeOfError error) (errorBranchState error) =
      errorBranchState error := by
  apply (jointStabilizerProjector_fixed_iff
    (xChecks q) (xChecks_commute q) (syndromeOfError error)
      (errorBranchState error)).2
  exact errorBranchState_xCheck_eigen error

/-- Every nonmatching full syndrome annihilates the branch. -/
theorem nonmatchingSyndromeProjector_errorBranchState {q : Nat}
    (error : PhysicalError q) (syndrome : Syndrome)
    (hne : syndrome ≠ syndromeOfError error) :
    jointStabilizerProjector (xChecks q) (xChecks_commute q)
        syndrome (errorBranchState error) = 0 := by
  have hmul := jointStabilizerProjector_mul_of_ne
    (xChecks q) (xChecks_commute q) syndrome (syndromeOfError error) hne
  have happ := LinearMap.congr_fun hmul (errorBranchState error)
  rw [Module.End.mul_apply, matchingSyndromeProjector_errorBranchState] at happ
  simpa using happ

private theorem syndrome_sandwich_errorBranchDensity {q : Nat}
    (error : PhysicalError q) (syndrome : Syndrome) :
    let projector :=
      jointStabilizerProjector (xChecks q) (xChecks_commute q) syndrome
    projector.comp ((errorBranchDensity error).toOperator.comp
        (LinearMap.adjoint projector)) =
      if syndrome = syndromeOfError error
        then (errorBranchDensity error).toOperator else 0 := by
  dsimp only
  rw [jointStabilizerProjector_adjoint]
  rw [errorBranchDensity, DensityOperator.pureDensity_toOperator]
  rw [selfAdjoint_sandwich_rankOne _
    (jointStabilizerProjector_adjoint (xChecks q) (xChecks_commute q) syndrome)]
  by_cases hmatch : syndrome = syndromeOfError error
  · subst syndrome
    rw [matchingSyndromeProjector_errorBranchState]
    simp
  · rw [nonmatchingSyndromeProjector_errorBranchState error syndrome hmatch]
    simp [hmatch]

/-- The coarse instrument selects exactly the deterministic syndrome endpoint. -/
theorem protocolBranch_errorBranchDensity (q : Nat) (error : PhysicalError q)
    (outcome : DistillationOutcome) :
    (protocolSyndromeInstrument q).branchOperator outcome
        (errorBranchDensity error).toOperator =
      if syndromeOutcome (syndromeOfError error) = outcome
        then (errorBranchDensity error).toOperator else 0 := by
  classical
  rw [FiniteInstrument.branchOperator_apply]
  simp only [protocolSyndromeInstrument, jointStabilizerKrausFamily_operator]
  simp_rw [syndrome_sandwich_errorBranchDensity]
  by_cases hvisible : syndromeOutcome (syndromeOfError error) = outcome
  · rw [if_pos hvisible]
    rw [Fintype.sum_eq_single (syndromeOfError error)]
    · simp [hvisible]
    · intro syndrome hne
      simp [hne]
  · rw [if_neg hvisible]
    apply Finset.sum_eq_zero
    intro syndrome _
    by_cases hmatch : syndrome = syndromeOfError error
    · subst syndrome
      simp [hvisible]
    · simp [hmatch]

private noncomputable def protocolBranchLinearMap (q : Nat)
    (outcome : DistillationOutcome) :
    Operator (PhysicalRegister q) →ₗ[Complex] Operator (PhysicalRegister q) where
  toFun := (protocolSyndromeInstrument q).branchOperator outcome
  map_add' := by
    intro A B
    classical
    simp only [FiniteInstrument.branchOperator_apply]
    rw [← Finset.sum_add_distrib]
    apply Finset.sum_congr rfl
    intro syndrome _
    by_cases hobserve :
        (protocolSyndromeInstrument q).observe syndrome = outcome
    · simp only [hobserve, if_true]
      apply LinearMap.ext
      intro psi
      simp [LinearMap.comp_apply, map_add]
    · simp [hobserve]
  map_smul' := by
    intro scalar A
    classical
    simp only [FiniteInstrument.branchOperator_apply]
    rw [Finset.smul_sum]
    apply Finset.sum_congr rfl
    intro syndrome _
    by_cases hobserve :
        (protocolSyndromeInstrument q).observe syndrome = outcome
    · simp only [hobserve, if_true]
      apply LinearMap.ext
      intro psi
      simp [LinearMap.comp_apply]
    · simp [hobserve]

private theorem protocolBranch_weightedBranchSum (q : Nat) (p : ErrorParameter)
    (outcome : DistillationOutcome) :
    (protocolSyndromeInstrument q).branchOperator outcome
        (∑ error : PhysicalError q,
          (errorWordProbability p error : Complex) •
            (errorBranchDensity error).toOperator) =
      ∑ error : PhysicalError q,
        (errorWordProbability p error : Complex) •
          (protocolSyndromeInstrument q).branchOperator outcome
            (errorBranchDensity error).toOperator := by
  classical
  change protocolBranchLinearMap q outcome
      (∑ error : PhysicalError q,
        (errorWordProbability p error : Complex) •
          (errorBranchDensity error).toOperator) = _
  rw [map_sum]
  apply Finset.sum_congr rfl
  intro error _
  rw [map_smul]
  rfl

/-- Raw physical endpoints are the corresponding independent error-word sums. -/
theorem rawEndpoint_eq_errorWordSum (q : Nat) (p : ErrorParameter)
    (outcome : DistillationOutcome) :
    rawEndpoint q p outcome =
      ∑ error : PhysicalError q,
        if syndromeOutcome (syndromeOfError error) = outcome then
          (errorWordProbability p error : Complex) •
            (errorBranchDensity error).toOperator
        else 0 := by
  rw [rawEndpoint, preSyndromeState_toOperator,
    protocolBranch_weightedBranchSum]
  apply Finset.sum_congr rfl
  intro error _
  rw [protocolBranch_errorBranchDensity]
  split_ifs <;> simp

theorem rawAcceptedEndpoint_eq_errorWordSum (q : Nat) (p : ErrorParameter) :
    rawEndpoint q p .accepted =
      ∑ error : PhysicalError q,
        if Accepts error then
          (errorWordProbability p error : Complex) •
            (errorBranchDensity error).toOperator
        else 0 := by
  rw [rawEndpoint_eq_errorWordSum]
  apply Finset.sum_congr rfl
  intro error _
  simp only [syndromeOutcome_eq_accepted_iff, Accepts]
  by_cases haccept : syndromeOfError error = trivialSyndrome <;>
    simp [haccept]

theorem rawRejectedEndpoint_eq_errorWordSum (q : Nat) (p : ErrorParameter) :
    rawEndpoint q p .rejected =
      ∑ error : PhysicalError q,
        if Accepts error then 0 else
          (errorWordProbability p error : Complex) •
            (errorBranchDensity error).toOperator := by
  rw [rawEndpoint_eq_errorWordSum]
  apply Finset.sum_congr rfl
  intro error _
  simp only [syndromeOutcome_eq_rejected_iff, Accepts]
  by_cases haccept : syndromeOfError error = trivialSyndrome <;>
    simp [haccept]

/-- The raw Bernoulli mass of accepted physical words. -/
def rawSuccessMass (q : Nat) (p : ErrorParameter) : ℝ :=
  ∑ error : PhysicalError q,
    if Accepts error then errorWordProbability p error else 0

/-- The real-valued sign of one binary field element. -/
private def realBinarySign (bit : ZMod 2) : ℝ :=
  if bit = 0 then 1 else -1

private theorem realBinarySign_add (left right : ZMod 2) :
    realBinarySign (left + right) =
      realBinarySign left * realBinarySign right := by
  by_cases hleft : left = 0
  · subst left
    simp [realBinarySign]
  · have hleftOne := zmod_two_eq_one_of_ne_zero hleft
    subst left
    by_cases hright : right = 0
    · subst right
      simp [realBinarySign]
    · have hrightOne := zmod_two_eq_one_of_ne_zero hright
      subst right
      have hone_add_one : (1 : ZMod 2) + 1 = 0 := by decide
      have hone_ne_zero : (1 : ZMod 2) ≠ 0 := by decide
      simp [realBinarySign, hone_add_one, hone_ne_zero]

private noncomputable instance evenCodeDualMembershipDecidable (q : Nat) :
    DecidablePred (fun error : PhysicalError q =>
      error ∈ (family q).evenCode.dual.carrier) :=
  Classical.decPred _

private theorem realBinarySign_add_of_ne_zero (left right : ZMod 2)
    (hright : right ≠ 0) :
    realBinarySign (left + right) = -realBinarySign left := by
  rw [realBinarySign_add]
  have hsign : realBinarySign right = -1 := by
    simp [realBinarySign, hright]
  rw [hsign]
  ring

/-- Translation by an actual `G₀` codeword, with subtraction as its inverse. -/
private def evenCodeTranslate {q : Nat}
    (word : (family q).evenCode.carrier) :
    (family q).evenCode.carrier ≃ (family q).evenCode.carrier where
  toFun := fun codeword => codeword + word
  invFun := fun codeword => codeword - word
  left_inv := by
    intro codeword
    exact add_sub_cancel_right codeword word
  right_inv := by
    intro codeword
    exact sub_add_cancel codeword word

@[simp] private theorem coe_evenCodeTranslate_apply {q : Nat}
    (word codeword : (family q).evenCode.carrier) :
    ((evenCodeTranslate word codeword : (family q).evenCode.carrier) :
      PhysicalError q) = (codeword : PhysicalError q) + word :=
  rfl

/-- The real-valued binary additive character used for the finite `G₀`
Fourier/MacWilliams calculation. -/
def evenCodeBinaryCharacter {q : Nat}
    (codeword : (family q).evenCode.carrier) (error : PhysicalError q) : ℝ :=
  realBinarySign (wordPairing (codeword : PhysicalError q) error)

private theorem evenCodeBinaryCharacter_translate {q : Nat}
    (word codeword : (family q).evenCode.carrier) (error : PhysicalError q)
    (hword : wordPairing (word : PhysicalError q) error ≠ 0) :
    evenCodeBinaryCharacter (evenCodeTranslate word codeword) error =
      -evenCodeBinaryCharacter codeword error := by
  unfold evenCodeBinaryCharacter
  change realBinarySign
      (wordPairing
        ((codeword : PhysicalError q) + (word : PhysicalError q)) error) = _
  rw [map_add]
  exact realBinarySign_add_of_ne_zero _ _ hword

/-- Finite binary character orthogonality: summing over the actual `G₀`
carrier detects precisely its dual carrier. -/
theorem evenCode_binaryCharacter_sum (q : Nat) (error : PhysicalError q) :
    (∑ codeword : (family q).evenCode.carrier,
      evenCodeBinaryCharacter codeword error) =
      if error ∈ (family q).evenCode.dual.carrier then
        Fintype.card (family q).evenCode.carrier else 0 := by
  classical
  letI : Fintype (family q).evenCode.carrier := Fintype.ofFinite _
  by_cases hdual : error ∈ (family q).evenCode.dual.carrier
  · have horth (codeword : (family q).evenCode.carrier) :
        wordPairing (codeword : PhysicalError q) error = 0 :=
      LinearCode.dual_orthogonal (family q).evenCode codeword.property hdual
    rw [if_pos hdual]
    simp [evenCodeBinaryCharacter, realBinarySign, horth]
  · obtain ⟨word, hword, hpair⟩ :=
      exists_carrier_wordPairing_ne_zero_of_not_mem_dual (family q).evenCode hdual
    let carrierWord : (family q).evenCode.carrier := ⟨word, hword⟩
    have hpair' : wordPairing (carrierWord : PhysicalError q) error ≠ 0 := by
      simpa [wordPairing_apply, dotProduct_comm] using hpair
    have htranslate :
        (∑ codeword : (family q).evenCode.carrier,
          evenCodeBinaryCharacter codeword error) =
        ∑ codeword : (family q).evenCode.carrier,
          evenCodeBinaryCharacter (evenCodeTranslate carrierWord codeword) error := by
      symm
      exact (evenCodeTranslate carrierWord).sum_comp
        (fun codeword => evenCodeBinaryCharacter codeword error)
    rw [if_neg hdual]
    have hneg :
        (∑ codeword : (family q).evenCode.carrier,
          evenCodeBinaryCharacter codeword error) =
        -(∑ codeword : (family q).evenCode.carrier,
          evenCodeBinaryCharacter codeword error) := by
      calc
        (∑ codeword : (family q).evenCode.carrier,
          evenCodeBinaryCharacter codeword error) =
            ∑ codeword : (family q).evenCode.carrier,
              evenCodeBinaryCharacter (evenCodeTranslate carrierWord codeword) error :=
          htranslate
        _ = ∑ codeword : (family q).evenCode.carrier,
              -evenCodeBinaryCharacter codeword error := by
          apply Finset.sum_congr rfl
          intro codeword _
          exact evenCodeBinaryCharacter_translate carrierWord codeword error hpair'
        _ = -(∑ codeword : (family q).evenCode.carrier,
              evenCodeBinaryCharacter codeword error) := by
          rw [Finset.sum_neg_distrib]
    simpa using (CharZero.eq_neg_self_iff.mp hneg)

private theorem realBinarySign_sum_eq_prod {ι : Type*} [DecidableEq ι]
    (sites : Finset ι) (term : ι → ZMod 2) :
    realBinarySign (∑ site ∈ sites, term site) =
      ∏ site ∈ sites, realBinarySign (term site) := by
  induction sites using Finset.induction_on with
  | empty => simp [realBinarySign]
  | insert site sites hsite ih =>
      rw [Finset.sum_insert hsite, Finset.prod_insert hsite,
        realBinarySign_add, ih]

private theorem evenCodeBinaryCharacter_eq_coordinateProduct {q : Nat}
    (codeword : (family q).evenCode.carrier) (error : PhysicalError q) :
    evenCodeBinaryCharacter codeword error =
      ∏ site, realBinarySign ((codeword : PhysicalError q) site * error site) := by
  unfold evenCodeBinaryCharacter
  rw [wordPairing_apply, dotProduct]
  simpa using realBinarySign_sum_eq_prod (Finset.univ : Finset (Column q))
    (fun site => (codeword : PhysicalError q) site * error site)

private theorem bernoulliCharacter_coordinate_sum (p : ErrorParameter)
    (codewordBit : ZMod 2) :
    (∑ errorBit : ZMod 2,
      (if errorBit = 0 then p.cleanWeight else p.rate) *
        realBinarySign (codewordBit * errorBit)) =
      if codewordBit = 0 then 1 else 1 - 2 * p.rate := by
  rw [show (Finset.univ : Finset (ZMod 2)) = {0, 1} by decide]
  by_cases hcodeword : codewordBit = 0
  · subst codewordBit
    simp [realBinarySign, ErrorParameter.cleanWeight]
  · have hcodewordOne := zmod_two_eq_one_of_ne_zero hcodeword
    subst codewordBit
    have hone_ne_zero : (1 : ZMod 2) ≠ 0 := by decide
    simp [realBinarySign, ErrorParameter.cleanWeight, hone_ne_zero]
    ring

private theorem hammingWeight_product_of_zero_one {q : Nat}
    (weight : ℝ) (word : PhysicalError q) :
    (∏ site, if word site = 0 then 1 else weight) =
      weight ^ HammingWeight word := by
  classical
  let support := hammingSupport word
  have hdisjoint : Disjoint support (Finset.univ \ support) := by
    exact Finset.disjoint_sdiff
  have hunion : support ∪ (Finset.univ \ support) = Finset.univ := by
    simp
  have hsupp_card : support.card = HammingWeight word := by
    rfl
  calc
    (∏ site, if word site = 0 then 1 else weight) =
        (∏ site ∈ support, if word site = 0 then 1 else weight) *
          ∏ site ∈ Finset.univ \ support, if word site = 0 then 1 else weight := by
      rw [← Finset.prod_union hdisjoint, hunion]
    _ = (∏ _site ∈ support, weight) *
          ∏ _site ∈ Finset.univ \ support, 1 := by
      congr 1
      · apply Finset.prod_congr rfl
        intro site hsite
        have hnonzero : word site ≠ 0 := by
          simpa [support, hammingSupport] using hsite
        simp [hnonzero]
      · apply Finset.prod_congr rfl
        intro site hsite
        have hzero : word site = 0 := by
          by_contra hnonzero
          exact (Finset.mem_sdiff.mp hsite).2
            (by simp [support, hammingSupport, hnonzero])
        simp [hzero]
    _ = weight ^ HammingWeight word := by
      simp [hsupp_card]

private theorem bernoulliCharacter_transform (q : Nat) (p : ErrorParameter)
    (codeword : PhysicalError q) :
    (∑ error : PhysicalError q,
      errorWordProbability p error *
        realBinarySign (wordPairing codeword error)) =
      (1 - 2 * p.rate) ^ HammingWeight codeword := by
  classical
  have h := Finset.sum_prod_piFinset
    (R := ℝ) (ι := Column q) (κ := ZMod 2)
    (s := Finset.univ)
    (g := fun site errorBit =>
      (if errorBit = 0 then p.cleanWeight else p.rate) *
        realBinarySign (codeword site * errorBit))
  calc
    (∑ error : PhysicalError q,
      errorWordProbability p error *
        realBinarySign (wordPairing codeword error)) =
        ∑ error : PhysicalError q,
          ∏ site,
            (if error site = 0 then p.cleanWeight else p.rate) *
              realBinarySign (codeword site * error site) := by
      apply Finset.sum_congr rfl
      intro error _
      rw [errorWordProbability, wordPairing_apply, dotProduct,
        realBinarySign_sum_eq_prod, Finset.prod_mul_distrib]
    _ = ∏ site,
        ∑ errorBit : ZMod 2,
          (if errorBit = 0 then p.cleanWeight else p.rate) *
            realBinarySign (codeword site * errorBit) := by
      simpa using h
    _ = ∏ site, if codeword site = 0 then 1 else 1 - 2 * p.rate := by
      apply Finset.prod_congr rfl
      intro site _
      exact bernoulliCharacter_coordinate_sum p (codeword site)
    _ = (1 - 2 * p.rate) ^ HammingWeight codeword :=
      hammingWeight_product_of_zero_one (1 - 2 * p.rate) codeword

private theorem evenCode_carrier_card (q : Nat) :
    Fintype.card (family q).evenCode.carrier = 8 := by
  calc
    Fintype.card (family q).evenCode.carrier =
        Fintype.card (EvenRow → ZMod 2) :=
      Fintype.card_congr (evenCoefficientLinearEquiv q).toEquiv.symm
    _ = Fintype.card (Fin 8) :=
      Fintype.card_congr coefficientEquiv.symm
    _ = 8 := Fintype.card_fin 8

private theorem sum_dite_submodule_real
    {R M : Type*} [Ring R] [AddCommGroup M] [Module R M]
    [Fintype M] (S : Submodule R M) [Fintype S]
    [DecidablePred fun x : M => x ∈ S] (f : S → ℝ) :
    (∑ x : M, if hx : x ∈ S then f ⟨x, hx⟩ else 0) =
      ∑ x : S, f x := by
  classical
  let g : M → ℝ := fun x => if hx : x ∈ S then f ⟨x, hx⟩ else 0
  have h := Finset.sum_subtype (p := fun x : M => x ∈ S) (F := inferInstance)
    (Finset.univ.filter fun x : M => x ∈ S) (by simp) g
  have hsub :
      ∑ x ∈ Finset.univ.filter (fun x : M => x ∈ S), g x =
        ∑ x : S, f x := by
    simpa [g] using h
  have hall :
      ∑ x ∈ Finset.univ.filter (fun x : M => x ∈ S), g x =
        ∑ x : M, g x := by
    apply Finset.sum_subset (Finset.filter_subset _ _)
    intro x _hx hxnot
    have hxS : x ∉ S := by simpa using hxnot
    simp [g, hxS]
  exact hall.symm.trans hsub

private theorem sum_dite_evenCodeDual (q : Nat)
    (f : (family q).evenCode.dual.carrier → ℝ) :
    (∑ error : PhysicalError q,
      if herror : error ∈ (family q).evenCode.dual.carrier then
        f ⟨error, herror⟩ else 0) =
      ∑ error : (family q).evenCode.dual.carrier, f error := by
  exact sum_dite_submodule_real (family q).evenCode.dual.carrier f

private theorem evenCode_dual_indicator_eq_character_average (q : Nat)
    (error : PhysicalError q) :
    (if error ∈ (family q).evenCode.dual.carrier then (1 : ℝ) else 0) =
      (8 : ℝ)⁻¹ *
        ∑ codeword : (family q).evenCode.carrier,
          evenCodeBinaryCharacter codeword error := by
  rw [evenCode_binaryCharacter_sum, evenCode_carrier_card]
  by_cases hdual : error ∈ (family q).evenCode.dual.carrier <;>
    simp only [hdual, if_true, if_false, Nat.cast_ofNat, Nat.cast_zero, mul_zero] <;>
      norm_num

/-- The finite binary character calculation turns the literal `G₀⊥`
Bernoulli sum into the actual `G₀` weight sum. -/
theorem evenCode_dual_bernoulliMass_eq_weightSum (q : Nat)
    (p : ErrorParameter) :
    (∑ error : (family q).evenCode.dual.carrier,
      errorWordProbability p (error : PhysicalError q)) =
      (8 : ℝ)⁻¹ *
        codeWeightSum (family q).evenCode
          (fun weight => (1 - 2 * p.rate) ^ weight) := by
  classical
  calc
    (∑ error : (family q).evenCode.dual.carrier,
      errorWordProbability p (error : PhysicalError q)) =
        ∑ error : PhysicalError q,
          if herror : error ∈ (family q).evenCode.dual.carrier then
            errorWordProbability p error else 0 := by
      symm
      simpa using sum_dite_evenCodeDual q
        (fun error => errorWordProbability p (error : PhysicalError q))
    _ = ∑ error : PhysicalError q,
          errorWordProbability p error *
            (if error ∈ (family q).evenCode.dual.carrier then (1 : ℝ) else 0) := by
      apply Finset.sum_congr rfl
      intro error _
      by_cases hdual : error ∈ (family q).evenCode.dual.carrier <;>
        simp only [hdual, dite_true, dite_false, if_true, if_false, mul_one, mul_zero]
    _ = ∑ error : PhysicalError q,
          errorWordProbability p error *
            ((8 : ℝ)⁻¹ *
              ∑ codeword : (family q).evenCode.carrier,
                evenCodeBinaryCharacter codeword error) := by
      apply Finset.sum_congr rfl
      intro error _
      rw [evenCode_dual_indicator_eq_character_average]
      apply congrArg (errorWordProbability p error * ·)
      apply congrArg ((8 : ℝ)⁻¹ * ·)
      apply Finset.sum_congr
      · ext codeword
        simp
      · intro codeword _
        rfl
    _ = (8 : ℝ)⁻¹ *
          ∑ codeword : (family q).evenCode.carrier,
            ∑ error : PhysicalError q,
              errorWordProbability p error *
                evenCodeBinaryCharacter codeword error := by
      calc
        (∑ error : PhysicalError q,
          errorWordProbability p error *
            ((8 : ℝ)⁻¹ *
              ∑ codeword : (family q).evenCode.carrier,
                evenCodeBinaryCharacter codeword error)) =
            ∑ error : PhysicalError q,
              ∑ codeword : (family q).evenCode.carrier,
                (8 : ℝ)⁻¹ *
                  (errorWordProbability p error *
                    evenCodeBinaryCharacter codeword error) := by
              apply Finset.sum_congr rfl
              intro error _
              calc
                errorWordProbability p error *
                    ((8 : ℝ)⁻¹ *
                      ∑ codeword : (family q).evenCode.carrier,
                        evenCodeBinaryCharacter codeword error) =
                    (8 : ℝ)⁻¹ *
                      (errorWordProbability p error *
                        ∑ codeword : (family q).evenCode.carrier,
                          evenCodeBinaryCharacter codeword error) := by
                  ring
                _ = (8 : ℝ)⁻¹ *
                      ∑ codeword : (family q).evenCode.carrier,
                        errorWordProbability p error *
                          evenCodeBinaryCharacter codeword error := by
                  rw [Finset.mul_sum]
                _ = ∑ codeword : (family q).evenCode.carrier,
                      (8 : ℝ)⁻¹ *
                        (errorWordProbability p error *
                          evenCodeBinaryCharacter codeword error) := by
                  rw [Finset.mul_sum]
        _ = (8 : ℝ)⁻¹ *
            ∑ codeword : (family q).evenCode.carrier,
              ∑ error : PhysicalError q,
                errorWordProbability p error *
                  evenCodeBinaryCharacter codeword error := by
              rw [Finset.sum_comm, Finset.mul_sum]
              apply Finset.sum_congr rfl
              intro codeword _
              rw [Finset.mul_sum]
    _ = (8 : ℝ)⁻¹ *
          ∑ codeword : (family q).evenCode.carrier,
            (1 - 2 * p.rate) ^ HammingWeight
              (codeword : PhysicalError q) := by
      apply congrArg
        ((8 : ℝ)⁻¹ * ·)
      apply Finset.sum_congr rfl
      intro codeword _
      simpa [evenCodeBinaryCharacter] using
        bernoulliCharacter_transform q p (codeword : PhysicalError q)
    _ = (8 : ℝ)⁻¹ *
          codeWeightSum (family q).evenCode
            (fun weight => (1 - 2 * p.rate) ^ weight) := by
      apply congrArg ((8 : ℝ)⁻¹ * ·)
      unfold codeWeightSum
      apply Finset.sum_congr
      · ext codeword
        simp
      · intro codeword _
        rfl

/-- The raw accepted physical mass is the dual-code Bernoulli sum evaluated
through the finite binary character bridge. -/
theorem rawSuccessMass_eq_evenCode_weightSum (q : Nat)
    (p : ErrorParameter) :
    rawSuccessMass q p =
      (8 : ℝ)⁻¹ *
        codeWeightSum (family q).evenCode
          (fun weight => (1 - 2 * p.rate) ^ weight) := by
  classical
  rw [rawSuccessMass]
  calc
    (∑ error : PhysicalError q,
      if Accepts error then errorWordProbability p error else 0) =
        ∑ error : PhysicalError q,
          if herror : error ∈ (family q).evenCode.dual.carrier then
            errorWordProbability p
              ((⟨error, herror⟩ : (family q).evenCode.dual.carrier) :
                PhysicalError q)
          else 0 := by
      apply Finset.sum_congr rfl
      intro error _
      by_cases hdual : error ∈ (family q).evenCode.dual.carrier <;>
        simp only [accepts_iff_mem_evenCode_dual, hdual,
          dite_true, dite_false, if_true, if_false]
    _ = ∑ error : (family q).evenCode.dual.carrier,
          errorWordProbability p (error : PhysicalError q) :=
      sum_dite_evenCodeDual q
        (fun error => errorWordProbability p (error : PhysicalError q))
    _ = (8 : ℝ)⁻¹ *
          codeWeightSum (family q).evenCode
            (fun weight => (1 - 2 * p.rate) ^ weight) :=
      evenCode_dual_bernoulliMass_eq_weightSum q p

/-- Specializing the character bridge with the concrete BH12 `G₀`
enumerator gives the exact raw success mass. -/
theorem rawSuccessMass_eq_evenFamilyWeightSum (q : Nat)
    (p : ErrorParameter) :
    rawSuccessMass q p =
      (8 : ℝ)⁻¹ *
        (1 + (1 - 2 * p.rate) ^ 8 +
          6 * (1 - 2 * p.rate) ^ (4 + 4 * q)) := by
  rw [rawSuccessMass_eq_evenCode_weightSum, evenCode_weightSum]
  simp [nsmul_eq_mul]

/-- The raw Bernoulli mass of rejected physical words. -/
def rawRejectMass (q : Nat) (p : ErrorParameter) : ℝ :=
  ∑ error : PhysicalError q,
    if Accepts error then 0 else errorWordProbability p error

/-- The accepted Born weight is exactly the raw accepted error-word mass. -/
theorem endpointWeight_accepted_eq_rawSuccessMass (q : Nat) (p : ErrorParameter) :
    endpointWeight q p .accepted = rawSuccessMass q p := by
  rw [endpointWeight, FiniteInstrument.bornWeight]
  change Complex.re (LinearMap.trace Complex (PhysicalRegister q)
    (rawEndpoint q p .accepted)) = _
  rw [rawAcceptedEndpoint_eq_errorWordSum, map_sum, Complex.re_sum]
  rw [rawSuccessMass]
  apply Finset.sum_congr rfl
  intro error _
  by_cases haccept : Accepts error
  · simp only [haccept, if_true, map_smul]
    rw [(errorBranchDensity error).trace_one]
    simp
  · simp [haccept]

/-- The rejected Born weight is exactly the complementary raw error-word mass. -/
theorem endpointWeight_rejected_eq_rawRejectMass (q : Nat) (p : ErrorParameter) :
    endpointWeight q p .rejected = rawRejectMass q p := by
  rw [endpointWeight, FiniteInstrument.bornWeight]
  change Complex.re (LinearMap.trace Complex (PhysicalRegister q)
    (rawEndpoint q p .rejected)) = _
  rw [rawRejectedEndpoint_eq_errorWordSum, map_sum, Complex.re_sum]
  rw [rawRejectMass]
  apply Finset.sum_congr rfl
  intro error _
  by_cases haccept : Accepts error
  · simp [haccept]
  · simp only [haccept, if_false, map_smul]
    rw [(errorBranchDensity error).trace_one]
    simp

/-- The concrete BH12 encoding, viewed in the ambient physical register. -/
def ambientEncodingIsometry (q : Nat) :
    LogicalRegister q →ₗᵢ[Complex] PhysicalRegister q :=
  (family q).cssQuantumCode.carrier.subtypeₗᵢ.comp
    ((family q).encoding (isTriorthogonal q)).toLinearIsometry

@[simp] theorem ambientEncodingIsometry_apply (q : Nat)
    (psi : LogicalRegister q) :
    ambientEncodingIsometry q psi =
      ((family q).encoding (isTriorthogonal q) psi : PhysicalRegister q) :=
  rfl

/-- The inverse-encoding Kraus branch on the actual code carrier. -/
def codeDecoderBranch (q : Nat) :
    PhysicalRegister q →ₗ[Complex] LogicalRegister q :=
  LinearMap.adjoint (ambientEncodingIsometry q).toLinearMap

@[simp] theorem codeDecoderBranch_encoded (q : Nat)
    (psi : LogicalRegister q) :
    codeDecoderBranch q (ambientEncodingIsometry q psi) = psi := by
  change LinearMap.adjoint (ambientEncodingIsometry q).toLinearMap
    ((ambientEncodingIsometry q).toLinearMap psi) = psi
  exact LinearMap.congr_fun (ambientEncodingIsometry q).adjoint_comp_self' psi

theorem adjoint_codeDecoderBranch (q : Nat) :
    LinearMap.adjoint (codeDecoderBranch q) =
      (ambientEncodingIsometry q).toLinearMap := by
  rw [codeDecoderBranch, LinearMap.adjoint_adjoint]

/-- Projector onto the range handled coherently by inverse encoding. -/
def decoderCodeProjector (q : Nat) : Operator (PhysicalRegister q) :=
  (LinearMap.adjoint (codeDecoderBranch q)).comp (codeDecoderBranch q)

@[simp] theorem decoderCodeProjector_encoded (q : Nat)
    (psi : LogicalRegister q) :
    decoderCodeProjector q (ambientEncodingIsometry q psi) =
      ambientEncodingIsometry q psi := by
  change LinearMap.adjoint (codeDecoderBranch q)
    (codeDecoderBranch q (ambientEncodingIsometry q psi)) =
      ambientEncodingIsometry q psi
  rw [codeDecoderBranch_encoded, adjoint_codeDecoderBranch]
  rfl

theorem codeDecoderBranch_comp_adjoint (q : Nat) :
    (codeDecoderBranch q).comp
        (LinearMap.adjoint (codeDecoderBranch q)) = 1 := by
  rw [adjoint_codeDecoderBranch, codeDecoderBranch]
  exact (ambientEncodingIsometry q).adjoint_comp_self'

theorem decoderCodeProjector_idempotent (q : Nat) :
    (decoderCodeProjector q).comp (decoderCodeProjector q) =
      decoderCodeProjector q := by
  rw [decoderCodeProjector]
  calc
    ((LinearMap.adjoint (codeDecoderBranch q)).comp (codeDecoderBranch q)).comp
        ((LinearMap.adjoint (codeDecoderBranch q)).comp (codeDecoderBranch q)) =
        (LinearMap.adjoint (codeDecoderBranch q)).comp
          (((codeDecoderBranch q).comp
            (LinearMap.adjoint (codeDecoderBranch q))).comp
              (codeDecoderBranch q)) := by
            ext psi
            rfl
    _ = (LinearMap.adjoint (codeDecoderBranch q)).comp
          ((1 : Operator (LogicalRegister q)).comp (codeDecoderBranch q)) := by
            rw [codeDecoderBranch_comp_adjoint]
    _ = (LinearMap.adjoint (codeDecoderBranch q)).comp
          (codeDecoderBranch q) := by
            ext psi
            rfl

theorem decoderCodeProjector_adjoint (q : Nat) :
    LinearMap.adjoint (decoderCodeProjector q) = decoderCodeProjector q := by
  simp [decoderCodeProjector, LinearMap.adjoint_comp]

/-- Orthogonal complement completed by neutral state preparation. -/
def decoderComplementProjector (q : Nat) : Operator (PhysicalRegister q) :=
  1 - decoderCodeProjector q

theorem decoderComplementProjector_adjoint (q : Nat) :
    LinearMap.adjoint (decoderComplementProjector q) =
      decoderComplementProjector q := by
  simp [decoderComplementProjector, decoderCodeProjector_adjoint]

theorem decoderComplementProjector_idempotent (q : Nat) :
    (decoderComplementProjector q).comp (decoderComplementProjector q) =
      decoderComplementProjector q := by
  ext psi
  have hprojector := LinearMap.congr_fun
    (decoderCodeProjector_idempotent q) psi
  simp only [decoderComplementProjector, LinearMap.comp_apply,
    LinearMap.sub_apply, Module.End.one_apply, map_sub] at hprojector ⊢
  rw [hprojector]
  abel_nf

@[simp] theorem decoderComplementProjector_encoded (q : Nat)
    (psi : LogicalRegister q) :
    decoderComplementProjector q (ambientEncodingIsometry q psi) = 0 := by
  simp only [decoderComplementProjector, LinearMap.sub_apply, Module.End.one_apply]
  rw [decoderCodeProjector_encoded]
  abel_nf

/-- A source-independent technical fallback for off-carrier inputs. -/
def decoderFallbackState (q : Nat) : LogicalRegister q :=
  BinaryRowFamily.logicalComputationalState (fun _ => 0)

theorem decoderFallbackState_inner_self (q : Nat) :
    inner Complex (decoderFallbackState q) (decoderFallbackState q) = 1 := by
  simp [decoderFallbackState, BinaryRowFamily.logicalComputationalState]

private theorem decoderFallbackState_normSq (q : Nat) :
    ‖decoderFallbackState q‖ ^ 2 = 1 := by
  rw [InnerProductSpace.norm_sq_eq_re_inner (𝕜 := Complex),
    decoderFallbackState_inner_self]
  norm_num

private noncomputable def decoderPhysicalBasis (q : Nat) :=
  stdOrthonormalBasis Complex (PhysicalRegister q)

/-- One complement branch erases a projected basis direction to the fallback. -/
def complementDecoderBranch (q : Nat)
    (i : Fin (Module.finrank Complex (PhysicalRegister q))) :
    PhysicalRegister q →ₗ[Complex] LogicalRegister q :=
  (InnerProductSpace.rankOne Complex (decoderFallbackState q)
    (decoderComplementProjector q (decoderPhysicalBasis q i))).toLinearMap

theorem complementDecoderBranch_adjoint_comp (q : Nat)
    (i : Fin (Module.finrank Complex (PhysicalRegister q))) :
    (LinearMap.adjoint (complementDecoderBranch q i)).comp
        (complementDecoderBranch q i) =
      (InnerProductSpace.rankOne Complex
        (decoderComplementProjector q (decoderPhysicalBasis q i))
        (decoderComplementProjector q (decoderPhysicalBasis q i))).toLinearMap := by
  have hadjoint : LinearMap.adjoint
      ((InnerProductSpace.rankOne Complex (decoderFallbackState q)
        (decoderComplementProjector q (decoderPhysicalBasis q i))).toLinearMap) =
      (InnerProductSpace.rankOne Complex
        (decoderComplementProjector q (decoderPhysicalBasis q i))
        (decoderFallbackState q)).toLinearMap := by
    rw [LinearMap.adjoint_eq_toCLM_adjoint]
    change ((InnerProductSpace.rankOne Complex
      (decoderFallbackState q)
      (decoderComplementProjector q (decoderPhysicalBasis q i))).adjoint).toLinearMap = _
    rw [InnerProductSpace.adjoint_rankOne]
  apply LinearMap.ext
  intro psi
  simp only [complementDecoderBranch]
  rw [hadjoint]
  have hnormSq : (↑‖decoderFallbackState q‖ : Complex) ^ 2 = 1 := by
    norm_cast
    exact decoderFallbackState_normSq q
  simp [LinearMap.comp_apply, hnormSq]

theorem sum_complementDecoderBranch_adjoint_comp (q : Nat) :
    ∑ i : Fin (Module.finrank Complex (PhysicalRegister q)),
        (LinearMap.adjoint (complementDecoderBranch q i)).comp
          (complementDecoderBranch q i) = decoderComplementProjector q := by
  simp_rw [complementDecoderBranch_adjoint_comp]
  calc
    (∑ i,
        (InnerProductSpace.rankOne Complex
          (decoderComplementProjector q (decoderPhysicalBasis q i))
          (decoderComplementProjector q (decoderPhysicalBasis q i))).toLinearMap) =
        (decoderComplementProjector q).comp
          (LinearMap.adjoint (decoderComplementProjector q)) :=
      by
        apply LinearMap.ext
        intro psi
        simp only [LinearMap.sum_apply, LinearMap.comp_apply]
        rw [← (decoderPhysicalBasis q).sum_repr'
          (LinearMap.adjoint (decoderComplementProjector q) psi)]
        simp only [map_sum, map_smul]
        apply Finset.sum_congr rfl
        intro i _
        rw [LinearMap.adjoint_inner_right]
        rfl
    _ = (decoderComplementProjector q).comp
          (decoderComplementProjector q) := by
      rw [decoderComplementProjector_adjoint]
    _ = decoderComplementProjector q :=
      decoderComplementProjector_idempotent q

/-- Explicit finite Kraus completion of inverse encoding to a total decoder. -/
def decoderKrausFamily (q : Nat) :
    FiniteKrausFamily
      (Sum Unit (Fin (Module.finrank Complex (PhysicalRegister q))))
      (PhysicalRegister q) (LogicalRegister q) where
  operator
    | .inl _ => codeDecoderBranch q
    | .inr i => complementDecoderBranch q i

theorem decoderKrausFamily_complete (q : Nat) :
    (decoderKrausFamily q).Complete := by
  rw [FiniteKrausFamily.Complete, Fintype.sum_sum_type]
  change (∑ _ : Unit, decoderCodeProjector q) +
      (∑ i : Fin (Module.finrank Complex (PhysicalRegister q)),
        (LinearMap.adjoint (complementDecoderBranch q i)).comp
          (complementDecoderBranch q i)) = 1
  rw [Fintype.sum_unique]
  rw [sum_complementDecoderBranch_adjoint_comp]
  simp [decoderComplementProjector]

/-- The actual CPTP decoder: inverse encoding on the carrier, neutral off it. -/
def decoderChannel (q : Nat) :
    QuantumChannel (PhysicalRegister q) (LogicalRegister q) :=
  (decoderKrausFamily q).toQuantumChannel (decoderKrausFamily_complete q)

theorem decoderChannel_rankOne_encoded (q : Nat)
    (psi : LogicalRegister q) :
    decoderChannel q
        (InnerProductSpace.rankOne Complex
          (ambientEncodingIsometry q psi)
          (ambientEncodingIsometry q psi)).toLinearMap =
      (InnerProductSpace.rankOne Complex psi psi).toLinearMap := by
  rw [decoderChannel, FiniteKrausFamily.toQuantumChannel_apply_sum,
    Fintype.sum_sum_type]
  simp only [decoderKrausFamily]
  simp_rw [sandwich_rankOne]
  rw [Fintype.sum_unique]
  simp only [codeDecoderBranch_encoded]
  have hcomplement : ∀ i, complementDecoderBranch q i
      (ambientEncodingIsometry q psi) = 0 := by
    intro i
    have hinner : inner Complex
        (decoderComplementProjector q (decoderPhysicalBasis q i))
        (ambientEncodingIsometry q psi) = 0 := by
      rw [← LinearMap.adjoint_inner_right, decoderComplementProjector_adjoint,
        decoderComplementProjector_encoded]
      simp
    change inner Complex
      (decoderComplementProjector q (decoderPhysicalBasis q i))
      (ambientEncodingIsometry q psi) • decoderFallbackState q = 0
    rw [hinner]
    simp
  simp_rw [hcomplement]
  simp

/-- One noisy A-basis resource for each literal physical site. -/
def resourceCount (q : Nat) : Nat := Fintype.card (Column q)

@[simp] theorem resourceCount_eq_three_logicalCount_add_eight (q : Nat) :
    resourceCount q = 3 * logicalCount q + 8 :=
  card_column q

private noncomputable def resourceSiteEquiv (q : Nat) :
    Column q ≃ Fin (resourceCount q) :=
  Fintype.equivFin (Column q)

/-- The actual indexed family supplied to the #457 run. -/
def noisyResources (q : Nat) (p : ErrorParameter) :
    ResourceInput (resourceCount q) Qubit.QubitSpace :=
  fun _ => OneQubit.diagonalAResource p

/-- Interpret one binary error bit as the corresponding retained A-basis result. -/
def resourceOutcome (bit : ZMod 2) : StabilizerOutcome :=
  if bit = 0 then .positive else .negative

/-- Joint probability obtained by actually measuring every supplied resource. -/
def measuredErrorWordProbability (q : Nat)
    (inputs : ResourceInput (resourceCount q) Qubit.QubitSpace)
    (error : PhysicalError q) : ℝ :=
  ∏ site, OneQubit.aBasisInstrument.bornWeight
    (resourceOutcome (error site)) (inputs (resourceSiteEquiv q site))

theorem measuredErrorWordProbability_nonneg (q : Nat)
    (inputs : ResourceInput (resourceCount q) Qubit.QubitSpace)
    (error : PhysicalError q) :
    0 ≤ measuredErrorWordProbability q inputs error := by
  apply Finset.prod_nonneg
  intro site _
  exact OneQubit.aBasisInstrument_weight_nonneg _ _

theorem sum_measuredErrorWordProbability (q : Nat)
    (inputs : ResourceInput (resourceCount q) Qubit.QubitSpace) :
    ∑ error : PhysicalError q,
      measuredErrorWordProbability q inputs error = 1 := by
  classical
  have h := Finset.sum_prod_piFinset
    (R := ℝ) (ι := Column q) (κ := ZMod 2)
    (s := Finset.univ)
    (g := fun site bit => OneQubit.aBasisInstrument.bornWeight
      (resourceOutcome bit) (inputs (resourceSiteEquiv q site)))
  have hsite (site : Column q) :
      ∑ bit : ZMod 2, OneQubit.aBasisInstrument.bornWeight
        (resourceOutcome bit) (inputs (resourceSiteEquiv q site)) = 1 := by
    rw [show (Finset.univ : Finset (ZMod 2)) = {0, 1} by decide]
    simpa [resourceOutcome] using
      OneQubit.aBasisInstrument_weight_sum
        (inputs (resourceSiteEquiv q site))
  simp_rw [hsite] at h
  simpa [measuredErrorWordProbability] using h

theorem measuredErrorWordProbability_noisyResources (q : Nat)
    (p : ErrorParameter) (error : PhysicalError q) :
    measuredErrorWordProbability q (noisyResources q p) error =
      errorWordProbability p error := by
  apply Finset.prod_congr rfl
  intro site _
  by_cases herror : error site = 0
  · simp [noisyResources, resourceOutcome, herror,
      OneQubit.aBasisInstrument_diagonalAResource_weight]
  · simp [noisyResources, resourceOutcome, herror,
      OneQubit.aBasisInstrument_diagonalAResource_weight]

/-- Computational record of one complete measured A-basis error word. -/
def errorWordBasisState {q : Nat} (error : PhysicalError q) :
    PhysicalRegister q :=
  EuclideanSpace.basisFun (Qubit.Bitstring (Column q)) Complex
    ((bitstringWordEquiv (Column q)).symm error)

theorem errorWordBasisState_normSq {q : Nat} (error : PhysicalError q) :
    ‖errorWordBasisState error‖ ^ 2 = 1 := by
  simp [errorWordBasisState]

/-- Normalized classical density associated with a measured error word. -/
def errorWordBasisDensity {q : Nat} (error : PhysicalError q) :
    DensityOperator (PhysicalRegister q) :=
  DensityOperator.pureDensity (errorWordBasisState error)
    (errorWordBasisState_normSq error)

private noncomputable def errorWordBasis (q : Nat) :
    OrthonormalBasis (PhysicalError q) Complex (PhysicalRegister q) :=
  (EuclideanSpace.basisFun (Qubit.Bitstring (Column q)) Complex).reindex
    (bitstringWordEquiv (Column q))

@[simp] theorem errorWordBasis_apply (q : Nat) (error : PhysicalError q) :
    errorWordBasis q error = errorWordBasisState error := by
  simp [errorWordBasis, errorWordBasisState]

/-- All measured resource outcomes assembled into one joint classical register. -/
def prepareMeasuredResources (q : Nat)
    (inputs : ResourceInput (resourceCount q) Qubit.QubitSpace) :
    DensityOperator (PhysicalRegister q) :=
  DensityOperator.convexCombination Finset.univ
    (measuredErrorWordProbability q inputs)
    errorWordBasisDensity
    (fun error _ => measuredErrorWordProbability_nonneg q inputs error)
    (sum_measuredErrorWordProbability q inputs)

@[simp] theorem prepareMeasuredResources_toOperator (q : Nat)
    (inputs : ResourceInput (resourceCount q) Qubit.QubitSpace) :
    (prepareMeasuredResources q inputs).toOperator =
      ∑ error : PhysicalError q,
        (measuredErrorWordProbability q inputs error : Complex) •
          (errorWordBasisDensity error).toOperator := by
  simp [prepareMeasuredResources,
    DensityOperator.convexCombinationOperator]

theorem prepareMeasuredResources_noisyResources_toOperator (q : Nat)
    (p : ErrorParameter) :
    (prepareMeasuredResources q (noisyResources q p)).toOperator =
      ∑ error : PhysicalError q,
        (errorWordProbability p error : Complex) •
          (errorWordBasisDensity error).toOperator := by
  rw [prepareMeasuredResources_toOperator]
  apply Finset.sum_congr rfl
  intro error _
  rw [measuredErrorWordProbability_noisyResources]

/-- Parameter-free consumer: a measured word prepares its actual corrected branch. -/
def resourceConsumerKrausFamily (q : Nat) :
    FiniteKrausFamily (PhysicalError q)
      (PhysicalRegister q) (PhysicalRegister q) where
  operator error :=
    (InnerProductSpace.rankOne Complex
      (errorBranchState error) (errorWordBasisState error)).toLinearMap

theorem resourceConsumerKrausFamily_adjoint_comp (q : Nat)
    (error : PhysicalError q) :
    (LinearMap.adjoint ((resourceConsumerKrausFamily q).operator error)).comp
        ((resourceConsumerKrausFamily q).operator error) =
      (InnerProductSpace.rankOne Complex
        (errorWordBasisState error) (errorWordBasisState error)).toLinearMap := by
  have hadjoint : LinearMap.adjoint
      ((InnerProductSpace.rankOne Complex
        (errorBranchState error) (errorWordBasisState error)).toLinearMap) =
      (InnerProductSpace.rankOne Complex
        (errorWordBasisState error) (errorBranchState error)).toLinearMap := by
    rw [LinearMap.adjoint_eq_toCLM_adjoint]
    change ((InnerProductSpace.rankOne Complex
      (errorBranchState error) (errorWordBasisState error)).adjoint).toLinearMap = _
    rw [InnerProductSpace.adjoint_rankOne]
  ext psi
  simp only [resourceConsumerKrausFamily]
  rw [hadjoint]
  have hnormSq : (↑‖errorBranchState error‖ : Complex) ^ 2 = 1 := by
    norm_cast
    exact errorBranchState_normSq error
  simp [LinearMap.comp_apply, hnormSq]

theorem resourceConsumerKrausFamily_complete (q : Nat) :
    (resourceConsumerKrausFamily q).Complete := by
  rw [FiniteKrausFamily.Complete]
  simp_rw [resourceConsumerKrausFamily_adjoint_comp]
  have hcomplete := congrArg ContinuousLinearMap.toLinearMap
    (OrthonormalBasis.sum_rankOne_eq_id (errorWordBasis q))
  simp only [errorWordBasis_apply, ContinuousLinearMap.toLinearMap_sum] at hcomplete
  exact hcomplete

/-- Actual CPTP consumption of the retained A-basis error-word register. -/
def resourceConsumerChannel (q : Nat) :
    QuantumChannel (PhysicalRegister q) (PhysicalRegister q) :=
  (resourceConsumerKrausFamily q).toQuantumChannel
    (resourceConsumerKrausFamily_complete q)

theorem resourceConsumerBranch_basis (q : Nat)
    (error observed : PhysicalError q) :
    (resourceConsumerKrausFamily q).operator error
        (errorWordBasisState observed) =
      if error = observed then errorBranchState error else 0 := by
  classical
  simp only [resourceConsumerKrausFamily]
  change inner Complex (errorWordBasisState error) (errorWordBasisState observed) •
      errorBranchState error = _
  rw [← errorWordBasis_apply q error, ← errorWordBasis_apply q observed]
  rw [(errorWordBasis q).inner_eq_ite]
  simp

private noncomputable def resourceConsumerBranchMap (q : Nat)
    (error : PhysicalError q) :
    Operator (PhysicalRegister q) →ₗ[Complex] Operator (PhysicalRegister q) where
  toFun := fun A =>
    (resourceConsumerKrausFamily q).operator error |>.comp
      (A.comp (LinearMap.adjoint ((resourceConsumerKrausFamily q).operator error)))
  map_add' := by
    intro A B
    ext psi
    simp [LinearMap.comp_apply, map_add]
  map_smul' := by
    intro scalar A
    ext psi
    simp [LinearMap.comp_apply, map_smul]

private theorem resourceConsumerBranchMap_errorWordBasisDensity (q : Nat)
    (error observed : PhysicalError q) :
    resourceConsumerBranchMap q error (errorWordBasisDensity observed).toOperator =
      if error = observed then (errorBranchDensity error).toOperator else 0 := by
  change ((resourceConsumerKrausFamily q).operator error).comp
      ((errorWordBasisDensity observed).toOperator.comp
        (LinearMap.adjoint ((resourceConsumerKrausFamily q).operator error))) = _
  rw [errorWordBasisDensity, DensityOperator.pureDensity_toOperator, sandwich_rankOne,
    resourceConsumerBranch_basis]
  by_cases h : error = observed <;> simp [h, errorBranchDensity,
    DensityOperator.pureDensity_toOperator]

theorem resourceConsumerChannel_prepares_branchMixture (q : Nat)
    (inputs : ResourceInput (resourceCount q) Qubit.QubitSpace) :
    resourceConsumerChannel q (prepareMeasuredResources q inputs).toOperator =
      ∑ error : PhysicalError q,
        (measuredErrorWordProbability q inputs error : Complex) •
          (errorBranchDensity error).toOperator := by
  rw [resourceConsumerChannel,
    FiniteKrausFamily.toQuantumChannel_apply_sum,
    prepareMeasuredResources_toOperator]
  change ∑ error : PhysicalError q,
      resourceConsumerBranchMap q error
        (∑ observed : PhysicalError q,
          (measuredErrorWordProbability q inputs observed : Complex) •
            (errorWordBasisDensity observed).toOperator) = _
  simp_rw [map_sum, map_smul]
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro observed _
  rw [← Finset.smul_sum]
  apply congrArg
  rw [Fintype.sum_eq_single observed]
  · rw [resourceConsumerBranchMap_errorWordBasisDensity]
    simp
  · intro error hne
    rw [resourceConsumerBranchMap_errorWordBasisDensity]
    simp [hne]

/-- The measured-resource consumer reproduces the proved physical pre-syndrome state. -/
theorem resourceConsumer_noisyResources_eq_preSyndromeState (q : Nat)
    (p : ErrorParameter) :
    (resourceConsumerChannel q).mapDensity
        (prepareMeasuredResources q (noisyResources q p)) =
      preSyndromeState q p := by
  apply DensityOperator.ext_toOperator
  rw [QuantumChannel.mapDensity_toOperator,
    resourceConsumerChannel_prepares_branchMixture,
    preSyndromeState_toOperator]
  apply Finset.sum_congr rfl
  intro error _
  rw [measuredErrorWordProbability_noisyResources]

/-- The actual pre-syndrome state obtained from a supplied A-basis resource family. -/
def resourcePreSyndromeState (q : Nat)
    (inputs : ResourceInput (resourceCount q) Qubit.QubitSpace) :
    DensityOperator (PhysicalRegister q) :=
  (resourceConsumerChannel q).mapDensity (prepareMeasuredResources q inputs)

theorem resourcePreSyndromeState_noisyResources (q : Nat)
    (p : ErrorParameter) :
    resourcePreSyndromeState q (noisyResources q p) = preSyndromeState q p :=
  resourceConsumer_noisyResources_eq_preSyndromeState q p

/-- The unnormalized accept/reject branch of the resource-dependent syndrome measurement. -/
def resourceEndpoint (q : Nat)
    (inputs : ResourceInput (resourceCount q) Qubit.QubitSpace)
    (outcome : DistillationOutcome) : Operator (PhysicalRegister q) :=
  (protocolSyndromeInstrument q).branchOperator outcome
    (resourcePreSyndromeState q inputs).toOperator

theorem resourceEndpoint_noisyResources (q : Nat)
    (p : ErrorParameter) (outcome : DistillationOutcome) :
    resourceEndpoint q (noisyResources q p) outcome = rawEndpoint q p outcome := by
  unfold resourceEndpoint rawEndpoint
  rw [resourcePreSyndromeState_noisyResources]

/-- The actual Born weight of a resource-dependent syndrome endpoint. -/
def resourceEndpointWeight (q : Nat)
    (inputs : ResourceInput (resourceCount q) Qubit.QubitSpace)
    (outcome : DistillationOutcome) : ℝ :=
  (protocolSyndromeInstrument q).bornWeight outcome (resourcePreSyndromeState q inputs)

theorem resourceEndpointWeight_noisyResources (q : Nat)
    (p : ErrorParameter) (outcome : DistillationOutcome) :
    resourceEndpointWeight q (noisyResources q p) outcome = endpointWeight q p outcome := by
  unfold resourceEndpointWeight endpointWeight
  rw [resourcePreSyndromeState_noisyResources]

/-- The supplied-resource accepted endpoint has exactly the proved BH12 raw success mass. -/
theorem resourceAcceptedWeight_noisyResources_eq_rawSuccessMass (q : Nat)
    (p : ErrorParameter) :
    resourceEndpointWeight q (noisyResources q p) .accepted = rawSuccessMass q p := by
  rw [resourceEndpointWeight_noisyResources,
    endpointWeight_accepted_eq_rawSuccessMass]

/-- Normalize a resource-dependent syndrome endpoint only with its actual positive Born weight. -/
def resourceEndpointConditional (q : Nat)
    (inputs : ResourceInput (resourceCount q) Qubit.QubitSpace)
    (outcome : DistillationOutcome)
    (hpos : 0 < resourceEndpointWeight q inputs outcome) :
    DensityOperator (PhysicalRegister q) :=
  (protocolSyndromeInstrument q).conditionalDensity outcome
    (resourcePreSyndromeState q inputs) hpos

@[simp] theorem resourceEndpointConditional_toOperator (q : Nat)
    (inputs : ResourceInput (resourceCount q) Qubit.QubitSpace)
    (outcome : DistillationOutcome)
    (hpos : 0 < resourceEndpointWeight q inputs outcome) :
    (resourceEndpointConditional q inputs outcome hpos).toOperator =
      ((resourceEndpointWeight q inputs outcome : Complex)⁻¹) •
        resourceEndpoint q inputs outcome :=
  rfl

/-- Resource-dependent endpoint weights are derived from the actual syndrome
instrument, so every supplied resource family has nonnegative branches. -/
theorem resourceEndpointWeight_nonneg (q : Nat)
    (inputs : ResourceInput (resourceCount q) Qubit.QubitSpace)
    (outcome : DistillationOutcome) :
    0 ≤ resourceEndpointWeight q inputs outcome :=
  (protocolSyndromeInstrument q).bornWeight_nonneg outcome
    (resourcePreSyndromeState q inputs)

/-- The two observed resource-dependent syndrome weights exhaust the complete
measurement channel. -/
theorem resourceEndpointWeight_sum (q : Nat)
    (inputs : ResourceInput (resourceCount q) Qubit.QubitSpace) :
    resourceEndpointWeight q inputs .accepted +
      resourceEndpointWeight q inputs .rejected = 1 := by
  have h := (protocolSyndromeInstrument q).sum_bornWeight_eq_one
    (protocolSyndromeInstrument_complete q) (resourcePreSyndromeState q inputs)
  rw [show (Finset.univ : Finset DistillationOutcome) =
      {.accepted, .rejected} by decide] at h
  simpa [resourceEndpointWeight] using h

/-- A zero resource-dependent endpoint remains its literal raw zero operator. -/
theorem resourceEndpoint_eq_zero_of_weight_eq_zero (q : Nat)
    (inputs : ResourceInput (resourceCount q) Qubit.QubitSpace)
    (outcome : DistillationOutcome)
    (hzero : resourceEndpointWeight q inputs outcome = 0) :
    resourceEndpoint q inputs outcome = 0 :=
  (protocolSyndromeInstrument q).branchOperator_eq_zero_of_bornWeight_eq_zero
    outcome (resourcePreSyndromeState q inputs) hzero

/-- A fixed physical density used only to complete a zero-weight interface
branch.  It is never claimed to be a BH12 decoded rejected state. -/
def resourceEndpointFallback (q : Nat) : DensityOperator (PhysicalRegister q) :=
  errorBranchDensity 0

/-- The resource-dependent conditional when its Born weight is positive, with
an explicit interface-only fallback at weight zero. -/
noncomputable def resourceEndpointCompletion (q : Nat)
    (inputs : ResourceInput (resourceCount q) Qubit.QubitSpace)
    (outcome : DistillationOutcome) : DensityOperator (PhysicalRegister q) :=
  if hpos : 0 < resourceEndpointWeight q inputs outcome then
    resourceEndpointConditional q inputs outcome hpos
  else resourceEndpointFallback q

/-- Weighting an endpoint completion always recovers the physical raw branch;
at zero weight this uses the proved raw-zero law rather than a conditional. -/
theorem resourceEndpointWeight_smul_completion_toOperator (q : Nat)
    (inputs : ResourceInput (resourceCount q) Qubit.QubitSpace)
    (outcome : DistillationOutcome) :
    (resourceEndpointWeight q inputs outcome : Complex) •
        (resourceEndpointCompletion q inputs outcome).toOperator =
      resourceEndpoint q inputs outcome := by
  classical
  by_cases hpos : 0 < resourceEndpointWeight q inputs outcome
  · rw [resourceEndpointCompletion, dif_pos hpos]
    simpa [resourceEndpointWeight, resourceEndpointConditional, resourceEndpoint] using
      (protocolSyndromeInstrument q).bornWeight_smul_conditionalDensity_toOperator outcome
          (resourcePreSyndromeState q inputs) hpos
  · rw [resourceEndpointCompletion, dif_neg hpos]
    have hzero : resourceEndpointWeight q inputs outcome = 0 :=
      le_antisymm (not_lt.mp hpos)
        (resourceEndpointWeight_nonneg q inputs outcome)
    rw [hzero, resourceEndpoint_eq_zero_of_weight_eq_zero q inputs outcome hzero]
    simp

/-- BH12's accepted output decodes only the positive accepted conditional branch. -/
def resourceAcceptedOutput (q : Nat)
    (inputs : ResourceInput (resourceCount q) Qubit.QubitSpace)
    (hpos : 0 < resourceEndpointWeight q inputs .accepted) :
    DensityOperator (LogicalRegister q) :=
  (decoderChannel q).mapDensity
    (resourceEndpointConditional q inputs .accepted hpos)

theorem resourceAcceptedOutput_noisyResources (q : Nat)
    (p : ErrorParameter) (hpos : 0 < endpointWeight q p .accepted) :
    resourceAcceptedOutput q (noisyResources q p)
        (by
          rw [resourceEndpointWeight_noisyResources]
          exact hpos) =
      (decoderChannel q).mapDensity (endpointConditional q p .accepted hpos) := by
  unfold resourceAcceptedOutput
  apply congrArg (decoderChannel q).mapDensity
  apply DensityOperator.ext_toOperator
  rw [resourceEndpointConditional_toOperator, endpointConditional_toOperator]
  rw [resourceEndpointWeight_noisyResources,
    resourceEndpoint_noisyResources]

/-- The parameter-free physical channel from a measured A-basis resource word
through the actual `G₀` syndrome measurement. -/
def resourceSyndromeOperation (q : Nat) :
    QuantumChannel (PhysicalRegister q) (PhysicalRegister q) :=
  QuantumChannel.comp (syndromeMeasurementChannel q)
    (resourceConsumerChannel q)

/-- The complete resource-dependent syndrome channel is the weighted mixture
of its two honest conditionals, with a fallback only for a proven zero branch. -/
theorem resourceSyndromeOperation_output_decomposition (q : Nat)
    (inputs : ResourceInput (resourceCount q) Qubit.QubitSpace) :
    (resourceSyndromeOperation q).mapDensity
        (prepareMeasuredResources q inputs) =
      outcomeMixture (resourceEndpointWeight q inputs .accepted)
        (resourceEndpointWeight_nonneg q inputs .accepted)
        (by
          have hsum := resourceEndpointWeight_sum q inputs
          linarith [resourceEndpointWeight_nonneg q inputs .rejected])
        (resourceEndpointCompletion q inputs .accepted)
        (resourceEndpointCompletion q inputs .rejected) := by
  apply DensityOperator.ext_toOperator
  rw [resourceSyndromeOperation, QuantumChannel.comp_mapDensity]
  change (((protocolSyndromeInstrument q).kraus.toQuantumChannel
      (protocolSyndromeInstrument_complete q)).mapDensity
        (resourcePreSyndromeState q inputs)).toOperator = _
  rw [← (protocolSyndromeInstrument q).sum_branchOperator_eq_mapDensity_toOperator
      (protocolSyndromeInstrument_complete q) (resourcePreSyndromeState q inputs)]
  change (∑ outcome, resourceEndpoint q inputs outcome) = _
  rw [show (Finset.univ : Finset DistillationOutcome) =
      {.accepted, .rejected} by decide]
  have hreject : 1 - resourceEndpointWeight q inputs .accepted =
      resourceEndpointWeight q inputs .rejected := by
    linarith [resourceEndpointWeight_sum q inputs]
  simp [outcomeMixture, DensityOperator.convexCombinationOperator,
    branchState, outcomeWeight,
    show (Finset.univ : Finset DistillationOutcome) =
      {.accepted, .rejected} by decide,
    hreject]
  rw [← resourceEndpointWeight_smul_completion_toOperator q inputs .accepted,
    ← resourceEndpointWeight_smul_completion_toOperator q inputs .rejected]
  simp only [RCLike.real_smul_eq_coe_smul (K := Complex)]
  rfl

/-- A generic #457 run whose preparation consumes every supplied noisy
resource through A-basis outcomes; neither its preparation nor operation
captures an error parameter. -/
noncomputable def resourceSyndromeRun (q : Nat)
    (inputs : ResourceInput (resourceCount q) Qubit.QubitSpace) :
    DistillationRun Qubit.QubitSpace (PhysicalRegister q) (PhysicalRegister q) where
  resourceCount := resourceCount q
  noisyInput := inputs
  prepareInput := prepareMeasuredResources q
  operation := resourceSyndromeOperation q
  successProbability := resourceEndpointWeight q inputs .accepted
  success_nonneg := resourceEndpointWeight_nonneg q inputs .accepted
  success_le_one := by
    have hsum := resourceEndpointWeight_sum q inputs
    linarith [resourceEndpointWeight_nonneg q inputs .rejected]
  acceptedOutput := resourceEndpointCompletion q inputs .accepted
  rejectedOutput := resourceEndpointCompletion q inputs .rejected
  output_decomposition := resourceSyndromeOperation_output_decomposition q inputs

/--
Interface-only complete operation: it retains a CPTP completion for rejected
syndromes, whereas source BH12 behavior decodes only `resourceAcceptedOutput`
and discards every rejected branch.
-/
def decodedOperation (q : Nat) :
    QuantumChannel (PhysicalRegister q) (LogicalRegister q) :=
  QuantumChannel.comp (decoderChannel q)
    (QuantumChannel.comp (syndromeMeasurementChannel q)
      (resourceConsumerChannel q))

/-- The generic resource run postprocessed by the explicit CPTP decoder. -/
noncomputable def resourceDecodedRun (q : Nat)
    (inputs : ResourceInput (resourceCount q) Qubit.QubitSpace) :
    DistillationRun Qubit.QubitSpace (PhysicalRegister q) (LogicalRegister q) :=
  (resourceSyndromeRun q inputs).postprocess (decoderChannel q)

/-- The decoded run uses the existing parameter-free consumer, syndrome, and
decoder composition. -/
theorem resourceDecodedRun_operation (q : Nat)
    (inputs : ResourceInput (resourceCount q) Qubit.QubitSpace) :
    (resourceDecodedRun q inputs).operation = decodedOperation q :=
  rfl

/-- At positive accepted Born weight, the generic run's accepted output is the
actual BH12 decoded conditional rather than an interface completion. -/
theorem resourceDecodedRun_acceptedOutput (q : Nat)
    (inputs : ResourceInput (resourceCount q) Qubit.QubitSpace)
    (hpos : 0 < resourceEndpointWeight q inputs .accepted) :
    (resourceDecodedRun q inputs).acceptedOutput =
      resourceAcceptedOutput q inputs hpos := by
  change (decoderChannel q).mapDensity
      (resourceEndpointCompletion q inputs .accepted) = _
  simp [resourceEndpointCompletion, resourceAcceptedOutput, hpos]

/-- On the diagonal BH12 resource family, the generic run recovers the
previously derived physical raw success mass. -/
theorem resourceDecodedRun_successProbability_noisyResources (q : Nat)
    (p : ErrorParameter) :
    (resourceDecodedRun q (noisyResources q p)).successProbability =
      rawSuccessMass q p :=
  resourceAcceptedWeight_noisyResources_eq_rawSuccessMass q p

/-- Logical error label extracted by pairing with every odd row. -/
def logicalErrorWord {q : Nat} (error : PhysicalError q) :
    Word (ZMod 2) (OddRow q) :=
  fun logical => wordPairing error (oddWord logical)

theorem rawSuccessMass_nonneg (q : Nat) (p : ErrorParameter) :
    0 ≤ rawSuccessMass q p := by
  apply Finset.sum_nonneg
  intro error _
  split_ifs
  · exact errorWordProbability_nonneg p error
  · rfl

theorem rawRejectMass_nonneg (q : Nat) (p : ErrorParameter) :
    0 ≤ rawRejectMass q p := by
  apply Finset.sum_nonneg
  intro error _
  split_ifs
  · rfl
  · exact errorWordProbability_nonneg p error

/-- Raw accepted and rejected physical error masses partition probability one. -/
theorem rawMass_sum (q : Nat) (p : ErrorParameter) :
    rawSuccessMass q p + rawRejectMass q p = 1 := by
  rw [rawSuccessMass, rawRejectMass, ← Finset.sum_add_distrib]
  calc
    (∑ error : PhysicalError q,
      ((if Accepts error then errorWordProbability p error else 0) +
        if Accepts error then 0 else errorWordProbability p error)) =
        ∑ error : PhysicalError q, errorWordProbability p error := by
          apply Finset.sum_congr rfl
          intro error _
          by_cases h : Accepts error <;> simp [h]
    _ = 1 := sum_errorWordProbability (Index := Column q) p

/-- Raw accepted mass assigned to one decoded logical `Z` word. -/
def rawLogicalErrorWeight (q : Nat) (p : ErrorParameter)
    (logical : Word (ZMod 2) (OddRow q)) : ℝ :=
  ∑ error : PhysicalError q,
    if Accepts error ∧ logicalErrorWord error = logical
      then errorWordProbability p error else 0

theorem rawLogicalErrorWeight_nonneg (q : Nat) (p : ErrorParameter)
    (logical : Word (ZMod 2) (OddRow q)) :
    0 ≤ rawLogicalErrorWeight q p logical := by
  apply Finset.sum_nonneg
  intro error _
  split_ifs
  · exact errorWordProbability_nonneg p error
  · rfl

/-- Summing decoded logical words recovers the raw accepted mass. -/
theorem sum_rawLogicalErrorWeight (q : Nat) (p : ErrorParameter) :
    ∑ logical : Word (ZMod 2) (OddRow q),
        rawLogicalErrorWeight q p logical = rawSuccessMass q p := by
  classical
  rw [rawSuccessMass]
  simp only [rawLogicalErrorWeight]
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro error _
  by_cases haccept : Accepts error
  · simp [haccept]
  · simp [haccept]

/-- Unnormalized marginal error mass on one output qubit. -/
def rawMarginalErrorWeight (q : Nat) (p : ErrorParameter) (a : OddRow q) : ℝ :=
  ∑ logical : Word (ZMod 2) (OddRow q),
    if logical a = 0 then 0 else rawLogicalErrorWeight q p logical

theorem rawMarginalErrorWeight_nonneg (q : Nat) (p : ErrorParameter)
    (a : OddRow q) : 0 ≤ rawMarginalErrorWeight q p a := by
  apply Finset.sum_nonneg
  intro logical _
  split_ifs
  · rfl
  · exact rawLogicalErrorWeight_nonneg q p logical

/-- The normalized decoded marginal, requiring actual positive success mass. -/
def decodedMarginalError (q : Nat) (p : ErrorParameter)
    (hpos : 0 < rawSuccessMass q p) (a : OddRow q) : ℝ :=
  if h : 0 < rawSuccessMass q p then
    rawMarginalErrorWeight q p a / rawSuccessMass q p
  else (h hpos).elim

theorem decodedMarginalError_nonneg (q : Nat) (p : ErrorParameter)
    (hpos : 0 < rawSuccessMass q p) (a : OddRow q) :
    0 ≤ decodedMarginalError q p hpos a := by
  simp only [decodedMarginalError, dif_pos hpos]
  exact div_nonneg (rawMarginalErrorWeight_nonneg q p a) hpos.le

/-- The actual affine `G⊥` coset carrying one decoded logical error word. -/
noncomputable def rowCodeDualCosetBernoulliMass (q : Nat) (p : ErrorParameter)
    (logical : Word (ZMod 2) (OddRow q)) : ℝ := by
  classical
  exact ∑ error : PhysicalError q,
    if error - (family q).oddCombination logical ∈
        (family q).rowCode.dual.carrier then
      errorWordProbability p error else 0

private theorem oddProjection_eq_oddCombination_logicalErrorWord (q : Nat)
    (error : PhysicalError q) :
    (family q).oddProjection error =
      (family q).oddCombination (logicalErrorWord error) := by
  unfold BinaryRowFamily.oddProjection logicalErrorWord
  rw [BinaryRowFamily.oddCombination_apply]
  simp [family]

/-- An accepted error has logical label `x` exactly when it lies in the
physical affine coset `G⊥ + \sum_a x_a g^a`. -/
theorem accepts_and_logicalErrorWord_eq_iff_mem_rowCodeDualCoset (q : Nat)
    (error : PhysicalError q) (logical : Word (ZMod 2) (OddRow q)) :
    Accepts error ∧ logicalErrorWord error = logical ↔
      error - (family q).oddCombination logical ∈
        (family q).rowCode.dual.carrier := by
  constructor
  · intro h
    have heven : error ∈ (family q).evenCode.dual.carrier :=
      (accepts_iff_mem_evenCode_dual error).mp h.1
    rw [← h.2, ← oddProjection_eq_oddCombination_logicalErrorWord]
    exact (family q).sub_oddProjection_mem_rowCode_dual
      (isTriorthogonal q) heven
  · intro hcoset
    have hremainderEven :
        error - (family q).oddCombination logical ∈
          (family q).evenCode.dual.carrier :=
      (family q).rowCode_dual_le_evenCode_dual hcoset
    have hlogicalEven :
        (family q).oddCombination logical ∈
          (family q).evenCode.dual.carrier :=
      (family q).oddCode_le_evenCode_dual (isTriorthogonal q)
        ((family q).oddCombination_mem_oddCode logical)
    constructor
    · apply (accepts_iff_mem_evenCode_dual error).mpr
      rw [← sub_add_cancel error ((family q).oddCombination logical)]
      exact Submodule.add_mem _ hremainderEven hlogicalEven
    · funext a
      have hremainderPair :
          wordPairing (error - (family q).oddCombination logical) (oddWord a) = 0 := by
        have hrowPair :
            wordPairing (oddWord a)
              (error - (family q).oddCombination logical) = 0 := by
          change wordPairing ((family q).row (Sum.inl a))
            (error - (family q).oddCombination logical) = 0
          exact LinearCode.dual_orthogonal (family q).rowCode
            ((family q).row_mem_rowCode (Sum.inl a)) hcoset
        rw [wordPairing_apply, dotProduct_comm, ← wordPairing_apply]
        exact hrowPair
      change wordPairing error (oddWord a) = logical a
      rw [← sub_add_cancel error ((family q).oddCombination logical),
        wordPairing.map_add]
      change
        wordPairing (error - (family q).oddCombination logical) (oddWord a) +
          wordPairing ((family q).oddCombination logical) (oddWord a) = logical a
      rw [hremainderPair, zero_add]
      simpa [family, BinaryRowFamily.oddCombination_apply] using
        (family q).wordPairing_sum_oddRow (isTriorthogonal q) logical a

/-- The accepted physical branches give the literal source `G⊥`-coset
distribution on decoded logical error words. -/
theorem rawLogicalErrorWeight_eq_rowCodeDualCosetBernoulliMass (q : Nat)
    (p : ErrorParameter) (logical : Word (ZMod 2) (OddRow q)) :
    rawLogicalErrorWeight q p logical =
      rowCodeDualCosetBernoulliMass q p logical := by
  classical
  unfold rawLogicalErrorWeight rowCodeDualCosetBernoulliMass
  apply Finset.sum_congr rfl
  intro error _
  by_cases hcoset : error - (family q).oddCombination logical ∈
      (family q).rowCode.dual.carrier
  · have hlogical : Accepts error ∧ logicalErrorWord error = logical :=
      (accepts_and_logicalErrorWord_eq_iff_mem_rowCodeDualCoset
        q error logical).mpr hcoset
    rw [if_pos hlogical, if_pos hcoset]
  · have hlogical : ¬(Accepts error ∧ logicalErrorWord error = logical) := by
      intro hlogical
      exact hcoset
        ((accepts_and_logicalErrorWord_eq_iff_mem_rowCodeDualCoset
          q error logical).mp hlogical)
    rw [if_neg hlogical, if_neg hcoset]

private theorem rawMarginalErrorWeight_eq_errorWordSum (q : Nat)
    (p : ErrorParameter) (a : OddRow q) :
    rawMarginalErrorWeight q p a =
      ∑ error : PhysicalError q,
        if Accepts error ∧ logicalErrorWord error a ≠ 0 then
          errorWordProbability p error else 0 := by
  classical
  unfold rawMarginalErrorWeight rawLogicalErrorWeight
  calc
    (∑ logical : Word (ZMod 2) (OddRow q),
      if logical a = 0 then 0 else
        ∑ error : PhysicalError q,
          if Accepts error ∧ logicalErrorWord error = logical then
            errorWordProbability p error else 0) =
        ∑ logical : Word (ZMod 2) (OddRow q),
          ∑ error : PhysicalError q,
            if logical a = 0 then 0 else
              if Accepts error ∧ logicalErrorWord error = logical then
                errorWordProbability p error else 0 := by
      apply Finset.sum_congr rfl
      intro logical _
      by_cases hlogical : logical a = 0 <;> simp [hlogical]
    _ = ∑ error : PhysicalError q,
          ∑ logical : Word (ZMod 2) (OddRow q),
            if logical a = 0 then 0 else
              if Accepts error ∧ logicalErrorWord error = logical then
                errorWordProbability p error else 0 := by
      rw [Finset.sum_comm]
    _ = ∑ error : PhysicalError q,
        if Accepts error ∧ logicalErrorWord error a ≠ 0 then
          errorWordProbability p error else 0 := by
      apply Finset.sum_congr rfl
      intro error _
      by_cases haccept : Accepts error
      · by_cases hbit : logicalErrorWord error a = 0
        · rw [Fintype.sum_eq_single (logicalErrorWord error)]
          · simp [haccept, hbit]
          · intro logical hne
            simp [hne.symm]
        · rw [Fintype.sum_eq_single (logicalErrorWord error)]
          · simp [haccept, hbit]
          · intro logical hne
            simp [hne.symm]
      · simp [haccept]

/-- The source's zero marginal sector is the dual of the actual extension
`G₀ + ⟨gᵃ⟩`, not an assumed output formula. -/
theorem accepts_and_logicalErrorWord_bit_zero_iff_mem_singleOddExtensionCode_dual
    (q : Nat) (a : OddRow q) (error : PhysicalError q) :
    Accepts error ∧ logicalErrorWord error a = 0 ↔
      error ∈ (singleOddExtensionCode a).dual.carrier := by
  constructor
  · intro h
    rw [LinearCode.mem_dual]
    intro word hword
    change word ∈ Submodule.span (ZMod 2) (Set.range (extensionRow a)) at hword
    induction hword using Submodule.span_induction with
    | mem word hword =>
        rcases hword with ⟨row, rfl⟩
        rcases row with row | row
        · simpa [extensionRow, logicalErrorWord] using h.2
        · simpa [extensionRow, wordPairing_apply, dotProduct_comm] using
            (accepts_iff_pairing_even_rows error).mp h.1 row
    | zero => simp
    | add left right _ _ hleft hright =>
        rw [(wordPairing error).map_add, hleft, hright, add_zero]
    | smul scalar word _ hword =>
        rw [(wordPairing error).map_smul, hword, smul_zero]
  · intro hdual
    constructor
    · apply (accepts_iff_pairing_even_rows error).mpr
      intro check
      have hmem : evenWord check ∈ (singleOddExtensionCode a).carrier := by
        exact Submodule.subset_span ⟨Sum.inr check, by simp [extensionRow]⟩
      exact LinearCode.dual_orthogonal (singleOddExtensionCode a) hmem hdual
    · have hmem : oddWord a ∈ (singleOddExtensionCode a).carrier := by
        exact Submodule.subset_span ⟨Sum.inl (), by simp [extensionRow]⟩
      have hpair :=
        LinearCode.dual_orthogonal (singleOddExtensionCode a) hmem hdual
      simpa [logicalErrorWord, wordPairing_apply, dotProduct_comm] using hpair

private noncomputable instance binaryCodeDualMembershipDecidable {q : Nat}
    (C : LinearCode (ZMod 2) (Column q)) :
    DecidablePred (fun error : PhysicalError q => error ∈ C.dual.carrier) :=
  Classical.decPred _

private theorem sum_dite_singleOddExtensionCodeDual (q : Nat) (a : OddRow q)
    (f : (singleOddExtensionCode a).dual.carrier → ℝ) :
    (∑ error : PhysicalError q,
      if herror : error ∈ (singleOddExtensionCode a).dual.carrier then
        f ⟨error, herror⟩ else 0) =
      ∑ error : (singleOddExtensionCode a).dual.carrier, f error := by
  exact sum_dite_submodule_real (singleOddExtensionCode a).dual.carrier f

/-- The raw marginal is the accepted mass minus the actual dual mass of the
zero-logical-bit extension. -/
theorem rawMarginalErrorWeight_eq_singleOddExtensionDualMass (q : Nat)
    (p : ErrorParameter) (a : OddRow q) :
    rawMarginalErrorWeight q p a =
      rawSuccessMass q p -
        ∑ error : (singleOddExtensionCode a).dual.carrier,
          errorWordProbability p (error : PhysicalError q) := by
  classical
  calc
    rawMarginalErrorWeight q p a =
        ∑ error : PhysicalError q,
          if Accepts error ∧ logicalErrorWord error a ≠ 0 then
            errorWordProbability p error else 0 :=
      rawMarginalErrorWeight_eq_errorWordSum q p a
    _ = (∑ error : PhysicalError q,
          if Accepts error then errorWordProbability p error else 0) -
          ∑ error : PhysicalError q,
            if error ∈ (singleOddExtensionCode a).dual.carrier then
              errorWordProbability p error else 0 := by
      rw [← Finset.sum_sub_distrib]
      apply Finset.sum_congr rfl
      intro error _
      by_cases haccept : Accepts error
      · by_cases hbit : logicalErrorWord error a = 0
        · have hext : error ∈ (singleOddExtensionCode a).dual.carrier :=
            (accepts_and_logicalErrorWord_bit_zero_iff_mem_singleOddExtensionCode_dual
              q a error).mp ⟨haccept, hbit⟩
          have hleft : ¬(Accepts error ∧ logicalErrorWord error a ≠ 0) :=
            fun h => h.2 hbit
          rw [if_neg hleft, if_pos haccept, if_pos hext]
          ring
        · have hext : error ∉ (singleOddExtensionCode a).dual.carrier := by
            intro hext
            exact hbit
              ((accepts_and_logicalErrorWord_bit_zero_iff_mem_singleOddExtensionCode_dual
                q a error).mpr hext).2
          have hleft : Accepts error ∧ logicalErrorWord error a ≠ 0 :=
            ⟨haccept, hbit⟩
          rw [if_pos hleft, if_pos haccept, if_neg hext]
          ring
      · have hext : error ∉ (singleOddExtensionCode a).dual.carrier := by
          intro hext
          exact haccept
            ((accepts_and_logicalErrorWord_bit_zero_iff_mem_singleOddExtensionCode_dual
              q a error).mpr hext).1
        have hleft : ¬(Accepts error ∧ logicalErrorWord error a ≠ 0) :=
          fun h => haccept h.1
        rw [if_neg hleft, if_neg haccept, if_neg hext]
        ring
    _ = rawSuccessMass q p -
          ∑ error : (singleOddExtensionCode a).dual.carrier,
            errorWordProbability p (error : PhysicalError q) := by
      have hdualMass :
          (∑ error : PhysicalError q,
            if error ∈ (singleOddExtensionCode a).dual.carrier then
              errorWordProbability p error else 0) =
            ∑ error : (singleOddExtensionCode a).dual.carrier,
              errorWordProbability p (error : PhysicalError q) := by
        exact sum_dite_singleOddExtensionCodeDual q a
          (fun error => errorWordProbability p (error : PhysicalError q))
      rw [rawSuccessMass, hdualMass]

/-- Translation by a codeword of an arbitrary finite binary code.  This is
the finite reindexing used for the extension-code character sum below. -/
private def binaryCodeTranslate {q : Nat}
    (C : LinearCode (ZMod 2) (Column q)) (word : C.carrier) :
    C.carrier ≃ C.carrier where
  toFun := fun codeword => codeword + word
  invFun := fun codeword => codeword - word
  left_inv := by
    intro codeword
    exact add_sub_cancel_right codeword word
  right_inv := by
    intro codeword
    exact sub_add_cancel codeword word

@[simp] private theorem coe_binaryCodeTranslate_apply {q : Nat}
    (C : LinearCode (ZMod 2) (Column q)) (word codeword : C.carrier) :
    ((binaryCodeTranslate C word codeword : C.carrier) : PhysicalError q) =
      (codeword : PhysicalError q) + (word : PhysicalError q) :=
  rfl

private def binaryCodeCharacter {q : Nat}
    (C : LinearCode (ZMod 2) (Column q)) (codeword : C.carrier)
    (error : PhysicalError q) : ℝ :=
  realBinarySign (wordPairing (codeword : PhysicalError q) error)

private noncomputable def binaryCodeCarrierCard {q : Nat}
    (C : LinearCode (ZMod 2) (Column q)) : Nat :=
  letI : Fintype C.carrier := Fintype.ofFinite _
  Fintype.card C.carrier

private theorem binaryCodeCharacter_translate {q : Nat}
    (C : LinearCode (ZMod 2) (Column q)) (word codeword : C.carrier)
    (error : PhysicalError q)
    (hword : wordPairing (word : PhysicalError q) error ≠ 0) :
    binaryCodeCharacter C (binaryCodeTranslate C word codeword) error =
      -binaryCodeCharacter C codeword error := by
  unfold binaryCodeCharacter
  change realBinarySign
      (wordPairing ((codeword : PhysicalError q) + (word : PhysicalError q)) error) = _
  rw [map_add]
  exact realBinarySign_add_of_ne_zero _ _ hword

private theorem binaryCodeCharacter_sum (q : Nat)
    (C : LinearCode (ZMod 2) (Column q)) (error : PhysicalError q) :
    (∑ codeword : C.carrier, binaryCodeCharacter C codeword error) =
      if error ∈ C.dual.carrier then binaryCodeCarrierCard C else 0 := by
  classical
  letI : Fintype C.carrier := Fintype.ofFinite _
  unfold binaryCodeCarrierCard
  by_cases hdual : error ∈ C.dual.carrier
  · have horth (codeword : C.carrier) :
        wordPairing (codeword : PhysicalError q) error = 0 :=
      LinearCode.dual_orthogonal C codeword.property hdual
    rw [if_pos hdual]
    simp [binaryCodeCharacter, realBinarySign, horth]
  · obtain ⟨word, hword, hpair⟩ :=
      exists_carrier_wordPairing_ne_zero_of_not_mem_dual C hdual
    let carrierWord : C.carrier := ⟨word, hword⟩
    have hpair' : wordPairing (carrierWord : PhysicalError q) error ≠ 0 := by
      simpa [wordPairing_apply, dotProduct_comm] using hpair
    have htranslate :
        (∑ codeword : C.carrier, binaryCodeCharacter C codeword error) =
          ∑ codeword : C.carrier,
            binaryCodeCharacter C (binaryCodeTranslate C carrierWord codeword) error := by
      symm
      exact (binaryCodeTranslate C carrierWord).sum_comp
        (fun codeword => binaryCodeCharacter C codeword error)
    rw [if_neg hdual]
    have hneg :
        (∑ codeword : C.carrier, binaryCodeCharacter C codeword error) =
          -(∑ codeword : C.carrier, binaryCodeCharacter C codeword error) := by
      calc
        (∑ codeword : C.carrier, binaryCodeCharacter C codeword error) =
            ∑ codeword : C.carrier,
              binaryCodeCharacter C (binaryCodeTranslate C carrierWord codeword) error :=
          htranslate
        _ = ∑ codeword : C.carrier, -binaryCodeCharacter C codeword error := by
          apply Finset.sum_congr rfl
          intro codeword _
          exact binaryCodeCharacter_translate C carrierWord codeword error hpair'
        _ = -(∑ codeword : C.carrier, binaryCodeCharacter C codeword error) := by
          rw [Finset.sum_neg_distrib]
    simpa using (CharZero.eq_neg_self_iff.mp hneg)

private theorem binaryCode_dual_indicator_eq_character_average (q : Nat)
    (C : LinearCode (ZMod 2) (Column q)) (error : PhysicalError q) :
    (if error ∈ C.dual.carrier then (1 : ℝ) else 0) =
      (binaryCodeCarrierCard C : ℝ)⁻¹ *
        ∑ codeword : C.carrier, binaryCodeCharacter C codeword error := by
  have hcard : (binaryCodeCarrierCard C : ℝ) ≠ 0 := by
    unfold binaryCodeCarrierCard
    exact_mod_cast (Fintype.card_ne_zero : Fintype.card C.carrier ≠ 0)
  rw [binaryCodeCharacter_sum]
  by_cases hdual : error ∈ C.dual.carrier <;>
    simp only [hdual, if_true, if_false, Nat.cast_zero, mul_zero, inv_mul_cancel₀ hcard]

private theorem binaryLinearCode_dual_bernoulliMass_eq_weightSum (q : Nat)
    (C : LinearCode (ZMod 2) (Column q)) (p : ErrorParameter) :
    (∑ error : C.dual.carrier,
      errorWordProbability p (error : PhysicalError q)) =
      (binaryCodeCarrierCard C : ℝ)⁻¹ *
        codeWeightSum C (fun weight => (1 - 2 * p.rate) ^ weight) := by
  classical
  letI : Fintype C.carrier := Fintype.ofFinite _
  calc
    (∑ error : C.dual.carrier,
      errorWordProbability p (error : PhysicalError q)) =
        ∑ error : PhysicalError q,
          if herror : error ∈ C.dual.carrier then
            errorWordProbability p error else 0 := by
      symm
      simpa using sum_dite_submodule_real C.dual.carrier
        (fun error => errorWordProbability p (error : PhysicalError q))
    _ = ∑ error : PhysicalError q,
          errorWordProbability p error *
            (if error ∈ C.dual.carrier then (1 : ℝ) else 0) := by
      apply Finset.sum_congr rfl
      intro error _
      by_cases hdual : error ∈ C.dual.carrier <;>
        simp only [hdual, dite_true, dite_false, if_true, if_false, mul_one, mul_zero]
    _ = ∑ error : PhysicalError q,
          errorWordProbability p error *
            ((binaryCodeCarrierCard C : ℝ)⁻¹ *
              ∑ codeword : C.carrier, binaryCodeCharacter C codeword error) := by
      apply Finset.sum_congr rfl
      intro error _
      exact congrArg (errorWordProbability p error * ·)
        (binaryCode_dual_indicator_eq_character_average q C error)
    _ = (binaryCodeCarrierCard C : ℝ)⁻¹ *
          ∑ codeword : C.carrier,
            ∑ error : PhysicalError q,
              errorWordProbability p error * binaryCodeCharacter C codeword error := by
      calc
        (∑ error : PhysicalError q,
          errorWordProbability p error *
            ((binaryCodeCarrierCard C : ℝ)⁻¹ *
              ∑ codeword : C.carrier, binaryCodeCharacter C codeword error)) =
            ∑ error : PhysicalError q,
              ∑ codeword : C.carrier,
                (binaryCodeCarrierCard C : ℝ)⁻¹ *
                  (errorWordProbability p error * binaryCodeCharacter C codeword error) := by
              apply Finset.sum_congr rfl
              intro error _
              calc
                errorWordProbability p error *
                    ((binaryCodeCarrierCard C : ℝ)⁻¹ *
                      ∑ codeword : C.carrier, binaryCodeCharacter C codeword error) =
                    (binaryCodeCarrierCard C : ℝ)⁻¹ *
                      (errorWordProbability p error *
                        ∑ codeword : C.carrier, binaryCodeCharacter C codeword error) := by
                  ring
                _ = (binaryCodeCarrierCard C : ℝ)⁻¹ *
                      ∑ codeword : C.carrier,
                        errorWordProbability p error * binaryCodeCharacter C codeword error := by
                  rw [Finset.mul_sum]
                _ = ∑ codeword : C.carrier,
                      (binaryCodeCarrierCard C : ℝ)⁻¹ *
                        (errorWordProbability p error * binaryCodeCharacter C codeword error) := by
                  rw [Finset.mul_sum]
        _ = (binaryCodeCarrierCard C : ℝ)⁻¹ *
            ∑ codeword : C.carrier,
              ∑ error : PhysicalError q,
                errorWordProbability p error * binaryCodeCharacter C codeword error := by
              rw [Finset.sum_comm, Finset.mul_sum]
              apply Finset.sum_congr rfl
              intro codeword _
              rw [Finset.mul_sum]
    _ = (binaryCodeCarrierCard C : ℝ)⁻¹ *
          ∑ codeword : C.carrier,
            (1 - 2 * p.rate) ^ HammingWeight (codeword : PhysicalError q) := by
      apply congrArg ((binaryCodeCarrierCard C : ℝ)⁻¹ * ·)
      apply Finset.sum_congr rfl
      intro codeword _
      simpa [binaryCodeCharacter] using
        bernoulliCharacter_transform q p (codeword : PhysicalError q)
    _ = (binaryCodeCarrierCard C : ℝ)⁻¹ *
          codeWeightSum C (fun weight => (1 - 2 * p.rate) ^ weight) := by
      apply congrArg ((binaryCodeCarrierCard C : ℝ)⁻¹ * ·)
      unfold codeWeightSum
      apply Finset.sum_congr
      · ext codeword
        simp
      · intro codeword _
        rfl

private theorem singleOddExtensionCode_carrier_card {q : Nat} (a : OddRow q) :
    binaryCodeCarrierCard (singleOddExtensionCode a) = 16 := by
  unfold binaryCodeCarrierCard
  letI : Fintype (singleOddExtensionCode a).carrier := Fintype.ofFinite _
  calc
    Fintype.card (singleOddExtensionCode a).carrier =
        Fintype.card (Sum Unit EvenRow → ZMod 2) :=
      Fintype.card_congr (extensionCoefficientLinearEquiv a).toEquiv.symm
    _ = Fintype.card (ZMod 2 × Fin 8) :=
      Fintype.card_congr extensionCoefficientEquiv.symm
    _ = 16 := by native_decide

/-- The finite extension-code character calculation evaluates the literal
zero-marginal dual Bernoulli mass from the actual 16-word enumerator. -/
theorem singleOddExtensionCode_dual_bernoulliMass_eq_weightSum (q : Nat)
    (a : OddRow q) (p : ErrorParameter) :
    (∑ error : (singleOddExtensionCode a).dual.carrier,
      errorWordProbability p (error : PhysicalError q)) =
      (16 : ℝ)⁻¹ *
        codeWeightSum (singleOddExtensionCode a)
          (fun weight => (1 - 2 * p.rate) ^ weight) := by
  rw [binaryLinearCode_dual_bernoulliMass_eq_weightSum,
    singleOddExtensionCode_carrier_card]
  norm_num

/-- Subtracting the actual zero-marginal extension dual mass from success and
using the two #754 enumerators gives the exact raw output-error polynomial. -/
theorem rawMarginalErrorWeight_eq_evenFamilyWeightSum (q : Nat)
    (p : ErrorParameter) (a : OddRow q) :
    rawMarginalErrorWeight q p a =
      (16 : ℝ)⁻¹ *
        (1 + (1 - 2 * p.rate) ^ 8 +
          6 * (1 - 2 * p.rate) ^ (4 + 4 * q) -
          2 * (1 - 2 * p.rate) ^ 7 -
          6 * (1 - 2 * p.rate) ^ (3 + 4 * q)) := by
  rw [rawMarginalErrorWeight_eq_singleOddExtensionDualMass,
    rawSuccessMass_eq_evenFamilyWeightSum,
    singleOddExtensionCode_dual_bernoulliMass_eq_weightSum,
    singleOddExtensionCode_weightSum]
  simp [nsmul_eq_mul]
  ring

private theorem one_sub_pow_le_nat_mul_one_sub (r : ℝ) (hr0 : 0 ≤ r) (n : Nat) :
    1 - r ^ n ≤ (n : ℝ) * (1 - r) := by
  have hbernoulli : 1 + (n : ℝ) * (r - 1) ≤ r ^ n := by
    apply one_add_mul_sub_le_pow
    linarith
  linarith

private theorem pow_sub_pow_le_nat_mul_one_sub (r : ℝ)
    (hr0 : 0 ≤ r) (hr1 : r ≤ 1) {low high : Nat} (hlow : low ≤ high) :
    r ^ low - r ^ high ≤ ((high - low : Nat) : ℝ) * (1 - r) := by
  have hpow : r ^ high = r ^ low * r ^ (high - low) := by
    calc
      r ^ high = r ^ (low + (high - low)) := by congr 1; omega
      _ = r ^ low * r ^ (high - low) := pow_add r low (high - low)
  rw [hpow]
  calc
    r ^ low - r ^ low * r ^ (high - low) =
        r ^ low * (1 - r ^ (high - low)) := by ring
    _ ≤ 1 * (1 - r ^ (high - low)) := by
      exact mul_le_mul_of_nonneg_right (pow_le_one₀ hr0 hr1)
        (sub_nonneg.mpr (pow_le_one₀ hr0 hr1))
    _ ≤ 1 * ((high - low : Nat) : ℝ) * (1 - r) := by
      simpa only [one_mul] using
        one_sub_pow_le_nat_mul_one_sub r hr0 (high - low)
    _ = ((high - low : Nat) : ℝ) * (1 - r) := by ring

/-- The exact #754 marginal polynomial is bounded by its source-leading
quadratic coefficient on the explicit half-error interval. -/
theorem rawMarginalErrorWeight_le_evenFamily_quadratic (q : Nat)
    (p : ErrorParameter) (a : OddRow q) (hhalf : p.rate ≤ 1 / 2) :
    rawMarginalErrorWeight q p a ≤
      ((1 + 6 * q : Nat) : ℝ) * p.rate ^ 2 := by
  let r : ℝ := 1 - 2 * p.rate
  have hr0 : 0 ≤ r := by
    dsimp [r]
    linarith
  have hr1 : r ≤ 1 := by
    dsimp [r]
    linarith [p.rate_nonneg]
  have honeSub : 0 ≤ 1 - r := sub_nonneg.mpr hr1
  have hq : 1 ≤ q := by
    have hlt := a.1.isLt
    omega
  have hhigh : 7 ≤ 3 + 4 * q := by omega
  have hgeom :
      (∑ i ∈ Finset.range 7, r ^ i) * (1 - r) = 1 - r ^ 7 :=
    geom_sum_mul_of_le_one hr1 7
  have hfactor :
      1 + r ^ 8 + 6 * r ^ (4 + 4 * q) - 2 * r ^ 7 -
          6 * r ^ (3 + 4 * q) =
        (1 - r) *
          ((∑ i ∈ Finset.range 7, r ^ i) - r ^ 7 -
            6 * r ^ (3 + 4 * q)) := by
    have hpow : r ^ (4 + 4 * q) = r ^ (3 + 4 * q) * r := by
      rw [show 4 + 4 * q = (3 + 4 * q) + 1 by omega, pow_succ]
    calc
      1 + r ^ 8 + 6 * r ^ (4 + 4 * q) - 2 * r ^ 7 -
          6 * r ^ (3 + 4 * q) =
          (1 - r ^ 7) - r ^ 7 * (1 - r) -
            6 * r ^ (3 + 4 * q) * (1 - r) := by
          rw [hpow]
          ring
      _ = (1 - r) *
          ((∑ i ∈ Finset.range 7, r ^ i) - r ^ 7 -
            6 * r ^ (3 + 4 * q)) := by
          rw [← hgeom]
          ring
  have hfirst :
      (∑ i ∈ Finset.range 7, (r ^ i - r ^ 7)) ≤ 28 * (1 - r) := by
    calc
      (∑ i ∈ Finset.range 7, (r ^ i - r ^ 7)) ≤
          ∑ i ∈ Finset.range 7, ((7 - i : Nat) : ℝ) * (1 - r) := by
        apply Finset.sum_le_sum
        intro i hi
        exact pow_sub_pow_le_nat_mul_one_sub r hr0 hr1
          (Nat.le_of_lt (Finset.mem_range.mp hi))
      _ = 28 * (1 - r) := by
        norm_num [Finset.sum_range_succ]
        ring
  have hsecond : r ^ 7 - r ^ (3 + 4 * q) ≤
      ((3 + 4 * q - 7 : Nat) : ℝ) * (1 - r) :=
    pow_sub_pow_le_nat_mul_one_sub r hr0 hr1 hhigh
  have hbracket :
      (∑ i ∈ Finset.range 7, r ^ i) - r ^ 7 -
          6 * r ^ (3 + 4 * q) ≤
        ((4 + 24 * q : Nat) : ℝ) * (1 - r) := by
    calc
      (∑ i ∈ Finset.range 7, r ^ i) - r ^ 7 -
          6 * r ^ (3 + 4 * q) =
          (∑ i ∈ Finset.range 7, (r ^ i - r ^ 7)) +
            6 * (r ^ 7 - r ^ (3 + 4 * q)) := by
          norm_num [Finset.sum_range_succ]
          ring
      _ ≤ 28 * (1 - r) +
          6 * (((3 + 4 * q - 7 : Nat) : ℝ) * (1 - r)) := by
          exact add_le_add hfirst
            (mul_le_mul_of_nonneg_left hsecond (by norm_num))
      _ = ((4 + 24 * q : Nat) : ℝ) * (1 - r) := by
          rw [Nat.cast_sub hhigh]
          push_cast
          ring
  rw [rawMarginalErrorWeight_eq_evenFamilyWeightSum]
  change (16 : ℝ)⁻¹ *
      (1 + r ^ 8 + 6 * r ^ (4 + 4 * q) - 2 * r ^ 7 -
        6 * r ^ (3 + 4 * q)) ≤
    ((1 + 6 * q : Nat) : ℝ) * p.rate ^ 2
  calc
    (16 : ℝ)⁻¹ *
        (1 + r ^ 8 + 6 * r ^ (4 + 4 * q) - 2 * r ^ 7 -
          6 * r ^ (3 + 4 * q)) =
        (16 : ℝ)⁻¹ * ((1 - r) *
          ((∑ i ∈ Finset.range 7, r ^ i) - r ^ 7 -
            6 * r ^ (3 + 4 * q))) := by rw [hfactor]
    _ ≤ (16 : ℝ)⁻¹ * ((1 - r) *
          (((4 + 24 * q : Nat) : ℝ) * (1 - r))) := by
          exact mul_le_mul_of_nonneg_left
            (mul_le_mul_of_nonneg_left hbracket honeSub) (by norm_num)
    _ = ((1 + 6 * q : Nat) : ℝ) * p.rate ^ 2 := by
          dsimp [r]
          push_cast
          ring

/-- On the same explicit interval the actual enumerator success expression is
at least its positive all-zero Fourier contribution. -/
theorem rawSuccessMass_one_eighth_le_of_rate_le_half (q : Nat)
    (p : ErrorParameter) (hhalf : p.rate ≤ 1 / 2) :
    (8 : ℝ)⁻¹ ≤ rawSuccessMass q p := by
  let r : ℝ := 1 - 2 * p.rate
  have hr0 : 0 ≤ r := by
    dsimp [r]
    linarith
  have hsum : 1 ≤ 1 + r ^ 8 + 6 * r ^ (4 + 4 * q) := by
    have h8 : 0 ≤ r ^ 8 := pow_nonneg hr0 _
    have hlong : 0 ≤ r ^ (4 + 4 * q) := pow_nonneg hr0 _
    linarith
  rw [rawSuccessMass_eq_evenFamilyWeightSum]
  change (8 : ℝ)⁻¹ ≤
    (8 : ℝ)⁻¹ * (1 + r ^ 8 + 6 * r ^ (4 + 4 * q))
  calc
    (8 : ℝ)⁻¹ = (8 : ℝ)⁻¹ * 1 := by ring
    _ ≤ (8 : ℝ)⁻¹ * (1 + r ^ 8 + 6 * r ^ (4 + 4 * q)) :=
      mul_le_mul_of_nonneg_left hsum (by norm_num)

/-- A positive accepted mass is derived from the concrete success enumerator
throughout the stated small-error interval; no zero-weight normalization is
introduced. -/
theorem rawSuccessMass_pos_of_rate_le_half (q : Nat)
    (p : ErrorParameter) (hhalf : p.rate ≤ 1 / 2) :
    0 < rawSuccessMass q p := by
  exact lt_of_lt_of_le (by norm_num)
    (rawSuccessMass_one_eighth_le_of_rate_le_half q p hhalf)

/-- Every physical output's normalized error is quadratically suppressed on
the explicit half-error interval, with the coefficient derived from the
concrete BH12 enumerators. -/
theorem decodedMarginalError_le_evenFamily_quadratic (q : Nat)
    (p : ErrorParameter) (a : OddRow q) (hhalf : p.rate ≤ 1 / 2) :
    decodedMarginalError q p
      (rawSuccessMass_pos_of_rate_le_half q p hhalf) a ≤
      8 * ((1 + 6 * q : Nat) : ℝ) * p.rate ^ 2 := by
  have hpos : 0 < rawSuccessMass q p :=
    rawSuccessMass_pos_of_rate_le_half q p hhalf
  have hsuccess : (8 : ℝ)⁻¹ ≤ rawSuccessMass q p :=
    rawSuccessMass_one_eighth_le_of_rate_le_half q p hhalf
  have hmarginal : rawMarginalErrorWeight q p a ≤
      ((1 + 6 * q : Nat) : ℝ) * p.rate ^ 2 :=
    rawMarginalErrorWeight_le_evenFamily_quadratic q p a hhalf
  simp only [decodedMarginalError, dif_pos hpos]
  apply (div_le_iff₀ hpos).mpr
  calc
    rawMarginalErrorWeight q p a ≤
        ((1 + 6 * q : Nat) : ℝ) * p.rate ^ 2 := hmarginal
    _ = (8 * ((1 + 6 * q : Nat) : ℝ) * p.rate ^ 2) * (8 : ℝ)⁻¹ := by
      ring
    _ ≤ (8 * ((1 + 6 * q : Nat) : ℝ) * p.rate ^ 2) *
        rawSuccessMass q p :=
      mul_le_mul_of_nonneg_left hsuccess (by positivity)

/-- The independent input model permits exactly the one-site diagonal
`A`-basis resources used by the supplied BH12 run, at their common physical
error rate. -/
def bh12IndependentInputModel (q : Nat) (p : ErrorParameter) :
    IndependentInputErrorModel (resourceCount q) Qubit.QubitSpace where
  rate := fun _ => p.rate
  rate_nonneg := fun _ => p.rate_nonneg
  rate_le_one := fun _ => p.rate_le_one
  admissible := fun rates inputs =>
    ∀ site, rates site = p.rate ∧
      inputs site = OneQubit.diagonalAResource p

/-- The actual BH12 diagonal resource family is permitted by its independent
input model; this is a per-site fact, not a wrapper assumption. -/
theorem bh12IndependentInputModel_permits (q : Nat) (p : ErrorParameter) :
    (InputErrorModel.independent (bh12IndependentInputModel q p)).Permits
      (noisyResources q p) := by
  change ∀ site, (fun _ => p.rate) site = p.rate ∧
    noisyResources q p site = OneQubit.diagonalAResource p
  intro site
  exact ⟨rfl, rfl⟩

/-- The ideal logical output is the normalized product logical magic state
already constructed by the corrected transversal foundation. -/
noncomputable def bh12IdealOutput (q : Nat) : DensityOperator (LogicalRegister q) :=
  DensityOperator.pureDensity
    (BinaryRowFamily.logicalMagicState (OddRow q))
    (by
      have hinner :
          inner Complex
              (BinaryRowFamily.logicalMagicState (OddRow q))
              (BinaryRowFamily.logicalMagicState (OddRow q)) = 1 := by
        exact BinaryRowFamily.logicalMagicState_inner_self (OddRow q)
      rw [InnerProductSpace.norm_sq_eq_re_inner (𝕜 := Complex), hinner]
      norm_num)

/-- The source A-basis observable on one logical output, obtained by
conjugating that output's literal `X` by the actual all-output `T` layer. -/
noncomputable def logicalABasisObservable {q : Nat} (a : OddRow q) :
    Operator (LogicalRegister q) :=
  (allSiteT (Index := OddRow q)).conjOperator (Qubit.localX a)

theorem logicalABasisObservable_adjoint {q : Nat} (a : OddRow q) :
    LinearMap.adjoint (logicalABasisObservable a) =
      logicalABasisObservable a := by
  rw [logicalABasisObservable, UnitaryTransport.conjOperator_adjoint,
    Qubit.localX_adjoint]

theorem logicalABasisObservable_square {q : Nat} (a : OddRow q) :
    logicalABasisObservable a * logicalABasisObservable a = 1 := by
  rw [logicalABasisObservable, ← UnitaryTransport.conjOperator_mul,
    Qubit.localX_square]
  exact (allSiteT (Index := OddRow q)).conjOperator_one

/-- The two actual spectral projectors measuring output `a` in the A basis. -/
noncomputable def logicalABasisProjector {q : Nat} (a : OddRow q)
    (outcome : StabilizerOutcome) : Operator (LogicalRegister q) :=
  (1 / 2 : Complex) •
    (1 + outcome.sign • logicalABasisObservable a)

theorem logicalABasisProjector_adjoint {q : Nat} (a : OddRow q)
    (outcome : StabilizerOutcome) :
    LinearMap.adjoint (logicalABasisProjector a outcome) =
      logicalABasisProjector a outcome := by
  apply LinearMap.IsSymmetric.adjoint_eq
  unfold logicalABasisProjector
  apply LinearMap.IsSymmetric.smul
  · have hreal : starRingEnd Complex ((2 : Complex)⁻¹) =
        (2 : Complex)⁻¹ := by
      rw [map_inv₀]
      have htwo : starRingEnd Complex (2 : Complex) = 2 :=
        map_natCast (starRingEnd Complex) 2
      rw [htwo]
    simpa only [one_div] using hreal
  · apply LinearMap.IsSymmetric.add
    · exact LinearMap.IsSymmetric.one
    · apply LinearMap.IsSymmetric.smul
      · cases outcome <;> simp [StabilizerOutcome.sign]
      · rw [LinearMap.isSymmetric_iff_isSelfAdjoint]
        exact logicalABasisObservable_adjoint a

theorem logicalABasisProjector_idempotent {q : Nat} (a : OddRow q)
    (outcome : StabilizerOutcome) :
    logicalABasisProjector a outcome * logicalABasisProjector a outcome =
      logicalABasisProjector a outcome := by
  cases outcome <;>
    simp only [logicalABasisProjector, StabilizerOutcome.sign,
      smul_mul_assoc, mul_smul_comm, mul_add, add_mul, one_mul, mul_one,
      logicalABasisObservable_square] <;>
    module

theorem logicalABasisProjector_add {q : Nat} (a : OddRow q) :
    logicalABasisProjector a .positive +
      logicalABasisProjector a .negative = 1 := by
  simp only [logicalABasisProjector, StabilizerOutcome.sign]
  module

/-- Projective measurement of one actual logical-output A-basis observable. -/
noncomputable def logicalABasisKrausFamily {q : Nat} (a : OddRow q) :
    FiniteKrausFamily StabilizerOutcome (LogicalRegister q) (LogicalRegister q) where
  operator := logicalABasisProjector a

theorem logicalABasisKrausFamily_complete {q : Nat} (a : OddRow q) :
    (logicalABasisKrausFamily a).Complete := by
  unfold FiniteKrausFamily.Complete
  simp only [logicalABasisKrausFamily, logicalABasisProjector_adjoint]
  change
    (∑ outcome : StabilizerOutcome,
      logicalABasisProjector a outcome * logicalABasisProjector a outcome) = 1
  rw [show (Finset.univ : Finset StabilizerOutcome) =
      {.positive, .negative} by decide]
  simpa [logicalABasisProjector_idempotent] using
    logicalABasisProjector_add a

noncomputable def logicalABasisInstrument {q : Nat} (a : OddRow q) :
    FiniteInstrument StabilizerOutcome StabilizerOutcome
      (LogicalRegister q) (LogicalRegister q) where
  kraus := logicalABasisKrausFamily a
  observe := id

theorem logicalABasisInstrument_complete {q : Nat} (a : OddRow q) :
    (logicalABasisInstrument a).kraus.Complete :=
  logicalABasisKrausFamily_complete a

private theorem logical_wordPairing_single_left {q : Nat} (a : OddRow q)
    (logical : Word (ZMod 2) (OddRow q)) :
    wordPairing (Pi.single a 1) logical = logical a := by
  classical
  rw [wordPairing_apply, dotProduct, Finset.sum_eq_single a]
  · simp
  · intro b _hb hba
    simp [hba]
  · simp

private theorem logicalXOperator_eq_localX {q : Nat} (a : OddRow q) :
    toQubitOperator (cssXCheck (Pi.single a 1)) = Qubit.localX a := by
  classical
  have hsupport : binarySupport (Pi.single a 1) = {a} := by
    ext x
    by_cases hxa : x = a
    · subst x
      simp [binarySupport]
    · simp [binarySupport, hxa]
  ext psi bits
  simp [toQubitOperator_apply, cssXCheck, xSupport, zSupport,
    hsupport, Qubit.flipSupport_singleton, Qubit.zSupportPhase]

private theorem allSiteT_commutes_logicalZ {q : Nat}
    (logical : Word (ZMod 2) (OddRow q)) (psi : LogicalRegister q) :
    (allSiteT (Index := OddRow q))
        (toQubitOperator (cssZCheck logical) psi) =
      toQubitOperator (cssZCheck logical)
        ((allSiteT (Index := OddRow q)) psi) := by
  ext bits
  simp only [allSiteT_apply, toQubitOperator_apply]
  simp [xSupport, zSupport, binarySupport]
  ring

private theorem localX_logicalPlusState {q : Nat} (a : OddRow q) :
    Qubit.localX a (BinaryRowFamily.logicalPlusState (OddRow q)) =
      BinaryRowFamily.logicalPlusState (OddRow q) := by
  ext bits
  simp [BinaryRowFamily.logicalPlusState_apply]

/-- The logical product A-basis state labelled by one decoded `Z`-error word. -/
noncomputable def logicalErrorState {q : Nat}
    (logical : Word (ZMod 2) (OddRow q)) : LogicalRegister q :=
  toQubitOperator (cssZCheck logical)
    (BinaryRowFamily.logicalMagicState (OddRow q))

theorem logicalErrorState_normSq {q : Nat}
    (logical : Word (ZMod 2) (OddRow q)) :
    ‖logicalErrorState logical‖ ^ 2 = 1 := by
  have hinner :
      inner Complex (logicalErrorState logical) (logicalErrorState logical) = 1 := by
    simp only [logicalErrorState]
    rw [← LinearMap.adjoint_inner_left]
    have hunit := toQubitOperator_adjoint_comp_self (cssZCheck logical)
    have happ :
        LinearMap.adjoint (toQubitOperator (cssZCheck logical))
            (toQubitOperator (cssZCheck logical)
              (BinaryRowFamily.logicalMagicState (OddRow q))) =
          BinaryRowFamily.logicalMagicState (OddRow q) := by
      have := LinearMap.congr_fun hunit
        (BinaryRowFamily.logicalMagicState (OddRow q))
      simpa [LinearMap.comp_apply] using this
    rw [happ]
    exact BinaryRowFamily.logicalMagicState_inner_self (OddRow q)
  rw [InnerProductSpace.norm_sq_eq_re_inner (𝕜 := Complex), hinner]
  norm_num

@[simp] theorem logicalErrorState_zero {q : Nat} :
    logicalErrorState (0 : Word (ZMod 2) (OddRow q)) =
      BinaryRowFamily.logicalMagicState (OddRow q) := by
  ext bits
  simp [logicalErrorState, toQubitOperator_apply, cssZCheck, xSupport,
    zSupport, binaryPhaseScalar, Qubit.zSupportPhase]

set_option maxHeartbeats 800000 in
private theorem acceptedError_pairing_encodingLabel {q : Nat}
    {error : PhysicalError q} (haccept : Accepts error)
    (bits : Qubit.Bitstring (Column q))
    (hbits : bitstringWordEquiv (Column q) bits ∈
      (family q).rowCode.dual.dual.carrier) :
    wordPairing error (bitstringWordEquiv (Column q) bits) =
      wordPairing (logicalErrorWord error)
        (bitstringWordEquiv (OddRow q)
          ((family q).logicalBasisEquivLogicalQuotient (isTriorthogonal q) |>.symm
            (Submodule.Quotient.mk
              ⟨bitstringWordEquiv (Column q) bits, hbits⟩))) := by
  let label : Qubit.Bitstring (OddRow q) :=
    (family q).logicalBasisEquivLogicalQuotient (isTriorthogonal q) |>.symm
      (Submodule.Quotient.mk
        ⟨bitstringWordEquiv (Column q) bits, hbits⟩)
  have hquotient :
      (family q).oddWordToLogicalQuotient
          (bitstringWordEquiv (OddRow q) label) =
        Submodule.Quotient.mk
          ⟨bitstringWordEquiv (Column q) bits, hbits⟩ := by
    change (family q).logicalBasisEquivLogicalQuotient
      (isTriorthogonal q) label = _
    exact Equiv.apply_symm_apply _ _
  have heven :=
    (Submodule.Quotient.eq
      (PauliSymplectic.binaryCSSXCodeInZDual
        (family q).evenCode (family q).rowCode.dual)).mp hquotient
  change (family q).oddCombination
      (bitstringWordEquiv (OddRow q) label) -
        bitstringWordEquiv (Column q) bits ∈
      (family q).evenCode.carrier at heven
  have horth :
      wordPairing error
          ((family q).oddCombination
            (bitstringWordEquiv (OddRow q) label) -
              bitstringWordEquiv (Column q) bits) = 0 :=
    (family q).evenCode.orthogonal_of_mem_dual
      ((accepts_iff_mem_evenCode_dual error).mp haccept) heven
  rw [(wordPairing error).map_sub] at horth
  have hphysical :
      wordPairing error (bitstringWordEquiv (Column q) bits) =
        wordPairing error
          ((family q).oddCombination
            (bitstringWordEquiv (OddRow q) label)) :=
    (sub_eq_zero.mp horth).symm
  change wordPairing error (bitstringWordEquiv (Column q) bits) =
    wordPairing (logicalErrorWord error)
      (bitstringWordEquiv (OddRow q) label)
  rw [hphysical, BinaryRowFamily.oddCombination_apply]
  rw [map_sum]
  simp_rw [map_smul]
  rw [wordPairing_apply, dotProduct]
  apply Finset.sum_congr rfl
  intro a _ha
  change (bitstringWordEquiv (OddRow q) label) a *
      wordPairing error (oddWord a) =
    logicalErrorWord error a *
      (bitstringWordEquiv (OddRow q) label) a
  rw [logicalErrorWord]
  ring

/-- Every accepted physical error branch is the concrete encoding of the
logical product state labelled by its derived odd-row syndrome. -/
theorem errorBranchState_eq_ambientEncodingIsometry {q : Nat}
    (error : PhysicalError q) (haccept : Accepts error) :
    errorBranchState error =
      ambientEncodingIsometry q (logicalErrorState (logicalErrorWord error)) := by
  ext bits
  by_cases hbits : bitstringWordEquiv (Column q) bits ∈
      (family q).rowCode.dual.dual.carrier
  · simp only [errorBranchState, logicalErrorState,
      ambientEncodingIsometry_apply]
    rw [toQubitOperator_apply]
    simp only [cssZCheck, binaryPhaseScalar, xSupport, zSupport,
      binarySupport_zero, Qubit.flipSupport_empty, if_true, one_mul]
    rw [
      (family q).encodedMagicState_apply_of_mem
        (isTriorthogonal q) hbits,
      (family q).encoding_apply_of_mem
        (isTriorthogonal q) _ hbits,
      toQubitOperator_apply]
    simp only [binaryPhaseScalar, xSupport, zSupport,
      binarySupport_zero, Qubit.flipSupport_empty, if_true, one_mul,
      BinaryRowFamily.logicalMagicState_apply]
    rw [zSupportPhase_eq_binaryPhaseScalar_wordPairing,
      zSupportPhase_eq_binaryPhaseScalar_wordPairing,
      acceptedError_pairing_encodingLabel haccept bits hbits]
    ring
  · simp only [errorBranchState, logicalErrorState,
      ambientEncodingIsometry_apply]
    rw [toQubitOperator_apply]
    simp only [cssZCheck, binaryPhaseScalar, xSupport, zSupport,
      binarySupport_zero, Qubit.flipSupport_empty, if_true, one_mul]
    rw [
      (family q).encodedMagicState_apply_of_not_mem
        (isTriorthogonal q) hbits,
      (family q).encoding_apply_of_not_mem
        (isTriorthogonal q) _ hbits]
    simp

/-- The transported local A observable fixes the ideal logical magic state. -/
@[simp] theorem logicalABasisObservable_logicalMagicState {q : Nat}
    (a : OddRow q) :
    logicalABasisObservable a
        (BinaryRowFamily.logicalMagicState (OddRow q)) =
      BinaryRowFamily.logicalMagicState (OddRow q) := by
  rw [← allSiteT_logicalPlusState q]
  rw [logicalABasisObservable, UnitaryTransport.conjOperator_apply]
  simp only [LinearEquiv.symm_apply_apply]
  rw [localX_logicalPlusState]

private theorem localX_logicalZ_relation {q : Nat} (a : OddRow q)
    (logical : Word (ZMod 2) (OddRow q)) :
    Qubit.localX a * toQubitOperator (cssZCheck logical) =
      if logical a = 0 then
        toQubitOperator (cssZCheck logical) * Qubit.localX a
      else
        -(toQubitOperator (cssZCheck logical) * Qubit.localX a) := by
  rw [← logicalXOperator_eq_localX a]
  by_cases hbit : logical a = 0
  · rw [if_pos hbit]
    exact cssXCheck_toQubitOperator_commute_cssZCheck_of_wordPairing_eq_zero
      (by simpa [logical_wordPairing_single_left] using hbit)
  · rw [if_neg hbit]
    apply toQubitOperator_anticommute_of_not_commutes
    have hpair : wordPairing (Pi.single a 1) logical ≠ 0 := by
      simpa [logical_wordPairing_single_left] using hbit
    simpa [cssXCheck, cssZCheck, Commutes,
      symplecticForm_x_zero_zero_z_eq_wordPairing] using hpair

/-- Measuring one logical output in the A basis reads exactly that coordinate
of the decoded logical error word. -/
theorem logicalABasisObservable_logicalErrorState {q : Nat} (a : OddRow q)
    (logical : Word (ZMod 2) (OddRow q)) :
    logicalABasisObservable a (logicalErrorState logical) =
      if logical a = 0 then logicalErrorState logical
      else -logicalErrorState logical := by
  rw [logicalErrorState, ← allSiteT_logicalPlusState q]
  rw [logicalABasisObservable, UnitaryTransport.conjOperator_apply]
  have hinv :
      (allSiteT (Index := OddRow q)).toLinearEquiv.symm
          (toQubitOperator (cssZCheck logical)
            ((allSiteT (Index := OddRow q))
              (BinaryRowFamily.logicalPlusState (OddRow q)))) =
        toQubitOperator (cssZCheck logical)
          (BinaryRowFamily.logicalPlusState (OddRow q)) := by
    apply (allSiteT (Index := OddRow q)).toLinearEquiv.injective
    rw [LinearEquiv.apply_symm_apply]
    exact (allSiteT_commutes_logicalZ logical
      (BinaryRowFamily.logicalPlusState (OddRow q))).symm
  rw [hinv]
  have hrelation := LinearMap.congr_fun
    (localX_logicalZ_relation a logical)
    (BinaryRowFamily.logicalPlusState (OddRow q))
  simp only [Module.End.mul_apply] at hrelation
  by_cases hbit : logical a = 0
  · simp only [if_pos hbit] at hrelation ⊢
    rw [hrelation, Module.End.mul_apply, localX_logicalPlusState]
    exact allSiteT_commutes_logicalZ logical
      (BinaryRowFamily.logicalPlusState (OddRow q))
  · simp only [if_neg hbit] at hrelation ⊢
    rw [hrelation, LinearMap.neg_apply, Module.End.mul_apply, map_neg,
      localX_logicalPlusState,
      allSiteT_commutes_logicalZ]

/-- The negative A-basis projector selects exactly the logical error words
whose selected coordinate is one. -/
@[simp] theorem logicalABasisProjector_negative_logicalErrorState {q : Nat}
    (a : OddRow q) (logical : Word (ZMod 2) (OddRow q)) :
    logicalABasisProjector a .negative (logicalErrorState logical) =
      if logical a = 0 then 0 else logicalErrorState logical := by
  by_cases hbit : logical a = 0
  · rw [if_pos hbit]
    simp only [logicalABasisProjector, StabilizerOutcome.sign,
      LinearMap.smul_apply, LinearMap.add_apply, Module.End.one_apply]
    rw [logicalABasisObservable_logicalErrorState, if_pos hbit]
    module
  · rw [if_neg hbit]
    simp only [logicalABasisProjector, StabilizerOutcome.sign,
      LinearMap.smul_apply, LinearMap.add_apply, Module.End.one_apply]
    rw [logicalABasisObservable_logicalErrorState, if_neg hbit]
    module

/-- The normalized pure logical output labelled by a decoded error word. -/
noncomputable def logicalErrorDensity {q : Nat}
    (logical : Word (ZMod 2) (OddRow q)) :
    DensityOperator (LogicalRegister q) :=
  DensityOperator.pureDensity (logicalErrorState logical)
    (logicalErrorState_normSq logical)

@[simp] theorem logicalErrorDensity_toOperator {q : Nat}
    (logical : Word (ZMod 2) (OddRow q)) :
    (logicalErrorDensity logical).toOperator =
      (InnerProductSpace.rankOne Complex
        (logicalErrorState logical) (logicalErrorState logical)).toLinearMap := by
  rw [logicalErrorDensity, DensityOperator.pureDensity_toOperator]

theorem logicalErrorDensity_zero_eq_bh12IdealOutput (q : Nat) :
    logicalErrorDensity (0 : Word (ZMod 2) (OddRow q)) =
      bh12IdealOutput q := by
  apply DensityOperator.ext_toOperator
  rw [logicalErrorDensity_toOperator, logicalErrorState_zero,
    bh12IdealOutput, DensityOperator.pureDensity_toOperator]

/-- The actual decoder maps every accepted physical pure branch to the pure
logical density labelled by its derived odd-row error word. -/
theorem decoderChannel_errorBranchDensity_of_accepts {q : Nat}
    (error : PhysicalError q) (haccept : Accepts error) :
    decoderChannel q (errorBranchDensity error).toOperator =
      (logicalErrorDensity (logicalErrorWord error)).toOperator := by
  rw [errorBranchDensity, DensityOperator.pureDensity_toOperator,
    errorBranchState_eq_ambientEncodingIsometry error haccept,
    decoderChannel_rankOne_encoded, logicalErrorDensity_toOperator]

/-- At positive success mass, the supplied-resource run's accepted output is
the normalized mixture of the genuinely decoded logical error branches. -/
theorem resourceDecodedRun_acceptedOutput_toOperator_errorWordSum (q : Nat)
    (p : ErrorParameter) (hsuccess : 0 < rawSuccessMass q p) :
    (resourceDecodedRun q (noisyResources q p)).acceptedOutput.toOperator =
      ((rawSuccessMass q p : Complex)⁻¹) •
        ∑ error : PhysicalError q,
          if Accepts error then
            (errorWordProbability p error : Complex) •
              (logicalErrorDensity (logicalErrorWord error)).toOperator
          else 0 := by
  have hendpoint : 0 < endpointWeight q p .accepted := by
    rw [endpointWeight_accepted_eq_rawSuccessMass]
    exact hsuccess
  have hresource : 0 < resourceEndpointWeight q
      (noisyResources q p) .accepted := by
    rw [resourceAcceptedWeight_noisyResources_eq_rawSuccessMass]
    exact hsuccess
  rw [resourceDecodedRun_acceptedOutput q (noisyResources q p) hresource,
    resourceAcceptedOutput_noisyResources q p hendpoint]
  simp only [QuantumChannel.mapDensity_toOperator,
    endpointConditional_toOperator]
  rw [endpointWeight_accepted_eq_rawSuccessMass,
    rawAcceptedEndpoint_eq_errorWordSum, map_smul, map_sum]
  apply congrArg (((rawSuccessMass q p : Complex)⁻¹) • ·)
  apply Finset.sum_congr rfl
  intro error _herror
  by_cases haccept : Accepts error
  · simp only [haccept, if_true, map_smul]
    rw [decoderChannel_errorBranchDensity_of_accepts error haccept]
  · simp [haccept]

private theorem logicalABasis_sandwich_rankOne {q : Nat}
    (a : OddRow q) (outcome : StabilizerOutcome)
    (psi : LogicalRegister q) :
    (logicalABasisProjector a outcome).comp
        ((InnerProductSpace.rankOne Complex psi psi).toLinearMap.comp
          (LinearMap.adjoint (logicalABasisProjector a outcome))) =
      (InnerProductSpace.rankOne Complex
        (logicalABasisProjector a outcome psi)
        (logicalABasisProjector a outcome psi)).toLinearMap := by
  ext x
  simp [LinearMap.comp_apply, InnerProductSpace.rankOne_apply,
    LinearMap.adjoint_inner_right]

private theorem logicalABasisInstrument_branchOperator_eq_sandwich {q : Nat}
    (a : OddRow q) (outcome : StabilizerOutcome)
    (A : Operator (LogicalRegister q)) :
    (logicalABasisInstrument a).branchOperator outcome A =
      (logicalABasisProjector a outcome).comp
        (A.comp (LinearMap.adjoint (logicalABasisProjector a outcome))) := by
  classical
  rw [FiniteInstrument.branchOperator_apply]
  rw [Fintype.sum_eq_single outcome]
  · simp [logicalABasisInstrument, logicalABasisKrausFamily]
  · intro other hne
    simp [logicalABasisInstrument, hne]

private noncomputable def logicalABasisBranchLinearMap {q : Nat}
    (a : OddRow q) (outcome : StabilizerOutcome) :
    Operator (LogicalRegister q) →ₗ[Complex] Operator (LogicalRegister q) where
  toFun := (logicalABasisInstrument a).branchOperator outcome
  map_add' := by
    intro A B
    classical
    simp only [FiniteInstrument.branchOperator_apply]
    rw [← Finset.sum_add_distrib]
    apply Finset.sum_congr rfl
    intro index _hindex
    by_cases hobserve : (logicalABasisInstrument a).observe index = outcome
    · simp only [hobserve, if_true]
      apply LinearMap.ext
      intro psi
      simp [LinearMap.comp_apply, map_add]
    · simp [hobserve]
  map_smul' := by
    intro scalar A
    classical
    simp only [FiniteInstrument.branchOperator_apply]
    rw [Finset.smul_sum]
    apply Finset.sum_congr rfl
    intro index _hindex
    by_cases hobserve : (logicalABasisInstrument a).observe index = outcome
    · simp only [hobserve, if_true]
      apply LinearMap.ext
      intro psi
      simp [LinearMap.comp_apply]
    · simp [hobserve]

theorem logicalABasisInstrument_branch_negative_logicalErrorDensity {q : Nat}
    (a : OddRow q) (logical : Word (ZMod 2) (OddRow q)) :
    (logicalABasisInstrument a).branchOperator .negative
        (logicalErrorDensity logical).toOperator =
      if logical a = 0 then 0 else (logicalErrorDensity logical).toOperator := by
  rw [logicalABasisInstrument_branchOperator_eq_sandwich,
    logicalErrorDensity_toOperator, logicalABasis_sandwich_rankOne]
  by_cases hbit : logical a = 0
  · rw [if_pos hbit,
      logicalABasisProjector_negative_logicalErrorState]
    simp only [hbit, if_pos]
    apply LinearMap.ext
    intro psi
    change inner Complex (0 : LogicalRegister q) psi •
        (0 : LogicalRegister q) = 0
    exact smul_zero _
  · rw [if_neg hbit,
      logicalABasisProjector_negative_logicalErrorState]
    simp [hbit]

private theorem trace_logicalABasisInstrument_branch_negative_logicalErrorDensity
    {q : Nat} (a : OddRow q)
    (logical : Word (ZMod 2) (OddRow q)) :
    LinearMap.trace Complex (LogicalRegister q)
        ((logicalABasisInstrument a).branchOperator .negative
          (logicalErrorDensity logical).toOperator) =
      if logical a = 0 then 0 else 1 := by
  rw [logicalABasisInstrument_branch_negative_logicalErrorDensity]
  by_cases hbit : logical a = 0
  · rw [if_pos hbit, if_pos hbit]
    norm_num
  · rw [if_neg hbit, if_neg hbit,
      (logicalErrorDensity logical).trace_one]

private theorem trace_logicalABasisBranchLinearMap_negative_logicalErrorDensity
    {q : Nat} (a : OddRow q)
    (logical : Word (ZMod 2) (OddRow q)) :
    LinearMap.trace Complex (LogicalRegister q)
        (logicalABasisBranchLinearMap a .negative
          (logicalErrorDensity logical).toOperator) =
      if logical a = 0 then 0 else 1 :=
  trace_logicalABasisInstrument_branch_negative_logicalErrorDensity a logical

/-- Actual negative-A Born weight of output coordinate `a` in a supplied
logical density operator. -/
noncomputable def logicalABasisNegativeWeight {q : Nat} (a : OddRow q)
    (rho : DensityOperator (LogicalRegister q)) : ℝ :=
  (logicalABasisInstrument a).bornWeight .negative rho

theorem logicalABasisNegativeWeight_nonneg {q : Nat} (a : OddRow q)
    (rho : DensityOperator (LogicalRegister q)) :
    0 ≤ logicalABasisNegativeWeight a rho :=
  (logicalABasisInstrument a).bornWeight_nonneg .negative rho

theorem logicalABasisNegativeWeight_logicalErrorDensity {q : Nat}
    (a : OddRow q) (logical : Word (ZMod 2) (OddRow q)) :
    logicalABasisNegativeWeight a (logicalErrorDensity logical) =
      if logical a = 0 then 0 else 1 := by
  rw [logicalABasisNegativeWeight, FiniteInstrument.bornWeight,
    logicalABasisInstrument_branch_negative_logicalErrorDensity]
  by_cases hbit : logical a = 0
  · rw [if_pos hbit, if_pos hbit]
    norm_num
  · rw [if_neg hbit, if_neg hbit,
      (logicalErrorDensity logical).trace_one]
    norm_num

theorem logicalABasisNegativeWeight_bh12IdealOutput {q : Nat}
    (a : OddRow q) :
    logicalABasisNegativeWeight a (bh12IdealOutput q) = 0 := by
  rw [← logicalErrorDensity_zero_eq_bh12IdealOutput q,
    logicalABasisNegativeWeight_logicalErrorDensity]
  simp

/-- The negative-A weight measured on the actual successful decoded run is
the normalized physical accepted mass whose derived logical bit is one. -/
theorem logicalABasisNegativeWeight_resourceDecodedRun_acceptedOutput
    (q : Nat) (p : ErrorParameter) (hsuccess : 0 < rawSuccessMass q p)
    (a : OddRow q) :
    logicalABasisNegativeWeight a
        (resourceDecodedRun q (noisyResources q p)).acceptedOutput =
      decodedMarginalError q p hsuccess a := by
  rw [logicalABasisNegativeWeight, FiniteInstrument.bornWeight,
    resourceDecodedRun_acceptedOutput_toOperator_errorWordSum q p hsuccess]
  change Complex.re (LinearMap.trace Complex (LogicalRegister q)
    (logicalABasisBranchLinearMap a .negative
      (((rawSuccessMass q p : Complex)⁻¹) •
        ∑ error : PhysicalError q,
          if Accepts error then
            (errorWordProbability p error : Complex) •
              (logicalErrorDensity (logicalErrorWord error)).toOperator
          else 0))) = _
  simp only [map_smul, map_sum, apply_ite, map_zero]
  simp_rw [trace_logicalABasisBranchLinearMap_negative_logicalErrorDensity]
  have hsum :
      (∑ error : PhysicalError q,
        if Accepts error then
          (errorWordProbability p error : Complex) •
            (if logicalErrorWord error a = 0 then 0 else 1)
        else 0) =
      ((∑ error : PhysicalError q,
        if Accepts error ∧ logicalErrorWord error a ≠ 0 then
          errorWordProbability p error else 0 : ℝ) : Complex) := by
    push_cast
    apply Finset.sum_congr rfl
    intro error _herror
    by_cases haccept : Accepts error
    · by_cases hbit : logicalErrorWord error a = 0 <;>
        simp [haccept, hbit]
    · simp [haccept]
  rw [hsum]
  simp only [decodedMarginalError, dif_pos hsuccess]
  rw [rawMarginalErrorWeight_eq_errorWordSum]
  rw [smul_eq_mul, ← Complex.ofReal_inv, ← Complex.ofReal_mul,
    Complex.ofReal_re]
  rw [div_eq_mul_inv]
  ring

/-- State-dependent single-output A-basis error: the absolute difference of
the negative-outcome probabilities of the actual and reference densities. -/
noncomputable def bh12ABasisOutputError {q : Nat} (a : OddRow q)
    (rho sigma : DensityOperator (LogicalRegister q)) : ℝ :=
  |logicalABasisNegativeWeight a rho - logicalABasisNegativeWeight a sigma|

theorem bh12ABasisOutputError_nonneg {q : Nat} (a : OddRow q)
    (rho sigma : DensityOperator (LogicalRegister q)) :
    0 ≤ bh12ABasisOutputError a rho sigma :=
  abs_nonneg _

/-- The state-dependent A-basis error of the actual accepted density against
the ideal logical magic state is exactly the source marginal enumerator. -/
theorem bh12ABasisOutputError_acceptedOutput (q : Nat)
    (p : ErrorParameter) (hsuccess : 0 < rawSuccessMass q p)
    (a : OddRow q) :
    bh12ABasisOutputError a
        (resourceDecodedRun q (noisyResources q p)).acceptedOutput
        (bh12IdealOutput q) =
      decodedMarginalError q p hsuccess a := by
  rw [bh12ABasisOutputError,
    logicalABasisNegativeWeight_resourceDecodedRun_acceptedOutput
      q p hsuccess a,
    logicalABasisNegativeWeight_bh12IdealOutput]
  simp only [sub_zero,
    abs_of_nonneg (decodedMarginalError_nonneg q p hsuccess a)]

/-- The concrete BH12 postselected protocol package over the existing
parameter-free resource consumer, syndrome operation, and CPTP decoder. -/
noncomputable def bh12MagicStateDistillationProtocol (q : Nat)
    (p : ErrorParameter) (a : OddRow q) (_hsuccess : 0 < rawSuccessMass q p) :
    MagicStateDistillationProtocol Qubit.QubitSpace
      (PhysicalRegister q) (LogicalRegister q) where
  run := resourceDecodedRun q (noisyResources q p)
  inputErrorModel := .independent (bh12IndependentInputModel q p)
  inputPermitted := bh12IndependentInputModel_permits q p
  behavior := .postselected
  idealOutput := bh12IdealOutput q
  outputError := bh12ABasisOutputError a
  outputError_nonneg := bh12ABasisOutputError_nonneg a

/-- The packaged protocol exposes the already-derived accepted marginal,
rather than a target-shaped success or error field. -/
theorem bh12MagicStateDistillationProtocol_successfulOutputError (q : Nat)
    (p : ErrorParameter) (a : OddRow q) (hsuccess : 0 < rawSuccessMass q p) :
    (bh12MagicStateDistillationProtocol q p a hsuccess).successfulOutputError =
      decodedMarginalError q p hsuccess a := by
  exact bh12ABasisOutputError_acceptedOutput q p hsuccess a

/-- The #457 wrapper inherits the physical BH12 quadratic marginal theorem;
the coefficient is proved from the actual #754 enumerators above. -/
theorem bh12MagicStateDistillationProtocol_quadratic (q : Nat)
    (p : ErrorParameter) (a : OddRow q) (hhalf : p.rate ≤ 1 / 2) :
    (bh12MagicStateDistillationProtocol q p a
      (rawSuccessMass_pos_of_rate_le_half q p hhalf)).successfulOutputError ≤
      8 * ((1 + 6 * q : Nat) : ℝ) * p.rate ^ 2 := by
  rw [bh12MagicStateDistillationProtocol_successfulOutputError]
  exact decodedMarginalError_le_evenFamily_quadratic q p a hhalf

