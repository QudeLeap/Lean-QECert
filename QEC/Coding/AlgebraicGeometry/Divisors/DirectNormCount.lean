import Mathlib.RingTheory.Ideal.Norm.RelNorm
import Mathlib.NumberTheory.RamificationInertia.Basic
import Mathlib.RingTheory.RamificationInertia.Inertia
import QEC.Coding.AlgebraicGeometry.Places.AffinePlaceDegree

namespace QEC.Coding.AlgebraicGeometry.DirectNormCount

open scoped Polynomial RatFunc nonZeroDivisors

variable (k F : Type*)
variable [Field k] [Finite k] [Field F]
variable [Algebra k[X] F] [Algebra k⟮X⟯ F]
variable [IsScalarTower k[X] k⟮X⟯ F]
variable [_root_.FunctionField k F]
variable [Algebra.IsSeparable k⟮X⟯ F]

abbrev directRingOfIntegers : Type _ := _root_.FunctionField.ringOfIntegers k F

noncomputable abbrev directBasePrime (P : AffinePlace.carrier k F) : Ideal k[X] :=
  P.asIdeal.under k[X]

local instance : Module.IsTorsionFree k[X] (directRingOfIntegers k F) :=
  Module.isTorsionFree_iff_algebraMap_injective.mpr
    (_root_.FunctionField.ringOfIntegers.algebraMap_injective k F)

/-- The relative norm of an actual principal ideal in the direct integral
closure is the principal ideal generated by its integral norm. -/
theorem direct_relNorm_spanSingleton_eq_intNorm (x : directRingOfIntegers k F) :
    Ideal.relNorm k[X] (Ideal.span ({x} : Set (directRingOfIntegers k F))) =
      Ideal.span ({Algebra.intNorm k[X] (directRingOfIntegers k F) x} : Set k[X]) := by
  letI : Module.Finite k[X] (directRingOfIntegers k F) :=
    AffinePlace.finite_ringOfIntegers k F
  letI : Module.IsTorsionFree k[X] F :=
    Module.IsTorsionFree.trans_faithfulSMul k[X] k⟮X⟯ F
  letI : Algebra.IsIntegral k[X] (directRingOfIntegers k F) :=
    IsIntegralClosure.isIntegral_algebra k[X] F
  simpa only using
    (Ideal.relNorm_singleton (R := k[X]) (S := directRingOfIntegers k F) x)

/-- The integral norm in the preceding principal ideal represents the actual
field norm after the fraction-ring embedding. -/
theorem direct_intNorm_represents_fieldNorm (x : directRingOfIntegers k F) :
    algebraMap k[X] k⟮X⟯ (Algebra.intNorm k[X] (directRingOfIntegers k F) x) =
      Algebra.norm k⟮X⟯ (algebraMap (directRingOfIntegers k F) F x) := by
  letI : Module.Finite k[X] (directRingOfIntegers k F) :=
    AffinePlace.finite_ringOfIntegers k F
  letI : Module.IsTorsionFree k[X] F :=
    Module.IsTorsionFree.trans_faithfulSMul k[X] k⟮X⟯ F
  letI : Algebra.IsIntegral k[X] (directRingOfIntegers k F) :=
    IsIntegralClosure.isIntegral_algebra k[X] F
  exact Algebra.algebraMap_intNorm x

/-- The Mathlib inertia degree is the degree of the actual residue-field
extension for the contracted direct base prime. -/
theorem direct_inertia_eq_actual_residue_extension_degree
    (P : AffinePlace.carrier k F) :
    (directBasePrime k F P).inertiaDeg' P.asIdeal =
      P.asIdeal.inertiaDeg k[X] := by
  letI : Module.Finite k[X] (directRingOfIntegers k F) :=
    AffinePlace.finite_ringOfIntegers k F
  letI : Module.IsTorsionFree k[X] F :=
    Module.IsTorsionFree.trans_faithfulSMul k[X] k⟮X⟯ F
  letI : Algebra.IsIntegral k[X] (directRingOfIntegers k F) :=
    IsIntegralClosure.isIntegral_algebra k[X] F
  letI : P.asIdeal.LiesOver (directBasePrime k F P) := ⟨rfl⟩
  exact Ideal.inertiaDeg'_eq_inertiaDeg (directBasePrime k F P) P.asIdeal

/-- The direct integral closure has the genuine finite ramification/inertia
identity at every nonzero base prime.  Both the upper-place container and its
summands are constructed by Mathlib from the actual mapped ideal. -/
theorem direct_sum_ramification_inertia
    {p : Ideal k[X]} [p.IsMaximal] (hp : p ≠ ⊥) :
    ∑ P ∈ IsDedekindDomain.primesOverFinset p (directRingOfIntegers k F),
      p.ramificationIdx' P * p.inertiaDeg' P = Module.finrank k⟮X⟯ F := by
  letI : Module.Finite k[X] (directRingOfIntegers k F) :=
    AffinePlace.finite_ringOfIntegers k F
  letI : Module.IsTorsionFree k[X] F :=
    Module.IsTorsionFree.trans_faithfulSMul k[X] k⟮X⟯ F
  letI : Algebra.IsIntegral k[X] (directRingOfIntegers k F) :=
    IsIntegralClosure.isIntegral_algebra k[X] F
  exact Ideal.sum_ramification_inertia (directRingOfIntegers k F) k⟮X⟯ F hp

end QEC.Coding.AlgebraicGeometry.DirectNormCount

namespace QEC.Coding.AlgebraicGeometry.AffinePlace

open scoped Polynomial RatFunc nonZeroDivisors
open Submodule.IsPrincipal

variable (k F : Type*)
variable [Field k] [Finite k] [Field F]
variable [Algebra k[X] F] [Algebra k⟮X⟯ F]
variable [IsScalarTower k[X] k⟮X⟯ F]
variable [_root_.FunctionField k F]
variable [Algebra.IsSeparable k⟮X⟯ F]

/-- The degree of an affine place over a finite constant field factors as the
degree of its contracted polynomial prime times the inertia degree upstairs. -/
theorem residueDegree_eq_generator_natDegree_mul_inertia
    (P : carrier k F) :
    residueDegree k F P =
      (generator (basePrime k F P)).natDegree *
        (basePrime k F P).inertiaDeg' P.asIdeal := by
  classical
  let B : Type _ := _root_.FunctionField.ringOfIntegers k F
  let p : Ideal k[X] := basePrime k F P
  letI : Module.Finite k[X] B := finite_ringOfIntegers k F
  letI : Module.IsTorsionFree k[X] F :=
    Module.IsTorsionFree.trans_faithfulSMul k[X] k⟮X⟯ F
  letI : Algebra.IsIntegral k[X] B := IsIntegralClosure.isIntegral_algebra k[X] F
  letI : P.asIdeal.LiesOver p := ⟨rfl⟩
  letI : P.asIdeal.IsMaximal := P.isPrime.isMaximal P.ne_bot
  letI : p.IsMaximal := Ideal.IsMaximal.under k[X] P.asIdeal
  letI : Field (k[X] ⧸ p) := Ideal.Quotient.field p
  letI : Field (B ⧸ P.asIdeal) := Ideal.Quotient.field P.asIdeal
  letI : Algebra (k[X] ⧸ p) (B ⧸ P.asIdeal) :=
    Ideal.Quotient.algebraQuotientOfLEComap (Ideal.over_def P.asIdeal p).ge
  letI : Algebra (k[X] ⧸ p) (residueField k F P) :=
    ((algebraMap (B ⧸ P.asIdeal) (residueField k F P)).comp
      (algebraMap (k[X] ⧸ p) (B ⧸ P.asIdeal))).toAlgebra
  letI : IsScalarTower (k[X] ⧸ p) (B ⧸ P.asIdeal) (residueField k F P) :=
    IsScalarTower.of_algebraMap_eq fun _ => rfl
  letI : Algebra k (residueField k F P) := residueAlgebra k F P
  letI : IsScalarTower k (k[X] ⧸ p) (residueField k F P) :=
    IsScalarTower.of_algebraMap_eq
      (R := k) (S := k[X] ⧸ p) (A := residueField k F P) fun a => by
      change constantsToResidue k F P a = _
      rw [constantsToResidue_apply]
      change algebraMap B (residueField k F P)
          (algebraMap k[X] B (Polynomial.C a)) =
        algebraMap (B ⧸ P.asIdeal) (residueField k F P)
          (Ideal.Quotient.mk P.asIdeal (algebraMap k[X] B (Polynomial.C a)))
      rw [Ideal.algebraMap_quotient_residueField_mk]
  unfold residueDegree
  letI : FiniteDimensional k (residueField k F P) :=
    residueField_finiteDimensional k F P
  rw [← Module.finrank_mul_finrank k (k[X] ⧸ p) (residueField k F P)]
  congr 1
  · rw [← Ideal.span_singleton_generator p]
    exact finrank_quotient_span_eq_natDegree
  · rw [← Module.finrank_mul_finrank (k[X] ⧸ p) (B ⧸ P.asIdeal)
      (residueField k F P),
      Module.finrank_of_bijective_algebraMap
        (Ideal.bijective_algebraMap_quotient_residueField P.asIdeal),
      mul_one,
      ← Ideal.inertiaDeg_algebraMap p P.asIdeal]

end QEC.Coding.AlgebraicGeometry.AffinePlace
