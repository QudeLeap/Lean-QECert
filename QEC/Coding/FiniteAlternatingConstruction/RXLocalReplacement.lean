private theorem rxOriginalBoundaryZRectangleVerticalQ
    (P : TannerSquarePresentation) (S : OddScale) (x : P.X) (copy : Two)
    (z : P.Z)
    (member : xStarBoundaryVertexMember P x (Vertex.z z) = true)
