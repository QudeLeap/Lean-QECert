import QEC.Coding.ExpanderCodes.LiftedProduct
import QEC.Coding.Stabilizer.FiniteFieldCSSPresentation

/-!
# Tanner lifted-product construction over a Cayley double cover

This module turns a generator-labelled double-cover Tanner boundary and two
local matrices into the concrete group-algebra data consumed by the existing
lifted-product chain complex. The two vertex sides account for the factors of
two in the endpoint cell counts, while dualizing the second Tanner boundary
produces the source's `w²` face block and `4rr'` vertex block.

The generic lifted-product boundary expands its first factor with the right
regular matrix. For the paper's *left* derived graph with voltage `s`, pass
`s⁻¹` as the Lean label and invert every group coordinate. The coefficient
bridge below checks the resulting Tanner edge endpoint `g ↦ s * g`.
-/

namespace QEC.Coding.TannerLiftedProduct

open QEC.Coding.LiftedProduct

universe u v

variable {F : Type u} {G W R R' : Type v}
variable [Field F] [Fintype F]
variable [Group G] [Fintype G] [DecidableEq G]
variable [Fintype W] [DecidableEq W]
variable [Fintype R] [DecidableEq R]
variable [Fintype R'] [DecidableEq R']

/-- Voltage used by the generic right-regular boundary on one side of the
double-cover base graph. To represent a source left-lift voltage, invert it
before passing it as `label`. -/
def doubleCoverVoltage (label : W → G) (side : Fin 2) (j : W) : G :=
  if side = 0 then 1 else label j

/-- The group-algebra Tanner boundary of the bipartite Cayley double cover.
The first vertex side sees the identity lift, and the second sees the supplied
right-regular label. A source left-lift voltage `s` is supplied as `s⁻¹`. -/
noncomputable def doubleCoverTannerMatrix
    (label : W → G) (h : Matrix R W F) :
    Matrix (Fin 2 × R) W (MonoidAlgebra F G) :=
  fun ir j =>
    MonoidAlgebra.single (doubleCoverVoltage label ir.1 j) (h ir.2 j)

omit [Fintype F] [Fintype G] [DecidableEq G] [Fintype W] [DecidableEq W]
    [Fintype R] [DecidableEq R] in
@[simp]
theorem doubleCoverTannerMatrix_zeroSide_apply
    (label : W → G) (h : Matrix R W F) (r : R) (j : W) :
    doubleCoverTannerMatrix label h (0, r) j =
      MonoidAlgebra.single 1 (h r j) := by
  simp [doubleCoverTannerMatrix, doubleCoverVoltage]

omit [Fintype F] [Fintype G] [DecidableEq G] [Fintype W] [DecidableEq W]
    [Fintype R] [DecidableEq R] in
@[simp]
theorem doubleCoverTannerMatrix_oneSide_apply
    (label : W → G) (h : Matrix R W F) (r : R) (j : W) :
    doubleCoverTannerMatrix label h (1, r) j =
      MonoidAlgebra.single (label j) (h r j) := by
  simp [doubleCoverTannerMatrix, doubleCoverVoltage]

omit [Fintype F] [Fintype G] [Fintype W] [DecidableEq W]
    [Fintype R] [DecidableEq R] in
/-- A Tanner entry has a nonzero coefficient at exactly its selected voltage,
provided the corresponding local-matrix coefficient is nonzero. -/
theorem doubleCoverTannerMatrix_coeff_ne_zero_iff
    (label : W → G) (h : Matrix R W F)
    (ir : Fin 2 × R) (j : W) (g : G) :
  (doubleCoverTannerMatrix label h ir j).coeff g ≠ 0 ↔
      g = doubleCoverVoltage label ir.1 j ∧ h ir.2 j ≠ 0 := by
  classical
  by_cases hg : g = doubleCoverVoltage label ir.1 j <;>
    simp [doubleCoverTannerMatrix, hg]

/-- The source complex `T(Γ;h) ⊗_G T(Γ;g')*`: the first factor is the
double-cover Tanner boundary of `h`, and the second group-algebra matrix is
the dual of the Tanner boundary generated by `g'`. -/
noncomputable def data (label : W → G) (h : Matrix R W F) (g' : Matrix R' W F) :
    LiftedProduct.Data F G (Fin 2 × R) W W (Fin 2 × R') where
  A := doubleCoverTannerMatrix label h
  B := LiftedProduct.starTranspose (doubleCoverTannerMatrix label g')

omit [DecidableEq G] in
/-- Under inversion of every group coordinate, the first boundary of the
generic lifted product realizes the paper's left-derived Tanner edge:
`e_j ⊗ g` has coefficient `h r j` at `v₂ ⊗ (sourceVoltage j * g)`.
The Lean label is the inverse of the source voltage because `boundary1Matrix`
uses the right regular representation for its first factor. -/
theorem sourceLeft_oneSide_boundary1_coeff
    (sourceVoltage : W → G) (h : Matrix R W F) (g' : Matrix R' W F)
    (r : R) (j br : W) (g : G) :
    LiftedProduct.boundary1Matrix
        (data (fun j => (sourceVoltage j)⁻¹) h g')
        ((1, r), br, (sourceVoltage j * g)⁻¹)
        (Sum.inl (j, br, g⁻¹)) = h r j := by
  simp [LiftedProduct.boundary1Matrix, data,
    doubleCoverTannerMatrix_oneSide_apply,
    LiftedProduct.rightRegularMatrix]

omit [DecidableEq G] in
/-- The same coordinate inversion sends the zero-side endpoint to `g`. -/
theorem sourceLeft_zeroSide_boundary1_coeff
    (sourceVoltage : W → G) (h : Matrix R W F) (g' : Matrix R' W F)
    (r : R) (j br : W) (g : G) :
    LiftedProduct.boundary1Matrix
        (data (fun j => (sourceVoltage j)⁻¹) h g')
        ((0, r), br, g⁻¹)
        (Sum.inl (j, br, g⁻¹)) = h r j := by
  simp [LiftedProduct.boundary1Matrix, data,
    doubleCoverTannerMatrix_zeroSide_apply,
    LiftedProduct.rightRegularMatrix]

omit [Field F] [Fintype F] [Group G] [DecidableEq G] [DecidableEq W]
    [DecidableEq R] [DecidableEq R'] in
/-- Exact physical coordinate count of the Tanner lifted product. -/
theorem card_qubitIndex :
    Fintype.card
        (LiftedProduct.QubitIndex (Fin 2 × R) W W (Fin 2 × R') G) =
      Fintype.card G *
        (Fintype.card W * Fintype.card W +
          4 * Fintype.card R * Fintype.card R') := by
  rw [LiftedProduct.card_qubitIndex]
  simp only [Fintype.card_prod, Fintype.card_fin]
  ring

omit [Field F] [Fintype F] [Group G] [DecidableEq G] [DecidableEq W]
    [DecidableEq R] [Fintype R'] [DecidableEq R'] in
/-- Exact degree-zero endpoint cell count. -/
theorem card_c0Index :
    Fintype.card (LiftedProduct.C0Index (Fin 2 × R) W G) =
      2 * Fintype.card R * Fintype.card W * Fintype.card G := by
  simp only [LiftedProduct.C0Index, Fintype.card_prod, Fintype.card_fin]
  ring

omit [Field F] [Fintype F] [Group G] [DecidableEq G] [DecidableEq W]
    [Fintype R] [DecidableEq R] [DecidableEq R'] in
/-- Exact degree-two endpoint cell count. -/
theorem card_c2Index :
    Fintype.card (LiftedProduct.C2Index W (Fin 2 × R') G) =
      2 * Fintype.card R' * Fintype.card W * Fintype.card G := by
  simp only [LiftedProduct.C2Index, Fintype.card_prod, Fintype.card_fin]
  ring

omit [Field F] [Fintype F] [Group G] [DecidableEq G] [DecidableEq W]
    [DecidableEq R] [DecidableEq R'] in
/-- The lifted-product chain complex has the same middle-cell count as the
paper's face-plus-vertex decomposition. -/
theorem chainComplex_middle_card :
    Fintype.card
        (LiftedProduct.QubitIndex (Fin 2 × R) W W (Fin 2 × R') G) =
      Fintype.card G *
        (Fintype.card W ^ 2 + 4 * Fintype.card R * Fintype.card R') := by
  simpa [pow_two] using (card_qubitIndex (G := G) (W := W) (R := R) (R' := R'))

/-- The generic lifted-product rank-nullity estimate specialized to the
double-cover Tanner construction. -/
theorem card_middle_le_finrank_homology_add_endpoints
    (label : W → G) (h : Matrix R W F) (g' : Matrix R' W F) :
    Fintype.card G *
        (Fintype.card W ^ 2 + 4 * Fintype.card R * Fintype.card R') ≤
      Module.finrank F (LiftedProduct.chainComplex (data label h g')).middleHomology +
        2 * Fintype.card R * Fintype.card W * Fintype.card G +
        2 * Fintype.card R' * Fintype.card W * Fintype.card G := by
  have hBound :=
    LiftedProduct.card_qubitIndex_le_finrank_middleHomology_add_endpoints
      (data label h g')
  rw [chainComplex_middle_card (G := G) (W := W) (R := R) (R' := R'),
    card_c0Index (G := G) (W := W) (R := R),
    card_c2Index (G := G) (W := W) (R' := R')] at hBound
  exact hBound

/-- A source-level local row-ratio inequality implies the encoded-rate bound
for every finite voltage group. This is the exact algebraic reduction used in
the terminal PK22 family proof. -/
theorem rate_le_finrank_middleHomology_of_local_ratio
    (label : W → G) (h : Matrix R W F) (g' : Matrix R' W F)
    (rate : ℝ)
    (hRatio :
      2 * ((Fintype.card R : ℝ) + Fintype.card R') * Fintype.card W ≤
        (1 - rate) *
          ((Fintype.card W : ℝ) ^ 2 +
            4 * Fintype.card R * Fintype.card R')) :
    rate * Fintype.card
        (LiftedProduct.QubitIndex (Fin 2 × R) W W (Fin 2 × R') G) ≤
      (Module.finrank F
        (LiftedProduct.chainComplex (data label h g')).middleHomology : ℝ) := by
  apply LiftedProduct.rate_le_finrank_middleHomology_of_endpoint_bound
    (data label h g') rate
  rw [card_c0Index (G := G) (W := W) (R := R),
    card_c2Index (G := G) (W := W) (R' := R'),
    chainComplex_middle_card (G := G) (W := W) (R := R) (R' := R')]
  calc
    ((2 * Fintype.card R * Fintype.card W * Fintype.card G : Nat) : ℝ) +
        ((2 * Fintype.card R' * Fintype.card W * Fintype.card G : Nat) : ℝ) =
      (Fintype.card G : ℝ) *
        (2 * ((Fintype.card R : ℝ) + Fintype.card R') * Fintype.card W) := by
          push_cast
          ring
    _ ≤ (Fintype.card G : ℝ) *
        ((1 - rate) *
          ((Fintype.card W : ℝ) ^ 2 +
            4 * Fintype.card R * Fintype.card R')) :=
      mul_le_mul_of_nonneg_left hRatio (Nat.cast_nonneg _)
    _ = (1 - rate) *
        (Fintype.card G *
          (Fintype.card W ^ 2 + 4 * Fintype.card R * Fintype.card R') : Nat) := by
      push_cast
      ring

/-! ## Uniform locality -/

/-- A group-size-independent cover of one first-boundary check support. -/
noncomputable def boundary1SupportCover
    (label : W → G) (_h : Matrix R W F) (_g' : Matrix R' W F)
    (c0 : LiftedProduct.C0Index (Fin 2 × R) W G) :
    Finset (LiftedProduct.QubitIndex (Fin 2 × R) W W (Fin 2 × R') G) := by
  classical
  rcases c0 with ⟨ar, br, go⟩
  let leftEmbedding : W ↪
      LiftedProduct.QubitIndex (Fin 2 × R) W W (Fin 2 × R') G :=
    ⟨fun ac => Sum.inl
      (ac, br, go * (doubleCoverVoltage label ar.1 ac)⁻¹), by
        intro x y hxy
        simpa using congrArg (fun z => z.1) (Sum.inl.inj hxy)⟩
  let rightEmbedding : (Fin 2 × R') ↪
      LiftedProduct.QubitIndex (Fin 2 × R) W W (Fin 2 × R') G :=
    ⟨fun bc => Sum.inr
      (ar, bc, doubleCoverVoltage label bc.1 br * go), by
        intro x y hxy
        simpa using congrArg (fun z => z.2.1) (Sum.inr.inj hxy)⟩
  exact Finset.univ.map leftEmbedding ∪ Finset.univ.map rightEmbedding

/-- Every nonzero coordinate in a first-boundary row lies in its explicit
group-size-independent cover. -/
theorem boundary1RowSupport_subset_cover
    (label : W → G) (h : Matrix R W F) (g' : Matrix R' W F)
    (c0 : LiftedProduct.C0Index (Fin 2 × R) W G) :
    LiftedProduct.boundary1RowSupport (data label h g') c0 ⊆
      boundary1SupportCover label h g' c0 := by
  classical
  rcases c0 with ⟨ar, br, go⟩
  intro q hq
  cases q with
  | inl q =>
      rcases q with ⟨ac, br', gi⟩
      rw [LiftedProduct.mem_boundary1RowSupport_inl] at hq
      rcases hq with ⟨rfl, hCoeff⟩
      rw [data, doubleCoverTannerMatrix_coeff_ne_zero_iff] at hCoeff
      have hgi : gi = go * (doubleCoverVoltage label ar.1 ac)⁻¹ := by
        calc
          gi = go * (gi⁻¹ * go)⁻¹ := by simp
          _ = go * (doubleCoverVoltage label ar.1 ac)⁻¹ := by rw [hCoeff.1]
      apply Finset.mem_union_left
      apply Finset.mem_map.mpr
      refine ⟨ac, Finset.mem_univ ac, ?_⟩
      subst gi
      rfl
  | inr q =>
      rcases q with ⟨ar', bc, gi⟩
      rw [LiftedProduct.mem_boundary1RowSupport_inr] at hq
      rcases hq with ⟨rfl, hCoeff⟩
      change (LiftedProduct.groupConj
        (doubleCoverTannerMatrix label g' bc br)).coeff (go * gi⁻¹) ≠ 0 at hCoeff
      rw [LiftedProduct.groupConj_apply,
        doubleCoverTannerMatrix_coeff_ne_zero_iff] at hCoeff
      have hgi : gi = doubleCoverVoltage label bc.1 br * go := by
        calc
          gi = (gi * go⁻¹) * go := by simp
          _ = doubleCoverVoltage label bc.1 br * go := by
            rw [show gi * go⁻¹ = doubleCoverVoltage label bc.1 br by
              simpa only [mul_inv_rev, inv_inv] using hCoeff.1]
      apply Finset.mem_union_right
      apply Finset.mem_map.mpr
      refine ⟨bc, Finset.mem_univ bc, ?_⟩
      subst gi
      rfl

/-- First-boundary checks have weight at most `w + 2r'`, independently of
the voltage-group size. -/
theorem card_boundary1RowSupport_le
    (label : W → G) (h : Matrix R W F) (g' : Matrix R' W F)
    (c0 : LiftedProduct.C0Index (Fin 2 × R) W G) :
    (LiftedProduct.boundary1RowSupport (data label h g') c0).card ≤
      Fintype.card W + 2 * Fintype.card R' := by
  apply (Finset.card_le_card (boundary1RowSupport_subset_cover label h g' c0)).trans
  rcases c0 with ⟨ar, br, go⟩
  change (boundary1SupportCover label h g' (ar, br, go)).card ≤ _
  unfold boundary1SupportCover
  calc
    (Finset.univ.map _ ∪ Finset.univ.map _).card ≤
        (Finset.univ.map _).card + (Finset.univ.map _).card :=
      Finset.card_union_le _ _
    _ = Fintype.card W + 2 * Fintype.card R' := by simp

/-- A group-size-independent cover of one second-boundary check support. -/
noncomputable def boundary2SupportCover
    (label : W → G) (_h : Matrix R W F) (_g' : Matrix R' W F)
    (c2 : LiftedProduct.C2Index W (Fin 2 × R') G) :
    Finset (LiftedProduct.QubitIndex (Fin 2 × R) W W (Fin 2 × R') G) := by
  classical
  rcases c2 with ⟨ac, bc, gi⟩
  let leftEmbedding : W ↪
      LiftedProduct.QubitIndex (Fin 2 × R) W W (Fin 2 × R') G :=
    ⟨fun br => Sum.inl
      (ac, br, (doubleCoverVoltage label bc.1 br)⁻¹ * gi), by
        intro x y hxy
        simpa using congrArg (fun z => z.2.1) (Sum.inl.inj hxy)⟩
  let rightEmbedding : (Fin 2 × R) ↪
      LiftedProduct.QubitIndex (Fin 2 × R) W W (Fin 2 × R') G :=
    ⟨fun ar => Sum.inr
      (ar, bc, gi * doubleCoverVoltage label ar.1 ac), by
        intro x y hxy
        simpa using congrArg (fun z => z.1) (Sum.inr.inj hxy)⟩
  exact Finset.univ.map leftEmbedding ∪ Finset.univ.map rightEmbedding

/-- Every nonzero coordinate in a second-boundary row lies in its explicit
group-size-independent cover. -/
theorem boundary2RowSupport_subset_cover
    (label : W → G) (h : Matrix R W F) (g' : Matrix R' W F)
    (c2 : LiftedProduct.C2Index W (Fin 2 × R') G) :
    LiftedProduct.boundary2RowSupport (data label h g') c2 ⊆
      boundary2SupportCover label h g' c2 := by
  classical
  rcases c2 with ⟨ac, bc, gi⟩
  intro q hq
  cases q with
  | inl q =>
      rcases q with ⟨ac', br, go⟩
      rw [LiftedProduct.mem_boundary2RowSupport_inl] at hq
      rcases hq with ⟨rfl, hCoeff⟩
      change (LiftedProduct.groupConj
        (doubleCoverTannerMatrix label g' bc br)).coeff (go * gi⁻¹) ≠ 0 at hCoeff
      rw [LiftedProduct.groupConj_apply,
        doubleCoverTannerMatrix_coeff_ne_zero_iff] at hCoeff
      have hgo : go = (doubleCoverVoltage label bc.1 br)⁻¹ * gi := by
        calc
          go = (gi * go⁻¹)⁻¹ * gi := by simp
          _ = (doubleCoverVoltage label bc.1 br)⁻¹ * gi := by
            rw [show gi * go⁻¹ = doubleCoverVoltage label bc.1 br by
              simpa only [mul_inv_rev, inv_inv] using hCoeff.1]
      apply Finset.mem_union_left
      apply Finset.mem_map.mpr
      refine ⟨br, Finset.mem_univ br, ?_⟩
      subst go
      rfl
  | inr q =>
      rcases q with ⟨ar, bc', go⟩
      rw [LiftedProduct.mem_boundary2RowSupport_inr] at hq
      rcases hq with ⟨rfl, hCoeff⟩
      rw [data, doubleCoverTannerMatrix_coeff_ne_zero_iff] at hCoeff
      have hgo : go = gi * doubleCoverVoltage label ar.1 ac := by
        calc
          go = gi * (gi⁻¹ * go) := by simp
          _ = gi * doubleCoverVoltage label ar.1 ac := by rw [hCoeff.1]
      apply Finset.mem_union_right
      apply Finset.mem_map.mpr
      refine ⟨ar, Finset.mem_univ ar, ?_⟩
      subst go
      rfl

/-- Second-boundary checks have weight at most `w + 2r`, independently of
the voltage-group size. -/
theorem card_boundary2RowSupport_le
    (label : W → G) (h : Matrix R W F) (g' : Matrix R' W F)
    (c2 : LiftedProduct.C2Index W (Fin 2 × R') G) :
    (LiftedProduct.boundary2RowSupport (data label h g') c2).card ≤
      Fintype.card W + 2 * Fintype.card R := by
  apply (Finset.card_le_card (boundary2RowSupport_subset_cover label h g' c2)).trans
  rcases c2 with ⟨ac, bc, gi⟩
  change (boundary2SupportCover label h g' (ac, bc, gi)).card ≤ _
  unfold boundary2SupportCover
  calc
    (Finset.univ.map _ ∪ Finset.univ.map _).card ≤
        (Finset.univ.map _).card + (Finset.univ.map _).card :=
      Finset.card_union_le _ _
    _ = Fintype.card W + 2 * Fintype.card R := by simp

/-- A group-size-independent cover of all checks incident to one qubit. -/
noncomputable def variableSupportCover
    (label : W → G) (_h : Matrix R W F) (_g' : Matrix R' W F)
    (q : LiftedProduct.QubitIndex (Fin 2 × R) W W (Fin 2 × R') G) :
    Finset (Sum
      (LiftedProduct.C0Index (Fin 2 × R) W G)
      (LiftedProduct.C2Index W (Fin 2 × R') G)) := by
  classical
  cases q with
  | inl q =>
      rcases q with ⟨ac, br, gi⟩
      let lowerEmbedding : (Fin 2 × R) ↪ Sum
          (LiftedProduct.C0Index (Fin 2 × R) W G)
          (LiftedProduct.C2Index W (Fin 2 × R') G) :=
        ⟨fun ar => Sum.inl
          (ar, br, gi * doubleCoverVoltage label ar.1 ac), by
            intro x y hxy
            simpa using congrArg (fun z => z.1) (Sum.inl.inj hxy)⟩
      let upperEmbedding : (Fin 2 × R') ↪ Sum
          (LiftedProduct.C0Index (Fin 2 × R) W G)
          (LiftedProduct.C2Index W (Fin 2 × R') G) :=
        ⟨fun bc => Sum.inr
          (ac, bc, doubleCoverVoltage label bc.1 br * gi), by
            intro x y hxy
            simpa using congrArg (fun z => z.2.1) (Sum.inr.inj hxy)⟩
      exact Finset.univ.map lowerEmbedding ∪ Finset.univ.map upperEmbedding
  | inr q =>
      rcases q with ⟨ar, bc, gi⟩
      let lowerEmbedding : W ↪ Sum
          (LiftedProduct.C0Index (Fin 2 × R) W G)
          (LiftedProduct.C2Index W (Fin 2 × R') G) :=
        ⟨fun br => Sum.inl
          (ar, br, (doubleCoverVoltage label bc.1 br)⁻¹ * gi), by
            intro x y hxy
            simpa using congrArg (fun z => z.2.1) (Sum.inl.inj hxy)⟩
      let upperEmbedding : W ↪ Sum
          (LiftedProduct.C0Index (Fin 2 × R) W G)
          (LiftedProduct.C2Index W (Fin 2 × R') G) :=
        ⟨fun ac => Sum.inr
          (ac, bc, gi * (doubleCoverVoltage label ar.1 ac)⁻¹), by
            intro x y hxy
            simpa using congrArg (fun z => z.1) (Sum.inr.inj hxy)⟩
      exact Finset.univ.map lowerEmbedding ∪ Finset.univ.map upperEmbedding

/-- Every check incident to a qubit lies in its explicit
group-size-independent cover. -/
theorem variableSupport_subset_cover
    (label : W → G) (h : Matrix R W F) (g' : Matrix R' W F)
    (q : LiftedProduct.QubitIndex (Fin 2 × R) W W (Fin 2 × R') G) :
    (LiftedProduct.boundaryIncidence (data label h g')).variableSupport q ⊆
      variableSupportCover label h g' q := by
  classical
  intro c hc
  rw [QEC.QLDPC.CheckIncidence.mem_variableSupport] at hc
  rw [← QEC.QLDPC.CheckIncidence.mem_checkSupport] at hc
  cases q with
  | inl q =>
      rcases q with ⟨ac, br, gi⟩
      cases c with
      | inl c0 =>
          rcases c0 with ⟨ar, br', go⟩
          rw [LiftedProduct.boundaryIncidence_checkSupport_inl,
            LiftedProduct.mem_boundary1RowSupport_inl] at hc
          rcases hc with ⟨rfl, hCoeff⟩
          rw [data, doubleCoverTannerMatrix_coeff_ne_zero_iff] at hCoeff
          have hgo : go = gi * doubleCoverVoltage label ar.1 ac := by
            calc
              go = gi * (gi⁻¹ * go) := by simp
              _ = gi * doubleCoverVoltage label ar.1 ac := by rw [hCoeff.1]
          apply Finset.mem_union_left
          apply Finset.mem_map.mpr
          refine ⟨ar, Finset.mem_univ ar, ?_⟩
          subst go
          rfl
      | inr c2 =>
          rcases c2 with ⟨ac', bc, go⟩
          rw [LiftedProduct.boundaryIncidence_checkSupport_inr,
            LiftedProduct.mem_boundary2RowSupport_inl] at hc
          rcases hc with ⟨rfl, hCoeff⟩
          change (LiftedProduct.groupConj
            (doubleCoverTannerMatrix label g' bc br)).coeff (gi * go⁻¹) ≠ 0 at hCoeff
          rw [LiftedProduct.groupConj_apply,
            doubleCoverTannerMatrix_coeff_ne_zero_iff] at hCoeff
          have hgo : go = doubleCoverVoltage label bc.1 br * gi := by
            calc
              go = (go * gi⁻¹) * gi := by simp
              _ = doubleCoverVoltage label bc.1 br * gi := by
                rw [show go * gi⁻¹ = doubleCoverVoltage label bc.1 br by
                  simpa only [mul_inv_rev, inv_inv] using hCoeff.1]
          apply Finset.mem_union_right
          apply Finset.mem_map.mpr
          refine ⟨bc, Finset.mem_univ bc, ?_⟩
          subst go
          rfl
  | inr q =>
      rcases q with ⟨ar, bc, gi⟩
      cases c with
      | inl c0 =>
          rcases c0 with ⟨ar', br, go⟩
          rw [LiftedProduct.boundaryIncidence_checkSupport_inl,
            LiftedProduct.mem_boundary1RowSupport_inr] at hc
          rcases hc with ⟨rfl, hCoeff⟩
          change (LiftedProduct.groupConj
            (doubleCoverTannerMatrix label g' bc br)).coeff (go * gi⁻¹) ≠ 0 at hCoeff
          rw [LiftedProduct.groupConj_apply,
            doubleCoverTannerMatrix_coeff_ne_zero_iff] at hCoeff
          have hgo : go = (doubleCoverVoltage label bc.1 br)⁻¹ * gi := by
            calc
              go = (gi * go⁻¹)⁻¹ * gi := by simp
              _ = (doubleCoverVoltage label bc.1 br)⁻¹ * gi := by
                rw [show gi * go⁻¹ = doubleCoverVoltage label bc.1 br by
                  simpa only [mul_inv_rev, inv_inv] using hCoeff.1]
          apply Finset.mem_union_left
          apply Finset.mem_map.mpr
          refine ⟨br, Finset.mem_univ br, ?_⟩
          subst go
          rfl
      | inr c2 =>
          rcases c2 with ⟨ac, bc', go⟩
          rw [LiftedProduct.boundaryIncidence_checkSupport_inr,
            LiftedProduct.mem_boundary2RowSupport_inr] at hc
          rcases hc with ⟨rfl, hCoeff⟩
          rw [data, doubleCoverTannerMatrix_coeff_ne_zero_iff] at hCoeff
          have hgo : go = gi * (doubleCoverVoltage label ar.1 ac)⁻¹ := by
            calc
              go = gi * (go⁻¹ * gi)⁻¹ := by simp
              _ = gi * (doubleCoverVoltage label ar.1 ac)⁻¹ := by rw [hCoeff.1]
          apply Finset.mem_union_right
          apply Finset.mem_map.mpr
          refine ⟨ac, Finset.mem_univ ac, ?_⟩
          subst go
          rfl

/-- Each qubit is incident to at most `2(w+r+r')` checks, independently of
the voltage-group size. -/
theorem card_variableSupport_le
    (label : W → G) (h : Matrix R W F) (g' : Matrix R' W F)
    (q : LiftedProduct.QubitIndex (Fin 2 × R) W W (Fin 2 × R') G) :
    ((LiftedProduct.boundaryIncidence (data label h g')).variableSupport q).card ≤
      2 * (Fintype.card W + Fintype.card R + Fintype.card R') := by
  apply (Finset.card_le_card (variableSupport_subset_cover label h g' q)).trans
  cases q with
  | inl q =>
      rcases q with ⟨ac, br, gi⟩
      change (variableSupportCover label h g' (Sum.inl (ac, br, gi))).card ≤ _
      unfold variableSupportCover
      calc
        (Finset.univ.map _ ∪ Finset.univ.map _).card ≤
            (Finset.univ.map _).card + (Finset.univ.map _).card :=
          Finset.card_union_le _ _
        _ = 2 * Fintype.card R + 2 * Fintype.card R' := by simp
        _ ≤ 2 * (Fintype.card W + Fintype.card R + Fintype.card R') := by omega
  | inr q =>
      rcases q with ⟨ar, bc, gi⟩
      change (variableSupportCover label h g' (Sum.inr (ar, bc, gi))).card ≤ _
      unfold variableSupportCover
      calc
        (Finset.univ.map _ ∪ Finset.univ.map _).card ≤
            (Finset.univ.map _).card + (Finset.univ.map _).card :=
          Finset.card_union_le _ _
        _ = 2 * Fintype.card W := by
          simp only [Finset.card_map, Finset.card_univ]
          omega
        _ ≤ 2 * (Fintype.card W + Fintype.card R + Fintype.card R') := by omega

/-- The Tanner lifted-product incidence is uniformly local. Its explicit
bound depends only on the three local matrix dimensions, not on `|G|`. -/
theorem boundedLocality
    (label : W → G) (h : Matrix R W F) (g' : Matrix R' W F) :
    QEC.Coding.BoundedLocality
      (LiftedProduct.boundaryIncidence (data label h g')).localityProfile
      (2 * (Fintype.card W + Fintype.card R + Fintype.card R')) := by
  apply LiftedProduct.boundaryIncidence_boundedLocality_of_bounds
  · intro c0
    exact (card_boundary1RowSupport_le label h g' c0).trans (by omega)
  · intro c2
    exact (card_boundary2RowSupport_le label h g' c2).trans (by omega)
  · exact card_variableSupport_le label h g'

end QEC.Coding.TannerLiftedProduct

namespace QEC.Coding.TannerLiftedProduct

/-! ## Semantic finite-qudit presentation -/

universe w

variable {F G W R R' : Type w}
variable [Field F] [Fintype F]
variable [Group G] [Fintype G] [DecidableEq G]
variable [Fintype W] [DecidableEq W]
variable [Fintype R] [DecidableEq R]
variable [Fintype R'] [DecidableEq R']

noncomputable local instance : DecidableEq
    (LiftedProduct.QubitIndex (Fin 2 × R) W W (Fin 2 × R') G) :=
  Classical.decEq _

/-- The actual finite-qudit CSS presentation carried by the Tanner
lifted-product chain complex. -/
noncomputable def semanticPresentation
    (label : W → G) (h : Matrix R W F) (g' : Matrix R' W F) :=
  QEC.Coding.FiniteFieldCSSPresentation.presentation
    (LiftedProduct.chainComplex (data label h g'))

/-- The concrete local qudit checks of the Tanner lifted product have a
group-size-independent locality bound. Listing all scalar multiples costs one
fixed factor `|F|` in variable degree and leaves check weight unchanged. -/
theorem semanticPresentation_boundedLocality
    (label : W → G) (h : Matrix R W F) (g' : Matrix R' W F) :
    BoundedLocality
      (semanticPresentation label h g').localityProfile
      (2 * (Fintype.card W + Fintype.card R + Fintype.card R') *
        Fintype.card F) := by
  apply QEC.Coding.FiniteFieldCSSPresentation.presentation_boundedLocality_of_boundaryIncidence_bounds
  · intro c
    change ((LiftedProduct.boundaryIncidence (data label h g')).checkSupport c).card ≤
      2 * (Fintype.card W + Fintype.card R + Fintype.card R')
    cases c with
    | inl c0 =>
        rw [LiftedProduct.boundaryIncidence_checkSupport_inl]
        exact (card_boundary1RowSupport_le label h g' c0).trans (by omega)
    | inr c2 =>
        rw [LiftedProduct.boundaryIncidence_checkSupport_inr]
        exact (card_boundary2RowSupport_le label h g' c2).trans (by omega)
  · intro q
    change ((LiftedProduct.boundaryIncidence
      (data label h g')).variableSupport q).card ≤ _
    exact card_variableSupport_le label h g' q

end QEC.Coding.TannerLiftedProduct
