import QEC.Coding.Stabilizer.JointMeasurement
import QEC.Distillation.Universality.OneQubitClifford
import QEC.Distillation.TwoQubitOperations.Core
import QEC.Semantics.Entropy.Purification
/-!
# Finite adaptive ideal-Clifford primitives

This internal module supplies the typed primitive vocabulary used by the BK05
adaptive ideal-Clifford route.  Clifford actions are generated only from the
named H, K, and controlled-X presentations (and structural relabel/tensor/
composition syntax); a resource use receives and consumes the actual density
operator it debits; and an honest discard is a concrete unitary factorization
followed by the finite CPTP partial trace.

No injection, retry, density, or universality conclusion is represented here.
-/

noncomputable section

namespace QEC
namespace Distillation
namespace AdaptiveIdealClifford

open Semantics Semantics.Qubit
open Coding.PauliSymplectic
open scoped TensorProduct

universe u v w

variable {H K R E : Type u}
variable [NormedAddCommGroup H] [InnerProductSpace Complex H]
  [FiniteQuantumSystem H]
variable [NormedAddCommGroup K] [InnerProductSpace Complex K]
  [FiniteQuantumSystem K]
variable [NormedAddCommGroup R] [InnerProductSpace Complex R]
  [FiniteQuantumSystem R]
variable [NormedAddCommGroup E] [InnerProductSpace Complex E]
  [FiniteQuantumSystem E]

/-- The identity transport of a finite quantum system. -/
noncomputable def unitaryIdentity (H : Type u)
    [NormedAddCommGroup H] [InnerProductSpace Complex H] [FiniteQuantumSystem H] :
    UnitaryTransport H H where
  toLinearEquiv := LinearEquiv.refl Complex H
  map_inner := by
    intro x y
    rfl

/-- Sequential composition of two actual unitary transports. -/
noncomputable def unitaryCompose {L : Type u}
    [NormedAddCommGroup L] [InnerProductSpace Complex L] [FiniteQuantumSystem L]
    (V : UnitaryTransport K L) (U : UnitaryTransport H K) :
    UnitaryTransport H L where
  toLinearEquiv := U.toLinearEquiv.trans V.toLinearEquiv
  map_inner := by
    intro x y
    change inner Complex (V (U x)) (V (U y)) = inner Complex x y
    simpa using (V.map_inner (U x) (U y)).trans (U.map_inner x y)

/-- A finite-register presentation of the three BK05 Clifford generators. -/
structure CliffordPresentation (Wire : Type v) [Fintype Wire] where
  hadamard : Wire → UnitaryTransport H H
  phase : Wire → UnitaryTransport H H
  controlledX : Wire → Wire → UnitaryTransport H H
  relabel : Equiv.Perm Wire → UnitaryTransport H H

/--
The finite syntax generated by H, K, and controlled-X.  `tensor` denotes the
parallel composition of already registered finite-register lifts; its
semantics is the corresponding product of those concrete lifts.
-/
inductive CliffordSyntax {Wire : Type v} [Fintype Wire]
    (presentation : CliffordPresentation (H := H) Wire) where
  | identity : CliffordSyntax presentation
  | hadamard (wire : Wire) : CliffordSyntax presentation
  | phase (wire : Wire) : CliffordSyntax presentation
  | controlledX (control target : Wire) : CliffordSyntax presentation
  | relabel (permutation : Equiv.Perm Wire) (gate : CliffordSyntax presentation) :
      CliffordSyntax presentation
  | tensor (left right : CliffordSyntax presentation) : CliffordSyntax presentation
  | compose (first second : CliffordSyntax presentation) : CliffordSyntax presentation

namespace CliffordSyntax

variable {Wire : Type v} [Fintype Wire]
variable {presentation : CliffordPresentation (H := H) Wire}

/-- The concrete unitary semantics recursively generated by the syntax. -/
noncomputable def unitary : CliffordSyntax presentation → UnitaryTransport H H
  | .identity => unitaryIdentity H
  | .hadamard wire => presentation.hadamard wire
  | .phase wire => presentation.phase wire
  | .controlledX control target => presentation.controlledX control target
  | .relabel permutation gate =>
      unitaryCompose (presentation.relabel permutation) gate.unitary
  | .tensor left right => unitaryCompose right.unitary left.unitary
  | .compose first second => unitaryCompose second.unitary first.unitary

/-- Every Clifford syntax term denotes the unitary-conjugation CPTP channel. -/
noncomputable def channel (gate : CliffordSyntax presentation) : QuantumChannel H H :=
  QuantumChannel.unitaryConj gate.unitary

@[simp] theorem unitary_identity : (identity : CliffordSyntax presentation).unitary =
    unitaryIdentity H :=
  rfl

@[simp] theorem unitary_hadamard (wire : Wire) :
    (CliffordSyntax.hadamard (presentation := presentation) wire).unitary =
    presentation.hadamard wire :=
  rfl

@[simp] theorem unitary_phase (wire : Wire) :
    (CliffordSyntax.phase (presentation := presentation) wire).unitary =
    presentation.phase wire :=
  rfl

@[simp] theorem unitary_controlledX (control target : Wire) :
    (CliffordSyntax.controlledX (presentation := presentation) control target).unitary =
    presentation.controlledX control target :=
  rfl

@[simp] theorem channel_apply (gate : CliffordSyntax presentation) (A : Operator H) :
    gate.channel A = gate.unitary.conjOperator A :=
  rfl

end CliffordSyntax

/-- A typed additive multiset of consumed ideal resources. -/
abbrev ResourceLedger (Token : Type v) := Multiset Token

/-- The empty resource ledger. -/
def ResourceLedger.empty (Token : Type v) : ResourceLedger Token :=
  0

/-- The structural debit of one supplied resource token. -/
def ResourceLedger.debit {Token : Type v} (token : Token) : ResourceLedger Token :=
  {token}

/--
An actual resource use: `resource` is tensored with the live input density and
fed to `consumer`.  The ledger debit is therefore determined by this syntax,
not supplied as a numerical claim.
-/
structure ResourceUse (Token : Type v) where
  token : Token
  resource : DensityOperator R
  consumer : QuantumChannel (CompositeSystem H R) K

namespace ResourceUse

variable {Token : Type v}

/-- Execute the resource use on a density input. -/
noncomputable def run (use : ResourceUse (H := H) (K := K) (R := R) Token)
    (rho : DensityOperator H) : DensityOperator K :=
  use.consumer.mapDensity (DensityOperator.tensorDensity rho use.resource)

/-- The resource debit is exactly the singleton token supplied by the use. -/
def ledger (use : ResourceUse (H := H) (K := K) (R := R) Token) :
    ResourceLedger Token :=
  ResourceLedger.debit use.token

@[simp] theorem run_toOperator
    (use : ResourceUse (H := H) (K := K) (R := R) Token)
    (rho : DensityOperator H) :
    (use.run rho).toOperator =
      use.consumer (DensityOperator.tensorDensity rho use.resource).toOperator :=
  rfl

@[simp] theorem ledger_eq_debit
    (use : ResourceUse (H := H) (K := K) (R := R) Token) :
    use.ledger = {use.token} :=
  rfl

end ResourceUse

/--
An honest discard exposes a tensor factor by a concrete unitary and traces out
that right factor with the repository's finite CPTP partial trace.
-/
structure HonestDiscard where
  factorization : UnitaryTransport H (CompositeSystem K E)

namespace HonestDiscard

/-- The concrete CPTP channel induced by the factorization and partial trace. -/
noncomputable def channel (discard : HonestDiscard (H := H) (K := K) (E := E)) :
    QuantumChannel H K :=
  QuantumChannel.comp (partialTraceRightRaw_cptp K E)
    (QuantumChannel.unitaryConj discard.factorization)

/-- Execute the honest discard on a density input. -/
noncomputable def run (discard : HonestDiscard (H := H) (K := K) (E := E))
    (rho : DensityOperator H) : DensityOperator K :=
  discard.channel.mapDensity rho

@[simp] theorem channel_apply (discard : HonestDiscard (H := H) (K := K) (E := E))
    (A : Operator H) :
    discard.channel A = partialTraceRightRaw K E (discard.factorization.conjOperator A) :=
  rfl

@[simp] theorem run_toOperator (discard : HonestDiscard (H := H) (K := K) (E := E))
    (rho : DensityOperator H) :
    (discard.run rho).toOperator =
      partialTraceRightRaw K E (discard.factorization.conjOperator rho.toOperator) :=
  rfl

end HonestDiscard

/-- The concrete one-qubit computational `|0⟩` density used by the adapter. -/
noncomputable def zeroQubitDensity : DensityOperator QubitSpace :=
  DensityOperator.pureOfNonzero
    (EuclideanSpace.basisFun (Fin 2) Complex 0)
    (by
      intro hzero
      have hcoordinate := congrArg (fun state : QubitSpace => state 0) hzero
      simpa using hcoordinate)

/--
An engineering `|0⟩` preparation adapter.  It injects the concrete zero-qubit
density and passes the resulting joint state to an actual CPTP consumer.
-/
structure ZeroPreparationAdapter (H K : Type)
    [NormedAddCommGroup H] [InnerProductSpace Complex H] [FiniteQuantumSystem H]
    [NormedAddCommGroup K] [InnerProductSpace Complex K] [FiniteQuantumSystem K] where
  consumer : QuantumChannel (CompositeSystem H QubitSpace) K

namespace ZeroPreparationAdapter

variable {H K : Type}
variable [NormedAddCommGroup H] [InnerProductSpace Complex H] [FiniteQuantumSystem H]
variable [NormedAddCommGroup K] [InnerProductSpace Complex K] [FiniteQuantumSystem K]

/-- Run the `|0⟩` preparation adapter. -/
noncomputable def run (adapter : ZeroPreparationAdapter (H := H) (K := K))
    (rho : DensityOperator H) : DensityOperator K :=
  adapter.consumer.mapDensity (DensityOperator.tensorDensity rho zeroQubitDensity)

@[simp] theorem run_toOperator (adapter : ZeroPreparationAdapter (H := H) (K := K))
    (rho : DensityOperator H) :
    (adapter.run rho).toOperator =
      adapter.consumer (DensityOperator.tensorDensity rho zeroQubitDensity).toOperator :=
  rfl

end ZeroPreparationAdapter

/-- A raw observable outcome branch: no zero-weight branch is normalized here. -/
structure RawOutcomeBranch (H : Type u)
    [NormedAddCommGroup H] [InnerProductSpace Complex H] [FiniteQuantumSystem H] where
  operator : Operator H
  weight : ℝ

/-- The #646 joint instrument, exposed as one typed primitive measurement. -/
structure JointMeasurement (ι : Type u) [Fintype ι] [DecidableEq ι]
    (κ : Type v) [Fintype κ] [DecidableEq κ] where
  checks : κ → Binary ι
  commute : ∀ left right, Commutes (checks left) (checks right)

namespace JointMeasurement

variable {ι : Type u} [Fintype ι] [DecidableEq ι]
variable {κ : Type v} [Fintype κ] [DecidableEq κ]

/-- The actual #646 finite joint syndrome instrument selected by this primitive. -/
noncomputable def instrument (measurement : JointMeasurement ι κ) :
    FiniteInstrument (JointSyndrome κ) (JointSyndrome κ)
      (QubitRegister ι) (QubitRegister ι) :=
  jointStabilizerInstrument measurement.checks measurement.commute

/-- The computed raw branch and its Born weight for one joint syndrome. -/
noncomputable def branch (measurement : JointMeasurement ι κ)
    (syndrome : JointSyndrome κ) (rho : DensityOperator (QubitRegister ι)) :
    RawOutcomeBranch (QubitRegister ι) where
  operator := (measurement.instrument.branchOperator syndrome rho.toOperator)
  weight := measurement.instrument.bornWeight syndrome rho

@[simp] theorem branch_operator (measurement : JointMeasurement ι κ)
    (syndrome : JointSyndrome κ) (rho : DensityOperator (QubitRegister ι)) :
    (measurement.branch syndrome rho).operator =
      measurement.instrument.branchOperator syndrome rho.toOperator :=
  rfl

@[simp] theorem branch_weight (measurement : JointMeasurement ι κ)
    (syndrome : JointSyndrome κ) (rho : DensityOperator (QubitRegister ι)) :
    (measurement.branch syndrome rho).weight = measurement.instrument.bornWeight syndrome rho :=
  rfl

theorem branch_weight_nonneg (measurement : JointMeasurement ι κ)
    (syndrome : JointSyndrome κ) (rho : DensityOperator (QubitRegister ι)) :
    0 ≤ (measurement.branch syndrome rho).weight :=
  measurement.instrument.bornWeight_nonneg syndrome rho

theorem sum_branch_weight_eq_one (measurement : JointMeasurement ι κ)
    (rho : DensityOperator (QubitRegister ι)) :
    ∑ syndrome, (measurement.branch syndrome rho).weight = 1 :=
  measurement.instrument.sum_bornWeight_eq_one
    (jointStabilizerKrausFamily_complete measurement.checks measurement.commute) rho

/-- A conditional density exists only behind the instrument's strict witness. -/
noncomputable def conditionalDensity (measurement : JointMeasurement ι κ)
    (syndrome : JointSyndrome κ) (rho : DensityOperator (QubitRegister ι))
    (hpositive : 0 < (measurement.branch syndrome rho).weight) :
    DensityOperator (QubitRegister ι) :=
  measurement.instrument.conditionalDensity syndrome rho hpositive

@[simp] theorem conditionalDensity_toOperator (measurement : JointMeasurement ι κ)
    (syndrome : JointSyndrome κ) (rho : DensityOperator (QubitRegister ι))
    (hpositive : 0 < (measurement.branch syndrome rho).weight) :
    (measurement.conditionalDensity syndrome rho hpositive).toOperator =
      ((measurement.branch syndrome rho).weight : Complex)⁻¹ •
        (measurement.branch syndrome rho).operator :=
  measurement.instrument.conditionalDensity_toOperator syndrome rho hpositive

end JointMeasurement

/-- The visible history of one finite adaptive execution. -/
abbrev AdaptiveHistory (κ : Type v) := List (JointSyndrome κ ⊕ Bool)

/--
The deterministic primitive nodes that preserve a finite qubit register.  No
constructor accepts an arbitrary channel: each channel is computed from the
corresponding Clifford syntax, resource use, honest discard, or zero adapter.
-/
inductive DeterministicStep {ι : Type} [Fintype ι] [DecidableEq ι]
    {Wire : Type} [Fintype Wire] (Token : Type)
    (presentation : CliffordPresentation (H := QubitRegister ι) Wire) where
  | clifford (gate : CliffordSyntax presentation) :
      DeterministicStep Token presentation
  | resource (use : ResourceUse (H := QubitRegister ι) (K := QubitRegister ι)
      (R := QubitSpace) Token) : DeterministicStep Token presentation
  | discard (E : Type) [NormedAddCommGroup E] [InnerProductSpace Complex E]
      [FiniteQuantumSystem E]
      (discard : HonestDiscard (H := QubitRegister ι) (K := QubitRegister ι)
        (E := E)) : DeterministicStep Token presentation
  | zeroPreparation (adapter : ZeroPreparationAdapter
      (H := QubitRegister ι) (K := QubitRegister ι)) :
      DeterministicStep Token presentation

namespace DeterministicStep

variable {ι : Type} [Fintype ι] [DecidableEq ι]
variable {Wire : Type} [Fintype Wire] {Token : Type}
variable {presentation : CliffordPresentation (H := QubitRegister ι) Wire}

/-- Execute the actual deterministic primitive on a density input. -/
noncomputable def run : DeterministicStep Token presentation →
    DensityOperator (QubitRegister ι) → DensityOperator (QubitRegister ι)
  | .clifford gate => fun rho => gate.channel.mapDensity rho
  | .resource use => fun rho => use.run rho
  | @discard _ _ _ _ _ _ _ E instNormed instInner instFinite honestDiscard => fun rho =>
      letI : NormedAddCommGroup E := instNormed
      letI : InnerProductSpace Complex E := instInner
      letI : FiniteQuantumSystem E := instFinite
      honestDiscard.run rho
  | .zeroPreparation adapter => fun rho => adapter.run rho

/-- The typed resource debit determined by the primitive syntax. -/
def ledger : DeterministicStep Token presentation → ResourceLedger Token
  | .clifford _ => ResourceLedger.empty Token
  | .resource use => use.ledger
  | @discard _ _ _ _ _ _ _ _ _ _ _ _ => ResourceLedger.empty Token
  | .zeroPreparation _ => ResourceLedger.empty Token

@[simp] theorem run_clifford (gate : CliffordSyntax presentation)
    (rho : DensityOperator (QubitRegister ι)) :
    (DeterministicStep.clifford (Token := Token) gate).run rho =
      gate.channel.mapDensity rho :=
  rfl

@[simp] theorem run_resource
    (use : ResourceUse (H := QubitRegister ι) (K := QubitRegister ι)
      (R := QubitSpace) Token)
    (rho : DensityOperator (QubitRegister ι)) :
    (DeterministicStep.resource (presentation := presentation) use).run rho =
      use.run rho :=
  rfl

@[simp] theorem run_discard {E : Type}
    [NormedAddCommGroup E] [InnerProductSpace Complex E] [FiniteQuantumSystem E]
    (discard : HonestDiscard (H := QubitRegister ι) (K := QubitRegister ι) (E := E))
    (rho : DensityOperator (QubitRegister ι)) :
    (DeterministicStep.discard E (Token := Token)
      (presentation := presentation) discard).run rho =
      discard.run rho :=
  rfl

@[simp] theorem run_zeroPreparation
    (adapter : ZeroPreparationAdapter (H := QubitRegister ι) (K := QubitRegister ι))
    (rho : DensityOperator (QubitRegister ι)) :
    (DeterministicStep.zeroPreparation (Token := Token)
      (presentation := presentation) adapter).run rho =
      adapter.run rho :=
  rfl

@[simp] theorem ledger_resource
    (use : ResourceUse (H := QubitRegister ι) (K := QubitRegister ι)
      (R := QubitSpace) Token) :
    (DeterministicStep.resource (presentation := presentation) use).ledger =
      {use.token} :=
  rfl

end DeterministicStep

/--
A structurally finite adaptive ideal-Clifford program.  The only continuation
arguments are generated joint syndromes and fair Boolean coin values.
-/
inductive AdaptiveProgram {ι : Type} [Fintype ι] [DecidableEq ι]
    (κ : Type) [Fintype κ] [DecidableEq κ]
    {Wire : Type} [Fintype Wire] (Token : Type)
    (presentation : CliffordPresentation (H := QubitRegister ι) Wire) where
  | terminal (deferred : CliffordSyntax presentation) :
      AdaptiveProgram κ Token presentation
  | deterministic (step : DeterministicStep Token presentation)
      (next : AdaptiveProgram κ Token presentation) :
      AdaptiveProgram κ Token presentation
  | coin (next : Bool → AdaptiveProgram κ Token presentation) :
      AdaptiveProgram κ Token presentation
  | measure (measurement : JointMeasurement ι κ)
      (next : JointSyndrome κ → AdaptiveProgram κ Token presentation) :
      AdaptiveProgram κ Token presentation

namespace AdaptiveProgram

variable {ι : Type} [Fintype ι] [DecidableEq ι]
variable {κ : Type} [Fintype κ] [DecidableEq κ]
variable {Wire : Type} [Fintype Wire] {Token : Type}
variable {presentation : CliffordPresentation (H := QubitRegister ι) Wire}

/-- The history-local terminal data computed by one positive execution branch. -/
structure TerminalBranch (ι : Type) [Fintype ι] [DecidableEq ι]
    (κ : Type) [Fintype κ] [DecidableEq κ] (Token : Type) where
  history : AdaptiveHistory κ
  weight : ℝ
  positive : 0 < weight
  ledger : ResourceLedger Token
  output : DensityOperator (QubitRegister ι)

/-- The unnormalised quantum operator computed by a terminal branch. -/
noncomputable def TerminalBranch.rawOperator (branch : TerminalBranch
    (ι := ι) (κ := κ) (Token := Token)) : Operator (QubitRegister ι) :=
  (branch.weight : Complex) • branch.output.toOperator

/-- Prepend a deterministic debit while preserving the computed branch state. -/
def TerminalBranch.prependDeterministic (debit : ResourceLedger Token)
    (branch : TerminalBranch (ι := ι) (κ := κ) (Token := Token)) :
    TerminalBranch (ι := ι) (κ := κ) (Token := Token) where
  history := branch.history
  weight := branch.weight
  positive := branch.positive
  ledger := debit + branch.ledger
  output := branch.output

/-- Prepend one actual fair-coin value, including its factor `1 / 2`. -/
noncomputable def TerminalBranch.prependCoin (coin : Bool)
    (branch : TerminalBranch (ι := ι) (κ := κ) (Token := Token)) :
    TerminalBranch (ι := ι) (κ := κ) (Token := Token) where
  history := Sum.inr coin :: branch.history
  weight := (1 / 2 : ℝ) * branch.weight
  positive := mul_pos (by norm_num) branch.positive
  ledger := branch.ledger
  output := branch.output

/-- Prepend a generated positive joint-syndrome branch and its Born weight. -/
noncomputable def TerminalBranch.prependSyndrome (measurement : JointMeasurement ι κ)
    (syndrome : JointSyndrome κ) (rho : DensityOperator (QubitRegister ι))
    (hpositive : 0 < (measurement.branch syndrome rho).weight)
    (branch : TerminalBranch (ι := ι) (κ := κ) (Token := Token)) :
    TerminalBranch (ι := ι) (κ := κ) (Token := Token) where
  history := Sum.inl syndrome :: branch.history
  weight := (measurement.branch syndrome rho).weight * branch.weight
  positive := mul_pos hpositive branch.positive
  ledger := branch.ledger
  output := branch.output

/--
Evaluate a finite adaptive program into positive raw terminal branches.  A
zero-Born-weight syndrome is omitted before the continuation is entered, so
the evaluator never invents a normalized zero branch.
-/
noncomputable def eval : AdaptiveProgram κ Token presentation →
    DensityOperator (QubitRegister ι) →
      Multiset (TerminalBranch (ι := ι) (κ := κ) (Token := Token))
  | .terminal deferred, rho =>
      { { history := []
          weight := 1
          positive := by norm_num
          ledger := ResourceLedger.empty Token
          output := deferred.channel.mapDensity rho } }
  | .deterministic step next, rho =>
      (next.eval (step.run rho)).map (TerminalBranch.prependDeterministic step.ledger)
  | .coin next, rho =>
      ((next false).eval rho).map (TerminalBranch.prependCoin false) +
        ((next true).eval rho).map (TerminalBranch.prependCoin true)
  | .measure measurement next, rho =>
      Finset.univ.1.bind fun syndrome =>
        if hpositive : 0 < (measurement.branch syndrome rho).weight then
          ((next syndrome).eval (measurement.conditionalDensity syndrome rho hpositive)).map
            (TerminalBranch.prependSyndrome measurement syndrome rho hpositive)
        else 0

/-- The sum of the computed terminal weights. -/
def totalWeight
    (branches : Multiset (TerminalBranch (ι := ι) (κ := κ) (Token := Token))) : ℝ :=
  (branches.map TerminalBranch.weight).sum

@[simp] theorem eval_terminal (deferred : CliffordSyntax presentation)
    (rho : DensityOperator (QubitRegister ι)) :
    (terminal (κ := κ) (Token := Token) deferred).eval rho =
      { { history := []
          weight := 1
          positive := by norm_num
          ledger := ResourceLedger.empty Token
          output := deferred.channel.mapDensity rho } } :=
  rfl

@[simp] theorem eval_deterministic
    (step : DeterministicStep Token presentation)
    (next : AdaptiveProgram κ Token presentation)
    (rho : DensityOperator (QubitRegister ι)) :
    (deterministic step next).eval rho =
      (next.eval (step.run rho)).map (TerminalBranch.prependDeterministic step.ledger) :=
  rfl

@[simp] theorem eval_coin
    (next : Bool → AdaptiveProgram κ Token presentation)
    (rho : DensityOperator (QubitRegister ι)) :
    (coin next).eval rho =
      ((next false).eval rho).map (TerminalBranch.prependCoin false) +
        ((next true).eval rho).map (TerminalBranch.prependCoin true) :=
  rfl

@[simp] theorem eval_measure
    (measurement : JointMeasurement ι κ)
    (next : JointSyndrome κ → AdaptiveProgram κ Token presentation)
    (rho : DensityOperator (QubitRegister ι)) :
    (measure measurement next).eval rho =
      Finset.univ.1.bind fun syndrome =>
        if hpositive : 0 < (measurement.branch syndrome rho).weight then
          ((next syndrome).eval (measurement.conditionalDensity syndrome rho hpositive)).map
            (TerminalBranch.prependSyndrome measurement syndrome rho hpositive)
        else 0 :=
  rfl

/-- A measurement family commutes with another one pointwise. -/
def MeasurementFamiliesCommute (left right : κ → Binary ι) : Prop :=
  ∀ first second, Commutes (left first) (right second)

/--
The branch-local BK05 commutation discipline.  At a coin or syndrome split,
each continuation is checked only against measurements on that actual path;
no condition relates mutually exclusive continuations.
-/
def branchLocalCommutation : AdaptiveProgram κ Token presentation →
    List (κ → Binary ι) → Prop
  | .terminal _, _ => True
  | .deterministic _ next, history => branchLocalCommutation next history
  | .coin next, history => ∀ coin, branchLocalCommutation (next coin) history
  | .measure measurement next, history =>
      (∀ previous ∈ history, MeasurementFamiliesCommute measurement.checks previous) ∧
        ∀ syndrome, branchLocalCommutation (next syndrome) (measurement.checks :: history)

/-- The empty-history validity predicate for an adaptive program. -/
def Valid (program : AdaptiveProgram κ Token presentation) : Prop :=
  branchLocalCommutation program []

/-- Deterministic prefixes preserve the total terminal weight. -/
@[simp] theorem totalWeight_map_prependDeterministic
    (debit : ResourceLedger Token)
    (branches : Multiset (TerminalBranch (ι := ι) (κ := κ) (Token := Token))) :
    totalWeight (branches.map (TerminalBranch.prependDeterministic debit)) =
      totalWeight branches := by
  simp [totalWeight, Function.comp_def, TerminalBranch.prependDeterministic]

/-- A fair-coin prefix scales the total terminal weight by one half. -/
@[simp] theorem totalWeight_map_prependCoin (coin : Bool)
    (branches : Multiset (TerminalBranch (ι := ι) (κ := κ) (Token := Token))) :
    totalWeight (branches.map (TerminalBranch.prependCoin coin)) =
      (1 / 2 : ℝ) * totalWeight branches := by
  simpa [totalWeight, TerminalBranch.prependCoin] using
    (Multiset.sum_map_mul_left (s := branches) (a := (1 / 2 : ℝ))
      (f := TerminalBranch.weight))

/-- A positive syndrome prefix scales total terminal weight by its Born weight. -/
@[simp] theorem totalWeight_map_prependSyndrome
    (measurement : JointMeasurement ι κ) (syndrome : JointSyndrome κ)
    (rho : DensityOperator (QubitRegister ι))
    (hpositive : 0 < (measurement.branch syndrome rho).weight)
    (branches : Multiset (TerminalBranch (ι := ι) (κ := κ) (Token := Token))) :
    totalWeight (branches.map
      (TerminalBranch.prependSyndrome measurement syndrome rho hpositive)) =
      (measurement.branch syndrome rho).weight * totalWeight branches := by
  simpa [totalWeight, Function.comp_def, TerminalBranch.prependSyndrome] using
    (Multiset.sum_map_mul_left (s := branches)
      (a := (measurement.branch syndrome rho).weight) (f := TerminalBranch.weight))

/-- The terminal evaluator has exactly unit total weight. -/
@[simp] theorem eval_terminal_totalWeight (deferred : CliffordSyntax presentation)
    (rho : DensityOperator (QubitRegister ι)) :
    totalWeight ((terminal (κ := κ) (Token := Token) deferred).eval rho) = 1 := by
  simp [eval, totalWeight]

/-- The deterministic evaluator equation preserves total terminal weight. -/
@[simp] theorem eval_deterministic_totalWeight
    (step : DeterministicStep Token presentation)
    (next : AdaptiveProgram κ Token presentation)
    (rho : DensityOperator (QubitRegister ι)) :
    totalWeight ((deterministic step next).eval rho) =
      totalWeight (next.eval (step.run rho)) := by
  simp [eval]

/-- The evaluator equation for a fair Boolean coin. -/
@[simp] theorem eval_coin_totalWeight
    (next : Bool → AdaptiveProgram κ Token presentation)
    (rho : DensityOperator (QubitRegister ι)) :
    totalWeight ((coin next).eval rho) =
      (1 / 2 : ℝ) * totalWeight ((next false).eval rho) +
        (1 / 2 : ℝ) * totalWeight ((next true).eval rho) := by
  rw [eval_coin]
  calc
    totalWeight
        (((next false).eval rho).map (TerminalBranch.prependCoin false) +
          ((next true).eval rho).map (TerminalBranch.prependCoin true)) =
        totalWeight (((next false).eval rho).map (TerminalBranch.prependCoin false)) +
          totalWeight (((next true).eval rho).map (TerminalBranch.prependCoin true)) := by
      simp [totalWeight]
    _ = (1 / 2 : ℝ) * totalWeight ((next false).eval rho) +
          (1 / 2 : ℝ) * totalWeight ((next true).eval rho) := by
      rw [totalWeight_map_prependCoin, totalWeight_map_prependCoin]

/-- The evaluator equation for one finite joint-syndrome measurement. -/
theorem eval_measure_totalWeight
    (measurement : JointMeasurement ι κ)
    (next : JointSyndrome κ → AdaptiveProgram κ Token presentation)
    (rho : DensityOperator (QubitRegister ι)) :
    totalWeight ((measure measurement next).eval rho) =
      ∑ syndrome, if hpositive : 0 < (measurement.branch syndrome rho).weight then
        (measurement.branch syndrome rho).weight *
          totalWeight ((next syndrome).eval
            (measurement.conditionalDensity syndrome rho hpositive))
      else 0 := by
  classical
  rw [eval_measure]
  simp only [totalWeight, Multiset.map_bind, Multiset.sum_bind]
  apply Finset.sum_congr rfl
  intro syndrome _
  by_cases hpositive : 0 < (measurement.branch syndrome rho).weight
  · simp only [dif_pos hpositive]
    change
      totalWeight
          (((next syndrome).eval
            (measurement.conditionalDensity syndrome rho hpositive)).map
              (TerminalBranch.prependSyndrome measurement syndrome rho hpositive)) =
        (measurement.branch syndrome rho).weight *
          totalWeight ((next syndrome).eval
            (measurement.conditionalDensity syndrome rho hpositive))
    exact totalWeight_map_prependSyndrome measurement syndrome rho hpositive _
  · have hnonpositive : ¬ 0 < measurement.instrument.bornWeight syndrome rho := by
      simpa only [JointMeasurement.branch] using hpositive
    simp [hnonpositive]

/-- Every finite adaptive program has normalized terminal-branch weight. -/
theorem eval_totalWeight_eq_one
    (program : AdaptiveProgram κ Token presentation)
    (rho : DensityOperator (QubitRegister ι)) :
    totalWeight (program.eval rho) = 1 := by
  classical
  induction program generalizing rho with
  | terminal deferred =>
      exact eval_terminal_totalWeight deferred rho
  | deterministic step next ih =>
      rw [eval_deterministic_totalWeight]
      exact ih (step.run rho)
  | coin next ih =>
      rw [eval_coin_totalWeight, ih false rho, ih true rho]
      norm_num
  | measure measurement next ih =>
      rw [eval_measure_totalWeight]
      simp only [ih]
      simp only [mul_one]
      rw [show (∑ syndrome,
        if hpositive : 0 < (measurement.branch syndrome rho).weight then
          (measurement.branch syndrome rho).weight else 0) =
          ∑ syndrome, (measurement.branch syndrome rho).weight by
        apply Finset.sum_congr rfl
        intro syndrome _
        by_cases hpositive : 0 < (measurement.branch syndrome rho).weight
        · simp at hpositive
          simp [hpositive]
        · have hnonpositive : (measurement.branch syndrome rho).weight = 0 := by
            have hnonnegative := measurement.branch_weight_nonneg syndrome rho
            linarith
          simp at hnonpositive
          simp [hnonpositive]]
      exact measurement.sum_branch_weight_eq_one rho

/-- Concatenate two generated positive terminal branches. -/
noncomputable def TerminalBranch.bind
    (first second : TerminalBranch (ι := ι) (κ := κ) (Token := Token)) :
    TerminalBranch (ι := ι) (κ := κ) (Token := Token) where
  history := first.history ++ second.history
  weight := first.weight * second.weight
  positive := mul_pos first.positive second.positive
  ledger := first.ledger + second.ledger
  output := second.output

/-- Branch binding has exactly product weights and additive typed ledgers. -/
@[simp] theorem TerminalBranch.bind_weight
    (first second : TerminalBranch (ι := ι) (κ := κ) (Token := Token)) :
    (first.bind second).weight = first.weight * second.weight :=
  rfl

@[simp] theorem TerminalBranch.bind_history
    (first second : TerminalBranch (ι := ι) (κ := κ) (Token := Token)) :
    (first.bind second).history = first.history ++ second.history :=
  rfl

@[simp] theorem TerminalBranch.bind_ledger
    (first second : TerminalBranch (ι := ι) (κ := κ) (Token := Token)) :
    (first.bind second).ledger = first.ledger + second.ledger :=
  rfl

/-- The raw branch operator after binding is weighted by the first branch mass. -/
theorem TerminalBranch.bind_rawOperator
    (first second : TerminalBranch (ι := ι) (κ := κ) (Token := Token)) :
    (first.bind second).rawOperator =
      (first.weight : Complex) • second.rawOperator := by
  change
    ((↑(first.weight * second.weight) : Complex) • second.output.toOperator) =
      (first.weight : Complex) •
        ((second.weight : Complex) • second.output.toOperator)
  rw [smul_smul]
  congr 1
  norm_cast

/--
Sequentially evaluate a generated branch family and a continuation selected
from each actual terminal branch.  This is the finite bind semantics used for
whole-program composition.
-/
noncomputable def bindEval
    (branches : Multiset (TerminalBranch (ι := ι) (κ := κ) (Token := Token)))
    (next : TerminalBranch (ι := ι) (κ := κ) (Token := Token) →
      AdaptiveProgram κ Token presentation) :
    Multiset (TerminalBranch (ι := ι) (κ := κ) (Token := Token)) :=
  branches.bind fun first =>
    ((next first).eval first.output).map (TerminalBranch.bind first)

/--
If every selected continuation is normalized, finite bind preserves total
weight.  Together with `eval_totalWeight_eq_one`, this is the sequential
product-weight normalization law.
-/
theorem totalWeight_bindEval
    (branches : Multiset (TerminalBranch (ι := ι) (κ := κ) (Token := Token)))
    (next : TerminalBranch (ι := ι) (κ := κ) (Token := Token) →
      AdaptiveProgram κ Token presentation)
    (hnormal : ∀ first, totalWeight ((next first).eval first.output) = 1) :
    totalWeight (bindEval branches next) = totalWeight branches := by
  induction branches using Multiset.induction_on with
  | empty =>
      simp [bindEval, totalWeight]
  | @cons first rest induction =>
      calc
        totalWeight (bindEval (first ::ₘ rest) next) =
            first.weight * totalWeight ((next first).eval first.output) +
              totalWeight (bindEval rest next) := by
          simp [bindEval, totalWeight, Multiset.map_bind, Multiset.sum_bind,
            Function.comp_def, TerminalBranch.bind, Multiset.sum_map_mul_left]
        _ = first.weight + totalWeight rest := by
          rw [hnormal first, mul_one, induction]
        _ = totalWeight (first ::ₘ rest) := by
          simp [totalWeight]

/-- The computed unnormalised output operator of a terminal-branch family. -/
noncomputable def aggregateRaw
    (branches : Multiset (TerminalBranch (ι := ι) (κ := κ) (Token := Token))) :
    Operator (QubitRegister ι) :=
  (branches.map TerminalBranch.rawOperator).sum

/-- Aggregate the raw terminal branches of a program on one density input. -/
noncomputable def outputOperator
    (program : AdaptiveProgram κ Token presentation)
    (rho : DensityOperator (QubitRegister ι)) : Operator (QubitRegister ι) :=
  aggregateRaw (program.eval rho)

/--
Transparent deterministic channel implementation.  The target is quantified
outside program data and the equality is the computed terminal-branch output.
-/
def ImplementsChannel (program : AdaptiveProgram κ Token presentation)
    (target : QuantumChannel (QubitRegister ι) (QubitRegister ι)) : Prop :=
  ∀ rho : DensityOperator (QubitRegister ι), program.outputOperator rho = target rho.toOperator

/--
Transparent observed branch implementation.  The external target receives the
actual input density and generated history; it is never stored by the program.
-/
def ImplementsObserved
    (program : AdaptiveProgram κ Token presentation)
    (target : AdaptiveHistory κ → DensityOperator (QubitRegister ι) →
      Operator (QubitRegister ι)) : Prop :=
  ∀ (rho : DensityOperator (QubitRegister ι)) branch,
    branch ∈ program.eval rho → branch.rawOperator = target branch.history rho

/-- Select the actual terminal branches belonging to an external event. -/
def selectEvent (event : TerminalBranch (ι := ι) (κ := κ) (Token := Token) → Prop)
    [DecidablePred event]
    (branches : Multiset (TerminalBranch (ι := ι) (κ := κ) (Token := Token))) :
    Multiset (TerminalBranch (ι := ι) (κ := κ) (Token := Token)) :=
  branches.filter event

/-- The computed positive-event mass of a terminal-branch family. -/
def eventWeight (event : TerminalBranch (ι := ι) (κ := κ) (Token := Token) → Prop)
    [DecidablePred event]
    (branches : Multiset (TerminalBranch (ι := ι) (κ := κ) (Token := Token))) : ℝ :=
  totalWeight (selectEvent event branches)

/-- Rescale an actual selected branch by a strictly positive event mass. -/
noncomputable def TerminalBranch.condition
    (eventMass : ℝ) (hpositive : 0 < eventMass)
    (branch : TerminalBranch (ι := ι) (κ := κ) (Token := Token)) :
    TerminalBranch (ι := ι) (κ := κ) (Token := Token) where
  history := branch.history
  weight := eventMass⁻¹ * branch.weight
  positive := mul_pos (inv_pos.mpr hpositive) branch.positive
  ledger := branch.ledger
  output := branch.output

/--
Positive-event conditioning is a partial branch operation.  It is deliberately
defined only with a strict event-mass witness and is not advertised as CPTP.
-/
noncomputable def conditionEvent
    (event : TerminalBranch (ι := ι) (κ := κ) (Token := Token) → Prop)
    [DecidablePred event]
    (branches : Multiset (TerminalBranch (ι := ι) (κ := κ) (Token := Token)))
    (hpositive : 0 < eventWeight event branches) :
    Multiset (TerminalBranch (ι := ι) (κ := κ) (Token := Token)) :=
  (selectEvent event branches).map
    (TerminalBranch.condition (eventWeight event branches) hpositive)

/-- The exact raw-operator rescaling law for positive-event conditioning. -/
theorem TerminalBranch.condition_rawOperator
    (eventMass : ℝ) (hpositive : 0 < eventMass)
    (branch : TerminalBranch (ι := ι) (κ := κ) (Token := Token)) :
    (branch.condition eventMass hpositive).rawOperator =
      (eventMass : Complex)⁻¹ • branch.rawOperator := by
  change
    ((↑(eventMass⁻¹ * branch.weight) : Complex) • branch.output.toOperator) =
      (eventMass : Complex)⁻¹ •
        ((branch.weight : Complex) • branch.output.toOperator)
  rw [smul_smul]
  congr 1
  norm_cast

/--
Transparent positive-event implementation.  The event and target are external
arguments; a target cannot be hidden in program or branch data.
-/
def ImplementsPostselected
    (program : AdaptiveProgram κ Token presentation)
    (event : TerminalBranch (ι := ι) (κ := κ) (Token := Token) → Prop)
    [DecidablePred event]
    (target : DensityOperator (QubitRegister ι) → Operator (QubitRegister ι)) : Prop :=
  ∀ (rho : DensityOperator (QubitRegister ι))
    (hpositive : 0 < eventWeight event (program.eval rho)),
    aggregateRaw (conditionEvent event (program.eval rho) hpositive) = target rho

/-- Apply an actual terminal correction or postprocessing channel to one branch. -/
noncomputable def TerminalBranch.postprocess
    (channel : QuantumChannel (QubitRegister ι) (QubitRegister ι))
    (branch : TerminalBranch (ι := ι) (κ := κ) (Token := Token)) :
    TerminalBranch (ι := ι) (κ := κ) (Token := Token) where
  history := branch.history
  weight := branch.weight
  positive := branch.positive
  ledger := branch.ledger
  output := channel.mapDensity branch.output

@[simp] theorem TerminalBranch.postprocess_history
    (channel : QuantumChannel (QubitRegister ι) (QubitRegister ι))
    (branch : TerminalBranch (ι := ι) (κ := κ) (Token := Token)) :
    (branch.postprocess channel).history = branch.history :=
  rfl

@[simp] theorem TerminalBranch.postprocess_weight
    (channel : QuantumChannel (QubitRegister ι) (QubitRegister ι))
    (branch : TerminalBranch (ι := ι) (κ := κ) (Token := Token)) :
    (branch.postprocess channel).weight = branch.weight :=
  rfl

@[simp] theorem TerminalBranch.postprocess_ledger
    (channel : QuantumChannel (QubitRegister ι) (QubitRegister ι))
    (branch : TerminalBranch (ι := ι) (κ := κ) (Token := Token)) :
    (branch.postprocess channel).ledger = branch.ledger :=
  rfl

/-- The terminal correction acts on the computed raw operator branchwise. -/
theorem TerminalBranch.postprocess_rawOperator
    (channel : QuantumChannel (QubitRegister ι) (QubitRegister ι))
    (branch : TerminalBranch (ι := ι) (κ := κ) (Token := Token)) :
    (branch.postprocess channel).rawOperator =
      (branch.weight : Complex) • channel branch.output.toOperator :=
  rfl

/-- The identity terminal program implements its concrete identity unitary channel. -/
theorem terminal_identity_implements :
    ImplementsChannel
      (terminal (κ := κ) (Token := Token)
        (CliffordSyntax.identity : CliffordSyntax presentation))
      (QuantumChannel.unitaryConj (unitaryIdentity (QubitRegister ι))) := by
  intro rho
  simp [ImplementsChannel, outputOperator, aggregateRaw, eval,
    TerminalBranch.rawOperator, CliffordSyntax.channel, CliffordSyntax.unitary,
    unitaryIdentity, UnitaryTransport.conjOperator]

