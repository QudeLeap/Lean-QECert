import Mathlib.RingTheory.AdjoinRoot
import Mathlib.RingTheory.LocalRing.ResidueField.Ideal
import QEC.Coding.AlgebraicGeometry.Places.RatFuncPlaceClassification

/-!
# Residue fields at finite places of a rational function field

This module identifies the residue field at a finite normalized place of
`k(X)` with the polynomial quotient by the unique monic irreducible generator
of its height-one prime.

It is a local algebraic bridge for the rational-function residue theorem.  It
does not state a global residue sum or a Riemann--Roch identity.
-/

open scoped Polynomial RatFunc

namespace QEC.Coding.AlgebraicGeometry
namespace GlobalPlace

variable {k : Type*} [Field k] [Finite k]

noncomputable local instance rationalAdicDecidableEq : DecidableEq k :=
  Classical.decEq k

/-- The unique monic polynomial generator chosen from a finite rational
place's height-one prime. -/
noncomputable def rationalAdicPolynomial
    (p : IsDedekindDomain.HeightOneSpectrum k[X]) : k[X] :=
  normalize (Submodule.IsPrincipal.generator p.asIdeal)

private theorem rationalAdicGenerator_ne_zero
    (p : IsDedekindDomain.HeightOneSpectrum k[X]) :
    Submodule.IsPrincipal.generator p.asIdeal ≠ 0 := by
  intro hzero
  apply p.ne_bot
  exact (Submodule.IsPrincipal.eq_bot_iff_generator_eq_zero p.asIdeal).2 hzero

/-- The chosen polynomial representative is monic. -/
theorem rationalAdicPolynomial_monic
    (p : IsDedekindDomain.HeightOneSpectrum k[X]) :
    (rationalAdicPolynomial p).Monic := by
  change (normalize (Submodule.IsPrincipal.generator p.asIdeal)).Monic
  exact Polynomial.monic_normalize (rationalAdicGenerator_ne_zero p)

/-- The chosen polynomial representative is irreducible. -/
theorem rationalAdicPolynomial_irreducible
    (p : IsDedekindDomain.HeightOneSpectrum k[X]) :
    Irreducible (rationalAdicPolynomial p) := by
  change Irreducible (normalize (Submodule.IsPrincipal.generator p.asIdeal))
  have hprime : Prime (Submodule.IsPrincipal.generator p.asIdeal) :=
    Submodule.IsPrincipal.prime_generator_of_isPrime p.asIdeal p.ne_bot
  exact ((associated_normalize _).prime hprime).irreducible

/-- The height-one prime of a finite rational place is generated by its
chosen monic irreducible polynomial. -/
theorem rationalAdic_asIdeal_eq_span
    (p : IsDedekindDomain.HeightOneSpectrum k[X]) :
    p.asIdeal = Ideal.span ({rationalAdicPolynomial p} : Set k[X]) := by
  rw [rationalAdicPolynomial]
  exact (Ideal.span_singleton_generator p.asIdeal).symm.trans
    (Ideal.span_singleton_eq_span_singleton.mpr (associated_normalize _))

private noncomputable def rationalAdicLocalizationEquiv
    (p : IsDedekindDomain.HeightOneSpectrum k[X]) :
    Localization.AtPrime p.asIdeal ≃+* (rationalAdic p).valuationRing := by
  let e₁ : Localization.AtPrime p.asIdeal ≃+*
      p.valuationSubringAtPrime (RatFunc k) :=
    (Localization.algEquiv p.asIdeal.primeCompl
      (p.valuationSubringAtPrime (RatFunc k))).toRingEquiv
  let hsub : (p.valuationSubringAtPrime (RatFunc k)).toSubring =
      (rationalAdic p).valuationRing.toSubring := by
    change (p.valuationSubringAtPrime (RatFunc k)).toSubring =
      (p.valuation (RatFunc k)).valuationSubring.toSubring
    exact congrArg ValuationSubring.toSubring
      p.valuationSubringAtPrime_eq_valuationSubring
  let e₂ : p.valuationSubringAtPrime (RatFunc k) ≃+*
      (rationalAdic p).valuationRing :=
    RingEquiv.subringCongr hsub
  exact e₁.trans e₂

/-- Polynomial functions are integral at the corresponding finite rational
place. -/
noncomputable def rationalAdicPolynomialToValuationRing
    (p : IsDedekindDomain.HeightOneSpectrum k[X]) :
    k[X] →+* (rationalAdic p).valuationRing :=
  (rationalAdicLocalizationEquiv p).toRingHom.comp
    (algebraMap k[X] (Localization.AtPrime p.asIdeal))

/-- The valuation-ring polynomial map has the expected ambient rational
function value. -/
@[simp]
theorem coe_rationalAdicPolynomialToValuationRing
    (p : IsDedekindDomain.HeightOneSpectrum k[X]) (b : k[X]) :
    ((rationalAdicPolynomialToValuationRing p b :
      (rationalAdic p).valuationRing) : RatFunc k) =
      algebraMap k[X] (RatFunc k) b := by
  unfold rationalAdicPolynomialToValuationRing rationalAdicLocalizationEquiv
  simp only [RingHom.comp_apply]
  exact congrArg Subtype.val
    ((Localization.algEquiv p.asIdeal.primeCompl
      (p.valuationSubringAtPrime (RatFunc k))).commutes b)

private noncomputable def rationalAdicQuotientResidueEquiv
    (p : IsDedekindDomain.HeightOneSpectrum k[X]) :
    (k[X] ⧸ p.asIdeal) ≃+* p.asIdeal.ResidueField :=
  RingEquiv.ofBijective (algebraMap (k[X] ⧸ p.asIdeal) p.asIdeal.ResidueField)
    p.asIdeal.bijective_algebraMap_quotient_residueField

/-- The residue field at a finite rational place is the quotient by its
chosen monic irreducible polynomial. -/
noncomputable def rationalAdicResidueEquiv
    (p : IsDedekindDomain.HeightOneSpectrum k[X]) :
    AdjoinRoot (rationalAdicPolynomial p) ≃+* (rationalAdic p).residueField :=
  (Ideal.quotEquivOfEq (rationalAdic_asIdeal_eq_span p).symm).trans
    ((rationalAdicQuotientResidueEquiv p).trans
      (IsLocalRing.ResidueField.mapEquiv (rationalAdicLocalizationEquiv p)))

/-- The finite-place residue equivalence sends a polynomial class to the
actual reduction of that polynomial in the valuation ring. -/
@[simp]
theorem rationalAdicResidueEquiv_mk
    (p : IsDedekindDomain.HeightOneSpectrum k[X]) (b : k[X]) :
    rationalAdicResidueEquiv p
        (AdjoinRoot.mk (rationalAdicPolynomial p) b) =
      (rationalAdic p).residue (rationalAdicPolynomialToValuationRing p b) := by
  unfold rationalAdicResidueEquiv
  change (IsLocalRing.ResidueField.mapEquiv (rationalAdicLocalizationEquiv p))
      ((rationalAdicQuotientResidueEquiv p)
        ((Ideal.quotEquivOfEq (rationalAdic_asIdeal_eq_span p).symm)
          (AdjoinRoot.mk (rationalAdicPolynomial p) b))) = _
  unfold AdjoinRoot.mk
  change (IsLocalRing.ResidueField.mapEquiv (rationalAdicLocalizationEquiv p))
      ((rationalAdicQuotientResidueEquiv p)
        (Ideal.Quotient.mk p.asIdeal b)) = _
  unfold rationalAdicQuotientResidueEquiv
  rw [RingEquiv.ofBijective_apply,
    Ideal.algebraMap_quotient_residueField_mk]
  letI : IsLocalHom (rationalAdicLocalizationEquiv p).toRingHom :=
    ⟨fun _ hunit => by
      simpa using hunit.map (rationalAdicLocalizationEquiv p).symm.toRingHom⟩
  change IsLocalRing.ResidueField.map (rationalAdicLocalizationEquiv p).toRingHom
      ((IsLocalRing.residue (Localization.AtPrime p.asIdeal))
        (algebraMap k[X] (Localization.AtPrime p.asIdeal) b)) = _
  rw [IsLocalRing.ResidueField.map_residue,
    rationalAdicPolynomialToValuationRing]
  rfl

end GlobalPlace
end QEC.Coding.AlgebraicGeometry
