    · have hinl :
          (Sum.inl (xStarEdgeStart P x ⟨Sum.inl edge, edgeMember⟩) :
            SubdivisionVertex P x S) =
          Sum.inl ⟨Vertex.z z, by
            simpa [xStarBoundaryVertexMember, xStarVertexMember]
