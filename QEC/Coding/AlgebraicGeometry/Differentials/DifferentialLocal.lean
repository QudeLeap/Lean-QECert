import QEC.Coding.AlgebraicGeometry.Differentials.Differential
import QEC.Coding.AlgebraicGeometry.Places.GlobalPlace
import QEC.Coding.AlgebraicGeometry.Places.RationalPlace
import Mathlib.Algebra.Module.Torsion.Basic
import Mathlib.RingTheory.Valuation.Discrete.RankOne

/-!
# Local differential lattices

For an actual #721 global place, its normalized valuation supplies a chosen
uniformizer.  We use it to construct the valuation-ring span of universal
differentials of regular functions.  This is a local lattice, not a
conclusion-bearing canonical divisor.

The residue construction here is deliberately a congruence modulo regular
differentials.  Identifying that quotient with the place residue field, and
proving a global residue theorem, require the subsequent local-freeness and
local-expansion proofs; they are not supplied as fields or assumptions.
-/

namespace QEC.Coding.AlgebraicGeometry

open scoped WithZero

variable {k F : Type*} [Field k] [Finite k] [Field F] [Algebra k F]

namespace Differential

/-- The chosen normalized uniformizer of a global place, used as the local
parameter in the differential lattice construction. -/
noncomputable def localParameter (P : GlobalPlace k F) : F :=
  P.uniformizer

/-- The local parameter has normalized valuation `exp (-1)`. -/
theorem localParameter_valuation (P : GlobalPlace k F) :
    P.valuation (localParameter P) = WithZero.exp (-1 : ℤ) :=
  P.valuation_uniformizer

/-- A normalized local parameter is nonzero. -/
theorem localParameter_ne_zero (P : GlobalPlace k F) : localParameter P ≠ 0 := by
  intro hzero
  have hvaluation := localParameter_valuation P
  rw [hzero, (P.valuation).map_zero] at hvaluation
  exact WithZero.exp_ne_zero hvaluation.symm

/-- The unit underlying the chosen local parameter. -/
noncomputable def localParameterUnit (P : GlobalPlace k F) : Fˣ :=
  Units.mk0 (localParameter P) (localParameter_ne_zero P)

/-- The actual valuation-ring lattice generated by differentials of functions
regular at the given place. -/
noncomputable def localDifferentialLattice (P : GlobalPlace k F) :
    Submodule P.valuationRing (Differential k F) :=
  Submodule.span P.valuationRing
    (Set.range fun f : P.valuationRing => differential k F (f : F))

/-- The range of the linear map induced by a derivation on Kähler
differentials is exactly the span of its actual values. -/
private theorem derivation_span_eq_liftKaehler_range
    {R S M : Type*} [CommRing R] [CommRing S] [Algebra R S]
    [AddCommGroup M] [Module R M] [Module S M] [IsScalarTower R S M]
    (D : Derivation R S M) :
    Submodule.span S (Set.range D) = D.liftKaehlerDifferential.range := by
  apply le_antisymm
  · refine Submodule.span_le.mpr ?_
    rintro _ ⟨x, rfl⟩
    exact ⟨KaehlerDifferential.D R S x, D.liftKaehlerDifferential_comp_D x⟩
  · rintro y ⟨omega, rfl⟩
    have homega : omega ∈ Submodule.span S
        (Set.range (KaehlerDifferential.D R S)) := by
      rw [KaehlerDifferential.span_range_derivation]
      trivial
    refine Submodule.span_induction ?_ ?_ ?_ ?_ homega
    · rintro _ ⟨x, rfl⟩
      rw [D.liftKaehlerDifferential_comp_D]
      exact Submodule.subset_span (show D x ∈ Set.range D from ⟨x, rfl⟩)
    · exact Submodule.zero_mem _
    · intro x y _ _ hx hy
      rw [map_add]
      exact Submodule.add_mem _ hx hy
    · intro a x _ hx
      rw [map_smul]
      exact Submodule.smul_mem _ a hx

/-- The actual local differential lattice is the range of the map from local
Kähler differentials induced by the function-field universal derivation.  The
constant-field algebra and scalar tower on the valuation ring are theorem-local,
so this equality exports no ambient instance. -/
theorem localDifferentialLattice_eq_localKaehlerRange
    (P : GlobalPlace k F) :
    letI : Algebra k P.valuationRing :=
      (GlobalPlace.constantsToValuationRing P).toAlgebra
    letI : IsScalarTower k P.valuationRing F :=
      IsScalarTower.of_algebraMap_eq fun c => by
        change algebraMap k F c =
          ((GlobalPlace.constantsToValuationRing P c : P.valuationRing) : F)
        exact (GlobalPlace.coe_constantsToValuationRing P c).symm
    localDifferentialLattice P =
      (Derivation.liftKaehlerDifferential
        (Derivation.compAlgebraMap (A := P.valuationRing)
          (KaehlerDifferential.D k F))).range := by
  letI : Algebra k P.valuationRing :=
    (GlobalPlace.constantsToValuationRing P).toAlgebra
  letI : IsScalarTower k P.valuationRing F :=
    IsScalarTower.of_algebraMap_eq fun c => by
      change algebraMap k F c =
        ((GlobalPlace.constantsToValuationRing P c : P.valuationRing) : F)
      exact (GlobalPlace.coe_constantsToValuationRing P c).symm
  let D : Derivation k P.valuationRing (Differential k F) :=
    (KaehlerDifferential.D k F).compAlgebraMap P.valuationRing
  change Submodule.span P.valuationRing (Set.range D) =
    D.liftKaehlerDifferential.range
  exact derivation_span_eq_liftKaehler_range D

/-- A differential of a function regular at `P` lies in the constructed local
differential lattice. -/
theorem differential_mem_localDifferentialLattice (P : GlobalPlace k F)
    (f : P.valuationRing) :
    differential k F (f : F) ∈ localDifferentialLattice P :=
  Submodule.subset_span ⟨f, rfl⟩

/-- The local-parameter power used to test a differential order bound. -/
noncomputable def localParameterPower (P : GlobalPlace k F) (n : ℤ) : F :=
  ((localParameterUnit P) ^ n : Fˣ)

/-- `OrderAtLeast P n omega` means that after multiplying `omega` by the
required inverse parameter power, it lies in the actual lattice of regular
differentials.  This is an order-bound predicate; existence and uniqueness of
an integer-valued order are later theorems, not data carried here. -/
def OrderAtLeast (P : GlobalPlace k F) (n : ℤ) (omega : Differential k F) : Prop :=
  localParameterPower P (-n) • omega ∈ localDifferentialLattice P

/-- Two eligible local differentials have the same residue class when their
difference is regular.  This is the quotient relation from which the later
residue map is constructed; it does not yet identify a class with an element
of the residue field. -/
def ResidueCongruent (P : GlobalPlace k F) (omega eta : Differential k F) : Prop :=
  OrderAtLeast P 0 (omega - eta)

@[refl]
theorem residueCongruent_refl (P : GlobalPlace k F) (omega : Differential k F) :
    ResidueCongruent P omega omega := by
  simp [ResidueCongruent, OrderAtLeast, localParameterPower]

@[symm]
theorem residueCongruent_symm {P : GlobalPlace k F} {omega eta : Differential k F} :
    ResidueCongruent P omega eta -> ResidueCongruent P eta omega := by
  intro h
  rw [ResidueCongruent, OrderAtLeast, smul_sub]
  convert (localDifferentialLattice P).neg_mem (by
    rwa [ResidueCongruent, OrderAtLeast, smul_sub] at h) using 1
  abel_nf

@[trans]
theorem residueCongruent_trans {P : GlobalPlace k F}
    {omega eta theta : Differential k F} :
    ResidueCongruent P omega eta -> ResidueCongruent P eta theta ->
      ResidueCongruent P omega theta := by
  intro homegaeta hetatheta
  have hsum := (localDifferentialLattice P).add_mem homegaeta hetatheta
  simpa only [ResidueCongruent, OrderAtLeast, smul_sub, sub_add_sub_cancel] using hsum

end Differential

namespace GlobalPlace

/-- The normalized valuation of a global place is nontrivial. -/
private theorem valuation_isNontrivial (P : GlobalPlace k F) :
    P.valuation.IsNontrivial := by
  rw [Valuation.isNontrivial_iff_exists_lt_one]
  refine ⟨P.uniformizer, ?_, ?_⟩
  · apply P.valuation.ne_zero_iff.mp
    rw [P.valuation_uniformizer]
    exact WithZero.exp_ne_zero
  · rw [P.valuation_uniformizer, ← WithZero.exp_zero]
    exact WithZero.exp_lt_exp.mpr (by omega)

/-- The valuation ring of a global place is a discrete valuation ring.  The
cyclicity and nontriviality instances used here are local to this proof. -/
theorem valuationRing_isDiscreteValuationRing (P : GlobalPlace k F) :
    IsDiscreteValuationRing P.valuationRing := by
  letI : P.valuation.IsNontrivial := valuation_isNontrivial P
  letI : IsCyclic (MonoidWithZeroHom.valueGroup (.ofClass P.valuation)) := inferInstance
  letI : Nontrivial (MonoidWithZeroHom.valueGroup (.ofClass P.valuation)) := inferInstance
  exact Valuation.valuationSubring_isDiscreteValuationRing P.valuation

/-- The normalized valuation uniformizer, regarded as an element of its
valuation ring. -/
noncomputable def uniformizerInValuationRing (P : GlobalPlace k F) :
    P.valuationRing :=
  ⟨P.uniformizer, (P.mem_valuationRing_iff _).mpr (by
    rw [P.valuation_uniformizer, ← WithZero.exp_zero]
    exact WithZero.exp_le_exp.mpr (by omega))⟩

private theorem uniformizerInValuationRing_isUniformizer (P : GlobalPlace k F)
    [P.valuation.IsRankOneDiscrete] :
    P.valuation.IsUniformizer (P.uniformizerInValuationRing : F) := by
  letI : P.valuation.IsNontrivial := valuation_isNontrivial P
  letI : IsCyclic (MonoidWithZeroHom.valueGroup (.ofClass P.valuation)) := inferInstance
  letI : Nontrivial (MonoidWithZeroHom.valueGroup (.ofClass P.valuation)) := inferInstance
  change P.valuation P.uniformizer =
    (Valuation.IsRankOneDiscrete.generator P.valuation : ℤᵐ⁰)
  calc
    P.valuation P.uniformizer = WithZero.exp (-1 : ℤ) :=
      P.valuation_uniformizer
    _ = (Valuation.IsRankOneDiscrete.generator P.valuation : ℤᵐ⁰) := by
      simpa using congrArg (fun u : ℤᵐ⁰ˣ => (u : ℤᵐ⁰))
        (Valuation.IsRankOneDiscrete.generator_eq_exp_neg_one_of_surjective
          (v := P.valuation) P.normalized).symm

/-- The maximal ideal of a global place's valuation ring is generated by its
normalized valuation uniformizer. -/
theorem maximalIdeal_eq_span_uniformizer (P : GlobalPlace k F) :
    IsLocalRing.maximalIdeal P.valuationRing =
      Ideal.span ({P.uniformizerInValuationRing} : Set P.valuationRing) := by
  letI : P.valuation.IsNontrivial := valuation_isNontrivial P
  letI : IsCyclic (MonoidWithZeroHom.valueGroup (.ofClass P.valuation)) := inferInstance
  letI : Nontrivial (MonoidWithZeroHom.valueGroup (.ofClass P.valuation)) := inferInstance
  letI : P.valuation.IsRankOneDiscrete :=
    Valuation.IsRankOneDiscrete.mk' P.valuation
  exact (uniformizerInValuationRing_isUniformizer P).is_generator

end GlobalPlace

namespace Differential

/-- The actual simple-pole differential lattice: multiplication by the
normalized valuation uniformizer lands in the lattice of regular
differentials.  This makes no claim that a differential of the uniformizer is
a basis. -/
noncomputable def simplePoleDifferentialLattice (P : GlobalPlace k F) :
    Submodule P.valuationRing (Differential k F) :=
  (localDifferentialLattice P).comap
    (LinearMap.lsmul P.valuationRing (Differential k F)
      P.uniformizerInValuationRing)

/-- Every regular differential is in the simple-pole differential lattice. -/
theorem localDifferentialLattice_le_simplePoleDifferentialLattice
    (P : GlobalPlace k F) :
    localDifferentialLattice P ≤ simplePoleDifferentialLattice P := by
  intro omega homega
  change P.uniformizerInValuationRing • omega ∈ localDifferentialLattice P
  exact (localDifferentialLattice P).smul_mem _ homega

/-- The regular differentials, regarded as a submodule of the simple-pole
differential lattice. -/
noncomputable def regularDifferentialSubmoduleOfSimplePole (P : GlobalPlace k F) :
    Submodule P.valuationRing (simplePoleDifferentialLattice P) :=
  (localDifferentialLattice P).comap (simplePoleDifferentialLattice P).subtype

/-- The quotient carrier of simple-pole differentials modulo regular
differentials.  This definition does not identify it with a residue field or
assert that it has dimension one. -/
noncomputable abbrev localResidueLine (P : GlobalPlace k F) :=
  simplePoleDifferentialLattice P ⧸ regularDifferentialSubmoduleOfSimplePole P

/-- The maximal ideal kills the simple-pole quotient modulo regular
differentials. -/
theorem localResidueLine_annihilated_by_maximalIdeal (P : GlobalPlace k F) :
    Module.IsTorsionBySet P.valuationRing (localResidueLine P)
      (IsLocalRing.maximalIdeal P.valuationRing) := by
  change Module.IsTorsionBySet P.valuationRing
    (simplePoleDifferentialLattice P ⧸ regularDifferentialSubmoduleOfSimplePole P)
    (IsLocalRing.maximalIdeal P.valuationRing)
  rw [Module.isTorsionBySet_quotient_iff]
  intro x r hr
  let I : Ideal P.valuationRing :=
    (localDifferentialLattice P).comap
      (LinearMap.toSpanSingleton P.valuationRing (Differential k F)
        (x : Differential k F))
  have hspan :
      Ideal.span ({P.uniformizerInValuationRing} : Set P.valuationRing) ≤ I := by
    refine Ideal.span_le.2 ?_
    intro y hy
    have hy' : y = P.uniformizerInValuationRing := Set.mem_singleton_iff.mp hy
    subst y
    change P.uniformizerInValuationRing • (x : Differential k F) ∈
      localDifferentialLattice P
    exact x.property
  rw [P.maximalIdeal_eq_span_uniformizer] at hr
  have hrI : r ∈ I := hspan hr
  change r • (x : Differential k F) ∈ localDifferentialLattice P
  change r • (x : Differential k F) ∈ localDifferentialLattice P at hrI
  exact hrI

end Differential

end QEC.Coding.AlgebraicGeometry
