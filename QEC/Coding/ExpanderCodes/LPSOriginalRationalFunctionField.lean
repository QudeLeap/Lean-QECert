import QEC.Coding.ExpanderCodes.LPSOriginalFunctionField
import QEC.Coding.ExpanderCodes.LPSOriginalRationalModularEquation

/-!
# LPSOriginalRationalFunctionField

Construct the genuine rational field generated by the SAME original j and jN
inside the existing actual holomorphic fraction field. Faithful polynomial
evaluation embeds Q(j); the proved original rational monic relation makes
original jN integral. Its literal adjoining field is finite dimensional, with
its degree bounded by the actual finite Gamma0(N) coset cardinal. This holds
for every positive level, including composite theta levels, with no supplied
relation or integrality hypothesis. No scalar linear retraction is used as a
ring homomorphism.

The bound does not assert exact degree or irreducibility. ALL compact
meromorphic-field identification, the canonical original smooth proper
arithmetic model, uniform good reduction, geometric Hecke/Frobenius/Weil and
the public PK22 main theorem remain subsequent mathematics. This internal
original-family bridge is motivated by pinned PK22 ex:Xpq/th:qLDPC and the
audited Milne modular-curve route; it adds no public theorem/source claim.
-/

namespace QEC.Coding.TannerLiftedProduct
open Complex Filter Topology
open scoped MatrixGroups UpperHalfPlane ModularForm Manifold ContDiff Modular
noncomputable section

/-- Genuine rational polynomial evaluation at SAME original j into the existing actual holomorphic integral domain. -/
def lpsOriginalJHolomorphicEvalQ : Polynomial ℚ →+* LPSOriginalHolomorphicRing :=
  lpsOriginalJHolomorphicEval.toRingHom.comp (Polynomial.mapRingHom (algebraMap ℚ ℂ))


/-- Literal pointwise evaluation identity for the genuine rational polynomial map. -/
lemma lpsOriginalJHolomorphicEvalQ_apply (P : Polynomial ℚ) (τ : ℍ) :
    (lpsOriginalJHolomorphicEvalQ P).val τ=P.eval₂ (algebraMap ℚ ℂ) (lpsOriginalJInvariant τ) := by
  change (lpsOriginalJHolomorphicEval (P.map (algebraMap ℚ ℂ))).val τ=_
  rw [lpsOriginalJHolomorphicEval_apply,Polynomial.eval_map]


/-- Faithfulness of SAMEj rational polynomial evaluation from the proved complex map and injective coefficient inclusion. -/
lemma lpsOriginalJHolomorphicEvalQ_injective :
    Function.Injective lpsOriginalJHolomorphicEvalQ :=
  lpsOriginalJHolomorphicEval_injective.comp
    (Polynomial.map_injective (algebraMap ℚ ℂ) (algebraMap ℚ ℂ).injective)


/-- Actual original jN integral over the image of Q[j], using the proved original rational monic relation. -/
lemma lpsOriginalJNHolomorphic_integralQ (N : ℕ) [NeZero N] (hN : 0<N) :
    lpsOriginalJHolomorphicEvalQ.IsIntegralElem
      (lpsOriginalJNHolomorphic N hN) := by
  obtain ⟨Φ,hΦ,_,hroot⟩ := lpsOriginalJ_jN_rational_monic_relation N hN
  refine ⟨Φ,hΦ,?_⟩
  apply Subtype.ext
  funext τ
  let e : LPSOriginalHolomorphicRing →+*ℂ :=
    { toFun f := f.val τ
      map_one' := rfl
      map_mul' _ _ := rfl
      map_zero' := rfl
      map_add' _ _ := rfl }
  have hc : e.comp lpsOriginalJHolomorphicEvalQ=
      ((Polynomial.evalRingHom (lpsOriginalJInvariant τ)).comp
        (Polynomial.mapRingHom (algebraMap ℚ ℂ))) := by
    apply RingHom.ext
    intro P
    change (lpsOriginalJHolomorphicEvalQ P).val τ=(P.map (algebraMap ℚ ℂ)).eval (lpsOriginalJInvariant τ)
    rw [Polynomial.eval_map]
    exact lpsOriginalJHolomorphicEvalQ_apply P τ
  have h := Polynomial.hom_eval₂ Φ lpsOriginalJHolomorphicEvalQ e
    (lpsOriginalJNHolomorphic N hN)
  rw [hc] at h
  exact h.trans (hroot τ)


/-- Faithful rational fraction-field embedding through actual j polynomial evaluation and genuine fraction localization. -/
def lpsOriginalJFractionEmbeddingQ :
    FractionRing (Polynomial ℚ) →+* LPSOriginalHolomorphicFractionField :=
  IsFractionRing.lift (g:=(algebraMap LPSOriginalHolomorphicRing
    LPSOriginalHolomorphicFractionField).comp lpsOriginalJHolomorphicEvalQ)
    ((IsFractionRing.injective LPSOriginalHolomorphicRing
      LPSOriginalHolomorphicFractionField).comp
        lpsOriginalJHolomorphicEvalQ_injective)


/-- Actual fraction-field embedding on polynomials recovers the SAME original rational j evaluation. -/
lemma lpsOriginalJFractionEmbeddingQ_polynomial (P : Polynomial ℚ) :
    lpsOriginalJFractionEmbeddingQ (algebraMap (Polynomial ℚ) (FractionRing (Polynomial ℚ)) P)=
      algebraMap LPSOriginalHolomorphicRing LPSOriginalHolomorphicFractionField
        (lpsOriginalJHolomorphicEvalQ P) :=
  IsFractionRing.lift_algebraMap _ P


/-- Literal intermediate field adjoining precisely SAME original jN over the actual embedded Q(j). -/
def lpsOriginalGeneratedFunctionFieldQ (N : ℕ) (hN : 0<N) :
    letI := lpsOriginalJFractionEmbeddingQ.toAlgebra
    IntermediateField (FractionRing (Polynomial ℚ)) LPSOriginalHolomorphicFractionField := by
  letI := lpsOriginalJFractionEmbeddingQ.toAlgebra
  exact IntermediateField.adjoin (FractionRing (Polynomial ℚ))
    {lpsOriginalJNInFractionField N hN}


/-- Actual mapped monic annihilator of SAME original jN with the genuine finite coset-card upper bound. -/
lemma lpsOriginalJNInFractionField_annihilatorQ (N : ℕ) [NeZero N] (hN : 0<N) :
    letI := lpsOriginalJFractionEmbeddingQ.toAlgebra
    ∃ P : Polynomial (FractionRing (Polynomial ℚ)), P.Monic ∧
      P.natDegree≤Nat.card (𝒮ℒ ⧸
        (CongruenceSubgroup.Gamma0 N : Subgroup (GL (Fin 2) ℝ)).subgroupOf 𝒮ℒ) ∧
      Polynomial.aeval (lpsOriginalJNInFractionField N hN) P=0 := by
  let := lpsOriginalJFractionEmbeddingQ.toAlgebra
  obtain ⟨Φ,hΦ,hdeg,hroot⟩ := lpsOriginalJ_jN_rational_monic_relation N hN
  let P := Φ.map (algebraMap (Polynomial ℚ) (FractionRing (Polynomial ℚ)))
  refine ⟨P,hΦ.map _,Polynomial.natDegree_map_le.trans hdeg.le,?_⟩
  rw [Polynomial.aeval_def,Polynomial.eval₂_map]
  have hc : (algebraMap (FractionRing (Polynomial ℚ)) LPSOriginalHolomorphicFractionField).comp
      (algebraMap (Polynomial ℚ) (FractionRing (Polynomial ℚ)))=
      (algebraMap LPSOriginalHolomorphicRing LPSOriginalHolomorphicFractionField).comp
        lpsOriginalJHolomorphicEvalQ := by
    apply RingHom.ext
    intro Q
    exact lpsOriginalJFractionEmbeddingQ_polynomial Q
  rw [hc]
  have hzero : Φ.eval₂ lpsOriginalJHolomorphicEvalQ
      (lpsOriginalJNHolomorphic N hN)=0 := by
    apply Subtype.ext
    funext τ
    let e : LPSOriginalHolomorphicRing →+*ℂ :=
      { toFun f := f.val τ
        map_one' := rfl
        map_mul' _ _ := rfl
        map_zero' := rfl
        map_add' _ _ := rfl }
    have hj : e.comp lpsOriginalJHolomorphicEvalQ=
        ((Polynomial.evalRingHom (lpsOriginalJInvariant τ)).comp
        (Polynomial.mapRingHom (algebraMap ℚ ℂ))) := by
      apply RingHom.ext
      intro Q
      change (lpsOriginalJHolomorphicEvalQ Q).val τ=(Q.map (algebraMap ℚ ℂ)).eval (lpsOriginalJInvariant τ)
      rw [Polynomial.eval_map]
      exact lpsOriginalJHolomorphicEvalQ_apply Q τ
    have h := Polynomial.hom_eval₂ Φ lpsOriginalJHolomorphicEvalQ e
      (lpsOriginalJNHolomorphic N hN)
    rw [hj] at h
    exact h.trans (hroot τ)
  have h := Polynomial.hom_eval₂ Φ lpsOriginalJHolomorphicEvalQ
    (algebraMap LPSOriginalHolomorphicRing LPSOriginalHolomorphicFractionField)
    (lpsOriginalJNHolomorphic N hN)
  rw [hzero,map_zero] at h
  exact h.symm


/-- Integrality of SAME original jN over the true embedded rational function field. -/
lemma lpsOriginalJNInFractionField_integralQ (N : ℕ) [NeZero N] (hN : 0<N) :
    letI := lpsOriginalJFractionEmbeddingQ.toAlgebra
    IsIntegral (FractionRing (Polynomial ℚ)) (lpsOriginalJNInFractionField N hN) := by
  let := lpsOriginalJFractionEmbeddingQ.toAlgebra
  obtain ⟨P,hP,_,he⟩ := lpsOriginalJNInFractionField_annihilatorQ N hN
  exact ⟨P,hP,he⟩


/-- Finite dimensionality of the literal SAME original rational generated field. -/
lemma lpsOriginalGeneratedFunctionFieldQ_finiteDimensional (N : ℕ) [NeZero N] (hN : 0<N) :
    letI := lpsOriginalJFractionEmbeddingQ.toAlgebra
    FiniteDimensional (FractionRing (Polynomial ℚ)) (lpsOriginalGeneratedFunctionFieldQ N hN) := by
  let := lpsOriginalJFractionEmbeddingQ.toAlgebra
  exact IntermediateField.adjoin.finiteDimensional
    (lpsOriginalJNInFractionField_integralQ N hN)


/-- Actual generated-field degree upper bound via its true minimal polynomial dividing the proved annihilator. -/
lemma lpsOriginalGeneratedFunctionFieldQ_finrank_bound (N : ℕ) [NeZero N] (hN : 0<N) :
    letI := lpsOriginalJFractionEmbeddingQ.toAlgebra
    Module.finrank (FractionRing (Polynomial ℚ)) (lpsOriginalGeneratedFunctionFieldQ N hN)≤
      Nat.card (𝒮ℒ ⧸ (CongruenceSubgroup.Gamma0 N : Subgroup (GL (Fin 2) ℝ)).subgroupOf 𝒮ℒ) := by
  let := lpsOriginalJFractionEmbeddingQ.toAlgebra
  rw [show Module.finrank (FractionRing (Polynomial ℚ)) (lpsOriginalGeneratedFunctionFieldQ N hN)=
    (minpoly (FractionRing (Polynomial ℚ)) (lpsOriginalJNInFractionField N hN)).natDegree from
      IntermediateField.adjoin.finrank (lpsOriginalJNInFractionField_integralQ N hN)]
  obtain ⟨P,hP,hd,he⟩ := lpsOriginalJNInFractionField_annihilatorQ N hN
  exact (Polynomial.natDegree_le_of_dvd
    (minpoly.dvd (FractionRing (Polynomial ℚ)) (lpsOriginalJNInFractionField N hN) he)
    hP.ne_zero).trans hd

end
end QEC.Coding.TannerLiftedProduct
