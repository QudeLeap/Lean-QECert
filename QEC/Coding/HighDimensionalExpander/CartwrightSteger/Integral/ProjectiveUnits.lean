import QEC.Coding.HighDimensionalExpander.CartwrightSteger.Integral.SkewRepresentation

/-!
# Projective units of the integral Cartwright--Steger cyclic order

The unit classification of the skew Laurent presentation is transported
through its explicit global matrix representation.  Consequently, the full
projective unit image is proved to be exactly the subgroup generated by the
represented nonzero constants and the cyclic element `z`; this is the
construction-owned form of LSV05b Proposition 3.5 for `G'(R_T)`.
-/

namespace QEC.Coding.HighDimensionalExpander.CartwrightSteger

open scoped MatrixGroups

noncomputable def globalIntegralUnitGLHom
    (P : BasePrime) (r : Rank) :
    (CartwrightStegerSkewLaurentRing P r)ˣ →*
      Matrix.GeneralLinearGroup (Fin r.matrixRank)
        (SplittingFunctionField P r) :=
  Units.map (skewLaurentToGlobalMatrix P r).toMonoidHom

@[simp] theorem globalIntegralUnitGLHom_coe
    (P : BasePrime) (r : Rank)
    (u : (CartwrightStegerSkewLaurentRing P r)ˣ) :
    (globalIntegralUnitGLHom P r u :
      Matrix (Fin r.matrixRank) (Fin r.matrixRank)
        (SplittingFunctionField P r)) =
      skewLaurentToGlobalMatrix P r u :=
  rfl

noncomputable def globalIntegralUnitPGLHom
    (P : BasePrime) (r : Rank) :
    (CartwrightStegerSkewLaurentRing P r)ˣ →*
      Matrix.ProjGenLinGroup (Fin r.matrixRank)
        (SplittingFunctionField P r) :=
  Matrix.ProjGenLinGroup.mk.comp (globalIntegralUnitGLHom P r)

noncomputable def globalConstantPGLHom
    (P : BasePrime) (r : Rank) :
    (ConstantExtension P r)ˣ →*
      Matrix.ProjGenLinGroup (Fin r.matrixRank)
        (SplittingFunctionField P r) :=
  Matrix.ProjGenLinGroup.mk.comp
    (Units.map (constantMatrixEmbedding P r).toMonoidHom)

noncomputable def globalCyclicGeneratorPGL
    (P : BasePrime) (r : Rank) :
    Matrix.ProjGenLinGroup (Fin r.matrixRank)
      (SplittingFunctionField P r) :=
  Matrix.ProjGenLinGroup.mk (cyclicGenerator P r)

theorem globalIntegralUnitPGLHom_eq_constant_mul_zpow
    (P : BasePrime) (r : Rank)
    (u : (CartwrightStegerSkewLaurentRing P r)ˣ) :
    ∃ c : (ConstantExtension P r)ˣ, ∃ n : ℤ,
      globalIntegralUnitPGLHom P r u =
        globalConstantPGLHom P r c *
          globalCyclicGeneratorPGL P r ^ n := by
  obtain ⟨c, n, hu⟩ := exists_constant_zpow_of_skewLaurent_unit P r u
  refine ⟨c, n, ?_⟩
  have hmatrix := congrArg (skewLaurentToGlobalMatrix P r) hu
  rw [skewLaurentToGlobalMatrix_single] at hmatrix
  have hGL : globalIntegralUnitGLHom P r u =
      Units.map (constantMatrixEmbedding P r).toMonoidHom c *
        cyclicGenerator P r ^ n := by
    apply Units.ext
    exact hmatrix
  exact congrArg (Matrix.ProjGenLinGroup.mk :
    Matrix.GeneralLinearGroup (Fin r.matrixRank)
        (SplittingFunctionField P r) →*
      Matrix.ProjGenLinGroup (Fin r.matrixRank)
        (SplittingFunctionField P r)) hGL

@[simp] theorem globalIntegralUnitPGLHom_monomial
    (P : BasePrime) (r : Rank)
    (c : (ConstantExtension P r)ˣ) (n : ℤ) :
    globalIntegralUnitPGLHom P r (skewLaurentMonomialUnit P r c n) =
      globalConstantPGLHom P r c *
        globalCyclicGeneratorPGL P r ^ n := by
  apply congrArg (Matrix.ProjGenLinGroup.mk :
    Matrix.GeneralLinearGroup (Fin r.matrixRank)
        (SplittingFunctionField P r) →*
      Matrix.ProjGenLinGroup (Fin r.matrixRank)
        (SplittingFunctionField P r))
  apply Units.ext
  change skewLaurentToGlobalMatrix P r
      (SkewMonoidAlgebra.single (Multiplicative.ofAdd n)
        (c : ConstantExtension P r)) = _
  rw [skewLaurentToGlobalMatrix_single]
  rfl

noncomputable def GlobalIntegralCompactCyclicSubgroup
    (P : BasePrime) (r : Rank) :
    Subgroup (Matrix.ProjGenLinGroup (Fin r.matrixRank)
      (SplittingFunctionField P r)) :=
  Subgroup.closure
    (Set.range (globalConstantPGLHom P r) ∪
      {globalCyclicGeneratorPGL P r})

theorem range_globalIntegralUnitPGLHom
    (P : BasePrime) (r : Rank) :
    (globalIntegralUnitPGLHom P r).range =
      GlobalIntegralCompactCyclicSubgroup P r := by
  apply le_antisymm
  · rintro g ⟨u, rfl⟩
    obtain ⟨c, n, hu⟩ :=
      globalIntegralUnitPGLHom_eq_constant_mul_zpow P r u
    rw [hu]
    exact (GlobalIntegralCompactCyclicSubgroup P r).mul_mem
      (Subgroup.subset_closure
        (Set.mem_union_left _ (Set.mem_range_self c)))
      ((GlobalIntegralCompactCyclicSubgroup P r).zpow_mem
        (Subgroup.subset_closure
          (Set.mem_union_right _ (Set.mem_singleton _))) n)
  · rw [GlobalIntegralCompactCyclicSubgroup]
    apply (Subgroup.closure_le _).mpr
    rintro g (hg | hg)
    · obtain ⟨c, rfl⟩ := hg
      refine ⟨skewLaurentMonomialUnit P r c 0, ?_⟩
      simp
    · rw [Set.mem_singleton_iff] at hg
      subst g
      refine ⟨skewLaurentMonomialUnit P r 1 1, ?_⟩
      simp [globalConstantPGLHom]

end QEC.Coding.HighDimensionalExpander.CartwrightSteger
