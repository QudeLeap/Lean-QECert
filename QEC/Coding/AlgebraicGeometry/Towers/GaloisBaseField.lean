import QEC.Coding.AlgebraicGeometry.Towers.BaseParameter
import QEC.Coding.AlgebraicGeometry.Towers.GaloisBase

import Mathlib.FieldTheory.RatFunc.Luroth

/-!
# The fixed rational base of the F256 Garcia--Stichtenoth Galois family

The source-facing Galois family is normal over `F256(z)`, where
`z = (x₀^16 + x₀)^15`.  This file realizes that fixed base as the actual
intermediate field generated by `galoisBaseZ`, proves its degree in the
rational seed field. Its final seed declarations transport that base into
the original `Field` recurrence; `SourceNormalClosure` supplies the analogous
`SourceField` construction. It constructs no normal closure, ramification divisor, genus, or
asymptotic conclusion.
-/

namespace QEC.Coding.AlgebraicGeometry.F256GarciaStichtenoth

noncomputable section

open IntermediateField Polynomial

private noncomputable def galoisBasePolynomial : Polynomial F256 :=
  (Polynomial.X ^ 16 + Polynomial.X) ^ 15

private theorem galoisBaseW_eq_algebraMap :
    galoisBaseW = algebraMap (Polynomial F256) (RatFunc F256)
      (Polynomial.X ^ 16 + Polynomial.X) := by
  simp [galoisBaseW, RatFunc.algebraMap_X]

private theorem galoisBaseZ_eq_algebraMap :
    galoisBaseZ =
      algebraMap (Polynomial F256) (RatFunc F256) galoisBasePolynomial := by
  simp [galoisBaseZ, galoisBaseW, galoisBasePolynomial,
    RatFunc.algebraMap_X]

/-- The literal parameter `z = (x₀^16+x₀)^15` is transcendental over
the constant field. -/
theorem galoisBaseZ_transcendental : Transcendental F256 galoisBaseZ := by
  have hdegree :
      (Polynomial.X ^ 16 + Polynomial.X : Polynomial F256).natDegree = 16 := by
    calc
      (Polynomial.X ^ 16 + Polynomial.X : Polynomial F256).natDegree =
          (Polynomial.X ^ 16 : Polynomial F256).natDegree :=
        Polynomial.natDegree_add_eq_left_of_natDegree_lt (by norm_num)
      _ = 16 := by norm_num
  have hmonic :
      (Polynomial.X ^ 16 + Polynomial.X : Polynomial F256).Monic :=
    Polynomial.monic_X_pow_add (by norm_num)
  have hw : Transcendental F256 galoisBaseW := by
    rw [galoisBaseW_eq_algebraMap]
    simpa only [RatFunc.aeval_X_left_eq_algebraMap] using
      RatFunc.transcendental_X.aeval
        (Polynomial.X ^ 16 + Polynomial.X : Polynomial F256)
        (by simp [hdegree])
        (by simp [hmonic.leadingCoeff])
  rw [galoisBaseZ]
  exact hw.pow (by norm_num)

/-- The fixed rational base `F256(z)` inside the rational seed field. -/
abbrev GaloisBaseField : Type := F256⟮galoisBaseZ⟯

/-- Sending the rational variable to the actual parameter `z` identifies a
rational function field with the fixed base `F256(z)`. -/
noncomputable def galoisBaseFieldEquivRatFunc :
    RatFunc F256 ≃ₐ[F256] GaloisBaseField :=
  RatFunc.algEquivOfTranscendental galoisBaseZ galoisBaseZ_transcendental

noncomputable instance galoisBaseFieldRatFuncFiniteDimensional :
    FiniteDimensional GaloisBaseField (RatFunc F256) :=
  FunctionField.finiteDimensional_of_adjoin_transcendental
    galoisBaseZ_transcendental

private theorem galoisBasePolynomial_natDegree :
    galoisBasePolynomial.natDegree = 240 := by
  rw [galoisBasePolynomial, Polynomial.natDegree_pow]
  have hinner :
      (Polynomial.X ^ 16 + Polynomial.X : Polynomial F256).natDegree = 16 := by
    calc
      (Polynomial.X ^ 16 + Polynomial.X : Polynomial F256).natDegree =
          (Polynomial.X ^ 16 : Polynomial F256).natDegree :=
        Polynomial.natDegree_add_eq_left_of_natDegree_lt (by norm_num)
      _ = 16 := by norm_num
  rw [hinner]

/-- The rational seed extension `F256(x₀) / F256(z)` has its literal degree
`240 = 15 * 16`. -/
theorem galoisBaseField_ratFunc_finrank :
    Module.finrank GaloisBaseField (RatFunc F256) = 240 := by
  calc
    Module.finrank GaloisBaseField (RatFunc F256) =
        max galoisBaseZ.num.natDegree galoisBaseZ.denom.natDegree :=
      RatFunc.finrank_eq_max_natDegree galoisBaseZ
    _ = 240 := by
      rw [galoisBaseZ_eq_algebraMap, RatFunc.num_algebraMap,
        RatFunc.denom_algebraMap, galoisBasePolynomial_natDegree]
      norm_num

/-- The actual inclusion of the fixed base `F256(z)` into recursive seed
level `m`. -/
noncomputable def galoisBaseFieldSeedEmbedding (m : ℕ) :
    GaloisBaseField →ₐ[F256] Field m :=
  (IsScalarTower.toAlgHom F256 (RatFunc F256) (Field m)).comp
    (F256⟮galoisBaseZ⟯).val

noncomputable instance galoisBaseFieldSeedFiniteDimensional (m : ℕ) :
    FiniteDimensional GaloisBaseField (Field m) :=
  FiniteDimensional.trans GaloisBaseField (RatFunc F256) (Field m)

/-- The recursive seed level has degree `240 * 16^m` over the fixed Galois
base. -/
theorem galoisBaseField_seed_finrank (m : ℕ) :
    Module.finrank GaloisBaseField (Field m) = 240 * 16 ^ m := by
  calc
    Module.finrank GaloisBaseField (Field m) =
        Module.finrank GaloisBaseField (RatFunc F256) *
          Module.finrank (RatFunc F256) (Field m) :=
      (Module.finrank_mul_finrank
        GaloisBaseField (RatFunc F256) (Field m)).symm
    _ = 240 * 16 ^ m := by
      rw [galoisBaseField_ratFunc_finrank, field_finrank]

end

end QEC.Coding.AlgebraicGeometry.F256GarciaStichtenoth
