import QEC.Locality.OptimalTradeoff.CorrectablePartition
/-!
# Dai--Li `d >= k` B/B'/C partition

This internal module formalizes DL24 `main.tex:1211-1261`.  The key finite
object is not a caller-provided cut: `C` is computed from the translated grid
vertex buffer and from both endpoints of every threshold-long interaction whose
one endpoint lies in the source's wider `B'` buffer.  The latter is counted via
the actual directed incidence multiset, while the final interaction quantity
remains `longInteractionCount`, the cardinality of distinct unordered edges.

The public Dai--Li theorem is intentionally not imported or advanced here.
-/

noncomputable section

open MeasureTheory Set Metric

namespace QEC.Locality

open QEC Semantics Coding PauliSymplectic
open Coding.StabilizerCode
open Coding.StabilizerCode.BinaryStabilizerPresentation

universe u v

variable {ι : Type u} [Fintype ι] [DecidableEq ι]
variable {κ : Type v} [Fintype κ]

local instance instClassicalDecidableDGeK (p : Prop) : Decidable p :=
  Classical.propDecidable p

/-- DL24's wider `B'` buffer in the no-bad-rectangle `d >= k` branch. -/
def daiLiDGeKBPrimeQubits (embedding : UnitSeparatedEmbedding2D ι)
    (w ell : ℝ) (t : GridTranslation w) : Finset ι :=
  gridWideEdgeBufferQubits embedding w ell t

/--
The endpoints in `B'` that participate in a threshold-long interaction.
`gridBadLongEndpointQubits` is defined from the actual long-incidence index,
so it does not accept an interaction list from a caller.
-/
def daiLiDGeKBPrimeBadEndpoints
    (P : BinaryStabilizerPresentation (ι := ι) (κ := κ))
    (embedding : UnitSeparatedEmbedding2D ι) (threshold w ell : ℝ)
    (t : GridTranslation w) : Finset ι :=
  gridBadLongEndpointQubits P embedding threshold w ell t

/--
Both endpoints of every bad interaction with a `B'` endpoint.  The first
summand keeps the `B'` endpoint itself; the second is the actual finite
long-neighbour set, which supplies its opposite endpoint.
-/
def daiLiDGeKCrossingEndpoints
    (P : BinaryStabilizerPresentation (ι := ι) (κ := κ))
    (embedding : UnitSeparatedEmbedding2D ι) (threshold w ell : ℝ)
    (t : GridTranslation w) : Finset ι :=
  daiLiDGeKBPrimeBadEndpoints P embedding threshold w ell t ∪
    longNeighborsOf P embedding threshold
      (daiLiDGeKBPrimeBadEndpoints P embedding threshold w ell t)

/-- DL24 Case 2's concrete `C`: grid vertices and both B'-incident endpoints. -/
def daiLiDGeKSeparator
    (P : BinaryStabilizerPresentation (ι := ι) (κ := κ))
    (embedding : UnitSeparatedEmbedding2D ι) (threshold w ell : ℝ)
    (t : GridTranslation w) : Finset ι :=
  gridVertexBufferQubits embedding w ell t ∪
    daiLiDGeKCrossingEndpoints P embedding threshold w ell t

/-- The source's exceptional bad-qubit piece `B_0`: all bad endpoints not in C. -/
def daiLiDGeKExceptionalBadQubits
    (P : BinaryStabilizerPresentation (ι := ι) (κ := κ))
    (embedding : UnitSeparatedEmbedding2D ι) (threshold w ell : ℝ)
    (t : GridTranslation w) : Finset ι :=
  longInteractionEndpointQubits P embedding threshold \
    daiLiDGeKSeparator P embedding threshold w ell t

/-- The finite subsystem carried by the source's exceptional `B_0` qubits. -/
def daiLiDGeKExceptionalSubsystem
    (P : BinaryStabilizerPresentation (ι := ι) (κ := κ))
    (embedding : UnitSeparatedEmbedding2D ι) (threshold w ell : ℝ)
    (t : GridTranslation w) : FiniteSubsystem ι :=
  ⟨daiLiDGeKExceptionalBadQubits P embedding threshold w ell t⟩

/-- The source's good edge-strip family, with all actual long endpoints removed. -/
def daiLiDGeKGoodBFamily
    (P : BinaryStabilizerPresentation (ι := ι) (κ := κ))
    (embedding : UnitSeparatedEmbedding2D ι) (threshold w ell : ℝ)
    (t : GridTranslation w) : DaiLiGridSideIndex → FiniteSubsystem ι :=
  daiLiGridSideGoodFamily P embedding threshold w ell (gridOrigin w t)

/-- All finite physical edge strips generated by occupied grid cells. -/
def daiLiDGeKGoodBIndices
    (embedding : UnitSeparatedEmbedding2D ι) (w : ℝ)
    (t : GridTranslation w) : Finset DaiLiGridSideIndex :=
  daiLiGridSideCandidates embedding w (gridOrigin w t)

/-- DL24 Case-2's actual `B`: exceptional bad endpoints plus good edge strips. -/
def daiLiDGeKBSubsystem
    (P : BinaryStabilizerPresentation (ι := ι) (κ := κ))
    (embedding : UnitSeparatedEmbedding2D ι) (threshold w ell : ℝ)
    (t : GridTranslation w) : FiniteSubsystem ι :=
  familyUnionSubsystem
    (caseDGeKPieceFamily
      (daiLiDGeKExceptionalSubsystem P embedding threshold w ell t)
      (daiLiDGeKGoodBFamily P embedding threshold w ell t))
    (caseDGeKPieceIndices (daiLiDGeKGoodBIndices embedding w t))

/--
The Case-2 `A` family consists only of strict cores of good grid squares.
The empty rectangle family is justified below from the actual global count;
it is not supplied by the caller.
-/
def daiLiDGeKASubsystem
    (P : BinaryStabilizerPresentation (ι := ι) (κ := κ))
    (embedding : UnitSeparatedEmbedding2D ι) (d : ℕ) (threshold w ell : ℝ)
    (t : GridTranslation w) : FiniteSubsystem ι :=
  daiLiKGeDASubsystem P embedding d threshold w ell t
    (daiLiBadGridCells P embedding threshold d w (gridOrigin w t))
    (fun _ => [])

/-- The recoverable Case-2 `B` region after removing any qubit already
assigned to `A`.  This is the second region passed to #368. -/
def daiLiDGeKTrimmedBSubsystem
    (P : BinaryStabilizerPresentation (ι := ι) (κ := κ))
    (embedding : UnitSeparatedEmbedding2D ι) (d : ℕ) (threshold w ell : ℝ)
    (t : GridTranslation w) : FiniteSubsystem ι :=
  ⟨(daiLiDGeKBSubsystem P embedding threshold w ell t).selected \
    (daiLiDGeKASubsystem P embedding d threshold w ell t).selected⟩

/-- The actual third region in the Case-2 partition.  Its definition makes
the cover exhaustive; the geometry below proves that it lies in the concrete
Dai--Li separator. -/
def daiLiDGeKResidualSubsystem
    (P : BinaryStabilizerPresentation (ι := ι) (κ := κ))
    (embedding : UnitSeparatedEmbedding2D ι) (d : ℕ) (threshold w ell : ℝ)
    (t : GridTranslation w) : FiniteSubsystem ι :=
  ⟨Finset.univ \
    ((daiLiDGeKASubsystem P embedding d threshold w ell t).selected ∪
      (daiLiDGeKTrimmedBSubsystem P embedding d threshold w ell t).selected)⟩

/-- Exported definitional identity for the actual Case-2 residual requested by
the #368 interface. -/
@[simp] theorem daiLiDGeKResidual_selected_eq
    (P : BinaryStabilizerPresentation (ι := ι) (κ := κ))
    (embedding : UnitSeparatedEmbedding2D ι) (d : ℕ) (threshold w ell : ℝ)
    (t : GridTranslation w) :
    (daiLiDGeKResidualSubsystem P embedding d threshold w ell t).selected =
      Finset.univ \
        ((daiLiDGeKASubsystem P embedding d threshold w ell t).selected ∪
          (daiLiDGeKTrimmedBSubsystem P embedding d threshold w ell t).selected) := rfl

/-- The Case-2 `A`, trimmed `B`, and residual regions are pairwise disjoint. -/
theorem daiLiDGeK_partition_pairwise
    (P : BinaryStabilizerPresentation (ι := ι) (κ := κ))
    (embedding : UnitSeparatedEmbedding2D ι) (d : ℕ) (threshold w ell : ℝ)
    (t : GridTranslation w) :
    Disjoint (daiLiDGeKASubsystem P embedding d threshold w ell t).selected
      (daiLiDGeKTrimmedBSubsystem P embedding d threshold w ell t).selected ∧
    Disjoint (daiLiDGeKASubsystem P embedding d threshold w ell t).selected
      (daiLiDGeKResidualSubsystem P embedding d threshold w ell t).selected ∧
    Disjoint (daiLiDGeKTrimmedBSubsystem P embedding d threshold w ell t).selected
      (daiLiDGeKResidualSubsystem P embedding d threshold w ell t).selected := by
  constructor
  · apply Finset.disjoint_left.mpr
    intro q hA hB
    exact (Finset.mem_sdiff.mp hB).2 hA
  constructor
  · apply Finset.disjoint_left.mpr
    intro q hA hC
    exact (Finset.mem_sdiff.mp hC).2 (Finset.mem_union_left _ hA)
  · apply Finset.disjoint_left.mpr
    intro q hB hC
    exact (Finset.mem_sdiff.mp hC).2 (Finset.mem_union_right _ hB)

/-- The three concrete Case-2 regions cover every physical qubit. -/
theorem daiLiDGeK_partition_cover
    (P : BinaryStabilizerPresentation (ι := ι) (κ := κ))
    (embedding : UnitSeparatedEmbedding2D ι) (d : ℕ) (threshold w ell : ℝ)
    (t : GridTranslation w) :
    (daiLiDGeKASubsystem P embedding d threshold w ell t).selected ∪
        (daiLiDGeKTrimmedBSubsystem P embedding d threshold w ell t).selected ∪
          (daiLiDGeKResidualSubsystem P embedding d threshold w ell t).selected =
      Finset.univ := by
  ext q
  constructor
  · intro _
    exact Finset.mem_univ _
  · intro _
    by_cases hq : q ∈ (daiLiDGeKASubsystem P embedding d threshold w ell t).selected ∪
        (daiLiDGeKTrimmedBSubsystem P embedding d threshold w ell t).selected
    · rcases Finset.mem_union.mp hq with hA | hB
      · exact Finset.mem_union.mpr (Or.inl (Finset.mem_union_left _ hA))
      · exact Finset.mem_union.mpr (Or.inl (Finset.mem_union_right _ hB))
    · exact Finset.mem_union.mpr (Or.inr (Finset.mem_sdiff.mpr ⟨Finset.mem_univ _, hq⟩))

/-- DL24's principal fourth-root scale, written with the exact `c₀ = 1 / 100`. -/
def daiLiPrincipalFourthRootScale (k d n : ℝ) : ℝ :=
  (1 / 100 : ℝ) * Real.rpow (k * d ^ 2 / n) (1 / 4 : ℝ)

/-- DL24's Case-2 grid width associated to the selected fourth-root scale. -/
def daiLiDGeKGridWidth (d ell : ℝ) : ℝ := d / (100 * ell)

/-- The principal fourth-root scale has the expected fourth power on its domain. -/
theorem daiLiPrincipalFourthRootScale_pow_four
    (k d n : ℝ) (hk : 0 ≤ k) (hn : 0 < n) :
    (daiLiPrincipalFourthRootScale k d n) ^ 4 =
      (1 / 100 : ℝ) ^ 4 * (k * d ^ 2 / n) := by
  have hRatio : 0 ≤ k * d ^ 2 / n := by
    exact div_nonneg (mul_nonneg hk (sq_nonneg d)) hn.le
  have hRoot := Real.rpow_inv_natCast_pow hRatio (by norm_num : (4 : ℕ) ≠ 0)
  unfold daiLiPrincipalFourthRootScale
  rw [mul_pow]
  convert congrArg (fun x : ℝ => (1 / 100 : ℝ) ^ 4 * x) hRoot using 1 <;>
    norm_num

/--
Every selected B'-endpoint contributes all of its incident long-edge slots to
the edge-bad incidence set.  This is the finite bridge that prevents replacing
distinct unordered interactions by an untracked ordered-pair count.
-/
theorem sum_counter_daiLiDGeKBPrimeBadEndpoints_le_edgeBadCount
    (P : BinaryStabilizerPresentation (ι := ι) (κ := κ))
    (embedding : UnitSeparatedEmbedding2D ι) (threshold w ell : ℝ)
    (t : GridTranslation w) :
    (∑ q ∈ daiLiDGeKBPrimeBadEndpoints P embedding threshold w ell t,
      P.daiLiInteractionCounter embedding threshold q) ≤
      edgeBadCount w (2 * ell)
        (P.daiLiLongIncidencePoint embedding threshold) t := by
  classical
  let endpoints := daiLiDGeKBPrimeBadEndpoints P embedding threshold w ell t
  let incidences := gridBadLongIncidences P embedding threshold w ell t
  let slots : Finset (P.daiLiLongIncidenceIndex embedding threshold) :=
    endpoints.sigma fun q => Finset.univ
  have hSlotsSubset : slots ⊆ incidences := by
    intro incidence hincidence
    rcases incidence with ⟨q, slot⟩
    have hq : q ∈ endpoints := by
      simpa [slots] using hincidence
    change q ∈ (gridBadLongIncidences P embedding threshold w ell t).image Sigma.fst at hq
    rcases Finset.mem_image.mp hq with ⟨source, hsource, hsourceEq⟩
    have hEdge : edgeBad w (2 * ell) t (embedding.point q) := by
      have hSourceEdge := (Finset.mem_filter.mp hsource).2
      change edgeBad w (2 * ell) t (embedding.point source.1) at hSourceEdge
      simpa [hsourceEq] using hSourceEdge
    change ⟨q, slot⟩ ∈ gridBadLongIncidences P embedding threshold w ell t
    apply Finset.mem_filter.mpr
    refine ⟨Finset.mem_univ _, ?_⟩
    simpa [incidences, gridBadLongIncidences,
      Coding.StabilizerCode.BinaryStabilizerPresentation.daiLiLongIncidencePoint] using hEdge
  have hCard : slots.card =
      ∑ q ∈ endpoints, P.daiLiInteractionCounter embedding threshold q := by
    simp [slots]
  calc
    _ = slots.card := by simpa [endpoints] using hCard.symm
    _ ≤ incidences.card := Finset.card_le_card hSlotsSubset
    _ = edgeBadCount w (2 * ell)
        (P.daiLiLongIncidencePoint embedding threshold) t := by
      simp [incidences, gridBadLongIncidences, edgeBadCount]

/--
The crossing endpoint set costs at most twice the selected long-incidence
count: once for the B' endpoint and once for its opposite endpoint.
-/
theorem card_daiLiDGeKCrossingEndpoints_le_two_mul_edgeBadCount
    (P : BinaryStabilizerPresentation (ι := ι) (κ := κ))
    (embedding : UnitSeparatedEmbedding2D ι) (threshold w ell : ℝ)
    (t : GridTranslation w) :
    (daiLiDGeKCrossingEndpoints P embedding threshold w ell t).card ≤
      2 * edgeBadCount w (2 * ell)
        (P.daiLiLongIncidencePoint embedding threshold) t := by
  classical
  let endpoints := daiLiDGeKBPrimeBadEndpoints P embedding threshold w ell t
  let neighbours := longNeighborsOf P embedding threshold endpoints
  have hUnion : (endpoints ∪ neighbours).card ≤ endpoints.card + neighbours.card :=
    Finset.card_union_le _ _
  have hEndpoint : endpoints.card ≤ edgeBadCount w (2 * ell)
      (P.daiLiLongIncidencePoint embedding threshold) t := by
    simpa [endpoints, daiLiDGeKBPrimeBadEndpoints] using
      card_gridBadLongEndpointQubits_le_edgeBadCount P embedding threshold w ell t
  have hNeighbour : neighbours.card ≤ edgeBadCount w (2 * ell)
      (P.daiLiLongIncidencePoint embedding threshold) t := by
    calc
      _ ≤ ∑ q ∈ endpoints, P.daiLiInteractionCounter embedding threshold q :=
        card_longNeighborsOf_le_sum_counter P embedding threshold endpoints
      _ ≤ _ := sum_counter_daiLiDGeKBPrimeBadEndpoints_le_edgeBadCount
        P embedding threshold w ell t
  change (endpoints ∪ neighbours).card ≤ _
  omega

/--
A threshold-long endpoint lying in the actual wider `B'` buffer is selected
by the bad-incidence construction.  This is the formal `B'`-to-`C` routing
step in DL24 Case 2.
-/
theorem mem_daiLiDGeKBPrimeBadEndpoints_of_mem_wide_longEndpoint
    (P : BinaryStabilizerPresentation (ι := ι) (κ := κ))
    (embedding : UnitSeparatedEmbedding2D ι) (threshold w ell : ℝ)
    (t : GridTranslation w) (q : ι)
    (hWide : q ∈ daiLiDGeKBPrimeQubits embedding w ell t)
    (hLong : q ∈ longInteractionEndpointQubits P embedding threshold) :
    q ∈ daiLiDGeKBPrimeBadEndpoints P embedding threshold w ell t := by
  classical
  have hCounter : 0 < P.daiLiInteractionCounter embedding threshold q :=
    (mem_longInteractionEndpointQubits_iff P embedding threshold q).1 hLong
  apply Finset.mem_image.mpr
  refine ⟨⟨q, ⟨0, hCounter⟩⟩, ?_, rfl⟩
  apply Finset.mem_filter.mpr
  refine ⟨Finset.mem_univ _, ?_⟩
  have hEdge : edgeBad w (2 * ell) t (embedding.point q) := by
    simpa [daiLiDGeKBPrimeQubits, gridWideEdgeBufferQubits] using
      (Finset.mem_filter.mp hWide).2.2
  simpa [gridBadLongIncidences,
    Coding.StabilizerCode.BinaryStabilizerPresentation.daiLiLongIncidencePoint] using hEdge

/--
An exceptional bad qubit is genuinely outside `B'`: otherwise its own bad
incidence would have put it into the crossing-endpoint part of `C`.
-/
theorem exceptionalBad_not_mem_daiLiDGeKBPrime
    (P : BinaryStabilizerPresentation (ι := ι) (κ := κ))
    (embedding : UnitSeparatedEmbedding2D ι) (threshold w ell : ℝ)
    (t : GridTranslation w) (q : ι)
    (hq : q ∈ daiLiDGeKExceptionalBadQubits P embedding threshold w ell t) :
    q ∉ daiLiDGeKBPrimeQubits embedding w ell t := by
  intro hWide
  have hLong : q ∈ longInteractionEndpointQubits P embedding threshold :=
    (Finset.mem_sdiff.mp hq).1
  have hBad : q ∈ daiLiDGeKBPrimeBadEndpoints P embedding threshold w ell t :=
    mem_daiLiDGeKBPrimeBadEndpoints_of_mem_wide_longEndpoint P embedding threshold
      w ell t q hWide hLong
  have hCrossing : q ∈ daiLiDGeKCrossingEndpoints P embedding threshold w ell t := by
    exact Finset.mem_union_left _ hBad
  exact (Finset.mem_sdiff.mp hq).2 (Finset.mem_union_right _ hCrossing)

/--
The finite geometric form of DL24's `B_0 \u2212 B'` separation argument.  A
point of `B_0` cannot be closer than `ell` to an actual width-`ell` side
strip: a shorter segment would place it in the periodic width-`2 * ell`
buffer, contradicting the preceding B'-to-C routing theorem.
-/
theorem exceptionalBad_separated_from_gridSideStrip
    (P : BinaryStabilizerPresentation (ι := ι) (κ := κ))
    (embedding : UnitSeparatedEmbedding2D ι) (threshold w ell : ℝ)
    (t : GridTranslation w) (hw : 0 < w)
    (p q : ι) (side : DaiLiGridSideIndex)
    (hp : p ∈ daiLiDGeKExceptionalBadQubits P embedding threshold w ell t)
    (hq : q ∈ daiLiGridSideStripQubits embedding w ell (2 * ell)
      (gridOrigin w t) side) :
    ell ≤ embedding.distance p q := by
  classical
  have hpNotSeparator : p ∉ daiLiDGeKSeparator P embedding threshold w ell t :=
    (Finset.mem_sdiff.mp hp).2
  have hpNotVertex : ¬ vertexBad w (2 * ell) t (embedding.point p) := by
    intro hVertex
    apply hpNotSeparator
    apply Finset.mem_union_left
    exact Finset.mem_filter.mpr ⟨Finset.mem_univ _, hVertex⟩
  have hpNotWide := exceptionalBad_not_mem_daiLiDGeKBPrime
    P embedding threshold w ell t p hp
  have hpNotEdge : ¬ edgeBad w (2 * ell) t (embedding.point p) := by
    intro hEdge
    apply hpNotWide
    exact Finset.mem_filter.mpr ⟨Finset.mem_univ _, hpNotVertex, hEdge⟩
  have hCoordinateX : |(embedding.point p).1 - (embedding.point q).1| ≤
      embedding.distance p q := by
    rw [UnitSeparatedEmbedding2D.distance, euclideanDistance2D]
    apply Real.abs_le_sqrt
    nlinarith [sq_nonneg ((embedding.point p).2 - (embedding.point q).2)]
  have hCoordinateY : |(embedding.point p).2 - (embedding.point q).2| ≤
      embedding.distance p q := by
    rw [UnitSeparatedEmbedding2D.distance, euclideanDistance2D]
    apply Real.abs_le_sqrt
    nlinarith [sq_nonneg ((embedding.point p).1 - (embedding.point q).1)]
  by_contra hSeparated
  have hDistance : embedding.distance p q < ell := lt_of_not_ge hSeparated
  rcases side with ⟨i, j, vertical⟩
  by_cases hVertical : vertical
  · have hqBounds := hq
    simp [daiLiGridSideStripQubits, hVertical] at hqBounds
    have hQLine : |(embedding.point q).1 -
        ((gridOrigin w t).1 + (i : ℝ) * w)| ≤ ell := by
      rw [abs_le]
      constructor <;> linarith [hqBounds.1.1, hqBounds.1.2]
    have hPLine : |(embedding.point p).1 -
        ((gridOrigin w t).1 + (i : ℝ) * w)| ≤ 2 * ell := by
      calc
        |(embedding.point p).1 - ((gridOrigin w t).1 + (i : ℝ) * w)| =
            |((embedding.point p).1 - (embedding.point q).1) +
              ((embedding.point q).1 - ((gridOrigin w t).1 + (i : ℝ) * w))| := by
              congr 1
              ring
        _ ≤ |(embedding.point p).1 - (embedding.point q).1| +
              |(embedding.point q).1 - ((gridOrigin w t).1 + (i : ℝ) * w)| :=
            abs_add_le _ _
        _ ≤ ell + ell := by
            gcongr
            exact hCoordinateX.trans hDistance.le
        _ = 2 * ell := by ring
    apply hpNotEdge
    unfold edgeBad
    left
    have htX : t.1 = ((gridOrigin w t).1 : AddCircle w) := by
      have hPhase := congrArg Prod.fst (phase_gridOrigin w t)
      simpa [phase] using hPhase.symm
    rw [htX]
    have hperiod :
        (((gridOrigin w t).1 + (i : ℝ) * w : ℝ) : AddCircle w) =
          ((gridOrigin w t).1 : AddCircle w) :=
      addCircle_coe_add_int_mul_period w (gridOrigin w t).1 i
    have hdist := addCircle_dist_le_abs_sub w
      ((gridOrigin w t).1 + (i : ℝ) * w) (embedding.point p).1 hw
    rw [hperiod] at hdist
    calc
      dist ((gridOrigin w t).1 : AddCircle w) (phase w (embedding.point p)).1 ≤
          |(embedding.point p).1 - (gridOrigin w t).1 - (i : ℝ) * w| := by
        simp only [sub_add_eq_sub_sub] at hdist
        exact hdist
      _ = |(embedding.point p).1 - ((gridOrigin w t).1 + (i : ℝ) * w)| := by
        congr 1
        ring
      _ ≤ 2 * ell := hPLine
  · have hqBounds := hq
    simp [daiLiGridSideStripQubits, hVertical] at hqBounds
    have hQLine : |(embedding.point q).2 -
        ((gridOrigin w t).2 + (j : ℝ) * w)| ≤ ell := by
      rw [abs_le]
      constructor <;> linarith [hqBounds.2.1, hqBounds.2.2]
    have hPLine : |(embedding.point p).2 -
        ((gridOrigin w t).2 + (j : ℝ) * w)| ≤ 2 * ell := by
      calc
        |(embedding.point p).2 - ((gridOrigin w t).2 + (j : ℝ) * w)| =
            |((embedding.point p).2 - (embedding.point q).2) +
              ((embedding.point q).2 - ((gridOrigin w t).2 + (j : ℝ) * w))| := by
              congr 1
              ring
        _ ≤ |(embedding.point p).2 - (embedding.point q).2| +
              |(embedding.point q).2 - ((gridOrigin w t).2 + (j : ℝ) * w)| :=
            abs_add_le _ _
        _ ≤ ell + ell := by
            gcongr
            exact hCoordinateY.trans hDistance.le
        _ = 2 * ell := by ring
    apply hpNotEdge
    unfold edgeBad
    right
    have htY : t.2 = ((gridOrigin w t).2 : AddCircle w) := by
      have hPhase := congrArg Prod.snd (phase_gridOrigin w t)
      simpa [phase] using hPhase.symm
    rw [htY]
    have hperiod :
        (((gridOrigin w t).2 + (j : ℝ) * w : ℝ) : AddCircle w) =
          ((gridOrigin w t).2 : AddCircle w) :=
      addCircle_coe_add_int_mul_period w (gridOrigin w t).2 j
    have hdist := addCircle_dist_le_abs_sub w
      ((gridOrigin w t).2 + (j : ℝ) * w) (embedding.point p).2 hw
    rw [hperiod] at hdist
    calc
      dist ((gridOrigin w t).2 : AddCircle w) (phase w (embedding.point p)).2 ≤
          |(embedding.point p).2 - (gridOrigin w t).2 - (j : ℝ) * w| := by
        simp only [sub_add_eq_sub_sub] at hdist
        exact hdist
      _ = |(embedding.point p).2 - ((gridOrigin w t).2 + (j : ℝ) * w)| := by
        congr 1
        ring
      _ ≤ 2 * ell := hPLine

/--
The exceptional bad set is small whenever the actual *unordered* long-edge
count is small.  The factor two is discharged from the interaction graph's
degree-sum theorem, rather than being supplied by a caller.
-/
theorem card_daiLiDGeKExceptionalBadQubits_lt_distance
    (P : BinaryStabilizerPresentation (ι := ι) (κ := κ))
    (embedding : UnitSeparatedEmbedding2D ι) (threshold w ell : ℝ)
    (t : GridTranslation w) (d : ℕ)
    (hLongCount : 2 * P.longInteractionCount embedding threshold < d) :
    (daiLiDGeKExceptionalBadQubits P embedding threshold w ell t).card < d := by
  calc
    (daiLiDGeKExceptionalBadQubits P embedding threshold w ell t).card ≤
        (longInteractionEndpointQubits P embedding threshold).card :=
      Finset.card_le_card Finset.sdiff_subset
    _ ≤ ∑ q : ι, P.daiLiInteractionCounter embedding threshold q :=
      card_longInteractionEndpointQubits_le_sum_counter P embedding threshold
    _ = 2 * P.longInteractionCount embedding threshold :=
      P.sum_daiLiInteractionCounter_eq_two_mul_longInteractionCount embedding threshold
    _ < d := hLongCount

/--
The exceptional `B_0` piece has no fixed-generator interaction with an actual
good edge strip.  Long interactions are excluded by the endpoint deletion;
short interactions are excluded by the proved `B_0 \u2212 B'` separation.
-/
theorem exceptionalBad_fixedGeneratorDecoupled_gridSideGood
    (P : BinaryStabilizerPresentation (ι := ι) (κ := κ))
    (embedding : UnitSeparatedEmbedding2D ι) (threshold w ell : ℝ)
    (t : GridTranslation w) (hw : 0 < w) (hThresholdEll : threshold ≤ ell)
    (side : DaiLiGridSideIndex) :
    P.fixedGeneratorDecoupled
      ((daiLiDGeKExceptionalBadQubits P embedding threshold w ell t : Finset ι) : Set ι)
      ((daiLiGridSideGoodQubits P embedding threshold w ell (gridOrigin w t) side :
        Finset ι) : Set ι) := by
  refine ⟨?_, ?_⟩
  · apply Set.disjoint_left.2
    intro q hExceptional hGood
    have hExceptional' : q ∈ daiLiDGeKExceptionalBadQubits P embedding threshold w ell t := by
      simpa using hExceptional
    have hEndpoint : q ∈ longInteractionEndpointQubits P embedding threshold :=
      (Finset.mem_sdiff.mp hExceptional').1
    have hGood' : q ∈ daiLiGridSideGoodQubits P embedding threshold w ell
        (gridOrigin w t) side := by
      simpa using hGood
    exact (Finset.mem_sdiff.mp hGood').2 hEndpoint
  · intro p hp q hq hInteraction
    have hpExceptional : p ∈ daiLiDGeKExceptionalBadQubits P embedding threshold w ell t := by
      simpa using hp
    have hqGood : q ∈ daiLiGridSideGoodQubits P embedding threshold w ell
        (gridOrigin w t) side := by
      simpa using hq
    by_cases hLong : threshold ≤ embedding.distance p q
    · have hqOutside : q ∉ longInteractionEndpointQubits P embedding threshold :=
        (Finset.mem_sdiff.mp hqGood).2
      exact no_long_interaction_from_outside_endpoint_set P embedding threshold q p hqOutside
        ⟨P.fixedGeneratorInteractionGraph_symmetric hInteraction,
          by simpa [embedding.distance_comm] using hLong⟩
    · have hShort : embedding.distance p q < ell :=
        (lt_of_not_ge hLong).trans_le hThresholdEll
      have hSeparated := exceptionalBad_separated_from_gridSideStrip P embedding threshold w ell
        t hw p q side hpExceptional (Finset.mem_sdiff.mp hqGood).1
      exact (not_lt_of_ge hSeparated) hShort

/-- A small helper for reversing a fixed-generator decoupling certificate. -/
theorem fixedGeneratorDecoupled_symm
    (P : BinaryStabilizerPresentation (ι := ι) (κ := κ))
    {left right : Set ι}
    (h : P.fixedGeneratorDecoupled left right) :
    P.fixedGeneratorDecoupled right left := by
  refine ⟨h.1.symm, ?_⟩
  intro p hp q hq hInteraction
  exact h.2 hq hp (P.fixedGeneratorInteractionGraph_symmetric hInteraction)

/--
DL24 Case 2's entire `B` region has an actual CPTP erasure recovery.  The
caller supplies only the source's numerical scale checks; its partition,
endpoint routing, local recoveries, and pairwise decoupling are constructed
above from the finite interaction graph and translated grid.
-/
theorem exists_erasureRecovery_daiLiDGeKB
    (P : BinaryStabilizerPresentation (ι := ι) (κ := κ))
    (embedding : UnitSeparatedEmbedding2D ι) (d : ℕ)
    (hDistance : StabilizerCode.SemanticStabilizerDistance P.code d)
    (threshold w ell : ℝ) (t : GridTranslation w)
    (hEll : 0 < ell) (hWidth : 4 * ell ≤ w)
    (hThresholdEll : threshold ≤ ell)
    (hEdge : 1 ≤ 2 * ell) (hLongStrip : 1 ≤ w - 4 * ell)
    (hSmallStrip : 12 * ell * (w - 4 * ell) < d)
    (hLongCount : 2 * P.longInteractionCount embedding threshold < d) :
    ∃ recovery : QuantumChannel
        (daiLiDGeKBSubsystem P embedding threshold w ell t).complementSystem
        (Qubit.QubitRegister ι),
      Correctable (Qubit.QubitRegister ι)
        (daiLiDGeKBSubsystem P embedding threshold w ell t).complementSystem
        P.semanticCode
        (daiLiDGeKBSubsystem P embedding threshold w ell t).erasureChannelFromRegister
        recovery := by
  apply exists_erasureRecovery_caseDGeK_badQubits_edgeStrips P d hDistance
    (daiLiDGeKExceptionalSubsystem P embedding threshold w ell t)
    (daiLiDGeKGoodBFamily P embedding threshold w ell t)
    (daiLiDGeKGoodBIndices embedding w t)
  · intro piece hpiece
    rcases piece with _ | side
    · simpa [caseDGeKPieceFamily, daiLiDGeKExceptionalSubsystem] using
        card_daiLiDGeKExceptionalBadQubits_lt_distance P embedding threshold w ell t d
          hLongCount
    · simpa [caseDGeKPieceFamily, daiLiDGeKGoodBFamily,
        daiLiGridSideGoodFamily, daiLiGridSideGoodSubsystem] using
        card_daiLiGridSideGood_lt_distance P embedding d threshold (gridOrigin w t) side
          hEdge hLongStrip hSmallStrip
  · intro piece hpiece other hother hne
    rcases piece with _ | side <;> rcases other with _ | other
    · exact (hne rfl).elim
    · simpa [caseDGeKPieceFamily, daiLiDGeKExceptionalSubsystem,
        daiLiDGeKGoodBFamily, daiLiGridSideGoodFamily, daiLiGridSideGoodSubsystem] using
        exceptionalBad_fixedGeneratorDecoupled_gridSideGood P embedding threshold w ell t
          (by linarith : 0 < w) hThresholdEll other
    · simpa [caseDGeKPieceFamily, daiLiDGeKExceptionalSubsystem,
        daiLiDGeKGoodBFamily, daiLiGridSideGoodFamily, daiLiGridSideGoodSubsystem] using
        fixedGeneratorDecoupled_symm P
          (exceptionalBad_fixedGeneratorDecoupled_gridSideGood P embedding threshold w ell t
            (by linarith : 0 < w) hThresholdEll side)
    · simpa [caseDGeKPieceFamily, daiLiDGeKGoodBFamily,
        daiLiGridSideGoodFamily, daiLiGridSideGoodSubsystem] using
        daiLiGridSideGood_fixedGeneratorDecoupled P embedding hEll hWidth threshold hThresholdEll
          (gridOrigin w t) side other (by
            intro hEq
            apply hne
            simpa [hEq])

/-- The second #368 region inherits the actual CPTP recovery of the complete
Case-2 `B` construction by selected-subsystem inclusion. -/
theorem exists_erasureRecovery_daiLiDGeKTrimmedB
    (P : BinaryStabilizerPresentation (ι := ι) (κ := κ))
    (embedding : UnitSeparatedEmbedding2D ι) (d : ℕ)
    (hDistance : StabilizerCode.SemanticStabilizerDistance P.code d)
    (threshold w ell : ℝ) (t : GridTranslation w)
    (hEll : 0 < ell) (hWidth : 4 * ell ≤ w)
    (hThresholdEll : threshold ≤ ell)
    (hEdge : 1 ≤ 2 * ell) (hLongStrip : 1 ≤ w - 4 * ell)
    (hSmallStrip : 12 * ell * (w - 4 * ell) < d)
    (hLongCount : 2 * P.longInteractionCount embedding threshold < d) :
    ∃ recovery : QuantumChannel
        (daiLiDGeKTrimmedBSubsystem P embedding d threshold w ell t).complementSystem
        (Qubit.QubitRegister ι),
      Correctable (Qubit.QubitRegister ι)
        (daiLiDGeKTrimmedBSubsystem P embedding d threshold w ell t).complementSystem
        P.semanticCode
        (daiLiDGeKTrimmedBSubsystem P embedding d threshold w ell t).erasureChannelFromRegister
        recovery := by
  apply exists_erasureRecovery_of_finiteSubsystem_subset
    (daiLiDGeKTrimmedBSubsystem P embedding d threshold w ell t)
    (daiLiDGeKBSubsystem P embedding threshold w ell t)
  · exact Finset.sdiff_subset
  · exact exists_erasureRecovery_daiLiDGeKB P embedding d hDistance threshold w ell t
      hEll hWidth hThresholdEll hEdge hLongStrip hSmallStrip hLongCount

/--
Case 2 has no bad grid cells once the actual total long-incidence count is
below `d / 10`.  This turns the paper's "fewer than one bad rectangle" step
into a finite contradiction, rather than accepting an empty rectangle list.
-/
theorem daiLiBadGridCells_eq_empty_of_small_longCount
    (P : BinaryStabilizerPresentation (ι := ι) (κ := κ))
    (embedding : UnitSeparatedEmbedding2D ι) (threshold w : ℝ) (d : ℕ)
    (origin : ℝ × ℝ)
    (hGlobal : 10 * (∑ q : ι, P.daiLiInteractionCounter embedding threshold q) < d) :
    daiLiBadGridCells P embedding threshold d w origin = ∅ := by
  classical
  apply Finset.not_nonempty_iff_eq_empty.mp
  rintro ⟨cell, hCell⟩
  have hBad : IsBadInteractionSquare P embedding threshold d
      (daiLiGridCellCenter w origin cell) (w / 2) :=
    (mem_daiLiBadGridCells_iff P embedding threshold d w origin cell).1 hCell |>.2
  have hBadLower : d ≤ 10 * regionInteractionCounter P embedding threshold
      (squareQubits embedding (daiLiGridCellCenter w origin cell) (w / 2)) := by
    simpa [IsBadInteractionSquare, IsBadInteractionRegion] using hBad
  have hRegionLe := regionInteractionCounter_mono P embedding threshold
    (Finset.subset_univ
      (squareQubits embedding (daiLiGridCellCenter w origin cell) (w / 2)))
  have hRegionLe' : regionInteractionCounter P embedding threshold
      (squareQubits embedding (daiLiGridCellCenter w origin cell) (w / 2)) ≤
        ∑ q : ι, P.daiLiInteractionCounter embedding threshold q := by
    simpa [regionInteractionCounter] using hRegionLe
  omega

/-- The exceptional component is one of the concrete pieces assembled into
the untrimmed Case-2 `B` subsystem. -/
theorem mem_daiLiDGeKExceptional_into_B
    (P : BinaryStabilizerPresentation (ι := ι) (κ := κ))
    (embedding : UnitSeparatedEmbedding2D ι) (threshold w ell : ℝ)
    (t : GridTranslation w) (q : ι)
    (hq : q ∈ daiLiDGeKExceptionalBadQubits P embedding threshold w ell t) :
    q ∈ (daiLiDGeKBSubsystem P embedding threshold w ell t).selected := by
  rw [daiLiDGeKBSubsystem, caseDGeKPieceFamily_union_selected]
  exact Finset.mem_union_left _ hq

/-- Every selected good side component is contained in the concrete Case-2
`B` subsystem. -/
theorem mem_daiLiDGeKGoodSide_into_B
    (P : BinaryStabilizerPresentation (ι := ι) (κ := κ))
    (embedding : UnitSeparatedEmbedding2D ι) (threshold w ell : ℝ)
    (t : GridTranslation w) (side : DaiLiGridSideIndex)
    (hSide : side ∈ daiLiDGeKGoodBIndices embedding w t) (q : ι)
    (hq : q ∈ daiLiGridSideGoodQubits P embedding threshold w ell (gridOrigin w t) side) :
    q ∈ (daiLiDGeKBSubsystem P embedding threshold w ell t).selected := by
  rw [daiLiDGeKBSubsystem, caseDGeKPieceFamily_union_selected]
  apply Finset.mem_union_right
  apply Finset.mem_biUnion.mpr
  exact ⟨side, hSide, hq⟩

/-- With no bad cells, the older complete cell-assignment `B` is contained in
the Case-2 `B`: its grid-side points avoid every long endpoint, while its
internal bad-rectangle family is empty. -/
theorem daiLiKGeDB_subset_daiLiDGeKB_of_no_bad
    (P : BinaryStabilizerPresentation (ι := ι) (κ := κ))
    (embedding : UnitSeparatedEmbedding2D ι) (d : ℕ) (threshold w ell : ℝ)
    (t : GridTranslation w)
    (hNoBad : daiLiBadGridCells P embedding threshold d w (gridOrigin w t) = ∅) :
    (daiLiKGeDBSubsystem P embedding d threshold w ell t
      (daiLiBadGridCells P embedding threshold d w (gridOrigin w t))
      (fun _ => [])).selected ⊆
      (daiLiDGeKBSubsystem P embedding threshold w ell t).selected := by
  intro q hq
  rcases Finset.mem_union.mp hq with hGrid | hInternal
  · change q ∈ (daiLiGridSideCandidates embedding w (gridOrigin w t)).biUnion
      (fun side => (daiLiKGeDGridSideFamily P embedding threshold w ell t
        (daiLiBadGridCells P embedding threshold d w (gridOrigin w t))
        (fun _ => []) side).selected) at hGrid
    rcases Finset.mem_biUnion.mp hGrid with ⟨side, hSide, hqSide⟩
    apply mem_daiLiDGeKGoodSide_into_B P embedding threshold w ell t side hSide q
    apply Finset.mem_sdiff.mpr
    refine ⟨(Finset.mem_sdiff.mp hqSide).1, ?_⟩
    intro hEndpoint
    exact (Finset.mem_sdiff.mp hqSide).2
      (Finset.mem_union_left _ (Finset.mem_union_right _ hEndpoint))
  · change q ∈ (daiLiKGeDInternalSideCandidates P embedding threshold d w
      (gridOrigin w t) (fun _ => [])).biUnion
        (fun side => (daiLiKGeDInternalSideFamily P embedding threshold w ell t
          (daiLiBadGridCells P embedding threshold d w (gridOrigin w t))
          (fun _ => []) side).selected) at hInternal
    rcases Finset.mem_biUnion.mp hInternal with ⟨side, hSide, _⟩
    have hBad := (mem_daiLiKGeDInternalSideCandidates_iff P embedding threshold d w
      (gridOrigin w t) (fun _ => []) side.1 side.2).1 hSide |>.1
    simpa [hNoBad] using hBad

/-- In the no-bad-cell branch, every point of the older source separator is
either in the sharper Case-2 separator or is an exceptional long endpoint
which the Case-2 construction puts into `B`. -/
theorem daiLiKGeDSeparator_subset_daiLiDGeKSeparator_union_B_of_no_bad
    (P : BinaryStabilizerPresentation (ι := ι) (κ := κ))
    (embedding : UnitSeparatedEmbedding2D ι) (d : ℕ) (threshold w ell : ℝ)
    (t : GridTranslation w)
    (hNoBad : daiLiBadGridCells P embedding threshold d w (gridOrigin w t) = ∅) :
    daiLiKGeDSeparator P embedding threshold w ell t
        (daiLiBadGridCells P embedding threshold d w (gridOrigin w t)) (fun _ => []) ⊆
      daiLiDGeKSeparator P embedding threshold w ell t ∪
        (daiLiDGeKBSubsystem P embedding threshold w ell t).selected := by
  intro q hq
  rcases Finset.mem_union.mp hq with hMain | hRectangleVertex
  · rcases Finset.mem_union.mp hMain with hVertex | hEndpoint
    · exact Finset.mem_union_left _ (Finset.mem_union_left _ hVertex)
    · by_cases hSharp : q ∈ daiLiDGeKSeparator P embedding threshold w ell t
      · exact Finset.mem_union_left _ hSharp
      · apply Finset.mem_union_right
        apply mem_daiLiDGeKExceptional_into_B P embedding threshold w ell t q
        exact Finset.mem_sdiff.mpr ⟨hEndpoint, hSharp⟩
  · simp [daiLiBadGridRectangleVertexBuffer, hNoBad] at hRectangleVertex

/-- Every physical qubit is assigned by the actual Case-2 geometry to the
sharper separator, `A`, or the complete recoverable `B`. -/
theorem daiLiDGeK_assignment
    (P : BinaryStabilizerPresentation (ι := ι) (κ := κ))
    (embedding : UnitSeparatedEmbedding2D ι) (d : ℕ) (threshold w ell : ℝ)
    (t : GridTranslation w)
    (hGlobal : 10 * (∑ q : ι, P.daiLiInteractionCounter embedding threshold q) < d)
    (hw : 0 < w) (hEll : 0 < ell) (q : ι) :
    q ∈ daiLiDGeKSeparator P embedding threshold w ell t ∨
      q ∈ (daiLiDGeKASubsystem P embedding d threshold w ell t).selected ∨
        q ∈ (daiLiDGeKBSubsystem P embedding threshold w ell t).selected := by
  have hNoBad : daiLiBadGridCells P embedding threshold d w (gridOrigin w t) = ∅ :=
    daiLiBadGridCells_eq_empty_of_small_longCount P embedding threshold w d
      (gridOrigin w t) hGlobal
  have hCellCover : q ∈ (embedding.gridOccupiedCells w (gridOrigin w t)).biUnion
      (embedding.gridCellQubits w (gridOrigin w t)) := by
    rw [embedding.gridCellQubits_cover w (gridOrigin w t)]
    exact Finset.mem_univ _
  rcases Finset.mem_biUnion.mp hCellCover with ⟨cell, hCell, hqCell⟩
  have hAssignment := daiLiKGeD_cell_assignment P embedding d threshold w ell t
    (fun _ => []) (fun _ => [])
    (by
      intro bad hBad
      have : False := by simpa [hNoBad] using hBad
      exact this.elim)
    (by
      intro bad hBad
      have : False := by simpa [hNoBad] using hBad
      exact this.elim)
    hw hEll cell hCell q hqCell
  rcases hAssignment with hSeparator | hA | hB
  · rcases Finset.mem_union.mp
      (daiLiKGeDSeparator_subset_daiLiDGeKSeparator_union_B_of_no_bad
        P embedding d threshold w ell t hNoBad hSeparator) with hSharp | hB
    · exact Or.inl hSharp
    · exact Or.inr (Or.inr hB)
  · exact Or.inr (Or.inl (by simpa [daiLiDGeKASubsystem] using hA))
  · exact Or.inr (Or.inr
      (daiLiKGeDB_subset_daiLiDGeKB_of_no_bad P embedding d threshold w ell t hNoBad hB))

/-- The actual residual of the Case-2 partition lies in the concrete
grid-vertex and bad-interaction-endpoint separator. -/
theorem daiLiDGeKResidual_subset_separator
    (P : BinaryStabilizerPresentation (ι := ι) (κ := κ))
    (embedding : UnitSeparatedEmbedding2D ι) (d : ℕ) (threshold w ell : ℝ)
    (t : GridTranslation w)
    (hGlobal : 10 * (∑ q : ι, P.daiLiInteractionCounter embedding threshold q) < d)
    (hw : 0 < w) (hEll : 0 < ell) :
    (daiLiDGeKResidualSubsystem P embedding d threshold w ell t).selected ⊆
      daiLiDGeKSeparator P embedding threshold w ell t := by
  intro q hq
  have hOutside := (Finset.mem_sdiff.mp hq).2
  have hNotA : q ∉ (daiLiDGeKASubsystem P embedding d threshold w ell t).selected := by
    intro hA
    exact hOutside (Finset.mem_union_left _ hA)
  have hNotTrimmedB :
      q ∉ (daiLiDGeKTrimmedBSubsystem P embedding d threshold w ell t).selected := by
    intro hB
    exact hOutside (Finset.mem_union_right _ hB)
  rcases daiLiDGeK_assignment P embedding d threshold w ell t hGlobal hw hEll q with
      hSeparator | hA | hB
  · exact hSeparator
  · exact (hNotA hA).elim
  · exfalso
    apply hNotTrimmedB
    exact Finset.mem_sdiff.mpr ⟨hB, hNotA⟩

/-- The actual residual cardinality is bounded by the computed Case-2
separator, with no partition or cut supplied by a caller. -/
theorem card_daiLiDGeKResidual_le_separator
    (P : BinaryStabilizerPresentation (ι := ι) (κ := κ))
    (embedding : UnitSeparatedEmbedding2D ι) (d : ℕ) (threshold w ell : ℝ)
    (t : GridTranslation w)
    (hGlobal : 10 * (∑ q : ι, P.daiLiInteractionCounter embedding threshold q) < d)
    (hw : 0 < w) (hEll : 0 < ell) :
    (daiLiDGeKResidualSubsystem P embedding d threshold w ell t).selected.card ≤
      (daiLiDGeKSeparator P embedding threshold w ell t).card :=
  Finset.card_le_card
    (daiLiDGeKResidual_subset_separator P embedding d threshold w ell t hGlobal hw hEll)

/-- A strict real-valued separator bound transfers to the actual residual. -/
theorem card_daiLiDGeKResidual_lt_of_separator_lt
    (P : BinaryStabilizerPresentation (ι := ι) (κ := κ))
    (embedding : UnitSeparatedEmbedding2D ι) (d : ℕ) (threshold w ell k : ℝ)
    (t : GridTranslation w)
    (hGlobal : 10 * (∑ q : ι, P.daiLiInteractionCounter embedding threshold q) < d)
    (hw : 0 < w) (hEll : 0 < ell)
    (hSeparator : ((daiLiDGeKSeparator P embedding threshold w ell t).card : ℝ) < k) :
    ((daiLiDGeKResidualSubsystem P embedding d threshold w ell t).selected.card : ℝ) < k := by
  exact lt_of_le_of_lt (by
    exact_mod_cast card_daiLiDGeKResidual_le_separator P embedding d threshold w ell t
      hGlobal hw hEll) hSeparator

/--
The internal Case-2 `A` family has a concrete CPTP recovery.  The only
quantitative hypotheses are the finite clipped-growth/packing checks needed
by the already proved cell recovery; no `A` region, rectangle list, or
recovery channel is accepted as an input.
-/
theorem exists_erasureRecovery_daiLiDGeKA
    (P : BinaryStabilizerPresentation (ι := ι) (κ := κ))
    (embedding : UnitSeparatedEmbedding2D ι) (d : ℕ)
    (hDistance : StabilizerCode.SemanticStabilizerDistance P.code d)
    (threshold w ell : ℝ) (t : GridTranslation w)
    (hGlobal : 10 * (∑ q : ι, P.daiLiInteractionCounter embedding threshold q) < d)
    (hThreshold : 1 ≤ threshold) (hWidthNat : 1 ≤ w) (hEllNat : 1 ≤ ell)
    (hEll : 0 < ell) (hWidth : 0 < w) (hThresholdEll : threshold ≤ ell)
    (baseHorizontalRadius baseVerticalRadius : ℝ) (steps : ℕ)
    (hBaseHorizontal : baseHorizontalRadius ≤ w / 2)
    (hBaseVerticalGood : baseVerticalRadius ≤ w / 2)
    (hBaseVerticalBad : baseVerticalRadius ≤ 5 * ell / 2)
    (hBaseHorizontalDiameter : 1 ≤ 2 * baseHorizontalRadius)
    (hBaseVerticalDiameter : 1 ≤ 2 * baseVerticalRadius)
    (hReachHorizontal : w / 2 ≤ baseHorizontalRadius + steps * threshold)
    (hReachVerticalGood : w / 2 ≤ baseVerticalRadius + steps * threshold)
    (hReachVerticalBad : w / 2 ≤ baseVerticalRadius + steps * threshold)
    (hGoodBaseCard : ∀ cell, cell ∈ embedding.gridOccupiedCells w (gridOrigin w t) →
      (centeredRectangleQubits embedding (daiLiGridCellCenter w (gridOrigin w t) cell)
        baseHorizontalRadius baseVerticalRadius).card < d)
    (hBoundaryBudget :
      48 * (w / 2 + w / 2 + threshold) * threshold + (d : ℝ) / 10 < d)
    (hShortPackingScale : 60 * w * ell < d) :
    ∃ recovery : QuantumChannel
        (daiLiDGeKASubsystem P embedding d threshold w ell t).complementSystem
        (Qubit.QubitRegister ι),
      Correctable (Qubit.QubitRegister ι)
        (daiLiDGeKASubsystem P embedding d threshold w ell t).complementSystem
        P.semanticCode
        (daiLiDGeKASubsystem P embedding d threshold w ell t).erasureChannelFromRegister
        recovery := by
  have hNoBad : daiLiBadGridCells P embedding threshold d w (gridOrigin w t) = ∅ :=
    daiLiBadGridCells_eq_empty_of_small_longCount P embedding threshold w d
      (gridOrigin w t) hGlobal
  exact
    (exists_erasureRecovery_daiLiKGeDA P embedding d hDistance threshold w ell t
      (fun _ => []) (fun _ => [])
      (by
        intro cell hCell
        have hFalse : False := by simpa [hNoBad] using hCell
        exact hFalse.elim)
      (by
        intro cell hCell
        have hFalse : False := by simpa [hNoBad] using hCell
        exact hFalse.elim)
      hThreshold hWidthNat hEllNat hEll hWidth hThresholdEll
      baseHorizontalRadius baseVerticalRadius steps hBaseHorizontal hBaseVerticalGood
      hBaseVerticalBad hBaseHorizontalDiameter hBaseVerticalDiameter hReachHorizontal
      hReachVerticalGood hReachVerticalBad
      (by
        intro cell hCandidate
        apply hGoodBaseCard cell
        exact (mem_daiLiKGeDRegionCandidates_good_iff P embedding threshold d w
          (gridOrigin w t) (fun _ => []) cell).1 hCandidate |>.1)
      (by
        intro cell slot hCandidate
        have hBad := (mem_daiLiKGeDRegionCandidates_bad_iff P embedding threshold d w
          (gridOrigin w t) (fun _ => []) cell slot).1 hCandidate |>.1
        have hFalse : False := by simpa [hNoBad] using hBad
        exact hFalse.elim)
      hBoundaryBudget hShortPackingScale)

/-- A fixed Case-2 translation supplies the exact three-region interface of
#368.  Both recoveries and every partition fact are constructed here, so a
downstream composition theorem need only discharge the source's numerical
scale hypotheses. -/
theorem daiLiDGeK_encodedQubits_le_separator_card
    (P : BinaryStabilizerPresentation (ι := ι) (κ := κ))
    (embedding : UnitSeparatedEmbedding2D ι) (d : ℕ)
    (hDistance : StabilizerCode.SemanticStabilizerDistance P.code d)
    (threshold w ell : ℝ) (t : GridTranslation w)
    (hGlobal : 10 * (∑ q : ι, P.daiLiInteractionCounter embedding threshold q) < d)
    (hThreshold : 1 ≤ threshold) (hWidthNat : 1 ≤ w) (hEllNat : 1 ≤ ell)
    (hEll : 0 < ell) (hWidth : 0 < w) (hScale : 4 * ell ≤ w)
    (hThresholdEll : threshold ≤ ell)
    (hEdge : 1 ≤ 2 * ell) (hLongStrip : 1 ≤ w - 4 * ell)
    (hSmallStrip : 12 * ell * (w - 4 * ell) < d)
    (baseHorizontalRadius baseVerticalRadius : ℝ) (steps : ℕ)
    (hBaseHorizontal : baseHorizontalRadius ≤ w / 2)
    (hBaseVerticalGood : baseVerticalRadius ≤ w / 2)
    (hBaseVerticalBad : baseVerticalRadius ≤ 5 * ell / 2)
    (hBaseHorizontalDiameter : 1 ≤ 2 * baseHorizontalRadius)
    (hBaseVerticalDiameter : 1 ≤ 2 * baseVerticalRadius)
    (hReachHorizontal : w / 2 ≤ baseHorizontalRadius + steps * threshold)
    (hReachVerticalGood : w / 2 ≤ baseVerticalRadius + steps * threshold)
    (hReachVerticalBad : w / 2 ≤ baseVerticalRadius + steps * threshold)
    (hGoodBaseCard : ∀ cell, cell ∈ embedding.gridOccupiedCells w (gridOrigin w t) →
      (centeredRectangleQubits embedding (daiLiGridCellCenter w (gridOrigin w t) cell)
        baseHorizontalRadius baseVerticalRadius).card < d)
    (hBoundaryBudget :
      48 * (w / 2 + w / 2 + threshold) * threshold + (d : ℝ) / 10 < d)
    (hShortPackingScale : 60 * w * ell < d) :
    P.encodedQubits ≤ (daiLiDGeKSeparator P embedding threshold w ell t).card := by
  have hLongCount : 2 * P.longInteractionCount embedding threshold < d := by
    rw [← P.sum_daiLiInteractionCounter_eq_two_mul_longInteractionCount embedding threshold]
    omega
  obtain ⟨recoveryA, hRecoveryA⟩ := exists_erasureRecovery_daiLiDGeKA P embedding d
    hDistance threshold w ell t hGlobal hThreshold hWidthNat hEllNat hEll hWidth
    hThresholdEll baseHorizontalRadius baseVerticalRadius steps hBaseHorizontal
    hBaseVerticalGood hBaseVerticalBad hBaseHorizontalDiameter hBaseVerticalDiameter
    hReachHorizontal hReachVerticalGood hReachVerticalBad hGoodBaseCard hBoundaryBudget
    hShortPackingScale
  obtain ⟨recoveryB, hRecoveryB⟩ := exists_erasureRecovery_daiLiDGeKTrimmedB P embedding d
    hDistance threshold w ell t hEll hScale hThresholdEll hEdge hLongStrip hSmallStrip
    hLongCount
  have hPairwise := daiLiDGeK_partition_pairwise P embedding d threshold w ell t
  have hDimension : P.encodedQubits ≤
      (daiLiDGeKResidualSubsystem P embedding d threshold w ell t).selected.card :=
    two_correctable_regions_encodedQubits_le_separator_card P
      (daiLiDGeKASubsystem P embedding d threshold w ell t)
      (daiLiDGeKTrimmedBSubsystem P embedding d threshold w ell t)
      (daiLiDGeKResidualSubsystem P embedding d threshold w ell t)
      hPairwise.1 hPairwise.2.1 hPairwise.2.2
      (daiLiDGeK_partition_cover P embedding d threshold w ell t)
      recoveryA hRecoveryA recoveryB hRecoveryB
  exact hDimension.trans
    (card_daiLiDGeKResidual_le_separator P embedding d threshold w ell t hGlobal hWidth hEll)

/--
The actual Case-2 separator is bounded by the translation's vertex event plus
twice its edge-incidence event.  No global ordered-pair or supplied count
appears in this statement.
-/
theorem card_daiLiDGeKSeparator_le_badCounts
    (P : BinaryStabilizerPresentation (ι := ι) (κ := κ))
    (embedding : UnitSeparatedEmbedding2D ι) (threshold w ell : ℝ)
    (t : GridTranslation w) :
    ((daiLiDGeKSeparator P embedding threshold w ell t).card : ℝ) ≤
      (vertexBadCount w (2 * ell) embedding.point t : ℝ) +
        2 * (edgeBadCount w (2 * ell)
          (P.daiLiLongIncidencePoint embedding threshold) t : ℝ) := by
  classical
  let vertices := gridVertexBufferQubits embedding w ell t
  let crossing := daiLiDGeKCrossingEndpoints P embedding threshold w ell t
  have hUnion : (vertices ∪ crossing).card ≤ vertices.card + crossing.card :=
    Finset.card_union_le _ _
  have hCrossing : crossing.card ≤ 2 * edgeBadCount w (2 * ell)
      (P.daiLiLongIncidencePoint embedding threshold) t := by
    simpa [crossing] using card_daiLiDGeKCrossingEndpoints_le_two_mul_edgeBadCount
      P embedding threshold w ell t
  change ((vertices ∪ crossing).card : ℝ) ≤ _
  have hUnionReal : ((vertices ∪ crossing).card : ℝ) ≤
      (vertices.card : ℝ) + (crossing.card : ℝ) := by
    exact_mod_cast hUnion
  have hVertex : (vertices.card : ℝ) =
      (vertexBadCount w (2 * ell) embedding.point t : ℝ) := by
    rfl
  have hCrossingReal : (crossing.card : ℝ) ≤
      2 * (edgeBadCount w (2 * ell)
        (P.daiLiLongIncidencePoint embedding threshold) t : ℝ) := by
    exact_mod_cast hCrossing
  rw [hVertex] at hUnionReal
  linarith

/--
One translated grid simultaneously controls the concrete Case-2 separator.
The `64` is the formalization's explicit two-endpoint charge: #385 bounds
directed edge incidences by `32 * ell / w * N`, and `C` keeps both endpoints.
Here `N` is still the cardinality of distinct unordered long interactions.
-/
theorem exists_daiLiDGeKSeparator_card_bound
    (P : BinaryStabilizerPresentation (ι := ι) (κ := κ))
    (embedding : UnitSeparatedEmbedding2D ι) (threshold w ell : ℝ)
    (hEll : 0 < ell) (hScale : 4 * ell ≤ w) :
    ∃ t : GridTranslation w,
      ((daiLiDGeKSeparator P embedding threshold w ell t).card : ℝ) ≤
        (32 * ell ^ 2 / w ^ 2) * Fintype.card ι +
          64 * ell / w * (P.longInteractionCount embedding threshold : ℝ) := by
  obtain ⟨t, hVertex, hEdge⟩ :=
    P.exists_good_translation_for_qubits_and_longIncidences embedding threshold w ell
      hEll hScale
  refine ⟨t, (card_daiLiDGeKSeparator_le_badCounts P embedding threshold w ell t).trans ?_⟩
  calc
    (vertexBadCount w (2 * ell) embedding.point t : ℝ) +
          2 * (edgeBadCount w (2 * ell)
            (P.daiLiLongIncidencePoint embedding threshold) t : ℝ) ≤
        (32 * ell ^ 2 / w ^ 2) * Fintype.card ι +
          2 * ((16 * ell / w) *
            (2 * (P.longInteractionCount embedding threshold : ℝ))) := by
      gcongr
    _ = (32 * ell ^ 2 / w ^ 2) * Fintype.card ι +
          64 * ell / w * (P.longInteractionCount embedding threshold : ℝ) := by
      ring

/--
The exact DL24 fourth-root substitution makes the Case-2 separator smaller
than `k`.  `d <= sqrt (k * n)` is the source's low-distance domain, written
with the principal nonnegative square root; `N` remains the actual unordered
long-interaction cardinality.
-/
theorem exists_daiLiDGeKSeparator_card_lt_k_of_principal_scale
    (P : BinaryStabilizerPresentation (ι := ι) (κ := κ))
    (embedding : UnitSeparatedEmbedding2D ι) (threshold w ell k d : ℝ)
    (hk : 0 < k) (hd : 0 < d) (_hDGeK : k ≤ d)
    (hn : 0 < (Fintype.card ι : ℝ))
    (hDistanceDomain : d ≤ Real.sqrt (k * Fintype.card ι))
    (hScale : ell = daiLiPrincipalFourthRootScale k d (Fintype.card ι))
    (hWidth : w = daiLiDGeKGridWidth d ell)
    (hLongCount : (P.longInteractionCount embedding threshold : ℝ) ≤ d / 100)
    (hGridScale : 4 * ell ≤ w) :
    ∃ t : GridTranslation w,
      ((daiLiDGeKSeparator P embedding threshold w ell t).card : ℝ) < k := by
  have hRatioPos : 0 < k * d ^ 2 / (Fintype.card ι : ℝ) := by
    positivity
  have hEll : 0 < ell := by
    rw [hScale, daiLiPrincipalFourthRootScale]
    exact mul_pos (by norm_num) (Real.rpow_pos_of_pos hRatioPos _)
  have hDGeKSq : d ^ 2 ≤ k * (Fintype.card ι : ℝ) := by
    have hKn : 0 ≤ k * (Fintype.card ι : ℝ) := by positivity
    have hSqrtSq : (Real.sqrt (k * (Fintype.card ι : ℝ))) ^ 2 =
        k * (Fintype.card ι : ℝ) := Real.sq_sqrt hKn
    nlinarith
  have hScalePow : ell ^ 4 = (1 / 100 : ℝ) ^ 4 *
      (k * d ^ 2 / (Fintype.card ι : ℝ)) := by
    rw [hScale]
    exact daiLiPrincipalFourthRootScale_pow_four k d (Fintype.card ι)
      hk.le hn
  have hVertexBudget :
      (32 * ell ^ 2 / w ^ 2) * (Fintype.card ι : ℝ) ≤ (32 / 10000 : ℝ) * k := by
    have hDne : d ≠ 0 := ne_of_gt hd
    have hEllNe : ell ≠ 0 := ne_of_gt hEll
    calc
      (32 * ell ^ 2 / w ^ 2) * (Fintype.card ι : ℝ) =
          32 * 100 ^ 2 * ell ^ 4 * (Fintype.card ι : ℝ) / d ^ 2 := by
        rw [hWidth, daiLiDGeKGridWidth]
        field_simp <;> ring
      _ ≤ (32 / 10000 : ℝ) * k := by
        rw [hScalePow]
        field_simp <;> ring <;> norm_num
  have hRatioLe : k * d ^ 2 / (Fintype.card ι : ℝ) ≤ k ^ 2 := by
    apply (div_le_iff₀ hn).2
    have hMul := mul_le_mul_of_nonneg_left hDGeKSq hk.le
    nlinarith
  have hEllPowLe : ell ^ 4 ≤ (k / 10000 : ℝ) ^ 2 := by
    calc
      ell ^ 4 = (1 / 100 : ℝ) ^ 4 *
          (k * d ^ 2 / (Fintype.card ι : ℝ)) := hScalePow
      _ ≤ (1 / 100 : ℝ) ^ 4 * k ^ 2 := by gcongr
      _ = (k / 10000 : ℝ) ^ 2 := by ring
  have hEllSq : ell ^ 2 ≤ k / 10000 := by
    have hLeft : 0 ≤ ell ^ 2 := sq_nonneg ell
    have hRight : 0 ≤ k / 10000 := by positivity
    nlinarith [sq_nonneg (ell ^ 2 + k / 10000)]
  have hEndpointBudget :
      64 * ell / w * (P.longInteractionCount embedding threshold : ℝ) ≤
        (64 / 10000 : ℝ) * k := by
    have hDne : d ≠ 0 := ne_of_gt hd
    have hEllNe : ell ≠ 0 := ne_of_gt hEll
    calc
      64 * ell / w * (P.longInteractionCount embedding threshold : ℝ) =
          (6400 * ell ^ 2 / d) * (P.longInteractionCount embedding threshold : ℝ) := by
        rw [hWidth, daiLiDGeKGridWidth]
        field_simp <;> ring
      _ ≤ (6400 * ell ^ 2 / d) * (d / 100) := by
        apply mul_le_mul_of_nonneg_left hLongCount
        positivity
      _ = 64 * ell ^ 2 := by
        field_simp <;> ring
      _ ≤ (64 / 10000 : ℝ) * k := by
        calc
          64 * ell ^ 2 ≤ 64 * (k / 10000) := by
            exact mul_le_mul_of_nonneg_left hEllSq (by norm_num)
          _ = (64 / 10000 : ℝ) * k := by ring
  obtain ⟨t, hSeparator⟩ :=
    exists_daiLiDGeKSeparator_card_bound P embedding threshold w ell hEll hGridScale
  refine ⟨t, lt_of_le_of_lt (hSeparator.trans (add_le_add hVertexBudget hEndpointBudget)) ?_⟩
  nlinarith

/--
Executable Case-2 handoff for #387.  A single averaged translation produces
the exact B/B'/C routing, an empty bad-square family, a concrete CPTP
recovery for each of `A` and `B`, and the distinct-unordered interaction
separator bound.  The fourth-root scale and width are named above; a later
count-composition node discharges their remaining numerical substitution.
-/
theorem exists_daiLiDGeK_realization
    (P : BinaryStabilizerPresentation (ι := ι) (κ := κ))
    (embedding : UnitSeparatedEmbedding2D ι) (d : ℕ)
    (hDistance : StabilizerCode.SemanticStabilizerDistance P.code d)
    (threshold w ell : ℝ)
    (hGlobal : 10 * (∑ q : ι, P.daiLiInteractionCounter embedding threshold q) < d)
    (hThreshold : 1 ≤ threshold) (hWidthNat : 1 ≤ w) (hEllNat : 1 ≤ ell)
    (hEll : 0 < ell) (hScale : 4 * ell ≤ w) (hThresholdEll : threshold ≤ ell)
    (hEdge : 1 ≤ 2 * ell) (hLongStrip : 1 ≤ w - 4 * ell)
    (hSmallStrip : 12 * ell * (w - 4 * ell) < d)
    (baseHorizontalRadius baseVerticalRadius : ℝ) (steps : ℕ)
    (hBaseHorizontal : baseHorizontalRadius ≤ w / 2)
    (hBaseVerticalGood : baseVerticalRadius ≤ w / 2)
    (hBaseVerticalBad : baseVerticalRadius ≤ 5 * ell / 2)
    (hBaseHorizontalDiameter : 1 ≤ 2 * baseHorizontalRadius)
    (hBaseVerticalDiameter : 1 ≤ 2 * baseVerticalRadius)
    (hReachHorizontal : w / 2 ≤ baseHorizontalRadius + steps * threshold)
    (hReachVerticalGood : w / 2 ≤ baseVerticalRadius + steps * threshold)
    (hReachVerticalBad : w / 2 ≤ baseVerticalRadius + steps * threshold)
    (hGoodBaseCard : ∀ (t : GridTranslation w) cell,
      cell ∈ embedding.gridOccupiedCells w (gridOrigin w t) →
        (centeredRectangleQubits embedding (daiLiGridCellCenter w (gridOrigin w t) cell)
          baseHorizontalRadius baseVerticalRadius).card < d)
    (hBoundaryBudget :
      48 * (w / 2 + w / 2 + threshold) * threshold + (d : ℝ) / 10 < d)
    (hShortPackingScale : 60 * w * ell < d) :
    ∃ t : GridTranslation w,
      ((daiLiDGeKSeparator P embedding threshold w ell t).card : ℝ) ≤
          (32 * ell ^ 2 / w ^ 2) * Fintype.card ι +
            64 * ell / w * (P.longInteractionCount embedding threshold : ℝ) ∧
      daiLiBadGridCells P embedding threshold d w (gridOrigin w t) = ∅ ∧
      (∃ recovery : QuantumChannel
          (daiLiDGeKASubsystem P embedding d threshold w ell t).complementSystem
          (Qubit.QubitRegister ι),
        Correctable (Qubit.QubitRegister ι)
          (daiLiDGeKASubsystem P embedding d threshold w ell t).complementSystem
          P.semanticCode
          (daiLiDGeKASubsystem P embedding d threshold w ell t).erasureChannelFromRegister
          recovery) ∧
      ∃ recovery : QuantumChannel
          (daiLiDGeKBSubsystem P embedding threshold w ell t).complementSystem
          (Qubit.QubitRegister ι),
        Correctable (Qubit.QubitRegister ι)
          (daiLiDGeKBSubsystem P embedding threshold w ell t).complementSystem
          P.semanticCode
          (daiLiDGeKBSubsystem P embedding threshold w ell t).erasureChannelFromRegister
          recovery := by
  obtain ⟨t, hSeparator⟩ :=
    exists_daiLiDGeKSeparator_card_bound P embedding threshold w ell hEll hScale
  have hLongCount : 2 * P.longInteractionCount embedding threshold < d := by
    rw [← P.sum_daiLiInteractionCounter_eq_two_mul_longInteractionCount embedding threshold]
    omega
  have hNoBad := daiLiBadGridCells_eq_empty_of_small_longCount P embedding threshold w d
    (gridOrigin w t) hGlobal
  refine ⟨t, hSeparator, hNoBad, ?_, ?_⟩
  · apply exists_erasureRecovery_daiLiDGeKA P embedding d hDistance threshold w ell t
      hGlobal hThreshold hWidthNat hEllNat hEll (by linarith) hThresholdEll
      baseHorizontalRadius baseVerticalRadius steps hBaseHorizontal hBaseVerticalGood
      hBaseVerticalBad hBaseHorizontalDiameter hBaseVerticalDiameter hReachHorizontal
      hReachVerticalGood hReachVerticalBad
    intro cell hCell
    exact hGoodBaseCard t cell (by simpa using hCell)
    exact hBoundaryBudget
    exact hShortPackingScale
  · exact exists_erasureRecovery_daiLiDGeKB P embedding d hDistance threshold w ell t
      hEll hScale hThresholdEll hEdge hLongStrip hSmallStrip hLongCount

/--
The source-scale Case-2 handoff uses one and the same selected translation for
the strict separator bound and for both CPTP recoveries.  It is the complete
internal `d >= k` B/B'/C result consumed by the subsequent dimension node.
-/
theorem exists_daiLiDGeK_source_case
    (P : BinaryStabilizerPresentation (ι := ι) (κ := κ))
    (embedding : UnitSeparatedEmbedding2D ι) (d : ℕ)
    (hDistance : StabilizerCode.SemanticStabilizerDistance P.code d)
    (threshold w ell k : ℝ)
    (hk : 0 < k) (hd : 0 < (d : ℝ)) (_hDGeK : k ≤ d)
    (hn : 0 < (Fintype.card ι : ℝ))
    (hDistanceDomain : (d : ℝ) ≤ Real.sqrt (k * Fintype.card ι))
    (hScale : ell = daiLiPrincipalFourthRootScale k d (Fintype.card ι))
    (hWidth : w = daiLiDGeKGridWidth d ell)
    (hLongCount : (P.longInteractionCount embedding threshold : ℝ) ≤ (d : ℝ) / 100)
    (hGridScale : 4 * ell ≤ w)
    (hThreshold : 1 ≤ threshold) (hWidthNat : 1 ≤ w) (hEllNat : 1 ≤ ell)
    (hThresholdEll : threshold ≤ ell)
    (hEdge : 1 ≤ 2 * ell) (hLongStrip : 1 ≤ w - 4 * ell)
    (hSmallStrip : 12 * ell * (w - 4 * ell) < d)
    (baseHorizontalRadius baseVerticalRadius : ℝ) (steps : ℕ)
    (hBaseHorizontal : baseHorizontalRadius ≤ w / 2)
    (hBaseVerticalGood : baseVerticalRadius ≤ w / 2)
    (hBaseVerticalBad : baseVerticalRadius ≤ 5 * ell / 2)
    (hBaseHorizontalDiameter : 1 ≤ 2 * baseHorizontalRadius)
    (hBaseVerticalDiameter : 1 ≤ 2 * baseVerticalRadius)
    (hReachHorizontal : w / 2 ≤ baseHorizontalRadius + steps * threshold)
    (hReachVerticalGood : w / 2 ≤ baseVerticalRadius + steps * threshold)
    (hReachVerticalBad : w / 2 ≤ baseVerticalRadius + steps * threshold)
    (hGoodBaseCard : ∀ (t : GridTranslation w) cell,
      cell ∈ embedding.gridOccupiedCells w (gridOrigin w t) →
        (centeredRectangleQubits embedding (daiLiGridCellCenter w (gridOrigin w t) cell)
          baseHorizontalRadius baseVerticalRadius).card < d)
    (hBoundaryBudget :
      48 * (w / 2 + w / 2 + threshold) * threshold + (d : ℝ) / 10 < d)
    (hShortPackingScale : 60 * w * ell < d) :
    ∃ t : GridTranslation w,
      ((daiLiDGeKSeparator P embedding threshold w ell t).card : ℝ) < k ∧
      daiLiBadGridCells P embedding threshold d w (gridOrigin w t) = ∅ ∧
      (∃ recovery : QuantumChannel
          (daiLiDGeKASubsystem P embedding d threshold w ell t).complementSystem
          (Qubit.QubitRegister ι),
        Correctable (Qubit.QubitRegister ι)
          (daiLiDGeKASubsystem P embedding d threshold w ell t).complementSystem
          P.semanticCode
          (daiLiDGeKASubsystem P embedding d threshold w ell t).erasureChannelFromRegister
          recovery) ∧
      ∃ recovery : QuantumChannel
          (daiLiDGeKBSubsystem P embedding threshold w ell t).complementSystem
          (Qubit.QubitRegister ι),
        Correctable (Qubit.QubitRegister ι)
          (daiLiDGeKBSubsystem P embedding threshold w ell t).complementSystem
          P.semanticCode
          (daiLiDGeKBSubsystem P embedding threshold w ell t).erasureChannelFromRegister
          recovery := by
  obtain ⟨t, hSeparator⟩ :=
    exists_daiLiDGeKSeparator_card_lt_k_of_principal_scale P embedding threshold w ell k d
      hk hd _hDGeK hn hDistanceDomain hScale hWidth hLongCount hGridScale
  have hTotal := P.sum_daiLiInteractionCounter_eq_two_mul_longInteractionCount
    embedding threshold
  have hTotalReal : ((∑ q : ι, P.daiLiInteractionCounter embedding threshold q : Nat) : ℝ) =
      2 * (P.longInteractionCount embedding threshold : ℝ) := by
    exact_mod_cast hTotal
  have hGlobalReal : 10 *
      ((∑ q : ι, P.daiLiInteractionCounter embedding threshold q : Nat) : ℝ) < d := by
    rw [hTotalReal]
    nlinarith
  have hGlobal : 10 * (∑ q : ι, P.daiLiInteractionCounter embedding threshold q) < d := by
    exact_mod_cast hGlobalReal
  have hLongCountNat : 2 * P.longInteractionCount embedding threshold < d := by
    have hLongCountReal : 2 * (P.longInteractionCount embedding threshold : ℝ) < d := by
      nlinarith
    exact_mod_cast hLongCountReal
  have hEll : 0 < ell := by
    rw [hScale, daiLiPrincipalFourthRootScale]
    apply mul_pos (by norm_num)
    apply Real.rpow_pos_of_pos
    positivity
  have hNoBad := daiLiBadGridCells_eq_empty_of_small_longCount P embedding threshold w d
    (gridOrigin w t) hGlobal
  refine ⟨t, hSeparator, hNoBad, ?_, ?_⟩
  · apply exists_erasureRecovery_daiLiDGeKA P embedding d hDistance threshold w ell t
      hGlobal hThreshold hWidthNat hEllNat hEll (by linarith) hThresholdEll
      baseHorizontalRadius baseVerticalRadius steps hBaseHorizontal hBaseVerticalGood
      hBaseVerticalBad hBaseHorizontalDiameter hBaseVerticalDiameter hReachHorizontal
      hReachVerticalGood hReachVerticalBad
    · intro cell hCell
      exact hGoodBaseCard t cell hCell
    · exact hBoundaryBudget
    · exact hShortPackingScale
  · exact exists_erasureRecovery_daiLiDGeKB P embedding d hDistance threshold w ell t
      hEll hGridScale hThresholdEll hEdge hLongStrip hSmallStrip hLongCountNat

/-- Final same-translation package for #387.  The chosen translation carries
the strict residual bound, the complete #368 partition, and both concrete CPTP
recoveries.  No geometric set, cover, disjointness fact, or recovery is an
input to this theorem. -/
theorem exists_daiLiDGeK_two_correctable_partition
    (P : BinaryStabilizerPresentation (ι := ι) (κ := κ))
    (embedding : UnitSeparatedEmbedding2D ι) (d : ℕ)
    (hDistance : StabilizerCode.SemanticStabilizerDistance P.code d)
    (threshold w ell k : ℝ)
    (hk : 0 < k) (hd : 0 < (d : ℝ)) (hDGeK : k ≤ d)
    (hn : 0 < (Fintype.card ι : ℝ))
    (hDistanceDomain : (d : ℝ) ≤ Real.sqrt (k * Fintype.card ι))
    (hScale : ell = daiLiPrincipalFourthRootScale k d (Fintype.card ι))
    (hWidth : w = daiLiDGeKGridWidth d ell)
    (hLongCount : (P.longInteractionCount embedding threshold : ℝ) ≤ (d : ℝ) / 100)
    (hGridScale : 4 * ell ≤ w)
    (hThreshold : 1 ≤ threshold) (hWidthNat : 1 ≤ w) (hEllNat : 1 ≤ ell)
    (hThresholdEll : threshold ≤ ell)
    (hEdge : 1 ≤ 2 * ell) (hLongStrip : 1 ≤ w - 4 * ell)
    (hSmallStrip : 12 * ell * (w - 4 * ell) < d)
    (baseHorizontalRadius baseVerticalRadius : ℝ) (steps : ℕ)
    (hBaseHorizontal : baseHorizontalRadius ≤ w / 2)
    (hBaseVerticalGood : baseVerticalRadius ≤ w / 2)
    (hBaseVerticalBad : baseVerticalRadius ≤ 5 * ell / 2)
    (hBaseHorizontalDiameter : 1 ≤ 2 * baseHorizontalRadius)
    (hBaseVerticalDiameter : 1 ≤ 2 * baseVerticalRadius)
    (hReachHorizontal : w / 2 ≤ baseHorizontalRadius + steps * threshold)
    (hReachVerticalGood : w / 2 ≤ baseVerticalRadius + steps * threshold)
    (hReachVerticalBad : w / 2 ≤ baseVerticalRadius + steps * threshold)
    (hGoodBaseCard : ∀ (t : GridTranslation w) cell,
      cell ∈ embedding.gridOccupiedCells w (gridOrigin w t) →
        (centeredRectangleQubits embedding (daiLiGridCellCenter w (gridOrigin w t) cell)
          baseHorizontalRadius baseVerticalRadius).card < d)
    (hBoundaryBudget :
      48 * (w / 2 + w / 2 + threshold) * threshold + (d : ℝ) / 10 < d)
    (hShortPackingScale : 60 * w * ell < d) :
    ∃ t : GridTranslation w,
      ((daiLiDGeKResidualSubsystem P embedding d threshold w ell t).selected.card : ℝ) < k ∧
      (daiLiDGeKResidualSubsystem P embedding d threshold w ell t).selected ⊆
        daiLiDGeKSeparator P embedding threshold w ell t ∧
      Disjoint (daiLiDGeKASubsystem P embedding d threshold w ell t).selected
        (daiLiDGeKTrimmedBSubsystem P embedding d threshold w ell t).selected ∧
      Disjoint (daiLiDGeKASubsystem P embedding d threshold w ell t).selected
        (daiLiDGeKResidualSubsystem P embedding d threshold w ell t).selected ∧
      Disjoint (daiLiDGeKTrimmedBSubsystem P embedding d threshold w ell t).selected
        (daiLiDGeKResidualSubsystem P embedding d threshold w ell t).selected ∧
      (daiLiDGeKASubsystem P embedding d threshold w ell t).selected ∪
          (daiLiDGeKTrimmedBSubsystem P embedding d threshold w ell t).selected ∪
            (daiLiDGeKResidualSubsystem P embedding d threshold w ell t).selected = Finset.univ ∧
      (∃ recoveryA : QuantumChannel
          (daiLiDGeKASubsystem P embedding d threshold w ell t).complementSystem
          (Qubit.QubitRegister ι),
        Correctable (Qubit.QubitRegister ι)
          (daiLiDGeKASubsystem P embedding d threshold w ell t).complementSystem
          P.semanticCode
          (daiLiDGeKASubsystem P embedding d threshold w ell t).erasureChannelFromRegister
          recoveryA) ∧
      ∃ recoveryB : QuantumChannel
          (daiLiDGeKTrimmedBSubsystem P embedding d threshold w ell t).complementSystem
          (Qubit.QubitRegister ι),
        Correctable (Qubit.QubitRegister ι)
          (daiLiDGeKTrimmedBSubsystem P embedding d threshold w ell t).complementSystem
          P.semanticCode
          (daiLiDGeKTrimmedBSubsystem P embedding d threshold w ell t).erasureChannelFromRegister
          recoveryB := by
  obtain ⟨t, hSeparator, _hNoBad, hRecoveryA, hRecoveryB⟩ :=
    exists_daiLiDGeK_source_case P embedding d hDistance threshold w ell k hk hd hDGeK hn
      hDistanceDomain hScale hWidth hLongCount hGridScale hThreshold hWidthNat hEllNat
      hThresholdEll hEdge hLongStrip hSmallStrip baseHorizontalRadius baseVerticalRadius steps
      hBaseHorizontal hBaseVerticalGood hBaseVerticalBad hBaseHorizontalDiameter
      hBaseVerticalDiameter hReachHorizontal hReachVerticalGood hReachVerticalBad hGoodBaseCard
      hBoundaryBudget hShortPackingScale
  have hTotal := P.sum_daiLiInteractionCounter_eq_two_mul_longInteractionCount
    embedding threshold
  have hTotalReal : ((∑ q : ι, P.daiLiInteractionCounter embedding threshold q : Nat) : ℝ) =
      2 * (P.longInteractionCount embedding threshold : ℝ) := by
    exact_mod_cast hTotal
  have hGlobalReal : 10 *
      ((∑ q : ι, P.daiLiInteractionCounter embedding threshold q : Nat) : ℝ) < d := by
    rw [hTotalReal]
    nlinarith
  have hGlobal : 10 * (∑ q : ι, P.daiLiInteractionCounter embedding threshold q) < d := by
    exact_mod_cast hGlobalReal
  have hEll : 0 < ell := by
    rw [hScale, daiLiPrincipalFourthRootScale]
    apply mul_pos (by norm_num)
    apply Real.rpow_pos_of_pos
    positivity
  have hWidthPos : 0 < w := by linarith
  have hPairwise := daiLiDGeK_partition_pairwise P embedding d threshold w ell t
  have hResidualSubset := daiLiDGeKResidual_subset_separator P embedding d threshold w ell t
    hGlobal hWidthPos hEll
  have hResidualLt := card_daiLiDGeKResidual_lt_of_separator_lt P embedding d threshold w ell k
    t hGlobal hWidthPos hEll hSeparator
  have hTrimmedRecovery := exists_erasureRecovery_of_finiteSubsystem_subset
    (daiLiDGeKTrimmedBSubsystem P embedding d threshold w ell t)
    (daiLiDGeKBSubsystem P embedding threshold w ell t) Finset.sdiff_subset
    P.semanticCode hRecoveryB
  exact ⟨t, hResidualLt, hResidualSubset, hPairwise.1, hPairwise.2.1,
    hPairwise.2.2, daiLiDGeK_partition_cover P embedding d threshold w ell t,
    hRecoveryA, hTrimmedRecovery⟩

end QEC.Locality
