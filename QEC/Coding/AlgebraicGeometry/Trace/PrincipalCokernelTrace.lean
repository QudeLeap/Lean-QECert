/-!
# A principal multiplication cokernel as an ideal quotient

For a commutative `R`-algebra `S`, the range of multiplication by `t : S`
is the principal ideal generated by `t`, viewed after restricting scalars to
`R`.  Thus its cokernel is canonically `R`-linearly equivalent to
`S / (t)`.  The equivalence intertwines the endomorphism induced by
multiplication by `b` with literal quotient multiplication by `b`, so their
finite primary-torsion traces agree.

The proof is symbolic and does not choose a basis, enumerate a quotient,
select a place, or assert a residue, duality, genus, or Riemann--Roch
formula.
-/

namespace QEC.Coding.AlgebraicGeometry

universe u v

variable {R : Type u} [CommRing R]
variable {S : Type v} [CommRing S] [Algebra R S]

noncomputable local instance principalCokernelModuleFinite
    [Module.Finite R S] (t : S) :
    Module.Finite R (S ⧸ LinearMap.range (Algebra.lmul R S t)) :=
  Module.Finite.quotient R (LinearMap.range (Algebra.lmul R S t))

noncomputable local instance idealQuotientModuleFinite
    [Module.Finite R S] (I : Ideal S) : Module.Finite R (S ⧸ I) :=
  Module.Finite.quotient R I

private theorem range_lmul_eq_restrictScalars_span_singleton (t : S) :
    LinearMap.range (Algebra.lmul R S t) =
      (Ideal.span ({t} : Set S)).restrictScalars R := by
  change LinearMap.range (LinearMap.mul R S t) =
    (Ideal.span ({t} : Set S)).restrictScalars R
  exact Ideal.range_mul S t

/-- If `I` is the principal ideal generated by `t`, the multiplication
cokernel is `R`-linearly equivalent to `S / I`.  The target ideal is fixed in
the type before quotient instances are synthesized. -/
noncomputable def principalCokernelEquivOfEq (t : S) (I : Ideal S)
    (hspan : Ideal.span ({t} : Set S) = I) :
    (S ⧸ LinearMap.range (Algebra.lmul R S t)) ≃ₗ[R]
      S ⧸ I :=
  (Submodule.quotEquivOfEq
      (LinearMap.range (Algebra.lmul R S t))
      (I.restrictScalars R)
      (by rw [range_lmul_eq_restrictScalars_span_singleton t, hspan])).trans
    (Submodule.Quotient.restrictScalarsEquiv R I)

/-- The equality-indexed cokernel equivalence preserves representatives. -/
@[simp]
theorem principalCokernelEquivOfEq_mk (t x : S) (I : Ideal S)
    (hspan : Ideal.span ({t} : Set S) = I) :
    principalCokernelEquivOfEq (R := R) t I hspan
        (Submodule.Quotient.mk x) =
      Ideal.Quotient.mk I x :=
  rfl

/-- The cokernel of multiplication by `t` is the quotient by the principal
ideal generated by `t`, as an `R`-module. -/
noncomputable def principalCokernelEquiv (t : S) :
    (S ⧸ LinearMap.range (Algebra.lmul R S t)) ≃ₗ[R]
      S ⧸ Ideal.span ({t} : Set S) :=
  principalCokernelEquivOfEq (R := R) t (Ideal.span ({t} : Set S)) rfl

/-- The principal-cokernel equivalence sends a cokernel representative to
the same representative in the ideal quotient. -/
@[simp]
theorem principalCokernelEquiv_mk (t x : S) :
    principalCokernelEquiv (R := R) t (Submodule.Quotient.mk x) =
      Ideal.Quotient.mk (Ideal.span ({t} : Set S)) x :=
  rfl

private theorem lmul_comp_comm (t b : S) :
    (Algebra.lmul R S t).comp (Algebra.lmul R S b) =
      (Algebra.lmul R S b).comp (Algebra.lmul R S t) := by
  apply LinearMap.ext
  intro x
  change t * (b * x) = b * (t * x)
  ring

/-- Multiplication by `b` induced on the cokernel of multiplication by `t`.
The commutation proof is internal to this construction. -/
def principalCokernelMul (t b : S) :
    (S ⧸ LinearMap.range (Algebra.lmul R S t)) →ₗ[R]
      S ⧸ LinearMap.range (Algebra.lmul R S t) :=
  cokernelEndomorphism (Algebra.lmul R S t) (Algebra.lmul R S b)
    (lmul_comp_comm t b)

private theorem cokernelEndomorphism_mk' (t b x : S) :
    principalCokernelMul (R := R) t b (Submodule.Quotient.mk x) =
      Submodule.Quotient.mk (b * x) :=
  rfl

/-- If `I = (t)`, the equality-indexed principal-cokernel equivalence
intertwines induced multiplication by `b` with literal multiplication by
`b` on `S / I`, so their finite primary traces agree. -/
theorem primaryTorsionTrace_cokernel_lmul_eq_idealQuotientMul_of_eq
    [IsNoetherianRing R] [Module.Finite R S]
    (p : Ideal R) [p.IsMaximal] (t b : S) (I : Ideal S)
    (hspan : Ideal.span ({t} : Set S) = I) (depth : ℕ) :
    primaryTorsionTrace p
        (principalCokernelMul (R := R) t b) depth =
      primaryTorsionTrace p
        (Algebra.lmul R (S ⧸ I) (Ideal.Quotient.mk I b)) depth := by
  let e := principalCokernelEquivOfEq (R := R) t I hspan
  let f := principalCokernelMul (R := R) t b
  let g := Algebra.lmul R (S ⧸ I) (Ideal.Quotient.mk I b)
  have hintertwines :
      (e : (S ⧸ LinearMap.range (Algebra.lmul R S t)) →ₗ[R]
        S ⧸ I).comp f =
        g.comp (e : (S ⧸ LinearMap.range (Algebra.lmul R S t)) →ₗ[R]
          S ⧸ I) := by
    apply LinearMap.ext
    intro z
    induction z using Quotient.inductionOn' with
    | _ x =>
        change principalCokernelEquivOfEq (R := R) t I hspan
            (principalCokernelMul (R := R) t b
              (Submodule.Quotient.mk x)) =
          Ideal.Quotient.mk I b *
            principalCokernelEquivOfEq (R := R) t I hspan
              (Submodule.Quotient.mk x)
        rw [cokernelEndomorphism_mk', principalCokernelEquivOfEq_mk,
          principalCokernelEquivOfEq_mk, map_mul]
  exact primaryTorsionTrace_eq_of_intertwining p e f g hintertwines depth

/-- Under the principal-cokernel equivalence, the primary trace of the
endomorphism induced by multiplication by `b` is the primary trace of
literal multiplication by `b` on `S / (t)`. -/
theorem primaryTorsionTrace_cokernel_lmul_eq_idealQuotientMul
    [IsNoetherianRing R] [Module.Finite R S]
    (p : Ideal R) [p.IsMaximal] (t b : S) (depth : ℕ) :
    primaryTorsionTrace p
        (principalCokernelMul (R := R) t b) depth =
      primaryTorsionTrace p
        (Algebra.lmul R (S ⧸ Ideal.span ({t} : Set S))
          (Ideal.Quotient.mk (Ideal.span ({t} : Set S)) b)) depth := by
  exact primaryTorsionTrace_cokernel_lmul_eq_idealQuotientMul_of_eq
    p t b (Ideal.span ({t} : Set S)) rfl depth

end QEC.Coding.AlgebraicGeometry
