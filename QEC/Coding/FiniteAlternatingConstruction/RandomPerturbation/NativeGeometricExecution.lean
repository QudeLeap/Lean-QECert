import QEC.Coding.FiniteAlternatingConstruction.RandomPerturbation.NativeKeyExecutionBridge

/-!
# Actual native-key resampling and its supported geometric output

Each transition rebuilds and scans the paid native master-candidate universe,
then refreshes exactly its stored support.  The selected trace is generated by
the execution itself.  The analytic estimate is an expected resampling-step
bound; total primitive operations and recursive embedding are separate claims.
-/
noncomputable section
namespace QEC.Coding.BDL26NativeGeometricExecution
open BDL26FiniteAlternatingCore BDL26FiniteTannerSquare BDL26BoundedValence
open BDL26ReplacementEmbedding BDL26TannerLocalRegularity
open BDL26RandomPerturbation BDL26KeyedGeometric BDL26KeyedGeometricExecution
open BDL26NativeKeyExecutionBridge
open QEC.Coding.ProbabilisticConstruction
open QEC.Coding.ProbabilisticConstruction.SphericalCap
open QEC.Coding.ProbabilisticConstruction.Resampling
open MeasureTheory
open scoped Classical BigOperators ENNReal

abbrev NativeTable (S : OddScale) (n : ℕ) := SR.Samples (SR.Index S n)
abbrev OriginalTable (S : OddScale) (n : ℕ) := originalTable (Presentation S n)

abbrev U (S : OddScale) (n : ℕ) (J : Vertex (Presentation S n) → Space) (r : ℝ) :=
  keySupport (Presentation S n) (NC.nativeKey S n) (NC.nativeKey_injective S n) J r
abbrev B (S : OddScale) (n : ℕ) (J : Vertex (Presentation S n) → Space) (r l : ℝ) (K : ℕ) :=
  keyBad (Presentation S n) (NC.nativeKey S n) (NC.nativeKey_injective S n) J r l K

structure Prefix (S : OddScale) (n : ℕ) (J : Vertex (Presentation S n) → Space) (r : ℝ) where
  rows : SR.Rows (SR.Index S n)
  trace : List (Option (LiveRow S n J r))

/-- The exact-real query interface counts operations. Allocation accounting is
retained only at the separately named native cache primitive below. -/
structure PrefixRun (A : Type*) where
  value : A
  operations : ℕ

def chosenSupport (S : OddScale) (n : ℕ) (J : Vertex (Presentation S n) → Space) (r : ℝ) :
    Option (LiveRow S n J r) → List (SR.Index S n)
  | none => []
  | some row => support S n J r row

/-- This recursion, rather than a caller trace, chooses every native transition. -/
def prefixQ (S : OddScale) (n : ℕ) (J : Vertex (Presentation S n) → Space)
    {r : ℝ} (hr : 0 ≤ r) (lambda : ℝ) (K : ℕ) (T : NativeTable S n) :
    ℕ → PrefixRun (Prefix S n J r)
  | 0 =>
      let init := SR.initializeQ S n T
      ⟨⟨init.value,[]⟩,init.operations+1⟩
  | m+1 =>
      let prior := prefixQ S n J hr lambda K T m
      let chosen := scanQ S n J hr lambda K prior.value.rows
      let updated := SR.refreshQ T (chosenSupport S n J r chosen.1) prior.value.rows
      let trace := BDL26NativeMasterCandidates.appendQ prior.value.trace [chosen.1]
      ⟨⟨updated.value,trace.value⟩,
        prior.operations+chosen.2+updated.operations+trace.operations+4⟩

def choice (S : OddScale) (n : ℕ) (J : Vertex (Presentation S n) → Space)
    {r : ℝ} (hr : 0 ≤ r) (lambda : ℝ) (K : ℕ) (T : NativeTable S n) (m : ℕ) :=
  (scanQ S n J hr lambda K (prefixQ S n J hr lambda K T m).value.rows).1

theorem points_rows (S : OddScale) (n : ℕ) (T : OriginalTable S n)
    (c : Vertex (Presentation S n) → ℕ) :
    originalPoints S n (SR.rowsFor (SR.indices (SR.count S n)) (SR.encodeSamples S n T)
      (fun a => c (SR.decode S n a))) = assignment (X := fun _ : Vertex (Presentation S n) => Space) T c := by
  funext v
  unfold originalPoints SR.points
  rw [SR.read_rowsFor _ _ _ _ (SR.indices_complete _ _)]
  simp only [SR.encodeSamples,assignment,tableRead]
  rw [(SR.decode S n).apply_symm_apply v]

theorem scan_rows (S : OddScale) (n : ℕ) (J : Vertex (Presentation S n) → Space)
    {r : ℝ} (hr : 0 ≤ r) (lambda : ℝ) (K : ℕ) (T : OriginalTable S n)
    (c : Vertex (Presentation S n) → ℕ) :
    (scanQ S n J hr lambda K
      (SR.rowsFor (SR.indices (SR.count S n)) (SR.encodeSamples S n T)
        (fun a => c (SR.decode S n a)))).1.map (event S n J r) =
      select (localEvent (X := fun _ : Vertex (Presentation S n) => Space) (U S n J r) (B S n J r lambda K)) (assignment (X := fun _ : Vertex (Presentation S n) => Space) T c) := by
  rw [scan_actual,points_rows]

/-- Exact counter and assignment refinement at every finite prefix. -/
theorem prefix_rows (S : OddScale) (n : ℕ) (J : Vertex (Presentation S n) → Space)
    {r : ℝ} (hr : 0 ≤ r) (lambda : ℝ) (K : ℕ) (T : OriginalTable S n) (m : ℕ) :
    (prefixQ S n J hr lambda K (SR.encodeSamples S n T) m).value.rows =
      SR.rowsFor (SR.indices (SR.count S n)) (SR.encodeSamples S n T)
        (fun a => counters (X := fun _ : Vertex (Presentation S n) => Space) (U S n J r) (B S n J r lambda K) T m (SR.decode S n a)) := by
  induction m with
  | zero => exact SR.initialize_value S n _
  | succ m ih =>
    have hs :
        (scanQ S n J hr lambda K
          (SR.rowsFor (SR.indices (SR.count S n)) (SR.encodeSamples S n T)
            (fun a => counters (X := fun _ : Vertex (Presentation S n) => Space)
              (U S n J r) (B S n J r lambda K) T m (SR.decode S n a)))).1.map
          (event S n J r) =
        selected (X := fun _ : Vertex (Presentation S n) => Space)
          (U S n J r) (B S n J r lambda K) T m := by
      exact scan_rows S n J hr lambda K T
        (counters (X := fun _ : Vertex (Presentation S n) => Space)
          (U S n J r) (B S n J r lambda K) T m)
    rw [← ih] at hs
    change (SR.refreshQ _ (chosenSupport S n J r _) _).value = _
    cases hc : (scanQ S n J hr lambda K
      (prefixQ S n J hr lambda K (SR.encodeSamples S n T) m).value.rows).1 with
    | none =>
      have hg : selected (X := fun _ : Vertex (Presentation S n) => Space) (U S n J r) (B S n J r lambda K) T m = none := by
        simpa only [hc,Option.map_none] using hs.symm
      rw [ih,SR.refresh_value,counters_succ_of_none (X := fun _ : Vertex (Presentation S n) => Space) _ _ T m hg]
      rfl
    | some row =>
      have hg : selected (X := fun _ : Vertex (Presentation S n) => Space) (U S n J r) (B S n J r lambda K) T m =
          some (event S n J r row) := by
        simpa only [hc,Option.map_some] using hs.symm
      rw [ih,SR.refresh_value,counters_succ_of_some (X := fun _ : Vertex (Presentation S n) => Space) _ _ T m _ hg]
      congr 1
      funext a
      simp only [chosenSupport,SR.advanceList,advance,(support_complete S n J r row).2.2]

theorem choice_original (S : OddScale) (n : ℕ) (J : Vertex (Presentation S n) → Space)
    {r : ℝ} (hr : 0 ≤ r) (lambda : ℝ) (K : ℕ) (T : OriginalTable S n) (m : ℕ) :
    (choice S n J hr lambda K (SR.encodeSamples S n T) m).map (event S n J r) =
      selected (X := fun _ : Vertex (Presentation S n) => Space) (U S n J r) (B S n J r lambda K) T m := by
  unfold choice
  rw [prefix_rows]
  exact scan_rows S n J hr lambda K T _

def originalTrace (S : OddScale) (n : ℕ) (J : Vertex (Presentation S n) → Space)
    (r lambda : ℝ) (K : ℕ) (T : OriginalTable S n) : ℕ → List (Option (Event S n J r))
  | 0 => []
  | m+1 => originalTrace S n J r lambda K T m ++
      [selected (X := fun _ : Vertex (Presentation S n) => Space) (U S n J r) (B S n J r lambda K) T m]

theorem prefix_trace (S : OddScale) (n : ℕ) (J : Vertex (Presentation S n) → Space)
    {r : ℝ} (hr : 0 ≤ r) (lambda : ℝ) (K : ℕ) (T : OriginalTable S n) (m : ℕ) :
    ((prefixQ S n J hr lambda K (SR.encodeSamples S n T) m).value.trace.map
      (Option.map (event S n J r))) = originalTrace S n J r lambda K T m := by
  induction m with
  | zero => rfl
  | succ m ih =>
    change ((BDL26NativeMasterCandidates.appendQ _ _).value.map _) = _
    rw [(BDL26NativeMasterCandidates.append_spec _ _).1,List.map_append]
    simp only [List.map_cons,List.map_nil,ih,originalTrace]
    exact congrArg (originalTrace S n J r lambda K T m ++ ·)
      (congrArg (fun x => [x]) (choice_original S n J hr lambda K T m))

theorem prefix_read (S : OddScale) (n : ℕ) (J : Vertex (Presentation S n) → Space)
    {r : ℝ} (hr : 0 ≤ r) (lambda : ℝ) (K : ℕ) (T : OriginalTable S n) (m : ℕ)
    (v : Vertex (Presentation S n)) :
    (SR.readQ ((SR.decode S n).symm v)
      (prefixQ S n J hr lambda K (SR.encodeSamples S n T) m).value.rows).value =
      (counters (X := fun _ : Vertex (Presentation S n) => Space) (U S n J r) (B S n J r lambda K) T m v,
        assignment (X := fun _ : Vertex (Presentation S n) => Space) T (counters (X := fun _ : Vertex (Presentation S n) => Space) (U S n J r) (B S n J r lambda K) T m) v) := by
  rw [prefix_rows,SR.read_rowsFor _ _ _ _ (SR.indices_complete _ _)]
  simp only [SR.encodeSamples,assignment,tableRead]
  rw [(SR.decode S n).apply_symm_apply v]

theorem prefix_assignment (S : OddScale) (n : ℕ) (J : Vertex (Presentation S n) → Space)
    {r : ℝ} (hr : 0 ≤ r) (lambda : ℝ) (K : ℕ) (T : OriginalTable S n) (m : ℕ) :
    originalPoints S n (prefixQ S n J hr lambda K (SR.encodeSamples S n T) m).value.rows =
      assignment (X := fun _ : Vertex (Presentation S n) => Space) T (counters (X := fun _ : Vertex (Presentation S n) => Space) (U S n J r) (B S n J r lambda K) T m) := by
  rw [prefix_rows,points_rows]

def supportTrace (S : OddScale) (n : ℕ) (J : Vertex (Presentation S n) → Space)
    {r : ℝ} (hr : 0 ≤ r) (lambda : ℝ) (K : ℕ) (T : NativeTable S n) (m : ℕ) :=
  (prefixQ S n J hr lambda K T m).value.trace.map (chosenSupport S n J r)

theorem trace_counters_original (S : OddScale) (n : ℕ)
    (J : Vertex (Presentation S n) → Space) {r : ℝ} (hr : 0 ≤ r)
    (lambda : ℝ) (K : ℕ) (T : OriginalTable S n) (m : ℕ) :
    SR.traceCounters (supportTrace S n J hr lambda K (SR.encodeSamples S n T) m)
      (fun _ => 0) =
      fun a => counters (X := fun _ : Vertex (Presentation S n) => Space) (U S n J r) (B S n J r lambda K) T m (SR.decode S n a) := by
  induction m with
  | zero => rfl
  | succ m ih =>
    have hs := choice_original S n J hr lambda K T m
    have ht : supportTrace S n J hr lambda K (SR.encodeSamples S n T) (m+1) =
        supportTrace S n J hr lambda K (SR.encodeSamples S n T) m ++
          [chosenSupport S n J r
            (choice S n J hr lambda K (SR.encodeSamples S n T) m)] := by
      change ((BDL26NativeMasterCandidates.appendQ _ _).value.map _) = _
      rw [(BDL26NativeMasterCandidates.append_spec _ _).1,List.map_append]
      rfl
    rw [ht,SR.trace_counters_append,ih]
    change SR.advanceList (chosenSupport S n J r
      (choice S n J hr lambda K (SR.encodeSamples S n T) m))
        (fun a => counters (X := fun _ : Vertex (Presentation S n) => Space)
          (U S n J r) (B S n J r lambda K) T m (SR.decode S n a)) = _
    cases hc : choice S n J hr lambda K (SR.encodeSamples S n T) m with
    | none =>
      have hg : selected (X := fun _ : Vertex (Presentation S n) => Space) (U S n J r) (B S n J r lambda K) T m = none := by
        simpa only [hc,Option.map_none] using hs.symm
      rw [counters_succ_of_none (X := fun _ : Vertex (Presentation S n) => Space) _ _ T m hg]
      rfl
    | some row =>
      have hg : selected (X := fun _ : Vertex (Presentation S n) => Space) (U S n J r) (B S n J r lambda K) T m =
          some (event S n J r row) := by simpa only [hc,Option.map_some] using hs.symm
      rw [counters_succ_of_some (X := fun _ : Vertex (Presentation S n) => Space) _ _ T m _ hg]
      funext a
      simp only [chosenSupport,SR.advanceList,advance,(support_complete S n J r row).2.2]

/-- The state-row executor is replayed only with the trace just generated by the
actual paid scans. No caller-supplied trace is an execution hypothesis. -/
theorem native_state_rows_refinement (S : OddScale) (n : ℕ)
    (J : Vertex (Presentation S n) → Space) {r : ℝ} (hr : 0 ≤ r)
    (lambda : ℝ) (K : ℕ) (T : OriginalTable S n) (m : ℕ) :
    (prefixQ S n J hr lambda K (SR.encodeSamples S n T) m).value.rows =
      (SR.executeQ S n (SR.encodeSamples S n T)
        (supportTrace S n J hr lambda K (SR.encodeSamples S n T) m)).value ∧
    ∀ v : Vertex (Presentation S n),
      (SR.readQ ((SR.decode S n).symm v)
        (prefixQ S n J hr lambda K (SR.encodeSamples S n T) m).value.rows).value =
      (counters (X := fun _ : Vertex (Presentation S n) => Space) (U S n J r) (B S n J r lambda K) T m v,
        assignment (X := fun _ : Vertex (Presentation S n) => Space) T (counters (X := fun _ : Vertex (Presentation S n) => Space) (U S n J r) (B S n J r lambda K) T m) v) := by
  refine ⟨?_,prefix_read S n J hr lambda K T m⟩
  rw [prefix_rows,SR.execute_value,trace_counters_original]

/-- Only the bounded cache refresh cost is claimed here, separately from all
paid eligibility/order/query work and its still-separate expectation. -/
theorem refresh_local_cost (S : OddScale) (n : ℕ)
    (J : Vertex (Presentation S n) → Space) (r : ℝ) (row : LiveRow S n J r)
    (T : NativeTable S n) (R : SR.Rows (SR.Index S n)) :
    (SR.refreshQ T (support S n J r row) R).operations ≤ 35*R.length ∧
    (SR.refreshQ T (support S n J r row) R).allocations ≤ 2*R.length := by
  have h := BDL26NativeStateRows.refresh_cost T (support S n J r row) R
  rw [(support_complete S n J r row).2.1] at h
  simpa only [Nat.mul_comm] using h

def NativeHalts (S : OddScale) (n : ℕ) (J : Vertex (Presentation S n) → Space)
    {r : ℝ} (hr : 0 ≤ r) (lambda : ℝ) (K : ℕ) (T : NativeTable S n) : Prop :=
  ∃ m, choice S n J hr lambda K T m = none

def nativeHaltTime (S : OddScale) (n : ℕ) (J : Vertex (Presentation S n) → Space)
    {r : ℝ} (hr : 0 ≤ r) (lambda : ℝ) (K : ℕ) (T : NativeTable S n) : ℕ :=
  if h : NativeHalts S n J hr lambda K T then Nat.find h else 0

theorem halts_original (S : OddScale) (n : ℕ) (J : Vertex (Presentation S n) → Space)
    {r : ℝ} (hr : 0 ≤ r) (lambda : ℝ) (K : ℕ) (T : OriginalTable S n) :
    NativeHalts S n J hr lambda K (SR.encodeSamples S n T) ↔
      Halts (X := fun _ : Vertex (Presentation S n) => Space) (U S n J r) (B S n J r lambda K) T := by
  have hm : ∀ m, choice S n J hr lambda K (SR.encodeSamples S n T) m = none ↔
      selected (X := fun _ : Vertex (Presentation S n) => Space) (U S n J r) (B S n J r lambda K) T m = none := by
    intro m
    rw [← choice_original S n J hr lambda K T m]
    simp
  exact exists_congr hm

theorem haltTime_original (S : OddScale) (n : ℕ) (J : Vertex (Presentation S n) → Space)
    {r : ℝ} (hr : 0 ≤ r) (lambda : ℝ) (K : ℕ) (T : OriginalTable S n) :
    nativeHaltTime S n J hr lambda K (SR.encodeSamples S n T) =
      haltTime (X := fun _ : Vertex (Presentation S n) => Space) (U S n J r) (B S n J r lambda K) T := by
  by_cases h : Halts (X := fun _ : Vertex (Presentation S n) => Space) (U S n J r) (B S n J r lambda K) T
  · have hn := (halts_original S n J hr lambda K T).mpr h
    simp only [nativeHaltTime,haltTime,dif_pos h,dif_pos hn]
    apply Nat.find_congr'
    intro m
    rw [← choice_original S n J hr lambda K T m]
    simp
  · have hn := (halts_original S n J hr lambda K T).not.mpr h
    simp only [nativeHaltTime,haltTime,dif_neg h,dif_neg hn]

def returned (S : OddScale) (n : ℕ) (J : Vertex (Presentation S n) → Space)
    {r : ℝ} (hr : 0 ≤ r) (lambda : ℝ) (K : ℕ) (T : NativeTable S n) :
    Vertex (Presentation S n) → Space :=
  originalPoints S n (prefixQ S n J hr lambda K T
    (nativeHaltTime S n J hr lambda K T)).value.rows

/-- The whole terminating output AND the original nontermination default agree. -/
theorem returned_original (S : OddScale) (n : ℕ) (J : Vertex (Presentation S n) → Space)
    {r : ℝ} (hr : 0 ≤ r) (lambda : ℝ) (K : ℕ) (T : OriginalTable S n) :
    returned S n J hr lambda K (SR.encodeSamples S n T) =
      output (X := fun _ : Vertex (Presentation S n) => Space) (U S n J r) (B S n J r lambda K) T := by
  unfold returned
  rw [haltTime_original,prefix_assignment]
  rfl

def nativePrefixCount (S : OddScale) (n : ℕ) (J : Vertex (Presentation S n) → Space)
    {r : ℝ} (hr : 0 ≤ r) (lambda : ℝ) (K : ℕ) (T : NativeTable S n)
    (m : ℕ) (e : Event S n J r) : ℕ :=
  ((Finset.range m).filter (fun i =>
    (choice S n J hr lambda K T i).map (event S n J r) = some e)).card

theorem prefixCount_original (S : OddScale) (n : ℕ)
    (J : Vertex (Presentation S n) → Space) {r : ℝ} (hr : 0 ≤ r)
    (lambda : ℝ) (K : ℕ) (T : OriginalTable S n) (m : ℕ) (e : Event S n J r) :
    nativePrefixCount S n J hr lambda K (SR.encodeSamples S n T) m e =
      prefixCount (X := fun _ : Vertex (Presentation S n) => Space) (U S n J r) (B S n J r lambda K) T m e := by
  simp only [nativePrefixCount,choice_original,prefixCount,occurrences]

def nativeTotalSteps (S : OddScale) (n : ℕ) (J : Vertex (Presentation S n) → Space)
    {r : ℝ} (hr : 0 ≤ r) (lambda : ℝ) (K : ℕ) (T : NativeTable S n) : ℝ≥0∞ :=
  ∑ e, ⨆ m : ℕ, (nativePrefixCount S n J hr lambda K T m e : ℝ≥0∞)

theorem totalSteps_original (S : OddScale) (n : ℕ)
    (J : Vertex (Presentation S n) → Space) {r : ℝ} (hr : 0 ≤ r)
    (lambda : ℝ) (K : ℕ) (T : OriginalTable S n) :
    nativeTotalSteps S n J hr lambda K (SR.encodeSamples S n T) =
      totalSteps (X := fun _ : Vertex (Presentation S n) => Space) (U S n J r) (B S n J r lambda K) T := by
  simp only [nativeTotalSteps,prefixCount_original,totalSteps,totalCount]

/-- The specified default is retained on every genuinely nonterminating table;
its total resampling count is infinite rather than the default halt clock0. -/
theorem nonhalting_default (S : OddScale) (n : ℕ)
    (J : Vertex (Presentation S n) → Space) {r : ℝ} (hr : 0 ≤ r)
    (lambda : ℝ) (K : ℕ) (T : OriginalTable S n)
    (h : ¬ NativeHalts S n J hr lambda K (SR.encodeSamples S n T)) :
    nativeHaltTime S n J hr lambda K (SR.encodeSamples S n T) = 0 ∧
    returned S n J hr lambda K (SR.encodeSamples S n T) = (fun v => T (v,0)) ∧
    nativeTotalSteps S n J hr lambda K (SR.encodeSamples S n T) = ∞ := by
  have hg : ¬ Halts (X := fun _ : Vertex (Presentation S n) => Space) (U S n J r) (B S n J r lambda K) T :=
    fun hh => h ((halts_original S n J hr lambda K T).mpr hh)
  refine ⟨by simp only [nativeHaltTime,dif_neg h],?_,?_⟩
  · rw [returned_original]
    simp only [Resampling.output,Resampling.haltTime,dif_neg hg,Resampling.counters]
    change Resampling.assignment (X := fun _ : Vertex (Presentation S n) => Space) T (fun _ : Vertex (Presentation S n) => 0) =
      (fun v => T (v,0))
    rfl
  · rw [totalSteps_original]
    by_contra hn
    exact hg (halts_of_totalSteps_lt_top (X := fun _ : Vertex (Presentation S n) => Space) _ _ T (lt_top_iff_ne_top.mpr hn))

def observation (S : OddScale) (n : ℕ) (J : Vertex (Presentation S n) → Space)
    {r : ℝ} (hr : 0 ≤ r) (lambda : ℝ) (K : ℕ) (T : NativeTable S n) :
    Resampling.VariableRelabeling.Observation (Vertex (Presentation S n)) (Event S n J r) Space :=
  ((fun m v => (SR.readQ ((SR.decode S n).symm v)
      (prefixQ S n J hr lambda K T m).value.rows).value.1),
    (fun m => (choice S n J hr lambda K T m).map (event S n J r)),
    (if NativeHalts S n J hr lambda K T then true else false),
    nativeHaltTime S n J hr lambda K T,
    returned S n J hr lambda K T,
    nativePrefixCount S n J hr lambda K T,
    (fun e => ⨆ m : ℕ, (nativePrefixCount S n J hr lambda K T m e : ℝ≥0∞)),
    nativeTotalSteps S n J hr lambda K T)

/-- The complete selected-event/counter/output/count observation, including
nonterminating defaults and infinity, is identified deterministically. -/
theorem observation_original (S : OddScale) (n : ℕ)
    (J : Vertex (Presentation S n) → Space) {r : ℝ} (hr : 0 ≤ r)
    (lambda : ℝ) (K : ℕ) (T : OriginalTable S n) :
    observation S n J hr lambda K (SR.encodeSamples S n T) =
      Resampling.VariableRelabeling.jointObservation (U S n J r) (B S n J r lambda K) T := by
  have hcounts : nativePrefixCount S n J hr lambda K (SR.encodeSamples S n T) =
      prefixCount (X := fun _ : Vertex (Presentation S n) => Space)
        (U S n J r) (B S n J r lambda K) T := by
    funext m e
    exact prefixCount_original S n J hr lambda K T m e
  simp only [observation,Resampling.VariableRelabeling.jointObservation,prefix_read,
    choice_original,halts_original,haltTime_original,returned_original,
    hcounts,totalSteps_original]
  rfl

def decodedTable (S : OddScale) (n : ℕ) (T : NativeTable S n) : OriginalTable S n :=
  Resampling.VariableRelabeling.decodeTable (SR.decode S n) T

theorem encoded_decoded (S : OddScale) (n : ℕ) (T : NativeTable S n) :
    SR.encodeSamples S n (decodedTable S n T) = T :=
  Resampling.VariableRelabeling.encode_decode_table (SR.decode S n) T

theorem observation_decoded (S : OddScale) (n : ℕ)
    (J : Vertex (Presentation S n) → Space) {r : ℝ} (hr : 0 ≤ r)
    (lambda : ℝ) (K : ℕ) (T : NativeTable S n) :
    observation S n J hr lambda K T =
      Resampling.VariableRelabeling.jointObservation (U S n J r) (B S n J r lambda K)
        (decodedTable S n T) := by
  have h := observation_original S n J hr lambda K (decodedTable S n T)
  rw [encoded_decoded] at h
  exact h

theorem measurable_observation (S : OddScale) (n : ℕ)
    (J : Vertex (Presentation S n) → Space) {r : ℝ} (hr : 0 ≤ r)
    (lambda : ℝ) (K : ℕ) : Measurable (observation S n J hr lambda K) := by
  have he : observation S n J hr lambda K =
      Resampling.VariableRelabeling.jointObservation (U S n J r) (B S n J r lambda K) ∘
        decodedTable S n := funext (observation_decoded S n J hr lambda K)
  have hd : Measurable (decodedTable S n) :=
    Resampling.VariableRelabeling.measurable_decodeTable (SR.decode S n)
  rw [he]
  exact (Resampling.VariableRelabeling.measurable_jointObservation _ _
    (measurableSet_keyBad _ _ _ _ _ _ _)).comp hd

def nativeTableMeasure (S : OddScale) (n : ℕ) {L : ℝ} (p : GeometricParameters L) :
    Measure (NativeTable S n) := by
  letI (a : SR.Index S n) := vertexLaw_probability (Presentation S n)
    ((6*p.m : ℕ)*(p.lambda : ℝ)) (capCutoff_bounds p.m_two).2 (SR.decode S n a)
  exact tableLaw (fun a : SR.Index S n => vertexLaw (Presentation S n)
    ((6*p.m : ℕ)*(p.lambda : ℝ)) (capCutoff p.m) (SR.decode S n a))

/-- The genuine original product law is transported through the generated decode equivalence. -/
theorem original_table_law (S : OddScale) (n : ℕ) {L : ℝ} (p : GeometricParameters L) :
    (tableMeasure (Presentation S n) p).map (SR.encodeSamples S n) = nativeTableMeasure S n p := by
  letI (v : Vertex (Presentation S n)) := vertexLaw_probability (Presentation S n)
    ((6*p.m : ℕ)*(p.lambda : ℝ)) (capCutoff_bounds p.m_two).2 v
  exact Resampling.VariableRelabeling.table_law (SR.decode S n) _

theorem decoded_table_law (S : OddScale) (n : ℕ) {L : ℝ} (p : GeometricParameters L) :
    (nativeTableMeasure S n p).map (decodedTable S n) = tableMeasure (Presentation S n) p := by
  letI (v : Vertex (Presentation S n)) := vertexLaw_probability (Presentation S n)
    ((6*p.m : ℕ)*(p.lambda : ℝ)) (capCutoff_bounds p.m_two).2 v
  letI (a : SR.Index S n) := vertexLaw_probability (Presentation S n)
    ((6*p.m : ℕ)*(p.lambda : ℝ)) (capCutoff_bounds p.m_two).2 (SR.decode S n a)
  have h := Resampling.VariableRelabeling.table_law (SR.decode S n).symm
    (fun a => vertexLaw (Presentation S n)
      ((6*p.m : ℕ)*(p.lambda : ℝ)) (capCutoff p.m) (SR.decode S n a))
  change
    (tableLaw (fun a : SR.Index S n => vertexLaw (Presentation S n)
      ((6*p.m : ℕ)*(p.lambda : ℝ)) (capCutoff p.m) (SR.decode S n a))).map
      (Resampling.VariableRelabeling.encodeTable (X := Space) (SR.decode S n).symm) =
        tableLaw (vertexLaw (Presentation S n)
          ((6*p.m : ℕ)*(p.lambda : ℝ)) (capCutoff p.m))
  simpa only [(SR.decode S n).apply_symm_apply] using h

theorem full_execution_law (S : OddScale) (n : ℕ)
    (J : Vertex (Presentation S n) → Space) {r : ℝ} (hr : 0 ≤ r)
    (lambda : ℝ) (K : ℕ) {L : ℝ} (p : GeometricParameters L) :
    (nativeTableMeasure S n p).map (observation S n J hr lambda K) =
      (tableMeasure (Presentation S n) p).map
        (Resampling.VariableRelabeling.jointObservation (U S n J r) (B S n J r lambda K)) := by
  have hd : Measurable (decodedTable S n) :=
    Resampling.VariableRelabeling.measurable_decodeTable (SR.decode S n)
  rw [← decoded_table_law S n p,Measure.map_map
    (Resampling.VariableRelabeling.measurable_jointObservation _ _
      (measurableSet_keyBad _ _ _ _ _ _ _))
    hd]
  congr 1
  exact funext (observation_decoded S n J hr lambda K)

theorem radius_nonneg {L : ℝ} (p : GeometricParameters L) : 0 ≤ (anchorRadius p.m : ℝ) := by
  unfold anchorRadius
  positivity

def nativeOutput (S : OddScale) (n : ℕ) (J : Vertex (Presentation S n) → Space)
    {L : ℝ} (p : GeometricParameters L) :=
  returned S n J (radius_nonneg p) p.lambda ((6*p.m+2)*p.lambda)

theorem nativeOutput_decoded (S : OddScale) (n : ℕ)
    (J : Vertex (Presentation S n) → Space) {L : ℝ} (p : GeometricParameters L)
    (T : NativeTable S n) : nativeOutput S n J p T =
      result (Presentation S n) (NC.nativeKey S n) (NC.nativeKey_injective S n)
        J p (decodedTable S n T) := by
  have h := returned_original S n J (radius_nonneg p) p.lambda
    ((6*p.m+2)*p.lambda) (decodedTable S n T)
  rw [encoded_decoded] at h
  exact h

theorem measurable_nativeOutput (S : OddScale) (n : ℕ)
    (J : Vertex (Presentation S n) → Space) {L : ℝ} (p : GeometricParameters L) :
    Measurable (nativeOutput S n J p) := by
  have he : nativeOutput S n J p =
      result (Presentation S n) (NC.nativeKey S n) (NC.nativeKey_injective S n) J p ∘
        decodedTable S n := funext (nativeOutput_decoded S n J p)
  have hd : Measurable (decodedTable S n) :=
    Resampling.VariableRelabeling.measurable_decodeTable (SR.decode S n)
  rw [he]
  exact (measurable_result _ _ _ _ _).comp hd

/-- Full native output pushforward; this is not a claim of product independence
of the adaptively selected output. -/
theorem nativeOutput_law (S : OddScale) (n : ℕ)
    (J : Vertex (Presentation S n) → Space) {L : ℝ} (p : GeometricParameters L) :
    (nativeTableMeasure S n p).map (nativeOutput S n J p) =
      (tableMeasure (Presentation S n) p).map
        (result (Presentation S n) (NC.nativeKey S n) (NC.nativeKey_injective S n) J p) := by
  have hd : Measurable (decodedTable S n) :=
    Resampling.VariableRelabeling.measurable_decodeTable (SR.decode S n)
  rw [← decoded_table_law S n p,Measure.map_map (measurable_result _ _ _ _ _) hd]
  congr 1
  exact funext (nativeOutput_decoded S n J p)

theorem native_execution_geometry_ae (S : OddScale) (n : ℕ)
    (J : Vertex (Presentation S n) → Space) {L : ℝ} (p : GeometricParameters L)
    (hJ : IsBoundedDensityLocalMap (Presentation S n) J p.t) :
    Measurable (nativeOutput S n J p) ∧
    ∀ᵐ T ∂nativeTableMeasure S n p,
      NativeHalts S n J (radius_nonneg p) p.lambda ((6*p.m+2)*p.lambda) T ∧
      nativeOutput S n J p T ∈ BDL26NativeGeometricAvoidance.NativeGood S n J p ∧
      IncomingFaceGeometry (Presentation S n) (perturbationOddScale p)
        (perturbedMap (Presentation S n) J p.lambda (nativeOutput S n J p T))
        (((p.m : ℝ)-1)*p.lambda) ((6*(p.m : ℝ)*widthFactor-1)*p.lambda) ∧
      ∀ z, ((familyHits (oldTriangleImage (Presentation S n)
        (perturbedMap (Presentation S n) J p.lambda (nativeOutput S n J p T)))
        (Metric.closedBall z 1)).card : ℝ) ≤ triangleDensityBound := by
  refine ⟨measurable_nativeOutput S n J p,?_⟩
  have h := halts_good_ae (Presentation S n) (NC.nativeKey S n)
    (NC.nativeKey_injective S n) J p hJ (state_boundedValence S n)
  have hd : Measurable (decodedTable S n) :=
    Resampling.VariableRelabeling.measurable_decodeTable (X := Space) (SR.decode S n)
  have hm : MeasurableSet {T : OriginalTable S n |
      Halts (X := fun _ : Vertex (Presentation S n) => Space) (U S n J (anchorRadius p.m))
        (B S n J (anchorRadius p.m) p.lambda ((6*p.m+2)*p.lambda)) T ∧
      result (Presentation S n) (NC.nativeKey S n) (NC.nativeKey_injective S n) J p T ∈
        KeyGood (Presentation S n) (NC.nativeKey S n) (NC.nativeKey_injective S n) J p} :=
    (measurableSet_halts (X := fun _ : Vertex (Presentation S n) => Space) _ _ (measurableSet_keyBad _ _ _ _ _ _ _)).inter
      ((measurableSet_KeyGood _ _ _ _ _).preimage (measurable_result _ _ _ _ _))
  have hp := (ae_map_iff hd.aemeasurable hm).mp (by
    rw [decoded_table_law S n p]
    exact h)
  filter_upwards [hp] with T hT
  have hh : NativeHalts S n J (radius_nonneg p) p.lambda ((6*p.m+2)*p.lambda) T := by
    rw [← encoded_decoded S n T]
    exact (halts_original S n J _ _ _ _).mpr hT.1
  rw [nativeOutput_decoded]
  exact ⟨hh,hT.2,keyGood_geometry_density (Presentation S n) (NC.nativeKey S n)
    (NC.nativeKey_injective S n) J p hJ (state_boundedValence S n) _ hT.2⟩

/-- Explicit finite expected totalSteps for the same paid native selection process. -/
theorem native_expected_steps (S : OddScale) (n : ℕ)
    (J : Vertex (Presentation S n) → Space) {L : ℝ} (p : GeometricParameters L)
    (hJ : IsBoundedDensityLocalMap (Presentation S n) J p.t) :
    (∫⁻ T, nativeTotalSteps S n J (radius_nonneg p) p.lambda ((6*p.m+2)*p.lambda) T
      ∂nativeTableMeasure S n p) ≤
      ENNReal.ofReal ((Fintype.card (Triangle (Presentation S n)) : ℝ)^4 *
        (lllWeight (dependencyBound p.M)/(1-lllWeight (dependencyBound p.M)))) ∧
    ENNReal.ofReal ((Fintype.card (Triangle (Presentation S n)) : ℝ)^4 *
        (lllWeight (dependencyBound p.M)/(1-lllWeight (dependencyBound p.M)))) < ∞ := by
  have hd : Measurable (decodedTable S n) :=
    Resampling.VariableRelabeling.measurable_decodeTable (SR.decode S n)
  have he : nativeTotalSteps S n J (radius_nonneg p) p.lambda ((6*p.m+2)*p.lambda) =
      totalSteps (X := fun _ : Vertex (Presentation S n) => Space) (U S n J (anchorRadius p.m))
        (B S n J (anchorRadius p.m) p.lambda ((6*p.m+2)*p.lambda)) ∘ decodedTable S n := by
    funext T
    have h := totalSteps_original S n J (radius_nonneg p) p.lambda
      ((6*p.m+2)*p.lambda) (decodedTable S n T)
    rw [encoded_decoded] at h
    exact h
  have hi : (∫⁻ T, nativeTotalSteps S n J (radius_nonneg p) p.lambda
      ((6*p.m+2)*p.lambda) T ∂nativeTableMeasure S n p) =
      ∫⁻ T, totalSteps (X := fun _ : Vertex (Presentation S n) => Space) (U S n J (anchorRadius p.m))
        (B S n J (anchorRadius p.m) p.lambda ((6*p.m+2)*p.lambda)) T
        ∂tableMeasure (Presentation S n) p := by
    rw [he,← decoded_table_law S n p]
    exact (lintegral_map
      (measurable_totalSteps (X := fun _ : Vertex (Presentation S n) => Space) _ _ (measurableSet_keyBad _ _ _ _ _ _ _)) hd).symm
  rw [hi]
  exact expected_steps_explicit_finite (Presentation S n) (NC.nativeKey S n)
    (NC.nativeKey_injective S n) J p hJ (state_boundedValence S n)

