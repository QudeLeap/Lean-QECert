import QEC.Coding.ExpanderCodes.LPSOriginalGaussSpecialFiber
import Mathlib.FieldTheory.Minpoly.IsIntegrallyClosed
import Mathlib.Algebra.Prime.Lemmas

/-!
# Reduced original special fiber

The SAME original integer normal zero chart in Q(j,j_N) has radical ideal
generated by p and reduced quotient by p whenever p does not divide the positive
level. Its original Gauss normalization supplies the proved reduced generic
special fiber. A constructed descent of integrality, proved by minimal-polynomial
coefficient comparison and prime-power denominator cancellation, returns the
actual quotient witness to the original integral closure. No reducedness or
good model is supplied as an original-chart hypothesis.

This internal arithmetic prerequisite supports the original LPS route in pinned
PK22 main.tex ex:Xpq, lines 484–486, and th:qLDPC, lines 231–238. The reciprocal
chart, normal or smooth special fibers, global good reduction, spectral bounds
and the full explicit quantum family remain unproved.
-/

namespace QEC.Coding.AlgebraicGeometry
noncomputable section

lemma primePower_dvd_of_localized_dvd
    {R : Type*} [CommRing R] [IsDomain R]
    (P : Ideal R) [P.IsPrime] (a : R) (hP : P = Ideal.span {a}) (ha : Prime a)
    (n : ℕ) (r : R)
    (h : (algebraMap R (Localization.AtPrime P) a)^n ∣
      algebraMap R (Localization.AtPrime P) r) : a^n ∣ r := by
  let G := Localization.AtPrime P
  obtain ⟨b,hb⟩ := h
  obtain ⟨⟨x,s⟩,hs⟩ := IsLocalization.surj P.primeCompl b
  have hsr : (s : R)*r = a^n*x := by
    apply FaithfulSMul.algebraMap_injective R G
    calc
      algebraMap R G ((s : R)*r) =
          (algebraMap R G a)^n * (b * algebraMap R G s) := by
        rw [map_mul,hb]
        ac_rfl
      _ = algebraMap R G (a^n*x) := by rw [hs,map_mul,map_pow]
  have hsnot : ¬ a ∣ (s : R) := by
    intro hd
    apply s.property
    exact (le_of_eq hP.symm) (Ideal.mem_span_singleton.mpr hd)
  exact ha.pow_dvd_of_dvd_mul_left n hsnot ⟨x,hsr⟩

lemma integral_of_prime_multiple_and_localizedIntegral
    {R : Type*} [CommRing R] [IsDomain R] [IsIntegrallyClosed R]
    (P : Ideal R) [P.IsPrime] (J K : Type*) [Field J] [Field K]
    [Algebra R J] [IsFractionRing R J]
    [Algebra (Localization.AtPrime P) J]
    [IsScalarTower R (Localization.AtPrime P) J]
    [IsFractionRing (Localization.AtPrime P) J]
    [Algebra R K] [Algebra (Localization.AtPrime P) K] [Algebra J K]
    [IsScalarTower R J K] [IsScalarTower (Localization.AtPrime P) J K]
    [IsScalarTower R (Localization.AtPrime P) K]
    [FaithfulSMul R K] [FaithfulSMul (Localization.AtPrime P) K]
    [IsIntegrallyClosed (Localization.AtPrime P)]
    (a : R) (hP : P = Ideal.span {a}) (ha : Prime a) (y : K)
    (hR : IsIntegral R (algebraMap R K a*y))
    (hG : IsIntegral (Localization.AtPrime P) y) : IsIntegral R y := by
  let G := Localization.AtPrime P
  let x := algebraMap R K a*y
  have hxG : IsIntegral G x := hR.tower_top
  have hRG : (minpoly R x).map (algebraMap R G) = minpoly G x := by
    apply Polynomial.map_injective (algebraMap G J) (IsFractionRing.injective G J)
    rw [Polynomial.map_map, ← IsScalarTower.algebraMap_eq R G J,
      ← minpoly.isIntegrallyClosed_eq_field_fractions' J hR,
      ← minpoly.isIntegrallyClosed_eq_field_fractions' J hxG]
  have haG : algebraMap R G a ≠ 0 := by
    intro h
    apply ha.ne_zero
    exact (FaithfulSMul.algebraMap_injective R G) (h.trans (map_zero _).symm)
  have hscale : minpoly G x = (minpoly G y).scaleRoots (algebraMap R G a) := by
    have h := IsIntegrallyClosed.minpoly_smul (R := G) haG hG
    simpa only [Algebra.smul_def, ← IsScalarTower.algebraMap_apply R G K] using h
  have hlifts : minpoly G y ∈ Polynomial.lifts (algebraMap R G) := by
    apply (Polynomial.lifts_iff_coeff_lifts _).mpr
    intro i
    let n := (minpoly G y).natDegree-i
    have hc : algebraMap R G ((minpoly R x).coeff i) =
        (algebraMap R G a)^n * (minpoly G y).coeff i := by
      have h := congrArg (fun f : Polynomial G => f.coeff i) (hRG.trans hscale)
      rw [Polynomial.coeff_map,Polynomial.coeff_scaleRoots] at h
      exact h.trans (mul_comm _ _)
    have hd : a^n ∣ (minpoly R x).coeff i :=
      primePower_dvd_of_localized_dvd P a hP ha n _ ⟨_,hc⟩
    obtain ⟨b,hb⟩ := hd
    refine ⟨b,?_⟩
    apply mul_left_cancel₀ (pow_ne_zero n haG)
    calc
      (algebraMap R G a)^n * algebraMap R G b =
          algebraMap R G ((minpoly R x).coeff i) := by rw [hb,map_mul,map_pow]
      _ = (algebraMap R G a)^n * (minpoly G y).coeff i := hc
  obtain ⟨Q,hQ,-,hmon⟩ := Polynomial.lifts_and_degree_eq_and_monic hlifts (minpoly.monic hG)
  refine ⟨Q,hmon,?_⟩
  have h := minpoly.aeval G y
  rw [← hQ,Polynomial.aeval_map_algebraMap] at h
  exact h

end
end QEC.Coding.AlgebraicGeometry


namespace QEC.Coding.TannerLiftedProduct
noncomputable section
attribute [local instance] lpsOriginalGaussPrime_isPrime
attribute [local instance] gaussFiberBaseFieldAlgebra gaussFiberNormalizationCommRing
  gaussFiberNormalizationRing gaussFiberNormalizationSemiring verticalPrimeJAlgebra
  verticalPrimeBaseFieldAlgebra verticalPrimeNormalCommRing verticalPrimeNormalRing
  verticalPrimeNormalSemiring

lemma lpsOriginalIntegral_of_prime_multiple_and_gaussIntegral
    (N : ℕ) [NeZero N] (hN : 0 < N) (p : ℕ) [Fact p.Prime] :
    let := lpsOriginalJFractionEmbeddingQ.toAlgebra
    let := (lpsOriginalIntegerBaseToGeneratedField N hN).toAlgebra
    let := (lpsOriginalGaussBaseToGeneratedField N hN p).toAlgebra
    ∀ y : lpsOriginalGeneratedFunctionFieldQ N hN,
      IsIntegral (Polynomial ℤ) ((p : lpsOriginalGeneratedFunctionFieldQ N hN)*y) →
      IsIntegral (LPSOriginalGaussBase p) y → IsIntegral (Polynomial ℤ) y := by
  let := lpsOriginalJFractionEmbeddingQ.toAlgebra
  let instRK := (lpsOriginalIntegerBaseToGeneratedField N hN).toAlgebra
  let instGK := (lpsOriginalGaussBaseToGeneratedField N hN p).toAlgebra
  let R := Polynomial ℤ
  let G := LPSOriginalGaussBase p
  let K : Type := lpsOriginalGeneratedFunctionFieldQ N hN
  let J := FractionRing R
  let : SMul R K := instRK.toSMul
  let : SMul G K := instGK.toSMul
  let : IsScalarTower R G K := lpsOriginalGaussBase_scalarTower N hN p
  let : FaithfulSMul R K := (faithfulSMul_iff_algebraMap_injective R K).mpr
    ((algebraMap (FractionRing (Polynomial ℚ)) K).injective.comp
      lpsOriginalIntegerBaseFractionMap_injective)
  let instJK : Algebra J K := FractionRing.liftAlgebra R K
  let : SMul J K := instJK.toSMul
  let : IsScalarTower R J K := FractionRing.isScalarTower_liftAlgebra R K
  let : IsScalarTower G J K := .of_algebraMap_eq' (by
    apply IsLocalization.ringHom_ext (lpsOriginalGaussPrime p).primeCompl
    apply RingHom.ext
    intro f
    change algebraMap G K (algebraMap R G f) =
      algebraMap J K (algebraMap G J (algebraMap R G f))
    rw [← IsScalarTower.algebraMap_apply R G K,
      ← IsScalarTower.algebraMap_apply R G J,
      ← IsScalarTower.algebraMap_apply R J K])
  let : FaithfulSMul G K := (faithfulSMul_iff_algebraMap_injective G K).mpr (by
    rw [IsScalarTower.algebraMap_eq G J K]
    exact (algebraMap J K).injective.comp (IsFractionRing.injective G J))
  let : IsIntegrallyClosed G :=
    isIntegrallyClosed_of_isLocalization G (lpsOriginalGaussPrime p).primeCompl
      (lpsOriginalGaussPrime p).primeCompl_le_nonZeroDivisors
  change ∀ y : K, IsIntegral R ((p : K)*y) → IsIntegral G y → IsIntegral R y
  intro y hR hG
  have ha : Prime (Polynomial.C (p : ℤ)) := Polynomial.prime_C_iff.mpr
    (Int.prime_iff_natAbs_prime.mpr (by simpa using (Fact.out : p.Prime)))
  apply QEC.Coding.AlgebraicGeometry.integral_of_prime_multiple_and_localizedIntegral
    (lpsOriginalGaussPrime p) J K (Polynomial.C (p : ℤ))
    (lpsOriginalGaussPrime_eq_span p) ha y
  · simpa only [Polynomial.C_eq_natCast,map_natCast] using hR
  · exact hG

lemma lpsOriginalNormalZero_primeIdeal_radical
    (N : ℕ) [NeZero N] (hN : 0 < N) (p : ℕ) [Fact p.Prime] (hpN : ¬ p ∣ N) :
    let := lpsOriginalJFractionEmbeddingQ.toAlgebra
    let := (lpsOriginalIntegerBaseToGeneratedField N hN).toAlgebra
    (Ideal.span {(p : integralClosure (Polynomial ℤ)
      (lpsOriginalGeneratedFunctionFieldQ N hN))}).IsRadical := by
  let := lpsOriginalJFractionEmbeddingQ.toAlgebra
  let := (lpsOriginalIntegerBaseToGeneratedField N hN).toAlgebra
  let := (lpsOriginalGaussBaseToGeneratedField N hN p).toAlgebra
  let := lpsOriginalGaussBase_scalarTower N hN p
  let R := Polynomial ℤ
  let G := LPSOriginalGaussBase p
  let K : Type := lpsOriginalGeneratedFunctionFieldQ N hN
  let C : Type := integralClosure R K
  let D : Type := integralClosure G K
  let instCCommRing : CommRing C := verticalPrimeNormalCommRing N hN
  let : Ring C := instCCommRing.toRing
  let : CommSemiring C := instCCommRing.toCommSemiring
  let : Semiring C := instCCommRing.toCommSemiring.toSemiring
  let instRC : Algebra R C := (integralClosure R K).algebra
  let : SMul R C := instRC.toSMul
  let instDCommRing : CommRing D := gaussFiberNormalizationCommRing N hN p
  let : Ring D := instDCommRing.toRing
  let : CommSemiring D := instDCommRing.toCommSemiring
  let : Semiring D := instDCommRing.toCommSemiring.toSemiring
  let instGD : Algebra G D := (integralClosure G K).algebra
  let : SMul G D := instGD.toSMul
  let F : C →+* D := lpsOriginalIntegerNormalZeroToGaussNormalization N hN p
  let Jp : Ideal D := Ideal.span {(p : D)}
  have hmax : IsLocalRing.maximalIdeal G = Ideal.span {(p : G)} := by
    calc
      IsLocalRing.maximalIdeal G =
          (lpsOriginalGaussPrime p).map (algebraMap R G) :=
        (Localization.AtPrime.map_eq_maximalIdeal (I := lpsOriginalGaussPrime p)).symm
      _ = (Ideal.span {Polynomial.C (p : ℤ)}).map (algebraMap R G) :=
        congrArg (Ideal.map (algebraMap R G)) (lpsOriginalGaussPrime_eq_span p)
      _ = Ideal.span {(p : G)} := by
        rw [Ideal.map_span,Set.image_singleton]
        simp only [map_natCast]
  have hJ : Jp = (IsLocalRing.maximalIdeal G).map (algebraMap G D) := by
    rw [hmax,Ideal.map_span,Set.image_singleton,map_natCast]
  have hred : IsReduced (D ⧸
      (IsLocalRing.maximalIdeal G).map (algebraMap G D)) :=
    lpsOriginalNormalization_gaussSpecialFiber_reduced N hN p hpN
  have hradD : ((IsLocalRing.maximalIdeal G).map (algebraMap G D)).IsRadical :=
    (Ideal.isRadical_iff_quotient_reduced _).mpr hred
  have hrad : Jp.IsRadical := hJ.symm ▸ hradD
  change (Ideal.span {(p : C)}).IsRadical
  intro x hx
  obtain ⟨n,hxn⟩ := hx
  have hxD : F x ∈ Jp := by
    apply hrad
    refine ⟨n,?_⟩
    have hmap := Ideal.mem_map_of_mem F hxn
    simpa only [Ideal.map_span,Set.image_singleton,map_natCast,map_pow] using hmap
  obtain ⟨d,hd⟩ := Ideal.mem_span_singleton.mp hxD
  have heq : (p : K)*d.val = x.val := by
    have h := congrArg (fun z : D => z.val) hd
    exact h.symm
  have hR : IsIntegral R ((p : K)*d.val) := heq.symm ▸ x.property
  have hi : IsIntegral R d.val :=
    lpsOriginalIntegral_of_prime_multiple_and_gaussIntegral N hN p d.val hR d.property
  apply Ideal.mem_span_singleton.mpr
  refine ⟨⟨d.val,hi⟩,?_⟩
  apply Subtype.ext
  exact heq.symm

lemma lpsOriginalNormalZero_specialFiber_reduced
    (N : ℕ) [NeZero N] (hN : 0 < N) (p : ℕ) [Fact p.Prime] (hpN : ¬ p ∣ N) :
    let := lpsOriginalJFractionEmbeddingQ.toAlgebra
    let := (lpsOriginalIntegerBaseToGeneratedField N hN).toAlgebra
    IsReduced (integralClosure (Polynomial ℤ) (lpsOriginalGeneratedFunctionFieldQ N hN) ⧸
      Ideal.span {(p : integralClosure (Polynomial ℤ) (lpsOriginalGeneratedFunctionFieldQ N hN))}) := by
  let := lpsOriginalJFractionEmbeddingQ.toAlgebra
  let := (lpsOriginalIntegerBaseToGeneratedField N hN).toAlgebra
  exact (Ideal.isRadical_iff_quotient_reduced _).mp
    (lpsOriginalNormalZero_primeIdeal_radical N hN p hpN)

end
end QEC.Coding.TannerLiftedProduct
