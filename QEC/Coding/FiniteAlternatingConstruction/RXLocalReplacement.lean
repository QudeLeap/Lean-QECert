private noncomputable def rxLocalCellZBoundaryIncidentEdgeA2Free
    (P : TannerSquarePresentation) (S : OddScale) (oldX : P.X)
    (cell : DoubleCylinderFace P oldX S)
    (vertex : ZStarBoundaryVertex (rxReplacementPresentation P S)
      (Sum.inl (Sum.inl ⟨oldX, cell⟩))) :
    {owned : ZStarBoundaryEdge (rxReplacementPresentation P S)
        (Sum.inl (Sum.inl ⟨oldX, cell⟩)) × Two //
      BDL26TannerLocalRegularity.edgeEndpoint
        (zBoundaryEdgeStart (rxReplacementPresentation P S)
          (Sum.inl (Sum.inl ⟨oldX, cell⟩)))
        (zBoundaryEdgeEnd (rxReplacementPresentation P S)
          (Sum.inl (Sum.inl ⟨oldX, cell⟩)))
        owned.1 owned.2 = vertex} := by
  rcases vertex with ⟨value, member⟩
  rcases value with newX | newQ | impossible
  · by_cases h00 : newX = rxLocalCellXAt P S oldX cell (0, 0)
    · exact rxLocalCellZBoundaryOwnedAtXCorner
        P S oldX cell newX member (0, 0) h00
    · by_cases h01 : newX = rxLocalCellXAt P S oldX cell (0, 1)
      · exact rxLocalCellZBoundaryOwnedAtXCorner
          P S oldX cell newX member (0, 1) h01
      · by_cases h10 : newX = rxLocalCellXAt P S oldX cell (1, 0)
        · exact rxLocalCellZBoundaryOwnedAtXCorner
            P S oldX cell newX member (1, 0) h10
        · have h11 := (((rxLocalCellBoundaryX_cases
              P S oldX cell newX member).resolve_left h00)
              |>.resolve_left h01).resolve_left h10
          exact rxLocalCellZBoundaryOwnedAtXCorner
            P S oldX cell newX member (1, 1) h11
  · have cases := rxLocalCellBoundaryQ_cases
      P S oldX cell newQ member
    by_cases h000 : newQ = rxLocalCellQAt P S oldX cell (0, 0) 0
    · exact rxLocalCellZBoundaryOwnedAtQCorner
        P S oldX cell newQ member (0, 0) 0 h000
    · by_cases h001 : newQ = rxLocalCellQAt P S oldX cell (0, 0) 1
      · exact rxLocalCellZBoundaryOwnedAtQCorner
          P S oldX cell newQ member (0, 0) 1 h001
      · by_cases h010 : newQ = rxLocalCellQAt P S oldX cell (0, 1) 0
        · exact rxLocalCellZBoundaryOwnedAtQCorner
            P S oldX cell newQ member (0, 1) 0 h010
        · by_cases h011 : newQ = rxLocalCellQAt P S oldX cell (0, 1) 1
          · exact rxLocalCellZBoundaryOwnedAtQCorner
              P S oldX cell newQ member (0, 1) 1 h011
          · by_cases h100 : newQ = rxLocalCellQAt P S oldX cell (1, 0) 0
            · exact rxLocalCellZBoundaryOwnedAtQCorner
                P S oldX cell newQ member (1, 0) 0 h100
            · by_cases h101 : newQ = rxLocalCellQAt P S oldX cell (1, 0) 1
              · exact rxLocalCellZBoundaryOwnedAtQCorner
                  P S oldX cell newQ member (1, 0) 1 h101
              · by_cases h110 : newQ = rxLocalCellQAt P S oldX cell (1, 1) 0
                · exact rxLocalCellZBoundaryOwnedAtQCorner
                    P S oldX cell newQ member (1, 1) 0 h110
                · have remaining001 := cases.resolve_left h000
                  have remaining010 := remaining001.resolve_left h001
                  have remaining011 := remaining010.resolve_left h010
                  have remaining100 := remaining011.resolve_left h011
                  have remaining101 := remaining100.resolve_left h100
                  have remaining110 := remaining101.resolve_left h101
                  have h111 := remaining110.resolve_left h110
                  exact rxLocalCellZBoundaryOwnedAtQCorner
                    P S oldX cell newQ member (1, 1) 1 h111
  · simp [zStarBoundaryVertexMember] at member

private noncomputable def rxQEdgeZBoundaryOwnedAtXEndpoint
    (P : TannerSquarePresentation) (S : OddScale)
    (qEdge : Σ q : P.Q, QDoubleCylinderEdge P q S)
    (newX : RX0 P S)
    (member : zStarBoundaryVertexMember (rxReplacementPresentation P S)
      (Sum.inl (Sum.inr qEdge)) (Vertex.x newX) = true)
    (oldX : P.X) (hxq : P.xq oldX qEdge.1 = true) (endpoint : Two)
    (h : newX = glueFaceX P S
      ⟨(⟨(oldX, qEdge.1), hxq⟩ : XQEdge P), qEdge.2, endpoint⟩) :
    {owned : ZStarBoundaryEdge (rxReplacementPresentation P S)
        (Sum.inl (Sum.inr qEdge)) × Two //
      BDL26TannerLocalRegularity.edgeEndpoint
        (zBoundaryEdgeStart (rxReplacementPresentation P S)
          (Sum.inl (Sum.inr qEdge)))
        (zBoundaryEdgeEnd (rxReplacementPresentation P S)
          (Sum.inl (Sum.inr qEdge))) owned.1 owned.2 =
            ⟨Vertex.x newX, member⟩} := by
  let face := rxQEdgeGlueZStarFace P S qEdge oldX hxq endpoint
  have hface : newX = rxFaceX P S face.1 := by
    simpa [face, rxQEdgeGlueZStarFace, rxFaceX] using h
  let targetMember : zStarBoundaryVertexMember
      (rxReplacementPresentation P S) (Sum.inl (Sum.inr qEdge))
      (Vertex.x (rxFaceX P S face.1)) = true := by
    simpa only [← hface] using member
  let owned := rxZFaceBoundaryOwnedAtX P S
    (Sum.inl (Sum.inr qEdge)) face 0 targetMember
  exact rxZBoundaryOwnedTransport P S (Sum.inl (Sum.inr qEdge))
    (congrArg Vertex.x hface) member targetMember owned

private noncomputable def rxQEdgeZBoundaryOwnedAtLocalQ
    (P : TannerSquarePresentation) (S : OddScale)
    (qEdge : Σ q : P.Q, QDoubleCylinderEdge P q S)
    (localEdge : Σ x : P.X, DoubleCylinderEdge P x S)
    (member : zStarBoundaryVertexMember (rxReplacementPresentation P S)
      (Sum.inl (Sum.inr qEdge)) (Vertex.q (Sum.inl localEdge)) = true) :
    {owned : ZStarBoundaryEdge (rxReplacementPresentation P S)
        (Sum.inl (Sum.inr qEdge)) × Two //
      BDL26TannerLocalRegularity.edgeEndpoint
        (zBoundaryEdgeStart (rxReplacementPresentation P S)
          (Sum.inl (Sum.inr qEdge)))
        (zBoundaryEdgeEnd (rxReplacementPresentation P S)
          (Sum.inl (Sum.inr qEdge))) owned.1 owned.2 =
            ⟨Vertex.q (Sum.inl localEdge), member⟩} := by
  let hxq := rxQEdgeBoundaryLocalQ_incidence P S qEdge localEdge member
  let face := rxQEdgeGlueZStarFace P S qEdge localEdge.1 hxq 0
  have hedge := rxQEdgeBoundaryLocalQ_edge P S qEdge localEdge member
  have hface : (Sum.inl localEdge : RX1 P S) = rxFaceQ P S face.1 0 := by
    change Sum.inl localEdge = Sum.inl
      ⟨localEdge.1,
        qToXDoubleCylinderEdgeRaw P qEdge.1 localEdge.1 hxq S qEdge.2⟩
    apply congrArg Sum.inl
    rw [Sigma.ext_iff]
    exact ⟨rfl, by simpa only [heq_eq_eq] using hedge⟩
  let targetMember : zStarBoundaryVertexMember
      (rxReplacementPresentation P S) (Sum.inl (Sum.inr qEdge))
      (Vertex.q (rxFaceQ P S face.1 0)) = true := by
    simpa only [← hface] using member
  let owned := rxZFaceBoundaryOwnedAtQ P S
    (Sum.inl (Sum.inr qEdge)) face 0 targetMember
  exact rxZBoundaryOwnedTransport P S (Sum.inl (Sum.inr qEdge))
    (congrArg Vertex.q hface) member targetMember owned

private noncomputable def rxQEdgeZBoundaryOwnedAtQVertexEndpoint
    (P : TannerSquarePresentation) (A : TannerSquareAdmissible P)
    (S : OddScale) (qEdge : Σ q : P.Q, QDoubleCylinderEdge P q S)
    (qVertex : Σ q : P.Q, QDoubleCylinderVertex P q S)
    (member : zStarBoundaryVertexMember (rxReplacementPresentation P S)
      (Sum.inl (Sum.inr qEdge)) (Vertex.q (Sum.inr qVertex)) = true)
    (endpoint : Two)
    (h : qVertex = ⟨qEdge.1,
      edgeEndpoint
        (qDoubleCylinderEdgeStart P qEdge.1 S)
        (qDoubleCylinderEdgeEnd P qEdge.1 S) qEdge.2 endpoint⟩) :
    {owned : ZStarBoundaryEdge (rxReplacementPresentation P S)
        (Sum.inl (Sum.inr qEdge)) × Two //
      BDL26TannerLocalRegularity.edgeEndpoint
        (zBoundaryEdgeStart (rxReplacementPresentation P S)
          (Sum.inl (Sum.inr qEdge)))
        (zBoundaryEdgeEnd (rxReplacementPresentation P S)
          (Sum.inl (Sum.inr qEdge))) owned.1 owned.2 =
            ⟨Vertex.q (Sum.inr qVertex), member⟩} := by
  let oldX := (A.xqRoot qEdge.1).1
  let hxq := (A.xqRoot qEdge.1).2
  let face := rxQEdgeGlueZStarFace P S qEdge oldX hxq endpoint
  have hface : (Sum.inr qVertex : RX1 P S) =
      rxFaceQ P S face.1 1 := by
    apply congrArg Sum.inr
    simpa [face, glueFaceQ1] using h
  let targetMember : zStarBoundaryVertexMember
      (rxReplacementPresentation P S) (Sum.inl (Sum.inr qEdge))
      (Vertex.q (rxFaceQ P S face.1 1)) = true := by
    simpa only [← hface] using member
  let owned := rxZFaceBoundaryOwnedAtQ P S
    (Sum.inl (Sum.inr qEdge)) face 1 targetMember
  exact rxZBoundaryOwnedTransport P S (Sum.inl (Sum.inr qEdge))
    (congrArg Vertex.q hface) member targetMember owned

private noncomputable def rxQEdgeZBoundaryIncidentEdgeA2Free
    (P : TannerSquarePresentation) (A : TannerSquareAdmissible P)
    (S : OddScale) (qEdge : Σ q : P.Q, QDoubleCylinderEdge P q S)
    (vertex : ZStarBoundaryVertex (rxReplacementPresentation P S)
      (Sum.inl (Sum.inr qEdge))) :
    {owned : ZStarBoundaryEdge (rxReplacementPresentation P S)
        (Sum.inl (Sum.inr qEdge)) × Two //
      BDL26TannerLocalRegularity.edgeEndpoint
        (zBoundaryEdgeStart (rxReplacementPresentation P S)
          (Sum.inl (Sum.inr qEdge)))
        (zBoundaryEdgeEnd (rxReplacementPresentation P S)
          (Sum.inl (Sum.inr qEdge))) owned.1 owned.2 = vertex} := by
  rcases vertex with ⟨value, member⟩
  rcases value with newX | newQ | impossible
  · let hxq := rxQEdgeBoundaryX_incidence P S qEdge newX member
    by_cases hzero : newX = glueFaceX P S
        ⟨(⟨(newX.1, qEdge.1), hxq⟩ : XQEdge P), qEdge.2, 0⟩
    · exact rxQEdgeZBoundaryOwnedAtXEndpoint
        P S qEdge newX member newX.1 hxq 0 hzero
    · have hone := (rxQEdgeBoundaryX_endpoints P S qEdge newX member)
          |>.resolve_left hzero
      exact rxQEdgeZBoundaryOwnedAtXEndpoint
        P S qEdge newX member newX.1 hxq 1 hone
  · rcases newQ with localEdge | qVertex
    · exact rxQEdgeZBoundaryOwnedAtLocalQ
        P S qEdge localEdge member
    · by_cases hstart : qVertex = ⟨qEdge.1,
          qDoubleCylinderEdgeStart P qEdge.1 S qEdge.2⟩
      · exact rxQEdgeZBoundaryOwnedAtQVertexEndpoint
          P A S qEdge qVertex member 0 (by simpa [edgeEndpoint] using hstart)
      · have hend := (rxQEdgeBoundaryQVertex_endpoints
            P S qEdge qVertex member).resolve_left hstart
        exact rxQEdgeZBoundaryOwnedAtQVertexEndpoint
          P A S qEdge qVertex member 1 (by simpa [edgeEndpoint] using hend)
  · simp [zStarBoundaryVertexMember] at member

private noncomputable def rxOldZBoundaryIncidentEdgeA2
    (P : TannerSquarePresentation) (A2 : TannerSquareAdmissibleV2 P)
    (S : OddScale) (oldZ : P.Z) (copy : Two)
    (vertex : ZStarBoundaryVertex (rxReplacementPresentation P S)
      (Sum.inr (oldZ, copy))) :
    {owned : ZStarBoundaryEdge (rxReplacementPresentation P S)
        (Sum.inr (oldZ, copy)) × Two //
      BDL26TannerLocalRegularity.edgeEndpoint
        (zBoundaryEdgeStart (rxReplacementPresentation P S)
          (Sum.inr (oldZ, copy)))
        (zBoundaryEdgeEnd (rxReplacementPresentation P S)
          (Sum.inr (oldZ, copy))) owned.1 owned.2 = vertex} := by
  let oldVertex := rxOldZBoundaryVertexProject P S oldZ copy vertex
  let selected := A2.zBoundaryIncidentEdge oldZ oldVertex
  rcases selected with ⟨⟨oldEdge, oldBit⟩, hendpoint⟩
  let successorEdge := rxOldZBoundaryEdgeMap P S oldZ copy oldEdge
  have mappedVertex := rxOldZBoundaryVertexMap_project
    P S oldZ copy vertex
  rcases vertex with ⟨value, member⟩
  rcases value with newX | newQ | impossible
  · exact rxTwoElim (motive := fun bit =>
        BDL26TannerLocalRegularity.edgeEndpoint
          (zBoundaryEdgeStart P oldZ) (zBoundaryEdgeEnd P oldZ)
          oldEdge bit = oldVertex →
        {owned : ZStarBoundaryEdge (rxReplacementPresentation P S)
            (Sum.inr (oldZ, copy)) × Two //
          BDL26TannerLocalRegularity.edgeEndpoint
            (zBoundaryEdgeStart (rxReplacementPresentation P S)
              (Sum.inr (oldZ, copy)))
            (zBoundaryEdgeEnd (rxReplacementPresentation P S)
              (Sum.inr (oldZ, copy))) owned.1 owned.2 =
                ⟨Vertex.x newX, member⟩}) (fun hendpoint => by
      refine ⟨(successorEdge, 0), ?_⟩
      rw [BDL26TannerLocalRegularity.edgeEndpoint_zero]
      calc
        zBoundaryEdgeStart (rxReplacementPresentation P S)
            (Sum.inr (oldZ, copy)) successorEdge =
            rxOldZBoundaryVertexMap P S oldZ copy
              (zBoundaryEdgeStart P oldZ oldEdge) :=
          rxOldZBoundaryEdgeMap_start P S oldZ copy oldEdge
        _ = rxOldZBoundaryVertexMap P S oldZ copy oldVertex := by
          rw [BDL26TannerLocalRegularity.edgeEndpoint_zero] at hendpoint
          exact congrArg (rxOldZBoundaryVertexMap P S oldZ copy) hendpoint
        _ = ⟨Vertex.x newX, member⟩ := mappedVertex) (fun hendpoint => by
      have hwrong : zBoundaryEdgeEnd (rxReplacementPresentation P S)
          (Sum.inr (oldZ, copy)) successorEdge =
          ⟨Vertex.x newX, member⟩ := by
        calc
          zBoundaryEdgeEnd (rxReplacementPresentation P S)
              (Sum.inr (oldZ, copy)) successorEdge =
              rxOldZBoundaryVertexMap P S oldZ copy
                (zBoundaryEdgeEnd P oldZ oldEdge) :=
            rxOldZBoundaryEdgeMap_end P S oldZ copy oldEdge
          _ = rxOldZBoundaryVertexMap P S oldZ copy oldVertex := by
            rw [BDL26TannerLocalRegularity.edgeEndpoint_one] at hendpoint
            exact congrArg (rxOldZBoundaryVertexMap P S oldZ copy) hendpoint
          _ = ⟨Vertex.x newX, member⟩ := mappedVertex
      have hraw := congrArg Subtype.val hwrong
      rcases oldEdge with ⟨rawEdge, oldEdgeMember⟩
      rcases rawEdge with xqEdge | impossibleEdge
      · simp [successorEdge, rxOldZBoundaryEdgeMap,
          zBoundaryEdgeEnd] at hraw
      · simp [zStarBoundaryEdgeMember] at oldEdgeMember) oldBit hendpoint
  · exact rxTwoElim (motive := fun bit =>
        BDL26TannerLocalRegularity.edgeEndpoint
          (zBoundaryEdgeStart P oldZ) (zBoundaryEdgeEnd P oldZ)
          oldEdge bit = oldVertex →
        {owned : ZStarBoundaryEdge (rxReplacementPresentation P S)
            (Sum.inr (oldZ, copy)) × Two //
          BDL26TannerLocalRegularity.edgeEndpoint
            (zBoundaryEdgeStart (rxReplacementPresentation P S)
              (Sum.inr (oldZ, copy)))
            (zBoundaryEdgeEnd (rxReplacementPresentation P S)
              (Sum.inr (oldZ, copy))) owned.1 owned.2 =
                ⟨Vertex.q newQ, member⟩}) (fun hendpoint => by
      have hwrong : zBoundaryEdgeStart (rxReplacementPresentation P S)
          (Sum.inr (oldZ, copy)) successorEdge =
          ⟨Vertex.q newQ, member⟩ := by
        calc
          zBoundaryEdgeStart (rxReplacementPresentation P S)
              (Sum.inr (oldZ, copy)) successorEdge =
              rxOldZBoundaryVertexMap P S oldZ copy
                (zBoundaryEdgeStart P oldZ oldEdge) :=
            rxOldZBoundaryEdgeMap_start P S oldZ copy oldEdge
          _ = rxOldZBoundaryVertexMap P S oldZ copy oldVertex := by
            rw [BDL26TannerLocalRegularity.edgeEndpoint_zero] at hendpoint
            exact congrArg (rxOldZBoundaryVertexMap P S oldZ copy) hendpoint
          _ = ⟨Vertex.q newQ, member⟩ := mappedVertex
      have hraw := congrArg Subtype.val hwrong
      rcases oldEdge with ⟨rawEdge, oldEdgeMember⟩
      rcases rawEdge with xqEdge | impossibleEdge
      · simp [successorEdge, rxOldZBoundaryEdgeMap,
          zBoundaryEdgeStart] at hraw
      · simp [zStarBoundaryEdgeMember] at oldEdgeMember) (fun hendpoint => by
      refine ⟨(successorEdge, 1), ?_⟩
      rw [BDL26TannerLocalRegularity.edgeEndpoint_one]
      calc
        zBoundaryEdgeEnd (rxReplacementPresentation P S)
            (Sum.inr (oldZ, copy)) successorEdge =
            rxOldZBoundaryVertexMap P S oldZ copy
              (zBoundaryEdgeEnd P oldZ oldEdge) :=
          rxOldZBoundaryEdgeMap_end P S oldZ copy oldEdge
        _ = rxOldZBoundaryVertexMap P S oldZ copy oldVertex := by
          rw [BDL26TannerLocalRegularity.edgeEndpoint_one] at hendpoint
          exact congrArg (rxOldZBoundaryVertexMap P S oldZ copy) hendpoint
        _ = ⟨Vertex.q newQ, member⟩ := mappedVertex) oldBit hendpoint
  · simp [zStarBoundaryVertexMember] at member

/-- Type-valued endpoint decoder for all sixteen frozen successor Z rows. -/
noncomputable def rxReplacementZBoundaryIncidentEdge
    (P : TannerSquarePresentation) (A4 : TannerSquareAdmissibleV4 P)
    (S : OddScale) (z : (rxReplacementPresentation P S).Z)
    (vertex : ZStarBoundaryVertex (rxReplacementPresentation P S) z) :
    {owned : ZStarBoundaryEdge (rxReplacementPresentation P S) z × Two //
      BDL26TannerLocalRegularity.edgeEndpoint
        (zBoundaryEdgeStart (rxReplacementPresentation P S) z)
        (zBoundaryEdgeEnd (rxReplacementPresentation P S) z)
        owned.1 owned.2 = vertex} := by
  let A2 := A4.toTannerSquareAdmissibleV3.toTannerSquareAdmissibleV2
  let A := A2.toTannerSquareAdmissible
  rcases z with localOrQEdge | oldZ
  · rcases localOrQEdge with localCell | qEdge
    · exact rxLocalCellZBoundaryIncidentEdgeA2Free
        P S localCell.1 localCell.2 vertex
    · exact rxQEdgeZBoundaryIncidentEdgeA2Free
        P A S qEdge vertex
  · exact rxOldZBoundaryIncidentEdgeA2
      P A2 S oldZ.1 oldZ.2 vertex

/-- The endpoint-tagged admissibility package for the RX successor.
Radial and boundary-face owner data remain separate V3 and V4 contracts. -/
noncomputable def rxReplacementAdmissibleV2
    (P : TannerSquarePresentation) (A4 : TannerSquareAdmissibleV4 P)
    (R : TannerSquareCellularRegular P) (S : OddScale) :
    TannerSquareAdmissibleV2 (rxReplacementPresentation P S) where
  toTannerSquareAdmissible := rxReplacementAdmissible P R A4 S
  xBoundaryIncidentEdge := rxReplacementXBoundaryIncidentEdge P R A4 S
  zBoundaryIncidentEdge := rxReplacementZBoundaryIncidentEdge P A4 S

/-! ### Successor V3 X-local radial owner row

This first V3 checkpoint covers only the `F_local_X` row.  Successor star
membership is used to normalize the stored X coordinate, and X-Q incidence
is eliminated only inside the Prop-valued endpoint exhaustion theorem.  The
face and ordered corner returned below come from the concrete local-edge
constructor and the input V3 owner used by `rxLocalEdgeCornerOwner`. -/

/-- The X endpoint stored by a successor radial edge is its requested
X-star coordinate. -/
private theorem rxXRadialEdge_ownerX
    (P : TannerSquarePresentation) (S : OddScale)
    (x : (rxReplacementPresentation P S).X)
    (edge : XQEdge (rxReplacementPresentation P S))
    (member : xStarEdgeMember (rxReplacementPresentation P S) x
      (Sum.inl edge) = true) :
    edge.1.1 = x := by
  let starEdge : XStarEdge (rxReplacementPresentation P S) x :=
    ⟨Sum.inl edge, member⟩
  have startMember :=
    (xStarEdgeStart (rxReplacementPresentation P S) x starEdge).2
  change decide (edge.1.1 = x) = true at startMember
  exact of_decide_eq_true startMember

/-- If a successor X coordinate is incident to a stored X-local edge, it is
one of that edge's two explicit endpoints.  Face existence is consumed only
inside this proposition. -/
private theorem rxLocalEdgeXCoordinate_endpoint_cases
    (P : TannerSquarePresentation) (S : OddScale)
    (xCoordinate : RX0 P S) (oldX : P.X)
    (edge : DoubleCylinderEdge P oldX S)
    (incidence : rxXQIncidence P S xCoordinate
      (Sum.inl ⟨oldX, edge⟩) = true) :
    xCoordinate =
        ⟨oldX, tannerDoubleCylinderEdgeStart P oldX S edge⟩ ∨
      xCoordinate =
        ⟨oldX, tannerDoubleCylinderEdgeEnd P oldX S edge⟩ := by
  obtain ⟨face, corner, hfaceX, hfaceQ⟩ :=
    (rxXQIncidence_eq_true_iff P S xCoordinate
      (Sum.inl ⟨oldX, edge⟩)).1 incidence
  obtain ⟨endpoint, hendpoint⟩ :=
    rxFaceX_eq_endpoint_of_faceQ_eq_xEdge
      P S face corner oldX edge hfaceQ
  have hx : xCoordinate =
      ⟨oldX, edgeEndpoint
        (tannerDoubleCylinderEdgeStart P oldX S)
        (tannerDoubleCylinderEdgeEnd P oldX S) edge endpoint⟩ :=
    hfaceX.symm.trans hendpoint
  exact rxTwoElim (motive := fun endpoint =>
      xCoordinate =
          ⟨oldX, edgeEndpoint
            (tannerDoubleCylinderEdgeStart P oldX S)
            (tannerDoubleCylinderEdgeEnd P oldX S) edge endpoint⟩ →
        xCoordinate =
            ⟨oldX, tannerDoubleCylinderEdgeStart P oldX S edge⟩ ∨
          xCoordinate =
            ⟨oldX, tannerDoubleCylinderEdgeEnd P oldX S edge⟩)
    (fun h => Or.inl (by simpa [edgeEndpoint] using h))
    (fun h => Or.inr (by simpa [edgeEndpoint] using h)) endpoint hx

/-- Materialize the local successor face at one explicit endpoint of its
stored X-local edge. -/
private noncomputable def rxLocalEdgeXRadialFaceOwnerAtEndpoint
    (P : TannerSquarePresentation) (A3 : TannerSquareAdmissibleV3 P)
    (S : OddScale) (xCoordinate : RX0 P S) (oldX : P.X)
    (edge : DoubleCylinderEdge P oldX S)
    (incidence : rxXQIncidence P S xCoordinate
      (Sum.inl ⟨oldX, edge⟩) = true)
    (starMember : xStarEdgeMember (rxReplacementPresentation P S) xCoordinate
      (Sum.inl
        (⟨(xCoordinate, Sum.inl ⟨oldX, edge⟩), incidence⟩ :
          XQEdge (rxReplacementPresentation P S))) = true)
    (endpoint : Two)
    (hendpoint : xCoordinate =
      ⟨oldX, edgeEndpoint
        (tannerDoubleCylinderEdgeStart P oldX S)
        (tannerDoubleCylinderEdgeEnd P oldX S) edge endpoint⟩) :
    {owner : XStarFace (rxReplacementPresentation P S) xCoordinate × Two //
      xStarFaceXQEdge (rxReplacementPresentation P S) xCoordinate
          owner.1 owner.2 =
        ⟨Sum.inl
          (⟨(xCoordinate, Sum.inl ⟨oldX, edge⟩), incidence⟩ :
            XQEdge (rxReplacementPresentation P S)), starMember⟩} := by
  obtain ⟨⟨⟨ownerX, localCell, materialCorner⟩, qCorner⟩, hq⟩ :=
    rxLocalEdgeCornerOwner P A3 S oldX edge
  have hsigma : (⟨ownerX,
      if qCorner = 0 then
        localFaceQ0EdgeAt P ownerX S localCell materialCorner
      else localFaceQ1EdgeAt P ownerX S localCell materialCorner⟩ :
        Σ ownerX : P.X, DoubleCylinderEdge P ownerX S) =
      ⟨oldX, edge⟩ := by
    fin_cases qCorner
    · simpa [localFaceQAt, localFaceQ0, localFaceQ0Edge] using hq
    · simpa [localFaceQAt, localFaceQ1, localFaceQ1Edge] using hq
  have hownerX : ownerX = oldX := congrArg Sigma.fst hsigma
  subst ownerX
  have hedge :
      (if qCorner = 0 then
          localFaceQ0EdgeAt P oldX S localCell materialCorner
        else localFaceQ1EdgeAt P oldX S localCell materialCorner) = edge :=
    eq_of_heq (Sigma.mk.inj_iff.mp hsigma).2
  let newMaterial := localMaterialCornerAtEndpoint
    P oldX S localCell materialCorner qCorner endpoint
  let localFace : RXLocalFace P S := ⟨oldX, localCell, newMaterial⟩
  let rawFace : RXFace P S := Sum.inl localFace
  have hfaceX : rxFaceX P S rawFace = xCoordinate := by
    change localFaceX P S localFace = xCoordinate
    rw [show localFaceX P S localFace =
        ⟨oldX, edgeEndpoint
          (tannerDoubleCylinderEdgeStart P oldX S)
          (tannerDoubleCylinderEdgeEnd P oldX S)
          (if qCorner = 0 then
            localFaceQ0EdgeAt P oldX S localCell materialCorner
          else localFaceQ1EdgeAt P oldX S localCell materialCorner)
          endpoint⟩ by
      simpa [localFace, newMaterial] using
        localFaceX_atEndpoint P oldX S localCell materialCorner
          qCorner endpoint]
    rw [hedge]
    exact hendpoint.symm
  have hfaceQ : rxFaceQ P S rawFace qCorner =
      Sum.inl ⟨oldX, edge⟩ := by
    change localFaceQAt P S localFace qCorner = Sum.inl ⟨oldX, edge⟩
    calc
      localFaceQAt P S localFace qCorner =
          localFaceQAt P S ⟨oldX, localCell, materialCorner⟩ qCorner := by
        simpa [localFace, newMaterial, localFaceQAt] using
          localFaceQ_atEndpoint P oldX S localCell materialCorner
            qCorner endpoint
      _ = Sum.inl ⟨oldX, edge⟩ := hq
  let starFace : XStarFace
      (rxReplacementPresentation P S) xCoordinate :=
    ⟨rawFace, by
      simp only [xStarFaceMember, decide_eq_true_eq]
      rw [show (rxReplacementPresentation P S).faceX = rxFaceX P S from rfl]
      exact hfaceX⟩
  refine ⟨(starFace, qCorner), ?_⟩
  apply Subtype.ext
  apply congrArg Sum.inl
  apply Subtype.ext
  exact Prod.ext hfaceX hfaceQ

/-- Choice-free `F_local_X` producer for the first successor V3 X-owner row.
It covers every concrete double-cylinder edge constructor; only the retained
old X-Q radial segment delegates to the input V3 owner. -/
private noncomputable def rxLocalEdgeXRadialFaceOwner
    (P : TannerSquarePresentation) (A3 : TannerSquareAdmissibleV3 P)
    (S : OddScale) (xCoordinate : RX0 P S) (oldX : P.X)
    (edge : DoubleCylinderEdge P oldX S)
    (incidence : rxXQIncidence P S xCoordinate
      (Sum.inl ⟨oldX, edge⟩) = true)
    (starMember : xStarEdgeMember (rxReplacementPresentation P S) xCoordinate
      (Sum.inl
        (⟨(xCoordinate, Sum.inl ⟨oldX, edge⟩), incidence⟩ :
          XQEdge (rxReplacementPresentation P S))) = true) :
    {owner : XStarFace (rxReplacementPresentation P S) xCoordinate × Two //
      xStarFaceXQEdge (rxReplacementPresentation P S) xCoordinate
          owner.1 owner.2 =
        ⟨Sum.inl
          (⟨(xCoordinate, Sum.inl ⟨oldX, edge⟩), incidence⟩ :
            XQEdge (rxReplacementPresentation P S)), starMember⟩} := by
  by_cases hstart : xCoordinate =
      ⟨oldX, tannerDoubleCylinderEdgeStart P oldX S edge⟩
  · exact rxLocalEdgeXRadialFaceOwnerAtEndpoint
      P A3 S xCoordinate oldX edge incidence starMember 0
      (by simpa [edgeEndpoint] using hstart)
  · have hend :=
      (rxLocalEdgeXCoordinate_endpoint_cases
        P S xCoordinate oldX edge incidence).resolve_left hstart
    exact rxLocalEdgeXRadialFaceOwnerAtEndpoint
      P A3 S xCoordinate oldX edge incidence starMember 1
      (by simpa [edgeEndpoint] using hend)

/-- A successor X-Q incidence at a Q-cylinder vertex retains the old X-Q
incidence determined by the requested successor X coordinate. -/
private theorem rxQVertexXRadial_oldXQ
    (P : TannerSquarePresentation) (S : OddScale)
    (xCoordinate : RX0 P S) (q : P.Q)
    (vertex : QDoubleCylinderVertex P q S)
    (incidence : rxXQIncidence P S xCoordinate
      (Sum.inr ⟨q, vertex⟩) = true) :
    P.xq xCoordinate.1 q = true := by
  obtain ⟨face, corner, hx, hq⟩ :=
    (rxXQIncidence_eq_true_iff P S xCoordinate
      (Sum.inr ⟨q, vertex⟩)).1 incidence
  rcases face with localFace | glue | oldFace
  · rcases localFace with ⟨oldX, cell, material⟩
    fin_cases corner <;> simp [rxFaceQ, localFaceQAt, localFaceQ0,
      localFaceQ1] at hq
  · rcases glue with ⟨edge, qEdge, endpoint⟩
    have hx' : edge.1.1 = xCoordinate.1 :=
      congrArg Sigma.fst hx
    fin_cases corner
    · simp [rxFaceQ, glueFaceQ0] at hq
    · have hq' : edge.1.2 = q :=
        congrArg Sigma.fst (Sum.inr.inj hq)
      simpa [hx', hq'] using edge.2
  · rcases oldFace with ⟨face, copy⟩
    have hx' : P.faceX face = xCoordinate.1 :=
      congrArg Sigma.fst hx
    have hq' : P.faceQ face corner = q :=
      congrArg Sigma.fst (Sum.inr.inj hq)
    simpa [hx', hq'] using P.data.faceQ_xq face corner

/-- Any explicit Q-cylinder edge endpoint equal to the requested Q vertex
has the same X-boundary image as the successor X-Q incidence.  Incidence
witnesses are eliminated only in this proposition. -/
private theorem rxQVertexGlueFaceX_eq
    (P : TannerSquarePresentation) (S : OddScale)
    (xCoordinate : RX0 P S) (q : P.Q)
    (vertex : QDoubleCylinderVertex P q S)
    (incidence : rxXQIncidence P S xCoordinate
      (Sum.inr ⟨q, vertex⟩) = true)
    (hxq : P.xq xCoordinate.1 q = true)
    (qEdge : QDoubleCylinderEdge P q S) (endpoint : Two)
    (hendpoint : edgeEndpoint
      (qDoubleCylinderEdgeStart P q S)
      (qDoubleCylinderEdgeEnd P q S) qEdge endpoint = vertex) :
    glueFaceX P S
        ⟨(⟨(xCoordinate.1, q), hxq⟩ : XQEdge P), qEdge, endpoint⟩ =
      xCoordinate := by
  rcases xCoordinate with ⟨oldX, xVertex⟩
  obtain ⟨face, corner, hfaceX, hfaceQ⟩ :=
    (rxXQIncidence_eq_true_iff P S ⟨oldX, xVertex⟩
      (Sum.inr ⟨q, vertex⟩)).1 incidence
  rcases face with localFace | glue | oldFace
  · rcases localFace with ⟨ownerX, cell, material⟩
    fin_cases corner <;> simp [rxFaceQ, localFaceQAt, localFaceQ0,
      localFaceQ1] at hfaceQ
  · rcases glue with
      ⟨⟨⟨firstX, firstQ⟩, firstHXQ⟩, firstEdge, firstEndpoint⟩
    fin_cases corner
    · cases hfaceQ
    · have htag :
          (⟨firstQ, edgeEndpoint
            (qDoubleCylinderEdgeStart P firstQ S)
            (qDoubleCylinderEdgeEnd P firstQ S)
            firstEdge firstEndpoint⟩ :
              Σ oldQ : P.Q, QDoubleCylinderVertex P oldQ S) =
            ⟨q, vertex⟩ :=
        Sum.inr.inj hfaceQ
      have hbase : firstQ = q := congrArg Sigma.fst htag
      subst firstQ
      have hfirstVertex : edgeEndpoint
          (qDoubleCylinderEdgeStart P q S)
          (qDoubleCylinderEdgeEnd P q S) firstEdge firstEndpoint = vertex :=
        eq_of_heq (Sigma.mk.inj_iff.mp htag).2
      have hfirstX : firstX = oldX := congrArg Sigma.fst hfaceX
      subst firstX
      have hmapped := qToXDoubleCylinderEdgeRaw_endpoint_congr
        P q oldX hxq S qEdge firstEdge endpoint firstEndpoint
          (hendpoint.trans hfirstVertex.symm)
      calc
        glueFaceX P S
            ⟨(⟨(oldX, q), hxq⟩ : XQEdge P), qEdge, endpoint⟩ =
            glueFaceX P S
              ⟨(⟨(oldX, q), firstHXQ⟩ : XQEdge P),
                firstEdge, firstEndpoint⟩ := by
          simpa [glueFaceX] using
            congrArg (fun target => (⟨oldX, target⟩ : RX0 P S)) hmapped
        _ = ⟨oldX, xVertex⟩ := by
          simpa [rxFaceX] using hfaceX
  · rcases oldFace with ⟨oldFace, copy⟩
    have htag :
        (⟨P.faceQ oldFace corner,
            (copy, Sum.inl (Sum.inr
            (⟨P.faceZ oldFace,
              P.data.faceQ_qz oldFace corner⟩ :
                QStarEdge P (P.faceQ oldFace corner))))⟩ :
            Σ oldQ : P.Q, QDoubleCylinderVertex P oldQ S) =
          ⟨q, vertex⟩ :=
      Sum.inr.inj hfaceQ
    have hbase : P.faceQ oldFace corner = q :=
      congrArg Sigma.fst htag
    have hownerX : P.faceX oldFace = oldX :=
      congrArg Sigma.fst hfaceX
    let hqz : P.qz q (P.faceZ oldFace) = true := by
      simpa [hbase] using P.data.faceQ_qz oldFace corner
    have hterminal :
        (copy, Sum.inl (Sum.inr
          (⟨P.faceZ oldFace, hqz⟩ : QStarEdge P q))) = vertex := by
      cases hbase
      exact eq_of_heq (Sigma.mk.inj_iff.mp htag).2
    have hbridge := qToXDoubleCylinderEdgeRaw_endpoint_eq_oldZFaceX
      P S oldX q (P.faceZ oldFace) hxq hqz qEdge endpoint
        oldFace corner copy hownerX rfl hbase
        (hendpoint.trans hterminal.symm)
    calc
      glueFaceX P S
          ⟨(⟨(oldX, q), hxq⟩ : XQEdge P), qEdge, endpoint⟩ =
          oldZFaceX P S (oldFace, copy) := by
        simpa [glueFaceX] using hbridge
      _ = ⟨oldX, xVertex⟩ := by
        simpa [rxFaceX] using hfaceX

/-- Choice-free `F_xqGlue_X` producer for the second successor V3 X-owner
row.  Its Q-cylinder edge and endpoint are obtained structurally from the
stored Q-local vertex. -/
private noncomputable def rxQVertexXRadialFaceOwner
    (P : TannerSquarePresentation) (A3 : TannerSquareAdmissibleV3 P)
    (S : OddScale) (xCoordinate : RX0 P S) (q : P.Q)
    (vertex : QDoubleCylinderVertex P q S)
    (incidence : rxXQIncidence P S xCoordinate
      (Sum.inr ⟨q, vertex⟩) = true)
    (starMember : xStarEdgeMember (rxReplacementPresentation P S) xCoordinate
      (Sum.inl
        (⟨(xCoordinate, Sum.inr ⟨q, vertex⟩), incidence⟩ :
          XQEdge (rxReplacementPresentation P S))) = true) :
    {owner : XStarFace (rxReplacementPresentation P S) xCoordinate × Two //
      xStarFaceXQEdge (rxReplacementPresentation P S) xCoordinate
          owner.1 owner.2 =
        ⟨Sum.inl
          (⟨(xCoordinate, Sum.inr ⟨q, vertex⟩), incidence⟩ :
            XQEdge (rxReplacementPresentation P S)), starMember⟩} := by
  let A := A3.toTannerSquareAdmissibleV2.toTannerSquareAdmissible
  obtain ⟨⟨qEdge, endpoint⟩, hendpoint⟩ :=
    rxQDoubleCylinderVertexIncidentEdge P A q S vertex
  have hendpoint' : edgeEndpoint
      (qDoubleCylinderEdgeStart P q S)
      (qDoubleCylinderEdgeEnd P q S) qEdge endpoint = vertex :=
    rxTwoElim (motive := fun endpoint =>
      BDL26TannerLocalRegularity.edgeEndpoint
          (qDoubleCylinderEdgeStart P q S)
          (qDoubleCylinderEdgeEnd P q S) qEdge endpoint = vertex →
        edgeEndpoint (qDoubleCylinderEdgeStart P q S)
          (qDoubleCylinderEdgeEnd P q S) qEdge endpoint = vertex)
      (fun h => h) (fun h => h) endpoint hendpoint
  let hxq := rxQVertexXRadial_oldXQ P S xCoordinate q vertex incidence
  let glue : RXXQGlueFace P S :=
    ⟨(⟨(xCoordinate.1, q), hxq⟩ : XQEdge P), qEdge, endpoint⟩
  have hfaceX : glueFaceX P S glue = xCoordinate :=
    rxQVertexGlueFaceX_eq P S xCoordinate q vertex incidence hxq
      qEdge endpoint hendpoint'
  have hfaceQ : glueFaceQ1 P S glue = Sum.inr ⟨q, vertex⟩ := by
    apply congrArg Sum.inr
    change (⟨q, edgeEndpoint
      (qDoubleCylinderEdgeStart P q S)
      (qDoubleCylinderEdgeEnd P q S) qEdge endpoint⟩ :
        Σ oldQ : P.Q, QDoubleCylinderVertex P oldQ S) = ⟨q, vertex⟩
    rw [Sigma.ext_iff]
    exact ⟨rfl, by simpa only [heq_eq_eq] using hendpoint'⟩
  let rawFace : RXFace P S := Sum.inr (Sum.inl glue)
  let starFace : XStarFace
      (rxReplacementPresentation P S) xCoordinate :=
    ⟨rawFace, by
      simp only [xStarFaceMember, decide_eq_true_eq]
      rw [show (rxReplacementPresentation P S).faceX = rxFaceX P S from rfl]
      exact hfaceX⟩
  refine ⟨(starFace, 1), ?_⟩
  apply Subtype.ext
  apply congrArg Sum.inl
  apply Subtype.ext
  exact Prod.ext hfaceX hfaceQ

/-- Total successor X-radial owner selector, assembled by direct dispatch on
the two RX degree-one coordinate constructors. -/
noncomputable def rxReplacementXRadialFaceOwner
    (P : TannerSquarePresentation) (A3 : TannerSquareAdmissibleV3 P)
    (S : OddScale) (x : (rxReplacementPresentation P S).X)
    (edge : XQEdge (rxReplacementPresentation P S))
    (member : xStarEdgeMember (rxReplacementPresentation P S) x
      (Sum.inl edge) = true) :
    {owner : XStarFace (rxReplacementPresentation P S) x × Two //
      xStarFaceXQEdge (rxReplacementPresentation P S) x
          owner.1 owner.2 = ⟨Sum.inl edge, member⟩} := by
  rcases edge with ⟨⟨xCoordinate, rawQ⟩, incidence⟩
  have howner : xCoordinate = x :=
    rxXRadialEdge_ownerX P S x
      ⟨(xCoordinate, rawQ), incidence⟩ member
  subst xCoordinate
  rcases rawQ with localEdge | qVertex
  · rcases localEdge with ⟨oldX, localEdge⟩
    exact rxLocalEdgeXRadialFaceOwner
      P A3 S x oldX localEdge incidence member
  · rcases qVertex with ⟨q, vertex⟩
    exact rxQVertexXRadialFaceOwner
      P A3 S x q vertex incidence member

/-! ### Successor V3 Z-local radial owner row -/

/-- A successor Q-Z radial edge in a local-cell Z-star retains its Q endpoint
as a boundary vertex of that same star. -/
private theorem rxLocalCellZRadial_qBoundaryMember
    (P : TannerSquarePresentation) (S : OddScale) (oldX : P.X)
    (cell : DoubleCylinderFace P oldX S) (newQ : RX1 P S)
    (incidence : rxQZIncidence P S newQ
      (Sum.inl (Sum.inl ⟨oldX, cell⟩)) = true)
    (member : zStarEdgeMember (rxReplacementPresentation P S)
      (Sum.inl (Sum.inl ⟨oldX, cell⟩))
      (Sum.inr
        (⟨(newQ, Sum.inl (Sum.inl ⟨oldX, cell⟩)), incidence⟩ :
          QZEdge (rxReplacementPresentation P S))) = true) :
    zStarBoundaryVertexMember (rxReplacementPresentation P S)
      (Sum.inl (Sum.inl ⟨oldX, cell⟩)) (Vertex.q newQ) = true := by
  classical
  simp only [zStarEdgeMember, decide_eq_true_eq] at member
  obtain ⟨face, hz, huse⟩ := member
  change decide
        ((⟨(newQ, Sum.inl (Sum.inl ⟨oldX, cell⟩)), incidence⟩ :
              QZEdge (rxReplacementPresentation P S)) =
            faceQZEdge (rxReplacementPresentation P S) face 0 ∨
          (⟨(newQ, Sum.inl (Sum.inl ⟨oldX, cell⟩)), incidence⟩ :
              QZEdge (rxReplacementPresentation P S)) =
            faceQZEdge (rxReplacementPresentation P S) face 1) = true at huse
  rw [decide_eq_true_eq] at huse
  simp only [zStarBoundaryVertexMember, decide_eq_true_eq]
  change (exists face : RXFace P S,
    zStarFaceMember (rxReplacementPresentation P S)
        (Sum.inl (Sum.inl ⟨oldX, cell⟩)) face = true ∧
      (newQ = rxFaceQ P S face 0 ∨ newQ = rxFaceQ P S face 1))
  refine ⟨face, hz, ?_⟩
  rcases huse with hzero | hone
  · exact Or.inl (congrArg
      (fun selected : QZEdge (rxReplacementPresentation P S) =>
        selected.1.1) hzero)
  · exact Or.inr (congrArg
      (fun selected : QZEdge (rxReplacementPresentation P S) =>
        selected.1.1) hone)

/-- Materialize one explicit local-cell face/corner realizing the requested
successor Q-Z radial edge. -/
private noncomputable def rxLocalCellZRadialFaceOwnerAtQCorner
    (P : TannerSquarePresentation) (S : OddScale) (oldX : P.X)
    (cell : DoubleCylinderFace P oldX S) (newQ : RX1 P S)
    (incidence : rxQZIncidence P S newQ
      (Sum.inl (Sum.inl ⟨oldX, cell⟩)) = true)
    (member : zStarEdgeMember (rxReplacementPresentation P S)
      (Sum.inl (Sum.inl ⟨oldX, cell⟩))
      (Sum.inr
        (⟨(newQ, Sum.inl (Sum.inl ⟨oldX, cell⟩)), incidence⟩ :
          QZEdge (rxReplacementPresentation P S))) = true)
    (corner : Two × Two) (qCorner : Two)
    (h : newQ = rxLocalCellQAt P S oldX cell corner qCorner) :
    {owner : ZStarFace (rxReplacementPresentation P S)
        (Sum.inl (Sum.inl ⟨oldX, cell⟩)) × Two //
      zStarFaceQZEdge (rxReplacementPresentation P S)
          (Sum.inl (Sum.inl ⟨oldX, cell⟩)) owner.1 owner.2 =
        ⟨Sum.inr
          (⟨(newQ, Sum.inl (Sum.inl ⟨oldX, cell⟩)), incidence⟩ :
            QZEdge (rxReplacementPresentation P S)), member⟩} := by
  let face := rxLocalCellZStarFace P S oldX cell corner
  have hfaceQ : rxFaceQ P S face.1 qCorner = newQ := by
    change localFaceQAt P S ⟨oldX, cell, corner⟩ qCorner = newQ
    exact h.symm
  have hfaceZ : rxFaceZ P S face.1 =
      Sum.inl (Sum.inl ⟨oldX, cell⟩) := rfl
  refine ⟨(face, qCorner), ?_⟩
  apply Subtype.ext
  apply congrArg Sum.inr
  apply Subtype.ext
  exact Prod.ext hfaceQ hfaceZ

/-- Choice-free `F_local_X` producer for the first successor V3 Z-owner row.
The eight possible ordered local Q corners are dispatched explicitly. -/
private noncomputable def rxLocalCellZRadialFaceOwner
    (P : TannerSquarePresentation) (S : OddScale) (oldX : P.X)
    (cell : DoubleCylinderFace P oldX S) (newQ : RX1 P S)
    (incidence : rxQZIncidence P S newQ
      (Sum.inl (Sum.inl ⟨oldX, cell⟩)) = true)
    (member : zStarEdgeMember (rxReplacementPresentation P S)
      (Sum.inl (Sum.inl ⟨oldX, cell⟩))
      (Sum.inr
        (⟨(newQ, Sum.inl (Sum.inl ⟨oldX, cell⟩)), incidence⟩ :
          QZEdge (rxReplacementPresentation P S))) = true) :
    {owner : ZStarFace (rxReplacementPresentation P S)
        (Sum.inl (Sum.inl ⟨oldX, cell⟩)) × Two //
      zStarFaceQZEdge (rxReplacementPresentation P S)
          (Sum.inl (Sum.inl ⟨oldX, cell⟩)) owner.1 owner.2 =
        ⟨Sum.inr
          (⟨(newQ, Sum.inl (Sum.inl ⟨oldX, cell⟩)), incidence⟩ :
            QZEdge (rxReplacementPresentation P S)), member⟩} := by
  let qMember := rxLocalCellZRadial_qBoundaryMember
    P S oldX cell newQ incidence member
  have cases := rxLocalCellBoundaryQ_cases
    P S oldX cell newQ qMember
  by_cases h000 : newQ = rxLocalCellQAt P S oldX cell (0, 0) 0
  · exact rxLocalCellZRadialFaceOwnerAtQCorner
      P S oldX cell newQ incidence member (0, 0) 0 h000
  · by_cases h001 : newQ = rxLocalCellQAt P S oldX cell (0, 0) 1
    · exact rxLocalCellZRadialFaceOwnerAtQCorner
        P S oldX cell newQ incidence member (0, 0) 1 h001
    · by_cases h010 : newQ = rxLocalCellQAt P S oldX cell (0, 1) 0
      · exact rxLocalCellZRadialFaceOwnerAtQCorner
          P S oldX cell newQ incidence member (0, 1) 0 h010
      · by_cases h011 : newQ = rxLocalCellQAt P S oldX cell (0, 1) 1
        · exact rxLocalCellZRadialFaceOwnerAtQCorner
            P S oldX cell newQ incidence member (0, 1) 1 h011
        · by_cases h100 : newQ = rxLocalCellQAt P S oldX cell (1, 0) 0
          · exact rxLocalCellZRadialFaceOwnerAtQCorner
              P S oldX cell newQ incidence member (1, 0) 0 h100
          · by_cases h101 : newQ = rxLocalCellQAt P S oldX cell (1, 0) 1
            · exact rxLocalCellZRadialFaceOwnerAtQCorner
                P S oldX cell newQ incidence member (1, 0) 1 h101
            · by_cases h110 : newQ = rxLocalCellQAt P S oldX cell (1, 1) 0
              · exact rxLocalCellZRadialFaceOwnerAtQCorner
                  P S oldX cell newQ incidence member (1, 1) 0 h110
              · have remaining001 := cases.resolve_left h000
                have remaining010 := remaining001.resolve_left h001
                have remaining011 := remaining010.resolve_left h010
                have remaining100 := remaining011.resolve_left h011
                have remaining101 := remaining100.resolve_left h100
                have remaining110 := remaining101.resolve_left h101
                have h111 := remaining110.resolve_left h110
                exact rxLocalCellZRadialFaceOwnerAtQCorner
                  P S oldX cell newQ incidence member (1, 1) 1 h111

/-! ### Successor V3 Z-glue radial owner rows -/

/-- A successor Q-Z radial edge in a Q-cylinder-edge Z-star retains its Q
endpoint as a boundary vertex of that same star. -/
private theorem rxQEdgeZRadial_qBoundaryMember
    (P : TannerSquarePresentation) (S : OddScale)
    (qEdge : Σ q : P.Q, QDoubleCylinderEdge P q S) (newQ : RX1 P S)
    (incidence : rxQZIncidence P S newQ (Sum.inl (Sum.inr qEdge)) = true)
    (member : zStarEdgeMember (rxReplacementPresentation P S)
      (Sum.inl (Sum.inr qEdge))
      (Sum.inr
        (⟨(newQ, Sum.inl (Sum.inr qEdge)), incidence⟩ :
          QZEdge (rxReplacementPresentation P S))) = true) :
    zStarBoundaryVertexMember (rxReplacementPresentation P S)
      (Sum.inl (Sum.inr qEdge)) (Vertex.q newQ) = true := by
  classical
  simp only [zStarEdgeMember, decide_eq_true_eq] at member
  obtain ⟨face, hz, huse⟩ := member
  change decide
        ((⟨(newQ, Sum.inl (Sum.inr qEdge)), incidence⟩ :
              QZEdge (rxReplacementPresentation P S)) =
            faceQZEdge (rxReplacementPresentation P S) face 0 ∨
          (⟨(newQ, Sum.inl (Sum.inr qEdge)), incidence⟩ :
              QZEdge (rxReplacementPresentation P S)) =
            faceQZEdge (rxReplacementPresentation P S) face 1) = true at huse
  rw [decide_eq_true_eq] at huse
  simp only [zStarBoundaryVertexMember, decide_eq_true_eq]
  change (exists face : RXFace P S,
    zStarFaceMember (rxReplacementPresentation P S)
        (Sum.inl (Sum.inr qEdge)) face = true ∧
      (newQ = rxFaceQ P S face 0 ∨ newQ = rxFaceQ P S face 1))
  refine ⟨face, hz, ?_⟩
  rcases huse with hzero | hone
  · exact Or.inl (congrArg
      (fun selected : QZEdge (rxReplacementPresentation P S) =>
        selected.1.1) hzero)
  · exact Or.inr (congrArg
      (fun selected : QZEdge (rxReplacementPresentation P S) =>
        selected.1.1) hone)

/-- The successor Z coordinate stored by a radial Q-Z edge is its requested
Z-star coordinate.  Face existence is eliminated only in this proposition. -/
private theorem rxZRadialEdge_ownerZ
    (P : TannerSquarePresentation) (S : OddScale)
    (z : RX2 P S) (edge : QZEdge (rxReplacementPresentation P S))
    (member : zStarEdgeMember (rxReplacementPresentation P S) z
      (Sum.inr edge) = true) :
    edge.1.2 = z := by
  classical
  simp only [zStarEdgeMember, decide_eq_true_eq] at member
  obtain ⟨face, hz, huse⟩ := member
  change decide (edge = faceQZEdge (rxReplacementPresentation P S) face 0 ∨
    edge = faceQZEdge (rxReplacementPresentation P S) face 1) = true at huse
  rw [decide_eq_true_eq] at huse
  have hfaceZ : rxFaceZ P S face = z := by
    simp only [zStarFaceMember, decide_eq_true_eq] at hz
    rw [show (rxReplacementPresentation P S).faceZ = rxFaceZ P S from rfl] at hz
    exact hz
  rcases huse with hzero | hone
  · exact (congrArg
      (fun selected : QZEdge (rxReplacementPresentation P S) =>
        selected.1.2) hzero).trans hfaceZ
  · exact (congrArg
      (fun selected : QZEdge (rxReplacementPresentation P S) =>
        selected.1.2) hone).trans hfaceZ

/-- `F_xqGlue_X` producer for an embedded X-local edge paired with its stored
Q-cylinder edge. -/
private noncomputable def rxQEdgeZRadialFaceOwnerLocalEdge
    (P : TannerSquarePresentation) (S : OddScale)
    (qEdge : Σ q : P.Q, QDoubleCylinderEdge P q S)
    (localEdge : Σ x : P.X, DoubleCylinderEdge P x S)
    (incidence : rxQZIncidence P S (Sum.inl localEdge)
      (Sum.inl (Sum.inr qEdge)) = true)
    (member : zStarEdgeMember (rxReplacementPresentation P S)
      (Sum.inl (Sum.inr qEdge))
      (Sum.inr
        (⟨(Sum.inl localEdge, Sum.inl (Sum.inr qEdge)), incidence⟩ :
          QZEdge (rxReplacementPresentation P S))) = true) :
    {owner : ZStarFace (rxReplacementPresentation P S)
        (Sum.inl (Sum.inr qEdge)) × Two //
      zStarFaceQZEdge (rxReplacementPresentation P S)
          (Sum.inl (Sum.inr qEdge)) owner.1 owner.2 =
        ⟨Sum.inr
          (⟨(Sum.inl localEdge, Sum.inl (Sum.inr qEdge)), incidence⟩ :
            QZEdge (rxReplacementPresentation P S)), member⟩} := by
  let qMember := rxQEdgeZRadial_qBoundaryMember
    P S qEdge (Sum.inl localEdge) incidence member
  let hxq := rxQEdgeBoundaryLocalQ_incidence
    P S qEdge localEdge qMember
  let face := rxQEdgeGlueZStarFace P S qEdge localEdge.1 hxq 0
  have hfaceQ : rxFaceQ P S face.1 0 = Sum.inl localEdge := by
    apply congrArg Sum.inl
    apply Sigma.ext
    · rfl
    · simp only [heq_eq_eq]
      exact (rxQEdgeBoundaryLocalQ_edge
        P S qEdge localEdge qMember).symm
  have hfaceZ : rxFaceZ P S face.1 =
      Sum.inl (Sum.inr qEdge) := rfl
  refine ⟨(face, 0), ?_⟩
  apply Subtype.ext
  apply congrArg Sum.inr
  apply Subtype.ext
  exact Prod.ext hfaceQ hfaceZ

/-- Materialize the glue face at one explicit endpoint of the stored
Q-cylinder edge.  The old X label is supplied only by the historical root. -/
private noncomputable def rxQEdgeZRadialFaceOwnerQVertexAtEndpoint
    (P : TannerSquarePresentation) (A : TannerSquareAdmissible P)
    (S : OddScale) (qEdge : Σ q : P.Q, QDoubleCylinderEdge P q S)
    (qVertex : Σ q : P.Q, QDoubleCylinderVertex P q S)
    (incidence : rxQZIncidence P S (Sum.inr qVertex)
      (Sum.inl (Sum.inr qEdge)) = true)
    (member : zStarEdgeMember (rxReplacementPresentation P S)
      (Sum.inl (Sum.inr qEdge))
      (Sum.inr
        (⟨(Sum.inr qVertex, Sum.inl (Sum.inr qEdge)), incidence⟩ :
          QZEdge (rxReplacementPresentation P S))) = true)
    (endpoint : Two)
    (hendpoint : qVertex = ⟨qEdge.1, edgeEndpoint
      (qDoubleCylinderEdgeStart P qEdge.1 S)
      (qDoubleCylinderEdgeEnd P qEdge.1 S) qEdge.2 endpoint⟩) :
    {owner : ZStarFace (rxReplacementPresentation P S)
        (Sum.inl (Sum.inr qEdge)) × Two //
      zStarFaceQZEdge (rxReplacementPresentation P S)
          (Sum.inl (Sum.inr qEdge)) owner.1 owner.2 =
        ⟨Sum.inr
          (⟨(Sum.inr qVertex, Sum.inl (Sum.inr qEdge)), incidence⟩ :
            QZEdge (rxReplacementPresentation P S)), member⟩} := by
  let face := rxQEdgeGlueZStarFace P S qEdge
    (A.xqRoot qEdge.1).1 (A.xqRoot qEdge.1).2 endpoint
  have hfaceQ : rxFaceQ P S face.1 1 = Sum.inr qVertex := by
    apply congrArg Sum.inr
    simpa [face, rxFaceQ, glueFaceQ1] using hendpoint.symm
  have hfaceZ : rxFaceZ P S face.1 =
      Sum.inl (Sum.inr qEdge) := rfl
  refine ⟨(face, 1), ?_⟩
  apply Subtype.ext
  apply congrArg Sum.inr
  apply Subtype.ext
  exact Prod.ext hfaceQ hfaceZ

/-- `F_xqGlue_X` producer for a Q-local vertex at an explicit endpoint of its
stored Q-cylinder edge. -/
private noncomputable def rxQEdgeZRadialFaceOwnerQVertex
    (P : TannerSquarePresentation) (A : TannerSquareAdmissible P)
    (S : OddScale) (qEdge : Σ q : P.Q, QDoubleCylinderEdge P q S)
    (qVertex : Σ q : P.Q, QDoubleCylinderVertex P q S)
    (incidence : rxQZIncidence P S (Sum.inr qVertex)
      (Sum.inl (Sum.inr qEdge)) = true)
    (member : zStarEdgeMember (rxReplacementPresentation P S)
      (Sum.inl (Sum.inr qEdge))
      (Sum.inr
        (⟨(Sum.inr qVertex, Sum.inl (Sum.inr qEdge)), incidence⟩ :
          QZEdge (rxReplacementPresentation P S))) = true) :
    {owner : ZStarFace (rxReplacementPresentation P S)
        (Sum.inl (Sum.inr qEdge)) × Two //
      zStarFaceQZEdge (rxReplacementPresentation P S)
          (Sum.inl (Sum.inr qEdge)) owner.1 owner.2 =
        ⟨Sum.inr
          (⟨(Sum.inr qVertex, Sum.inl (Sum.inr qEdge)), incidence⟩ :
            QZEdge (rxReplacementPresentation P S)), member⟩} := by
  let qMember := rxQEdgeZRadial_qBoundaryMember
    P S qEdge (Sum.inr qVertex) incidence member
  by_cases hstart : qVertex = ⟨qEdge.1,
      qDoubleCylinderEdgeStart P qEdge.1 S qEdge.2⟩
  · exact rxQEdgeZRadialFaceOwnerQVertexAtEndpoint
      P A S qEdge qVertex incidence member 0
      (by simpa [edgeEndpoint] using hstart)
  · have hend := (rxQEdgeBoundaryQVertex_endpoints
      P S qEdge qVertex qMember).resolve_left hstart
    exact rxQEdgeZRadialFaceOwnerQVertexAtEndpoint
      P A S qEdge qVertex incidence member 1
      (by simpa [edgeEndpoint] using hend)

/-- Choice-free grouped decoder for the three non-old-Z successor radial
owner rows.  The retained old-Z copy row is intentionally excluded. -/
private noncomputable def rxReplacementZRadialFaceOwnerNonOldZ
    (P : TannerSquarePresentation) (A : TannerSquareAdmissible P)
    (S : OddScale)
    (z : (Σ x : P.X, DoubleCylinderFace P x S) ⊕
      (Σ q : P.Q, QDoubleCylinderEdge P q S))
    (edge : QZEdge (rxReplacementPresentation P S))
    (member : zStarEdgeMember (rxReplacementPresentation P S)
      (Sum.inl z) (Sum.inr edge) = true) :
    {owner : ZStarFace (rxReplacementPresentation P S) (Sum.inl z) × Two //
      zStarFaceQZEdge (rxReplacementPresentation P S) (Sum.inl z)
          owner.1 owner.2 = ⟨Sum.inr edge, member⟩} := by
  rcases edge with ⟨⟨newQ, edgeZ⟩, incidence⟩
  have howner : edgeZ = Sum.inl z :=
    rxZRadialEdge_ownerZ P S (Sum.inl z)
      ⟨(newQ, edgeZ), incidence⟩ member
  subst edgeZ
  rcases z with localCell | qEdge
  · rcases localCell with ⟨oldX, cell⟩
    exact rxLocalCellZRadialFaceOwner
      P S oldX cell newQ incidence member
  · rcases newQ with localEdge | qVertex
    · exact rxQEdgeZRadialFaceOwnerLocalEdge
        P S qEdge localEdge incidence member
    · exact rxQEdgeZRadialFaceOwnerQVertex
        P A S qEdge qVertex incidence member

/-! ### Successor V3 retained old-Z radial owner row -/

/-- A radial edge in a retained old-Z successor star retains its Q endpoint
as a boundary vertex of that same star. -/
private theorem rxOldZRadial_qBoundaryMember
    (P : TannerSquarePresentation) (S : OddScale)
    (oldZ : P.Z) (copy : Two) (newQ : RX1 P S)
    (incidence : rxQZIncidence P S newQ (Sum.inr (oldZ, copy)) = true)
    (member : zStarEdgeMember (rxReplacementPresentation P S)
      (Sum.inr (oldZ, copy))
      (Sum.inr
        (⟨(newQ, Sum.inr (oldZ, copy)), incidence⟩ :
          QZEdge (rxReplacementPresentation P S))) = true) :
    zStarBoundaryVertexMember (rxReplacementPresentation P S)
      (Sum.inr (oldZ, copy)) (Vertex.q newQ) = true := by
  classical
  simp only [zStarEdgeMember, decide_eq_true_eq] at member
  obtain ⟨face, hz, huse⟩ := member
  change decide
        ((⟨(newQ, Sum.inr (oldZ, copy)), incidence⟩ :
              QZEdge (rxReplacementPresentation P S)) =
            faceQZEdge (rxReplacementPresentation P S) face 0 ∨
          (⟨(newQ, Sum.inr (oldZ, copy)), incidence⟩ :
              QZEdge (rxReplacementPresentation P S)) =
            faceQZEdge (rxReplacementPresentation P S) face 1) = true at huse
  rw [decide_eq_true_eq] at huse
  simp only [zStarBoundaryVertexMember, decide_eq_true_eq]
  change (exists face : RXFace P S,
    zStarFaceMember (rxReplacementPresentation P S)
        (Sum.inr (oldZ, copy)) face = true ∧
      (newQ = rxFaceQ P S face 0 ∨ newQ = rxFaceQ P S face 1))
  refine ⟨face, hz, ?_⟩
  rcases huse with hzero | hone
  · exact Or.inl (congrArg
      (fun selected : QZEdge (rxReplacementPresentation P S) =>
        selected.1.1) hzero)
  · exact Or.inr (congrArg
      (fun selected : QZEdge (rxReplacementPresentation P S) =>
        selected.1.1) hone)

/-- Only a copy-tagged old Q-Z endpoint can lie on the boundary of a retained
old-Z successor star.  This proposition is used solely to eliminate the
three unreachable structural constructors. -/
private theorem rxOldZBoundaryQ_terminal
    (P : TannerSquarePresentation) (S : OddScale)
    (oldZ : P.Z) (copy : Two) (newQ : RX1 P S)
    (member : zStarBoundaryVertexMember (rxReplacementPresentation P S)
      (Sum.inr (oldZ, copy)) (Vertex.q newQ) = true) :
    match newQ with
    | Sum.inr ⟨_, (_, Sum.inl (Sum.inr _))⟩ => True
    | _ => False := by
  classical
  simp only [zStarBoundaryVertexMember, decide_eq_true_eq] at member
  change (exists face : RXFace P S,
    zStarFaceMember (rxReplacementPresentation P S)
        (Sum.inr (oldZ, copy)) face = true ∧
      (newQ = rxFaceQ P S face 0 ∨ newQ = rxFaceQ P S face 1))
      at member
  obtain ⟨face, hz, hq⟩ := member
  rcases face with localFace | glue | oldFace
  · simp only [zStarFaceMember, decide_eq_true_eq] at hz
    cases hz
  · simp only [zStarFaceMember, decide_eq_true_eq] at hz
    cases hz
  · rcases newQ with localEdge | qVertex
    · rcases hq with hq | hq <;> cases hq
    · rcases qVertex with ⟨q, newCopy, vertex⟩
      rcases vertex with original | interior
      · rcases original with center | endpoint
        · rcases hq with hq | hq <;> cases hq
        · trivial
      · rcases hq with hq | hq <;> cases hq

/-- An old Z-boundary Q vertex determines the corresponding old radial Q-Z
edge in that Z-star. -/
private theorem rxOldZBoundaryQ_radialMember
    (P : TannerSquarePresentation) (oldZ : P.Z) (q : P.Q)
    (member : zStarBoundaryVertexMember P oldZ (Vertex.q q) = true) :
    zStarEdgeMember P oldZ
      (Sum.inr
        (⟨(q, oldZ), rxOldZBoundaryQZIncidence P q oldZ member⟩ :
          QZEdge P)) = true := by
  change decide (exists face : P.Face,
    zStarFaceMember P oldZ face = true ∧
      (q = P.faceQ face 0 ∨ q = P.faceQ face 1)) = true at member
  change decide (exists face : P.Face,
    zStarFaceMember P oldZ face = true ∧
      decide
        ((⟨(q, oldZ), rxOldZBoundaryQZIncidence P q oldZ member⟩ :
              QZEdge P) = faceQZEdge P face 0 ∨
          (⟨(q, oldZ), rxOldZBoundaryQZIncidence P q oldZ member⟩ :
              QZEdge P) = faceQZEdge P face 1) = true) = true
  rw [decide_eq_true_eq]
  obtain ⟨face, hz, hq | hq⟩ := of_decide_eq_true member
  · refine ⟨face, hz, ?_⟩
    rw [decide_eq_true_eq]
    left
    apply Subtype.ext
    have hz' : P.faceZ face = oldZ := by
      simpa [zStarFaceMember] using hz
    exact Prod.ext hq hz'.symm
  · refine ⟨face, hz, ?_⟩
    rw [decide_eq_true_eq]
    right
    apply Subtype.ext
    have hz' : P.faceZ face = oldZ := by
      simpa [zStarFaceMember] using hz
    exact Prod.ext hq hz'.symm

/-- `F_oldZ_X` producer for the retained old-Z radial row.  Projection and
re-embedding normalize the successor terminal Q coordinate; the input V3
owner supplies the old face and ordered corner unchanged. -/
private noncomputable def rxOldZRadialFaceOwnerTerminal
    (P : TannerSquarePresentation) (A3 : TannerSquareAdmissibleV3 P)
    (S : OddScale) (oldZ : P.Z) (copy newCopy : Two) (q : P.Q)
    (endpoint : QStarEdge P q)
    (incidence : rxQZIncidence P S
      (Sum.inr ⟨q, (newCopy, Sum.inl (Sum.inr endpoint))⟩)
      (Sum.inr (oldZ, copy)) = true)
    (member : zStarEdgeMember (rxReplacementPresentation P S)
      (Sum.inr (oldZ, copy))
      (Sum.inr
        (⟨(Sum.inr ⟨q, (newCopy, Sum.inl (Sum.inr endpoint))⟩,
            Sum.inr (oldZ, copy)), incidence⟩ :
          QZEdge (rxReplacementPresentation P S))) = true) :
    {owner : ZStarFace (rxReplacementPresentation P S)
        (Sum.inr (oldZ, copy)) × Two //
      zStarFaceQZEdge (rxReplacementPresentation P S)
          (Sum.inr (oldZ, copy)) owner.1 owner.2 =
        ⟨Sum.inr
          (⟨(Sum.inr ⟨q, (newCopy, Sum.inl (Sum.inr endpoint))⟩,
              Sum.inr (oldZ, copy)), incidence⟩ :
            QZEdge (rxReplacementPresentation P S)), member⟩} := by
  let newQ : RX1 P S :=
    Sum.inr ⟨q, (newCopy, Sum.inl (Sum.inr endpoint))⟩
  let qMember := rxOldZRadial_qBoundaryMember
    P S oldZ copy newQ incidence member
  let successorVertex : ZStarBoundaryVertex
      (rxReplacementPresentation P S) (Sum.inr (oldZ, copy)) :=
    ⟨Vertex.q newQ, qMember⟩
  let oldVertex := rxOldZBoundaryVertexProject
    P S oldZ copy successorVertex
  have oldQMember : zStarBoundaryVertexMember P oldZ
      (Vertex.q q) = true := by
    exact oldVertex.2
  have mappedVertex := rxOldZBoundaryVertexMap_project
    P S oldZ copy successorVertex
  have hmappedQ : rxOldZCopyQCoordinate
      P S oldZ copy q oldQMember = newQ := by
    have hvalue := congrArg Subtype.val mappedVertex
    exact Vertex.q.inj hvalue
  let oldIncidence := rxOldZBoundaryQZIncidence P q oldZ oldQMember
  let oldEdge : QZEdge P := ⟨(q, oldZ), oldIncidence⟩
  let oldMember := rxOldZBoundaryQ_radialMember
    P oldZ q oldQMember
  let selected := A3.zRadialFaceOwner oldZ oldEdge oldMember
  have hselected := congrArg Subtype.val selected.2
  have hedge : faceQZEdge P selected.1.1.1 selected.1.2 = oldEdge :=
    Sum.inr.inj hselected
  have hfaceQ : P.faceQ selected.1.1.1 selected.1.2 = q :=
    (congrArg (fun chosen : QZEdge P => chosen.1.1) hedge).trans rfl
  have hfaceZ : P.faceZ selected.1.1.1 = oldZ := by
    simpa [zStarFaceMember] using selected.1.1.2
  let face : ZStarFace (rxReplacementPresentation P S)
      (Sum.inr (oldZ, copy)) :=
    ⟨Sum.inr (Sum.inr (selected.1.1.1, copy)), by
      simp only [zStarFaceMember, decide_eq_true_eq]
      change rxFaceZ P S
        (Sum.inr (Sum.inr (selected.1.1.1, copy))) =
          Sum.inr (oldZ, copy)
      simp [rxFaceZ, oldZFaceZ, hfaceZ]⟩
  have hlift := congrArg (fun chosen : QZEdge P =>
      (Sum.inr ⟨chosen.1.1,
        (copy, Sum.inl (Sum.inr
          (⟨chosen.1.2, chosen.2⟩ : QStarEdge P chosen.1.1)))⟩ :
        RX1 P S)) hedge
  have hsuccessorQ : rxFaceQ P S face.1 selected.1.2 = newQ := by
    rw [show rxFaceQ P S face.1 selected.1.2 =
        rxOldZCopyQCoordinate P S oldZ copy q oldQMember by
      simpa [face, rxFaceQ, oldZFaceQ, rxOldZCopyQCoordinate,
        oldEdge, oldIncidence, faceQZEdge] using hlift]
    exact hmappedQ
  have hsuccessorZ : rxFaceZ P S face.1 =
      Sum.inr (oldZ, copy) := by
    simp [face, rxFaceZ, oldZFaceZ, hfaceZ]
  refine ⟨(face, selected.1.2), ?_⟩
  apply Subtype.ext
  apply congrArg Sum.inr
  apply Subtype.ext
  exact Prod.ext hsuccessorQ hsuccessorZ

/-- Total successor Z-radial owner selector, covering the three structural
non-old-Z rows and the retained old-Z copy row. -/
noncomputable def rxReplacementZRadialFaceOwner
    (P : TannerSquarePresentation) (A4 : TannerSquareAdmissibleV4 P)
    (S : OddScale) (z : (rxReplacementPresentation P S).Z)
    (edge : QZEdge (rxReplacementPresentation P S))
    (member : zStarEdgeMember (rxReplacementPresentation P S) z
      (Sum.inr edge) = true) :
    {owner : ZStarFace (rxReplacementPresentation P S) z × Two //
      zStarFaceQZEdge (rxReplacementPresentation P S) z
          owner.1 owner.2 = ⟨Sum.inr edge, member⟩} := by
  let A3 := A4.toTannerSquareAdmissibleV3
  let A := A3.toTannerSquareAdmissibleV2.toTannerSquareAdmissible
  rcases edge with ⟨⟨newQ, edgeZ⟩, incidence⟩
  have howner : edgeZ = z := rxZRadialEdge_ownerZ
    P S z ⟨(newQ, edgeZ), incidence⟩ member
  subst edgeZ
  rcases z with nonOldZ | oldZCopy
  · exact rxReplacementZRadialFaceOwnerNonOldZ
      P A S nonOldZ ⟨(newQ, Sum.inl nonOldZ), incidence⟩ member
  · rcases oldZCopy with ⟨oldZ, copy⟩
    let qMember := rxOldZRadial_qBoundaryMember
      P S oldZ copy newQ incidence member
    have terminal := rxOldZBoundaryQ_terminal
      P S oldZ copy newQ qMember
    rcases newQ with localEdge | qVertex
    · exact terminal.elim
    · rcases qVertex with ⟨q, newCopy, vertex⟩
      rcases vertex with original | interior
      · rcases original with center | endpoint
        · exact terminal.elim
        · exact rxOldZRadialFaceOwnerTerminal
            P A3 S oldZ copy newCopy q endpoint incidence member
      · exact terminal.elim

/-! ### Successor V4 X-local boundary-face owner row -/

/-- An X-star boundary Q-Z edge whose Z endpoint is a fixed local cell
determines one of the eight explicit `(material corner, Q corner)` pairs of
that cell.  Face existence is eliminated only in this proposition. -/
private theorem rxXBoundaryLocalCell_pair_cases
    (P : TannerSquarePresentation) (S : OddScale)
    (xCoordinate : RX0 P S) (oldX : P.X)
    (cell : DoubleCylinderFace P oldX S) (newQ : RX1 P S)
    (incidence : rxQZIncidence P S newQ
      (Sum.inl (Sum.inl ⟨oldX, cell⟩)) = true)
    (member : xStarEdgeMember (rxReplacementPresentation P S) xCoordinate
      (Sum.inr
        (⟨(newQ, Sum.inl (Sum.inl ⟨oldX, cell⟩)), incidence⟩ :
          QZEdge (rxReplacementPresentation P S))) = true) :
    (xCoordinate = rxLocalCellXAt P S oldX cell (0, 0) ∧
        newQ = rxLocalCellQAt P S oldX cell (0, 0) 0) ∨
      (xCoordinate = rxLocalCellXAt P S oldX cell (0, 0) ∧
        newQ = rxLocalCellQAt P S oldX cell (0, 0) 1) ∨
      (xCoordinate = rxLocalCellXAt P S oldX cell (0, 1) ∧
        newQ = rxLocalCellQAt P S oldX cell (0, 1) 0) ∨
      (xCoordinate = rxLocalCellXAt P S oldX cell (0, 1) ∧
        newQ = rxLocalCellQAt P S oldX cell (0, 1) 1) ∨
      (xCoordinate = rxLocalCellXAt P S oldX cell (1, 0) ∧
        newQ = rxLocalCellQAt P S oldX cell (1, 0) 0) ∨
      (xCoordinate = rxLocalCellXAt P S oldX cell (1, 0) ∧
        newQ = rxLocalCellQAt P S oldX cell (1, 0) 1) ∨
      (xCoordinate = rxLocalCellXAt P S oldX cell (1, 1) ∧
        newQ = rxLocalCellQAt P S oldX cell (1, 1) 0) ∨
      (xCoordinate = rxLocalCellXAt P S oldX cell (1, 1) ∧
        newQ = rxLocalCellQAt P S oldX cell (1, 1) 1) := by
  classical
  let edge : QZEdge (rxReplacementPresentation P S) :=
    ⟨(newQ, Sum.inl (Sum.inl ⟨oldX, cell⟩)), incidence⟩
  simp only [xStarEdgeMember, decide_eq_true_eq] at member
  obtain ⟨face, hface, huse⟩ := member
  change decide (edge = faceQZEdge (rxReplacementPresentation P S) face 0 ∨
    edge = faceQZEdge (rxReplacementPresentation P S) face 1) = true at huse
  rw [decide_eq_true_eq] at huse
  have hfaceX : rxFaceX P S face = xCoordinate := by
    simp only [xStarFaceMember, decide_eq_true_eq] at hface
    rw [show (rxReplacementPresentation P S).faceX = rxFaceX P S from rfl] at hface
    exact hface
  have route : ∀ (corner : Two × Two) (qCorner : Two),
      xCoordinate = rxLocalCellXAt P S oldX cell corner →
      newQ = rxLocalCellQAt P S oldX cell corner qCorner →
      (xCoordinate = rxLocalCellXAt P S oldX cell (0, 0) ∧
          newQ = rxLocalCellQAt P S oldX cell (0, 0) 0) ∨
        (xCoordinate = rxLocalCellXAt P S oldX cell (0, 0) ∧
          newQ = rxLocalCellQAt P S oldX cell (0, 0) 1) ∨
        (xCoordinate = rxLocalCellXAt P S oldX cell (0, 1) ∧
          newQ = rxLocalCellQAt P S oldX cell (0, 1) 0) ∨
        (xCoordinate = rxLocalCellXAt P S oldX cell (0, 1) ∧
          newQ = rxLocalCellQAt P S oldX cell (0, 1) 1) ∨
        (xCoordinate = rxLocalCellXAt P S oldX cell (1, 0) ∧
          newQ = rxLocalCellQAt P S oldX cell (1, 0) 0) ∨
        (xCoordinate = rxLocalCellXAt P S oldX cell (1, 0) ∧
          newQ = rxLocalCellQAt P S oldX cell (1, 0) 1) ∨
        (xCoordinate = rxLocalCellXAt P S oldX cell (1, 1) ∧
          newQ = rxLocalCellQAt P S oldX cell (1, 1) 0) ∨
        (xCoordinate = rxLocalCellXAt P S oldX cell (1, 1) ∧
          newQ = rxLocalCellQAt P S oldX cell (1, 1) 1) := by
    rintro ⟨first, second⟩ qCorner hx hq
    fin_cases first <;> fin_cases second <;> fin_cases qCorner
    · exact Or.inl ⟨hx, hq⟩
    · exact Or.inr (Or.inl ⟨hx, hq⟩)
    · exact Or.inr (Or.inr (Or.inl ⟨hx, hq⟩))
    · exact Or.inr (Or.inr (Or.inr (Or.inl ⟨hx, hq⟩)))
    · exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inl ⟨hx, hq⟩))))
    · exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl ⟨hx, hq⟩)))))
    · exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inr
        (Or.inr (Or.inl ⟨hx, hq⟩))))))
    · exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inr
        (Or.inr (Or.inr ⟨hx, hq⟩))))))
  have routeFace : ∀ qCorner : Two,
      edge = faceQZEdge (rxReplacementPresentation P S) face qCorner →
      (xCoordinate = rxLocalCellXAt P S oldX cell (0, 0) ∧
          newQ = rxLocalCellQAt P S oldX cell (0, 0) 0) ∨
        (xCoordinate = rxLocalCellXAt P S oldX cell (0, 0) ∧
          newQ = rxLocalCellQAt P S oldX cell (0, 0) 1) ∨
        (xCoordinate = rxLocalCellXAt P S oldX cell (0, 1) ∧
          newQ = rxLocalCellQAt P S oldX cell (0, 1) 0) ∨
        (xCoordinate = rxLocalCellXAt P S oldX cell (0, 1) ∧
          newQ = rxLocalCellQAt P S oldX cell (0, 1) 1) ∨
        (xCoordinate = rxLocalCellXAt P S oldX cell (1, 0) ∧
          newQ = rxLocalCellQAt P S oldX cell (1, 0) 0) ∨
        (xCoordinate = rxLocalCellXAt P S oldX cell (1, 0) ∧
          newQ = rxLocalCellQAt P S oldX cell (1, 0) 1) ∨
        (xCoordinate = rxLocalCellXAt P S oldX cell (1, 1) ∧
          newQ = rxLocalCellQAt P S oldX cell (1, 1) 0) ∨
        (xCoordinate = rxLocalCellXAt P S oldX cell (1, 1) ∧
          newQ = rxLocalCellQAt P S oldX cell (1, 1) 1) := by
    intro qCorner hedge
    have hraw := congrArg Subtype.val hedge
    have hq : newQ = rxFaceQ P S face qCorner :=
      congrArg Prod.fst hraw
    have hz : (Sum.inl (Sum.inl ⟨oldX, cell⟩) : RX2 P S) =
        rxFaceZ P S face := congrArg Prod.snd hraw
    rcases face with localFaceData | glue | old
    · rcases localFaceData with ⟨ownerX, ownerCell, corner⟩
      change (Sum.inl (Sum.inl ⟨oldX, cell⟩) : RX2 P S) =
          Sum.inl (Sum.inl ⟨ownerX, ownerCell⟩) at hz
      have howner : (⟨oldX, cell⟩ :
          Σ x : P.X, DoubleCylinderFace P x S) =
          ⟨ownerX, ownerCell⟩ := Sum.inl.inj (Sum.inl.inj hz)
      cases howner
      have hx' : xCoordinate = rxLocalCellXAt P S oldX cell corner := by
        simpa [rxLocalCellXAt, rxFaceX] using hfaceX.symm
      have hq' : newQ =
          rxLocalCellQAt P S oldX cell corner qCorner := by
        simpa [rxLocalCellQAt, rxFaceQ, localFaceQAt] using hq
      exact route corner qCorner hx' hq'
    · rcases glue with ⟨a, qEdge, endpoint⟩
      simp [rxFaceZ, glueFaceZ] at hz
    · rcases old with ⟨oldFace, copy⟩
      simp [rxFaceZ, oldZFaceZ] at hz
  exact huse.elim (routeFace 0) (routeFace 1)

/-- Materialize the exact `F_local_X` X-star boundary-face owner at one
explicit material/Q-corner pair. -/
private noncomputable def rxLocalCellXBoundaryFaceOwnerAtCorner
    (P : TannerSquarePresentation) (S : OddScale)
    (xCoordinate : RX0 P S) (oldX : P.X)
    (cell : DoubleCylinderFace P oldX S) (newQ : RX1 P S)
    (incidence : rxQZIncidence P S newQ
      (Sum.inl (Sum.inl ⟨oldX, cell⟩)) = true)
    (member : xStarEdgeMember (rxReplacementPresentation P S) xCoordinate
      (Sum.inr
        (⟨(newQ, Sum.inl (Sum.inl ⟨oldX, cell⟩)), incidence⟩ :
          QZEdge (rxReplacementPresentation P S))) = true)
    (corner : Two × Two) (qCorner : Two)
    (hx : xCoordinate = rxLocalCellXAt P S oldX cell corner)
    (hq : newQ = rxLocalCellQAt P S oldX cell corner qCorner) :
    {owner : XStarFace (rxReplacementPresentation P S) xCoordinate × Two //
      xStarFaceQZEdge (rxReplacementPresentation P S) xCoordinate
          owner.1 owner.2 =
        ⟨Sum.inr
          (⟨(newQ, Sum.inl (Sum.inl ⟨oldX, cell⟩)), incidence⟩ :
            QZEdge (rxReplacementPresentation P S)), member⟩} := by
  let rawFace : RXFace P S := Sum.inl ⟨oldX, cell, corner⟩
  have hfaceX : rxFaceX P S rawFace = xCoordinate := by
    change localFaceX P S ⟨oldX, cell, corner⟩ = xCoordinate
    exact hx.symm
  have hfaceQ : rxFaceQ P S rawFace qCorner = newQ := by
    change localFaceQAt P S ⟨oldX, cell, corner⟩ qCorner = newQ
    exact hq.symm
  have hfaceZ : rxFaceZ P S rawFace =
      Sum.inl (Sum.inl ⟨oldX, cell⟩) := rfl
  let face : XStarFace (rxReplacementPresentation P S) xCoordinate :=
    ⟨rawFace, by
      simp only [xStarFaceMember, decide_eq_true_eq]
      rw [show (rxReplacementPresentation P S).faceX = rxFaceX P S from rfl]
      exact hfaceX⟩
  refine ⟨(face, qCorner), ?_⟩
  apply Subtype.ext
  apply congrArg Sum.inr
  apply Subtype.ext
  exact Prod.ext hfaceQ hfaceZ

/-- Choice-free `F_local_X` producer for the first successor V4 X-boundary
owner row.  The eight concrete corner pairs are dispatched explicitly. -/
private noncomputable def rxLocalCellXBoundaryFaceOwner
    (P : TannerSquarePresentation) (S : OddScale)
    (xCoordinate : RX0 P S) (oldX : P.X)
    (cell : DoubleCylinderFace P oldX S) (newQ : RX1 P S)
    (incidence : rxQZIncidence P S newQ
      (Sum.inl (Sum.inl ⟨oldX, cell⟩)) = true)
    (member : xStarEdgeMember (rxReplacementPresentation P S) xCoordinate
      (Sum.inr
        (⟨(newQ, Sum.inl (Sum.inl ⟨oldX, cell⟩)), incidence⟩ :
          QZEdge (rxReplacementPresentation P S))) = true) :
    {owner : XStarFace (rxReplacementPresentation P S) xCoordinate × Two //
      xStarFaceQZEdge (rxReplacementPresentation P S) xCoordinate
          owner.1 owner.2 =
        ⟨Sum.inr
          (⟨(newQ, Sum.inl (Sum.inl ⟨oldX, cell⟩)), incidence⟩ :
            QZEdge (rxReplacementPresentation P S)), member⟩} := by
  classical
  have cases := rxXBoundaryLocalCell_pair_cases
    P S xCoordinate oldX cell newQ incidence member
  by_cases h000 : xCoordinate = rxLocalCellXAt P S oldX cell (0, 0) ∧
      newQ = rxLocalCellQAt P S oldX cell (0, 0) 0
  · exact rxLocalCellXBoundaryFaceOwnerAtCorner
      P S xCoordinate oldX cell newQ incidence member (0, 0) 0 h000.1 h000.2
  · by_cases h001 : xCoordinate = rxLocalCellXAt P S oldX cell (0, 0) ∧
        newQ = rxLocalCellQAt P S oldX cell (0, 0) 1
    · exact rxLocalCellXBoundaryFaceOwnerAtCorner
        P S xCoordinate oldX cell newQ incidence member (0, 0) 1 h001.1 h001.2
    · by_cases h010 : xCoordinate = rxLocalCellXAt P S oldX cell (0, 1) ∧
          newQ = rxLocalCellQAt P S oldX cell (0, 1) 0
      · exact rxLocalCellXBoundaryFaceOwnerAtCorner
          P S xCoordinate oldX cell newQ incidence member (0, 1) 0 h010.1 h010.2
      · by_cases h011 :
            xCoordinate = rxLocalCellXAt P S oldX cell (0, 1) ∧
              newQ = rxLocalCellQAt P S oldX cell (0, 1) 1
        · exact rxLocalCellXBoundaryFaceOwnerAtCorner
            P S xCoordinate oldX cell newQ incidence member
              (0, 1) 1 h011.1 h011.2
        · by_cases h100 :
              xCoordinate = rxLocalCellXAt P S oldX cell (1, 0) ∧
                newQ = rxLocalCellQAt P S oldX cell (1, 0) 0
          · exact rxLocalCellXBoundaryFaceOwnerAtCorner
              P S xCoordinate oldX cell newQ incidence member
                (1, 0) 0 h100.1 h100.2
          · by_cases h101 :
                xCoordinate = rxLocalCellXAt P S oldX cell (1, 0) ∧
                  newQ = rxLocalCellQAt P S oldX cell (1, 0) 1
            · exact rxLocalCellXBoundaryFaceOwnerAtCorner
                P S xCoordinate oldX cell newQ incidence member
                  (1, 0) 1 h101.1 h101.2
            · by_cases h110 :
                  xCoordinate = rxLocalCellXAt P S oldX cell (1, 1) ∧
                    newQ = rxLocalCellQAt P S oldX cell (1, 1) 0
              · exact rxLocalCellXBoundaryFaceOwnerAtCorner
                  P S xCoordinate oldX cell newQ incidence member
                    (1, 1) 0 h110.1 h110.2
              · have remaining001 := cases.resolve_left h000
                have remaining010 := remaining001.resolve_left h001
                have remaining011 := remaining010.resolve_left h010
                have remaining100 := remaining011.resolve_left h011
                have remaining101 := remaining100.resolve_left h100
                have remaining110 := remaining101.resolve_left h101
                have h111 := remaining110.resolve_left h110
                exact rxLocalCellXBoundaryFaceOwnerAtCorner
                  P S xCoordinate oldX cell newQ incidence member
                    (1, 1) 1 h111.1 h111.2

/-! ### Successor V4 X-glue boundary-face owner rows -/

/-- An X-star Q-Z edge exposes its X endpoint on the boundary of the
successor Z-star selected by that edge.  Face existence is eliminated only in
this proposition. -/
private theorem rxXBoundaryQZ_to_zBoundaryX
    (P : TannerSquarePresentation) (S : OddScale)
    (xCoordinate : RX0 P S) (newQ : RX1 P S) (newZ : RX2 P S)
    (incidence : rxQZIncidence P S newQ newZ = true)
    (member : xStarEdgeMember (rxReplacementPresentation P S) xCoordinate
      (Sum.inr
        (⟨(newQ, newZ), incidence⟩ :
          QZEdge (rxReplacementPresentation P S))) = true) :
    zStarBoundaryVertexMember (rxReplacementPresentation P S) newZ
      (Vertex.x xCoordinate) = true := by
  classical
  simp only [xStarEdgeMember, decide_eq_true_eq] at member
  obtain ⟨face, hx, huse⟩ := member
  change decide
        ((⟨(newQ, newZ), incidence⟩ :
              QZEdge (rxReplacementPresentation P S)) =
            faceQZEdge (rxReplacementPresentation P S) face 0 ∨
          (⟨(newQ, newZ), incidence⟩ :
              QZEdge (rxReplacementPresentation P S)) =
            faceQZEdge (rxReplacementPresentation P S) face 1) = true at huse
  rw [decide_eq_true_eq] at huse
  simp only [zStarBoundaryVertexMember]
  rw [decide_eq_true_eq]
  refine ⟨face, ?_, ?_⟩
  · simp only [zStarFaceMember, decide_eq_true_eq]
    rcases huse with hzero | hone
    · exact (congrArg
        (fun selected : QZEdge (rxReplacementPresentation P S) =>
          selected.1.2) hzero).symm
    · exact (congrArg
        (fun selected : QZEdge (rxReplacementPresentation P S) =>
          selected.1.2) hone).symm
  · have hfaceX : rxFaceX P S face = xCoordinate := by
      simp only [xStarFaceMember, decide_eq_true_eq] at hx
      rw [show (rxReplacementPresentation P S).faceX = rxFaceX P S from rfl] at hx
      exact hx
    exact hfaceX.symm

/-- An X-star Q-Z edge exposes its Q endpoint on the boundary of the
successor Z-star selected by that edge. -/
private theorem rxXBoundaryQZ_to_zBoundaryQ
    (P : TannerSquarePresentation) (S : OddScale)
    (xCoordinate : RX0 P S) (newQ : RX1 P S) (newZ : RX2 P S)
    (incidence : rxQZIncidence P S newQ newZ = true)
    (member : xStarEdgeMember (rxReplacementPresentation P S) xCoordinate
      (Sum.inr
        (⟨(newQ, newZ), incidence⟩ :
          QZEdge (rxReplacementPresentation P S))) = true) :
    zStarBoundaryVertexMember (rxReplacementPresentation P S) newZ
      (Vertex.q newQ) = true := by
  classical
  simp only [xStarEdgeMember, decide_eq_true_eq] at member
  obtain ⟨face, _hx, huse⟩ := member
  change decide
        ((⟨(newQ, newZ), incidence⟩ :
              QZEdge (rxReplacementPresentation P S)) =
            faceQZEdge (rxReplacementPresentation P S) face 0 ∨
          (⟨(newQ, newZ), incidence⟩ :
              QZEdge (rxReplacementPresentation P S)) =
            faceQZEdge (rxReplacementPresentation P S) face 1) = true at huse
  rw [decide_eq_true_eq] at huse
  simp only [zStarBoundaryVertexMember]
  rw [decide_eq_true_eq]
  rcases huse with hzero | hone
  · refine ⟨face, ?_, Or.inl ?_⟩
    · simp only [zStarFaceMember, decide_eq_true_eq]
      exact (congrArg
        (fun selected : QZEdge (rxReplacementPresentation P S) =>
          selected.1.2) hzero).symm
    · exact congrArg
        (fun selected : QZEdge (rxReplacementPresentation P S) =>
          selected.1.1) hzero
  · refine ⟨face, ?_, Or.inr ?_⟩
    · simp only [zStarFaceMember, decide_eq_true_eq]
      exact (congrArg
        (fun selected : QZEdge (rxReplacementPresentation P S) =>
          selected.1.2) hone).symm
    · exact congrArg
        (fun selected : QZEdge (rxReplacementPresentation P S) =>
          selected.1.1) hone

/-- The Q endpoint of an X-star Q-Z edge is incident to the requested
successor X coordinate. -/
private theorem rxXBoundaryQZ_xqIncidence
    (P : TannerSquarePresentation) (S : OddScale)
    (xCoordinate : RX0 P S) (newQ : RX1 P S) (newZ : RX2 P S)
    (incidence : rxQZIncidence P S newQ newZ = true)
    (member : xStarEdgeMember (rxReplacementPresentation P S) xCoordinate
      (Sum.inr
        (⟨(newQ, newZ), incidence⟩ :
          QZEdge (rxReplacementPresentation P S))) = true) :
    rxXQIncidence P S xCoordinate newQ = true := by
  classical
  simp only [xStarEdgeMember, decide_eq_true_eq] at member
  obtain ⟨face, hx, huse⟩ := member
  change decide
        ((⟨(newQ, newZ), incidence⟩ :
              QZEdge (rxReplacementPresentation P S)) =
            faceQZEdge (rxReplacementPresentation P S) face 0 ∨
          (⟨(newQ, newZ), incidence⟩ :
              QZEdge (rxReplacementPresentation P S)) =
            faceQZEdge (rxReplacementPresentation P S) face 1) = true at huse
  rw [decide_eq_true_eq] at huse
  have hfaceX : rxFaceX P S face = xCoordinate := by
    simp only [xStarFaceMember, decide_eq_true_eq] at hx
    rw [show (rxReplacementPresentation P S).faceX = rxFaceX P S from rfl] at hx
    exact hx
  rcases huse with hzero | hone
  · have hfaceQ : newQ = rxFaceQ P S face 0 := congrArg
      (fun selected : QZEdge (rxReplacementPresentation P S) =>
        selected.1.1) hzero
    exact (rxXQIncidence_eq_true_iff P S xCoordinate newQ).2
      ⟨face, 0, hfaceX, hfaceQ.symm⟩
  · have hfaceQ : newQ = rxFaceQ P S face 1 := congrArg
      (fun selected : QZEdge (rxReplacementPresentation P S) =>
        selected.1.1) hone
    exact (rxXQIncidence_eq_true_iff P S xCoordinate newQ).2
      ⟨face, 1, hfaceX, hfaceQ.symm⟩

/-- In the local-edge glue row, the embedded local edge and the requested
successor X coordinate retain the same old-X owner. -/
private theorem rxXBoundaryQEdgeGlue_localOwner
    (P : TannerSquarePresentation) (S : OddScale)
    (xCoordinate : RX0 P S) (oldX : P.X)
    (localEdge : DoubleCylinderEdge P oldX S)
    (qEdge : Σ q : P.Q, QDoubleCylinderEdge P q S)
    (incidence : rxQZIncidence P S (Sum.inl ⟨oldX, localEdge⟩)
      (Sum.inl (Sum.inr qEdge)) = true)
    (member : xStarEdgeMember (rxReplacementPresentation P S) xCoordinate
      (Sum.inr
        (⟨(Sum.inl ⟨oldX, localEdge⟩, Sum.inl (Sum.inr qEdge)), incidence⟩ :
          QZEdge (rxReplacementPresentation P S))) = true) :
    oldX = xCoordinate.1 := by
  classical
  simp only [xStarEdgeMember, decide_eq_true_eq] at member
  obtain ⟨face, hx, huse⟩ := member
  change decide
        ((⟨(Sum.inl ⟨oldX, localEdge⟩, Sum.inl (Sum.inr qEdge)), incidence⟩ :
              QZEdge (rxReplacementPresentation P S)) =
            faceQZEdge (rxReplacementPresentation P S) face 0 ∨
          (⟨(Sum.inl ⟨oldX, localEdge⟩, Sum.inl (Sum.inr qEdge)), incidence⟩ :
              QZEdge (rxReplacementPresentation P S)) =
            faceQZEdge (rxReplacementPresentation P S) face 1) = true at huse
  rw [decide_eq_true_eq] at huse
  have hfaceX : rxFaceX P S face = xCoordinate := by
    simp only [xStarFaceMember, decide_eq_true_eq] at hx
    rw [show (rxReplacementPresentation P S).faceX = rxFaceX P S from rfl] at hx
    exact hx
  have route : ∀ corner : Two,
      (⟨(Sum.inl ⟨oldX, localEdge⟩, Sum.inl (Sum.inr qEdge)), incidence⟩ :
          QZEdge (rxReplacementPresentation P S)) =
        faceQZEdge (rxReplacementPresentation P S) face corner →
      oldX = xCoordinate.1 := by
    intro corner hedge
    have hraw := congrArg Subtype.val hedge
    have hq := congrArg Prod.fst hraw
    have hz := congrArg Prod.snd hraw
    rcases face with localFace | glue | oldFace
    · change Sum.inl (Sum.inr qEdge) = localFaceZ P S localFace at hz
      simp [localFaceZ] at hz
    · rcases glue with ⟨a, edge, endpoint⟩
      fin_cases corner
      · have hlocal := Sum.inl.inj hq
        exact (congrArg Sigma.fst hlocal).trans
          (congrArg Sigma.fst hfaceX)
      · change Sum.inl ⟨oldX, localEdge⟩ =
          glueFaceQ1 P S ⟨a, edge, endpoint⟩ at hq
        simp [glueFaceQ1] at hq
    · change Sum.inl (Sum.inr qEdge) = oldZFaceZ P S oldFace at hz
      simp [oldZFaceZ] at hz
  exact huse.elim (route 0) (route 1)

/-- Materialize the corner-zero glue owner at an explicit Q-cylinder
endpoint. -/
private noncomputable def rxQEdgeXBoundaryFaceOwnerLocalEdgeAtEndpoint
    (P : TannerSquarePresentation) (S : OddScale)
    (xCoordinate : RX0 P S)
    (qEdge : Σ q : P.Q, QDoubleCylinderEdge P q S)
    (localEdge : DoubleCylinderEdge P xCoordinate.1 S)
    (incidence : rxQZIncidence P S
      (Sum.inl ⟨xCoordinate.1, localEdge⟩)
      (Sum.inl (Sum.inr qEdge)) = true)
    (member : xStarEdgeMember (rxReplacementPresentation P S) xCoordinate
      (Sum.inr
        (⟨(Sum.inl ⟨xCoordinate.1, localEdge⟩,
            Sum.inl (Sum.inr qEdge)), incidence⟩ :
          QZEdge (rxReplacementPresentation P S))) = true)
    (hxq : P.xq xCoordinate.1 qEdge.1 = true) (endpoint : Two)
    (hfaceX : glueFaceX P S
      ⟨(⟨(xCoordinate.1, qEdge.1), hxq⟩ : XQEdge P),
        qEdge.2, endpoint⟩ = xCoordinate)
    (hedge : localEdge = qToXDoubleCylinderEdgeRaw
      P qEdge.1 xCoordinate.1 hxq S qEdge.2) :
    {owner : XStarFace (rxReplacementPresentation P S) xCoordinate × Two //
      xStarFaceQZEdge (rxReplacementPresentation P S) xCoordinate
          owner.1 owner.2 =
        ⟨Sum.inr
          (⟨(Sum.inl ⟨xCoordinate.1, localEdge⟩,
              Sum.inl (Sum.inr qEdge)), incidence⟩ :
            QZEdge (rxReplacementPresentation P S)), member⟩} := by
  let glue : RXXQGlueFace P S :=
    ⟨(⟨(xCoordinate.1, qEdge.1), hxq⟩ : XQEdge P), qEdge.2, endpoint⟩
  let rawFace : RXFace P S := Sum.inr (Sum.inl glue)
  have hfaceQ : rxFaceQ P S rawFace 0 =
      Sum.inl ⟨xCoordinate.1, localEdge⟩ := by
    apply congrArg Sum.inl
    exact Sigma.ext rfl (by simpa only [heq_eq_eq] using hedge.symm)
  have hfaceZ : rxFaceZ P S rawFace =
      Sum.inl (Sum.inr qEdge) := rfl
  let face : XStarFace (rxReplacementPresentation P S) xCoordinate :=
    ⟨rawFace, by
      simp only [xStarFaceMember, decide_eq_true_eq]
      rw [show (rxReplacementPresentation P S).faceX = rxFaceX P S from rfl]
      exact hfaceX⟩
  refine ⟨(face, 0), ?_⟩
  apply Subtype.ext
  apply congrArg Sum.inr
  apply Subtype.ext
  exact Prod.ext hfaceQ hfaceZ

/-- Choice-free corner-zero `F_xqGlue_X` boundary-face owner producer. -/
private noncomputable def rxQEdgeXBoundaryFaceOwnerLocalEdge
    (P : TannerSquarePresentation) (S : OddScale)
    (xCoordinate : RX0 P S)
    (qEdge : Σ q : P.Q, QDoubleCylinderEdge P q S)
    (localEdge : Σ x : P.X, DoubleCylinderEdge P x S)
    (incidence : rxQZIncidence P S (Sum.inl localEdge)
      (Sum.inl (Sum.inr qEdge)) = true)
    (member : xStarEdgeMember (rxReplacementPresentation P S) xCoordinate
      (Sum.inr
        (⟨(Sum.inl localEdge, Sum.inl (Sum.inr qEdge)), incidence⟩ :
          QZEdge (rxReplacementPresentation P S))) = true) :
    {owner : XStarFace (rxReplacementPresentation P S) xCoordinate × Two //
      xStarFaceQZEdge (rxReplacementPresentation P S) xCoordinate
          owner.1 owner.2 =
        ⟨Sum.inr
          (⟨(Sum.inl localEdge, Sum.inl (Sum.inr qEdge)), incidence⟩ :
            QZEdge (rxReplacementPresentation P S)), member⟩} := by
  rcases localEdge with ⟨oldX, localEdge⟩
  have howner := rxXBoundaryQEdgeGlue_localOwner
    P S xCoordinate oldX localEdge qEdge incidence member
  subst oldX
  let xMember := rxXBoundaryQZ_to_zBoundaryX P S xCoordinate
    (Sum.inl ⟨xCoordinate.1, localEdge⟩)
      (Sum.inl (Sum.inr qEdge)) incidence member
  let qMember := rxXBoundaryQZ_to_zBoundaryQ P S xCoordinate
    (Sum.inl ⟨xCoordinate.1, localEdge⟩)
      (Sum.inl (Sum.inr qEdge)) incidence member
  let hxq := rxQEdgeBoundaryX_incidence P S qEdge xCoordinate xMember
  have hedge : localEdge = qToXDoubleCylinderEdgeRaw
      P qEdge.1 xCoordinate.1 hxq S qEdge.2 := by
    simpa using rxQEdgeBoundaryLocalQ_edge P S qEdge
      ⟨xCoordinate.1, localEdge⟩ qMember
  by_cases hzero : xCoordinate = glueFaceX P S
      ⟨(⟨(xCoordinate.1, qEdge.1), hxq⟩ : XQEdge P), qEdge.2, 0⟩
  · exact rxQEdgeXBoundaryFaceOwnerLocalEdgeAtEndpoint
      P S xCoordinate qEdge localEdge
        incidence member hxq 0 hzero.symm hedge
  · have hone := (rxQEdgeBoundaryX_endpoints
      P S qEdge xCoordinate xMember).resolve_left hzero
    exact rxQEdgeXBoundaryFaceOwnerLocalEdgeAtEndpoint
      P S xCoordinate qEdge localEdge
        incidence member hxq 1 hone.symm hedge

/-- Materialize the corner-one glue owner at an explicit endpoint of the
stored Q-cylinder edge. -/
private noncomputable def rxQEdgeXBoundaryFaceOwnerQVertexAtEndpoint
    (P : TannerSquarePresentation) (S : OddScale)
    (xCoordinate : RX0 P S)
    (qEdge : Σ q : P.Q, QDoubleCylinderEdge P q S)
    (endpoint : Two)
    (incidence : rxQZIncidence P S
      (Sum.inr ⟨qEdge.1, edgeEndpoint
        (qDoubleCylinderEdgeStart P qEdge.1 S)
        (qDoubleCylinderEdgeEnd P qEdge.1 S) qEdge.2 endpoint⟩)
      (Sum.inl (Sum.inr qEdge)) = true)
    (member : xStarEdgeMember (rxReplacementPresentation P S) xCoordinate
      (Sum.inr
        (⟨(Sum.inr ⟨qEdge.1, edgeEndpoint
              (qDoubleCylinderEdgeStart P qEdge.1 S)
              (qDoubleCylinderEdgeEnd P qEdge.1 S) qEdge.2 endpoint⟩,
            Sum.inl (Sum.inr qEdge)), incidence⟩ :
          QZEdge (rxReplacementPresentation P S))) = true) :
    {owner : XStarFace (rxReplacementPresentation P S) xCoordinate × Two //
      xStarFaceQZEdge (rxReplacementPresentation P S) xCoordinate
          owner.1 owner.2 =
        ⟨Sum.inr
          (⟨(Sum.inr ⟨qEdge.1, edgeEndpoint
                (qDoubleCylinderEdgeStart P qEdge.1 S)
                (qDoubleCylinderEdgeEnd P qEdge.1 S) qEdge.2 endpoint⟩,
              Sum.inl (Sum.inr qEdge)), incidence⟩ :
            QZEdge (rxReplacementPresentation P S)), member⟩} := by
  let successorXQ := rxXBoundaryQZ_xqIncidence P S xCoordinate
    (Sum.inr ⟨qEdge.1, edgeEndpoint
      (qDoubleCylinderEdgeStart P qEdge.1 S)
      (qDoubleCylinderEdgeEnd P qEdge.1 S) qEdge.2 endpoint⟩)
    (Sum.inl (Sum.inr qEdge)) incidence member
  let hxq := rxQVertexXRadial_oldXQ P S xCoordinate qEdge.1
    (edgeEndpoint (qDoubleCylinderEdgeStart P qEdge.1 S)
      (qDoubleCylinderEdgeEnd P qEdge.1 S) qEdge.2 endpoint) successorXQ
  let glue : RXXQGlueFace P S :=
    ⟨(⟨(xCoordinate.1, qEdge.1), hxq⟩ : XQEdge P), qEdge.2, endpoint⟩
  have hfaceX : glueFaceX P S glue = xCoordinate :=
    rxQVertexGlueFaceX_eq P S xCoordinate qEdge.1
      (edgeEndpoint (qDoubleCylinderEdgeStart P qEdge.1 S)
        (qDoubleCylinderEdgeEnd P qEdge.1 S) qEdge.2 endpoint)
      successorXQ hxq qEdge.2 endpoint rfl
  have hfaceQ : rxFaceQ P S (Sum.inr (Sum.inl glue)) 1 =
      Sum.inr ⟨qEdge.1, edgeEndpoint
        (qDoubleCylinderEdgeStart P qEdge.1 S)
        (qDoubleCylinderEdgeEnd P qEdge.1 S) qEdge.2 endpoint⟩ := rfl
  have hfaceZ : rxFaceZ P S (Sum.inr (Sum.inl glue)) =
      Sum.inl (Sum.inr qEdge) := rfl
  let face : XStarFace (rxReplacementPresentation P S) xCoordinate :=
    ⟨Sum.inr (Sum.inl glue), by
      simp only [xStarFaceMember, decide_eq_true_eq]
      rw [show (rxReplacementPresentation P S).faceX = rxFaceX P S from rfl]
      exact hfaceX⟩
  refine ⟨(face, 1), ?_⟩
  apply Subtype.ext
  apply congrArg Sum.inr
  apply Subtype.ext
  exact Prod.ext hfaceQ hfaceZ

/-- Choice-free corner-one `F_xqGlue_X` boundary-face owner producer. -/
private noncomputable def rxQEdgeXBoundaryFaceOwnerQVertex
    (P : TannerSquarePresentation) (S : OddScale)
    (xCoordinate : RX0 P S)
    (qEdge : Σ q : P.Q, QDoubleCylinderEdge P q S)
    (qVertex : Σ q : P.Q, QDoubleCylinderVertex P q S)
    (incidence : rxQZIncidence P S (Sum.inr qVertex)
      (Sum.inl (Sum.inr qEdge)) = true)
    (member : xStarEdgeMember (rxReplacementPresentation P S) xCoordinate
      (Sum.inr
        (⟨(Sum.inr qVertex, Sum.inl (Sum.inr qEdge)), incidence⟩ :
          QZEdge (rxReplacementPresentation P S))) = true) :
    {owner : XStarFace (rxReplacementPresentation P S) xCoordinate × Two //
      xStarFaceQZEdge (rxReplacementPresentation P S) xCoordinate
          owner.1 owner.2 =
        ⟨Sum.inr
          (⟨(Sum.inr qVertex, Sum.inl (Sum.inr qEdge)), incidence⟩ :
            QZEdge (rxReplacementPresentation P S)), member⟩} := by
  let qMember := rxXBoundaryQZ_to_zBoundaryQ P S xCoordinate
    (Sum.inr qVertex) (Sum.inl (Sum.inr qEdge)) incidence member
  by_cases hstart : qVertex = ⟨qEdge.1,
      qDoubleCylinderEdgeStart P qEdge.1 S qEdge.2⟩
  · cases hstart
    exact rxQEdgeXBoundaryFaceOwnerQVertexAtEndpoint
      P S xCoordinate qEdge 0 incidence member
  · have hend := (rxQEdgeBoundaryQVertex_endpoints
      P S qEdge qVertex qMember).resolve_left hstart
    cases hend
    exact rxQEdgeXBoundaryFaceOwnerQVertexAtEndpoint
      P S xCoordinate qEdge 1 incidence member

/-! ### Successor V4 retained old-Z X-boundary owner row -/

/-- The old Q-Z edge underlying a terminal retained-old-Z successor edge lies
in the old X-star selected by the successor X coordinate.  Successor face
existence is eliminated only in this proposition. -/
private theorem rxOldZXBoundary_oldEdgeMember
    (P : TannerSquarePresentation) (S : OddScale)
    (xCoordinate : RX0 P S) (oldZ : P.Z) (copy newCopy : Two)
    (q : P.Q) (endpoint : QStarEdge P q)
    (incidence : rxQZIncidence P S
      (Sum.inr ⟨q, (newCopy, Sum.inl (Sum.inr endpoint))⟩)
      (Sum.inr (oldZ, copy)) = true)
    (member : xStarEdgeMember (rxReplacementPresentation P S) xCoordinate
      (Sum.inr
        (⟨(Sum.inr ⟨q, (newCopy, Sum.inl (Sum.inr endpoint))⟩,
            Sum.inr (oldZ, copy)), incidence⟩ :
          QZEdge (rxReplacementPresentation P S))) = true)
    (oldQMember : zStarBoundaryVertexMember P oldZ
      (Vertex.q q) = true) :
    xStarEdgeMember P xCoordinate.1
      (Sum.inr
        (⟨(q, oldZ), rxOldZBoundaryQZIncidence P q oldZ oldQMember⟩ :
          QZEdge P)) = true := by
  classical
  let oldEdge : QZEdge P :=
    ⟨(q, oldZ), rxOldZBoundaryQZIncidence P q oldZ oldQMember⟩
  simp only [xStarEdgeMember, decide_eq_true_eq] at member
  obtain ⟨face, hx, huse⟩ := member
  change decide
        ((⟨(Sum.inr ⟨q, (newCopy, Sum.inl (Sum.inr endpoint))⟩,
              Sum.inr (oldZ, copy)), incidence⟩ :
            QZEdge (rxReplacementPresentation P S)) =
            faceQZEdge (rxReplacementPresentation P S) face 0 ∨
          (⟨(Sum.inr ⟨q, (newCopy, Sum.inl (Sum.inr endpoint))⟩,
              Sum.inr (oldZ, copy)), incidence⟩ :
            QZEdge (rxReplacementPresentation P S)) =
            faceQZEdge (rxReplacementPresentation P S) face 1) = true at huse
  rw [decide_eq_true_eq] at huse
  simp only [xStarEdgeMember, decide_eq_true_eq]
  have route : ∀ corner : Two,
      (⟨(Sum.inr ⟨q, (newCopy, Sum.inl (Sum.inr endpoint))⟩,
          Sum.inr (oldZ, copy)), incidence⟩ :
        QZEdge (rxReplacementPresentation P S)) =
          faceQZEdge (rxReplacementPresentation P S) face corner →
      ∃ oldFace : P.Face,
        xStarFaceMember P xCoordinate.1 oldFace = true ∧
          decide (oldEdge = faceQZEdge P oldFace 0 ∨
            oldEdge = faceQZEdge P oldFace 1) = true := by
    intro corner hedge
    have hraw := congrArg Subtype.val hedge
    have hq := congrArg Prod.fst hraw
    have hz := congrArg Prod.snd hraw
    rcases face with localFace | glue | oldFace
    · change Sum.inr (oldZ, copy) = localFaceZ P S localFace at hz
      simp [localFaceZ] at hz
    · change Sum.inr (oldZ, copy) = glueFaceZ P S glue at hz
      simp [glueFaceZ] at hz
    · rcases oldFace with ⟨oldFace, storedCopy⟩
      have hzpair : (P.faceZ oldFace, storedCopy) = (oldZ, copy) := by
        change Sum.inr (oldZ, copy) =
          Sum.inr (P.faceZ oldFace, storedCopy) at hz
        exact (Sum.inr.inj hz).symm
      have hfaceZ : P.faceZ oldFace = oldZ := congrArg Prod.fst hzpair
      have hfaceX : P.faceX oldFace = xCoordinate.1 := by
        have hsuccessorX : rxFaceX P S
            (Sum.inr (Sum.inr (oldFace, storedCopy))) = xCoordinate := by
          simp only [xStarFaceMember, decide_eq_true_eq] at hx
          rw [show (rxReplacementPresentation P S).faceX = rxFaceX P S from rfl] at hx
          exact hx
        exact congrArg Sigma.fst hsuccessorX
      have hfaceQ : P.faceQ oldFace corner = q := by
        have hsuccessorQ :
            Sum.inr ⟨q, (newCopy, Sum.inl (Sum.inr endpoint))⟩ =
              rxFaceQ P S (Sum.inr (Sum.inr (oldFace, storedCopy))) corner := hq
        exact (congrArg Sigma.fst (Sum.inr.inj hsuccessorQ)).symm
      refine ⟨oldFace, ?_, ?_⟩
      · simpa [xStarFaceMember] using hfaceX
      · rw [decide_eq_true_eq]
        apply rxTwoElim (motive := fun corner =>
          P.faceQ oldFace corner = q →
            oldEdge = faceQZEdge P oldFace 0 ∨
              oldEdge = faceQZEdge P oldFace 1)
        · intro hq0
          left
          apply Subtype.ext
          exact Prod.ext hq0.symm hfaceZ.symm
        · intro hq1
          right
          apply Subtype.ext
          exact Prod.ext hq1.symm hfaceZ.symm
        · exact hfaceQ
  obtain ⟨oldFace, hmember, hedge⟩ := huse.elim (route 0) (route 1)
  exact ⟨oldFace, hmember, hedge⟩

/-- Any old face selected for the projected old Q-Z edge has the same
copywise successor X coordinate as the original successor face witness. -/
private theorem rxOldZXBoundary_selectedFaceX
    (P : TannerSquarePresentation) (S : OddScale)
    (xCoordinate : RX0 P S) (oldZ : P.Z) (copy newCopy : Two)
    (q : P.Q) (endpoint : QStarEdge P q)
    (incidence : rxQZIncidence P S
      (Sum.inr ⟨q, (newCopy, Sum.inl (Sum.inr endpoint))⟩)
      (Sum.inr (oldZ, copy)) = true)
    (member : xStarEdgeMember (rxReplacementPresentation P S) xCoordinate
      (Sum.inr
        (⟨(Sum.inr ⟨q, (newCopy, Sum.inl (Sum.inr endpoint))⟩,
            Sum.inr (oldZ, copy)), incidence⟩ :
          QZEdge (rxReplacementPresentation P S))) = true)
    (selectedFace : P.Face)
    (hselectedX : P.faceX selectedFace = xCoordinate.1)
    (hselectedZ : P.faceZ selectedFace = oldZ) :
    oldZFaceX P S (selectedFace, copy) = xCoordinate := by
  classical
  simp only [xStarEdgeMember, decide_eq_true_eq] at member
  obtain ⟨face, hx, huse⟩ := member
  change decide
        ((⟨(Sum.inr ⟨q, (newCopy, Sum.inl (Sum.inr endpoint))⟩,
              Sum.inr (oldZ, copy)), incidence⟩ :
            QZEdge (rxReplacementPresentation P S)) =
            faceQZEdge (rxReplacementPresentation P S) face 0 ∨
          (⟨(Sum.inr ⟨q, (newCopy, Sum.inl (Sum.inr endpoint))⟩,
              Sum.inr (oldZ, copy)), incidence⟩ :
            QZEdge (rxReplacementPresentation P S)) =
            faceQZEdge (rxReplacementPresentation P S) face 1) = true at huse
  rw [decide_eq_true_eq] at huse
  have route : ∀ corner : Two,
      (⟨(Sum.inr ⟨q, (newCopy, Sum.inl (Sum.inr endpoint))⟩,
          Sum.inr (oldZ, copy)), incidence⟩ :
        QZEdge (rxReplacementPresentation P S)) =
          faceQZEdge (rxReplacementPresentation P S) face corner →
      oldZFaceX P S (selectedFace, copy) = xCoordinate := by
    intro corner hedge
    have hraw := congrArg Subtype.val hedge
    have hz := congrArg Prod.snd hraw
    rcases face with localFace | glue | oldFace
    · change Sum.inr (oldZ, copy) = localFaceZ P S localFace at hz
      simp [localFaceZ] at hz
    · change Sum.inr (oldZ, copy) = glueFaceZ P S glue at hz
      simp [glueFaceZ] at hz
    · rcases oldFace with ⟨sourceFace, storedCopy⟩
      have hzpair : (P.faceZ sourceFace, storedCopy) = (oldZ, copy) := by
        change Sum.inr (oldZ, copy) =
          Sum.inr (P.faceZ sourceFace, storedCopy) at hz
        exact (Sum.inr.inj hz).symm
      have hsourceZ : P.faceZ sourceFace = oldZ :=
        congrArg Prod.fst hzpair
      have hcopy : storedCopy = copy := congrArg Prod.snd hzpair
      have hsource : oldZFaceX P S (sourceFace, storedCopy) =
          xCoordinate := by
        have hrawX : rxFaceX P S
            (Sum.inr (Sum.inr (sourceFace, storedCopy))) = xCoordinate := by
          simp only [xStarFaceMember, decide_eq_true_eq] at hx
          rw [show (rxReplacementPresentation P S).faceX = rxFaceX P S from rfl] at hx
          exact hx
        exact hrawX
      have hsourceX : P.faceX sourceFace = xCoordinate.1 :=
        congrArg Sigma.fst hsource
      subst storedCopy
      exact (oldZFaceX_congr P S selectedFace sourceFace copy
        (hselectedX.trans hsourceX.symm)
        (hselectedZ.trans hsourceZ.symm)).trans hsource
  exact huse.elim (route 0) (route 1)

/-- `F_oldZ_X` boundary-face owner.  Projection/re-embedding normalizes both
successor endpoints; the input V4 owner supplies the old face and preserves
its ordered boundary corner unchanged. -/
private noncomputable def rxOldZXBoundaryFaceOwnerTerminal
    (P : TannerSquarePresentation) (A4 : TannerSquareAdmissibleV4 P)
    (S : OddScale) (xCoordinate : RX0 P S)
    (oldZ : P.Z) (copy newCopy : Two) (q : P.Q)
    (endpoint : QStarEdge P q)
    (incidence : rxQZIncidence P S
      (Sum.inr ⟨q, (newCopy, Sum.inl (Sum.inr endpoint))⟩)
      (Sum.inr (oldZ, copy)) = true)
    (member : xStarEdgeMember (rxReplacementPresentation P S) xCoordinate
      (Sum.inr
        (⟨(Sum.inr ⟨q, (newCopy, Sum.inl (Sum.inr endpoint))⟩,
            Sum.inr (oldZ, copy)), incidence⟩ :
          QZEdge (rxReplacementPresentation P S))) = true) :
    {owner : XStarFace (rxReplacementPresentation P S) xCoordinate × Two //
      xStarFaceQZEdge (rxReplacementPresentation P S) xCoordinate
          owner.1 owner.2 =
        ⟨Sum.inr
          (⟨(Sum.inr ⟨q, (newCopy, Sum.inl (Sum.inr endpoint))⟩,
              Sum.inr (oldZ, copy)), incidence⟩ :
            QZEdge (rxReplacementPresentation P S)), member⟩} := by
  let newQ : RX1 P S :=
    Sum.inr ⟨q, (newCopy, Sum.inl (Sum.inr endpoint))⟩
  let qMember := rxXBoundaryQZ_to_zBoundaryQ P S xCoordinate newQ
    (Sum.inr (oldZ, copy)) incidence member
  let successorQ : ZStarBoundaryVertex
      (rxReplacementPresentation P S) (Sum.inr (oldZ, copy)) :=
    ⟨Vertex.q newQ, qMember⟩
  let oldQVertex := rxOldZBoundaryVertexProject
    P S oldZ copy successorQ
  have oldQMember : zStarBoundaryVertexMember P oldZ
      (Vertex.q q) = true := oldQVertex.2
  have mappedQ := rxOldZBoundaryVertexMap_project
    P S oldZ copy successorQ
  have hmappedQ : rxOldZCopyQCoordinate
      P S oldZ copy q oldQMember = newQ := by
    exact Vertex.q.inj (congrArg Subtype.val mappedQ)
  let oldIncidence := rxOldZBoundaryQZIncidence P q oldZ oldQMember
  let oldEdge : QZEdge P := ⟨(q, oldZ), oldIncidence⟩
  let oldMember := rxOldZXBoundary_oldEdgeMember
    P S xCoordinate oldZ copy newCopy q endpoint incidence member oldQMember
  let selected := A4.xBoundaryFaceOwner xCoordinate.1 oldEdge oldMember
  have hselected := congrArg Subtype.val selected.2
  have hedge : faceQZEdge P selected.1.1.1 selected.1.2 = oldEdge :=
    Sum.inr.inj hselected
  have hfaceX : P.faceX selected.1.1.1 = xCoordinate.1 := by
    simpa [xStarFaceMember] using selected.1.1.2
  have hfaceQ : P.faceQ selected.1.1.1 selected.1.2 = q :=
    (congrArg (fun chosen : QZEdge P => chosen.1.1) hedge).trans rfl
  have hfaceZ : P.faceZ selected.1.1.1 = oldZ :=
    (congrArg (fun chosen : QZEdge P => chosen.1.2) hedge).trans rfl
  let rawFace : RXFace P S :=
    Sum.inr (Sum.inr (selected.1.1.1, copy))
  have hsuccessorX : rxFaceX P S rawFace = xCoordinate := by
    exact rxOldZXBoundary_selectedFaceX
      P S xCoordinate oldZ copy newCopy q endpoint incidence member
        selected.1.1.1 hfaceX hfaceZ
  have hlift := congrArg (fun chosen : QZEdge P =>
      (Sum.inr ⟨chosen.1.1,
        (copy, Sum.inl (Sum.inr
          (⟨chosen.1.2, chosen.2⟩ : QStarEdge P chosen.1.1)))⟩ :
        RX1 P S)) hedge
  have hsuccessorQ : rxFaceQ P S rawFace selected.1.2 = newQ := by
    rw [show rxFaceQ P S rawFace selected.1.2 =
        rxOldZCopyQCoordinate P S oldZ copy q oldQMember by
      simpa [rawFace, rxFaceQ, oldZFaceQ, rxOldZCopyQCoordinate,
        oldEdge, oldIncidence, faceQZEdge] using hlift]
    exact hmappedQ
  have hsuccessorZ : rxFaceZ P S rawFace =
      Sum.inr (oldZ, copy) := by
    simp [rawFace, rxFaceZ, oldZFaceZ, hfaceZ]
  let face : XStarFace (rxReplacementPresentation P S) xCoordinate :=
    ⟨rawFace, by
      simp only [xStarFaceMember, decide_eq_true_eq]
      rw [show (rxReplacementPresentation P S).faceX = rxFaceX P S from rfl]
      exact hsuccessorX⟩
  refine ⟨(face, selected.1.2), ?_⟩
  apply Subtype.ext
  apply congrArg Sum.inr
  apply Subtype.ext
  exact Prod.ext hsuccessorQ hsuccessorZ

/-- Total successor X-boundary face owner, covering the local-cell row, both
X-Q glue Q rows, and the retained old-Z row. -/
noncomputable def rxReplacementXBoundaryFaceOwner
    (P : TannerSquarePresentation) (A4 : TannerSquareAdmissibleV4 P)
    (S : OddScale) (xCoordinate : (rxReplacementPresentation P S).X)
    (edge : QZEdge (rxReplacementPresentation P S))
    (member : xStarEdgeMember (rxReplacementPresentation P S) xCoordinate
      (Sum.inr edge) = true) :
    {owner : XStarFace (rxReplacementPresentation P S) xCoordinate × Two //
      xStarFaceQZEdge (rxReplacementPresentation P S) xCoordinate
          owner.1 owner.2 = ⟨Sum.inr edge, member⟩} := by
  rcases edge with ⟨⟨newQ, newZ⟩, incidence⟩
  rcases newZ with nonOldZ | oldZCopy
  · rcases nonOldZ with localCell | qEdge
    · rcases localCell with ⟨oldX, cell⟩
      exact rxLocalCellXBoundaryFaceOwner
        P S xCoordinate oldX cell newQ incidence member
    · rcases newQ with localEdge | qVertex
      · exact rxQEdgeXBoundaryFaceOwnerLocalEdge
          P S xCoordinate qEdge localEdge incidence member
      · exact rxQEdgeXBoundaryFaceOwnerQVertex
          P S xCoordinate qEdge qVertex incidence member
  · rcases oldZCopy with ⟨oldZ, copy⟩
    let qMember := rxXBoundaryQZ_to_zBoundaryQ P S xCoordinate newQ
      (Sum.inr (oldZ, copy)) incidence member
    have terminal := rxOldZBoundaryQ_terminal
      P S oldZ copy newQ qMember
    rcases newQ with localEdge | qVertex
    · exact terminal.elim
    · rcases qVertex with ⟨q, newCopy, vertex⟩
      rcases vertex with original | interior
      · rcases original with center | endpoint
        · exact terminal.elim
        · exact rxOldZXBoundaryFaceOwnerTerminal
            P A4 S xCoordinate oldZ copy newCopy q endpoint incidence member
      · exact terminal.elim

/-! ### Successor V4 Z-local boundary-face owner row -/

/-- A successor X-Q boundary edge in a fixed local-cell Z-star determines
one of the eight explicit `(material corner, Q corner)` pairs of that cell.
Face existence is eliminated only in this proposition. -/
private theorem rxZBoundaryLocalCellLocalEdge_pair_cases
    (P : TannerSquarePresentation) (S : OddScale) (oldX : P.X)
    (cell : DoubleCylinderFace P oldX S) (newX : RX0 P S)
    (localEdge : Σ x : P.X, DoubleCylinderEdge P x S)
    (incidence : rxXQIncidence P S newX (Sum.inl localEdge) = true)
    (member : zStarEdgeMember (rxReplacementPresentation P S)
      (Sum.inl (Sum.inl ⟨oldX, cell⟩))
      (Sum.inl
        (⟨(newX, Sum.inl localEdge), incidence⟩ :
          XQEdge (rxReplacementPresentation P S))) = true) :
    (newX = rxLocalCellXAt P S oldX cell (0, 0) ∧
        (Sum.inl localEdge : RX1 P S) =
          rxLocalCellQAt P S oldX cell (0, 0) 0) ∨
      (newX = rxLocalCellXAt P S oldX cell (0, 0) ∧
        (Sum.inl localEdge : RX1 P S) =
          rxLocalCellQAt P S oldX cell (0, 0) 1) ∨
      (newX = rxLocalCellXAt P S oldX cell (0, 1) ∧
        (Sum.inl localEdge : RX1 P S) =
          rxLocalCellQAt P S oldX cell (0, 1) 0) ∨
      (newX = rxLocalCellXAt P S oldX cell (0, 1) ∧
        (Sum.inl localEdge : RX1 P S) =
          rxLocalCellQAt P S oldX cell (0, 1) 1) ∨
      (newX = rxLocalCellXAt P S oldX cell (1, 0) ∧
        (Sum.inl localEdge : RX1 P S) =
          rxLocalCellQAt P S oldX cell (1, 0) 0) ∨
      (newX = rxLocalCellXAt P S oldX cell (1, 0) ∧
        (Sum.inl localEdge : RX1 P S) =
          rxLocalCellQAt P S oldX cell (1, 0) 1) ∨
      (newX = rxLocalCellXAt P S oldX cell (1, 1) ∧
        (Sum.inl localEdge : RX1 P S) =
          rxLocalCellQAt P S oldX cell (1, 1) 0) ∨
      (newX = rxLocalCellXAt P S oldX cell (1, 1) ∧
        (Sum.inl localEdge : RX1 P S) =
          rxLocalCellQAt P S oldX cell (1, 1) 1) := by
  classical
  let edge : XQEdge (rxReplacementPresentation P S) :=
    ⟨(newX, Sum.inl localEdge), incidence⟩
  simp only [zStarEdgeMember, decide_eq_true_eq] at member
  obtain ⟨face, hface, huse⟩ := member
  change decide (edge = faceXQEdge (rxReplacementPresentation P S) face 0 ∨
    edge = faceXQEdge (rxReplacementPresentation P S) face 1) = true at huse
  rw [decide_eq_true_eq] at huse
  have hfaceZ : rxFaceZ P S face =
      Sum.inl (Sum.inl ⟨oldX, cell⟩) := by
    simp only [zStarFaceMember, decide_eq_true_eq] at hface
    rw [show (rxReplacementPresentation P S).faceZ = rxFaceZ P S from rfl] at hface
    exact hface
  have route : ∀ (corner : Two × Two) (qCorner : Two),
      newX = rxLocalCellXAt P S oldX cell corner →
      (Sum.inl localEdge : RX1 P S) =
          rxLocalCellQAt P S oldX cell corner qCorner →
      (newX = rxLocalCellXAt P S oldX cell (0, 0) ∧
          (Sum.inl localEdge : RX1 P S) =
            rxLocalCellQAt P S oldX cell (0, 0) 0) ∨
        (newX = rxLocalCellXAt P S oldX cell (0, 0) ∧
          (Sum.inl localEdge : RX1 P S) =
            rxLocalCellQAt P S oldX cell (0, 0) 1) ∨
        (newX = rxLocalCellXAt P S oldX cell (0, 1) ∧
          (Sum.inl localEdge : RX1 P S) =
            rxLocalCellQAt P S oldX cell (0, 1) 0) ∨
        (newX = rxLocalCellXAt P S oldX cell (0, 1) ∧
          (Sum.inl localEdge : RX1 P S) =
            rxLocalCellQAt P S oldX cell (0, 1) 1) ∨
        (newX = rxLocalCellXAt P S oldX cell (1, 0) ∧
          (Sum.inl localEdge : RX1 P S) =
            rxLocalCellQAt P S oldX cell (1, 0) 0) ∨
        (newX = rxLocalCellXAt P S oldX cell (1, 0) ∧
          (Sum.inl localEdge : RX1 P S) =
            rxLocalCellQAt P S oldX cell (1, 0) 1) ∨
        (newX = rxLocalCellXAt P S oldX cell (1, 1) ∧
          (Sum.inl localEdge : RX1 P S) =
            rxLocalCellQAt P S oldX cell (1, 1) 0) ∨
        (newX = rxLocalCellXAt P S oldX cell (1, 1) ∧
          (Sum.inl localEdge : RX1 P S) =
            rxLocalCellQAt P S oldX cell (1, 1) 1) := by
    rintro ⟨first, second⟩ qCorner hx hq
    fin_cases first <;> fin_cases second <;> fin_cases qCorner
    · exact Or.inl ⟨hx, hq⟩
    · exact Or.inr (Or.inl ⟨hx, hq⟩)
    · exact Or.inr (Or.inr (Or.inl ⟨hx, hq⟩))
    · exact Or.inr (Or.inr (Or.inr (Or.inl ⟨hx, hq⟩)))
    · exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inl ⟨hx, hq⟩))))
    · exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl ⟨hx, hq⟩)))))
    · exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inr
        (Or.inr (Or.inl ⟨hx, hq⟩))))))
    · exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inr
        (Or.inr (Or.inr ⟨hx, hq⟩))))))
  have routeFace : ∀ qCorner : Two,
      edge = faceXQEdge (rxReplacementPresentation P S) face qCorner →
      (newX = rxLocalCellXAt P S oldX cell (0, 0) ∧
          (Sum.inl localEdge : RX1 P S) =
            rxLocalCellQAt P S oldX cell (0, 0) 0) ∨
        (newX = rxLocalCellXAt P S oldX cell (0, 0) ∧
          (Sum.inl localEdge : RX1 P S) =
            rxLocalCellQAt P S oldX cell (0, 0) 1) ∨
        (newX = rxLocalCellXAt P S oldX cell (0, 1) ∧
          (Sum.inl localEdge : RX1 P S) =
            rxLocalCellQAt P S oldX cell (0, 1) 0) ∨
        (newX = rxLocalCellXAt P S oldX cell (0, 1) ∧
          (Sum.inl localEdge : RX1 P S) =
            rxLocalCellQAt P S oldX cell (0, 1) 1) ∨
        (newX = rxLocalCellXAt P S oldX cell (1, 0) ∧
          (Sum.inl localEdge : RX1 P S) =
            rxLocalCellQAt P S oldX cell (1, 0) 0) ∨
        (newX = rxLocalCellXAt P S oldX cell (1, 0) ∧
          (Sum.inl localEdge : RX1 P S) =
            rxLocalCellQAt P S oldX cell (1, 0) 1) ∨
        (newX = rxLocalCellXAt P S oldX cell (1, 1) ∧
          (Sum.inl localEdge : RX1 P S) =
            rxLocalCellQAt P S oldX cell (1, 1) 0) ∨
        (newX = rxLocalCellXAt P S oldX cell (1, 1) ∧
          (Sum.inl localEdge : RX1 P S) =
            rxLocalCellQAt P S oldX cell (1, 1) 1) := by
    intro qCorner hedge
    have hraw := congrArg Subtype.val hedge
    have hx : newX = rxFaceX P S face := congrArg Prod.fst hraw
    have hq : (Sum.inl localEdge : RX1 P S) =
        rxFaceQ P S face qCorner := congrArg Prod.snd hraw
    rcases face with localFaceData | glue | old
    · rcases localFaceData with ⟨ownerX, ownerCell, corner⟩
      change (Sum.inl (Sum.inl ⟨ownerX, ownerCell⟩) : RX2 P S) =
          Sum.inl (Sum.inl ⟨oldX, cell⟩) at hfaceZ
      have howner : (⟨ownerX, ownerCell⟩ :
          Σ x : P.X, DoubleCylinderFace P x S) = ⟨oldX, cell⟩ :=
        Sum.inl.inj (Sum.inl.inj hfaceZ)
      cases howner
      have hx' : newX = rxLocalCellXAt P S oldX cell corner := by
        simpa [rxLocalCellXAt, rxFaceX] using hx
      have hq' : (Sum.inl localEdge : RX1 P S) =
          rxLocalCellQAt P S oldX cell corner qCorner := by
        simpa [rxLocalCellQAt, rxFaceQ, localFaceQAt] using hq
      exact route corner qCorner hx' hq'
    · rcases glue with ⟨a, qEdge, endpoint⟩
      simp [rxFaceZ, glueFaceZ] at hfaceZ
    · rcases old with ⟨oldFace, copy⟩
      simp [rxFaceZ, oldZFaceZ] at hfaceZ
  exact huse.elim (routeFace 0) (routeFace 1)

/-- Materialize the exact `F_local_X` Z-star boundary-face owner at one
explicit material/Q-corner pair. -/
private noncomputable def rxLocalCellZBoundaryFaceOwnerLocalEdgeAtCorner
    (P : TannerSquarePresentation) (S : OddScale) (oldX : P.X)
    (cell : DoubleCylinderFace P oldX S) (newX : RX0 P S)
    (localEdge : Σ x : P.X, DoubleCylinderEdge P x S)
    (incidence : rxXQIncidence P S newX (Sum.inl localEdge) = true)
    (member : zStarEdgeMember (rxReplacementPresentation P S)
      (Sum.inl (Sum.inl ⟨oldX, cell⟩))
      (Sum.inl
        (⟨(newX, Sum.inl localEdge), incidence⟩ :
          XQEdge (rxReplacementPresentation P S))) = true)
    (corner : Two × Two) (qCorner : Two)
    (hx : newX = rxLocalCellXAt P S oldX cell corner)
    (hq : (Sum.inl localEdge : RX1 P S) =
      rxLocalCellQAt P S oldX cell corner qCorner) :
    {owner : ZStarFace (rxReplacementPresentation P S)
        (Sum.inl (Sum.inl ⟨oldX, cell⟩)) × Two //
      zStarFaceXQEdge (rxReplacementPresentation P S)
          (Sum.inl (Sum.inl ⟨oldX, cell⟩)) owner.1 owner.2 =
        ⟨Sum.inl
          (⟨(newX, Sum.inl localEdge), incidence⟩ :
            XQEdge (rxReplacementPresentation P S)), member⟩} := by
  let rawFace : RXFace P S := Sum.inl ⟨oldX, cell, corner⟩
  have hfaceX : rxFaceX P S rawFace = newX := by
    change localFaceX P S ⟨oldX, cell, corner⟩ = newX
    exact hx.symm
  have hfaceQ : rxFaceQ P S rawFace qCorner =
      (Sum.inl localEdge : RX1 P S) := by
    change localFaceQAt P S ⟨oldX, cell, corner⟩ qCorner = Sum.inl localEdge
    exact hq.symm
  let face := rxLocalCellZStarFace P S oldX cell corner
  refine ⟨(face, qCorner), ?_⟩
  apply Subtype.ext
  apply congrArg Sum.inl
  apply Subtype.ext
  exact Prod.ext hfaceX hfaceQ

/-- Choice-free `F_local_X` producer for the successor V4 local-cell/local-
edge Z-boundary owner row.  The eight concrete corner pairs are dispatched
explicitly. -/
private noncomputable def rxLocalCellZBoundaryFaceOwnerLocalEdge
    (P : TannerSquarePresentation) (S : OddScale) (oldX : P.X)
    (cell : DoubleCylinderFace P oldX S) (newX : RX0 P S)
    (localEdge : Σ x : P.X, DoubleCylinderEdge P x S)
    (incidence : rxXQIncidence P S newX (Sum.inl localEdge) = true)
    (member : zStarEdgeMember (rxReplacementPresentation P S)
      (Sum.inl (Sum.inl ⟨oldX, cell⟩))
      (Sum.inl
        (⟨(newX, Sum.inl localEdge), incidence⟩ :
          XQEdge (rxReplacementPresentation P S))) = true) :
    {owner : ZStarFace (rxReplacementPresentation P S)
        (Sum.inl (Sum.inl ⟨oldX, cell⟩)) × Two //
      zStarFaceXQEdge (rxReplacementPresentation P S)
          (Sum.inl (Sum.inl ⟨oldX, cell⟩)) owner.1 owner.2 =
        ⟨Sum.inl
          (⟨(newX, Sum.inl localEdge), incidence⟩ :
            XQEdge (rxReplacementPresentation P S)), member⟩} := by
  classical
  have cases := rxZBoundaryLocalCellLocalEdge_pair_cases
    P S oldX cell newX localEdge incidence member
  by_cases h000 : newX = rxLocalCellXAt P S oldX cell (0, 0) ∧
      (Sum.inl localEdge : RX1 P S) =
        rxLocalCellQAt P S oldX cell (0, 0) 0
  · exact rxLocalCellZBoundaryFaceOwnerLocalEdgeAtCorner
      P S oldX cell newX localEdge incidence member (0, 0) 0 h000.1 h000.2
  · by_cases h001 : newX = rxLocalCellXAt P S oldX cell (0, 0) ∧
        (Sum.inl localEdge : RX1 P S) =
          rxLocalCellQAt P S oldX cell (0, 0) 1
    · exact rxLocalCellZBoundaryFaceOwnerLocalEdgeAtCorner
        P S oldX cell newX localEdge incidence member (0, 0) 1 h001.1 h001.2
    · by_cases h010 : newX = rxLocalCellXAt P S oldX cell (0, 1) ∧
          (Sum.inl localEdge : RX1 P S) =
            rxLocalCellQAt P S oldX cell (0, 1) 0
      · exact rxLocalCellZBoundaryFaceOwnerLocalEdgeAtCorner
          P S oldX cell newX localEdge incidence member (0, 1) 0 h010.1 h010.2
      · by_cases h011 :
            newX = rxLocalCellXAt P S oldX cell (0, 1) ∧
              (Sum.inl localEdge : RX1 P S) =
                rxLocalCellQAt P S oldX cell (0, 1) 1
        · exact rxLocalCellZBoundaryFaceOwnerLocalEdgeAtCorner
            P S oldX cell newX localEdge incidence member
              (0, 1) 1 h011.1 h011.2
        · by_cases h100 :
              newX = rxLocalCellXAt P S oldX cell (1, 0) ∧
                (Sum.inl localEdge : RX1 P S) =
                  rxLocalCellQAt P S oldX cell (1, 0) 0
          · exact rxLocalCellZBoundaryFaceOwnerLocalEdgeAtCorner
              P S oldX cell newX localEdge incidence member
                (1, 0) 0 h100.1 h100.2
          · by_cases h101 :
                newX = rxLocalCellXAt P S oldX cell (1, 0) ∧
                  (Sum.inl localEdge : RX1 P S) =
                    rxLocalCellQAt P S oldX cell (1, 0) 1
            · exact rxLocalCellZBoundaryFaceOwnerLocalEdgeAtCorner
                P S oldX cell newX localEdge incidence member
                  (1, 0) 1 h101.1 h101.2
            · by_cases h110 :
                  newX = rxLocalCellXAt P S oldX cell (1, 1) ∧
                    (Sum.inl localEdge : RX1 P S) =
                      rxLocalCellQAt P S oldX cell (1, 1) 0
              · exact rxLocalCellZBoundaryFaceOwnerLocalEdgeAtCorner
                  P S oldX cell newX localEdge incidence member
                    (1, 1) 0 h110.1 h110.2
              · have remaining001 := cases.resolve_left h000
                have remaining010 := remaining001.resolve_left h001
                have remaining011 := remaining010.resolve_left h010
                have remaining100 := remaining011.resolve_left h011
                have remaining101 := remaining100.resolve_left h100
                have remaining110 := remaining101.resolve_left h101
                have h111 := remaining110.resolve_left h110
                exact rxLocalCellZBoundaryFaceOwnerLocalEdgeAtCorner
                  P S oldX cell newX localEdge incidence member
                    (1, 1) 1 h111.1 h111.2

/-! ### Successor V4 Z-glue boundary-face owner rows -/

/-- The X endpoint of a successor X-Q edge is a boundary vertex of the
requested successor Z-star.  Face existence is eliminated only in this
proposition. -/
private theorem rxZBoundaryXQ_to_zBoundaryX
    (P : TannerSquarePresentation) (S : OddScale)
    (zCoordinate : RX2 P S) (newX : RX0 P S) (newQ : RX1 P S)
    (incidence : rxXQIncidence P S newX newQ = true)
    (member : zStarEdgeMember (rxReplacementPresentation P S) zCoordinate
      (Sum.inl
        (⟨(newX, newQ), incidence⟩ :
          XQEdge (rxReplacementPresentation P S))) = true) :
    zStarBoundaryVertexMember (rxReplacementPresentation P S) zCoordinate
      (Vertex.x newX) = true := by
  classical
  simp only [zStarEdgeMember, decide_eq_true_eq] at member
  obtain ⟨face, hz, huse⟩ := member
  change decide
        ((⟨(newX, newQ), incidence⟩ :
              XQEdge (rxReplacementPresentation P S)) =
            faceXQEdge (rxReplacementPresentation P S) face 0 ∨
          (⟨(newX, newQ), incidence⟩ :
              XQEdge (rxReplacementPresentation P S)) =
            faceXQEdge (rxReplacementPresentation P S) face 1) = true at huse
  rw [decide_eq_true_eq] at huse
  simp only [zStarBoundaryVertexMember]
  rw [decide_eq_true_eq]
  refine ⟨face, hz, ?_⟩
  rcases huse with hzero | hone
  · exact congrArg
      (fun selected : XQEdge (rxReplacementPresentation P S) =>
        selected.1.1) hzero
  · exact congrArg
      (fun selected : XQEdge (rxReplacementPresentation P S) =>
        selected.1.1) hone

/-- The Q endpoint of a successor X-Q edge is a boundary vertex of the
requested successor Z-star.  Face existence is eliminated only in this
proposition. -/
private theorem rxZBoundaryXQ_to_zBoundaryQ
    (P : TannerSquarePresentation) (S : OddScale)
    (zCoordinate : RX2 P S) (newX : RX0 P S) (newQ : RX1 P S)
    (incidence : rxXQIncidence P S newX newQ = true)
    (member : zStarEdgeMember (rxReplacementPresentation P S) zCoordinate
      (Sum.inl
        (⟨(newX, newQ), incidence⟩ :
          XQEdge (rxReplacementPresentation P S))) = true) :
    zStarBoundaryVertexMember (rxReplacementPresentation P S) zCoordinate
      (Vertex.q newQ) = true := by
  classical
  simp only [zStarEdgeMember, decide_eq_true_eq] at member
  obtain ⟨face, hz, huse⟩ := member
  change decide
        ((⟨(newX, newQ), incidence⟩ :
              XQEdge (rxReplacementPresentation P S)) =
            faceXQEdge (rxReplacementPresentation P S) face 0 ∨
          (⟨(newX, newQ), incidence⟩ :
              XQEdge (rxReplacementPresentation P S)) =
            faceXQEdge (rxReplacementPresentation P S) face 1) = true at huse
  rw [decide_eq_true_eq] at huse
  simp only [zStarBoundaryVertexMember, decide_eq_true_eq]
  change (exists face : RXFace P S,
    zStarFaceMember (rxReplacementPresentation P S) zCoordinate face = true ∧
      (newQ = rxFaceQ P S face 0 ∨ newQ = rxFaceQ P S face 1))
  refine ⟨face, hz, ?_⟩
  rcases huse with hzero | hone
  · exact Or.inl (congrArg
      (fun selected : XQEdge (rxReplacementPresentation P S) =>
        selected.1.2) hzero)
  · exact Or.inr (congrArg
      (fun selected : XQEdge (rxReplacementPresentation P S) =>
        selected.1.2) hone)

/-- Materialize the corner-zero glue owner for an embedded local edge at one
explicit endpoint of its stored Q-cylinder edge. -/
private noncomputable def rxQEdgeZBoundaryFaceOwnerLocalEdgeAtEndpoint
    (P : TannerSquarePresentation) (S : OddScale)
    (qEdge : Σ q : P.Q, QDoubleCylinderEdge P q S)
    (newX : RX0 P S) (localEdge : DoubleCylinderEdge P newX.1 S)
    (incidence : rxXQIncidence P S newX
      (Sum.inl ⟨newX.1, localEdge⟩) = true)
    (member : zStarEdgeMember (rxReplacementPresentation P S)
      (Sum.inl (Sum.inr qEdge))
      (Sum.inl
        (⟨(newX, Sum.inl ⟨newX.1, localEdge⟩), incidence⟩ :
          XQEdge (rxReplacementPresentation P S))) = true)
    (hxq : P.xq newX.1 qEdge.1 = true) (endpoint : Two)
    (hfaceX : glueFaceX P S
      ⟨(⟨(newX.1, qEdge.1), hxq⟩ : XQEdge P), qEdge.2, endpoint⟩ =
        newX)
    (hedge : localEdge = qToXDoubleCylinderEdgeRaw
      P qEdge.1 newX.1 hxq S qEdge.2) :
    {owner : ZStarFace (rxReplacementPresentation P S)
        (Sum.inl (Sum.inr qEdge)) × Two //
      zStarFaceXQEdge (rxReplacementPresentation P S)
          (Sum.inl (Sum.inr qEdge)) owner.1 owner.2 =
        ⟨Sum.inl
          (⟨(newX, Sum.inl ⟨newX.1, localEdge⟩), incidence⟩ :
            XQEdge (rxReplacementPresentation P S)), member⟩} := by
  let face := rxQEdgeGlueZStarFace P S qEdge newX.1 hxq endpoint
  have hfaceQ : rxFaceQ P S face.1 0 =
      Sum.inl ⟨newX.1, localEdge⟩ := by
    apply congrArg Sum.inl
    exact Sigma.ext rfl (by simpa only [heq_eq_eq] using hedge.symm)
  refine ⟨(face, 0), ?_⟩
  apply Subtype.ext
  apply congrArg Sum.inl
  apply Subtype.ext
  exact Prod.ext hfaceX hfaceQ

/-- Choice-free corner-zero `F_xqGlue_X` producer for a successor X-Q edge
whose Q endpoint is an embedded local edge. -/
private noncomputable def rxQEdgeZBoundaryFaceOwnerLocalEdge
    (P : TannerSquarePresentation) (S : OddScale)
    (qEdge : Σ q : P.Q, QDoubleCylinderEdge P q S)
    (newX : RX0 P S)
    (localEdge : Σ x : P.X, DoubleCylinderEdge P x S)
    (incidence : rxXQIncidence P S newX (Sum.inl localEdge) = true)
    (member : zStarEdgeMember (rxReplacementPresentation P S)
      (Sum.inl (Sum.inr qEdge))
      (Sum.inl
        (⟨(newX, Sum.inl localEdge), incidence⟩ :
          XQEdge (rxReplacementPresentation P S))) = true) :
    {owner : ZStarFace (rxReplacementPresentation P S)
        (Sum.inl (Sum.inr qEdge)) × Two //
      zStarFaceXQEdge (rxReplacementPresentation P S)
          (Sum.inl (Sum.inr qEdge)) owner.1 owner.2 =
        ⟨Sum.inl
          (⟨(newX, Sum.inl localEdge), incidence⟩ :
            XQEdge (rxReplacementPresentation P S)), member⟩} := by
  rcases localEdge with ⟨ownerX, localEdge⟩
  have endpointCases := rxLocalEdgeXCoordinate_endpoint_cases
    P S newX ownerX localEdge incidence
  have howner : newX.1 = ownerX := endpointCases.elim
    (fun h => congrArg Sigma.fst h)
    (fun h => congrArg Sigma.fst h)
  subst ownerX
  let xMember := rxZBoundaryXQ_to_zBoundaryX P S
    (Sum.inl (Sum.inr qEdge)) newX
      (Sum.inl ⟨newX.1, localEdge⟩) incidence member
  let qMember := rxZBoundaryXQ_to_zBoundaryQ P S
    (Sum.inl (Sum.inr qEdge)) newX
      (Sum.inl ⟨newX.1, localEdge⟩) incidence member
  let hxq := rxQEdgeBoundaryX_incidence P S qEdge newX xMember
  have hedge : localEdge = qToXDoubleCylinderEdgeRaw
      P qEdge.1 newX.1 hxq S qEdge.2 := by
    simpa using rxQEdgeBoundaryLocalQ_edge P S qEdge
      ⟨newX.1, localEdge⟩ qMember
  by_cases hzero : newX = glueFaceX P S
      ⟨(⟨(newX.1, qEdge.1), hxq⟩ : XQEdge P), qEdge.2, 0⟩
  · exact rxQEdgeZBoundaryFaceOwnerLocalEdgeAtEndpoint
      P S qEdge newX localEdge incidence member hxq 0 hzero.symm hedge
  · have hone := (rxQEdgeBoundaryX_endpoints
      P S qEdge newX xMember).resolve_left hzero
    exact rxQEdgeZBoundaryFaceOwnerLocalEdgeAtEndpoint
      P S qEdge newX localEdge incidence member hxq 1 hone.symm hedge

/-- Materialize the corner-one glue owner when the Q endpoint is one explicit
endpoint of the stored Q-cylinder edge. -/
private noncomputable def rxQEdgeZBoundaryFaceOwnerQVertexAtEndpoint
    (P : TannerSquarePresentation) (S : OddScale)
    (qEdge : Σ q : P.Q, QDoubleCylinderEdge P q S)
    (newX : RX0 P S) (endpoint : Two)
    (incidence : rxXQIncidence P S newX
      (Sum.inr ⟨qEdge.1, edgeEndpoint
        (qDoubleCylinderEdgeStart P qEdge.1 S)
        (qDoubleCylinderEdgeEnd P qEdge.1 S) qEdge.2 endpoint⟩) = true)
    (member : zStarEdgeMember (rxReplacementPresentation P S)
      (Sum.inl (Sum.inr qEdge))
      (Sum.inl
        (⟨(newX, Sum.inr ⟨qEdge.1, edgeEndpoint
              (qDoubleCylinderEdgeStart P qEdge.1 S)
              (qDoubleCylinderEdgeEnd P qEdge.1 S) qEdge.2 endpoint⟩),
            incidence⟩ : XQEdge (rxReplacementPresentation P S))) = true) :
    {owner : ZStarFace (rxReplacementPresentation P S)
        (Sum.inl (Sum.inr qEdge)) × Two //
      zStarFaceXQEdge (rxReplacementPresentation P S)
          (Sum.inl (Sum.inr qEdge)) owner.1 owner.2 =
        ⟨Sum.inl
          (⟨(newX, Sum.inr ⟨qEdge.1, edgeEndpoint
                (qDoubleCylinderEdgeStart P qEdge.1 S)
                (qDoubleCylinderEdgeEnd P qEdge.1 S) qEdge.2 endpoint⟩),
              incidence⟩ : XQEdge (rxReplacementPresentation P S)), member⟩} := by
  let vertex := edgeEndpoint
    (qDoubleCylinderEdgeStart P qEdge.1 S)
    (qDoubleCylinderEdgeEnd P qEdge.1 S) qEdge.2 endpoint
  let hxq := rxQVertexXRadial_oldXQ
    P S newX qEdge.1 vertex incidence
  let face := rxQEdgeGlueZStarFace P S qEdge newX.1 hxq endpoint
  have hfaceX : rxFaceX P S face.1 = newX := by
    exact rxQVertexGlueFaceX_eq P S newX qEdge.1 vertex incidence hxq
      qEdge.2 endpoint rfl
  have hfaceQ : rxFaceQ P S face.1 1 =
      Sum.inr ⟨qEdge.1, vertex⟩ := rfl
  refine ⟨(face, 1), ?_⟩
  apply Subtype.ext
  apply congrArg Sum.inl
  apply Subtype.ext
  exact Prod.ext hfaceX hfaceQ

/-- Choice-free corner-one `F_xqGlue_X` producer for a successor X-Q edge
whose Q endpoint is a Q-cylinder vertex. -/
private noncomputable def rxQEdgeZBoundaryFaceOwnerQVertex
    (P : TannerSquarePresentation) (S : OddScale)
    (qEdge : Σ q : P.Q, QDoubleCylinderEdge P q S)
    (newX : RX0 P S)
    (qVertex : Σ q : P.Q, QDoubleCylinderVertex P q S)
    (incidence : rxXQIncidence P S newX (Sum.inr qVertex) = true)
    (member : zStarEdgeMember (rxReplacementPresentation P S)
      (Sum.inl (Sum.inr qEdge))
      (Sum.inl
        (⟨(newX, Sum.inr qVertex), incidence⟩ :
          XQEdge (rxReplacementPresentation P S))) = true) :
    {owner : ZStarFace (rxReplacementPresentation P S)
        (Sum.inl (Sum.inr qEdge)) × Two //
      zStarFaceXQEdge (rxReplacementPresentation P S)
          (Sum.inl (Sum.inr qEdge)) owner.1 owner.2 =
        ⟨Sum.inl
          (⟨(newX, Sum.inr qVertex), incidence⟩ :
            XQEdge (rxReplacementPresentation P S)), member⟩} := by
  let qMember := rxZBoundaryXQ_to_zBoundaryQ P S
    (Sum.inl (Sum.inr qEdge)) newX (Sum.inr qVertex) incidence member
  by_cases hstart : qVertex = ⟨qEdge.1,
      qDoubleCylinderEdgeStart P qEdge.1 S qEdge.2⟩
  · cases hstart
    exact rxQEdgeZBoundaryFaceOwnerQVertexAtEndpoint
      P S qEdge newX 0 incidence member
  · have hend := (rxQEdgeBoundaryQVertex_endpoints
      P S qEdge qVertex qMember).resolve_left hstart
    cases hend
    exact rxQEdgeZBoundaryFaceOwnerQVertexAtEndpoint
      P S qEdge newX 1 incidence member

/-! ### Successor V4 retained old-Z Z-boundary owner row -/

/-- A successor X-Q boundary edge in a retained old-Z star projects to the
old X-Q incidence carried by its deterministic X and Q labels.  Face
existence is eliminated only in this proposition. -/
private theorem rxOldZBoundaryXQ_oldIncidence
    (P : TannerSquarePresentation) (S : OddScale)
    (oldZ : P.Z) (copy : Two) (newX : RX0 P S)
    (qVertex : Σ q : P.Q, QDoubleCylinderVertex P q S)
    (incidence : rxXQIncidence P S newX (Sum.inr qVertex) = true)
    (member : zStarEdgeMember (rxReplacementPresentation P S)
      (Sum.inr (oldZ, copy))
      (Sum.inl
        (⟨(newX, Sum.inr qVertex), incidence⟩ :
          XQEdge (rxReplacementPresentation P S))) = true) :
    P.xq newX.1 qVertex.1 = true := by
  classical
  let edge : XQEdge (rxReplacementPresentation P S) :=
    ⟨(newX, Sum.inr qVertex), incidence⟩
  simp only [zStarEdgeMember, decide_eq_true_eq] at member
  obtain ⟨face, hz, huse⟩ := member
  change decide (edge = faceXQEdge (rxReplacementPresentation P S) face 0 ∨
    edge = faceXQEdge (rxReplacementPresentation P S) face 1) = true at huse
  rw [decide_eq_true_eq] at huse
  have route : ∀ corner : Two,
      edge = faceXQEdge (rxReplacementPresentation P S) face corner →
        P.xq newX.1 qVertex.1 = true := by
    intro corner hedge
    have hraw := congrArg Subtype.val hedge
    have hx := congrArg Prod.fst hraw
    have hq := congrArg Prod.snd hraw
    rcases face with localFace | glue | oldFace
    · simp only [zStarFaceMember, decide_eq_true_eq] at hz
      cases hz
    · simp only [zStarFaceMember, decide_eq_true_eq] at hz
      cases hz
    · rcases oldFace with ⟨oldFace, storedCopy⟩
      have hfaceX : P.faceX oldFace = newX.1 :=
        (congrArg Sigma.fst hx).symm
      have hfaceQ : P.faceQ oldFace corner = qVertex.1 :=
        (congrArg Sigma.fst (Sum.inr.inj hq)).symm
      simpa [hfaceX, hfaceQ] using P.data.faceQ_xq oldFace corner
  exact huse.elim (route 0) (route 1)

/-- The deterministic old X-Q projection of a retained-old-Z successor
boundary edge is itself an old Z-star boundary edge. -/
private theorem rxOldZBoundaryXQ_oldMember
    (P : TannerSquarePresentation) (S : OddScale)
    (oldZ : P.Z) (copy : Two) (newX : RX0 P S)
    (qVertex : Σ q : P.Q, QDoubleCylinderVertex P q S)
    (incidence : rxXQIncidence P S newX (Sum.inr qVertex) = true)
    (member : zStarEdgeMember (rxReplacementPresentation P S)
      (Sum.inr (oldZ, copy))
      (Sum.inl
        (⟨(newX, Sum.inr qVertex), incidence⟩ :
          XQEdge (rxReplacementPresentation P S))) = true)
    (oldIncidence : P.xq newX.1 qVertex.1 = true) :
    zStarEdgeMember P oldZ
      (Sum.inl (⟨(newX.1, qVertex.1), oldIncidence⟩ : XQEdge P)) = true := by
  classical
  let successorEdge : XQEdge (rxReplacementPresentation P S) :=
    ⟨(newX, Sum.inr qVertex), incidence⟩
  let oldEdge : XQEdge P := ⟨(newX.1, qVertex.1), oldIncidence⟩
  simp only [zStarEdgeMember, decide_eq_true_eq] at member
  obtain ⟨face, hz, huse⟩ := member
  change decide (successorEdge = faceXQEdge (rxReplacementPresentation P S) face 0 ∨
    successorEdge = faceXQEdge (rxReplacementPresentation P S) face 1) = true at huse
  rw [decide_eq_true_eq] at huse
  simp only [zStarEdgeMember, decide_eq_true_eq]
  have route : ∀ corner : Two,
      successorEdge =
          faceXQEdge (rxReplacementPresentation P S) face corner →
      ∃ oldFace : P.Face,
        zStarFaceMember P oldZ oldFace = true ∧
          decide (oldEdge = faceXQEdge P oldFace 0 ∨
            oldEdge = faceXQEdge P oldFace 1) = true := by
    intro corner hedge
    have hraw := congrArg Subtype.val hedge
    have hx := congrArg Prod.fst hraw
    have hq := congrArg Prod.snd hraw
    rcases face with localFace | glue | oldFace
    · simp only [zStarFaceMember, decide_eq_true_eq] at hz
      cases hz
    · simp only [zStarFaceMember, decide_eq_true_eq] at hz
      cases hz
    · rcases oldFace with ⟨oldFace, storedCopy⟩
      simp only [zStarFaceMember, decide_eq_true_eq] at hz
      have hzpair : (P.faceZ oldFace, storedCopy) = (oldZ, copy) :=
        Sum.inr.inj hz
      have hfaceZ : P.faceZ oldFace = oldZ := congrArg Prod.fst hzpair
      have hfaceX : P.faceX oldFace = newX.1 :=
        (congrArg Sigma.fst hx).symm
      have hfaceQ : P.faceQ oldFace corner = qVertex.1 :=
        (congrArg Sigma.fst (Sum.inr.inj hq)).symm
      refine ⟨oldFace, by simpa [zStarFaceMember] using hfaceZ, ?_⟩
      rw [decide_eq_true_eq]
      apply rxTwoElim (motive := fun corner =>
        P.faceX oldFace = newX.1 →
        P.faceQ oldFace corner = qVertex.1 →
          oldEdge = faceXQEdge P oldFace 0 ∨
            oldEdge = faceXQEdge P oldFace 1)
      · intro hx0 hq0
        left
        apply Subtype.ext
        exact Prod.ext hx0.symm hq0.symm
      · intro hx1 hq1
        right
        apply Subtype.ext
        exact Prod.ext hx1.symm hq1.symm
      · exact hfaceX
      · exact hfaceQ
  obtain ⟨oldFace, hmember, hedge⟩ := huse.elim (route 0) (route 1)
  exact ⟨oldFace, hmember, hedge⟩

/-- Project a retained-old-Z successor boundary edge to the old Z-star edge
fixed by its constructor labels.  All face reasoning remains in membership
proofs. -/
private noncomputable def rxOldZBoundaryEdgeProject
    (P : TannerSquarePresentation) (S : OddScale)
    (oldZ : P.Z) (copy : Two) :
    ZStarBoundaryEdge (rxReplacementPresentation P S)
        (Sum.inr (oldZ, copy)) → ZStarBoundaryEdge P oldZ :=
  fun successorEdge => by
    rcases successorEdge with ⟨raw, member⟩
    rcases raw with newXQ | impossible
    · rcases newXQ with ⟨⟨newX, newQ⟩, incidence⟩
      let successorEdge : ZStarBoundaryEdge
          (rxReplacementPresentation P S) (Sum.inr (oldZ, copy)) :=
        ⟨Sum.inl (⟨(newX, newQ), incidence⟩ :
          XQEdge (rxReplacementPresentation P S)), member⟩
      let qMember := (zBoundaryEdgeEnd (rxReplacementPresentation P S)
        (Sum.inr (oldZ, copy)) successorEdge).2
      have terminal := rxOldZBoundaryQ_terminal
        P S oldZ copy newQ qMember
      rcases newQ with localEdge | qVertex
      · exact terminal.elim
      · rcases qVertex with ⟨q, newCopy, vertex⟩
        rcases vertex with original | interior
        · rcases original with center | endpoint
          · exact terminal.elim
          · let qVertex : Σ q : P.Q, QDoubleCylinderVertex P q S :=
              ⟨q, (newCopy, Sum.inl (Sum.inr endpoint))⟩
            let oldIncidence := rxOldZBoundaryXQ_oldIncidence
              P S oldZ copy newX qVertex incidence member
            exact ⟨Sum.inl
              (⟨(newX.1, q), oldIncidence⟩ : XQEdge P),
              rxOldZBoundaryXQ_oldMember
                P S oldZ copy newX qVertex incidence member oldIncidence⟩
        · exact terminal.elim
    · simp [zStarBoundaryEdgeMember] at member

/-- Projecting and then re-embedding a retained-old-Z successor boundary edge
is the identity. -/
private theorem rxOldZBoundaryEdgeMap_project
    (P : TannerSquarePresentation) (S : OddScale)
    (oldZ : P.Z) (copy : Two)
    (edge : ZStarBoundaryEdge (rxReplacementPresentation P S)
      (Sum.inr (oldZ, copy))) :
    rxOldZBoundaryEdgeMap P S oldZ copy
        (rxOldZBoundaryEdgeProject P S oldZ copy edge) = edge := by
  have hstart := rxOldZBoundaryVertexMap_project P S oldZ copy
    (zBoundaryEdgeStart (rxReplacementPresentation P S)
      (Sum.inr (oldZ, copy)) edge)
  have hend := rxOldZBoundaryVertexMap_project P S oldZ copy
    (zBoundaryEdgeEnd (rxReplacementPresentation P S)
      (Sum.inr (oldZ, copy)) edge)
  rcases edge with ⟨raw, member⟩
  rcases raw with newXQ | impossible
  · rcases newXQ with ⟨⟨newX, newQ⟩, incidence⟩
    let successorEdge : ZStarBoundaryEdge
        (rxReplacementPresentation P S) (Sum.inr (oldZ, copy)) :=
      ⟨Sum.inl (⟨(newX, newQ), incidence⟩ :
        XQEdge (rxReplacementPresentation P S)), member⟩
    let qMember := (zBoundaryEdgeEnd (rxReplacementPresentation P S)
      (Sum.inr (oldZ, copy)) successorEdge).2
    have terminal := rxOldZBoundaryQ_terminal P S oldZ copy newQ qMember
    rcases newQ with localEdge | qVertex
    · exact terminal.elim
    · rcases qVertex with ⟨q, newCopy, vertex⟩
      rcases vertex with original | interior
      · rcases original with center | endpoint
        · exact terminal.elim
        · apply Subtype.ext
          apply congrArg Sum.inl
          apply Subtype.ext
          exact Prod.ext
            (Vertex.x.inj (congrArg Subtype.val hstart))
            (Vertex.q.inj (congrArg Subtype.val hend))
      · exact terminal.elim
  · simp [zStarBoundaryEdgeMember] at member

/-- `F_oldZ_X` producer for a retained-old-Z successor boundary edge.  The
input V4 owner supplies the old face and ordered corner; the deterministic
edge projection and re-embedding recover the requested successor edge. -/
private noncomputable def rxOldZZBoundaryFaceOwnerTerminal
    (P : TannerSquarePresentation) (A4 : TannerSquareAdmissibleV4 P)
    (S : OddScale) (oldZ : P.Z) (copy : Two)
    (newX : RX0 P S) (newCopy : Two) (q : P.Q)
    (endpoint : QStarEdge P q)
    (incidence : rxXQIncidence P S newX
      (Sum.inr ⟨q, (newCopy, Sum.inl (Sum.inr endpoint))⟩) = true)
    (member : zStarEdgeMember (rxReplacementPresentation P S)
      (Sum.inr (oldZ, copy))
      (Sum.inl
        (⟨(newX,
            Sum.inr ⟨q, (newCopy, Sum.inl (Sum.inr endpoint))⟩),
          incidence⟩ : XQEdge (rxReplacementPresentation P S))) = true) :
    {owner : ZStarFace (rxReplacementPresentation P S)
        (Sum.inr (oldZ, copy)) × Two //
      zStarFaceXQEdge (rxReplacementPresentation P S)
          (Sum.inr (oldZ, copy)) owner.1 owner.2 =
        ⟨Sum.inl
          (⟨(newX,
              Sum.inr ⟨q, (newCopy, Sum.inl (Sum.inr endpoint))⟩),
            incidence⟩ : XQEdge (rxReplacementPresentation P S)), member⟩} := by
  let newQ : RX1 P S :=
    Sum.inr ⟨q, (newCopy, Sum.inl (Sum.inr endpoint))⟩
  let successorEdge : ZStarBoundaryEdge
      (rxReplacementPresentation P S) (Sum.inr (oldZ, copy)) :=
    ⟨Sum.inl (⟨(newX, newQ), incidence⟩ :
      XQEdge (rxReplacementPresentation P S)), member⟩
  let oldBoundary := rxOldZBoundaryEdgeProject
    P S oldZ copy successorEdge
  have hmapped : rxOldZBoundaryEdgeMap P S oldZ copy oldBoundary =
      successorEdge := rxOldZBoundaryEdgeMap_project
        P S oldZ copy successorEdge
  rcases oldBoundary with ⟨rawOld, oldMember⟩
  rcases rawOld with oldXQ | impossible
  · let selected := A4.zBoundaryFaceOwner oldZ oldXQ oldMember
    have hfaceZ : P.faceZ selected.1.1.1 = oldZ := by
      simpa [zStarFaceMember] using selected.1.1.2
    let face : ZStarFace (rxReplacementPresentation P S)
        (Sum.inr (oldZ, copy)) :=
      ⟨Sum.inr (Sum.inr (selected.1.1.1, copy)), by
        simp only [zStarFaceMember, decide_eq_true_eq]
        change rxFaceZ P S
          (Sum.inr (Sum.inr (selected.1.1.1, copy))) =
            Sum.inr (oldZ, copy)
        simp [rxFaceZ, oldZFaceZ, hfaceZ]⟩
    let selectedBoundary : ZStarBoundaryEdge P oldZ :=
      ⟨Sum.inl (faceXQEdge P selected.1.1.1 selected.1.2), by
        change decide (exists oldFace : P.Face,
          zStarFaceMember P oldZ oldFace = true ∧
            decide
              (faceXQEdge P selected.1.1.1 selected.1.2 =
                  faceXQEdge P oldFace 0 ∨
                faceXQEdge P selected.1.1.1 selected.1.2 =
                  faceXQEdge P oldFace 1) = true) = true
        rw [decide_eq_true_eq]
        refine ⟨selected.1.1.1, selected.1.1.2, ?_⟩
        rw [decide_eq_true_eq]
        exact rxTwoElim (motive := fun corner =>
          faceXQEdge P selected.1.1.1 corner =
              faceXQEdge P selected.1.1.1 0 ∨
            faceXQEdge P selected.1.1.1 corner =
              faceXQEdge P selected.1.1.1 1)
          (Or.inl rfl) (Or.inr rfl) selected.1.2⟩
    have hselectedBoundary : selectedBoundary =
        (⟨Sum.inl oldXQ, oldMember⟩ : ZStarBoundaryEdge P oldZ) := by
      apply Subtype.ext
      simpa [selectedBoundary, zStarFaceXQEdge] using
        congrArg Subtype.val selected.2
    have hlift := congrArg
      (rxOldZBoundaryEdgeMap P S oldZ copy) hselectedBoundary
    have hlifted : rxOldZBoundaryEdgeMap P S oldZ copy selectedBoundary =
        successorEdge := hlift.trans hmapped
    have hstartLifted := congrArg
      (zBoundaryEdgeStart (rxReplacementPresentation P S)
        (Sum.inr (oldZ, copy))) hlifted
    have hendLifted := congrArg
      (zBoundaryEdgeEnd (rxReplacementPresentation P S)
        (Sum.inr (oldZ, copy))) hlifted
    have hstart : rxOldZBoundaryVertexMap P S oldZ copy
          (zBoundaryEdgeStart P oldZ selectedBoundary) =
        zBoundaryEdgeStart (rxReplacementPresentation P S)
          (Sum.inr (oldZ, copy)) successorEdge :=
      (rxOldZBoundaryEdgeMap_start P S oldZ copy selectedBoundary).symm.trans
        hstartLifted
    have hend : rxOldZBoundaryVertexMap P S oldZ copy
          (zBoundaryEdgeEnd P oldZ selectedBoundary) =
        zBoundaryEdgeEnd (rxReplacementPresentation P S)
          (Sum.inr (oldZ, copy)) successorEdge :=
      (rxOldZBoundaryEdgeMap_end P S oldZ copy selectedBoundary).symm.trans
        hendLifted
    refine ⟨(face, selected.1.2), ?_⟩
    apply Subtype.ext
    apply congrArg Sum.inl
    apply Subtype.ext
    exact Prod.ext
      (by
        change rxFaceX P S face.1 = newX
        have hstartX := Vertex.x.inj (congrArg Subtype.val hstart)
        simp [faceXQEdge, face, selectedBoundary, rxFaceX, oldZFaceX,
          xStarFaceZVertex, oldFaceInXStar, hfaceZ,
          zBoundaryEdgeStart, rxOldZBoundaryVertexMap,
          rxOldZCopyXCoordinate, successorEdge, newQ] at hstartX ⊢
        exact hstartX)
      (by
        change rxFaceQ P S face.1 selected.1.2 = newQ
        simpa [faceXQEdge, face, selectedBoundary, rxFaceQ, oldZFaceQ,
          hfaceZ, Sigma.ext_iff,
          zBoundaryEdgeEnd, rxOldZBoundaryVertexMap,
          rxOldZCopyQCoordinate, successorEdge, newQ] using
        Sum.inr.inj (Vertex.q.inj (congrArg Subtype.val hend)))
  · simp [zStarBoundaryEdgeMember] at oldMember

/-- Only an embedded local edge can be a Q boundary vertex of a local-cell
successor Z-star.  This proposition eliminates the unreachable Q-vertex
constructor in the total decoder. -/
private theorem rxLocalCellBoundaryQ_localTag
    (P : TannerSquarePresentation) (S : OddScale) (oldX : P.X)
    (cell : DoubleCylinderFace P oldX S) (newQ : RX1 P S)
    (member : zStarBoundaryVertexMember (rxReplacementPresentation P S)
      (Sum.inl (Sum.inl ⟨oldX, cell⟩)) (Vertex.q newQ) = true) :
    match newQ with
    | Sum.inl _ => True
    | Sum.inr _ => False := by
  have cases := rxLocalCellBoundaryQ_cases P S oldX cell newQ member
  rcases cases with h | h | h | h | h | h | h | h <;>
    cases h <;> trivial

/-- Total successor Z-boundary face owner, covering the local-cell row, both
X-Q glue rows, and the retained old-Z row. -/
noncomputable def rxReplacementZBoundaryFaceOwner
    (P : TannerSquarePresentation) (A4 : TannerSquareAdmissibleV4 P)
    (S : OddScale) (zCoordinate : (rxReplacementPresentation P S).Z)
    (edge : XQEdge (rxReplacementPresentation P S))
    (member : zStarEdgeMember (rxReplacementPresentation P S) zCoordinate
      (Sum.inl edge) = true) :
    {owner : ZStarFace (rxReplacementPresentation P S) zCoordinate × Two //
      zStarFaceXQEdge (rxReplacementPresentation P S) zCoordinate
          owner.1 owner.2 = ⟨Sum.inl edge, member⟩} := by
  rcases edge with ⟨⟨newX, newQ⟩, incidence⟩
  rcases zCoordinate with nonOldZ | oldZCopy
  · rcases nonOldZ with localCell | qEdge
    · rcases localCell with ⟨oldX, cell⟩
      rcases newQ with localEdge | qVertex
      · exact rxLocalCellZBoundaryFaceOwnerLocalEdge
          P S oldX cell newX localEdge incidence member
      · have qMember := rxZBoundaryXQ_to_zBoundaryQ P S
          (Sum.inl (Sum.inl ⟨oldX, cell⟩)) newX
            (Sum.inr qVertex) incidence member
        exact (rxLocalCellBoundaryQ_localTag
          P S oldX cell (Sum.inr qVertex) qMember).elim
    · rcases newQ with localEdge | qVertex
      · exact rxQEdgeZBoundaryFaceOwnerLocalEdge
          P S qEdge newX localEdge incidence member
      · exact rxQEdgeZBoundaryFaceOwnerQVertex
          P S qEdge newX qVertex incidence member
  · rcases oldZCopy with ⟨oldZ, copy⟩
    let qMember := rxZBoundaryXQ_to_zBoundaryQ P S
      (Sum.inr (oldZ, copy)) newX newQ incidence member
    have terminal := rxOldZBoundaryQ_terminal
      P S oldZ copy newQ qMember
    rcases newQ with localEdge | qVertex
    · exact terminal.elim
    · rcases qVertex with ⟨q, newCopy, vertex⟩
      rcases vertex with original | interior
      · rcases original with center | endpoint
        · exact terminal.elim
        · exact rxOldZZBoundaryFaceOwnerTerminal
            P A4 S oldZ copy newX newCopy q endpoint incidence member
      · exact terminal.elim

/-! ### Successor V3 admissibility package -/

/-- The radial-owner admissibility package for the RX successor.  Historical
and endpoint-tagged data are inherited from the V2 package; the two new
fields are the total structural X and Z radial-owner selectors above.
Boundary-face ownership remains a separate V4 contract. -/
noncomputable def rxReplacementAdmissibleV3
    (P : TannerSquarePresentation) (A4 : TannerSquareAdmissibleV4 P)
    (R : TannerSquareCellularRegular P) (S : OddScale) :
    TannerSquareAdmissibleV3 (rxReplacementPresentation P S) where
  toTannerSquareAdmissibleV2 := rxReplacementAdmissibleV2 P A4 R S
  xRadialFaceOwner :=
    rxReplacementXRadialFaceOwner P A4.toTannerSquareAdmissibleV3 S
  zRadialFaceOwner := rxReplacementZRadialFaceOwner P A4 S

/-! ### Successor V4 admissibility package -/

/-- The boundary-face-owner admissibility package for the RX successor.
Historical, endpoint-tagged, and radial-owner data are inherited from the V3
package; the two new fields are the total structural X and Z boundary-face
owner selectors above. -/
noncomputable def rxReplacementAdmissibleV4
    (P : TannerSquarePresentation) (A4 : TannerSquareAdmissibleV4 P)
    (R : TannerSquareCellularRegular P) (S : OddScale) :
    TannerSquareAdmissibleV4 (rxReplacementPresentation P S) where
  toTannerSquareAdmissibleV3 := rxReplacementAdmissibleV3 P A4 R S
  xBoundaryFaceOwner := rxReplacementXBoundaryFaceOwner P A4 S
  zBoundaryFaceOwner := rxReplacementZBoundaryFaceOwner P A4 S

/-! ## Successor cellular regularity

The three proofs below follow the constructor split fixed by #917.  The local
and X-Q glue families are injective from their concrete successor tags alone.
Only the retained old-Z copy family consumes cellular regularity of the input
presentation.
-/

/-- `F_local_X`: a local successor face is determined by its successor X/Z
pair.  The Z coordinate fixes the local two-cell, and the X coordinate then
fixes its material corner. -/
theorem rxLocalFaceXZ_injective
    (P : TannerSquarePresentation) (S : OddScale) :
    Function.Injective (fun face : RXLocalFace P S =>
      (localFaceX P S face, localFaceZ P S face)) := by
  rintro ⟨firstX, firstCell, firstCorner⟩
    ⟨secondX, secondCell, secondCorner⟩ hpair
  have hx := congrArg Prod.fst hpair
  have hz := congrArg Prod.snd hpair
  change (Sum.inl (Sum.inl (⟨firstX, firstCell⟩ :
      Σ x : P.X, DoubleCylinderFace P x S)) : RX2 P S) =
    Sum.inl (Sum.inl (⟨secondX, secondCell⟩ :
      Σ x : P.X, DoubleCylinderFace P x S)) at hz
  have hcell : (⟨firstX, firstCell⟩ :
      Σ x : P.X, DoubleCylinderFace P x S) =
    ⟨secondX, secondCell⟩ := Sum.inl.inj (Sum.inl.inj hz)
  cases hcell
  have hcorner : firstCorner = secondCorner :=
    localFaceX_fixedCell_injective P firstX S firstCell hx
  cases hcorner
  rfl

/-- `F_xqGlue_X`: an X-Q glue successor face is determined by its successor
X/Z pair.  The Z coordinate fixes the Q-cylinder edge, while the X coordinate
fixes the old X owner and the selected endpoint. -/
theorem rxGlueFaceXZ_injective
    (P : TannerSquarePresentation) (S : OddScale) :
    Function.Injective (fun face : RXXQGlueFace P S =>
      (glueFaceX P S face, glueFaceZ P S face)) := by
  rintro ⟨firstA, firstEdge, firstEndpoint⟩
    ⟨secondA, secondEdge, secondEndpoint⟩ hpair
  have hx := congrArg Prod.fst hpair
  have hz := congrArg Prod.snd hpair
  change (Sum.inl (Sum.inr (⟨firstA.1.2, firstEdge⟩ :
      Σ q : P.Q, QDoubleCylinderEdge P q S)) : RX2 P S) =
    Sum.inl (Sum.inr (⟨secondA.1.2, secondEdge⟩ :
      Σ q : P.Q, QDoubleCylinderEdge P q S)) at hz
  have hqedge : (⟨firstA.1.2, firstEdge⟩ :
      Σ q : P.Q, QDoubleCylinderEdge P q S) =
    ⟨secondA.1.2, secondEdge⟩ := Sum.inr.inj (Sum.inl.inj hz)
  have hqbase : firstA.1.2 = secondA.1.2 := congrArg Sigma.fst hqedge
  have hxbase : firstA.1.1 = secondA.1.1 := congrArg Sigma.fst hx
  have ha : firstA = secondA := by
    apply Subtype.ext
    exact Prod.ext hxbase hqbase
  subst secondA
  have hedge : firstEdge = secondEdge :=
    eq_of_heq (Sigma.mk.inj_iff.mp hqedge).2
  subst secondEdge
  change (⟨firstA.1.1,
      edgeEndpoint (tannerDoubleCylinderEdgeStart P firstA.1.1 S)
        (tannerDoubleCylinderEdgeEnd P firstA.1.1 S)
        (qToXDoubleCylinderEdgeRaw P firstA.1.2 firstA.1.1 firstA.2 S
          firstEdge) firstEndpoint⟩ : RX0 P S) =
    ⟨firstA.1.1,
      edgeEndpoint (tannerDoubleCylinderEdgeStart P firstA.1.1 S)
        (tannerDoubleCylinderEdgeEnd P firstA.1.1 S)
        (qToXDoubleCylinderEdgeRaw P firstA.1.2 firstA.1.1 firstA.2 S
          firstEdge) secondEndpoint⟩ at hx
  injection hx with _ hvertex
  have hendpoint : firstEndpoint = secondEndpoint := by
    apply twoSelect_injective
      (tannerDoubleCylinderEdgeStart_ne_end P firstA.1.1 S
        (qToXDoubleCylinderEdgeRaw P firstA.1.2 firstA.1.1 firstA.2 S
          firstEdge))
    exact hvertex
  subst secondEndpoint
  rfl

/-- `F_oldZ_X`: a retained old-Z copy face is determined by its successor X/Z
pair, using input cellular regularity exactly for the old face identity. -/
theorem rxOldZFaceXZ_injective
    (P : TannerSquarePresentation) (R : TannerSquareCellularRegular P)
    (S : OddScale) :
    Function.Injective (fun face : RXOldZFace P =>
      (oldZFaceX P S face, oldZFaceZ P S face)) := by
  rintro ⟨firstFace, firstCopy⟩ ⟨secondFace, secondCopy⟩ hpair
  have hx := congrArg Prod.fst hpair
  have hz := congrArg Prod.snd hpair
  change Sum.inr (P.faceZ firstFace, firstCopy) =
    Sum.inr (P.faceZ secondFace, secondCopy) at hz
  have hzpair : (P.faceZ firstFace, firstCopy) =
      (P.faceZ secondFace, secondCopy) := Sum.inr.inj hz
  have hcopy : firstCopy = secondCopy := congrArg Prod.snd hzpair
  have hxold : P.faceX firstFace = P.faceX secondFace :=
    congrArg Sigma.fst hx
  have hzold : P.faceZ firstFace = P.faceZ secondFace :=
    congrArg Prod.fst hzpair
  have hface : firstFace = secondFace :=
    R.faceXZ_injective (Prod.ext hxold hzold)
  subst secondFace
  subst secondCopy
  rfl

/-- All RX successor faces are determined by their successor X/Z pair.  The
outer Z-coordinate tags make the three face families disjoint. -/
theorem rxFaceXZ_injective
    (P : TannerSquarePresentation) (R : TannerSquareCellularRegular P)
    (S : OddScale) :
    Function.Injective (fun face : RXFace P S =>
      (rxFaceX P S face, rxFaceZ P S face)) := by
  intro first second hpair
  rcases first with firstLocal | firstGlue | firstOld <;>
    rcases second with secondLocal | secondGlue | secondOld
  · exact congrArg Sum.inl
      (rxLocalFaceXZ_injective P S (by
        simpa [rxFaceX, rxFaceZ] using hpair))
  · have hz := congrArg Prod.snd hpair
    simp [rxFaceZ, localFaceZ, glueFaceZ] at hz
  · have hz := congrArg Prod.snd hpair
    simp [rxFaceZ, localFaceZ, oldZFaceZ] at hz
  · have hz := congrArg Prod.snd hpair
    simp [rxFaceZ, glueFaceZ, localFaceZ] at hz
  · exact congrArg (fun face => Sum.inr (Sum.inl face))
      (rxGlueFaceXZ_injective P S (by
        simpa [rxFaceX, rxFaceZ] using hpair))
  · have hz := congrArg Prod.snd hpair
    simp [rxFaceZ, glueFaceZ, oldZFaceZ] at hz
  · have hz := congrArg Prod.snd hpair
    simp [rxFaceZ, oldZFaceZ, localFaceZ] at hz
  · have hz := congrArg Prod.snd hpair
    simp [rxFaceZ, oldZFaceZ, glueFaceZ] at hz
  · exact congrArg (fun face => Sum.inr (Sum.inr face))
      (rxOldZFaceXZ_injective P R S (by
        simpa [rxFaceX, rxFaceZ] using hpair))

/-- Concrete RX replacement preserves the one-field cellular-regularity
domain frozen by #917/#921. -/
noncomputable def rxReplacementCellularRegular
    (P : TannerSquarePresentation) (R : TannerSquareCellularRegular P)
    (S : OddScale) :
    TannerSquareCellularRegular (rxReplacementPresentation P S) where
  faceXZ_injective := rxFaceXZ_injective P R S

@[simp] theorem subdivisionEdgeVertexMatrix_start_eq_one
    (P : TannerSquarePresentation) (x : P.X) (S : OddScale)
    (edge : SubdivisionEdge P x S) :
    subdivisionEdgeVertexMatrix P x S
        (subdivisionEdgeStart P x S edge) edge = 1 := by
  classical
  simp [subdivisionEdgeVertexMatrix, subdivisionEdgeStart_ne_end P x S edge]

@[simp] theorem subdivisionEdgeVertexMatrix_end_eq_one
    (P : TannerSquarePresentation) (x : P.X) (S : OddScale)
    (edge : SubdivisionEdge P x S) :
    subdivisionEdgeVertexMatrix P x S
        (subdivisionEdgeEnd P x S edge) edge = 1 := by
  classical
  simp [subdivisionEdgeVertexMatrix,
    Ne.symm (subdivisionEdgeStart_ne_end P x S edge)]

set_option maxHeartbeats 800000 in
private theorem rxBoundaryMatrices_mul_xFace
    (P : TannerSquarePresentation) (S : OddScale)
    (xCoordinate : RX0 P S)
    (xFace : Σ x : P.X, DoubleCylinderFace P x S) :
    rxBoundaryProductMatrix P S xCoordinate
        (Sum.inl (Sum.inl xFace)) = 0 := by
  classical
  rcases xCoordinate with ⟨x, vertex⟩
  rcases xFace with ⟨x', face⟩
  by_cases hxx : x = x'
  · subst x'
    rw [rxBoundaryProductMatrix]
    simp only [Fintype.sum_sum_type]
    rw [Fintype.sum_sigma]
    rw [Finset.sum_eq_single x]
    · simp only [rxBoundary1Matrix, rxBoundary2Matrix, dite_true, mul_zero,
        Finset.sum_const_zero, add_zero]
      change (∑ edge : DoubleCylinderEdge P x S,
        doubleCylinderEdgeVertexMatrix P x S vertex edge *
          doubleCylinderFaceEdgeMatrix P x S edge face) = 0
      rw [← Matrix.mul_apply]
      rw [doubleCylinderEdgeVertexMatrix_mul_faceEdgeMatrix]
      rfl
    · intro y _hy hyx
      simp [rxBoundary1Matrix, rxBoundary2Matrix, hyx, Ne.symm hyx]
    · simp
  · rw [rxBoundaryProductMatrix]
    simp only [Fintype.sum_sum_type]
    rw [Fintype.sum_sigma]
    simp [rxBoundary1Matrix, rxBoundary2Matrix, hxx]

private noncomputable def rxVertexIndicator {Vertex : Type}
    (first second : Vertex) : Field := by
  classical
  exact if first = second then 1 else 0

private theorem rxSumMulIndicator {Index : Type}
    [Fintype Index] [DecidableEq Index]
    (value : Index → Field) (target : Index) :
    (∑ index : Index, value index *
      (if index = target then (1 : Field) else 0)) = value target := by
  classical
  simp

private def rxFinTwoElim {motive : Fin 2 → Sort _}
    (zero : motive 0) (one : motive 1) (endpoint : Fin 2) : motive endpoint := by
  rcases endpoint with ⟨endpoint, hendpoint⟩
  rcases endpoint with _ | endpoint
  · exact zero
  · rcases endpoint with _ | endpoint
    · exact one
    · omega

private theorem qDoubleCylinderVertexXIncidence_atRoot
    (P : TannerSquarePresentation) (S : OddScale)
    (x : P.X) (q : P.Q) (hxq : P.xq x q = true)
    (root : QStarEdge P q) (qVertex : QDoubleCylinderVertex P q S)
    (xVertex : DoubleCylinderVertex P x S) :
    qDoubleCylinderVertexXIncidence P q x S xVertex qVertex =
      rxVertexIndicator xVertex
        (qToXDoubleCylinderVertexAtRoot P q x hxq S root qVertex) := by
  classical
  rcases xVertex with ⟨xCopy, xVertex⟩
  rcases qVertex with ⟨qCopy, qVertex⟩
  fin_cases xCopy <;> fin_cases qCopy
  all_goals
    rcases xVertex with oldVertex | edgeInterior | faceInterior
  all_goals
    rcases qVertex with oldVertex' | edgeInterior'
  all_goals
    first
    | (rcases oldVertex' with cone | endpoint <;>
        simp [qDoubleCylinderVertexXIncidence, qSubdivisionVertexXIncidence,
          qToXDoubleCylinderVertexAtRoot, qToXSubdivisionVertexAtRoot,
          qToXBoundaryVertexAtRoot, xStarBoundaryVertexToStar,
          xBoundaryEdgeStart, xBoundaryEdgeEnd, qToXBoundaryEdge,
          rxVertexIndicator, Subtype.ext_iff, Prod.ext_iff, hxq])
    | simp [qDoubleCylinderVertexXIncidence, qSubdivisionVertexXIncidence,
        qToXDoubleCylinderVertexAtRoot, qToXSubdivisionVertexAtRoot,
        qToXBoundaryVertexAtRoot, xStarBoundaryVertexToStar,
        xBoundaryEdgeStart, xBoundaryEdgeEnd, qToXBoundaryEdge,
        rxVertexIndicator, Subtype.ext_iff, Prod.ext_iff, hxq]
  all_goals
    rcases edgeInterior with ⟨⟨edge, hmem⟩, index⟩
    rcases edge with xqEdge | qzEdge
    · simp [xStarBoundaryEdgeToStar, rxVertexIndicator,
        Subtype.ext_iff] at hmem ⊢
    · simp [xStarBoundaryEdgeToStar, qToXBoundaryEdge,
        rxVertexIndicator, Subtype.ext_iff, Prod.ext_iff, and_assoc]

private theorem qDoubleCylinderVertexXIncidence_endpoint
    (P : TannerSquarePresentation) (S : OddScale)
    (x : P.X) (q : P.Q) (hxq : P.xq x q = true)
    (qEdge : QDoubleCylinderEdge P q S) (endpoint : Two)
    (xVertex : DoubleCylinderVertex P x S) :
    qDoubleCylinderVertexXIncidence P q x S xVertex
        (edgeEndpoint (qDoubleCylinderEdgeStart P q S)
          (qDoubleCylinderEdgeEnd P q S) qEdge endpoint) =
      rxVertexIndicator xVertex
        (edgeEndpoint (tannerDoubleCylinderEdgeStart P x S)
          (tannerDoubleCylinderEdgeEnd P x S)
          (qToXDoubleCylinderEdgeRaw P q x hxq S qEdge) endpoint) := by
  let root := qDoubleCylinderUnderlyingStarEdge P q S qEdge
  refine rxFinTwoElim (motive := fun endpoint =>
    qDoubleCylinderVertexXIncidence P q x S xVertex
        (edgeEndpoint (qDoubleCylinderEdgeStart P q S)
          (qDoubleCylinderEdgeEnd P q S) qEdge endpoint) =
      rxVertexIndicator xVertex
        (edgeEndpoint (tannerDoubleCylinderEdgeStart P x S)
          (tannerDoubleCylinderEdgeEnd P x S)
          (qToXDoubleCylinderEdgeRaw P q x hxq S qEdge) endpoint)) ?_ ?_ endpoint
  · simp only [edgeEndpoint, twoSelect_zero]
    rw [qDoubleCylinderVertexXIncidence_atRoot P S x q hxq root]
    rw [qToXDoubleCylinderEdgeRaw_start P q x hxq S root qEdge]
  · simp only [edgeEndpoint, twoSelect_one]
    rw [qDoubleCylinderVertexXIncidence_atRoot P S x q hxq root]
    rw [qToXDoubleCylinderEdgeRaw_end P q x hxq S root qEdge]

private theorem doubleCylinderEdgeVertexMatrix_eq_endpointIndicators
    (P : TannerSquarePresentation) (S : OddScale) (x : P.X)
    (vertex : DoubleCylinderVertex P x S)
    (edge : DoubleCylinderEdge P x S) :
    doubleCylinderEdgeVertexMatrix P x S vertex edge =
      rxVertexIndicator vertex (tannerDoubleCylinderEdgeStart P x S edge) +
        rxVertexIndicator vertex (tannerDoubleCylinderEdgeEnd P x S edge) := by
  classical
  rcases edge with ⟨copy, subdivisionEdge⟩ | boundaryVertex
  · rcases vertex with ⟨vertexCopy, vertexValue⟩
    fin_cases vertexCopy <;> fin_cases copy <;>
      simp [doubleCylinderEdgeVertexMatrix, subdivisionEdgeVertexMatrix,
        tannerDoubleCylinderEdgeStart, tannerDoubleCylinderEdgeEnd,
        rxVertexIndicator]
  · rcases vertex with ⟨vertexCopy, vertexValue⟩
    fin_cases vertexCopy <;>
      simp [doubleCylinderEdgeVertexMatrix, tannerDoubleCylinderEdgeStart,
        tannerDoubleCylinderEdgeEnd, rxVertexIndicator]

private theorem qDoubleCylinderVertexZIncidence_eq_indicator
    (P : TannerSquarePresentation) (S : OddScale)
    (q : P.Q) (z : P.Z) (zCopy : Two) (hqz : P.qz q z = true)
    (vertex : QDoubleCylinderVertex P q S) :
    qDoubleCylinderVertexZIncidence P q S vertex (z, zCopy) =
      rxVertexIndicator vertex
        (zCopy, Sum.inl (Sum.inr (⟨z, hqz⟩ : QStarEdge P q))) := by
  classical
  rcases vertex with ⟨copy, vertex⟩
  fin_cases copy <;> fin_cases zCopy
  all_goals rcases vertex with (cone | endpoint) | interior
  all_goals
    simp [qDoubleCylinderVertexZIncidence, rxVertexIndicator, hqz,
      Subtype.ext_iff]

set_option maxHeartbeats 800000 in
private theorem rxBoundaryMatrices_mul_qEdge
    (P : TannerSquarePresentation) (S : OddScale)
    (xCoordinate : RX0 P S)
    (qEdge : Σ q : P.Q, QDoubleCylinderEdge P q S) :
    rxBoundaryProductMatrix P S xCoordinate
        (Sum.inl (Sum.inr qEdge)) = 0 := by
  classical
  rcases xCoordinate with ⟨x, xVertex⟩
  rcases qEdge with ⟨q, qEdge⟩
  rw [rxBoundaryProductMatrix]
  rw [Fintype.sum_sum_type]
  rw [Fintype.sum_sigma, Fintype.sum_sigma]
  simp only [rxBoundary1Matrix, rxBoundary2Matrix]
  simp
  by_cases hxq : P.xq x q = true
  · let mapped := qToXDoubleCylinderEdgeRaw P q x hxq S qEdge
    have hX :
        (∑ edge : DoubleCylinderEdge P x S,
          doubleCylinderEdgeVertexMatrix P x S xVertex edge *
            qDoubleCylinderEdgeXIncidence P q x S edge qEdge) =
          doubleCylinderEdgeVertexMatrix P x S xVertex mapped := by
      rw [Finset.sum_eq_single mapped]
      · simp [qDoubleCylinderEdgeXIncidence, hxq, mapped]
      · intro other _ hother
        rw [qDoubleCylinderEdgeXIncidence]
        rw [dif_pos hxq]
        rw [if_neg]
        simp
        intro heq
        apply hother
        simpa [mapped] using heq
      · simp
    have hQ :
        (∑ vertex : QDoubleCylinderVertex P q S,
          qDoubleCylinderVertexXIncidence P q x S xVertex vertex *
            qDoubleCylinderEdgeVertexIncidence P q S vertex qEdge) =
          qDoubleCylinderVertexXIncidence P q x S xVertex
              (qDoubleCylinderEdgeStart P q S qEdge) +
            qDoubleCylinderVertexXIncidence P q x S xVertex
              (qDoubleCylinderEdgeEnd P q S qEdge) := by
      simp only [qDoubleCylinderEdgeVertexIncidence, mul_add,
        Finset.sum_add_distrib, rxSumMulIndicator]
    have hXsplit :
        (∑ edge : Two × SubdivisionEdge P x S,
            doubleCylinderEdgeVertexMatrix P x S xVertex (Sum.inl edge) *
              qDoubleCylinderEdgeXIncidence P q x S (Sum.inl edge) qEdge) +
          ∑ vertex : SubdivisionBoundaryVertex P x S,
            doubleCylinderEdgeVertexMatrix P x S xVertex (Sum.inr vertex) *
              qDoubleCylinderEdgeXIncidence P q x S (Sum.inr vertex) qEdge =
          doubleCylinderEdgeVertexMatrix P x S xVertex mapped := by
      simpa only [Fintype.sum_sum_type] using hX
    have hstart :
        qDoubleCylinderVertexXIncidence P q x S xVertex
            (qDoubleCylinderEdgeStart P q S qEdge) =
          rxVertexIndicator xVertex
            (tannerDoubleCylinderEdgeStart P x S mapped) := by
      simpa only [edgeEndpoint, twoSelect_zero, mapped] using
        qDoubleCylinderVertexXIncidence_endpoint P S x q hxq qEdge 0 xVertex
    have hend :
        qDoubleCylinderVertexXIncidence P q x S xVertex
            (qDoubleCylinderEdgeEnd P q S qEdge) =
          rxVertexIndicator xVertex
            (tannerDoubleCylinderEdgeEnd P x S mapped) := by
      simpa only [edgeEndpoint, twoSelect_one, mapped] using
        qDoubleCylinderVertexXIncidence_endpoint P S x q hxq qEdge 1 xVertex
    rw [hXsplit, hQ]
    rw [hstart, hend]
    rw [doubleCylinderEdgeVertexMatrix_eq_endpointIndicators]
    exact ZModModule.add_self _
  · simp [qDoubleCylinderEdgeXIncidence,
      qDoubleCylinderVertexXIncidence, qSubdivisionVertexXIncidence, hxq]

set_option maxHeartbeats 800000 in
private theorem rxBoundaryMatrices_mul_zPoint
    (P : TannerSquarePresentation) (S : OddScale)
    (xCoordinate : RX0 P S) (zPoint : P.Z × Two) :
    rxBoundaryProductMatrix P S xCoordinate (Sum.inr zPoint) = 0 := by
  classical
  rcases xCoordinate with ⟨x, xVertex⟩
  rcases zPoint with ⟨z, zCopy⟩
  rw [rxBoundaryProductMatrix]
  rw [Fintype.sum_sum_type]
  rw [Fintype.sum_sigma, Fintype.sum_sigma]
  simp only [rxBoundary1Matrix, rxBoundary2Matrix, mul_zero,
    Finset.sum_const_zero, zero_add]
  have hreduce :
      (∑ q : P.Q, ∑ vertex : QDoubleCylinderVertex P q S,
        qDoubleCylinderVertexXIncidence P q x S xVertex vertex *
          qDoubleCylinderVertexZIncidence P q S vertex (z, zCopy)) =
        ∑ q : P.Q, if hqz : P.qz q z = true then
          qDoubleCylinderVertexXIncidence P q x S xVertex
            (zCopy, Sum.inl (Sum.inr (⟨z, hqz⟩ : QStarEdge P q)))
        else 0 := by
    apply Finset.sum_congr rfl
    intro q _
    by_cases hqz : P.qz q z = true
    · rw [dif_pos hqz]
      simp_rw [qDoubleCylinderVertexZIncidence_eq_indicator P S q z zCopy hqz]
      simp [rxVertexIndicator]
    · rw [dif_neg hqz]
      simp [qDoubleCylinderVertexZIncidence, hqz]
  rw [hreduce]
  rcases xVertex with ⟨xCopy, xVertex⟩
  fin_cases xCopy <;> fin_cases zCopy
  all_goals rcases xVertex with oldVertex | edgeInterior | faceInterior
  all_goals
    first
    | (rcases oldVertex with ⟨oldVertex, hmem⟩;
       rcases oldVertex with oldX | oldQ | oldZ)
    | skip
  all_goals
    try simp [qDoubleCylinderVertexXIncidence, qSubdivisionVertexXIncidence]
  all_goals
    by_cases hzz : oldZ = z
    · subst oldZ
      calc
        _ = ∑ q : P.Q,
            if P.xq x q && P.qz q z then (1 : Field) else 0 := by
          apply Finset.sum_congr rfl
          intro q _
          by_cases hxq : P.xq x q = true <;>
            by_cases hqz : P.qz q z = true <;>
              simp [hxq, hqz, Subtype.ext_iff]
        _ = 0 := sharedQ_indicator_sum_zero P x z
    · simp [hzz]

/-- The explicit RX degree-one and degree-two incidence matrices compose to
zero.  The three column families are discharged respectively by the local
X-cylinder chain law, cancellation of the two Q-edge endpoints, and the
perfect-pairing parity of every shared-Q fiber. -/
theorem rxBoundaryMatrices_mul
    (P : TannerSquarePresentation) (S : OddScale) :
    rxBoundaryProductMatrix P S = 0 := by
  classical
  ext xCoordinate zCoordinate
  rcases zCoordinate with (xFace | qEdge) | zPoint
  · exact rxBoundaryMatrices_mul_xFace P S xCoordinate xFace
  · exact rxBoundaryMatrices_mul_qEdge P S xCoordinate qEdge
  · exact rxBoundaryMatrices_mul_zPoint P S xCoordinate zPoint

/-- Degree-one boundary of the total concrete RX replacement. -/
noncomputable def rxBoundary1
    (P : TannerSquarePresentation) (S : OddScale) :
    Word Field (RX1 P S) →ₗ[Field] Word Field (RX0 P S) := by
  classical
  exact Matrix.toLin' (rxBoundary1Matrix P S)

/-- Degree-two boundary of the total concrete RX replacement. -/
noncomputable def rxBoundary2
    (P : TannerSquarePresentation) (S : OddScale) :
    Word Field (RX2 P S) →ₗ[Field] Word Field (RX1 P S) := by
  classical
  exact Matrix.toLin' (rxBoundary2Matrix P S)

/-- The total explicit RX boundaries satisfy the chain condition. -/
theorem rxBoundary_squared
    (P : TannerSquarePresentation) (S : OddScale) :
    (rxBoundary1 P S).comp (rxBoundary2 P S) = 0 := by
  classical
  change (Matrix.toLin' (rxBoundary1Matrix P S)).comp
    (Matrix.toLin' (rxBoundary2Matrix P S)) = 0
  rw [← Matrix.toLin'_mul (rxBoundary1Matrix P S) (rxBoundary2Matrix P S)]
  change Matrix.toLin' (rxBoundaryProductMatrix P S) = 0
  rw [rxBoundaryMatrices_mul]
  simp

/-! ## Concrete F04 local complexes -/

/-- The RX X-block is exactly the cellular double cylinder from #871. -/
noncomputable def rxCx (P : TannerSquarePresentation) (x : P.X)
    (S : OddScale) :
    ChainComplexData Field
      (Word Field (DoubleCylinderVertex P x S))
      (Word Field (DoubleCylinderEdge P x S))
      (Word Field (DoubleCylinderFace P x S)) :=
  doubleCylinderChainComplex P x S

/-- The RX Q-block is the Q-cylinder shifted up by one degree. -/
noncomputable def rxCq (P : TannerSquarePresentation) (q : P.Q)
    (S : OddScale) :
    ChainComplexData Field
      (Word Field (Fin 0))
      (Word Field (QDoubleCylinderVertex P q S))
      (Word Field (QDoubleCylinderEdge P q S)) where
  boundary1 := 0
  boundary2 := qDoubleCylinderBoundary1 P q S
  boundary_squared := by simp

/-- The RX Z-block is the two old-Z copy points shifted to degree two. -/
noncomputable def rxCz (_P : TannerSquarePresentation) (_z : _P.Z) :
    ChainComplexData Field
      (Word Field (Fin 0)) (Word Field (Fin 0)) (Word Field Two) where
  boundary1 := 0
  boundary2 := 0
  boundary_squared := by simp

/-- The total concrete RX chain complex assembled from the explicit successor
incidence and restriction matrices. -/
noncomputable def rxTotalChainComplex
    (P : TannerSquarePresentation) (S : OddScale) :
    ChainComplexData Field
      (Word Field (RX0 P S))
      (Word Field (RX1 P S))
      (Word Field (RX2 P S)) where
  boundary1 := rxBoundary1 P S
  boundary2 := rxBoundary2 P S
  boundary_squared := rxBoundary_squared P S

/-! ## Restriction maps and parity coordinates -/

/-- Pull a finite word back along an explicit coordinate map. -/
def wordPullback {Source Target : Type}
    (map : Source → Target) : Word Field Target →ₗ[Field] Word Field Source where
  toFun := fun word source => word (map source)
  map_add' := by intros; rfl
  map_smul' := by intros; rfl

@[simp] theorem wordPullback_apply {Source Target : Type}
    (map : Source → Target) (word : Word Field Target) (source : Source) :
    wordPullback map word source = word (map source) := rfl

/-- Coordinate formula for the coboundary of an endpoint graph. -/
theorem wordLinearMapTranspose_graphBoundary_apply
    {Vertex Edge : Type} [Fintype Vertex] [Fintype Edge]
    [DecidableEq Vertex] [DecidableEq Edge]
    (edgeStart edgeEnd : Edge → Vertex) (word : Word Field Vertex)
    (edge : Edge) :
    wordLinearMapTranspose (graphBoundary edgeStart edgeEnd) word edge =
      word (edgeStart edge) + word (edgeEnd edge) := by
  have hpair := wordPairing_wordLinearMapTranspose
    (graphBoundary edgeStart edgeEnd) word
    (Pi.single edge (1 : Field))
  simpa only [wordPairing_apply, dotProduct_single_one,
    graphBoundary_single, graphEdgeBoundary, dotProduct_add] using hpair

/-- Pullback commutes with graph coboundaries when the two endpoint tables
commute pointwise. -/
theorem wordPullback_graphCoboundary
    {SourceVertex SourceEdge TargetVertex TargetEdge : Type}
    [Fintype SourceVertex] [Fintype SourceEdge]
    [Fintype TargetVertex] [Fintype TargetEdge]
    [DecidableEq SourceVertex] [DecidableEq SourceEdge]
    [DecidableEq TargetVertex] [DecidableEq TargetEdge]
    (sourceStart sourceEnd : SourceEdge → SourceVertex)
    (targetStart targetEnd : TargetEdge → TargetVertex)
    (vertexMap : SourceVertex → TargetVertex)
    (edgeMap : SourceEdge → TargetEdge)
    (start_commutes : ∀ edge, targetStart (edgeMap edge) =
      vertexMap (sourceStart edge))
    (end_commutes : ∀ edge, targetEnd (edgeMap edge) =
      vertexMap (sourceEnd edge)) :
    (wordLinearMapTranspose (graphBoundary sourceStart sourceEnd)).comp
        (wordPullback vertexMap) =
      (wordPullback edgeMap).comp
        (wordLinearMapTranspose (graphBoundary targetStart targetEnd)) := by
  classical
  apply LinearMap.ext
  intro word
  ext edge
  simp only [LinearMap.comp_apply, wordPullback_apply,
    wordLinearMapTranspose_graphBoundary_apply]
  rw [start_commutes edge, end_commutes edge]

/-- A zero graph coboundary makes a word constant along every constructive
undirected path. -/
theorem word_eq_root_of_graphCoboundary_eq_zero
    {Vertex Edge : Type} [Fintype Vertex] [Fintype Edge]
    [DecidableEq Vertex] [DecidableEq Edge]
    (edgeStart edgeEnd : Edge → Vertex) (root : Vertex)
    (paths : ∀ vertex, UndirectedPath edgeStart edgeEnd root vertex)
    (word : Word Field Vertex)
    (hword : wordLinearMapTranspose (graphBoundary edgeStart edgeEnd) word = 0) :
    ∀ vertex, word vertex = word root := by
  intro vertex
  induction paths vertex with
  | nil => rfl
  | @step u v path edge connects ih =>
      have hedge := congrFun hword edge
      rw [wordLinearMapTranspose_graphBoundary_apply] at hedge
      change word (edgeStart edge) + word (edgeEnd edge) = 0 at hedge
      have hneg : ∀ value : Field, -value = value := by
        intro value
        exact neg_eq_of_add_eq_zero_left (ZModModule.add_self value)
      have heq : word (edgeStart edge) = word (edgeEnd edge) := by
        rw [← sub_eq_zero]
        simpa [sub_eq_add_neg, hneg] using hedge
      rcases connects with connects | connects
      · calc
          word v = word (edgeEnd edge) := congrArg word connects.2.symm
          _ = word (edgeStart edge) := heq.symm
          _ = word u := congrArg word connects.1
          _ = word root := ih
      · calc
          word v = word (edgeStart edge) := congrArg word connects.1.symm
          _ = word (edgeEnd edge) := heq
          _ = word u := congrArg word connects.2
          _ = word root := ih

/-- A zero graph coboundary is constant along one supplied constructive path. -/
theorem word_eq_root_of_graphCoboundary_eq_zero_of_path
    {Vertex Edge : Type} [Fintype Vertex] [Fintype Edge]
    [DecidableEq Vertex] [DecidableEq Edge]
    (edgeStart edgeEnd : Edge → Vertex) (root vertex : Vertex)
    (path : UndirectedPath edgeStart edgeEnd root vertex)
    (word : Word Field Vertex)
    (hword : wordLinearMapTranspose (graphBoundary edgeStart edgeEnd) word = 0) :
    word vertex = word root := by
  induction path with
  | nil => rfl
  | @step u v path edge connects ih =>
      have hedge := congrFun hword edge
      rw [wordLinearMapTranspose_graphBoundary_apply] at hedge
      change word (edgeStart edge) + word (edgeEnd edge) = 0 at hedge
      have heq : word (edgeStart edge) = word (edgeEnd edge) := by
        rw [← sub_eq_zero]
        simpa [sub_eq_add_neg, neg_eq_self] using hedge
      rcases connects with connects | connects
      · calc
          word v = word (edgeEnd edge) := congrArg word connects.2.symm
          _ = word (edgeStart edge) := heq.symm
          _ = word u := congrArg word connects.1
          _ = word root := ih
      · calc
          word v = word (edgeStart edge) := congrArg word connects.1.symm
          _ = word (edgeEnd edge) := heq
          _ = word u := congrArg word connects.2
          _ = word root := ih

/-- Vertex after traversing a prefix of one subdivided X-star edge. -/
private def rxSubdivisionSegmentVertex
    (P : TannerSquarePresentation) (x : P.X) (S : OddScale)
    (edge : XStarEdge P x) (step : Nat) (hstep : step ≤ S.half) :
    SubdivisionVertex P x S :=
  if hzero : step = 0 then
    Sum.inl (xStarEdgeStart P x edge)
  else if hlast : step = S.half then
    Sum.inl (xStarEdgeEnd P x edge)
  else
    Sum.inr (Sum.inl (edge, ⟨step - 1, by omega⟩))

/-- Traverse one explicitly tagged subdivided X-star edge. -/
private noncomputable def rxSubdivisionSegmentPath
    (P : TannerSquarePresentation) (x : P.X) (S : OddScale)
    (edge : XStarEdge P x) :
    (step : Nat) → (hstep : step ≤ S.half) →
      UndirectedPath (subdivisionEdgeStart P x S)
        (subdivisionEdgeEnd P x S) (Sum.inl (xStarEdgeStart P x edge))
        (rxSubdivisionSegmentVertex P x S edge step hstep)
  | 0, _ => .nil
  | step + 1, hstep => by
      have hindex : step < S.half := by omega
      let index : Fin S.half := ⟨step, hindex⟩
      apply UndirectedPath.step
        (rxSubdivisionSegmentPath P x S edge step (by omega))
        (Sum.inl (edge, index))
      exact Or.inl ⟨by
        have hnotlast : step ≠ S.half := by omega
        simp [rxSubdivisionSegmentVertex, subdivisionEdgeStart, index,
          subdivisionSegmentStart, hnotlast], by
        simp [rxSubdivisionSegmentVertex, subdivisionEdgeEnd, index,
          subdivisionSegmentEnd]⟩

/-- Endpoint graph boundary of the constructed X-cylinder. -/
noncomputable def doubleCylinderGraphBoundary
    (P : TannerSquarePresentation) (x : P.X) (S : OddScale) :
    Word Field (DoubleCylinderEdge P x S) →ₗ[Field]
      Word Field (DoubleCylinderVertex P x S) := by
  classical
  exact graphBoundary (tannerDoubleCylinderEdgeStart P x S)
    (tannerDoubleCylinderEdgeEnd P x S)

/-- The endpoint graph boundary is exactly the constructed X-cylinder
degree-one boundary. -/
theorem doubleCylinderGraphBoundary_eq_boundary1
    (P : TannerSquarePresentation) (x : P.X) (S : OddScale) :
    doubleCylinderGraphBoundary P x S = doubleCylinderBoundary1 P x S := by
  classical
  apply LinearMap.ext
  intro word
  rw [← word_eq_sum_single (F := Field) word]
  simp only [map_sum]
  apply Finset.sum_congr rfl
  intro edge _
  have hsingle : Pi.single edge (word edge) =
      word edge • Pi.single edge (1 : Field) := by
    ext other
    change (Pi.single edge (word edge) :
        Word Field (DoubleCylinderEdge P x S)) other =
      word edge *
        (Pi.single edge (1 : Field) :
          Word Field (DoubleCylinderEdge P x S)) other
    rw [Pi.single_apply, Pi.single_apply]
    by_cases h : other = edge <;> simp [h]
  rw [hsingle]
  simp only [map_smul]
  apply congrArg (fun value => word edge • value)
  rw [doubleCylinderGraphBoundary, graphBoundary_single]
  ext vertex
  simp only [doubleCylinderBoundary1, Matrix.toLin'_apply,
    Matrix.mulVec, dotProduct]
  rw [Fintype.sum_eq_single edge]
  · rcases edge with ⟨copy, subdivisionEdge⟩ | boundaryVertex
    · rcases vertex with ⟨vertexCopy, vertexValue⟩
      fin_cases vertexCopy <;> fin_cases copy <;>
        simp [doubleCylinderEdgeVertexMatrix, subdivisionEdgeVertexMatrix,
          graphEdgeBoundary, tannerDoubleCylinderEdgeStart,
          tannerDoubleCylinderEdgeEnd, Pi.single_apply]
    · rcases vertex with ⟨vertexCopy, vertexValue⟩
      fin_cases vertexCopy <;>
        simp [doubleCylinderEdgeVertexMatrix, graphEdgeBoundary,
          tannerDoubleCylinderEdgeStart, tannerDoubleCylinderEdgeEnd,
          Pi.single_apply]
  · intro other hne
    simp [hne]

/-- A zero X-cylinder coboundary equates the two ends of every subdivided
original star edge, at either fixed cylinder copy. -/
theorem rxCxCocycle_eq_on_starEdge
    (P : TannerSquarePresentation) (x : P.X) (S : OddScale)
    (copy : Two) (edge : XStarEdge P x)
    (word : Word Field (DoubleCylinderVertex P x S))
    (hword : wordLinearMapTranspose (rxCx P x S).boundary1 word = 0) :
    word (copy, Sum.inl (xStarEdgeEnd P x edge)) =
      word (copy, Sum.inl (xStarEdgeStart P x edge)) := by
  classical
  let path := rxSubdivisionSegmentPath P x S edge S.half (le_refl S.half)
  let lifted := UndirectedPath.map
    (edgeStart := subdivisionEdgeStart P x S)
    (edgeEnd := subdivisionEdgeEnd P x S)
    (edgeStart' := tannerDoubleCylinderEdgeStart P x S)
    (edgeEnd' := tannerDoubleCylinderEdgeEnd P x S)
    (fun vertex => (copy, vertex)) (fun localEdge => Sum.inl (copy, localEdge))
    (fun _ => rfl) (fun _ => rfl) path
  have hgraph : wordLinearMapTranspose
      (graphBoundary (tannerDoubleCylinderEdgeStart P x S)
        (tannerDoubleCylinderEdgeEnd P x S)) word = 0 := by
    change wordLinearMapTranspose (doubleCylinderGraphBoundary P x S) word = 0
    rw [doubleCylinderGraphBoundary_eq_boundary1]
    simpa [rxCx, doubleCylinderChainComplex] using hword
  have hpath := word_eq_root_of_graphCoboundary_eq_zero_of_path
    (tannerDoubleCylinderEdgeStart P x S)
    (tannerDoubleCylinderEdgeEnd P x S)
    (copy, Sum.inl (xStarEdgeStart P x edge))
    (copy, rxSubdivisionSegmentVertex P x S edge S.half (le_refl S.half))
    lifted word hgraph
  simpa [lifted, path, rxSubdivisionSegmentVertex, S.half_pos.ne'] using hpath

/-- A zero X-cylinder coboundary equates the endpoints of each concrete
subdivision edge at a fixed copy. -/
theorem rxCxCocycle_eq_on_subdivisionEdge
    (P : TannerSquarePresentation) (x : P.X) (S : OddScale)
    (copy : Two) (edge : SubdivisionEdge P x S)
    (word : Word Field (DoubleCylinderVertex P x S))
    (hword : wordLinearMapTranspose (rxCx P x S).boundary1 word = 0) :
    word (copy, subdivisionEdgeEnd P x S edge) =
      word (copy, subdivisionEdgeStart P x S edge) := by
  classical
  have hgraph : wordLinearMapTranspose
      (graphBoundary (tannerDoubleCylinderEdgeStart P x S)
        (tannerDoubleCylinderEdgeEnd P x S)) word = 0 := by
    change wordLinearMapTranspose (doubleCylinderGraphBoundary P x S) word = 0
    rw [doubleCylinderGraphBoundary_eq_boundary1]
    simpa [rxCx, doubleCylinderChainComplex] using hword
  have hedge := congrFun hgraph (Sum.inl (copy, edge))
  rw [wordLinearMapTranspose_graphBoundary_apply] at hedge
  change word (copy, subdivisionEdgeStart P x S edge) +
      word (copy, subdivisionEdgeEnd P x S edge) = 0 at hedge
  rw [← sub_eq_zero]
  simpa [sub_eq_add_neg, neg_eq_self, add_comm] using hedge

private theorem rxCxCocycle_gridVertical_eq_zero
    (P : TannerSquarePresentation) (x : P.X) (S : OddScale)
    (copy : Two) (face : XStarFace P x)
    (i : Fin (S.half + 1))
    (word : Word Field (DoubleCylinderVertex P x S))
    (hword : wordLinearMapTranspose (rxCx P x S).boundary1 word = 0) :
    (step : Nat) → (hstep : step ≤ S.half) →
      word (copy, subdivisionGridVertex P x S face i
        ⟨step, by omega⟩) =
      word (copy, subdivisionGridVertex P x S face i 0)
  | 0, _ => rfl
  | step + 1, hstep => by
      have hindex : step < S.half := by omega
      let edge := subdivisionVerticalEdge P x S face i
        (⟨step, hindex⟩ : Fin S.half)
      have hedge := rxCxCocycle_eq_on_subdivisionEdge
        P x S copy edge word hword
      rw [subdivisionVerticalEdge_start, subdivisionVerticalEdge_end] at hedge
      have ih := rxCxCocycle_gridVertical_eq_zero P x S copy face i word hword
        step (by omega)
      exact hedge.trans ih

private theorem rxCxCocycle_gridHorizontal_eq_zero
    (P : TannerSquarePresentation) (x : P.X) (S : OddScale)
    (copy : Two) (face : XStarFace P x)
    (word : Word Field (DoubleCylinderVertex P x S))
    (hword : wordLinearMapTranspose (rxCx P x S).boundary1 word = 0) :
    (step : Nat) → (hstep : step ≤ S.half) →
      word (copy, subdivisionGridVertex P x S face
        ⟨step, by omega⟩ 0) =
      word (copy, subdivisionGridVertex P x S face 0 0)
  | 0, _ => rfl
  | step + 1, hstep => by
      have hindex : step < S.half := by omega
      let edge := subdivisionHorizontalEdge P x S face
        (⟨step, hindex⟩ : Fin S.half) 0
      have hedge := rxCxCocycle_eq_on_subdivisionEdge
        P x S copy edge word hword
      rw [subdivisionHorizontalEdge_start, subdivisionHorizontalEdge_end] at hedge
      have ih := rxCxCocycle_gridHorizontal_eq_zero P x S copy face word hword
        step (by omega)
      exact hedge.trans ih

/-- Every grid vertex of one materialized local face has the value of its
X-corner under a zero X-cylinder coboundary. -/
theorem rxCxCocycle_gridVertex_eq_xCorner
    (P : TannerSquarePresentation) (x : P.X) (S : OddScale)
    (copy : Two) (face : XStarFace P x)
    (i j : Fin (S.half + 1))
    (word : Word Field (DoubleCylinderVertex P x S))
    (hword : wordLinearMapTranspose (rxCx P x S).boundary1 word = 0) :
    word (copy, subdivisionGridVertex P x S face i j) =
      word (copy, Sum.inl (xStarFaceXVertex P x face)) := by
  have hvertical := rxCxCocycle_gridVertical_eq_zero
    P x S copy face i word hword j.1 (by omega)
  have hhorizontal := rxCxCocycle_gridHorizontal_eq_zero
    P x S copy face word hword i.1 (by omega)
  calc
    word (copy, subdivisionGridVertex P x S face i j) =
        word (copy, subdivisionGridVertex P x S face i 0) := by
      simpa using hvertical
    _ = word (copy, subdivisionGridVertex P x S face 0 0) := by
      simpa using hhorizontal
    _ = word (copy, Sum.inl (xStarFaceXVertex P x face)) := by
      simp [subdivisionGridVertex]

private theorem xStarBoundaryEdgeToStar_start
    (P : TannerSquarePresentation) (x : P.X)
    (edge : XStarBoundaryEdge P x) :
    xStarEdgeStart P x (xStarBoundaryEdgeToStar P x edge) =
      xStarBoundaryVertexToStar P x (xBoundaryEdgeStart P x edge) := by
  apply Subtype.ext
  rcases edge with ⟨edge, hboundary⟩
  rcases edge with xqEdge | qzEdge
  · simp [xStarBoundaryEdgeMember] at hboundary
  · rfl

private theorem xStarBoundaryEdgeToStar_end
    (P : TannerSquarePresentation) (x : P.X)
    (edge : XStarBoundaryEdge P x) :
    xStarEdgeEnd P x (xStarBoundaryEdgeToStar P x edge) =
      xStarBoundaryVertexToStar P x (xBoundaryEdgeEnd P x edge) := by
  apply Subtype.ext
  rcases edge with ⟨edge, hboundary⟩
  rcases edge with xqEdge | qzEdge
  · simp [xStarBoundaryEdgeMember] at hboundary
  · rfl

/-- A zero X-cylinder coboundary is constant on every old boundary vertex at
one fixed cylinder copy.  This uses only the supplied historical boundary
path; it does not select an incident face or a quotient representative. -/
theorem rxCxCocycle_eq_on_boundaryVertex
    (P : TannerSquarePresentation) (A : TannerSquareAdmissible P)
    (x : P.X) (S : OddScale) (copy : Two)
    (word : Word Field (DoubleCylinderVertex P x S))
    (hword : wordLinearMapTranspose (rxCx P x S).boundary1 word = 0)
    (vertex : XStarBoundaryVertex P x) :
    word (copy, (subdivisionOriginalBoundaryVertex P x S vertex).1) =
      word (copy,
        (subdivisionOriginalBoundaryVertex P x S (A.xBoundaryRoot x)).1) := by
  let path := A.xBoundaryPath x vertex
  induction path with
  | nil => rfl
  | @step u v path edge connects ih =>
      let starEdge := xStarBoundaryEdgeToStar P x edge
      have hedge := rxCxCocycle_eq_on_starEdge P x S copy starEdge word hword
      have hstart :
          Sum.inl (xStarEdgeStart P x starEdge) =
            (subdivisionOriginalBoundaryVertex P x S
              (xBoundaryEdgeStart P x edge)).1 := by
        exact congrArg Sum.inl (xStarBoundaryEdgeToStar_start P x edge)
      have hend :
          Sum.inl (xStarEdgeEnd P x starEdge) =
            (subdivisionOriginalBoundaryVertex P x S
              (xBoundaryEdgeEnd P x edge)).1 := by
        exact congrArg Sum.inl (xStarBoundaryEdgeToStar_end P x edge)
      rw [hstart, hend] at hedge
      rcases connects with connects | connects
      · calc
          word (copy, (subdivisionOriginalBoundaryVertex P x S v).1) =
              word (copy, (subdivisionOriginalBoundaryVertex P x S
                (xBoundaryEdgeEnd P x edge)).1) :=
            congrArg (fun boundaryVertex =>
              word (copy, (subdivisionOriginalBoundaryVertex P x S
                boundaryVertex).1)) connects.2.symm
          _ = word (copy, (subdivisionOriginalBoundaryVertex P x S
                (xBoundaryEdgeStart P x edge)).1) := hedge
          _ = word (copy, (subdivisionOriginalBoundaryVertex P x S u).1) :=
            congrArg (fun boundaryVertex =>
              word (copy, (subdivisionOriginalBoundaryVertex P x S
                boundaryVertex).1)) connects.1
          _ = word (copy, (subdivisionOriginalBoundaryVertex P x S
                (A.xBoundaryRoot x)).1) := ih
      · calc
          word (copy, (subdivisionOriginalBoundaryVertex P x S v).1) =
              word (copy, (subdivisionOriginalBoundaryVertex P x S
                (xBoundaryEdgeStart P x edge)).1) :=
            congrArg (fun boundaryVertex =>
              word (copy, (subdivisionOriginalBoundaryVertex P x S
                boundaryVertex).1)) connects.1.symm
          _ = word (copy, (subdivisionOriginalBoundaryVertex P x S
                (xBoundaryEdgeEnd P x edge)).1) := hedge.symm
          _ = word (copy, (subdivisionOriginalBoundaryVertex P x S u).1) :=
            congrArg (fun boundaryVertex =>
              word (copy, (subdivisionOriginalBoundaryVertex P x S
                boundaryVertex).1)) connects.2
          _ = word (copy, (subdivisionOriginalBoundaryVertex P x S
                (A.xBoundaryRoot x)).1) := ih

/-- The X-corner of every materialized old face has the common boundary-root
value. -/
theorem rxCxCocycle_faceXCorner_eq_boundaryRoot
    (P : TannerSquarePresentation) (A : TannerSquareAdmissible P)
    (x : P.X) (S : OddScale) (copy : Two) (face : XStarFace P x)
    (word : Word Field (DoubleCylinderVertex P x S))
    (hword : wordLinearMapTranspose (rxCx P x S).boundary1 word = 0) :
    word (copy, Sum.inl (xStarFaceXVertex P x face)) =
      word (copy,
        (subdivisionOriginalBoundaryVertex P x S (A.xBoundaryRoot x)).1) := by
  let boundaryQ : XStarBoundaryVertex P x :=
    ⟨Vertex.q (P.faceQ face.1 0), by
      change decide (∃ candidate : P.Face,
        xStarFaceMember P x candidate = true ∧
          (P.faceQ face.1 0 = P.faceQ candidate 0 ∨
            P.faceQ face.1 0 = P.faceQ candidate 1)) = true
      rw [decide_eq_true_eq]
      exact ⟨face.1, face.2, Or.inl rfl⟩⟩
  have hedge := rxCxCocycle_eq_on_starEdge P x S copy
    (xStarFaceXQEdge P x face 0) word hword
  have hq : Sum.inl (xStarFaceQVertex P x face 0) =
      (subdivisionOriginalBoundaryVertex P x S boundaryQ).1 := by
    apply congrArg Sum.inl
    apply Subtype.ext
    rfl
  rw [xStarEdgeStart_faceXQEdge, xStarEdgeEnd_faceXQEdge, hq] at hedge
  exact hedge.symm.trans
    (rxCxCocycle_eq_on_boundaryVertex P A x S copy word hword boundaryQ)

/-- Every original X-star vertex has the common boundary-root value.  Face
membership existentials are eliminated only inside this proposition proof. -/
theorem rxCxCocycle_eq_on_oldVertex
    (P : TannerSquarePresentation) (A : TannerSquareAdmissible P)
    (x : P.X) (S : OddScale) (copy : Two)
    (word : Word Field (DoubleCylinderVertex P x S))
    (hword : wordLinearMapTranspose (rxCx P x S).boundary1 word = 0)
    (vertex : XStarVertex P x) :
    word (copy, Sum.inl vertex) =
      word (copy,
        (subdivisionOriginalBoundaryVertex P x S (A.xBoundaryRoot x)).1) := by
  rcases vertex with ⟨vertex, hmember⟩
  rcases vertex with oldX | oldQ | oldZ
  · change decide (oldX = x) = true at hmember
    have hx : oldX = x := of_decide_eq_true hmember
    subst oldX
    let root := A.xBoundaryRoot x
    rcases root with ⟨rootVertex, hroot⟩
    rcases rootVertex with rootX | rootQ | rootZ
    · simp [xStarBoundaryVertexMember] at hroot
    · change decide (∃ face : P.Face,
          xStarFaceMember P x face = true ∧
            (rootQ = P.faceQ face 0 ∨ rootQ = P.faceQ face 1)) = true at hroot
      rcases of_decide_eq_true hroot with ⟨face, hface, _⟩
      let starFace : XStarFace P x := ⟨face, hface⟩
      have hcorner := rxCxCocycle_faceXCorner_eq_boundaryRoot
        P A x S copy starFace word hword
      have hfx : P.faceX face = x := by
        simpa [xStarFaceMember] using hface
      let oldVertex : XStarVertex P x := ⟨Vertex.x x, hmember⟩
      have hv : oldVertex = xStarFaceXVertex P x starFace := by
        apply Subtype.ext
        simp [oldVertex, xStarFaceXVertex, starFace, hfx]
      exact (congrArg (fun v => word (copy, Sum.inl v)) hv).trans hcorner
    · change decide (∃ face : P.Face,
          xStarFaceMember P x face = true ∧ rootZ = P.faceZ face) = true at hroot
      rcases of_decide_eq_true hroot with ⟨face, hface, _⟩
      let starFace : XStarFace P x := ⟨face, hface⟩
      have hcorner := rxCxCocycle_faceXCorner_eq_boundaryRoot
        P A x S copy starFace word hword
      have hfx : P.faceX face = x := by
        simpa [xStarFaceMember] using hface
      let oldVertex : XStarVertex P x := ⟨Vertex.x x, hmember⟩
      have hv : oldVertex = xStarFaceXVertex P x starFace := by
        apply Subtype.ext
        simp [oldVertex, xStarFaceXVertex, starFace, hfx]
      exact (congrArg (fun v => word (copy, Sum.inl v)) hv).trans hcorner
  · change decide (∃ face : P.Face,
        xStarFaceMember P x face = true ∧
          (oldQ = P.faceQ face 0 ∨ oldQ = P.faceQ face 1)) = true at hmember
    rcases of_decide_eq_true hmember with ⟨face, hface, hcorner⟩
    let starFace : XStarFace P x := ⟨face, hface⟩
    rcases hcorner with hcorner | hcorner
    · have hedge := rxCxCocycle_eq_on_starEdge P x S copy
        (xStarFaceXQEdge P x starFace 0) word hword
      rw [xStarEdgeStart_faceXQEdge, xStarEdgeEnd_faceXQEdge] at hedge
      let oldVertex : XStarVertex P x := ⟨Vertex.q oldQ, hmember⟩
      have hv : oldVertex = xStarFaceQVertex P x starFace 0 := by
        apply Subtype.ext
        simp [oldVertex, xStarFaceQVertex, starFace, hcorner]
      have hedge' := (congrArg (fun v => word (copy, Sum.inl v)) hv).trans hedge
      exact hedge'.trans (rxCxCocycle_faceXCorner_eq_boundaryRoot
        P A x S copy starFace word hword)
    · have hedge := rxCxCocycle_eq_on_starEdge P x S copy
        (xStarFaceXQEdge P x starFace 1) word hword
      rw [xStarEdgeStart_faceXQEdge, xStarEdgeEnd_faceXQEdge] at hedge
      let oldVertex : XStarVertex P x := ⟨Vertex.q oldQ, hmember⟩
      have hv : oldVertex = xStarFaceQVertex P x starFace 1 := by
        apply Subtype.ext
        simp [oldVertex, xStarFaceQVertex, starFace, hcorner]
      have hedge' := (congrArg (fun v => word (copy, Sum.inl v)) hv).trans hedge
      exact hedge'.trans (rxCxCocycle_faceXCorner_eq_boundaryRoot
        P A x S copy starFace word hword)
  · change decide (∃ face : P.Face,
        xStarFaceMember P x face = true ∧ oldZ = P.faceZ face) = true at hmember
    rcases of_decide_eq_true hmember with ⟨face, hface, hz⟩
    let starFace : XStarFace P x := ⟨face, hface⟩
    have hxq := rxCxCocycle_eq_on_starEdge P x S copy
      (xStarFaceXQEdge P x starFace 0) word hword
    have hqz := rxCxCocycle_eq_on_starEdge P x S copy
      (xStarFaceQZEdge P x starFace 0) word hword
    rw [xStarEdgeStart_faceXQEdge, xStarEdgeEnd_faceXQEdge] at hxq
    rw [xStarEdgeStart_faceQZEdge, xStarEdgeEnd_faceQZEdge] at hqz
    let oldVertex : XStarVertex P x := ⟨Vertex.z oldZ, hmember⟩
    have hv : oldVertex = xStarFaceZVertex P x starFace := by
      apply Subtype.ext
      simp [oldVertex, xStarFaceZVertex, starFace, hz]
    have hqz' := (congrArg (fun v => word (copy, Sum.inl v)) hv).trans hqz
    exact hqz'.trans (hxq.trans (rxCxCocycle_faceXCorner_eq_boundaryRoot
      P A x S copy starFace word hword))

/-- Every path-interior subdivision tag has the common boundary-root value. -/
theorem rxCxCocycle_eq_on_edgeInterior
    (P : TannerSquarePresentation) (A : TannerSquareAdmissible P)
    (x : P.X) (S : OddScale) (copy : Two)
    (word : Word Field (DoubleCylinderVertex P x S))
    (hword : wordLinearMapTranspose (rxCx P x S).boundary1 word = 0)
    (edge : XStarEdge P x) (index : Fin (S.half - 1)) :
    word (copy, Sum.inr (Sum.inl (edge, index))) =
      word (copy,
        (subdivisionOriginalBoundaryVertex P x S (A.xBoundaryRoot x)).1) := by
  classical
  have hstep : index.1 + 1 ≤ S.half := by
    have := index.2
    omega
  have hzero : index.1 + 1 ≠ 0 := by omega
  have hlast : index.1 + 1 ≠ S.half := by
    have := index.2
    omega
  let path := rxSubdivisionSegmentPath P x S edge (index.1 + 1) hstep
  let lifted := UndirectedPath.map
    (edgeStart := subdivisionEdgeStart P x S)
    (edgeEnd := subdivisionEdgeEnd P x S)
    (edgeStart' := tannerDoubleCylinderEdgeStart P x S)
    (edgeEnd' := tannerDoubleCylinderEdgeEnd P x S)
    (fun vertex => (copy, vertex)) (fun localEdge => Sum.inl (copy, localEdge))
    (fun _ => rfl) (fun _ => rfl) path
  have hgraph : wordLinearMapTranspose
      (graphBoundary (tannerDoubleCylinderEdgeStart P x S)
        (tannerDoubleCylinderEdgeEnd P x S)) word = 0 := by
    change wordLinearMapTranspose (doubleCylinderGraphBoundary P x S) word = 0
    rw [doubleCylinderGraphBoundary_eq_boundary1]
    simpa [rxCx, doubleCylinderChainComplex] using hword
  have hpath := word_eq_root_of_graphCoboundary_eq_zero_of_path
    (tannerDoubleCylinderEdgeStart P x S)
    (tannerDoubleCylinderEdgeEnd P x S)
    (copy, Sum.inl (xStarEdgeStart P x edge))
    (copy, rxSubdivisionSegmentVertex P x S edge (index.1 + 1) hstep)
    lifted word hgraph
  have hprefix : word (copy, Sum.inr (Sum.inl (edge, index))) =
      word (copy, Sum.inl (xStarEdgeStart P x edge)) := by
    simpa [lifted, path, rxSubdivisionSegmentVertex, hzero, hlast] using hpath
  exact hprefix.trans
    (rxCxCocycle_eq_on_oldVertex P A x S copy word hword
      (xStarEdgeStart P x edge))

/-- Every normalized subdivision vertex has the common boundary-root value.
The face-owner existential for old/edge tags is consumed only in the preceding
Prop proofs; this theorem returns no selected face or path. -/
theorem rxCxCocycle_eq_on_subdivisionVertex
    (P : TannerSquarePresentation) (A : TannerSquareAdmissible P)
    (x : P.X) (S : OddScale) (copy : Two)
    (word : Word Field (DoubleCylinderVertex P x S))
    (hword : wordLinearMapTranspose (rxCx P x S).boundary1 word = 0)
    (vertex : SubdivisionVertex P x S) :
    word (copy, vertex) =
      word (copy,
        (subdivisionOriginalBoundaryVertex P x S (A.xBoundaryRoot x)).1) := by
  rcases vertex with oldVertex | edgeInterior | faceInterior
  · exact rxCxCocycle_eq_on_oldVertex P A x S copy word hword oldVertex
  · rcases edgeInterior with ⟨edge, index⟩
    exact rxCxCocycle_eq_on_edgeInterior
      P A x S copy word hword edge index
  · rcases faceInterior with ⟨face, i, j⟩
    let gridI : Fin (S.half + 1) := ⟨i.1 + 1, by
      have := i.2
      have hhalf := S.half_pos
      omega⟩
    let gridJ : Fin (S.half + 1) := ⟨j.1 + 1, by
      have := j.2
      have hhalf := S.half_pos
      omega⟩
    have hgrid : subdivisionGridVertex P x S face gridI gridJ =
        Sum.inr (Sum.inr (face, i, j)) := by
      have hi0 : gridI.1 ≠ 0 := by simp [gridI]
      have him : gridI.1 ≠ S.half := by
        simp [gridI]
        have := i.2
        omega
      have hj0 : gridJ.1 ≠ 0 := by simp [gridJ]
      have hjm : gridJ.1 ≠ S.half := by
        simp [gridJ]
        have := j.2
        omega
      simp only [subdivisionGridVertex, hi0, him, hj0, hjm,
        dite_false, Sum.inr.injEq]
      apply Prod.ext
      · rfl
      · apply Prod.ext
        · apply Fin.ext
          change gridI.1 - 1 = i.1
          simp [gridI]
        · apply Fin.ext
          change gridJ.1 - 1 = j.1
          simp [gridJ]
    rw [← hgrid]
    exact (rxCxCocycle_gridVertex_eq_xCorner
      P x S copy face gridI gridJ word hword).trans
        (rxCxCocycle_faceXCorner_eq_boundaryRoot
          P A x S copy face word hword)

/-- The boundary-root vertical cylinder edge identifies the two copies. -/
theorem rxCxCocycle_copy_one_eq_zero_at_boundaryRoot
    (P : TannerSquarePresentation) (A : TannerSquareAdmissible P)
    (x : P.X) (S : OddScale)
    (word : Word Field (DoubleCylinderVertex P x S))
    (hword : wordLinearMapTranspose (rxCx P x S).boundary1 word = 0) :
    word (1,
        (subdivisionOriginalBoundaryVertex P x S (A.xBoundaryRoot x)).1) =
      word (0,
        (subdivisionOriginalBoundaryVertex P x S (A.xBoundaryRoot x)).1) := by
  classical
  let root := subdivisionOriginalBoundaryVertex P x S (A.xBoundaryRoot x)
  have hgraph : wordLinearMapTranspose
      (graphBoundary (tannerDoubleCylinderEdgeStart P x S)
        (tannerDoubleCylinderEdgeEnd P x S)) word = 0 := by
    change wordLinearMapTranspose (doubleCylinderGraphBoundary P x S) word = 0
    rw [doubleCylinderGraphBoundary_eq_boundary1]
    simpa [rxCx, doubleCylinderChainComplex] using hword
  have hedge := congrFun hgraph (Sum.inr root)
  rw [wordLinearMapTranspose_graphBoundary_apply] at hedge
  change word (0, root.1) + word (1, root.1) = 0 at hedge
  rw [← sub_eq_zero]
  simpa [sub_eq_add_neg, neg_eq_self, add_comm] using hedge

/-- Every X-cylinder degree-zero cocycle is constant at the copy-zero
boundary root. -/
theorem rxCxCocycle_eq_boundaryRoot_zeroCopy
    (P : TannerSquarePresentation) (A : TannerSquareAdmissible P)
    (x : P.X) (S : OddScale)
    (word : Word Field (DoubleCylinderVertex P x S))
    (hword : wordLinearMapTranspose (rxCx P x S).boundary1 word = 0)
    (vertex : DoubleCylinderVertex P x S) :
    word vertex =
      word (0,
        (subdivisionOriginalBoundaryVertex P x S (A.xBoundaryRoot x)).1) := by
  rcases vertex with ⟨copy, vertex⟩
  fin_cases copy
  · exact rxCxCocycle_eq_on_subdivisionVertex
      P A x S 0 word hword vertex
  · exact (rxCxCocycle_eq_on_subdivisionVertex
      P A x S 1 word hword vertex).trans
        (rxCxCocycle_copy_one_eq_zero_at_boundaryRoot P A x S word hword)

/-! ## Named F04 X-block degree-zero coordinate -/

/-- Actual degree-zero cohomology of the concrete X block. -/
noncomputable abbrev RXH0 (P : TannerSquarePresentation) (x : P.X)
    (S : OddScale) :=
  LinearMap.ker (wordLinearMapTranspose (rxCx P x S).boundary1)

/-- Evaluation of an X-block zero cocycle at the explicit copy-zero boundary
root. -/
def rxCxH0Coordinate (P : TannerSquarePresentation)
    (A : TannerSquareAdmissible P) (x : P.X) (S : OddScale) :
    RXH0 P x S →ₗ[Field] Field where
  toFun := fun word => word.1
    (0, (subdivisionOriginalBoundaryVertex P x S (A.xBoundaryRoot x)).1)
  map_add' := by intros; rfl
  map_smul' := by intros; rfl

/-- F04 `H⁰(Cx)=F₂` as a named bijective coordinate map. -/
theorem rxCxH0Coordinate_bijective (P : TannerSquarePresentation)
    (A : TannerSquareAdmissible P) (x : P.X) (S : OddScale) :
    Function.Bijective (rxCxH0Coordinate P A x S) := by
  classical
  constructor
  · intro first second hcoordinate
    apply Subtype.ext
    funext vertex
    rw [rxCxCocycle_eq_boundaryRoot_zeroCopy P A x S first.1 first.2 vertex,
      rxCxCocycle_eq_boundaryRoot_zeroCopy P A x S second.1 second.2 vertex]
    exact hcoordinate
  · intro value
    let constant : Word Field (DoubleCylinderVertex P x S) := fun _ => value
    have hgraph : wordLinearMapTranspose
        (graphBoundary (tannerDoubleCylinderEdgeStart P x S)
          (tannerDoubleCylinderEdgeEnd P x S)) constant = 0 := by
      ext edge
      rw [wordLinearMapTranspose_graphBoundary_apply]
      change value + value = 0
      exact ZModModule.add_self value
    have hkernel :
        wordLinearMapTranspose (rxCx P x S).boundary1 constant = 0 := by
      change wordLinearMapTranspose (doubleCylinderBoundary1 P x S) constant = 0
      rw [← doubleCylinderGraphBoundary_eq_boundary1]
      exact hgraph
    exact ⟨⟨constant, hkernel⟩, rfl⟩

/-! ## Named F06 X-block degree-one coordinate -/

/-- Actual degree-one cohomology of the concrete X block. -/
noncomputable abbrev RXH1 (P : TannerSquarePresentation) (x : P.X)
    (S : OddScale) :=
  (rxCx P x S).middleCohomology

/-- The zero coordinate on the X-block degree-one cohomology quotient. -/
noncomputable def rxCxH1Coordinate (P : TannerSquarePresentation)
    (x : P.X) (S : OddScale) :
    RXH1 P x S →ₗ[Field] Word Field (Fin 0) := 0

private theorem rxSum_mul_indicator {Index : Type} [Fintype Index]
    [DecidableEq Index] (word : Index → Field) (target : Index) :
    (∑ index : Index, word index * if index = target then 1 else 0) =
      word target := by
  simp

private theorem rxSum_product_fst_indicator {Tag Index : Type}
    [Fintype Tag] [DecidableEq Tag] [Fintype Index]
    (word : Tag × Index → Field) (tag : Tag) (coefficient : Index → Field) :
    (∑ pair : Tag × Index,
        word pair * if pair.1 = tag then coefficient pair.2 else 0) =
      ∑ index : Index, word (tag, index) * coefficient index := by
  classical
  simp [Fintype.sum_prod_type, mul_ite]

private theorem rxSum_mul_four_indicators {Index : Type} [Fintype Index]
    [DecidableEq Index] (word : Index → Field) (first second third fourth : Index) :
    (∑ index : Index, word index *
      ((((if index = first then 1 else 0) +
          (if index = second then 1 else 0)) +
        (if index = third then 1 else 0)) +
        (if index = fourth then 1 else 0))) =
      word first + word second + word third + word fourth := by
  simp only [mul_add, Finset.sum_add_distrib, rxSum_mul_indicator]

private theorem rxSum_mul_two_indicators {Index : Type} [Fintype Index]
    [DecidableEq Index] (word : Index → Field) (first second : Index) :
    (∑ index : Index, word index *
      ((if index = first then 1 else 0) +
        (if index = second then 1 else 0))) =
      word first + word second := by
  simp only [mul_add, Finset.sum_add_distrib, rxSum_mul_indicator]

/-- A degree-one cocycle sums to zero around every explicit small square in
either end copy of the double cylinder. -/
private theorem rxCxH1_smallSquare_sum_eq_zero
    (P : TannerSquarePresentation) (x : P.X) (S : OddScale)
    (word : Word Field (DoubleCylinderEdge P x S))
    (hword : wordLinearMapTranspose (rxCx P x S).boundary2 word = 0)
    (copy : Two) (face : SubdivisionFace P x S) :
    word (Sum.inl (copy, subdivisionFaceBoundaryEdge P x S face (0, 0))) +
        word (Sum.inl (copy, subdivisionFaceBoundaryEdge P x S face (1, 1))) +
        word (Sum.inl (copy, subdivisionFaceBoundaryEdge P x S face (0, 1))) +
        word (Sum.inl (copy, subdivisionFaceBoundaryEdge P x S face (1, 0))) =
      0 := by
  classical
  have hface := congrFun hword (Sum.inl (copy, face))
  change wordLinearMapTranspose
      (Matrix.toLin' (doubleCylinderFaceEdgeMatrix P x S)) word
        (Sum.inl (copy, face)) = 0 at hface
  rw [wordLinearMapTranspose_toLin'_apply] at hface
  rw [Fintype.sum_sum_type] at hface
  simp only [doubleCylinderFaceEdgeMatrix, mul_zero,
    Finset.sum_const_zero, add_zero] at hface
  have hproduct :
      (∑ pair : Two × SubdivisionEdge P x S,
        word (Sum.inl pair) * if pair.1 = copy then
          subdivisionFaceEdgeMatrix P x S pair.2 face else 0) =
        ∑ edge : SubdivisionEdge P x S,
          word (Sum.inl (copy, edge)) *
            subdivisionFaceEdgeMatrix P x S edge face := by
    exact rxSum_product_fst_indicator
      (fun pair : Two × SubdivisionEdge P x S => word (Sum.inl pair)) copy
      (fun edge => subdivisionFaceEdgeMatrix P x S edge face)
  have hfour := rxSum_mul_four_indicators
    (fun edge : SubdivisionEdge P x S => word (Sum.inl (copy, edge)))
    (subdivisionFaceBoundaryEdge P x S face (0, 0))
    (subdivisionFaceBoundaryEdge P x S face (1, 1))
    (subdivisionFaceBoundaryEdge P x S face (0, 1))
    (subdivisionFaceBoundaryEdge P x S face (1, 0))
  rw [← hfour]
  change (∑ edge : SubdivisionEdge P x S,
      word (Sum.inl (copy, edge)) *
        subdivisionFaceEdgeMatrix P x S edge face) = 0
  rw [← hproduct]
  exact hface

/-- The coboundary of any explicit subdivision potential also sums to zero
around each small square.  This is the local algebraic transport used to move
the bottom-row path integral through successive grid rows. -/
private theorem rxCxH1_potential_smallSquare_sum_eq_zero
    (P : TannerSquarePresentation) (x : P.X) (S : OddScale)
    (potential : Word Field (SubdivisionVertex P x S))
    (face : SubdivisionFace P x S) :
    let value := fun edge : SubdivisionEdge P x S =>
      potential (subdivisionEdgeStart P x S edge) +
        potential (subdivisionEdgeEnd P x S edge)
    value (subdivisionFaceBoundaryEdge P x S face (0, 0)) +
        value (subdivisionFaceBoundaryEdge P x S face (1, 1)) +
      value (subdivisionFaceBoundaryEdge P x S face (0, 1)) +
        value (subdivisionFaceBoundaryEdge P x S face (1, 0)) = 0 := by
  classical
  dsimp only
  let coboundary := wordLinearMapTranspose
    (subdivisionBoundary1 P x S) potential
  have hedge (edge : SubdivisionEdge P x S) :
      coboundary edge =
        potential (subdivisionEdgeStart P x S edge) +
          potential (subdivisionEdgeEnd P x S edge) := by
    rw [show coboundary edge = wordLinearMapTranspose
      (subdivisionBoundary1 P x S) potential edge from rfl]
    rw [subdivisionBoundary1, wordLinearMapTranspose_toLin'_apply]
    change (∑ vertex : SubdivisionVertex P x S,
      potential vertex *
        ((if vertex = subdivisionEdgeStart P x S edge then 1 else 0) +
          (if vertex = subdivisionEdgeEnd P x S edge then 1 else 0))) = _
    exact rxSum_mul_two_indicators potential
      (subdivisionEdgeStart P x S edge)
      (subdivisionEdgeEnd P x S edge)
  have hsquared := congrArg (fun map => map potential)
    (subdivisionCoboundary_squared P x S)
  have hface := congrFun hsquared face
  simp only [LinearMap.comp_apply, LinearMap.zero_apply, Pi.zero_apply] at hface
  change wordLinearMapTranspose (subdivisionBoundary2 P x S)
      coboundary face = 0 at hface
  rw [subdivisionBoundary2, wordLinearMapTranspose_toLin'_apply] at hface
  have hfour := rxSum_mul_four_indicators coboundary
    (subdivisionFaceBoundaryEdge P x S face (0, 0))
    (subdivisionFaceBoundaryEdge P x S face (1, 1))
    (subdivisionFaceBoundaryEdge P x S face (0, 1))
    (subdivisionFaceBoundaryEdge P x S face (1, 0))
  rw [← hedge (subdivisionFaceBoundaryEdge P x S face (0, 0)),
    ← hedge (subdivisionFaceBoundaryEdge P x S face (1, 1)),
    ← hedge (subdivisionFaceBoundaryEdge P x S face (0, 1)),
    ← hedge (subdivisionFaceBoundaryEdge P x S face (1, 0))]
  rw [← hfour]
  change (∑ edge : SubdivisionEdge P x S,
    coboundary edge * subdivisionFaceEdgeMatrix P x S edge face) = 0
  exact hface

/-- If the potential already realizes three sides of a small square, the
cocycle equation transports the realization to the opposite horizontal side.
This is the row-to-row induction step; it neither selects a path nor consumes
regularity. -/
private theorem rxCxH1_smallSquare_curl_transport
    (P : TannerSquarePresentation) (x : P.X) (S : OddScale)
    (word : Word Field (DoubleCylinderEdge P x S))
    (hword : wordLinearMapTranspose (rxCx P x S).boundary2 word = 0)
    (copy : Two) (potential : Word Field (SubdivisionVertex P x S))
    (face : SubdivisionFace P x S)
    (hbottom :
      potential (subdivisionEdgeStart P x S
          (subdivisionFaceBoundaryEdge P x S face (0, 0))) +
        potential (subdivisionEdgeEnd P x S
          (subdivisionFaceBoundaryEdge P x S face (0, 0))) =
        word (Sum.inl (copy,
          subdivisionFaceBoundaryEdge P x S face (0, 0))))
    (hright :
      potential (subdivisionEdgeStart P x S
          (subdivisionFaceBoundaryEdge P x S face (1, 1))) +
        potential (subdivisionEdgeEnd P x S
          (subdivisionFaceBoundaryEdge P x S face (1, 1))) =
        word (Sum.inl (copy,
          subdivisionFaceBoundaryEdge P x S face (1, 1))))
    (hleft :
      potential (subdivisionEdgeStart P x S
          (subdivisionFaceBoundaryEdge P x S face (1, 0))) +
        potential (subdivisionEdgeEnd P x S
          (subdivisionFaceBoundaryEdge P x S face (1, 0))) =
        word (Sum.inl (copy,
          subdivisionFaceBoundaryEdge P x S face (1, 0)))) :
    potential (subdivisionEdgeStart P x S
        (subdivisionFaceBoundaryEdge P x S face (0, 1))) +
      potential (subdivisionEdgeEnd P x S
        (subdivisionFaceBoundaryEdge P x S face (0, 1))) =
      word (Sum.inl (copy,
        subdivisionFaceBoundaryEdge P x S face (0, 1))) := by
  have hpotential := rxCxH1_potential_smallSquare_sum_eq_zero
    P x S potential face
  have hcocycle := rxCxH1_smallSquare_sum_eq_zero
    P x S word hword copy face
  dsimp only at hpotential
  rw [hbottom, hright, hleft] at hpotential
  linear_combination hpotential - hcocycle

/-- The same local curl identity can solve the right vertical side when the
bottom, top, and left sides are already realized. -/
private theorem rxCxH1_smallSquare_curl_transport_right
    (P : TannerSquarePresentation) (x : P.X) (S : OddScale)
    (word : Word Field (DoubleCylinderEdge P x S))
    (hword : wordLinearMapTranspose (rxCx P x S).boundary2 word = 0)
    (copy : Two) (potential : Word Field (SubdivisionVertex P x S))
    (face : SubdivisionFace P x S)
    (hbottom :
      potential (subdivisionEdgeStart P x S
          (subdivisionFaceBoundaryEdge P x S face (0, 0))) +
        potential (subdivisionEdgeEnd P x S
          (subdivisionFaceBoundaryEdge P x S face (0, 0))) =
        word (Sum.inl (copy,
          subdivisionFaceBoundaryEdge P x S face (0, 0))))
    (htop :
      potential (subdivisionEdgeStart P x S
          (subdivisionFaceBoundaryEdge P x S face (0, 1))) +
        potential (subdivisionEdgeEnd P x S
          (subdivisionFaceBoundaryEdge P x S face (0, 1))) =
        word (Sum.inl (copy,
          subdivisionFaceBoundaryEdge P x S face (0, 1))))
    (hleft :
      potential (subdivisionEdgeStart P x S
          (subdivisionFaceBoundaryEdge P x S face (1, 0))) +
        potential (subdivisionEdgeEnd P x S
          (subdivisionFaceBoundaryEdge P x S face (1, 0))) =
        word (Sum.inl (copy,
          subdivisionFaceBoundaryEdge P x S face (1, 0)))) :
    potential (subdivisionEdgeStart P x S
        (subdivisionFaceBoundaryEdge P x S face (1, 1))) +
      potential (subdivisionEdgeEnd P x S
        (subdivisionFaceBoundaryEdge P x S face (1, 1))) =
      word (Sum.inl (copy,
        subdivisionFaceBoundaryEdge P x S face (1, 1))) := by
  have hpotential := rxCxH1_potential_smallSquare_sum_eq_zero
    P x S potential face
  have hcocycle := rxCxH1_smallSquare_sum_eq_zero
    P x S word hword copy face
  dsimp only at hpotential
  rw [hbottom, htop, hleft] at hpotential
  linear_combination hpotential - hcocycle

/-- A degree-one cocycle sums to zero around every explicit boundary
rectangle joining the two end copies. -/
private theorem rxCxH1_rectangle_sum_eq_zero
    (P : TannerSquarePresentation) (x : P.X) (S : OddScale)
    (word : Word Field (DoubleCylinderEdge P x S))
    (hword : wordLinearMapTranspose (rxCx P x S).boundary2 word = 0)
    (rectangle : SubdivisionBoundaryEdge P x S) :
    word (doubleCylinderRectangleBoundaryEdge P x S rectangle (0, 0)) +
        word (doubleCylinderRectangleBoundaryEdge P x S rectangle (0, 1)) +
        word (doubleCylinderRectangleBoundaryEdge P x S rectangle (1, 0)) +
        word (doubleCylinderRectangleBoundaryEdge P x S rectangle (1, 1)) =
      0 := by
  classical
  have hface := congrFun hword (Sum.inr rectangle)
  change wordLinearMapTranspose
      (Matrix.toLin' (doubleCylinderFaceEdgeMatrix P x S)) word
        (Sum.inr rectangle) = 0 at hface
  rw [wordLinearMapTranspose_toLin'_apply] at hface
  rw [Fintype.sum_sum_type] at hface
  simp only [doubleCylinderFaceEdgeMatrix] at hface
  rw [Fintype.sum_prod_type, Fin.sum_univ_two] at hface
  simp only [if_true, mul_one] at hface
  simp only [rxSum_mul_indicator] at hface
  have hvertical := rxSum_mul_two_indicators
    (fun vertex : SubdivisionBoundaryVertex P x S => word (Sum.inr vertex))
    (subdivisionBoundaryEdgeStart P x S rectangle)
    (subdivisionBoundaryEdgeEnd P x S rectangle)
  simp only [
    doubleCylinderRectangleBoundaryEdge_zero,
    doubleCylinderRectangleBoundaryEdge_one_zero,
    doubleCylinderRectangleBoundaryEdge_one_one]
  rw [add_assoc]
  rw [← hvertical]
  convert hface using 1
  congr 1
  apply Finset.sum_congr rfl
  intro vertex _
  by_cases hstart : vertex = subdivisionBoundaryEdgeStart P x S rectangle <;>
    by_cases hend : vertex = subdivisionBoundaryEdgeEnd P x S rectangle <;>
    simp [hstart, hend]

/-! ### Explicit path-integral potential -/

/-- Integral along the first `step` segments of one oriented original
X-star edge.  The bound is proof-only; no path or preimage is selected. -/
private def rxCxH1_segmentPrefix
    (P : TannerSquarePresentation) (x : P.X) (S : OddScale)
    (word : Word Field (DoubleCylinderEdge P x S)) (copy : Two)
    (edge : XStarEdge P x) :
    (step : Nat) → step ≤ S.half → Field
  | 0, _ => 0
  | step + 1, hstep =>
      rxCxH1_segmentPrefix P x S word copy edge step (by omega) +
        word (Sum.inl (copy, Sum.inl (edge, ⟨step, by omega⟩)))

/-- Integral along a bottom-row horizontal grid prefix of one old face. -/
private def rxCxH1_horizontalPrefix
    (P : TannerSquarePresentation) (x : P.X) (S : OddScale)
    (word : Word Field (DoubleCylinderEdge P x S)) (copy : Two)
    (face : XStarFace P x) :
    (step : Nat) → step ≤ S.half → Field
  | 0, _ => 0
  | step + 1, hstep =>
      rxCxH1_horizontalPrefix P x S word copy face step (by omega) +
        word (Sum.inl (copy, subdivisionHorizontalEdge P x S face
          ⟨step, by omega⟩ 0))

/-- Integral along a vertical grid prefix at one fixed horizontal index. -/
private def rxCxH1_verticalPrefix
    (P : TannerSquarePresentation) (x : P.X) (S : OddScale)
    (word : Word Field (DoubleCylinderEdge P x S)) (copy : Two)
    (face : XStarFace P x) (horizontal : Fin (S.half + 1)) :
    (step : Nat) → step ≤ S.half → Field
  | 0, _ => 0
  | step + 1, hstep =>
      rxCxH1_verticalPrefix P x S word copy face horizontal step (by omega) +
        word (Sum.inl (copy, subdivisionVerticalEdge P x S face horizontal
          ⟨step, by omega⟩))

/-- A retained old-Q vertex certifies the fixed raw X-Q incidence `(x,q)`.
The face witness is eliminated only in this proposition. -/
private theorem rxCxH1_qIncidence
    (P : TannerSquarePresentation) (x : P.X) (q : P.Q)
    (member : xStarVertexMember P x (Vertex.q q) = true) :
    P.xq x q = true := by
  change decide (∃ face : P.Face,
    xStarFaceMember P x face = true ∧
      (q = P.faceQ face 0 ∨ q = P.faceQ face 1)) = true at member
  obtain ⟨face, hface, hcorner⟩ := of_decide_eq_true member
  have hx : P.faceX face = x := by
    simpa [xStarFaceMember] using hface
  rcases hcorner with hcorner | hcorner
  · simpa [hx, hcorner] using P.data.faceQ_xq face 0
  · simpa [hx, hcorner] using P.data.faceQ_xq face 1

/-- The fixed raw X-Q incidence of an old-Q vertex belongs to its X-star.
Again the old face witness is consumed only in `Prop`. -/
private theorem rxCxH1_qRadialMember
    (P : TannerSquarePresentation) (x : P.X) (q : P.Q)
    (member : xStarVertexMember P x (Vertex.q q) = true) :
    xStarEdgeMember P x
      (Sum.inl (⟨(x, q), rxCxH1_qIncidence P x q member⟩ : XQEdge P)) =
        true := by
  change decide (∃ rawFace : P.Face,
    xStarFaceMember P x rawFace = true ∧
      (q = P.faceQ rawFace 0 ∨ q = P.faceQ rawFace 1)) = true at member
  obtain ⟨rawFace, hface, hcorner⟩ := of_decide_eq_true member
  let face : XStarFace P x := ⟨rawFace, hface⟩
  have hx : P.faceX rawFace = x := by
    simpa [xStarFaceMember] using hface
  rcases hcorner with hcorner | hcorner
  · have hedge :
        (⟨(x, q), rxCxH1_qIncidence P x q member⟩ : XQEdge P) =
          faceXQEdge P rawFace 0 := by
      apply Subtype.ext
      change (x, q) = (P.faceX rawFace, P.faceQ rawFace 0)
      simp [hx, hcorner]
    rw [hedge]
    exact (xStarFaceXQEdge P x face 0).2
  · have hedge :
        (⟨(x, q), rxCxH1_qIncidence P x q member⟩ : XQEdge P) =
          faceXQEdge P rawFace 1 := by
      apply Subtype.ext
      change (x, q) = (P.faceX rawFace, P.faceQ rawFace 1)
      simp [hx, hcorner]
    rw [hedge]
    exact (xStarFaceXQEdge P x face 1).2

/-- The raw X-Q edge from the star center to a retained old-Q vertex. -/
private def rxCxH1_qRadialEdge
    (P : TannerSquarePresentation) (x : P.X) (q : P.Q)
    (member : xStarVertexMember P x (Vertex.q q) = true) :
    XStarEdge P x :=
  ⟨Sum.inl
      (⟨(x, q), rxCxH1_qIncidence P x q member⟩ : XQEdge P),
    rxCxH1_qRadialMember P x q member⟩

/-- The Q endpoint of any typed Q-Z edge in an X-star is an old vertex of
that star.  Face witnesses remain confined to this proposition. -/
private theorem rxCxH1_qMember_of_qzMember
    (P : TannerSquarePresentation) (x : P.X) (edge : QZEdge P)
    (member : xStarEdgeMember P x (Sum.inr edge) = true) :
    xStarVertexMember P x (Vertex.q edge.1.1) = true := by
  let starEdge : XStarEdge P x := ⟨Sum.inr edge, member⟩
  have startMember := (xStarEdgeStart P x starEdge).2
  change xStarVertexMember P x (Vertex.q edge.1.1) = true at startMember
  exact startMember

/-- Potential of an old Q vertex, obtained by integrating its fixed radial
edge from the old X center. -/
private def rxCxH1_qPotential
    (P : TannerSquarePresentation) (x : P.X) (S : OddScale)
    (word : Word Field (DoubleCylinderEdge P x S)) (copy : Two)
    (q : P.Q) (member : xStarVertexMember P x (Vertex.q q) = true) : Field :=
  rxCxH1_segmentPrefix P x S word copy
    (rxCxH1_qRadialEdge P x q member) S.half (le_refl S.half)

/-- The path integral stored by a selected old-Z boundary owner depends only
on its typed boundary edge; the endpoint witness remains outside the data
used by the potential. -/
private def rxCxH1_oldZOwnerPotential
    (P : TannerSquarePresentation) (x : P.X) (S : OddScale)
    (word : Word Field (DoubleCylinderEdge P x S)) (copy : Two)
    (ownerEdge : XStarBoundaryEdge P x) : Field := by
  rcases ownerEdge with ⟨rawEdge, edgeMember⟩
  rcases rawEdge with impossible | qzEdge
  · simp [xStarBoundaryEdgeMember] at edgeMember
  · have starMember : xStarEdgeMember P x (Sum.inr qzEdge) = true :=
      edgeMember
    have qMember : xStarVertexMember P x (Vertex.q qzEdge.1.1) = true :=
      rxCxH1_qMember_of_qzMember P x qzEdge starMember
    let starEdge : XStarEdge P x :=
      ⟨Sum.inr qzEdge, starMember⟩
    exact rxCxH1_qPotential P x S word copy qzEdge.1.1 qMember +
      rxCxH1_segmentPrefix P x S word copy starEdge S.half
        (le_refl S.half)

/-- Potential on original X-star vertices.  At an old Z vertex the input V2
endpoint owner supplies one concrete Q-Z boundary edge; its Q endpoint and
the complete edge integral determine the value. -/
private noncomputable def rxCxH1_oldVertexPotential
    (P : TannerSquarePresentation) (A3 : TannerSquareAdmissibleV3 P)
    (x : P.X) (S : OddScale)
    (word : Word Field (DoubleCylinderEdge P x S)) (copy : Two)
    (vertex : XStarVertex P x) : Field := by
  rcases vertex with ⟨rawVertex, member⟩
  rcases rawVertex with oldX | oldQ | oldZ
  · exact 0
  · exact rxCxH1_qPotential P x S word copy oldQ member
  · let boundaryVertex : XStarBoundaryVertex P x :=
      ⟨Vertex.z oldZ, member⟩
    let owner := A3.toTannerSquareAdmissibleV2.xBoundaryIncidentEdge
      x boundaryVertex
    exact rxCxH1_oldZOwnerPotential P x S word copy owner.1.1

/-- Explicit potential on every vertex of one subdivided X-star copy. -/
private noncomputable def rxCxH1_subdivisionPotential
    (P : TannerSquarePresentation) (A3 : TannerSquareAdmissibleV3 P)
    (x : P.X) (S : OddScale)
    (word : Word Field (DoubleCylinderEdge P x S)) (copy : Two)
    (vertex : SubdivisionVertex P x S) : Field := by
  rcases vertex with oldVertex | edgeInterior | faceInterior
  · exact rxCxH1_oldVertexPotential P A3 x S word copy oldVertex
  · rcases edgeInterior with ⟨edge, index⟩
    exact rxCxH1_oldVertexPotential P A3 x S word copy
        (xStarEdgeStart P x edge) +
      rxCxH1_segmentPrefix P x S word copy edge (index.1 + 1) (by
        have := index.2
        omega)
  · rcases faceInterior with ⟨face, i, j⟩
    let horizontal : Fin (S.half + 1) := ⟨i.1 + 1, by
      have := i.2
      have := S.half_pos
      omega⟩
    exact rxCxH1_horizontalPrefix P x S word copy face (i.1 + 1) (by
        have := i.2
        omega) +
      rxCxH1_verticalPrefix P x S word copy face horizontal (j.1 + 1) (by
        have := j.2
        omega)

/-- Binary cancellation in the exact form used by successive path-integral
potentials. -/
private theorem rxCxH1_cancel_successive (base accumulated edgeValue : Field) :
    (base + accumulated) + (base + (accumulated + edgeValue)) = edgeValue := by
  rw [show (base + accumulated) + (base + (accumulated + edgeValue)) =
      (base + base) + (accumulated + accumulated) + edgeValue by abel]
  rw [ZModModule.add_self, ZModModule.add_self]
  simp

/-- Every nonterminal segment of an original star edge is the coboundary of
the explicit subdivision potential.  Terminal segments are deferred because
their old-Q/old-Z endpoint equations carry the actual A3/R content. -/
private theorem rxCxH1_segmentInterior_equation
    (P : TannerSquarePresentation) (A3 : TannerSquareAdmissibleV3 P)
    (x : P.X) (S : OddScale)
    (word : Word Field (DoubleCylinderEdge P x S)) (copy : Two)
    (edge : XStarEdge P x) (segment : Fin S.half)
    (hinterior : segment.1 + 1 < S.half) :
    rxCxH1_subdivisionPotential P A3 x S word copy
        (subdivisionSegmentStart P x S edge segment) +
      rxCxH1_subdivisionPotential P A3 x S word copy
        (subdivisionSegmentEnd P x S edge segment) =
      word (Sum.inl (copy, Sum.inl (edge, segment))) := by
  rcases segment with ⟨segment, hsegment⟩
  rcases segment with _ | segment
  · change 1 < S.half at hinterior
    have hnotlast : 1 ≠ S.half := by omega
    simp only [subdivisionSegmentStart, subdivisionSegmentEnd,
      dif_neg hnotlast, rxCxH1_subdivisionPotential,
      rxCxH1_segmentPrefix]
    change rxCxH1_oldVertexPotential P A3 x S word copy
          (xStarEdgeStart P x edge) +
        (rxCxH1_oldVertexPotential P A3 x S word copy
            (xStarEdgeStart P x edge) +
          (0 + word (Sum.inl (copy, Sum.inl (edge, ⟨0, hsegment⟩))))) =
      word (Sum.inl (copy, Sum.inl (edge, ⟨0, hsegment⟩)))
    simpa using rxCxH1_cancel_successive
      (rxCxH1_oldVertexPotential P A3 x S word copy
        (xStarEdgeStart P x edge)) 0
      (word (Sum.inl (copy, Sum.inl (edge, ⟨0, hsegment⟩))))
  · change segment + 2 < S.half at hinterior
    have hnotlast : segment + 2 ≠ S.half := by omega
    have hnotzero : segment + 1 ≠ 0 := by omega
    simp only [subdivisionSegmentStart, subdivisionSegmentEnd,
      dif_neg hnotzero, dif_neg hnotlast, rxCxH1_subdivisionPotential]
    change
      (rxCxH1_oldVertexPotential P A3 x S word copy
          (xStarEdgeStart P x edge) +
        rxCxH1_segmentPrefix P x S word copy edge (segment + 1) (by omega)) +
      (rxCxH1_oldVertexPotential P A3 x S word copy
          (xStarEdgeStart P x edge) +
        (rxCxH1_segmentPrefix P x S word copy edge (segment + 1) (by omega) +
          word (Sum.inl (copy, Sum.inl (edge, ⟨segment + 1, hsegment⟩))))) =
      word (Sum.inl (copy, Sum.inl (edge, ⟨segment + 1, hsegment⟩)))
    exact rxCxH1_cancel_successive
      (rxCxH1_oldVertexPotential P A3 x S word copy
        (xStarEdgeStart P x edge))
      (rxCxH1_segmentPrefix P x S word copy edge (segment + 1) (by omega))
      (word (Sum.inl (copy, Sum.inl (edge, ⟨segment + 1, hsegment⟩))))

/-- The bottom grid row is definitionally the ordered X-Q radial edge at
corner zero, including every finite prefix. -/
private theorem rxCxH1_horizontalPrefix_eq_xqZero
    (P : TannerSquarePresentation) (x : P.X) (S : OddScale)
    (word : Word Field (DoubleCylinderEdge P x S)) (copy : Two)
    (face : XStarFace P x) :
    (step : Nat) → (hstep : step ≤ S.half) →
      rxCxH1_horizontalPrefix P x S word copy face step hstep =
        rxCxH1_segmentPrefix P x S word copy
          (xStarFaceXQEdge P x face 0) step hstep
  | 0, _ => rfl
  | step + 1, hstep => by
      rw [rxCxH1_horizontalPrefix, rxCxH1_segmentPrefix,
        rxCxH1_horizontalPrefix_eq_xqZero P x S word copy face step]
      congr 3

/-- The left grid column is definitionally the ordered X-Q radial edge at
corner one, including every finite prefix. -/
private theorem rxCxH1_verticalPrefix_eq_xqOne
    (P : TannerSquarePresentation) (x : P.X) (S : OddScale)
    (word : Word Field (DoubleCylinderEdge P x S)) (copy : Two)
    (face : XStarFace P x) :
    (step : Nat) → (hstep : step ≤ S.half) →
      rxCxH1_verticalPrefix P x S word copy face 0 step hstep =
        rxCxH1_segmentPrefix P x S word copy
          (xStarFaceXQEdge P x face 1) step hstep
  | 0, _ => rfl
  | step + 1, hstep => by
      rw [rxCxH1_verticalPrefix, rxCxH1_segmentPrefix,
        rxCxH1_verticalPrefix_eq_xqOne P x S word copy face step]
      congr 3

/-- The right grid column is definitionally the ordered Q-Z boundary edge at
corner zero, including every finite prefix. -/
private theorem rxCxH1_verticalPrefix_eq_qzZero
    (P : TannerSquarePresentation) (x : P.X) (S : OddScale)
    (word : Word Field (DoubleCylinderEdge P x S)) (copy : Two)
    (face : XStarFace P x) :
    (step : Nat) → (hstep : step ≤ S.half) →
      rxCxH1_verticalPrefix P x S word copy face
          ⟨S.half, by omega⟩ step hstep =
        rxCxH1_segmentPrefix P x S word copy
          (xStarFaceQZEdge P x face 0) step hstep
  | 0, _ => rfl
  | step + 1, hstep => by
      have hhalf : S.half ≠ 0 := S.half_pos.ne'
      rw [rxCxH1_verticalPrefix, rxCxH1_segmentPrefix,
        rxCxH1_verticalPrefix_eq_qzZero P x S word copy face step]
      congr 3
      simp [subdivisionVerticalEdge, hhalf]

/-- Every strictly interior vertical grid segment is the coboundary of the
explicit face-interior potential.  Bottom and top boundary segments are
handled by the boundary-prefix and terminal-edge layers. -/
private theorem rxCxH1_verticalInterior_equation
    (P : TannerSquarePresentation) (A3 : TannerSquareAdmissibleV3 P)
    (x : P.X) (S : OddScale)
    (word : Word Field (DoubleCylinderEdge P x S)) (copy : Two)
    (face : XStarFace P x) (i : Fin (S.half - 1))
    (segment : Fin S.half) (hpositive : 0 < segment.1)
    (hinterior : segment.1 + 1 < S.half) :
    let horizontal : Fin (S.half + 1) := ⟨i.1 + 1, by
      have := i.2
      have := S.half_pos
      omega⟩
    rxCxH1_subdivisionPotential P A3 x S word copy
        (subdivisionEdgeStart P x S
          (subdivisionVerticalEdge P x S face horizontal segment)) +
      rxCxH1_subdivisionPotential P A3 x S word copy
        (subdivisionEdgeEnd P x S
          (subdivisionVerticalEdge P x S face horizontal segment)) =
      word (Sum.inl (copy,
        subdivisionVerticalEdge P x S face horizontal segment)) := by
  dsimp only
  rcases segment with ⟨segment, hsegment⟩
  rcases segment with _ | segment
  · change 0 < 0 at hpositive
    omega
  · change segment + 2 < S.half at hinterior
    have hhorizontalZero : i.1 + 1 ≠ 0 := by omega
    have hhorizontalLast : i.1 + 1 ≠ S.half := by
      have := i.2
      omega
    have hverticalZero : segment + 1 ≠ 0 := by omega
    have hverticalLast : segment + 1 ≠ S.half := by omega
    have hverticalSuccZero : segment + 2 ≠ 0 := by omega
    have hverticalSuccLast : segment + 2 ≠ S.half := by omega
    have hstart :
        subdivisionEdgeStart P x S
            (subdivisionVerticalEdge P x S face
              ⟨i.1 + 1, by have := i.2; have := S.half_pos; omega⟩
              ⟨segment + 1, hsegment⟩) =
          Sum.inr (Sum.inr (face, i,
            (⟨segment, by omega⟩ : Fin (S.half - 1)))) := by
      rw [subdivisionVerticalEdge_start]
      change subdivisionGridVertex P x S face
          ⟨i.1 + 1, by have := i.2; have := S.half_pos; omega⟩
          ⟨segment + 1, by omega⟩ = _
      simp only [subdivisionGridVertex, hhorizontalZero, hhorizontalLast,
        hverticalZero, hverticalLast, ↓reduceDIte]
      constructor <;> apply Fin.ext <;> rfl
    have hend :
        subdivisionEdgeEnd P x S
            (subdivisionVerticalEdge P x S face
              ⟨i.1 + 1, by have := i.2; have := S.half_pos; omega⟩
              ⟨segment + 1, hsegment⟩) =
          Sum.inr (Sum.inr (face, i,
            (⟨segment + 1, by omega⟩ : Fin (S.half - 1)))) := by
      rw [subdivisionVerticalEdge_end]
      change subdivisionGridVertex P x S face
          ⟨i.1 + 1, by have := i.2; have := S.half_pos; omega⟩
          ⟨segment + 2, by omega⟩ = _
      simp only [subdivisionGridVertex, hhorizontalZero, hhorizontalLast,
        hverticalSuccZero, hverticalSuccLast, ↓reduceDIte]
      constructor <;> apply Fin.ext <;> rfl
    rw [hstart, hend]
    simp only [rxCxH1_subdivisionPotential]
    change
      (rxCxH1_horizontalPrefix P x S word copy face (i.1 + 1) (by omega) +
        rxCxH1_verticalPrefix P x S word copy face
          ⟨i.1 + 1, by omega⟩ (segment + 1) (by omega)) +
      (rxCxH1_horizontalPrefix P x S word copy face (i.1 + 1) (by omega) +
        (rxCxH1_verticalPrefix P x S word copy face
            ⟨i.1 + 1, by omega⟩ (segment + 1) (by omega) +
          word (Sum.inl (copy, subdivisionVerticalEdge P x S face
            ⟨i.1 + 1, by omega⟩ ⟨segment + 1, hsegment⟩)))) =
      word (Sum.inl (copy, subdivisionVerticalEdge P x S face
        ⟨i.1 + 1, by omega⟩ ⟨segment + 1, hsegment⟩))
    exact rxCxH1_cancel_successive
      (rxCxH1_horizontalPrefix P x S word copy face (i.1 + 1) (by omega))
      (rxCxH1_verticalPrefix P x S word copy face
        ⟨i.1 + 1, by omega⟩ (segment + 1) (by omega))
      (word (Sum.inl (copy, subdivisionVerticalEdge P x S face
        ⟨i.1 + 1, by omega⟩ ⟨segment + 1, hsegment⟩)))

/-- A nonterminal bottom-row horizontal edge is already covered by the
original-edge path integral. -/
private theorem rxCxH1_horizontalBottom_equation
    (P : TannerSquarePresentation) (A3 : TannerSquareAdmissibleV3 P)
    (x : P.X) (S : OddScale)
    (word : Word Field (DoubleCylinderEdge P x S)) (copy : Two)
    (face : XStarFace P x) (segment : Fin S.half)
    (hnonterminal : segment.1 + 1 < S.half) :
    rxCxH1_subdivisionPotential P A3 x S word copy
        (subdivisionEdgeStart P x S
          (subdivisionHorizontalEdge P x S face segment 0)) +
      rxCxH1_subdivisionPotential P A3 x S word copy
        (subdivisionEdgeEnd P x S
          (subdivisionHorizontalEdge P x S face segment 0)) =
      word (Sum.inl (copy,
        subdivisionHorizontalEdge P x S face segment 0)) := by
  simpa [subdivisionHorizontalEdge, subdivisionEdgeStart, subdivisionEdgeEnd] using
    rxCxH1_segmentInterior_equation P A3 x S word copy
      (xStarFaceXQEdge P x face 0) segment hnonterminal

private theorem rxCxH1_oldVertexPotential_xStarFaceXVertex
    (P : TannerSquarePresentation) (A3 : TannerSquareAdmissibleV3 P)
    (x : P.X) (S : OddScale)
    (word : Word Field (DoubleCylinderEdge P x S)) (copy : Two)
    (face : XStarFace P x) :
    rxCxH1_oldVertexPotential P A3 x S word copy
        (xStarFaceXVertex P x face) = 0 := by
  rfl

/-- The first vertical segment at an interior grid column is realized by the
bottom horizontal prefix followed by one vertical step. -/
private theorem rxCxH1_verticalBottom_equation
    (P : TannerSquarePresentation) (A3 : TannerSquareAdmissibleV3 P)
    (x : P.X) (S : OddScale)
    (word : Word Field (DoubleCylinderEdge P x S)) (copy : Two)
    (face : XStarFace P x) (i : Fin (S.half - 1)) :
    let horizontal : Fin (S.half + 1) := ⟨i.1 + 1, by
      have := i.2
      have := S.half_pos
      omega⟩
    let segment : Fin S.half := ⟨0, by have := i.2; omega⟩
    rxCxH1_subdivisionPotential P A3 x S word copy
        (subdivisionEdgeStart P x S
          (subdivisionVerticalEdge P x S face horizontal segment)) +
      rxCxH1_subdivisionPotential P A3 x S word copy
        (subdivisionEdgeEnd P x S
          (subdivisionVerticalEdge P x S face horizontal segment)) =
      word (Sum.inl (copy,
        subdivisionVerticalEdge P x S face horizontal segment)) := by
  dsimp only
  have hhorizontalZero : i.1 + 1 ≠ 0 := by omega
  have hhorizontalLast : i.1 + 1 ≠ S.half := by
    have := i.2
    omega
  have honeLast : 1 ≠ S.half := by have := i.2; omega
  let zeroIndex : Fin (S.half - 1) := ⟨0, by have := i.2; omega⟩
  have hstart :
      subdivisionEdgeStart P x S
          (subdivisionVerticalEdge P x S face
            ⟨i.1 + 1, by have := i.2; have := S.half_pos; omega⟩
            ⟨0, by have := i.2; omega⟩) =
        Sum.inr (Sum.inl (xStarFaceXQEdge P x face 0, i)) := by
    rw [subdivisionVerticalEdge_start]
    change subdivisionGridVertex P x S face
      ⟨i.1 + 1, by have := i.2; have := S.half_pos; omega⟩ 0 = _
    exact subdivisionGridVertex_edgeInterior_xq0 P x S face i
  have hend :
      subdivisionEdgeEnd P x S
          (subdivisionVerticalEdge P x S face
            ⟨i.1 + 1, by have := i.2; have := S.half_pos; omega⟩
            ⟨0, by have := i.2; omega⟩) =
        Sum.inr (Sum.inr (face, i, zeroIndex)) := by
    rw [subdivisionVerticalEdge_end]
    change subdivisionGridVertex P x S face
      ⟨i.1 + 1, by have := i.2; have := S.half_pos; omega⟩
      ⟨1, by have := i.2; omega⟩ = _
    simp only [subdivisionGridVertex, hhorizontalZero, hhorizontalLast,
      one_ne_zero, honeLast, ↓reduceDIte]
    dsimp only [zeroIndex]
    constructor <;> apply Fin.ext <;> rfl
  rw [hstart, hend]
  simp only [rxCxH1_subdivisionPotential]
  rw [xStarEdgeStart_faceXQEdge]
  rw [rxCxH1_oldVertexPotential_xStarFaceXVertex]
  rw [← rxCxH1_horizontalPrefix_eq_xqZero]
  simp only [zeroIndex, rxCxH1_verticalPrefix]
  simpa using rxCxH1_cancel_successive
    (rxCxH1_horizontalPrefix P x S word copy face
      (i.1 + 1) (by omega)) 0
    (word (Sum.inl (copy, subdivisionVerticalEdge P x S face
      ⟨i.1 + 1, by omega⟩ ⟨0, by omega⟩)))

/-- Curl transport realizes every non-top horizontal edge whose two endpoints
lie at strictly interior grid columns.  The omitted side columns and top row
are precisely the later original-boundary/terminal cases. -/
private theorem rxCxH1_horizontalInterior_equation
    (P : TannerSquarePresentation) (A3 : TannerSquareAdmissibleV3 P)
    (x : P.X) (S : OddScale)
    (word : Word Field (DoubleCylinderEdge P x S))
    (hword : wordLinearMapTranspose (rxCx P x S).boundary2 word = 0)
    (copy : Two) (face : XStarFace P x)
    (segment : Fin S.half) (hleft : 0 < segment.1)
    (hright : segment.1 + 1 < S.half) :
    (row : Nat) → (hrow : row < S.half) →
      rxCxH1_subdivisionPotential P A3 x S word copy
          (subdivisionEdgeStart P x S
            (subdivisionHorizontalEdge P x S face segment
              ⟨row, by omega⟩)) +
        rxCxH1_subdivisionPotential P A3 x S word copy
          (subdivisionEdgeEnd P x S
            (subdivisionHorizontalEdge P x S face segment
              ⟨row, by omega⟩)) =
        word (Sum.inl (copy,
          subdivisionHorizontalEdge P x S face segment
            ⟨row, by omega⟩))
  | 0, hrow => rxCxH1_horizontalBottom_equation
      P A3 x S word copy face segment hright
  | row + 1, hrow => by
      have hrightIndex : segment.1 < S.half - 1 := by omega
      have hleftIndex : segment.1 - 1 < S.half - 1 := by omega
      have hleftSucc : segment.1 - 1 + 1 = segment.1 := by omega
      let cell : SubdivisionFace P x S :=
        (face, segment, ⟨row, by omega⟩)
      let potential : Word Field (SubdivisionVertex P x S) :=
        rxCxH1_subdivisionPotential P A3 x S word copy
      apply rxCxH1_smallSquare_curl_transport
        P x S word hword copy potential cell
      · change
          rxCxH1_subdivisionPotential P A3 x S word copy
              (subdivisionEdgeStart P x S
                (subdivisionHorizontalEdge P x S face segment
                  ⟨row, by omega⟩)) +
            rxCxH1_subdivisionPotential P A3 x S word copy
              (subdivisionEdgeEnd P x S
                (subdivisionHorizontalEdge P x S face segment
                  ⟨row, by omega⟩)) =
            word (Sum.inl (copy,
              subdivisionHorizontalEdge P x S face segment
                ⟨row, by omega⟩))
        exact rxCxH1_horizontalInterior_equation P A3 x S word hword copy
          face segment hleft hright row (by omega)
      · change
          rxCxH1_subdivisionPotential P A3 x S word copy
              (subdivisionEdgeStart P x S
                (subdivisionVerticalEdge P x S face
                  ⟨segment.1 + 1, by omega⟩ ⟨row, by omega⟩)) +
            rxCxH1_subdivisionPotential P A3 x S word copy
              (subdivisionEdgeEnd P x S
                (subdivisionVerticalEdge P x S face
                  ⟨segment.1 + 1, by omega⟩ ⟨row, by omega⟩)) =
            word (Sum.inl (copy, subdivisionVerticalEdge P x S face
              ⟨segment.1 + 1, by omega⟩ ⟨row, by omega⟩))
        have hrowSuccessor : row + 1 < S.half := hrow
        rcases row with _ | row
        · exact rxCxH1_verticalBottom_equation P A3 x S word copy face
            ⟨segment.1, hrightIndex⟩
        · change row + 2 < S.half at hrowSuccessor
          have hrowFin : row + 1 < S.half :=
            Nat.lt_trans (Nat.lt_succ_self (row + 1)) hrowSuccessor
          exact rxCxH1_verticalInterior_equation P A3 x S word copy face
            ⟨segment.1, hrightIndex⟩ ⟨row + 1, hrowFin⟩
              (Nat.zero_lt_succ row) hrowSuccessor
      · change
          rxCxH1_subdivisionPotential P A3 x S word copy
              (subdivisionEdgeStart P x S
                (subdivisionVerticalEdge P x S face
                  ⟨segment.1, by omega⟩ ⟨row, by omega⟩)) +
            rxCxH1_subdivisionPotential P A3 x S word copy
              (subdivisionEdgeEnd P x S
                (subdivisionVerticalEdge P x S face
                  ⟨segment.1, by omega⟩ ⟨row, by omega⟩)) =
            word (Sum.inl (copy, subdivisionVerticalEdge P x S face
              ⟨segment.1, by omega⟩ ⟨row, by omega⟩))
        have hrowSuccessor : row + 1 < S.half := hrow
        rcases row with _ | row
        · simpa [hleftSucc] using
            rxCxH1_verticalBottom_equation P A3 x S word copy face
              ⟨segment.1 - 1, hleftIndex⟩
        · change row + 2 < S.half at hrowSuccessor
          have hrowFin : row + 1 < S.half :=
            Nat.lt_trans (Nat.lt_succ_self (row + 1)) hrowSuccessor
          simpa [hleftSucc] using
            rxCxH1_verticalInterior_equation P A3 x S word copy face
              ⟨segment.1 - 1, hleftIndex⟩ ⟨row + 1, hrowFin⟩
                (Nat.zero_lt_succ row) hrowSuccessor

/-- The fixed radial edge used by the old-Q potential is the same typed X-Q
edge supplied by any incident face/corner; only proof fields differ. -/
private theorem rxCxH1_qRadialEdge_faceXQEdge
    (P : TannerSquarePresentation) (x : P.X) (face : XStarFace P x)
    (corner : Two) :
    rxCxH1_qRadialEdge P x (P.faceQ face.1 corner)
        (xStarFaceQVertex P x face corner).2 =
      xStarFaceXQEdge P x face corner := by
  apply Subtype.ext
  change Sum.inl
      (⟨(x, P.faceQ face.1 corner),
        rxCxH1_qIncidence P x (P.faceQ face.1 corner)
          (xStarFaceQVertex P x face corner).2⟩ : XQEdge P) =
    Sum.inl (faceXQEdge P face.1 corner)
  congr 1
  apply Subtype.ext
  have hx : P.faceX face.1 = x := by
    simpa [xStarFaceMember] using face.2
  change (x, P.faceQ face.1 corner) =
    (P.faceX face.1, P.faceQ face.1 corner)
  simp [hx]

/-- At either old-Q corner, the endpoint potential is the complete integral
of that face's X-Q radial edge. -/
private theorem rxCxH1_oldVertexPotential_faceQ
    (P : TannerSquarePresentation) (A3 : TannerSquareAdmissibleV3 P)
    (x : P.X) (S : OddScale)
    (word : Word Field (DoubleCylinderEdge P x S)) (copy : Two)
    (face : XStarFace P x) (corner : Two) :
    rxCxH1_oldVertexPotential P A3 x S word copy
        (xStarFaceQVertex P x face corner) =
      rxCxH1_segmentPrefix P x S word copy
        (xStarFaceXQEdge P x face corner) S.half (le_refl S.half) := by
  change rxCxH1_qPotential P x S word copy (P.faceQ face.1 corner)
      (xStarFaceQVertex P x face corner).2 = _
  dsimp only [rxCxH1_qPotential]
  rw [rxCxH1_qRadialEdge_faceXQEdge]

/-- A terminal X-Q segment reaches the old-Q potential without selecting an
incident face or a path. -/
private theorem rxCxH1_xqTerminal_equation
    (P : TannerSquarePresentation) (A3 : TannerSquareAdmissibleV3 P)
    (x : P.X) (S : OddScale)
    (word : Word Field (DoubleCylinderEdge P x S)) (copy : Two)
    (face : XStarFace P x) (corner : Two)
    (segment : Fin S.half) (hterminal : segment.1 + 1 = S.half) :
    rxCxH1_subdivisionPotential P A3 x S word copy
        (subdivisionSegmentStart P x S
          (xStarFaceXQEdge P x face corner) segment) +
      rxCxH1_subdivisionPotential P A3 x S word copy
        (subdivisionSegmentEnd P x S
          (xStarFaceXQEdge P x face corner) segment) =
      word (Sum.inl (copy, Sum.inl
        (xStarFaceXQEdge P x face corner, segment))) := by
  have hlast : segment.1 + 1 = S.half := hterminal
  rcases segment with ⟨segment, hsegment⟩
  rcases segment with _ | segment
  · change 1 = S.half at hterminal
    have hstart : subdivisionSegmentStart P x S
        (xStarFaceXQEdge P x face corner) ⟨0, hsegment⟩ =
        Sum.inl (xStarEdgeStart P x (xStarFaceXQEdge P x face corner)) := by
      simp [subdivisionSegmentStart]
    have hend : subdivisionSegmentEnd P x S
        (xStarFaceXQEdge P x face corner) ⟨0, hsegment⟩ =
        Sum.inl (xStarEdgeEnd P x (xStarFaceXQEdge P x face corner)) := by
      simp [subdivisionSegmentEnd, hterminal]
    rw [hstart, hend]
    simp only [rxCxH1_subdivisionPotential]
    rw [xStarEdgeStart_faceXQEdge, xStarEdgeEnd_faceXQEdge,
      rxCxH1_oldVertexPotential_xStarFaceXVertex,
      rxCxH1_oldVertexPotential_faceQ]
    have hprefixFull :
        rxCxH1_segmentPrefix P x S word copy
            (xStarFaceXQEdge P x face corner) S.half (le_refl S.half) =
          rxCxH1_segmentPrefix P x S word copy
            (xStarFaceXQEdge P x face corner) 1 (by omega) := by
      congr 1
      exact hterminal.symm
    rw [hprefixFull, rxCxH1_segmentPrefix]
    simp [rxCxH1_segmentPrefix]
  · change segment + 2 = S.half at hterminal
    have hnotzero : segment + 1 ≠ 0 := by omega
    let interior : Fin (S.half - 1) := ⟨segment, by omega⟩
    have hstart : subdivisionSegmentStart P x S
        (xStarFaceXQEdge P x face corner) ⟨segment + 1, hsegment⟩ =
        Sum.inr (Sum.inl
          (xStarFaceXQEdge P x face corner, interior)) := by
      simp [subdivisionSegmentStart, hnotzero, interior]
    have hend : subdivisionSegmentEnd P x S
        (xStarFaceXQEdge P x face corner) ⟨segment + 1, hsegment⟩ =
        Sum.inl (xStarEdgeEnd P x (xStarFaceXQEdge P x face corner)) := by
      simp [subdivisionSegmentEnd, hterminal]
    rw [hstart, hend]
    simp only [rxCxH1_subdivisionPotential]
    rw [xStarEdgeEnd_faceXQEdge, rxCxH1_oldVertexPotential_faceQ]
    rw [xStarEdgeStart_faceXQEdge,
      rxCxH1_oldVertexPotential_xStarFaceXVertex]
    have hprefixFull :
        rxCxH1_segmentPrefix P x S word copy
            (xStarFaceXQEdge P x face corner) S.half (le_refl S.half) =
          rxCxH1_segmentPrefix P x S word copy
            (xStarFaceXQEdge P x face corner) (segment + 2) (by omega) := by
      congr 1
      exact hterminal.symm
    rw [hprefixFull]
    rw (occs := .pos [2]) [rxCxH1_segmentPrefix]
    dsimp only [interior]
    simpa using rxCxH1_cancel_successive
      0
      (rxCxH1_segmentPrefix P x S word copy
        (xStarFaceXQEdge P x face corner) (segment + 1) (by omega))
      (word (Sum.inl (copy, Sum.inl
        (xStarFaceXQEdge P x face corner, ⟨segment + 1, hsegment⟩))))

/-- Every bottom-row segment is realized: nonterminal segments use the
prefix equation, while the final segment reaches the corner-zero old Q. -/
private theorem rxCxH1_horizontalBottom_total_equation
    (P : TannerSquarePresentation) (A3 : TannerSquareAdmissibleV3 P)
    (x : P.X) (S : OddScale)
    (word : Word Field (DoubleCylinderEdge P x S)) (copy : Two)
    (face : XStarFace P x) (segment : Fin S.half) :
    rxCxH1_subdivisionPotential P A3 x S word copy
        (subdivisionEdgeStart P x S
          (subdivisionHorizontalEdge P x S face segment 0)) +
      rxCxH1_subdivisionPotential P A3 x S word copy
        (subdivisionEdgeEnd P x S
          (subdivisionHorizontalEdge P x S face segment 0)) =
      word (Sum.inl (copy,
        subdivisionHorizontalEdge P x S face segment 0)) := by
  by_cases hterminal : segment.1 + 1 = S.half
  · simpa [subdivisionHorizontalEdge, subdivisionEdgeStart, subdivisionEdgeEnd] using
      rxCxH1_xqTerminal_equation P A3 x S word copy face 0
        segment hterminal
  · exact rxCxH1_horizontalBottom_equation P A3 x S word copy face
      segment (by have := segment.2; omega)

/-- Every nonterminal vertical grid segment is realized, including the two
original-edge side columns.  Interior columns reuse the explicit vertical
prefix equations. -/
private theorem rxCxH1_verticalNonterminal_equation
    (P : TannerSquarePresentation) (A3 : TannerSquareAdmissibleV3 P)
    (x : P.X) (S : OddScale)
    (word : Word Field (DoubleCylinderEdge P x S)) (copy : Two)
    (face : XStarFace P x) (horizontal : Fin (S.half + 1))
    (segment : Fin S.half) (hnonterminal : segment.1 + 1 < S.half) :
    rxCxH1_subdivisionPotential P A3 x S word copy
        (subdivisionEdgeStart P x S
          (subdivisionVerticalEdge P x S face horizontal segment)) +
      rxCxH1_subdivisionPotential P A3 x S word copy
        (subdivisionEdgeEnd P x S
          (subdivisionVerticalEdge P x S face horizontal segment)) =
      word (Sum.inl (copy,
        subdivisionVerticalEdge P x S face horizontal segment)) := by
  by_cases hzero : horizontal.1 = 0
  · have horizontalZero : horizontal = 0 := by
      apply Fin.ext
      exact hzero
    subst horizontal
    simpa [subdivisionVerticalEdge, subdivisionEdgeStart, subdivisionEdgeEnd] using
      rxCxH1_segmentInterior_equation P A3 x S word copy
        (xStarFaceXQEdge P x face 1) segment hnonterminal
  · by_cases hlast : horizontal.1 = S.half
    · have horizontalLast : horizontal = ⟨S.half, by omega⟩ := by
        apply Fin.ext
        exact hlast
      have hhalf : S.half ≠ 0 := by omega
      rw [horizontalLast]
      simpa [subdivisionVerticalEdge, hhalf, subdivisionEdgeStart, subdivisionEdgeEnd] using
        rxCxH1_segmentInterior_equation P A3 x S word copy
          (xStarFaceQZEdge P x face 0) segment hnonterminal
    · let interior : Fin (S.half - 1) :=
        ⟨horizontal.1 - 1, by
          have hbound := horizontal.2
          omega⟩
      have hinteriorSucc : interior.1 + 1 = horizontal.1 := by
        dsimp only [interior]
        omega
      rcases segment with ⟨segment, hsegment⟩
      rcases segment with _ | segment
      · simpa [subdivisionVerticalEdge, hzero, hlast, interior,
          hinteriorSucc] using
          rxCxH1_verticalBottom_equation P A3 x S word copy face interior
      · change segment + 2 < S.half at hnonterminal
        have hsegmentFin : segment + 1 < S.half := by omega
        simpa [subdivisionVerticalEdge, hzero, hlast, interior,
            hinteriorSucc] using
          rxCxH1_verticalInterior_equation P A3 x S word copy face interior
            ⟨segment + 1, hsegmentFin⟩ (Nat.zero_lt_succ segment)
            hnonterminal

/-- Curl transport lifts every horizontal segment through all rows strictly
below the top boundary.  The side columns are discharged by the grouped
nonterminal vertical equation, so no terminal owner is consumed here. -/
private theorem rxCxH1_horizontalLower_equation
    (P : TannerSquarePresentation) (A3 : TannerSquareAdmissibleV3 P)
    (x : P.X) (S : OddScale)
    (word : Word Field (DoubleCylinderEdge P x S))
    (hword : wordLinearMapTranspose (rxCx P x S).boundary2 word = 0)
    (copy : Two) (face : XStarFace P x) (segment : Fin S.half) :
    (row : Nat) → (hrow : row < S.half) →
      rxCxH1_subdivisionPotential P A3 x S word copy
          (subdivisionEdgeStart P x S
            (subdivisionHorizontalEdge P x S face segment
              ⟨row, by omega⟩)) +
        rxCxH1_subdivisionPotential P A3 x S word copy
          (subdivisionEdgeEnd P x S
            (subdivisionHorizontalEdge P x S face segment
              ⟨row, by omega⟩)) =
        word (Sum.inl (copy,
          subdivisionHorizontalEdge P x S face segment
            ⟨row, by omega⟩))
  | 0, _ => rxCxH1_horizontalBottom_total_equation
      P A3 x S word copy face segment
  | row + 1, hrow => by
      let cell : SubdivisionFace P x S :=
        (face, segment, ⟨row, by omega⟩)
      let potential : Word Field (SubdivisionVertex P x S) :=
        rxCxH1_subdivisionPotential P A3 x S word copy
      apply rxCxH1_smallSquare_curl_transport
        P x S word hword copy potential cell
      · change
          rxCxH1_subdivisionPotential P A3 x S word copy
              (subdivisionEdgeStart P x S
                (subdivisionHorizontalEdge P x S face segment
                  ⟨row, by omega⟩)) +
            rxCxH1_subdivisionPotential P A3 x S word copy
              (subdivisionEdgeEnd P x S
                (subdivisionHorizontalEdge P x S face segment
                  ⟨row, by omega⟩)) =
            word (Sum.inl (copy,
              subdivisionHorizontalEdge P x S face segment
                ⟨row, by omega⟩))
        exact rxCxH1_horizontalLower_equation P A3 x S word hword copy
          face segment row (by omega)
      · change
          rxCxH1_subdivisionPotential P A3 x S word copy
              (subdivisionEdgeStart P x S
                (subdivisionVerticalEdge P x S face
                  ⟨segment.1 + 1, by omega⟩ ⟨row, by omega⟩)) +
            rxCxH1_subdivisionPotential P A3 x S word copy
              (subdivisionEdgeEnd P x S
                (subdivisionVerticalEdge P x S face
                  ⟨segment.1 + 1, by omega⟩ ⟨row, by omega⟩)) =
            word (Sum.inl (copy, subdivisionVerticalEdge P x S face
              ⟨segment.1 + 1, by omega⟩ ⟨row, by omega⟩))
        exact rxCxH1_verticalNonterminal_equation P A3 x S word copy face
          ⟨segment.1 + 1, by omega⟩ ⟨row, by omega⟩ hrow
      · change
          rxCxH1_subdivisionPotential P A3 x S word copy
              (subdivisionEdgeStart P x S
                (subdivisionVerticalEdge P x S face
                  ⟨segment.1, by omega⟩ ⟨row, by omega⟩)) +
            rxCxH1_subdivisionPotential P A3 x S word copy
              (subdivisionEdgeEnd P x S
                (subdivisionVerticalEdge P x S face
                  ⟨segment.1, by omega⟩ ⟨row, by omega⟩)) =
            word (Sum.inl (copy, subdivisionVerticalEdge P x S face
              ⟨segment.1, by omega⟩ ⟨row, by omega⟩))
        exact rxCxH1_verticalNonterminal_equation P A3 x S word copy face
          ⟨segment.1, by omega⟩ ⟨row, by omega⟩ hrow

/-- Along the top strip, known lower horizontal edges and nonterminal Q-Z
top segments propagate the terminal vertical equation from the left X-Q
boundary through every strictly interior column. -/
private theorem rxCxH1_verticalTerminalInterior_equation
    (P : TannerSquarePresentation) (A3 : TannerSquareAdmissibleV3 P)
    (x : P.X) (S : OddScale)
    (word : Word Field (DoubleCylinderEdge P x S))
    (hword : wordLinearMapTranspose (rxCx P x S).boundary2 word = 0)
    (copy : Two) (face : XStarFace P x) :
    (column : Nat) → (hcolumn : column + 1 < S.half) →
      let terminal : Fin S.half := ⟨S.half - 1, by omega⟩
      let horizontal : Fin (S.half + 1) := ⟨column + 1, by omega⟩
      rxCxH1_subdivisionPotential P A3 x S word copy
          (subdivisionEdgeStart P x S
            (subdivisionVerticalEdge P x S face horizontal terminal)) +
        rxCxH1_subdivisionPotential P A3 x S word copy
          (subdivisionEdgeEnd P x S
            (subdivisionVerticalEdge P x S face horizontal terminal)) =
        word (Sum.inl (copy,
          subdivisionVerticalEdge P x S face horizontal terminal)) := by
  intro column hcolumn
  induction column with
  | zero =>
      dsimp only
      let terminal : Fin S.half := ⟨S.half - 1, by omega⟩
      let cell : SubdivisionFace P x S :=
        (face, ⟨0, by omega⟩, terminal)
      let potential : Word Field (SubdivisionVertex P x S) :=
        rxCxH1_subdivisionPotential P A3 x S word copy
      apply rxCxH1_smallSquare_curl_transport_right
        P x S word hword copy potential cell
      · change
          rxCxH1_subdivisionPotential P A3 x S word copy
              (subdivisionEdgeStart P x S
                (subdivisionHorizontalEdge P x S face ⟨0, by omega⟩
                  ⟨S.half - 1, by omega⟩)) +
            rxCxH1_subdivisionPotential P A3 x S word copy
              (subdivisionEdgeEnd P x S
                (subdivisionHorizontalEdge P x S face ⟨0, by omega⟩
                  ⟨S.half - 1, by omega⟩)) =
            word (Sum.inl (copy, subdivisionHorizontalEdge P x S face
              ⟨0, by omega⟩ ⟨S.half - 1, by omega⟩))
        exact rxCxH1_horizontalLower_equation P A3 x S word hword copy
          face ⟨0, by omega⟩ (S.half - 1) (by omega)
      · have htopEdge :
            subdivisionFaceBoundaryEdge P x S cell (0, 1) =
              subdivisionHorizontalEdge P x S face ⟨0, by omega⟩
                ⟨S.half, by omega⟩ := by
          rw [subdivisionFaceBoundaryEdge_zero_one]
          congr 1
          apply Fin.ext
          rw [finSuccGrid_val]
          dsimp only [cell, terminal]
          omega
        rw [htopEdge]
        dsimp only [potential]
        have hhalf : S.half ≠ 0 := by omega
        simpa [subdivisionHorizontalEdge, hhalf, subdivisionEdgeStart, subdivisionEdgeEnd] using
          rxCxH1_segmentInterior_equation P A3 x S word copy
            (xStarFaceQZEdge P x face 1) ⟨0, by omega⟩ hcolumn
      · change
          rxCxH1_subdivisionPotential P A3 x S word copy
              (subdivisionEdgeStart P x S
                (subdivisionVerticalEdge P x S face 0 terminal)) +
            rxCxH1_subdivisionPotential P A3 x S word copy
              (subdivisionEdgeEnd P x S
                (subdivisionVerticalEdge P x S face 0 terminal)) =
            word (Sum.inl (copy, subdivisionVerticalEdge P x S face 0 terminal))
        simpa [subdivisionVerticalEdge, subdivisionEdgeStart, subdivisionEdgeEnd] using
          rxCxH1_xqTerminal_equation P A3 x S word copy face 1 terminal
            (by dsimp only [terminal]; omega)
  | succ column ih =>
      dsimp only
      let terminal : Fin S.half := ⟨S.half - 1, by omega⟩
      let segment : Fin S.half := ⟨column + 1, by omega⟩
      let cell : SubdivisionFace P x S := (face, segment, terminal)
      let potential : Word Field (SubdivisionVertex P x S) :=
        rxCxH1_subdivisionPotential P A3 x S word copy
      apply rxCxH1_smallSquare_curl_transport_right
        P x S word hword copy potential cell
      · change
          rxCxH1_subdivisionPotential P A3 x S word copy
              (subdivisionEdgeStart P x S
                (subdivisionHorizontalEdge P x S face segment
                  ⟨S.half - 1, by omega⟩)) +
            rxCxH1_subdivisionPotential P A3 x S word copy
              (subdivisionEdgeEnd P x S
                (subdivisionHorizontalEdge P x S face segment
                  ⟨S.half - 1, by omega⟩)) =
            word (Sum.inl (copy, subdivisionHorizontalEdge P x S face
              segment ⟨S.half - 1, by omega⟩))
        exact rxCxH1_horizontalLower_equation P A3 x S word hword copy
          face segment (S.half - 1) (by omega)
      · have htopEdge :
            subdivisionFaceBoundaryEdge P x S cell (0, 1) =
              subdivisionHorizontalEdge P x S face segment
                ⟨S.half, by omega⟩ := by
          rw [subdivisionFaceBoundaryEdge_zero_one]
          congr 1
          apply Fin.ext
          rw [finSuccGrid_val]
          dsimp only [cell, terminal]
          omega
        rw [htopEdge]
        dsimp only [potential]
        have hhalf : S.half ≠ 0 := by omega
        simpa [subdivisionHorizontalEdge, segment, hhalf,
          subdivisionEdgeStart, subdivisionEdgeEnd] using
          rxCxH1_segmentInterior_equation P A3 x S word copy
            (xStarFaceQZEdge P x face 1) segment hcolumn
      · change
          rxCxH1_subdivisionPotential P A3 x S word copy
              (subdivisionEdgeStart P x S
                (subdivisionVerticalEdge P x S face
                  ⟨column + 1, by omega⟩ terminal)) +
            rxCxH1_subdivisionPotential P A3 x S word copy
              (subdivisionEdgeEnd P x S
                (subdivisionVerticalEdge P x S face
                  ⟨column + 1, by omega⟩ terminal)) =
            word (Sum.inl (copy, subdivisionVerticalEdge P x S face
              ⟨column + 1, by omega⟩ terminal))
        exact ih (by omega)

/-- The left side of the top-right small square is terminally realized.  At
scale one it is the original X-Q side; otherwise it is the final interior
column reached by the top-strip sweep. -/
private theorem rxCxH1_topRightLeft_equation
    (P : TannerSquarePresentation) (A3 : TannerSquareAdmissibleV3 P)
    (x : P.X) (S : OddScale)
    (word : Word Field (DoubleCylinderEdge P x S))
    (hword : wordLinearMapTranspose (rxCx P x S).boundary2 word = 0)
    (copy : Two) (face : XStarFace P x) :
    let terminal : Fin S.half := ⟨S.half - 1, by
      have := S.half_pos
      omega⟩
    let horizontal : Fin (S.half + 1) := ⟨S.half - 1, by omega⟩
    rxCxH1_subdivisionPotential P A3 x S word copy
        (subdivisionEdgeStart P x S
          (subdivisionVerticalEdge P x S face horizontal terminal)) +
      rxCxH1_subdivisionPotential P A3 x S word copy
        (subdivisionEdgeEnd P x S
          (subdivisionVerticalEdge P x S face horizontal terminal)) =
      word (Sum.inl (copy,
        subdivisionVerticalEdge P x S face horizontal terminal)) := by
  dsimp only
  let terminal : Fin S.half := ⟨S.half - 1, by
    have := S.half_pos
    omega⟩
  by_cases hone : S.half = 1
  · have horizontalZero :
        (⟨S.half - 1, by omega⟩ : Fin (S.half + 1)) = 0 := by
      apply Fin.ext
      change S.half - 1 = 0
      omega
    rw [horizontalZero]
    simpa [subdivisionVerticalEdge, subdivisionEdgeStart, subdivisionEdgeEnd] using
      rxCxH1_xqTerminal_equation P A3 x S word copy face 1 terminal
        (by dsimp only [terminal]; omega)
  · let column := S.half - 2
    have hcolumn : column + 1 < S.half := by
      dsimp only [column]
      have := S.half_pos
      omega
    have horizontalEq :
        (⟨column + 1, by omega⟩ : Fin (S.half + 1)) =
          ⟨S.half - 1, by omega⟩ := by
      apply Fin.ext
      dsimp only [column]
      omega
    rw [← horizontalEq]
    exact rxCxH1_verticalTerminalInterior_equation
      P A3 x S word hword copy face column hcolumn

/-- The endpoint owner used at an old Z is one of the two ordered Q-Z edges
of any current face with that X/Z pair.  The owner face witness is consumed
only in `Prop`; cellular regularity is used exactly once to identify it with
the current face. -/
private theorem rxCxH1_oldZOwner_edge_cases
    (P : TannerSquarePresentation) (A3 : TannerSquareAdmissibleV3 P)
    (R : TannerSquareCellularRegular P) (x : P.X)
    (face : XStarFace P x) :
    let vertex : XStarBoundaryVertex P x :=
      ⟨Vertex.z (P.faceZ face.1), (xStarFaceZVertex P x face).2⟩
    let owner := A3.toTannerSquareAdmissibleV2.xBoundaryIncidentEdge x vertex
    owner.1.1.1 = xStarFaceQZEdge P x face 0 ∨
      owner.1.1.1 = xStarFaceQZEdge P x face 1 := by
  dsimp only
  let vertex : XStarBoundaryVertex P x :=
    ⟨Vertex.z (P.faceZ face.1), (xStarFaceZVertex P x face).2⟩
  let owner := A3.toTannerSquareAdmissibleV2.xBoundaryIncidentEdge x vertex
  generalize howned : owner.1.1 = selected
  rcases selected with ⟨rawEdge, edgeMember⟩
  rcases rawEdge with impossible | qzEdge
  · simp [xStarBoundaryEdgeMember] at edgeMember
  · have starMember : xStarEdgeMember P x (Sum.inr qzEdge) = true :=
      edgeMember
    change decide (exists candidate : P.Face,
      xStarFaceMember P x candidate = true ∧
        decide (qzEdge = faceQZEdge P candidate 0 ∨
          qzEdge = faceQZEdge P candidate 1) = true) = true at starMember
    obtain ⟨candidate, hcandidate, hedge⟩ := of_decide_eq_true starMember
    have hcandidateX : P.faceX candidate = x := by
      simpa [xStarFaceMember] using hcandidate
    have hendpoint := owner.2
    rw [howned] at hendpoint
    have hqzZ : qzEdge.1.2 = P.faceZ face.1 := by
      have hcases : owner.1.2 = 0 ∨ owner.1.2 = 1 :=
        rxTwoElim (motive := fun endpoint => endpoint = 0 ∨ endpoint = 1)
          (Or.inl rfl) (Or.inr rfl) owner.1.2
      rcases hcases with hzero | hone
      · rw [hzero] at hendpoint
        rw [BDL26TannerLocalRegularity.edgeEndpoint_zero] at hendpoint
        simp only [xBoundaryEdgeStart] at hendpoint
        have hraw := congrArg Subtype.val hendpoint
        dsimp only [vertex] at hraw
        change Vertex.q qzEdge.1.1 = Vertex.z (P.faceZ face.1) at hraw
        cases hraw
      · rw [hone] at hendpoint
        rw [BDL26TannerLocalRegularity.edgeEndpoint_one] at hendpoint
        simp only [xBoundaryEdgeEnd] at hendpoint
        have hraw := congrArg Subtype.val hendpoint
        dsimp only [vertex] at hraw
        exact Vertex.z.inj hraw
    have hcandidateZ : P.faceZ candidate = P.faceZ face.1 := by
      rcases of_decide_eq_true hedge with hedge | hedge
      · have hz := congrArg (fun edge : QZEdge P => edge.1.2) hedge
        exact hz.symm.trans hqzZ
      · have hz := congrArg (fun edge : QZEdge P => edge.1.2) hedge
        exact hz.symm.trans hqzZ
    have hfaceX : P.faceX face.1 = x := by
      simpa [xStarFaceMember] using face.2
    have hcandidateEq : candidate = face.1 := by
      apply R.faceXZ_injective
      exact Prod.ext (hcandidateX.trans hfaceX.symm) hcandidateZ
    subst candidate
    rcases of_decide_eq_true hedge with hedge | hedge
    · left
      exact congrArg Sum.inr hedge
    · right
      exact congrArg Sum.inr hedge

/-- The V2 incident-edge owner reaches an old Z at endpoint one. -/
private theorem rxCxH1_oldZOwner_endpoint_one
    (P : TannerSquarePresentation) (A3 : TannerSquareAdmissibleV3 P)
    (x : P.X) (face : XStarFace P x) :
    let vertex : XStarBoundaryVertex P x :=
      ⟨Vertex.z (P.faceZ face.1), (xStarFaceZVertex P x face).2⟩
    (A3.toTannerSquareAdmissibleV2.xBoundaryIncidentEdge x vertex).1.2 = 1 := by
  dsimp only
  let vertex : XStarBoundaryVertex P x :=
    ⟨Vertex.z (P.faceZ face.1), (xStarFaceZVertex P x face).2⟩
  let owner := A3.toTannerSquareAdmissibleV2.xBoundaryIncidentEdge x vertex
  have hendpoint := owner.2
  have hcases : owner.1.2 = 0 ∨ owner.1.2 = 1 :=
    rxTwoElim (motive := fun endpoint => endpoint = 0 ∨ endpoint = 1)
      (Or.inl rfl) (Or.inr rfl) owner.1.2
  rcases hcases with hzero | hone
  · rw [hzero] at hendpoint
    rw [BDL26TannerLocalRegularity.edgeEndpoint_zero] at hendpoint
    rcases howned : owner.1.1 with ⟨rawEdge, edgeMember⟩
    rcases rawEdge with impossible | qzEdge
    · simp [xStarBoundaryEdgeMember] at edgeMember
    · rw [howned] at hendpoint
      simp only [xBoundaryEdgeStart] at hendpoint
      have hraw := congrArg Subtype.val hendpoint
      dsimp only [vertex] at hraw
      change Vertex.q qzEdge.1.1 = Vertex.z (P.faceZ face.1) at hraw
      cases hraw
  · exact hone

/-- Generic terminal-segment algebra once the endpoint potential is known to
be the complete path integral from the edge start. -/
private theorem rxCxH1_segmentTerminal_equation_of_endpoint
    (P : TannerSquarePresentation) (A3 : TannerSquareAdmissibleV3 P)
    (x : P.X) (S : OddScale)
    (word : Word Field (DoubleCylinderEdge P x S)) (copy : Two)
    (edge : XStarEdge P x)
    (hendpoint :
      rxCxH1_oldVertexPotential P A3 x S word copy
          (xStarEdgeEnd P x edge) =
        rxCxH1_oldVertexPotential P A3 x S word copy
            (xStarEdgeStart P x edge) +
          rxCxH1_segmentPrefix P x S word copy edge S.half
            (le_refl S.half))
    (segment : Fin S.half) (hterminal : segment.1 + 1 = S.half) :
    rxCxH1_subdivisionPotential P A3 x S word copy
        (subdivisionSegmentStart P x S edge segment) +
      rxCxH1_subdivisionPotential P A3 x S word copy
        (subdivisionSegmentEnd P x S edge segment) =
      word (Sum.inl (copy, Sum.inl (edge, segment))) := by
  rcases segment with ⟨segment, hsegment⟩
  rcases segment with _ | segment
  · change 1 = S.half at hterminal
    have hstart : subdivisionSegmentStart P x S edge ⟨0, hsegment⟩ =
        Sum.inl (xStarEdgeStart P x edge) := by
      simp [subdivisionSegmentStart]
    have hend : subdivisionSegmentEnd P x S edge ⟨0, hsegment⟩ =
        Sum.inl (xStarEdgeEnd P x edge) := by
      simp [subdivisionSegmentEnd, hterminal]
    rw [hstart, hend]
    simp only [rxCxH1_subdivisionPotential]
    rw [hendpoint]
    have hprefixFull :
        rxCxH1_segmentPrefix P x S word copy edge S.half
            (le_refl S.half) =
          rxCxH1_segmentPrefix P x S word copy edge 1 (by omega) := by
      congr 1
      exact hterminal.symm
    rw [hprefixFull, rxCxH1_segmentPrefix]
    simp only [rxCxH1_segmentPrefix, zero_add]
    simpa using rxCxH1_cancel_successive
      (rxCxH1_oldVertexPotential P A3 x S word copy
        (xStarEdgeStart P x edge)) 0
      (word (Sum.inl (copy, Sum.inl (edge, ⟨0, hsegment⟩))))
  · change segment + 2 = S.half at hterminal
    have hnotzero : segment + 1 ≠ 0 := by omega
    let interior : Fin (S.half - 1) := ⟨segment, by omega⟩
    have hstart : subdivisionSegmentStart P x S edge
        ⟨segment + 1, hsegment⟩ =
        Sum.inr (Sum.inl (edge, interior)) := by
      simp [subdivisionSegmentStart, hnotzero, interior]
    have hend : subdivisionSegmentEnd P x S edge
        ⟨segment + 1, hsegment⟩ =
        Sum.inl (xStarEdgeEnd P x edge) := by
      simp [subdivisionSegmentEnd, hterminal]
    rw [hstart, hend]
    simp only [rxCxH1_subdivisionPotential]
    rw [hendpoint]
    have hprefixFull :
        rxCxH1_segmentPrefix P x S word copy edge S.half
            (le_refl S.half) =
          rxCxH1_segmentPrefix P x S word copy edge (segment + 2)
            (by omega) := by
      congr 1
      exact hterminal.symm
    rw [hprefixFull]
    rw (occs := .pos [2]) [rxCxH1_segmentPrefix]
    dsimp only [interior]
    exact rxCxH1_cancel_successive
      (rxCxH1_oldVertexPotential P A3 x S word copy
        (xStarEdgeStart P x edge))
      (rxCxH1_segmentPrefix P x S word copy edge (segment + 1) (by omega))
      (word (Sum.inl (copy, Sum.inl (edge, ⟨segment + 1, hsegment⟩))))

/-- The selected old-Z owner is exactly the route stored by the explicit
old-vertex potential. -/
private theorem rxCxH1_oldZOwner_endpointPotential
    (P : TannerSquarePresentation) (A3 : TannerSquareAdmissibleV3 P)
    (x : P.X) (S : OddScale)
    (word : Word Field (DoubleCylinderEdge P x S)) (copy : Two)
    (face : XStarFace P x) :
    let vertex : XStarBoundaryVertex P x :=
      ⟨Vertex.z (P.faceZ face.1), (xStarFaceZVertex P x face).2⟩
    let owner := A3.toTannerSquareAdmissibleV2.xBoundaryIncidentEdge x vertex
    rxCxH1_oldVertexPotential P A3 x S word copy
        (xStarEdgeEnd P x (xStarBoundaryEdgeToStar P x owner.1.1)) =
      rxCxH1_oldVertexPotential P A3 x S word copy
          (xStarEdgeStart P x (xStarBoundaryEdgeToStar P x owner.1.1)) +
        rxCxH1_segmentPrefix P x S word copy
          (xStarBoundaryEdgeToStar P x owner.1.1) S.half (le_refl S.half) := by
  dsimp only
  let vertex : XStarBoundaryVertex P x :=
    ⟨Vertex.z (P.faceZ face.1), (xStarFaceZVertex P x face).2⟩
  let owner := A3.toTannerSquareAdmissibleV2.xBoundaryIncidentEdge x vertex
  change rxCxH1_oldVertexPotential P A3 x S word copy
      (xStarEdgeEnd P x (xStarBoundaryEdgeToStar P x owner.1.1)) =
    rxCxH1_oldVertexPotential P A3 x S word copy
        (xStarEdgeStart P x (xStarBoundaryEdgeToStar P x owner.1.1)) +
      rxCxH1_segmentPrefix P x S word copy
        (xStarBoundaryEdgeToStar P x owner.1.1) S.half (le_refl S.half)
  have hone : owner.1.2 = 1 :=
    rxCxH1_oldZOwner_endpoint_one P A3 x face
  have hendpoint := owner.2
  rw [hone, BDL26TannerLocalRegularity.edgeEndpoint_one] at hendpoint
  generalize howned : owner.1.1 = selected
  rcases selected with ⟨rawEdge, edgeMember⟩
  rcases rawEdge with impossible | qzEdge
  · simp [xStarBoundaryEdgeMember] at edgeMember
  · rw [howned] at hendpoint
    simp only [xBoundaryEdgeEnd] at hendpoint
    let starEdge : XStarEdge P x := ⟨Sum.inr qzEdge, edgeMember⟩
    have hend : xStarEdgeEnd P x starEdge = xStarFaceZVertex P x face := by
      apply Subtype.ext
      have hraw := congrArg Subtype.val hendpoint
      dsimp only [vertex] at hraw
      exact hraw
    change rxCxH1_oldVertexPotential P A3 x S word copy
        (xStarEdgeEnd P x starEdge) =
      rxCxH1_oldVertexPotential P A3 x S word copy
          (xStarEdgeStart P x starEdge) +
        rxCxH1_segmentPrefix P x S word copy starEdge S.half
          (le_refl S.half)
    rw [hend]
    simp only [xStarFaceZVertex, xStarEdgeStart]
    simp only [rxCxH1_oldVertexPotential]
    change rxCxH1_oldZOwnerPotential P x S word copy owner.1.1 = _
    rw [howned]
    simp only [rxCxH1_oldZOwnerPotential]
    rfl

/-- The terminal segment of the selected old-Z owner is the coboundary of
the explicit endpoint potential. -/
private theorem rxCxH1_oldZOwner_terminal_equation
    (P : TannerSquarePresentation) (A3 : TannerSquareAdmissibleV3 P)
    (x : P.X) (S : OddScale)
    (word : Word Field (DoubleCylinderEdge P x S)) (copy : Two)
    (face : XStarFace P x) (segment : Fin S.half)
    (hterminal : segment.1 + 1 = S.half) :
    let vertex : XStarBoundaryVertex P x :=
      ⟨Vertex.z (P.faceZ face.1), (xStarFaceZVertex P x face).2⟩
    let owner := A3.toTannerSquareAdmissibleV2.xBoundaryIncidentEdge x vertex
    let edge := xStarBoundaryEdgeToStar P x owner.1.1
    rxCxH1_subdivisionPotential P A3 x S word copy
        (subdivisionSegmentStart P x S edge segment) +
      rxCxH1_subdivisionPotential P A3 x S word copy
        (subdivisionSegmentEnd P x S edge segment) =
      word (Sum.inl (copy, Sum.inl (edge, segment))) := by
  dsimp only
  exact rxCxH1_segmentTerminal_equation_of_endpoint P A3 x S word copy
    _ (rxCxH1_oldZOwner_endpointPotential P A3 x S word copy face)
    segment hterminal

/-- A selected owner identified with one ordered face corner yields that
corner's concrete Q-Z terminal equation. -/
private theorem rxCxH1_qzTerminal_equation_of_owner
    (P : TannerSquarePresentation) (A3 : TannerSquareAdmissibleV3 P)
    (x : P.X) (S : OddScale)
    (word : Word Field (DoubleCylinderEdge P x S)) (copy : Two)
    (face : XStarFace P x) (corner : Two) (segment : Fin S.half)
    (hterminal : segment.1 + 1 = S.half)
    (howner :
      let vertex : XStarBoundaryVertex P x :=
        ⟨Vertex.z (P.faceZ face.1), (xStarFaceZVertex P x face).2⟩
      let owner :=
        A3.toTannerSquareAdmissibleV2.xBoundaryIncidentEdge x vertex
      owner.1.1.1 = xStarFaceQZEdge P x face corner) :
    rxCxH1_subdivisionPotential P A3 x S word copy
        (subdivisionSegmentStart P x S
          (xStarFaceQZEdge P x face corner) segment) +
      rxCxH1_subdivisionPotential P A3 x S word copy
        (subdivisionSegmentEnd P x S
          (xStarFaceQZEdge P x face corner) segment) =
      word (Sum.inl (copy, Sum.inl
        (xStarFaceQZEdge P x face corner, segment))) := by
  let vertex : XStarBoundaryVertex P x :=
    ⟨Vertex.z (P.faceZ face.1), (xStarFaceZVertex P x face).2⟩
  let owner := A3.toTannerSquareAdmissibleV2.xBoundaryIncidentEdge x vertex
  have hedge :
      xStarBoundaryEdgeToStar P x owner.1.1 =
        xStarFaceQZEdge P x face corner := by
    apply Subtype.ext
    simpa [owner, vertex, xStarBoundaryEdgeToStar] using howner
  have hselected := rxCxH1_oldZOwner_terminal_equation
    P A3 x S word copy face segment hterminal
  dsimp only at hselected
  rw [hedge] at hselected
  exact hselected

/-- If corner zero is the selected old-Z terminal, the last small square
transports the terminal equation to corner one. -/
private theorem rxCxH1_qzOne_terminal_of_qzZero
    (P : TannerSquarePresentation) (A3 : TannerSquareAdmissibleV3 P)
    (x : P.X) (S : OddScale)
    (word : Word Field (DoubleCylinderEdge P x S))
    (hword : wordLinearMapTranspose (rxCx P x S).boundary2 word = 0)
    (copy : Two) (face : XStarFace P x)
    (hzero :
      let terminal : Fin S.half := ⟨S.half - 1, by
        have := S.half_pos
        omega⟩
      rxCxH1_subdivisionPotential P A3 x S word copy
          (subdivisionSegmentStart P x S
            (xStarFaceQZEdge P x face 0) terminal) +
        rxCxH1_subdivisionPotential P A3 x S word copy
          (subdivisionSegmentEnd P x S
            (xStarFaceQZEdge P x face 0) terminal) =
        word (Sum.inl (copy, Sum.inl
          (xStarFaceQZEdge P x face 0, terminal)))) :
    let terminal : Fin S.half := ⟨S.half - 1, by
      have := S.half_pos
      omega⟩
    rxCxH1_subdivisionPotential P A3 x S word copy
        (subdivisionSegmentStart P x S
          (xStarFaceQZEdge P x face 1) terminal) +
      rxCxH1_subdivisionPotential P A3 x S word copy
        (subdivisionSegmentEnd P x S
          (xStarFaceQZEdge P x face 1) terminal) =
      word (Sum.inl (copy, Sum.inl
        (xStarFaceQZEdge P x face 1, terminal))) := by
  dsimp only
  let terminal : Fin S.half := ⟨S.half - 1, by
    have := S.half_pos
    omega⟩
  let cell : SubdivisionFace P x S := (face, terminal, terminal)
  let potential : Word Field (SubdivisionVertex P x S) :=
    rxCxH1_subdivisionPotential P A3 x S word copy
  have htopEdge :
      subdivisionFaceBoundaryEdge P x S cell (0, 1) =
        subdivisionHorizontalEdge P x S face terminal
          ⟨S.half, by omega⟩ := by
    rw [subdivisionFaceBoundaryEdge_zero_one]
    congr 1
    apply Fin.ext
    rw [finSuccGrid_val]
    dsimp only [cell, terminal]
    have := S.half_pos
    omega
  have hrightEdge :
      subdivisionFaceBoundaryEdge P x S cell (1, 1) =
        subdivisionVerticalEdge P x S face ⟨S.half, by omega⟩
          terminal := by
    rw [subdivisionFaceBoundaryEdge_one_one]
    congr 1
    apply Fin.ext
    rw [finSuccGrid_val]
    dsimp only [cell, terminal]
    have := S.half_pos
    omega
  have hhalf : S.half ≠ 0 := S.half_pos.ne'
  change potential
        (subdivisionEdgeStart P x S
          (Sum.inl (xStarFaceQZEdge P x face 1, terminal))) +
      potential
        (subdivisionEdgeEnd P x S
          (Sum.inl (xStarFaceQZEdge P x face 1, terminal))) =
      word (Sum.inl (copy,
        Sum.inl (xStarFaceQZEdge P x face 1, terminal)))
  have htopBoundary :
      subdivisionHorizontalEdge P x S face terminal
          ⟨S.half, by omega⟩ =
        Sum.inl (xStarFaceQZEdge P x face 1, terminal) := by
    simp [subdivisionHorizontalEdge, hhalf]
  rw [← htopBoundary, ← htopEdge]
  apply rxCxH1_smallSquare_curl_transport
    P x S word hword copy potential cell
  · change
      rxCxH1_subdivisionPotential P A3 x S word copy
          (subdivisionEdgeStart P x S
            (subdivisionHorizontalEdge P x S face terminal
              ⟨S.half - 1, by omega⟩)) +
        rxCxH1_subdivisionPotential P A3 x S word copy
          (subdivisionEdgeEnd P x S
            (subdivisionHorizontalEdge P x S face terminal
              ⟨S.half - 1, by omega⟩)) =
        word (Sum.inl (copy, subdivisionHorizontalEdge P x S face terminal
          ⟨S.half - 1, by omega⟩))
    exact rxCxH1_horizontalLower_equation P A3 x S word hword copy
      face terminal (S.half - 1) (by omega)
  · rw [hrightEdge]
    dsimp only [potential]
    simpa [subdivisionVerticalEdge, hhalf, subdivisionEdgeStart, subdivisionEdgeEnd] using hzero
  · change
      rxCxH1_subdivisionPotential P A3 x S word copy
          (subdivisionEdgeStart P x S
            (subdivisionVerticalEdge P x S face
              ⟨S.half - 1, by omega⟩ terminal)) +
        rxCxH1_subdivisionPotential P A3 x S word copy
          (subdivisionEdgeEnd P x S
            (subdivisionVerticalEdge P x S face
              ⟨S.half - 1, by omega⟩ terminal)) =
        word (Sum.inl (copy, subdivisionVerticalEdge P x S face
          ⟨S.half - 1, by omega⟩ terminal))
    exact rxCxH1_topRightLeft_equation
      P A3 x S word hword copy face

/-- If corner one is the selected old-Z terminal, the last small square
solves its right side and transports the terminal equation to corner zero. -/
private theorem rxCxH1_qzZero_terminal_of_qzOne
    (P : TannerSquarePresentation) (A3 : TannerSquareAdmissibleV3 P)
    (x : P.X) (S : OddScale)
    (word : Word Field (DoubleCylinderEdge P x S))
    (hword : wordLinearMapTranspose (rxCx P x S).boundary2 word = 0)
    (copy : Two) (face : XStarFace P x)
    (hone :
      let terminal : Fin S.half := ⟨S.half - 1, by
        have := S.half_pos
        omega⟩
      rxCxH1_subdivisionPotential P A3 x S word copy
          (subdivisionSegmentStart P x S
            (xStarFaceQZEdge P x face 1) terminal) +
        rxCxH1_subdivisionPotential P A3 x S word copy
          (subdivisionSegmentEnd P x S
            (xStarFaceQZEdge P x face 1) terminal) =
        word (Sum.inl (copy, Sum.inl
          (xStarFaceQZEdge P x face 1, terminal)))) :
    let terminal : Fin S.half := ⟨S.half - 1, by
      have := S.half_pos
      omega⟩
    rxCxH1_subdivisionPotential P A3 x S word copy
        (subdivisionSegmentStart P x S
          (xStarFaceQZEdge P x face 0) terminal) +
      rxCxH1_subdivisionPotential P A3 x S word copy
        (subdivisionSegmentEnd P x S
          (xStarFaceQZEdge P x face 0) terminal) =
      word (Sum.inl (copy, Sum.inl
        (xStarFaceQZEdge P x face 0, terminal))) := by
  dsimp only
  let terminal : Fin S.half := ⟨S.half - 1, by
    have := S.half_pos
    omega⟩
  let cell : SubdivisionFace P x S := (face, terminal, terminal)
  let potential : Word Field (SubdivisionVertex P x S) :=
    rxCxH1_subdivisionPotential P A3 x S word copy
  have htopEdge :
      subdivisionFaceBoundaryEdge P x S cell (0, 1) =
        subdivisionHorizontalEdge P x S face terminal
          ⟨S.half, by omega⟩ := by
    rw [subdivisionFaceBoundaryEdge_zero_one]
    congr 1
    apply Fin.ext
    rw [finSuccGrid_val]
    dsimp only [cell, terminal]
    have := S.half_pos
    omega
  have hrightEdge :
      subdivisionFaceBoundaryEdge P x S cell (1, 1) =
        subdivisionVerticalEdge P x S face ⟨S.half, by omega⟩
          terminal := by
    rw [subdivisionFaceBoundaryEdge_one_one]
    congr 1
    apply Fin.ext
    rw [finSuccGrid_val]
    dsimp only [cell, terminal]
    have := S.half_pos
    omega
  have hhalf : S.half ≠ 0 := S.half_pos.ne'
  change potential
        (subdivisionEdgeStart P x S
          (Sum.inl (xStarFaceQZEdge P x face 0, terminal))) +
      potential
        (subdivisionEdgeEnd P x S
          (Sum.inl (xStarFaceQZEdge P x face 0, terminal))) =
      word (Sum.inl (copy,
        Sum.inl (xStarFaceQZEdge P x face 0, terminal)))
  have hrightBoundary :
      subdivisionVerticalEdge P x S face ⟨S.half, by omega⟩
          terminal =
        Sum.inl (xStarFaceQZEdge P x face 0, terminal) := by
    simp [subdivisionVerticalEdge, hhalf]
  rw [← hrightBoundary, ← hrightEdge]
  apply rxCxH1_smallSquare_curl_transport_right
    P x S word hword copy potential cell
  · change
      rxCxH1_subdivisionPotential P A3 x S word copy
          (subdivisionEdgeStart P x S
            (subdivisionHorizontalEdge P x S face terminal
              ⟨S.half - 1, by omega⟩)) +
        rxCxH1_subdivisionPotential P A3 x S word copy
          (subdivisionEdgeEnd P x S
            (subdivisionHorizontalEdge P x S face terminal
              ⟨S.half - 1, by omega⟩)) =
        word (Sum.inl (copy, subdivisionHorizontalEdge P x S face terminal
          ⟨S.half - 1, by omega⟩))
    exact rxCxH1_horizontalLower_equation P A3 x S word hword copy
      face terminal (S.half - 1) (by omega)
  · rw [htopEdge]
    dsimp only [potential]
    simpa [subdivisionHorizontalEdge, hhalf, subdivisionEdgeStart, subdivisionEdgeEnd] using hone
  · change
      rxCxH1_subdivisionPotential P A3 x S word copy
          (subdivisionEdgeStart P x S
            (subdivisionVerticalEdge P x S face
              ⟨S.half - 1, by omega⟩ terminal)) +
        rxCxH1_subdivisionPotential P A3 x S word copy
          (subdivisionEdgeEnd P x S
            (subdivisionVerticalEdge P x S face
              ⟨S.half - 1, by omega⟩ terminal)) =
        word (Sum.inl (copy, subdivisionVerticalEdge P x S face
          ⟨S.half - 1, by omega⟩ terminal))
    exact rxCxH1_topRightLeft_equation
      P A3 x S word hword copy face

/-- Every ordered Q-Z corner has the terminal coboundary equation.  The V2
owner selects one corner; cellular face uniqueness identifies that corner,
and the final small-square transport supplies the other. -/
theorem rxCxH1_qzTerminal_equation
    (P : TannerSquarePresentation) (A3 : TannerSquareAdmissibleV3 P)
    (R : TannerSquareCellularRegular P) (x : P.X) (S : OddScale)
    (word : Word Field (DoubleCylinderEdge P x S))
    (hword : wordLinearMapTranspose (rxCx P x S).boundary2 word = 0)
    (copy : Two) (face : XStarFace P x) (corner : Two)
    (segment : Fin S.half) (hterminal : segment.1 + 1 = S.half) :
    rxCxH1_subdivisionPotential P A3 x S word copy
        (subdivisionSegmentStart P x S
          (xStarFaceQZEdge P x face corner) segment) +
      rxCxH1_subdivisionPotential P A3 x S word copy
        (subdivisionSegmentEnd P x S
          (xStarFaceQZEdge P x face corner) segment) =
      word (Sum.inl (copy, Sum.inl
        (xStarFaceQZEdge P x face corner, segment))) := by
  let terminal : Fin S.half := ⟨S.half - 1, by
    have := S.half_pos
    omega⟩
  have hsegment : segment = terminal := by
    apply Fin.ext
    dsimp only [terminal]
    omega
  rw [hsegment]
  have hterminalLast : terminal.1 + 1 = S.half := by
    dsimp only [terminal]
    have := S.half_pos
    omega
  have hcases := rxCxH1_oldZOwner_edge_cases P A3 R x face
  rcases hcases with hzero | hone
  · have hselected := rxCxH1_qzTerminal_equation_of_owner
      P A3 x S word copy face 0 terminal hterminalLast hzero
    refine rxTwoElim (motive := fun corner : Two =>
      rxCxH1_subdivisionPotential P A3 x S word copy
          (subdivisionSegmentStart P x S
            (xStarFaceQZEdge P x face corner) terminal) +
        rxCxH1_subdivisionPotential P A3 x S word copy
          (subdivisionSegmentEnd P x S
            (xStarFaceQZEdge P x face corner) terminal) =
        word (Sum.inl (copy, Sum.inl
          (xStarFaceQZEdge P x face corner, terminal))))
      hselected
      (rxCxH1_qzOne_terminal_of_qzZero
        P A3 x S word hword copy face hselected)
      corner
  · have hselected := rxCxH1_qzTerminal_equation_of_owner
      P A3 x S word copy face 1 terminal hterminalLast hone
    refine rxTwoElim (motive := fun corner : Two =>
      rxCxH1_subdivisionPotential P A3 x S word copy
          (subdivisionSegmentStart P x S
            (xStarFaceQZEdge P x face corner) terminal) +
        rxCxH1_subdivisionPotential P A3 x S word copy
          (subdivisionSegmentEnd P x S
            (xStarFaceQZEdge P x face corner) terminal) =
        word (Sum.inl (copy, Sum.inl
          (xStarFaceQZEdge P x face corner, terminal))))
      (rxCxH1_qzZero_terminal_of_qzOne
        P A3 x S word hword copy face hselected)
      hselected
      corner

/-- Every terminal segment of an arbitrary typed original star edge is
realized.  Its membership proposition only identifies an incident face and
ordered corner; no face data escapes this proof. -/
private theorem rxCxH1_starEdgeTerminal_equation
    (P : TannerSquarePresentation) (A3 : TannerSquareAdmissibleV3 P)
    (R : TannerSquareCellularRegular P) (x : P.X) (S : OddScale)
    (word : Word Field (DoubleCylinderEdge P x S))
    (hword : wordLinearMapTranspose (rxCx P x S).boundary2 word = 0)
    (copy : Two) (edge : XStarEdge P x) (segment : Fin S.half)
    (hterminal : segment.1 + 1 = S.half) :
    rxCxH1_subdivisionPotential P A3 x S word copy
        (subdivisionSegmentStart P x S edge segment) +
      rxCxH1_subdivisionPotential P A3 x S word copy
        (subdivisionSegmentEnd P x S edge segment) =
      word (Sum.inl (copy, Sum.inl (edge, segment))) := by
  rcases edge with ⟨rawEdge, member⟩
  rcases rawEdge with xqEdge | qzEdge
  · change decide (exists face : P.Face,
        xStarFaceMember P x face = true ∧
          decide (xqEdge = faceXQEdge P face 0 ∨
            xqEdge = faceXQEdge P face 1) = true) = true at member
    obtain ⟨face, hface, huse⟩ := of_decide_eq_true member
    let starFace : XStarFace P x := ⟨face, hface⟩
    rcases of_decide_eq_true huse with hzero | hone
    · have hedge :
          (⟨Sum.inl xqEdge, member⟩ : XStarEdge P x) =
            xStarFaceXQEdge P x starFace 0 := by
        apply Subtype.ext
        exact congrArg Sum.inl hzero
      rw [hedge]
      exact rxCxH1_xqTerminal_equation P A3 x S word copy starFace 0
        segment hterminal
    · have hedge :
          (⟨Sum.inl xqEdge, member⟩ : XStarEdge P x) =
            xStarFaceXQEdge P x starFace 1 := by
        apply Subtype.ext
        exact congrArg Sum.inl hone
      rw [hedge]
      exact rxCxH1_xqTerminal_equation P A3 x S word copy starFace 1
        segment hterminal
  · change decide (exists face : P.Face,
        xStarFaceMember P x face = true ∧
          decide (qzEdge = faceQZEdge P face 0 ∨
            qzEdge = faceQZEdge P face 1) = true) = true at member
    obtain ⟨face, hface, huse⟩ := of_decide_eq_true member
    let starFace : XStarFace P x := ⟨face, hface⟩
    rcases of_decide_eq_true huse with hzero | hone
    · have hedge :
          (⟨Sum.inr qzEdge, member⟩ : XStarEdge P x) =
            xStarFaceQZEdge P x starFace 0 := by
        apply Subtype.ext
        exact congrArg Sum.inr hzero
      rw [hedge]
      exact rxCxH1_qzTerminal_equation P A3 R x S word hword copy
        starFace 0 segment hterminal
    · have hedge :
          (⟨Sum.inr qzEdge, member⟩ : XStarEdge P x) =
            xStarFaceQZEdge P x starFace 1 := by
        apply Subtype.ext
        exact congrArg Sum.inr hone
      rw [hedge]
      exact rxCxH1_qzTerminal_equation P A3 R x S word hword copy
        starFace 1 segment hterminal

/-- The explicit potential realizes every edge in either subdivided X-star
copy.  Constructor dispatch is entirely structural; regularity is inherited
only through the Q-Z terminal producer. -/
private theorem rxCxH1_subdivisionEdge_equation
    (P : TannerSquarePresentation) (A3 : TannerSquareAdmissibleV3 P)
    (R : TannerSquareCellularRegular P) (x : P.X) (S : OddScale)
    (word : Word Field (DoubleCylinderEdge P x S))
    (hword : wordLinearMapTranspose (rxCx P x S).boundary2 word = 0)
    (copy : Two) (edge : SubdivisionEdge P x S) :
    rxCxH1_subdivisionPotential P A3 x S word copy
        (subdivisionEdgeStart P x S edge) +
      rxCxH1_subdivisionPotential P A3 x S word copy
        (subdivisionEdgeEnd P x S edge) =
      word (Sum.inl (copy, edge)) := by
  rcases edge with original | horizontal | vertical
  · rcases original with ⟨edge, segment⟩
    by_cases hterminal : segment.1 + 1 = S.half
    · exact rxCxH1_starEdgeTerminal_equation
        P A3 R x S word hword copy edge segment hterminal
    · exact rxCxH1_segmentInterior_equation P A3 x S word copy
        edge segment (by have := segment.2; omega)
  · rcases horizontal with ⟨face, segment, row⟩
    have hrow : row.1 + 1 < S.half := by
      have := row.2
      omega
    have hrowZero : row.1 + 1 ≠ 0 := by omega
    have hrowLast : row.1 + 1 ≠ S.half := by omega
    have hhorizontal := rxCxH1_horizontalLower_equation P A3 x S word hword copy face segment
        (row.1 + 1) hrow
    simp [subdivisionHorizontalEdge, hrowZero, hrowLast] at hhorizontal
    exact hhorizontal
  · rcases vertical with ⟨face, column, segment⟩
    let horizontal : Fin (S.half + 1) := ⟨column.1 + 1, by
      have := column.2
      have := S.half_pos
      omega⟩
    have hhorizontalZero : horizontal.1 ≠ 0 := by
      dsimp only [horizontal]
      omega
    have hhorizontalLast : horizontal.1 ≠ S.half := by
      dsimp only [horizontal]
      have := column.2
      omega
    by_cases hterminal : segment.1 + 1 = S.half
    · let terminal : Fin S.half := ⟨S.half - 1, by
        have := S.half_pos
        omega⟩
      have hsegment : segment = terminal := by
        apply Fin.ext
        dsimp only [terminal]
        omega
      rw [hsegment]
      have hvertical := rxCxH1_verticalTerminalInterior_equation
          P A3 x S word hword copy face column.1 (by
            have := column.2
            omega)
      simp [subdivisionVerticalEdge, horizontal, hhorizontalZero,
        hhorizontalLast] at hvertical
      exact hvertical
    · have hvertical := rxCxH1_verticalNonterminal_equation P A3 x S word copy face
          horizontal segment (by have := segment.2; omega)
      simp [subdivisionVerticalEdge, horizontal, hhorizontalZero,
        hhorizontalLast] at hvertical
      exact hvertical

/-- Failure of the two unshifted copy potentials to realize one vertical
cylinder edge.  Rectangle cocycles will show that this value is constant on
the connected subdivided boundary. -/
private noncomputable def rxCxH1_glueDiscrepancy
    (P : TannerSquarePresentation) (A3 : TannerSquareAdmissibleV3 P)
    (x : P.X) (S : OddScale)
    (word : Word Field (DoubleCylinderEdge P x S))
    (vertex : SubdivisionBoundaryVertex P x S) : Field :=
  rxCxH1_subdivisionPotential P A3 x S word 0 vertex.1 +
    rxCxH1_subdivisionPotential P A3 x S word 1 vertex.1 +
      word (Sum.inr vertex)

/-- The copy-one normalization is anchored at the historical constructive
boundary root. -/
private noncomputable def rxCxH1_glueOffset
    (P : TannerSquarePresentation) (A3 : TannerSquareAdmissibleV3 P)
    (x : P.X) (S : OddScale)
    (word : Word Field (DoubleCylinderEdge P x S)) : Field :=
  let A := A3.toTannerSquareAdmissibleV2.toTannerSquareAdmissible
  rxCxH1_glueDiscrepancy P A3 x S word
    (subdivisionOriginalBoundaryVertex P x S (A.xBoundaryRoot x))

/-- Full two-copy vertex potential, with the single boundary normalization
added only on copy one. -/
private noncomputable def rxCxH1_doubleCylinderPotential
    (P : TannerSquarePresentation) (A3 : TannerSquareAdmissibleV3 P)
    (x : P.X) (S : OddScale)
    (word : Word Field (DoubleCylinderEdge P x S)) :
    Word Field (DoubleCylinderVertex P x S) := fun vertex =>
  rxCxH1_subdivisionPotential P A3 x S word vertex.1 vertex.2 +
    rxTwoElim (motive := fun _ => Field) 0
      (rxCxH1_glueOffset P A3 x S word) vertex.1

/-- A boundary rectangle and the two copy-edge equations make the glue
discrepancy equal at the endpoints of every subdivided boundary edge. -/
private theorem rxCxH1_glueDiscrepancy_edge_eq
    (P : TannerSquarePresentation) (A3 : TannerSquareAdmissibleV3 P)
    (R : TannerSquareCellularRegular P) (x : P.X) (S : OddScale)
    (word : Word Field (DoubleCylinderEdge P x S))
    (hword : wordLinearMapTranspose (rxCx P x S).boundary2 word = 0)
    (edge : SubdivisionBoundaryEdge P x S) :
    rxCxH1_glueDiscrepancy P A3 x S word
        (subdivisionBoundaryEdgeStart P x S edge) =
      rxCxH1_glueDiscrepancy P A3 x S word
        (subdivisionBoundaryEdgeEnd P x S edge) := by
  have hcopyZero := rxCxH1_subdivisionEdge_equation
    P A3 R x S word hword 0 edge.1
  have hcopyOne := rxCxH1_subdivisionEdge_equation
    P A3 R x S word hword 1 edge.1
  have hcopyZero' :
      rxCxH1_subdivisionPotential P A3 x S word 0
          (subdivisionBoundaryEdgeStart P x S edge).1 +
        rxCxH1_subdivisionPotential P A3 x S word 0
          (subdivisionBoundaryEdgeEnd P x S edge).1 =
        word (Sum.inl (0, edge.1)) := by
    simpa using hcopyZero
  have hcopyOne' :
      rxCxH1_subdivisionPotential P A3 x S word 1
          (subdivisionBoundaryEdgeStart P x S edge).1 +
        rxCxH1_subdivisionPotential P A3 x S word 1
          (subdivisionBoundaryEdgeEnd P x S edge).1 =
        word (Sum.inl (1, edge.1)) := by
    simpa using hcopyOne
  have hrectangle := rxCxH1_rectangle_sum_eq_zero
    P x S word hword edge
  simp only [doubleCylinderRectangleBoundaryEdge_zero,
    doubleCylinderRectangleBoundaryEdge_one_zero,
    doubleCylinderRectangleBoundaryEdge_one_one] at hrectangle
  rw [← hcopyZero', ← hcopyOne'] at hrectangle
  have hsum :
      rxCxH1_glueDiscrepancy P A3 x S word
          (subdivisionBoundaryEdgeStart P x S edge) +
        rxCxH1_glueDiscrepancy P A3 x S word
          (subdivisionBoundaryEdgeEnd P x S edge) = 0 := by
    unfold rxCxH1_glueDiscrepancy
    rw [show
      (rxCxH1_subdivisionPotential P A3 x S word 0
            (subdivisionBoundaryEdgeStart P x S edge).1 +
          rxCxH1_subdivisionPotential P A3 x S word 1
            (subdivisionBoundaryEdgeStart P x S edge).1 +
          word (Sum.inr (subdivisionBoundaryEdgeStart P x S edge))) +
        (rxCxH1_subdivisionPotential P A3 x S word 0
            (subdivisionBoundaryEdgeEnd P x S edge).1 +
          rxCxH1_subdivisionPotential P A3 x S word 1
            (subdivisionBoundaryEdgeEnd P x S edge).1 +
          word (Sum.inr (subdivisionBoundaryEdgeEnd P x S edge))) =
        (rxCxH1_subdivisionPotential P A3 x S word 0
            (subdivisionBoundaryEdgeStart P x S edge).1 +
          rxCxH1_subdivisionPotential P A3 x S word 0
            (subdivisionBoundaryEdgeEnd P x S edge).1) +
        (rxCxH1_subdivisionPotential P A3 x S word 1
            (subdivisionBoundaryEdgeStart P x S edge).1 +
          rxCxH1_subdivisionPotential P A3 x S word 1
            (subdivisionBoundaryEdgeEnd P x S edge).1) +
        word (Sum.inr (subdivisionBoundaryEdgeStart P x S edge)) +
          word (Sum.inr (subdivisionBoundaryEdgeEnd P x S edge)) by abel]
    exact hrectangle
  rw [← sub_eq_zero]
  simpa [sub_eq_add_neg, neg_eq_self] using hsum

/-- Consecutive subdivision segments of one old boundary edge share their
intermediate endpoint. -/
private theorem rxCxH1_boundarySegment_next
    (P : TannerSquarePresentation) (x : P.X) (S : OddScale)
    (edge : XStarBoundaryEdge P x) (segment : Nat)
    (hnext : segment + 1 < S.half) :
    subdivisionBoundaryEdgeEnd P x S
        (subdivisionOriginalBoundaryEdge P x S edge
          ⟨segment, by omega⟩) =
      subdivisionBoundaryEdgeStart P x S
        (subdivisionOriginalBoundaryEdge P x S edge
          ⟨segment + 1, by omega⟩) := by
  apply Subtype.ext
  rw [subdivisionBoundaryEdgeEnd_value,
    subdivisionBoundaryEdgeStart_value]
  simp [subdivisionOriginalBoundaryEdge, subdivisionEdgeStart,
    subdivisionEdgeEnd, subdivisionSegmentStart, subdivisionSegmentEnd,
    hnext.ne]

/-- The first subdivision segment starts at the old boundary-edge start. -/
private theorem rxCxH1_boundarySegment_first
    (P : TannerSquarePresentation) (x : P.X) (S : OddScale)
    (edge : XStarBoundaryEdge P x) :
    subdivisionBoundaryEdgeStart P x S
        (subdivisionOriginalBoundaryEdge P x S edge
          ⟨0, S.half_pos⟩) =
      subdivisionOriginalBoundaryVertex P x S
        (xBoundaryEdgeStart P x edge) := by
  apply Subtype.ext
  rw [subdivisionBoundaryEdgeStart_value]
  simp [subdivisionOriginalBoundaryEdge, subdivisionOriginalBoundaryVertex,
    subdivisionEdgeStart, subdivisionSegmentStart]

/-- The last subdivision segment ends at the old boundary-edge end. -/
private theorem rxCxH1_boundarySegment_last
    (P : TannerSquarePresentation) (x : P.X) (S : OddScale)
    (edge : XStarBoundaryEdge P x) :
    subdivisionBoundaryEdgeEnd P x S
        (subdivisionOriginalBoundaryEdge P x S edge
          ⟨S.half - 1, by have := S.half_pos; omega⟩) =
      subdivisionOriginalBoundaryVertex P x S
        (xBoundaryEdgeEnd P x edge) := by
  apply Subtype.ext
  rw [subdivisionBoundaryEdgeEnd_value]
  simp [subdivisionOriginalBoundaryEdge, subdivisionOriginalBoundaryVertex,
    subdivisionEdgeEnd, subdivisionSegmentEnd]
  exact Nat.sub_add_cancel S.half_pos

/-- Segment induction transports boundary-glue discrepancy equality across
one complete old boundary edge. -/
private theorem rxCxH1_glueDiscrepancy_oldEdge_eq
    (P : TannerSquarePresentation) (A3 : TannerSquareAdmissibleV3 P)
    (R : TannerSquareCellularRegular P) (x : P.X) (S : OddScale)
    (word : Word Field (DoubleCylinderEdge P x S))
    (hword : wordLinearMapTranspose (rxCx P x S).boundary2 word = 0)
    (edge : XStarBoundaryEdge P x) :
    rxCxH1_glueDiscrepancy P A3 x S word
        (subdivisionOriginalBoundaryVertex P x S
          (xBoundaryEdgeStart P x edge)) =
      rxCxH1_glueDiscrepancy P A3 x S word
        (subdivisionOriginalBoundaryVertex P x S
          (xBoundaryEdgeEnd P x edge)) := by
  let segmentEdge : Fin S.half → SubdivisionBoundaryEdge P x S :=
    subdivisionOriginalBoundaryEdge P x S edge
  have hprefix : ∀ (segment : Nat) (hsegment : segment < S.half),
      rxCxH1_glueDiscrepancy P A3 x S word
          (subdivisionBoundaryEdgeStart P x S
            (segmentEdge ⟨0, S.half_pos⟩)) =
        rxCxH1_glueDiscrepancy P A3 x S word
          (subdivisionBoundaryEdgeEnd P x S
            (segmentEdge ⟨segment, hsegment⟩)) := by
    intro segment hsegment
    induction segment with
    | zero =>
        exact rxCxH1_glueDiscrepancy_edge_eq P A3 R x S word hword
          (segmentEdge ⟨0, hsegment⟩)
    | succ segment ih =>
        have hprevious : segment < S.half := by omega
        calc
          rxCxH1_glueDiscrepancy P A3 x S word
                (subdivisionBoundaryEdgeStart P x S
                  (segmentEdge ⟨0, S.half_pos⟩)) =
              rxCxH1_glueDiscrepancy P A3 x S word
                (subdivisionBoundaryEdgeEnd P x S
                  (segmentEdge ⟨segment, hprevious⟩)) :=
            ih hprevious
          _ = rxCxH1_glueDiscrepancy P A3 x S word
                (subdivisionBoundaryEdgeStart P x S
                  (segmentEdge ⟨segment + 1, hsegment⟩)) := by
            exact congrArg (rxCxH1_glueDiscrepancy P A3 x S word)
              (rxCxH1_boundarySegment_next P x S edge segment hsegment)
          _ = rxCxH1_glueDiscrepancy P A3 x S word
                (subdivisionBoundaryEdgeEnd P x S
                  (segmentEdge ⟨segment + 1, hsegment⟩)) :=
            rxCxH1_glueDiscrepancy_edge_eq P A3 R x S word hword
              (segmentEdge ⟨segment + 1, hsegment⟩)
  have hlast := hprefix (S.half - 1) (by
    have := S.half_pos
    omega)
  rw [rxCxH1_boundarySegment_first,
    rxCxH1_boundarySegment_last] at hlast
  exact hlast

/-- Restriction of the glue discrepancy to the historical old boundary
vertices. -/
private noncomputable def rxCxH1_oldBoundaryDiscrepancy
    (P : TannerSquarePresentation) (A3 : TannerSquareAdmissibleV3 P)
    (x : P.X) (S : OddScale)
    (word : Word Field (DoubleCylinderEdge P x S)) :
    Word Field (XStarBoundaryVertex P x) := fun vertex =>
  rxCxH1_glueDiscrepancy P A3 x S word
    (subdivisionOriginalBoundaryVertex P x S vertex)

/-- Old-edge discrepancy equality is exactly vanishing graph coboundary for
the historical boundary word. -/
private theorem rxCxH1_oldBoundaryDiscrepancy_coboundary_eq_zero
    (P : TannerSquarePresentation) (A3 : TannerSquareAdmissibleV3 P)
    (R : TannerSquareCellularRegular P) (x : P.X) (S : OddScale)
    (word : Word Field (DoubleCylinderEdge P x S))
    (hword : wordLinearMapTranspose (rxCx P x S).boundary2 word = 0) :
    wordLinearMapTranspose
        (graphBoundary (xBoundaryEdgeStart P x) (xBoundaryEdgeEnd P x))
        (rxCxH1_oldBoundaryDiscrepancy P A3 x S word) = 0 := by
  ext edge
  rw [wordLinearMapTranspose_graphBoundary_apply]
  change
    rxCxH1_glueDiscrepancy P A3 x S word
          (subdivisionOriginalBoundaryVertex P x S
            (xBoundaryEdgeStart P x edge)) +
        rxCxH1_glueDiscrepancy P A3 x S word
          (subdivisionOriginalBoundaryVertex P x S
            (xBoundaryEdgeEnd P x edge)) = 0
  rw [rxCxH1_glueDiscrepancy_oldEdge_eq P A3 R x S word hword edge]
  exact ZModModule.add_self _

/-- Historical constructive boundary paths make every original-boundary
discrepancy equal to the copy-one normalization offset. -/
private theorem rxCxH1_glueDiscrepancy_original_eq_offset
    (P : TannerSquarePresentation) (A3 : TannerSquareAdmissibleV3 P)
    (R : TannerSquareCellularRegular P) (x : P.X) (S : OddScale)
    (word : Word Field (DoubleCylinderEdge P x S))
    (hword : wordLinearMapTranspose (rxCx P x S).boundary2 word = 0)
    (vertex : XStarBoundaryVertex P x) :
    rxCxH1_glueDiscrepancy P A3 x S word
        (subdivisionOriginalBoundaryVertex P x S vertex) =
      rxCxH1_glueOffset P A3 x S word := by
  let A := A3.toTannerSquareAdmissibleV2.toTannerSquareAdmissible
  have hconstant := word_eq_root_of_graphCoboundary_eq_zero
    (xBoundaryEdgeStart P x) (xBoundaryEdgeEnd P x)
    (A.xBoundaryRoot x) (A.xBoundaryPath x)
    (rxCxH1_oldBoundaryDiscrepancy P A3 x S word)
    (rxCxH1_oldBoundaryDiscrepancy_coboundary_eq_zero
      P A3 R x S word hword) vertex
  simpa [rxCxH1_oldBoundaryDiscrepancy, rxCxH1_glueOffset, A] using
    hconstant

/-- Prefix segment induction transports the discrepancy from an old edge's
initial vertex to the end of any selected subdivision segment. -/
private theorem rxCxH1_glueDiscrepancy_segmentEnd_eq
    (P : TannerSquarePresentation) (A3 : TannerSquareAdmissibleV3 P)
    (R : TannerSquareCellularRegular P) (x : P.X) (S : OddScale)
    (word : Word Field (DoubleCylinderEdge P x S))
    (hword : wordLinearMapTranspose (rxCx P x S).boundary2 word = 0)
    (edge : XStarBoundaryEdge P x) (selected : Fin S.half) :
    rxCxH1_glueDiscrepancy P A3 x S word
        (subdivisionOriginalBoundaryVertex P x S
          (xBoundaryEdgeStart P x edge)) =
      rxCxH1_glueDiscrepancy P A3 x S word
        (subdivisionBoundaryEdgeEnd P x S
          (subdivisionOriginalBoundaryEdge P x S edge selected)) := by
  let segmentEdge : Fin S.half → SubdivisionBoundaryEdge P x S :=
    subdivisionOriginalBoundaryEdge P x S edge
  have hprefix : ∀ (segment : Nat) (hsegment : segment < S.half),
      rxCxH1_glueDiscrepancy P A3 x S word
          (subdivisionBoundaryEdgeStart P x S
            (segmentEdge ⟨0, S.half_pos⟩)) =
        rxCxH1_glueDiscrepancy P A3 x S word
          (subdivisionBoundaryEdgeEnd P x S
            (segmentEdge ⟨segment, hsegment⟩)) := by
    intro segment hsegment
    induction segment with
    | zero =>
        exact rxCxH1_glueDiscrepancy_edge_eq P A3 R x S word hword
          (segmentEdge ⟨0, hsegment⟩)
    | succ segment ih =>
        have hprevious : segment < S.half := by omega
        calc
          rxCxH1_glueDiscrepancy P A3 x S word
                (subdivisionBoundaryEdgeStart P x S
                  (segmentEdge ⟨0, S.half_pos⟩)) =
              rxCxH1_glueDiscrepancy P A3 x S word
                (subdivisionBoundaryEdgeEnd P x S
                  (segmentEdge ⟨segment, hprevious⟩)) :=
            ih hprevious
          _ = rxCxH1_glueDiscrepancy P A3 x S word
                (subdivisionBoundaryEdgeStart P x S
                  (segmentEdge ⟨segment + 1, hsegment⟩)) := by
            exact congrArg (rxCxH1_glueDiscrepancy P A3 x S word)
              (rxCxH1_boundarySegment_next P x S edge segment hsegment)
          _ = rxCxH1_glueDiscrepancy P A3 x S word
                (subdivisionBoundaryEdgeEnd P x S
                  (segmentEdge ⟨segment + 1, hsegment⟩)) :=
            rxCxH1_glueDiscrepancy_edge_eq P A3 R x S word hword
              (segmentEdge ⟨segment + 1, hsegment⟩)
  have hselected := hprefix selected.1 selected.2
  rw [rxCxH1_boundarySegment_first] at hselected
  exact hselected

/-- An edge-interior boundary tag is the end of its preceding old-edge
subdivision segment. -/
private theorem rxCxH1_boundaryInterior_end
    (P : TannerSquarePresentation) (x : P.X) (S : OddScale)
    (edge : XStarBoundaryEdge P x) (interior : Fin (S.half - 1)) :
    subdivisionBoundaryEdgeEnd P x S
        (subdivisionOriginalBoundaryEdge P x S edge
          ⟨interior.1, by have := interior.2; omega⟩) =
      (⟨Sum.inr
          (Sum.inl (xStarBoundaryEdgeToStar P x edge, interior)), by
        simpa [subdivisionBoundaryVertexMember, xStarBoundaryEdgeToStar] using edge.2⟩ :
        SubdivisionBoundaryVertex P x S) := by
  apply Subtype.ext
  rw [subdivisionBoundaryEdgeEnd_value]
  have hnot : interior.1 + 1 ≠ S.half := by
    have := interior.2
    omega
  simp [subdivisionOriginalBoundaryEdge, subdivisionEdgeEnd,
    subdivisionSegmentEnd, hnot]

/-- Every tagged subdivision-boundary vertex has the historical root
discrepancy.  Original vertices use the old graph path, edge-interior vertices
use segment induction, and the face-interior constructor is impossible. -/
private theorem rxCxH1_glueDiscrepancy_eq_offset
    (P : TannerSquarePresentation) (A3 : TannerSquareAdmissibleV3 P)
    (R : TannerSquareCellularRegular P) (x : P.X) (S : OddScale)
    (word : Word Field (DoubleCylinderEdge P x S))
    (hword : wordLinearMapTranspose (rxCx P x S).boundary2 word = 0)
    (vertex : SubdivisionBoundaryVertex P x S) :
    rxCxH1_glueDiscrepancy P A3 x S word vertex =
      rxCxH1_glueOffset P A3 x S word := by
  rcases vertex with ⟨vertex, hboundary⟩
  rcases vertex with original | interior
  · let boundaryVertex : XStarBoundaryVertex P x :=
      ⟨original.1, by
        simpa [subdivisionBoundaryVertexMember] using hboundary⟩
    simpa [subdivisionOriginalBoundaryVertex, xStarBoundaryVertexToStar,
      boundaryVertex] using
      rxCxH1_glueDiscrepancy_original_eq_offset
        P A3 R x S word hword boundaryVertex
  · rcases interior with edgeInterior | faceInterior
    · rcases edgeInterior with ⟨starEdge, interior⟩
      let boundaryEdge : XStarBoundaryEdge P x :=
        ⟨starEdge.1, by
          simpa [subdivisionBoundaryVertexMember] using hboundary⟩
      let selected : Fin S.half := ⟨interior.1, by
        have := interior.2
        omega⟩
      have hprefix := rxCxH1_glueDiscrepancy_segmentEnd_eq
        P A3 R x S word hword boundaryEdge selected
      have hinterior := rxCxH1_boundaryInterior_end
        P x S boundaryEdge interior
      have hendpoint :
          subdivisionBoundaryEdgeEnd P x S
              (subdivisionOriginalBoundaryEdge P x S boundaryEdge selected) =
            (⟨Sum.inr (Sum.inl (starEdge, interior)), hboundary⟩ :
              SubdivisionBoundaryVertex P x S) := by
        simpa [selected, boundaryEdge, xStarBoundaryEdgeToStar] using hinterior
      have hstart := rxCxH1_glueDiscrepancy_original_eq_offset
        P A3 R x S word hword (xBoundaryEdgeStart P x boundaryEdge)
      rw [hendpoint] at hprefix
      exact hprefix.symm.trans hstart
    · simp [subdivisionBoundaryVertexMember] at hboundary

/-- The normalized two-copy potential realizes every vertical glue edge. -/
private theorem rxCxH1_verticalGlue_equation
    (P : TannerSquarePresentation) (A3 : TannerSquareAdmissibleV3 P)
    (R : TannerSquareCellularRegular P) (x : P.X) (S : OddScale)
    (word : Word Field (DoubleCylinderEdge P x S))
    (hword : wordLinearMapTranspose (rxCx P x S).boundary2 word = 0)
    (vertex : SubdivisionBoundaryVertex P x S) :
    rxCxH1_doubleCylinderPotential P A3 x S word
        (tannerDoubleCylinderEdgeStart P x S (Sum.inr vertex)) +
      rxCxH1_doubleCylinderPotential P A3 x S word
        (tannerDoubleCylinderEdgeEnd P x S (Sum.inr vertex)) =
      word (Sum.inr vertex) := by
  have hdiscrepancy := rxCxH1_glueDiscrepancy_eq_offset
    P A3 R x S word hword vertex
  simp only [tannerDoubleCylinderEdgeStart, tannerDoubleCylinderEdgeEnd,
    rxCxH1_doubleCylinderPotential, rxTwoElim_zero, rxTwoElim_one]
  simp only [add_zero]
  rw [← hdiscrepancy]
  unfold rxCxH1_glueDiscrepancy
  rw [show
    rxCxH1_subdivisionPotential P A3 x S word 0 vertex.1 +
        (rxCxH1_subdivisionPotential P A3 x S word 1 vertex.1 +
          (rxCxH1_subdivisionPotential P A3 x S word 0 vertex.1 +
            rxCxH1_subdivisionPotential P A3 x S word 1 vertex.1 +
              word (Sum.inr vertex))) =
      (rxCxH1_subdivisionPotential P A3 x S word 0 vertex.1 +
          rxCxH1_subdivisionPotential P A3 x S word 0 vertex.1) +
        (rxCxH1_subdivisionPotential P A3 x S word 1 vertex.1 +
          rxCxH1_subdivisionPotential P A3 x S word 1 vertex.1) +
        word (Sum.inr vertex) by abel]
  rw [ZModModule.add_self, ZModModule.add_self]
  simp

/-- The explicit normalized potential realizes every double-cylinder edge,
dispatching structurally between the two subdivision copies and vertical
glue edges. -/
private theorem rxCxH1_doubleCylinderEdge_equation
    (P : TannerSquarePresentation) (A3 : TannerSquareAdmissibleV3 P)
    (R : TannerSquareCellularRegular P) (x : P.X) (S : OddScale)
    (word : Word Field (DoubleCylinderEdge P x S))
    (hword : wordLinearMapTranspose (rxCx P x S).boundary2 word = 0)
    (edge : DoubleCylinderEdge P x S) :
    rxCxH1_doubleCylinderPotential P A3 x S word
        (tannerDoubleCylinderEdgeStart P x S edge) +
      rxCxH1_doubleCylinderPotential P A3 x S word
        (tannerDoubleCylinderEdgeEnd P x S edge) =
      word edge := by
  rcases edge with copyEdge | vertex
  · rcases copyEdge with ⟨copy, edge⟩
    have hedge := rxCxH1_subdivisionEdge_equation
      P A3 R x S word hword copy edge
    fin_cases copy
    · simpa [rxCxH1_doubleCylinderPotential, rxTwoElim,
        tannerDoubleCylinderEdgeStart, tannerDoubleCylinderEdgeEnd] using
        hedge
    · change
        (rxCxH1_subdivisionPotential P A3 x S word 1
              (subdivisionEdgeStart P x S edge) +
            rxCxH1_glueOffset P A3 x S word) +
          (rxCxH1_subdivisionPotential P A3 x S word 1
              (subdivisionEdgeEnd P x S edge) +
            rxCxH1_glueOffset P A3 x S word) =
          word (Sum.inl (1, edge))
      rw [show
        (rxCxH1_subdivisionPotential P A3 x S word 1
              (subdivisionEdgeStart P x S edge) +
            rxCxH1_glueOffset P A3 x S word) +
          (rxCxH1_subdivisionPotential P A3 x S word 1
              (subdivisionEdgeEnd P x S edge) +
            rxCxH1_glueOffset P A3 x S word) =
          (rxCxH1_subdivisionPotential P A3 x S word 1
                (subdivisionEdgeStart P x S edge) +
              rxCxH1_subdivisionPotential P A3 x S word 1
                (subdivisionEdgeEnd P x S edge)) +
            (rxCxH1_glueOffset P A3 x S word +
              rxCxH1_glueOffset P A3 x S word) by abel]
      rw [ZModModule.add_self, add_zero]
      exact hedge
  · exact rxCxH1_verticalGlue_equation P A3 R x S word hword vertex

/-- The explicit normalized vertex potential is a concrete preimage of every
middle cocycle under the X-cylinder degree-zero coboundary.  Over `Field =
ZMod 2`, the graph coboundary is the unsigned sum of the two endpoint values,
exactly matching the total edge equation above. -/
private theorem rxCxH1_doubleCylinderPotential_coboundary_eq
    (P : TannerSquarePresentation) (A3 : TannerSquareAdmissibleV3 P)
    (R : TannerSquareCellularRegular P) (x : P.X) (S : OddScale)
    (word : Word Field (DoubleCylinderEdge P x S))
    (hword : wordLinearMapTranspose (rxCx P x S).boundary2 word = 0) :
    wordLinearMapTranspose (rxCx P x S).boundary1
        (rxCxH1_doubleCylinderPotential P A3 x S word) = word := by
  classical
  change wordLinearMapTranspose (doubleCylinderBoundary1 P x S)
      (rxCxH1_doubleCylinderPotential P A3 x S word) = word
  rw [← doubleCylinderGraphBoundary_eq_boundary1]
  change wordLinearMapTranspose
      (graphBoundary (tannerDoubleCylinderEdgeStart P x S)
        (tannerDoubleCylinderEdgeEnd P x S))
      (rxCxH1_doubleCylinderPotential P A3 x S word) = word
  ext edge
  rw [wordLinearMapTranspose_graphBoundary_apply]
  exact rxCxH1_doubleCylinderEdge_equation P A3 R x S word hword edge

/-- Exactness of the concrete X-block middle coboundary and cocycle spaces is
the precise algebraic input needed by the named zero coordinate. -/
private theorem rxCxH1Coordinate_bijective_of_exact
    (P : TannerSquarePresentation) (x : P.X) (S : OddScale)
    (hexact : (rxCx P x S).firstCoboundaryCheckCode.carrier =
      (rxCx P x S).middleCocycleCode.carrier) :
    Function.Bijective (rxCxH1Coordinate P x S) := by
  constructor
  · intro first second _
    refine Submodule.Quotient.induction_on _ first ?_
    intro firstWord
    refine Submodule.Quotient.induction_on _ second ?_
    intro secondWord
    rw [Submodule.Quotient.eq]
    change (firstWord - secondWord).1 ∈
      (rxCx P x S).firstCoboundaryCheckCode.carrier
    rw [hexact]
    exact (rxCx P x S).middleCocycleCode.carrier.sub_mem
      firstWord.2 secondWord.2
  · intro value
    exact ⟨0, Subsingleton.elim _ value⟩

/-- For an admissible locally regular Tanner square, every X-cylinder middle
cocycle is the coboundary of the explicit normalized potential. -/
private theorem rxCxH1_firstCoboundary_eq_middleCocycle
    (P : TannerSquarePresentation) (A3 : TannerSquareAdmissibleV3 P)
    (R : TannerSquareCellularRegular P) (x : P.X) (S : OddScale) :
    (rxCx P x S).firstCoboundaryCheckCode.carrier =
      (rxCx P x S).middleCocycleCode.carrier := by
  apply le_antisymm
  · exact (rxCx P x S).firstCoboundaryCheckCode_le_middleCocycleCode
  · intro word hword
    apply ((rxCx P x S).mem_firstCoboundaryCheckCode_iff word).2
    refine ⟨rxCxH1_doubleCylinderPotential P A3 x S word, ?_⟩
    exact rxCxH1_doubleCylinderPotential_coboundary_eq
      P A3 R x S word
        (((rxCx P x S).mem_middleCocycleCode_iff word).1 hword)

/-- F06 `H¹(Cx)=0`: the concrete X-block degree-one cohomology has its
bijective zero coordinate under the precise A3 plus cellular-regularity
domain. -/
theorem rxCxH1Coordinate_bijective
    (P : TannerSquarePresentation) (A3 : TannerSquareAdmissibleV3 P)
    (R : TannerSquareCellularRegular P) (x : P.X) (S : OddScale) :
    Function.Bijective (rxCxH1Coordinate P x S) :=
  rxCxH1Coordinate_bijective_of_exact P x S
    (rxCxH1_firstCoboundary_eq_middleCocycle P A3 R x S)

/-- The actual adjacent X-Q restriction on vertices. -/
def rxXQDegreeZero (P : TannerSquarePresentation)
    (A : TannerSquareAdmissible P) (q : P.Q) (x : P.X)
    (hxq : P.xq x q = true) (S : OddScale) :
    Word Field (DoubleCylinderVertex P x S) →ₗ[Field]
      Word Field (QDoubleCylinderVertex P q S) :=
  wordPullback (qToXDoubleCylinderVertex P A q x hxq S)

/-- The actual adjacent X-Q restriction on edges. -/
def rxXQDegreeOne (P : TannerSquarePresentation)
    (A : TannerSquareAdmissible P) (q : P.Q) (x : P.X)
    (hxq : P.xq x q = true) (S : OddScale) :
    Word Field (DoubleCylinderEdge P x S) →ₗ[Field]
      Word Field (QDoubleCylinderEdge P q S) :=
  wordPullback (qToXDoubleCylinderEdge P A q x hxq S)

/-- The two adjacent X-Q restrictions commute with their concrete
coboundaries. -/
theorem rxXQ_commutes (P : TannerSquarePresentation)
    (A : TannerSquareAdmissible P) (q : P.Q) (x : P.X)
    (hxq : P.xq x q = true) (S : OddScale) :
    (wordLinearMapTranspose (qDoubleCylinderBoundary1 P q S)).comp
        (rxXQDegreeZero P A q x hxq S) =
      (rxXQDegreeOne P A q x hxq S).comp
        (wordLinearMapTranspose (doubleCylinderBoundary1 P x S)) := by
  classical
  rw [← doubleCylinderGraphBoundary_eq_boundary1]
  simpa [doubleCylinderGraphBoundary, qDoubleCylinderBoundary1,
    rxXQDegreeZero, rxXQDegreeOne] using
    (wordPullback_graphCoboundary
      (qDoubleCylinderEdgeStart P q S)
      (qDoubleCylinderEdgeEnd P q S)
      (tannerDoubleCylinderEdgeStart P x S)
      (tannerDoubleCylinderEdgeEnd P x S)
      (qToXDoubleCylinderVertex P A q x hxq S)
      (qToXDoubleCylinderEdge P A q x hxq S)
      (fun edge => (qToXDoubleCylinderEdge_start P A q x hxq S edge).symm)
      (fun edge => (qToXDoubleCylinderEdge_end P A q x hxq S edge).symm))

/-! ## Named F06 Q-block coordinate -/

/-- Actual degree-zero cohomology of the concrete shifted Q block. -/
noncomputable abbrev RXQH0 (P : TannerSquarePresentation) (q : P.Q)
    (S : OddScale) :=
  Word Field (Fin 0) ⧸
    LinearMap.range (rxCq P q S).boundary1

/-- The empty degree-zero Q block has its canonical zero coordinate. -/
noncomputable def rxCqH0Coordinate (P : TannerSquarePresentation) (q : P.Q)
    (S : OddScale) : RXQH0 P q S →ₗ[Field] Word Field (Fin 0) := 0

/-- F06 `H⁰(Cq)=0` as a named bijective coordinate map. -/
theorem rxCqH0Coordinate_bijective (P : TannerSquarePresentation)
    (q : P.Q) (S : OddScale) :
    Function.Bijective (rxCqH0Coordinate P q S) := by
  constructor
  · intro first second _
    exact Subsingleton.elim first second
  · intro value
    exact ⟨0, Subsingleton.elim _ value⟩

/-- The actual middle cohomology of the concrete Q block. -/
noncomputable abbrev RXQH1 (P : TannerSquarePresentation) (q : P.Q)
    (S : OddScale) := (rxCq P q S).middleCohomology

/-- The adjacent X-Q restriction sends X degree-zero cocycles to Q
degree-one cocycles and hence induces the concrete cohomology map. -/
noncomputable def rxXQH0ToH1 (P : TannerSquarePresentation)
    (A : TannerSquareAdmissible P) (q : P.Q) (x : P.X)
    (hxq : P.xq x q = true) (S : OddScale) :
    RXH0 P x S →ₗ[Field] RXQH1 P q S := by
  classical
  let cocycleMap : RXH0 P x S →ₗ[Field]
      (rxCq P q S).middleCocycleCode.carrier := {
    toFun := fun word => ⟨rxXQDegreeZero P A q x hxq S word.1, by
      rw [(rxCq P q S).mem_middleCocycleCode_iff]
      change wordLinearMapTranspose (qDoubleCylinderBoundary1 P q S)
          (rxXQDegreeZero P A q x hxq S word.1) = 0
      have hcommutes := LinearMap.congr_fun
        (rxXQ_commutes P A q x hxq S) word.1
      rw [LinearMap.comp_apply, LinearMap.comp_apply] at hcommutes
      rw [hcommutes]
      have hxzero :
          wordLinearMapTranspose (doubleCylinderBoundary1 P x S) word.1 = 0 := by
        exact word.2
      rw [hxzero]
      exact map_zero (rxXQDegreeOne P A q x hxq S)⟩
    map_add' := by intros; rfl
    map_smul' := by intros; rfl }
  exact (rxCq P q S).middleCoboundaryInCocycles.mkQ.comp cocycleMap

/-- Root evaluation on Q-block cocycle representatives. -/
def rxCqRootEvaluation (P : TannerSquarePresentation) (q : P.Q)
    (S : OddScale) :
    (rxCq P q S).middleCocycleCode.carrier →ₗ[Field] Field where
  toFun := fun word => word.1 (0, Sum.inl (Sum.inl ()))
  map_add' := by intros; rfl
  map_smul' := by intros; rfl

/-- Evaluation at the explicit end-zero cone point descends to the actual
Q-block cohomology quotient. -/
noncomputable def rxCqH1Coordinate (P : TannerSquarePresentation) (q : P.Q)
    (S : OddScale) : RXQH1 P q S →ₗ[Field] Field :=
  (rxCq P q S).middleCoboundaryInCocycles.liftQ
    (rxCqRootEvaluation P q S)
    (by
      intro boundary hboundary
      change boundary.1 ∈
        (rxCq P q S).firstCoboundaryCheckCode.carrier at hboundary
      rcases ((rxCq P q S).mem_firstCoboundaryCheckCode_iff boundary.1).1
          hboundary with ⟨source, hsource⟩
      have hzero : wordLinearMapTranspose (rxCq P q S).boundary1 source = 0 := by
        simp [rxCq, wordLinearMapTranspose_zero]
      have hword : boundary.1 = 0 := by simpa [hzero] using hsource.symm
      change boundary ∈ LinearMap.ker (rxCqRootEvaluation P q S)
      rw [LinearMap.mem_ker]
      change boundary.1 (0, Sum.inl (Sum.inl ())) = 0
      simp [hword])

@[simp] theorem rxCqH1Coordinate_mk (P : TannerSquarePresentation) (q : P.Q)
    (S : OddScale) (word : (rxCq P q S).middleCocycleCode.carrier) :
    rxCqH1Coordinate P q S
        (Submodule.Quotient.mk word) =
      word.1 (0, Sum.inl (Sum.inl ())) := rfl

/-- F08 X-Q quotient-coordinate formula: an adjacent X coordinate maps to
the same Q coordinate. -/
theorem rxXQH0ToH1_coordinate (P : TannerSquarePresentation)
    (A : TannerSquareAdmissible P) (q : P.Q) (x : P.X)
    (hxq : P.xq x q = true) (S : OddScale) (word : RXH0 P x S) :
    rxCqH1Coordinate P q S (rxXQH0ToH1 P A q x hxq S word) =
      rxCxH0Coordinate P A x S word := by
  change word.1
      (qToXDoubleCylinderVertex P A q x hxq S
        (0, Sum.inl (Sum.inl ()))) =
    word.1
      (0, (subdivisionOriginalBoundaryVertex P x S
        (A.xBoundaryRoot x)).1)
  exact rxCxCocycle_eq_boundaryRoot_zeroCopy
    P A x S word.1 word.2 _

/-- F06 `H¹(Cq)=F₂` as a named bijective coordinate map. -/
theorem rxCqH1Coordinate_bijective (P : TannerSquarePresentation)
    (A : TannerSquareAdmissible P) (q : P.Q) (S : OddScale) :
    Function.Bijective (rxCqH1Coordinate P q S) := by
  classical
  let root : QDoubleCylinderVertex P q S := (0, Sum.inl (Sum.inl ()))
  have hconstant : ∀ word : (rxCq P q S).middleCocycleCode.carrier,
      ∀ vertex, word.1 vertex = word.1 root := by
    intro word
    exact word_eq_root_of_graphCoboundary_eq_zero
      (qDoubleCylinderEdgeStart P q S)
      (qDoubleCylinderEdgeEnd P q S) root
      (qDoubleCylinderPath P A q S) word.1
      (by simpa [rxCq, qDoubleCylinderBoundary1] using word.2)
  constructor
  · intro first
    refine Submodule.Quotient.induction_on _ first ?_
    intro firstWord second
    refine Submodule.Quotient.induction_on _ second ?_
    intro secondWord h
    rw [Submodule.Quotient.eq]
    have hwords : firstWord = secondWord := by
      apply Subtype.ext
      funext vertex
      rw [hconstant firstWord vertex, hconstant secondWord vertex]
      exact h
    rw [hwords, sub_self]
    exact Submodule.zero_mem _
  · intro value
    let constant : Word Field (QDoubleCylinderVertex P q S) := fun _ => value
    have hkernel :
        wordLinearMapTranspose (qDoubleCylinderBoundary1 P q S) constant = 0 := by
      ext edge
      unfold qDoubleCylinderBoundary1
      rw [wordLinearMapTranspose_graphBoundary_apply]
      change value + value = 0
      exact ZModModule.add_self value
    let cocycle : (rxCq P q S).middleCocycleCode.carrier :=
      ⟨constant, by simpa [rxCq] using hkernel⟩
    exact ⟨Submodule.Quotient.mk cocycle, rfl⟩

/-! ## Named F06 zero coordinates for the old-Z block -/

/-- Actual degree-zero cohomology of the concrete old-Z block. -/
noncomputable abbrev RXZH0 (P : TannerSquarePresentation) (z : P.Z) :=
  Word Field (Fin 0) ⧸
    LinearMap.range (rxCz P z).boundary1

/-- The empty degree-zero old-Z block has its canonical zero coordinate. -/
noncomputable def rxCzH0Coordinate (P : TannerSquarePresentation) (z : P.Z) :
    RXZH0 P z →ₗ[Field] Word Field (Fin 0) := 0

/-- F06 `H⁰(Cz)=0` as a named bijective coordinate map. -/
theorem rxCzH0Coordinate_bijective (P : TannerSquarePresentation) (z : P.Z) :
    Function.Bijective (rxCzH0Coordinate P z) := by
  constructor
  · intro first second _
    exact Subsingleton.elim first second
  · intro value
    exact ⟨0, Subsingleton.elim _ value⟩

/-- Actual degree-one cohomology of the concrete old-Z block. -/
noncomputable abbrev RXZH1 (P : TannerSquarePresentation) (z : P.Z) :=
  (rxCz P z).middleCohomology

/-- The empty degree-one old-Z block has its canonical zero coordinate. -/
noncomputable def rxCzH1Coordinate (P : TannerSquarePresentation) (z : P.Z) :
    RXZH1 P z →ₗ[Field] Word Field (Fin 0) := 0

/-- F06 `H¹(Cz)=0` as a named bijective coordinate map. -/
theorem rxCzH1Coordinate_bijective (P : TannerSquarePresentation) (z : P.Z) :
    Function.Bijective (rxCzH1Coordinate P z) := by
  constructor
  · intro first second _
    exact Subsingleton.elim first second
  · intro value
    exact ⟨0, Subsingleton.elim _ value⟩

/-- The two-copy Q-Z restriction on the nonzero Q degree. -/
def rxQZDegreeOne (P : TannerSquarePresentation) (q : P.Q) (z : P.Z)
    (hqz : P.qz q z = true) (S : OddScale) :
    Word Field (QDoubleCylinderVertex P q S) →ₗ[Field] Word Field Two :=
  wordPullback (fun copy : Two =>
    (copy, Sum.inl (Sum.inr (⟨z, hqz⟩ : QStarEdge P q))))

/-- Restricting the constant X generator gives the constant Q generator. -/
theorem rxXQDegreeZero_one (P : TannerSquarePresentation)
    (A : TannerSquareAdmissible P) (q : P.Q) (x : P.X)
    (hxq : P.xq x q = true) (S : OddScale) :
    rxXQDegreeZero P A q x hxq S (1 : Word Field (DoubleCylinderVertex P x S)) =
      (1 : Word Field (QDoubleCylinderVertex P q S)) := by
  rfl

/-- F08 Q-Z generator formula: the constant Q generator restricts to `(1,1)`. -/
theorem rxQZDegreeOne_one (P : TannerSquarePresentation)
    (q : P.Q) (z : P.Z) (hqz : P.qz q z = true) (S : OddScale) :
    rxQZDegreeOne P q z hqz S
        (1 : Word Field (QDoubleCylinderVertex P q S)) =
      (1 : Word Field Two) := by
  rfl

/-- Actual degree-two cohomology of the concrete old-Z block. -/
noncomputable abbrev RXZH2 (P : TannerSquarePresentation) (z : P.Z) :=
  Word Field Two ⧸
    LinearMap.range (wordLinearMapTranspose (rxCz P z).boundary2)

/-- The two raw old-Z copy coordinates. -/
def rxCzWordCoordinates : Word Field Two →ₗ[Field] Field × Field where
  toFun := fun word => (word 0, word 1)
  map_add' := by intros; rfl
  map_smul' := by intros; rfl

/-- The named F06 degree-two coordinate map on the actual quotient. -/
noncomputable def rxCzH2Coordinates (P : TannerSquarePresentation) (z : P.Z) :
    RXZH2 P z →ₗ[Field] Field × Field :=
  (LinearMap.range (wordLinearMapTranspose (rxCz P z).boundary2)).liftQ
    rxCzWordCoordinates
    (by
      intro boundary hboundary
      rcases hboundary with ⟨source, hsource⟩
      have hzero : wordLinearMapTranspose (rxCz P z).boundary2 source = 0 := by
        simp [rxCz, wordLinearMapTranspose_zero]
      change boundary ∈ LinearMap.ker rxCzWordCoordinates
      rw [LinearMap.mem_ker]
      have : boundary = 0 := by simpa [hzero] using hsource.symm
      simp [this, rxCzWordCoordinates])

@[simp] theorem rxCzH2Coordinates_mk (P : TannerSquarePresentation) (z : P.Z)
    (word : Word Field Two) :
    rxCzH2Coordinates P z
        ((LinearMap.range
          (wordLinearMapTranspose (rxCz P z).boundary2)).mkQ word) =
      (word 0, word 1) := rfl

/-- F06 `H²(Cz)=F₂²` as a named bijective coordinate map. -/
theorem rxCzH2Coordinates_bijective (P : TannerSquarePresentation) (z : P.Z) :
    Function.Bijective (rxCzH2Coordinates P z) := by
  constructor
  · intro first
    refine Submodule.Quotient.induction_on _ first ?_
    intro firstWord second
    refine Submodule.Quotient.induction_on _ second ?_
    intro secondWord h
    rw [Submodule.Quotient.eq]
    have hwords : firstWord = secondWord := by
      funext index
      fin_cases index
      · exact congrArg Prod.fst h
      · exact congrArg Prod.snd h
    rw [hwords, sub_self]
    exact Submodule.zero_mem _
  · rintro ⟨first, second⟩
    let word : Word Field Two := fun index => twoSelect first second index
    refine ⟨(LinearMap.range
      (wordLinearMapTranspose (rxCz P z).boundary2)).mkQ word, ?_⟩
    rw [rxCzH2Coordinates_mk]
    ext <;> simp [word, twoSelect]

/-! ## Restriction-induced F08 quotient map -/

/-- The actual Q-Z restriction descends from the concrete Q-block middle
cohomology to the concrete old-Z top cohomology.  The source quotient is
well-defined because the shifted Q block has zero degree-zero boundary. -/
noncomputable def rxQZH1ToH2 (P : TannerSquarePresentation)
    (q : P.Q) (z : P.Z) (hqz : P.qz q z = true) (S : OddScale) :
    RXQH1 P q S →ₗ[Field] RXZH2 P z := by
  classical
  let targetQ := LinearMap.range
    (wordLinearMapTranspose (rxCz P z).boundary2)
  exact (rxCq P q S).middleCoboundaryInCocycles.liftQ
    (targetQ.mkQ.comp
      ((rxQZDegreeOne P q z hqz S).comp
        (rxCq P q S).middleCocycleCode.carrier.subtype)) (by
      intro boundary hboundary
      change boundary.1 ∈
        (rxCq P q S).firstCoboundaryCheckCode.carrier at hboundary
      rcases ((rxCq P q S).mem_firstCoboundaryCheckCode_iff boundary.1).1
          hboundary with ⟨source, hsource⟩
      have hzero :
          wordLinearMapTranspose (rxCq P q S).boundary1 source = 0 := by
        simp [rxCq, wordLinearMapTranspose_zero]
      have hword : boundary.1 = 0 := by
        simpa [hzero] using hsource.symm
      rw [LinearMap.mem_ker]
      simp [hword])

@[simp] theorem rxQZH1ToH2_mk (P : TannerSquarePresentation)
    (q : P.Q) (z : P.Z) (hqz : P.qz q z = true) (S : OddScale)
    (word : (rxCq P q S).middleCocycleCode.carrier) :
    rxQZH1ToH2 P q z hqz S
        ((rxCq P q S).middleCoboundaryInCocycles.mkQ word) =
      (LinearMap.range
        (wordLinearMapTranspose (rxCz P z).boundary2)).mkQ
        (rxQZDegreeOne P q z hqz S word.1) := rfl

/-- F08 Q-Z quotient-coordinate formula: an adjacent Q coordinate maps to
the diagonal pair of old-Z copy coordinates. -/
theorem rxQZH1ToH2_coordinates (P : TannerSquarePresentation)
    (A : TannerSquareAdmissible P) (q : P.Q) (z : P.Z)
    (hqz : P.qz q z = true) (S : OddScale)
    (cohomologyClass : RXQH1 P q S) :
    rxCzH2Coordinates P z
        (rxQZH1ToH2 P q z hqz S cohomologyClass) =
      (rxCqH1Coordinate P q S cohomologyClass,
        rxCqH1Coordinate P q S cohomologyClass) := by
  refine Submodule.Quotient.induction_on _ cohomologyClass ?_
  intro word
  change rxCzH2Coordinates P z
      (rxQZH1ToH2 P q z hqz S
        ((rxCq P q S).middleCoboundaryInCocycles.mkQ word)) =
    (rxCqH1Coordinate P q S
        ((rxCq P q S).middleCoboundaryInCocycles.mkQ word),
      rxCqH1Coordinate P q S
        ((rxCq P q S).middleCoboundaryInCocycles.mkQ word))
  rw [rxQZH1ToH2_mk, rxCzH2Coordinates_mk]
  change
    (word.1 (0, Sum.inl (Sum.inr (⟨z, hqz⟩ : QStarEdge P q))),
      word.1 (1, Sum.inl (Sum.inr (⟨z, hqz⟩ : QStarEdge P q)))) =
      (word.1 (0, Sum.inl (Sum.inl ())),
        word.1 (0, Sum.inl (Sum.inl ())))
  have hconstant := word_eq_root_of_graphCoboundary_eq_zero
    (qDoubleCylinderEdgeStart P q S)
    (qDoubleCylinderEdgeEnd P q S)
    (0, Sum.inl (Sum.inl ()))
    (qDoubleCylinderPath P A q S) word.1
    (by simpa [rxCq, qDoubleCylinderBoundary1] using word.2)
  apply Prod.ext
  · exact hconstant (0, Sum.inl (Sum.inr ⟨z, hqz⟩))
  · exact hconstant (1, Sum.inl (Sum.inr ⟨z, hqz⟩))

/-- The Q-Z generator formula in the named two-coordinate chart. -/
theorem rxCzH2Coordinates_rxQZDegreeOne_one
    (P : TannerSquarePresentation) (q : P.Q) (z : P.Z)
    (hqz : P.qz q z = true) (S : OddScale) :
    rxCzH2Coordinates P z
        ((LinearMap.range
          (wordLinearMapTranspose (rxCz P z).boundary2)).mkQ
      (rxQZDegreeOne P q z hqz S
            (1 : Word Field (QDoubleCylinderVertex P q S)))) = (1, 1) := by
  rfl

/-! ## Choice-free aggregate F08 formulas -/

/-- Replicate an old X coordinate over every vertex of its concrete local
X block. -/
def rxAggregateDegreeZero (P : TannerSquarePresentation) (S : OddScale) :
    Word Field P.X →ₗ[Field] Word Field (RX0 P S) :=
  wordPullback Sigma.fst

/-- Replicate an old Z coordinate on the two retained Z points and vanish on
the auxiliary X-face and Q-edge coordinates. -/
def rxAggregateDegreeTwo (P : TannerSquarePresentation) (S : OddScale) :
    Word Field P.Z →ₗ[Field] Word Field (RX2 P S) where
  toFun := fun word coordinate => match coordinate with
    | Sum.inl _ => 0
    | Sum.inr zPoint => word zPoint.1
  map_add' := by intros; funext coordinate; rcases coordinate with _ | _ <;> rfl
  map_smul' := by intros; funext coordinate; rcases coordinate with _ | _ <;> rfl

@[simp] theorem rxAggregateDegreeTwo_xFace
    (P : TannerSquarePresentation) (S : OddScale) (word : Word Field P.Z)
    (xFace : Σ x : P.X, DoubleCylinderFace P x S) :
    rxAggregateDegreeTwo P S word (Sum.inl (Sum.inl xFace)) = 0 := rfl

@[simp] theorem rxAggregateDegreeTwo_qEdge
    (P : TannerSquarePresentation) (S : OddScale) (word : Word Field P.Z)
    (qEdge : Σ q : P.Q, QDoubleCylinderEdge P q S) :
    rxAggregateDegreeTwo P S word (Sum.inl (Sum.inr qEdge)) = 0 := rfl

@[simp] theorem rxAggregateDegreeTwo_zPoint
    (P : TannerSquarePresentation) (S : OddScale) (word : Word Field P.Z)
    (z : P.Z) (copy : Two) :
    rxAggregateDegreeTwo P S word (Sum.inr (z, copy)) = word z := rfl

/-- The aggregate old-X word, regarded in one actual local X `H⁰`. -/
noncomputable def rxAggregateXH0 (P : TannerSquarePresentation)
    (x : P.X) (S : OddScale) : Word Field P.X →ₗ[Field] RXH0 P x S := by
  classical
  exact {
    toFun := fun word => ⟨fun _ => word x, by
      change wordLinearMapTranspose (doubleCylinderBoundary1 P x S)
          (fun _ => word x) = 0
      rw [← doubleCylinderGraphBoundary_eq_boundary1]
      change wordLinearMapTranspose
        (graphBoundary (tannerDoubleCylinderEdgeStart P x S)
          (tannerDoubleCylinderEdgeEnd P x S)) (fun _ => word x) = 0
      ext edge
      rw [wordLinearMapTranspose_graphBoundary_apply]
      exact ZModModule.add_self (word x)⟩
    map_add' := by intros; rfl
    map_smul' := by intros; rfl }

@[simp] theorem rxCxH0Coordinate_rxAggregateXH0
    (P : TannerSquarePresentation) (A : TannerSquareAdmissible P)
    (x : P.X) (S : OddScale) (word : Word Field P.X) :
    rxCxH0Coordinate P A x S (rxAggregateXH0 P x S word) = word x := rfl

/-- Old X-Q adjacency in the same coordinate orientation as the induced
local X-to-Q maps. -/
noncomputable def rxXQAdjacency (P : TannerSquarePresentation) :
    Word Field P.X →ₗ[Field] Word Field P.Q :=
  wordLinearMapTranspose (Matrix.toLin' (xqIncidenceMatrix P))

/-- Aggregating the actual local X-to-Q quotient maps recovers precisely the
old X-Q adjacency map. -/
theorem rxXQAdjacency_eq_sum_coordinates
    (P : TannerSquarePresentation) (A : TannerSquareAdmissible P)
    (S : OddScale) (word : Word Field P.X) (q : P.Q) :
    rxXQAdjacency P word q =
      ∑ x : P.X, if hxq : P.xq x q = true then
        rxCqH1Coordinate P q S
          (rxXQH0ToH1 P A q x hxq S (rxAggregateXH0 P x S word))
      else 0 := by
  rw [rxXQAdjacency, wordLinearMapTranspose_toLin'_apply]
  apply Finset.sum_congr rfl
  intro x _
  by_cases hxq : P.xq x q = true
  · simp [xqIncidenceMatrix, hxq, rxXQH0ToH1_coordinate]
  · simp [xqIncidenceMatrix, hxq]

/-- The constant representative of an old Q coordinate in one actual local
Q `H¹`. -/
noncomputable def rxAggregateQH1 (P : TannerSquarePresentation)
    (q : P.Q) (S : OddScale) : Word Field P.Q →ₗ[Field] RXQH1 P q S := by
  classical
  let cocycleMap : Word Field P.Q →ₗ[Field]
      (rxCq P q S).middleCocycleCode.carrier := {
    toFun := fun word => ⟨fun _ => word q, by
      rw [(rxCq P q S).mem_middleCocycleCode_iff]
      change wordLinearMapTranspose (qDoubleCylinderBoundary1 P q S)
          (fun _ => word q) = 0
      unfold qDoubleCylinderBoundary1
      ext edge
      rw [wordLinearMapTranspose_graphBoundary_apply]
      exact ZModModule.add_self (word q)⟩
    map_add' := by intros; rfl
    map_smul' := by intros; rfl }
  exact (rxCq P q S).middleCoboundaryInCocycles.mkQ.comp cocycleMap

@[simp] theorem rxCqH1Coordinate_rxAggregateQH1
    (P : TannerSquarePresentation) (q : P.Q) (S : OddScale)
    (word : Word Field P.Q) :
    rxCqH1Coordinate P q S (rxAggregateQH1 P q S word) = word q := rfl

/-- Old Q-Z adjacency in the same coordinate orientation as the induced
local Q-to-Z maps. -/
noncomputable def rxQZAdjacency (P : TannerSquarePresentation) :
    Word Field P.Q →ₗ[Field] Word Field P.Z :=
  wordLinearMapTranspose (Matrix.toLin' (qzIncidenceMatrix P))

/-- Aggregating the actual local Q-to-Z quotient maps gives the diagonal of
the old Q-Z adjacency coordinate. -/
theorem rxQZDiagonal_eq_sum_coordinates
    (P : TannerSquarePresentation) (A : TannerSquareAdmissible P)
    (S : OddScale) (word : Word Field P.Q) (z : P.Z) :
    (rxQZAdjacency P word z, rxQZAdjacency P word z) =
      ∑ q : P.Q, if hqz : P.qz q z = true then
        rxCzH2Coordinates P z
          (rxQZH1ToH2 P q z hqz S (rxAggregateQH1 P q S word))
      else 0 := by
  apply Prod.ext
  · rw [rxQZAdjacency, wordLinearMapTranspose_toLin'_apply]
    simp only [Prod.fst_sum]
    apply Finset.sum_congr rfl
    intro q _
    by_cases hqz : P.qz q z = true
    · simp only [qzIncidenceMatrix, hqz, if_true, dif_pos]
      rw [rxQZH1ToH2_coordinates P A q z hqz S]
      simp
    · simp [qzIncidenceMatrix, hqz]
  · rw [rxQZAdjacency, wordLinearMapTranspose_toLin'_apply]
    simp only [Prod.snd_sum]
    apply Finset.sum_congr rfl
    intro q _
    by_cases hqz : P.qz q z = true
    · simp only [qzIncidenceMatrix, hqz, if_true, dif_pos]
      rw [rxQZH1ToH2_coordinates P A q z hqz S]
      simp
    · simp [qzIncidenceMatrix, hqz]

